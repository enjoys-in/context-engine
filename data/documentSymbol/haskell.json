{
  "language": "haskell",
  "symbolPatterns": [
    {
      "name": "Module",
      "pattern": "^module\\s+([A-Z][\\w.]*)",
      "captureGroup": 1,
      "kind": 1,
      "type": "module"
    },
    {
      "name": "Data",
      "pattern": "^data\\s+(?:instance\\s+)?([A-Z]\\w*)",
      "captureGroup": 1,
      "kind": 22,
      "type": "data"
    },
    {
      "name": "Newtype",
      "pattern": "^newtype\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "kind": 22,
      "type": "newtype"
    },
    {
      "name": "Type synonym",
      "pattern": "^type\\s+(?:family\\s+)?([A-Z]\\w*)",
      "captureGroup": 1,
      "kind": 25,
      "type": "type"
    },
    {
      "name": "Class",
      "pattern": "^class\\s+(?:.*=>\\s*)?([A-Z]\\w*)",
      "captureGroup": 1,
      "kind": 10,
      "type": "class"
    },
    {
      "name": "Instance",
      "pattern": "^instance\\s+(?:.*=>\\s*)?([A-Z][\\w.]*)",
      "captureGroup": 1,
      "kind": 10,
      "type": "instance"
    },
    {
      "name": "Type signature",
      "pattern": "^([a-z_]\\w*'?)\\s*::",
      "captureGroup": 1,
      "kind": 11,
      "type": "function"
    },
    {
      "name": "Function equation",
      "pattern": "^([a-z_]\\w*'?)\\s+[\\w({\\[]",
      "captureGroup": 1,
      "kind": 11,
      "type": "function"
    },
    {
      "name": "Pattern binding",
      "pattern": "^([a-z_]\\w*'?)\\s*=",
      "captureGroup": 1,
      "kind": 12,
      "type": "variable"
    },
    {
      "name": "Operator",
      "pattern": "^\\(([^)\\s]+)\\)\\s*::",
      "captureGroup": 1,
      "kind": 24,
      "type": "operator"
    },
    {
      "name": "Record field",
      "pattern": "^\\s*[,{]\\s*(\\w+)\\s*::",
      "captureGroup": 1,
      "kind": 7,
      "type": "field"
    },
    {
      "name": "Constructor",
      "pattern": "^\\s*[=|]\\s*([A-Z]\\w*)",
      "captureGroup": 1,
      "kind": 8,
      "type": "constructor"
    },
    {
      "name": "Language pragma",
      "pattern": "^\\{-#\\s*LANGUAGE\\s+(\\w+)",
      "captureGroup": 1,
      "kind": 13,
      "type": "pragma"
    },
    {
      "name": "Import",
      "pattern": "^import\\s+(?:qualified\\s+)?([A-Z][\\w.]*)",
      "captureGroup": 1,
      "kind": 2,
      "type": "import"
    }
  ]
}
