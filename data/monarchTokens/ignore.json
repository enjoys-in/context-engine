{
  "language": "ignore",
  "tokenPostfix": ".ignore",
  "defaultToken": "",
  "keywords": [],
  "typeKeywords": [],
  "operators": [
    "!"
  ],
  "symbols": "[!/*?]+",
  "escapes": "\\\\.",
  "digits": "\\d+",
  "brackets": [
    {
      "open": "[",
      "close": "]",
      "token": "delimiter.square"
    }
  ],
  "tokenizer": {
    "root": [
      [
        "^\\s*#.*$",
        "comment"
      ],
      [
        "^\\s*!",
        "keyword.negation"
      ],
      [
        "\\*\\*",
        "regexp.globstar"
      ],
      [
        "\\*",
        "regexp.glob"
      ],
      [
        "\\?",
        "regexp.glob"
      ],
      [
        "\\[[^\\]]*\\]",
        "regexp.charclass"
      ],
      [
        "/",
        "delimiter"
      ],
      [
        "[^\\s#!*?\\[\\]/]+",
        "string.path"
      ]
    ],
    "comment": [
      [
        "#.*$",
        "comment"
      ]
    ]
  }
}
