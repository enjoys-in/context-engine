{
  "language": "prisma",
  "triggerKinds": {
    "invoke": 0,
    "automatic": 1
  },
  "tags": {
    "aiGenerated": 1
  },
  "namingConventions": {
    "casing": [
      "camelCase",
      "PascalCase",
      "snake_case"
    ],
    "prefixes": {
      "variable": [
        "get",
        "set",
        "is",
        "has",
        "new"
      ]
    },
    "suffixes": {
      "type": [
        "Handler",
        "Service",
        "Factory",
        "Helper",
        "Manager"
      ]
    }
  },
  "symbolKinds": [
    "class",
    "enum",
    "property",
    "typeParameter"
  ],
  "renameSuggestionRules": [
    {
      "symbolKind": "class",
      "pattern": ".*",
      "suggestedNames": [
        {
          "newSymbolName": "{descriptiveModel}",
          "tags": [
            1
          ]
        }
      ],
      "description": "Model rename"
    },
    {
      "symbolKind": "enum",
      "pattern": ".*",
      "suggestedNames": [
        {
          "newSymbolName": "{descriptiveEnum}",
          "tags": [
            1
          ]
        }
      ],
      "description": "Enum rename"
    },
    {
      "symbolKind": "property",
      "pattern": ".*",
      "suggestedNames": [
        {
          "newSymbolName": "{descriptiveField}",
          "tags": [
            1
          ]
        }
      ],
      "description": "Field rename"
    }
  ],
  "reservedWords": [
    "model",
    "enum",
    "datasource",
    "generator",
    "type",
    "view"
  ],
  "identifierRules": {
    "start": "[a-zA-Z_]",
    "continue": "[a-zA-Z0-9_]",
    "maxLength": 255,
    "caseSensitive": true,
    "unicodeSupport": false
  }
}
