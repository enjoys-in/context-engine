{
  "language": "ignore",
  "triggerKinds": {
    "invoke": 0,
    "automatic": 1
  },
  "tags": {
    "aiGenerated": 1
  },
  "namingConventions": {
    "casing": [
      "camelCase",
      "PascalCase",
      "snake_case"
    ],
    "prefixes": {
      "variable": [
        "get",
        "set",
        "is",
        "has",
        "new"
      ]
    },
    "suffixes": {
      "type": [
        "Handler",
        "Service",
        "Factory",
        "Helper",
        "Manager"
      ]
    }
  },
  "symbolKinds": [
    "variable"
  ],
  "renameSuggestionRules": [
    {
      "symbolKind": "variable",
      "pattern": ".*",
      "suggestedNames": [
        {
          "newSymbolName": "{descriptivePattern}",
          "tags": [
            1
          ]
        }
      ],
      "description": "Ignore pattern rename"
    }
  ],
  "reservedWords": [
    ".gitignore",
    ".dockerignore",
    ".npmignore"
  ],
  "identifierRules": {
    "start": "[A-Za-z0-9_.*?/-]",
    "continue": "[A-Za-z0-9_.*?/-]",
    "maxLength": 255,
    "caseSensitive": true,
    "unicodeSupport": false
  }
}
