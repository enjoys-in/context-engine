{
  "language": "haskell",
  "triggerKinds": {
    "invoke": 0,
    "automatic": 1
  },
  "tags": {
    "aiGenerated": 1
  },
  "symbolKinds": [
    "function",
    "type",
    "constructor",
    "class",
    "field",
    "module",
    "typeParameter",
    "variable"
  ],
  "namingConventions": {
    "casing": [
      "camelCase",
      "PascalCase"
    ],
    "prefixes": {
      "function": [
        "get",
        "set",
        "mk",
        "run",
        "with",
        "to",
        "from",
        "is",
        "has"
      ],
      "boolean": [
        "is",
        "has",
        "can",
        "should"
      ],
      "interface": [],
      "class": [],
      "constant": [],
      "variable": [],
      "method": [],
      "receiver": []
    },
    "suffixes": {
      "function": [
        "'",
        "M",
        "_"
      ],
      "class": [],
      "interface": [],
      "constant": [],
      "enum": [],
      "variable": [
        "'"
      ]
    },
    "patterns": {
      "function": "^[a-z_][A-Za-z0-9_']*$",
      "class": "^[A-Z][A-Za-z0-9_']*$",
      "constant": "^[a-z_][A-Za-z0-9_']*$",
      "interface": "^[A-Z][A-Za-z0-9_']*$",
      "enum": "^[A-Z][A-Za-z0-9_']*$",
      "typeParameter": "^[a-z][A-Za-z0-9_']*$",
      "parameter": "^[a-z_][A-Za-z0-9_']*$"
    }
  },
  "identifierRules": {
    "start": "[A-Za-z_]",
    "continue": "[A-Za-z0-9_']",
    "caseSensitive": true,
    "unicodeSupport": true
  },
  "reservedWords": [
    "module",
    "where",
    "import",
    "qualified",
    "hiding",
    "as",
    "data",
    "newtype",
    "type",
    "class",
    "instance",
    "deriving",
    "do",
    "case",
    "of",
    "let",
    "in",
    "if",
    "then",
    "else",
    "forall",
    "infixl",
    "infixr",
    "infix",
    "foreign"
  ],
  "renameSuggestionRules": [
    {
      "symbolKind": "function",
      "pattern": "^[a-z_]\\w*'?$",
      "description": "Functions and variables are camelCase and must start lowercase",
      "suggestedNames": [
        {
          "newSymbolName": "toResult",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "runStep",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "mkConfig",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "function",
      "pattern": "^is[A-Z]",
      "description": "Boolean-returning functions read as a predicate",
      "suggestedNames": [
        {
          "newSymbolName": "isValid",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "hasValue",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "function",
      "pattern": "'$",
      "description": "A trailing prime marks the strict variant, as in foldl'",
      "suggestedNames": [
        {
          "newSymbolName": "foldl'",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "sum'",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "function",
      "pattern": "M$",
      "description": "A trailing M marks the monadic variant, as in mapM",
      "suggestedNames": [
        {
          "newSymbolName": "traverseM",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "type",
      "pattern": "^[A-Z]\\w*$",
      "description": "Types, constructors and classes are PascalCase",
      "suggestedNames": [
        {
          "newSymbolName": "Config",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "Result",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "field",
      "pattern": "^\\w+$",
      "description": "Record fields are often prefixed to avoid clashing across types",
      "suggestedNames": [
        {
          "newSymbolName": "cfgName",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "userId",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "typeParameter",
      "pattern": "^[a-z]$",
      "description": "Type variables are single lowercase letters",
      "suggestedNames": [
        {
          "newSymbolName": "a",
          "tags": [
            1
          ]
        },
        {
          "newSymbolName": "m",
          "tags": [
            1
          ]
        }
      ]
    },
    {
      "symbolKind": "function",
      "pattern": "^un[A-Z]",
      "description": "A newtype accessor is conventionally un-prefixed",
      "suggestedNames": [
        {
          "newSymbolName": "unConfig",
          "tags": [
            1
          ]
        }
      ]
    }
  ]
}
