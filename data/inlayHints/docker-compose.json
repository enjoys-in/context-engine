{
  "language": "docker-compose",
  "inlayHintPatterns": [
    {
      "pattern": "(?:environment):\\s*\\n\\s+(\\w+)\\s*[:=]\\s*(.+)",
      "kind": 1,
      "label": ": {inferred_type}",
      "position": "after_capture_1",
      "paddingLeft": true,
      "description": "Show inferred type for environment variable values"
    },
    {
      "kind": 2,
      "description": "Parameter name hints",
      "pattern": "(\\w+)\\s*\\(([^)]+)\\)",
      "display": "parameterName:",
      "position": "before"
    },
    {
      "kind": 1,
      "description": "Inferred type hints",
      "pattern": "(?:let|var|val|const|auto)\\s+(\\w+)\\s*=",
      "display": ": inferredType",
      "position": "after"
    },
    {
      "kind": 1,
      "description": "Return type hints",
      "pattern": "(?:function|def|fn|func|fun)\\s+\\w+\\s*\\([^)]*\\)\\s*(?:=>|->|:)?",
      "display": "-> returnType",
      "position": "after"
    },
    {
      "kind": 1,
      "description": "Enum member value hints",
      "pattern": "(?:enum|const)\\s+\\w+",
      "display": "= value",
      "position": "after"
    },
    {
      "kind": 1,
      "description": "Chained method result type",
      "pattern": "\\.(\\w+)\\(",
      "display": ": resultType",
      "position": "after"
    },
    {
      "kind": 1,
      "description": "Destructuring type hints",
      "pattern": "(?:const|let|var)\\s*[{\\[]",
      "display": ": type",
      "position": "inline"
    },
    {
      "kind": 1,
      "pattern": "(const|let|var)\\s+(\\w+)",
      "label": ": {inferred_type}",
      "position": "after",
      "paddingLeft": true,
      "description": "Type inference for Docker Compose variable declarations"
    },
    {
      "kind": 2,
      "pattern": "\\b(\\w+)\\s*\\(",
      "label": "{param_name}:",
      "position": "before",
      "paddingRight": true,
      "description": "Parameter name hints for Docker Compose function calls"
    },
    {
      "kind": 1,
      "pattern": "\\breturn\\s+",
      "label": "-> {return_type}",
      "position": "after",
      "paddingLeft": true,
      "description": "Return type hints for Docker Compose functions"
    },
    {
      "kind": 2,
      "pattern": "\\b(true|false|null|undefined|nil|None)\\b",
      "label": "{param_name}:",
      "position": "before",
      "paddingRight": true,
      "description": "Boolean/null literal parameter hints"
    },
    {
      "kind": 1,
      "pattern": "\\[([^\\]]+)\\]",
      "label": ": {element_type}[]",
      "position": "after",
      "paddingLeft": true,
      "description": "Array literal type hints"
    },
    {
      "kind": 1,
      "pattern": "\\{([^}]+)\\}",
      "label": ": {object_type}",
      "position": "after",
      "paddingLeft": true,
      "description": "Object literal type hints"
    },
    {
      "kind": 2,
      "pattern": "\\b\\d+\\.?\\d*\\b",
      "label": "{param_name}:",
      "position": "before",
      "paddingRight": true,
      "description": "Numeric literal parameter hints"
    },
    {
      "kind": 2,
      "pattern": "\"[^\"]*\"",
      "label": "{param_name}:",
      "position": "before",
      "paddingRight": true,
      "description": "String literal parameter hints"
    },
    {
      "kind": 1,
      "pattern": "\\blambda\\b|=>|->",
      "label": ": {callback_type}",
      "position": "after",
      "paddingLeft": true,
      "description": "Lambda/arrow function type hints"
    },
    {
      "kind": 1,
      "pattern": "\\.(\\w+)\\(\\)",
      "label": ": {chain_type}",
      "position": "after",
      "paddingLeft": true,
      "description": "Chained expression type hints"
    },
    {
      "kind": 1,
      "pattern": "\\bnew\\s+\\w+",
      "label": ": {constructor_type}",
      "position": "after",
      "paddingLeft": true,
      "description": "Constructor call type hints"
    },
    {
      "kind": 2,
      "pattern": "\\b[A-Z][A-Z0-9_]+\\b",
      "label": "{enum_member}",
      "position": "before",
      "paddingRight": true,
      "description": "Enum value hints"
    }
  ],
  "typeInferenceRules": {
    "string_literal": {
      "pattern": "['\"].*['\"]",
      "type": "string"
    },
    "number_literal": {
      "pattern": "\\d+(\\.\\d+)?",
      "type": "number"
    },
    "boolean_literal": {
      "pattern": "\\b(true|false)\\b",
      "type": "boolean"
    },
    "array_literal": {
      "pattern": "\\[.*\\]",
      "type": "array"
    },
    "null_literal": {
      "pattern": "\\b(null|nil|None|undefined)\\b",
      "type": "null"
    },
    "duration_literal": {
      "pattern": "\\d+[smh]",
      "type": "duration"
    },
    "bytes_literal": {
      "pattern": "\\d+[bBkKmMgG]",
      "type": "bytes"
    },
    "object_literal": {
      "pattern": "\\{.*\\}",
      "type": "object"
    },
    "regex_literal": {
      "pattern": "\\/.*\\/[gimsuy]*",
      "type": "regexp"
    },
    "function_expression": {
      "pattern": "(function|=>|->|lambda|fn|fun)",
      "type": "function"
    },
    "template_string": {
      "pattern": "`[^`]*`",
      "type": "string"
    },
    "tuple_literal": {
      "pattern": "\\(.*,.*\\)",
      "type": "tuple"
    }
  }
}
