{
  "language": "haskell",
  "inlineCompletions": [
    {
      "triggerPattern": "^module\\s+$",
      "insertText": "Main (main) where",
      "description": "Module header with an explicit export list",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "^main\\s*$",
      "insertText": " :: IO ()\nmain = do\n  ",
      "description": "main entry point",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "^import\\s+$",
      "insertText": "qualified Data.Map.Strict as Map",
      "description": "Qualified Map import, the usual convention",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "^data\\s+\\w+\\s*$",
      "insertText": " = \n  deriving (Show, Eq)",
      "description": "Data declaration with derived instances",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "^newtype\\s+(\\w+)\\s*$",
      "insertText": " = $1 { un$1 :: }",
      "description": "Newtype with an un-prefixed accessor",
      "completeBracketPairs": true
    },
    {
      "triggerPattern": "\\bcase\\s+\\w+\\s+of\\s*$",
      "insertText": "\n  Just x  -> \n  Nothing -> ",
      "description": "Maybe alternatives",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "\\bcase\\s+\\w+\\s+of\\s*$",
      "insertText": "\n  Left err -> \n  Right v  -> ",
      "description": "Either alternatives",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "^instance\\s+Show\\s+\\w+\\s*$",
      "insertText": " where\n  show = ",
      "description": "Show instance",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "\\{-#\\s*$",
      "insertText": " LANGUAGE OverloadedStrings #-}",
      "description": "LANGUAGE pragma",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "\\bwhere\\s*$",
      "insertText": "\n  ",
      "description": "Open a where block",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "\\bdo\\s*$",
      "insertText": "\n  ",
      "description": "Open a do block",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "\\bforM_\\s*$",
      "insertText": " xs $ \\x -> do\n  ",
      "description": "Iterate for effect",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "\\bbracket\\s*$",
      "insertText": " acquire release $ \\r -> do\n  ",
      "description": "Exception-safe resource use",
      "completeBracketPairs": false
    },
    {
      "triggerPattern": "^prop_\\w*\\s*$",
      "insertText": " :: Int -> Bool\nprop_ = ",
      "description": "QuickCheck property",
      "completeBracketPairs": false
    }
  ]
}
