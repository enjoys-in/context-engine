{
  "language": "haskell",
  "identifierPattern": "[A-Za-z_][A-Za-z0-9_']*",
  "includeDeclaration": true,
  "referencePatterns": [
    {
      "symbol": "map",
      "patterns": [
        "\\bmap\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of map"
    },
    {
      "symbol": "filter",
      "patterns": [
        "\\bfilter\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of filter"
    },
    {
      "symbol": "foldr",
      "patterns": [
        "\\bfoldr\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of foldr"
    },
    {
      "symbol": "fmap",
      "patterns": [
        "\\bfmap\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of fmap"
    },
    {
      "symbol": "pure",
      "patterns": [
        "\\bpure\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of pure"
    },
    {
      "symbol": "traverse",
      "patterns": [
        "\\btraverse\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of traverse"
    },
    {
      "symbol": "Just",
      "patterns": [
        "\\bJust\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of Just"
    },
    {
      "symbol": "Nothing",
      "patterns": [
        "\\bNothing\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of Nothing"
    },
    {
      "symbol": "Left",
      "patterns": [
        "\\bLeft\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of Left"
    },
    {
      "symbol": "Right",
      "patterns": [
        "\\bRight\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of Right"
    },
    {
      "symbol": "putStrLn",
      "patterns": [
        "\\bputStrLn\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of putStrLn"
    },
    {
      "symbol": "return",
      "patterns": [
        "\\breturn\\b"
      ],
      "includeDeclaration": true,
      "description": "Find all usages of return"
    },
    {
      "name": "function_definition",
      "symbol": "function_definition",
      "patterns": [
        "^([a-z_]\\w*'?)\\s*::"
      ],
      "includeDeclaration": true,
      "description": "Type signatures"
    },
    {
      "name": "data_definition",
      "symbol": "data_definition",
      "patterns": [
        "^(?:data|newtype)\\s+([A-Z]\\w*)"
      ],
      "includeDeclaration": true,
      "description": "Data declarations"
    },
    {
      "name": "import_statement",
      "symbol": "import_statement",
      "patterns": [
        "^import\\s+(?:qualified\\s+)?([A-Z][\\w.]*)"
      ],
      "includeDeclaration": true,
      "description": "Imports"
    },
    {
      "name": "function_call",
      "symbol": "function_call",
      "patterns": [
        "\\b([a-z_]\\w*'?)\\s+[\\w(\\[\"]"
      ],
      "includeDeclaration": false,
      "description": "Application sites"
    }
  ]
}
