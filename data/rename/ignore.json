{
  "language": "ignore",
  "wordPattern": "[A-Za-z0-9_.*?/-]+",
  "identifierRules": {
    "start": "[A-Za-z0-9_.*?/-]",
    "continue": "[A-Za-z0-9_.*?/-]",
    "forbidden": [
      "#"
    ],
    "validPattern": "^[^#\\s][^\\s]*$",
    "reservedWords": [
      ".gitignore",
      ".dockerignore",
      ".npmignore",
      "#",
      "!",
      "*",
      "**",
      "?"
    ],
    "caseSensitive": true
  },
  "renameValidation": {
    "allowEmpty": false,
    "maxLength": 255,
    "pattern": "^[^#\\s][^\\s]*$",
    "rejectPattern": "^#|\\s",
    "allowEmptyName": false
  },
  "prepareRenamePatterns": [
    {
      "pattern": "^\\s*!?([^#\\s]\\S*)\\s*$",
      "captureGroup": 1,
      "description": "Ignore pattern entry"
    }
  ],
  "renameStrategy": {
    "scopeAware": false,
    "updateImports": false,
    "updateStrings": false,
    "updateComments": false,
    "preview": true
  }
}
