{
  "language": "prisma",
  "offSide": false,
  "markers": {
    "start": "^\\s*//\\s*region\\b",
    "end": "^\\s*//\\s*endregion\\b"
  },
  "foldingRules": [
    {
      "kind": "comment",
      "startPattern": "^\\s*///",
      "endPattern": "^(?!\\s*///)",
      "description": "Consecutive documentation comments",
      "groupConsecutive": true
    },
    {
      "kind": "comment",
      "startPattern": "^\\s*//(?!/)",
      "endPattern": "^(?!\\s*//(?!/))",
      "description": "Consecutive line comments",
      "groupConsecutive": true
    },
    {
      "kind": "region",
      "startPattern": "^\\s*model\\s+\\w+\\s*\\{",
      "endPattern": "^\\s*\\}",
      "description": "model block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*enum\\s+\\w+\\s*\\{",
      "endPattern": "^\\s*\\}",
      "description": "enum block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*type\\s+\\w+\\s*\\{",
      "endPattern": "^\\s*\\}",
      "description": "composite type block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*view\\s+\\w+\\s*\\{",
      "endPattern": "^\\s*\\}",
      "description": "view block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*datasource\\s+\\w+\\s*\\{",
      "endPattern": "^\\s*\\}",
      "description": "datasource block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*generator\\s+\\w+\\s*\\{",
      "endPattern": "^\\s*\\}",
      "description": "generator block"
    }
  ]
}
