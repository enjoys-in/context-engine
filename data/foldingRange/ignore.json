{
  "language": "ignore",
  "offSide": false,
  "markers": {
    "start": "^\\s*#\\s*region\\b",
    "end": "^\\s*#\\s*endregion\\b"
  },
  "foldingRules": [
    {
      "kind": "comment",
      "startPattern": "^\\s*#",
      "endPattern": "^(?!\\s*#)",
      "description": "Consecutive comment lines",
      "groupConsecutive": true
    },
    {
      "kind": "region",
      "startPattern": "^\\s*#\\s*[-=]{3,}",
      "endPattern": "^\\s*$|^\\s*#\\s*[-=]{3,}",
      "description": "Comment-delimited section block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*#.*:\\s*$",
      "endPattern": "^\\s*$",
      "description": "Labeled group of ignore patterns"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*!",
      "endPattern": "^(?!\\s*!)",
      "description": "Consecutive negation (re-include) patterns",
      "groupConsecutive": true
    }
  ]
}
