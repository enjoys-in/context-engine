{
  "language": "haskell",
  "offSide": true,
  "markers": {
    "start": "^\\s*--\\s*#region\\b",
    "end": "^\\s*--\\s*#endregion\\b"
  },
  "foldingRules": [
    {
      "kind": "region",
      "startPattern": "^\\s*(?:data|newtype)\\s+\\w+.*=\\s*$",
      "endPattern": "",
      "description": "Data declaration spanning lines"
    },
    {
      "kind": "region",
      "startPattern": "\\bwhere\\s*$",
      "endPattern": "",
      "description": "where block (layout-based)"
    },
    {
      "kind": "region",
      "startPattern": "\\bdo\\s*$",
      "endPattern": "",
      "description": "do block (layout-based)"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*(?:class|instance)\\b.*\\bwhere\\s*$",
      "endPattern": "",
      "description": "class or instance body"
    },
    {
      "kind": "region",
      "startPattern": "\\bcase\\b.*\\bof\\s*$",
      "endPattern": "",
      "description": "case alternatives"
    },
    {
      "kind": "comment",
      "startPattern": "\\{-",
      "endPattern": "-\\}",
      "description": "Block comment, including Haddock {-|"
    },
    {
      "kind": "imports",
      "startPattern": "^import\\b",
      "endPattern": "",
      "description": "Import block"
    },
    {
      "kind": "region",
      "startPattern": "^\\s*--\\s*#region\\b",
      "endPattern": "^\\s*--\\s*#endregion\\b",
      "description": "Manual region markers"
    }
  ]
}
