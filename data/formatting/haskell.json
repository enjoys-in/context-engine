{
  "language": "haskell",
  "formatting": {
    "defaultTabSize": 2,
    "defaultInsertSpaces": true,
    "rules": [
      {
        "description": "Remove trailing whitespace",
        "pattern": "[ \\t]+$",
        "replacement": ""
      },
      {
        "description": "Normalize line endings to LF",
        "pattern": "\\r\\n",
        "replacement": "\n"
      },
      {
        "description": "Ensure newline at end of file",
        "pattern": "(?<!\\n)$",
        "replacement": "\n"
      },
      {
        "description": "Normalize multiple blank lines to single",
        "pattern": "\\n{3,}",
        "replacement": "\n\n"
      },
      {
        "description": "Ensure single space after comma",
        "pattern": ",(\\S)",
        "replacement": ", $1"
      },
      {
        "description": "Space around the type annotation operator",
        "pattern": "(\\S)::(\\S)",
        "replacement": "$1 :: $2"
      },
      {
        "description": "Space around the function arrow",
        "pattern": "(\\S)->(\\S)",
        "replacement": "$1 -> $2"
      },
      {
        "description": "Space around the constraint arrow",
        "pattern": "(\\S)=>(\\S)",
        "replacement": "$1 => $2"
      },
      {
        "description": "Space around the bind arrow",
        "pattern": "(\\S)<-(\\S)",
        "replacement": "$1 <- $2"
      },
      {
        "description": "Remove space inside parentheses",
        "pattern": "\\(\\s+",
        "replacement": "("
      },
      {
        "description": "Remove space before closing parenthesis",
        "pattern": "\\s+\\)",
        "replacement": ")"
      },
      {
        "description": "Tabs to two spaces (tabs are unsafe with layout)",
        "pattern": "\\t",
        "replacement": "  "
      }
    ],
    "indentation": {
      "increasePattern": "(\\b(where|do|of|let)\\s*$)|(=\\s*$)",
      "decreasePattern": "^\\s*(in\\b|\\}|\\)|\\])"
    }
  }
}
