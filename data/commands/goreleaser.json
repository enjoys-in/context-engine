{
  "name": "goreleaser",
  "description": "Build and release Go projects",
  "category": "go",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build the binaries without releasing",
      "options": [
        {
          "name": "--snapshot",
          "description": "Build without requiring a clean tag",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--single-target",
          "description": "Build only for the current platform",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--clean",
          "description": "Remove the dist directory first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--id",
          "description": "Only build this build id",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the binary here",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "release",
      "description": "Build and publish a release",
      "options": [
        {
          "name": "--snapshot",
          "description": "Build without publishing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--clean",
          "description": "Remove the dist directory first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip",
          "description": "Steps to skip (publish, validate, sign)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--draft",
          "description": "Publish as a draft release",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--release-notes",
          "description": "File containing the release notes",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check",
      "description": "Validate the configuration",
      "options": [
        {
          "name": "--deprecated",
          "description": "Fail on deprecated options",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "init",
      "description": "Create a starter .goreleaser.yaml"
    },
    {
      "name": "healthcheck",
      "description": "Verify the required external tools are installed"
    },
    {
      "name": "schema",
      "description": "Print the configuration JSON schema"
    },
    {
      "name": "changelog",
      "description": "Print the generated changelog"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--timeout",
      "description": "Overall timeout",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--parallelism",
      "description": "Concurrent build jobs",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    }
  ],
  "examples": [
    {
      "command": "goreleaser init",
      "description": "Create a starter configuration"
    },
    {
      "command": "goreleaser build --snapshot --clean",
      "description": "Build locally without a tag"
    },
    {
      "command": "goreleaser release --clean",
      "description": "Build and publish a release"
    },
    {
      "command": "goreleaser check",
      "description": "Validate the configuration"
    }
  ],
  "relatedCommands": [
    "go",
    "git",
    "docker",
    "cosign",
    "syft"
  ]
}
