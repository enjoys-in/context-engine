{
  "name": "linkerd",
  "description": "Linkerd service mesh CLI",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Generate Linkerd install manifest",
      "examples": [
        "linkerd install | kubectl apply -f -",
        "linkerd install --crds | kubectl apply -f -"
      ],
      "options": [
        {
          "name": "--set",
          "description": "Override a Helm value, key=value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ha",
          "description": "Install in high-availability mode",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--crds",
          "description": "Install only the CRDs",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--identity-trust-anchors-file",
          "description": "Trust anchor certificate",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check",
      "description": "Check installation health",
      "examples": [
        "linkerd check",
        "linkerd check --pre",
        "linkerd check --proxy"
      ],
      "options": [
        {
          "name": "--pre",
          "description": "Check prerequisites only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--proxy",
          "description": "Check the data plane",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format (table, json, short)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--wait",
          "description": "How long to wait for checks",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "inject",
      "description": "Inject sidecar proxy",
      "examples": [
        "linkerd inject deployment.yaml | kubectl apply -f -",
        "cat deploy.yaml | linkerd inject - | kubectl apply -f -"
      ],
      "options": [
        {
          "name": "--manual",
          "description": "Inject the full proxy specification",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ingress",
          "description": "Inject as an ingress proxy",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-inbound-ports",
          "description": "Ports to bypass inbound",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--skip-outbound-ports",
          "description": "Ports to bypass outbound",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "uninject",
      "description": "Remove sidecar proxy",
      "examples": [
        "linkerd uninject deployment.yaml | kubectl apply -f -"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: yaml or json",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "stat",
      "description": "Traffic statistics",
      "examples": [
        "linkerd stat deploy",
        "linkerd stat deploy -n my-ns",
        "linkerd stat po -n my-ns --from deploy/frontend"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all-namespaces",
          "description": "Every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--time-window",
          "description": "Window to aggregate over",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--from",
          "description": "Only traffic from this resource",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "top",
      "description": "Real-time traffic view",
      "examples": [
        "linkerd top deploy/my-app",
        "linkerd top deploy/my-app --namespace my-ns"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--to",
          "description": "Only traffic to this resource",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from",
          "description": "Only traffic from this resource",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Only this request path",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "tap",
      "description": "Tap live traffic",
      "examples": [
        "linkerd tap deploy/my-app",
        "linkerd tap ns/my-ns --to deploy/backend"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--to",
          "description": "Only traffic to this resource",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Only this request path",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--max-rps",
          "description": "Requests per second cap",
          "type": "number",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "routes",
      "description": "per-route metrics",
      "examples": [
        "linkerd routes deploy/my-app",
        "linkerd routes deploy/my-app --to svc/backend"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--to",
          "description": "Only traffic to this resource",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--time-window",
          "description": "Window to aggregate over",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "edges",
      "description": "Show edges between resources",
      "examples": [
        "linkerd edges deploy -n my-ns"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all-namespaces",
          "description": "Every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "profile",
      "description": "Manage service profiles",
      "examples": [
        "linkerd profile --open-api spec.yaml my-svc | kubectl apply -f -"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--template",
          "description": "Print a template profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--open-api",
          "description": "Generate from an OpenAPI spec",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--proto",
          "description": "Generate from a protobuf definition",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--tap",
          "description": "Generate by observing live traffic",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "viz",
      "description": "Viz extension commands",
      "examples": [
        "linkerd viz install | kubectl apply -f -",
        "linkerd viz dashboard",
        "linkerd viz stat deploy"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--set",
          "description": "Override a Helm value",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "multicluster",
      "description": "Multi-cluster commands",
      "examples": [
        "linkerd multicluster install | kubectl apply -f -",
        "linkerd multicluster link --cluster-name target"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--set",
          "description": "Override a Helm value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cluster-name",
          "description": "Cluster name to link",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade Linkerd",
      "examples": [
        "linkerd upgrade | kubectl apply -f -"
      ],
      "options": [
        {
          "name": "--set",
          "description": "Override a Helm value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--crds",
          "description": "Upgrade only the CRDs",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall Linkerd",
      "examples": [
        "linkerd uninstall | kubectl delete -f -"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to uninstall from",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "linkerd version"
      ],
      "options": [
        {
          "name": "--client",
          "description": "Print only the client version",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--short",
          "description": "Print just the version number",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--api-addr",
      "description": "API address override",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--as",
      "description": "Impersonate user",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "linkerd install | kubectl apply -f -",
    "linkerd check",
    "linkerd inject deployment.yaml | kubectl apply -f -",
    "linkerd stat deploy",
    "linkerd top deploy/my-app",
    "linkerd tap deploy/my-app",
    "linkerd viz dashboard",
    "linkerd version"
  ],
  "relatedCommands": [
    "kubectl",
    "istioctl",
    "helm",
    "nginx"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Linkerd CLI and control-plane versions",
        "command": "linkerd version --client --short 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "linkerd"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "check",
        "description": "Linkerd control-plane health",
        "command": "linkerd check --output short 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "linkerd"
      }
    ]
  }
}
