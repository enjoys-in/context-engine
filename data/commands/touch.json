{
  "name": "touch",
  "description": "Change file timestamps or create empty files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-a",
      "description": "Change only the access time"
    },
    {
      "name": "-m",
      "description": "Change only the modification time"
    },
    {
      "name": "-c",
      "description": "Do not create any files"
    },
    {
      "name": "-t",
      "description": "Use timestamp instead of current time",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-r",
      "description": "Use reference file's times",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Parse date string",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "touch newfile.txt",
    "touch -c existing.txt",
    "touch -t 202301011200 file.txt",
    "touch -r ref.txt target.txt",
    "touch file1 file2 file3"
  ],
  "relatedCommands": [
    "mkdir",
    "stat",
    "date",
    "ls"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "touch version",
        "command": "touch --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "touch"
      },
      {
        "name": "recent_files",
        "description": "Most recently modified files here",
        "command": "ls -t 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "writable",
        "description": "Whether the current directory is writable",
        "command": "test -w . && echo writable || echo read-only",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
