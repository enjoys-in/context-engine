{
  "name": "id",
  "description": "Print user and group information",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-u",
      "description": "Print only the effective user ID"
    },
    {
      "name": "-g",
      "description": "Print only the effective group ID"
    },
    {
      "name": "-G",
      "description": "Print all group IDs"
    },
    {
      "name": "-n",
      "description": "Print name instead of number (with -u/-g/-G)"
    },
    {
      "name": "-r",
      "description": "Print real ID instead of effective"
    }
  ],
  "examples": [
    "id",
    "id -u",
    "id -un",
    "id -Gn",
    "id root",
    "id -g"
  ],
  "relatedCommands": [
    "whoami",
    "groups",
    "who"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "identity",
        "description": "Current user, group and supplementary groups",
        "command": "id 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "id"
      },
      {
        "name": "groups",
        "description": "Groups the current user belongs to",
        "command": "groups 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "user",
        "description": "Effective user name",
        "command": "id -un 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "id"
      }
    ]
  }
}
