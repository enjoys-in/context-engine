{
  "name": "gpg",
  "description": "GNU Privacy Guard — encrypt, sign, verify data",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Symmetric encryption"
    },
    {
      "name": "-e",
      "description": "Encrypt"
    },
    {
      "name": "-d",
      "description": "Decrypt"
    },
    {
      "name": "-s",
      "description": "Sign"
    },
    {
      "name": "--verify",
      "description": "Verify a signature"
    },
    {
      "name": "-r",
      "description": "Recipient",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--armor",
      "short": "-a",
      "description": "ASCII armor output",
      "shorthand": "-a"
    },
    {
      "name": "--gen-key",
      "description": "Generate a new key pair"
    },
    {
      "name": "--list-keys",
      "description": "List public keys"
    },
    {
      "name": "--list-secret-keys",
      "description": "List private keys"
    },
    {
      "name": "--import",
      "description": "Import keys"
    },
    {
      "name": "--export",
      "description": "Export public key"
    },
    {
      "name": "--delete-key",
      "description": "Delete public key"
    },
    {
      "name": "--fingerprint",
      "description": "Show key fingerprint"
    },
    {
      "name": "--keyserver",
      "description": "Key server URL",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--recv-keys",
      "description": "Receive keys from keyserver",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sign-key",
      "description": "Sign a key",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--encrypt",
      "description": "Encrypt data",
      "type": "boolean",
      "takesValue": false,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--decrypt",
      "description": "Decrypt data",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--sign",
      "description": "Make a signature",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--clearsign",
      "description": "Make a clear-text signature",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--detach-sign",
      "description": "Make a detached signature",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--symmetric",
      "description": "Encrypt with a passphrase only",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--recipient",
      "description": "Encrypt for this key",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--local-user",
      "description": "Sign with this key",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--output",
      "description": "Write the result here",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--full-generate-key",
      "description": "Generate a key pair with full options",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quick-generate-key",
      "description": "Generate a key pair quickly",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--export-secret-keys",
      "description": "Export secret keys",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--delete-keys",
      "description": "Delete public keys",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--delete-secret-keys",
      "description": "Delete secret keys",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--edit-key",
      "description": "Edit a key interactively",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--trust-model",
      "description": "Trust model to apply",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--send-keys",
      "description": "Publish keys to the keyserver",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--batch",
      "description": "Run without prompting",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--yes",
      "description": "Assume yes to every question",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--passphrase",
      "description": "Passphrase to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--pinentry-mode",
      "description": "Pinentry mode, e.g. loopback",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--cipher-algo",
      "description": "Cipher algorithm to use",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "gpg -c file.txt",
    "gpg -d file.txt.gpg",
    "gpg -e -r user@example.com file.txt",
    "gpg --gen-key",
    "gpg --list-keys",
    "gpg --armor --export user@example.com",
    "gpg --verify sig.asc file.txt"
  ],
  "relatedCommands": [
    "age",
    "openssl",
    "ssh-keygen",
    "sops"
  ]
}
