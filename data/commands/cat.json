{
  "name": "cat",
  "description": "Concatenate and display file contents",
  "category": "text-processing",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Number all output lines"
    },
    {
      "name": "-b",
      "description": "Number non-blank output lines"
    },
    {
      "name": "-s",
      "description": "Squeeze multiple blank lines"
    },
    {
      "name": "-E",
      "description": "Display $ at end of each line"
    },
    {
      "name": "-T",
      "description": "Display TAB as ^I"
    },
    {
      "name": "-A",
      "description": "Show all (equivalent to -vET)"
    }
  ],
  "examples": [
    "cat file.txt",
    "cat -n file.txt",
    "cat file1.txt file2.txt > combined.txt",
    "cat -b script.sh"
  ],
  "relatedCommands": [
    "less",
    "more",
    "head",
    "tail",
    "bat",
    "tac"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "cat version",
        "command": "cat --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cat"
      },
      {
        "name": "cwd_files",
        "description": "Readable files in this directory",
        "command": "find . -maxdepth 1 -type f 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 30
      }
    ]
  }
}
