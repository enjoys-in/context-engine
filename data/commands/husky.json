{
  "name": "husky",
  "description": "Modern native Git hooks made easy",
  "category": "git",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize Husky in a project",
      "examples": [
        "npx husky init"
      ]
    },
    {
      "name": "add",
      "description": "Add a hook",
      "examples": [
        "npx husky add .husky/pre-commit 'npm test'"
      ],
      "args": [
        {
          "name": "file",
          "description": "Hook file to add",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install Git hooks",
      "examples": [
        "npx husky install"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "npx husky init",
    "npx husky add .husky/pre-commit 'npm test'",
    "npx husky add .husky/commit-msg 'npx commitlint --edit $1'",
    "npx husky install"
  ],
  "relatedCommands": [
    "commitlint",
    "lint-staged",
    "git",
    "pre-commit"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "husky version",
        "command": "husky --version 2>/dev/null || npx husky --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "hooks",
        "description": "Hooks husky manages in this repository",
        "command": "ls .husky 2>/dev/null | grep -v '^_$'",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "hooks_path",
        "description": "Git hooks path husky installed",
        "command": "git config --get core.hooksPath 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
