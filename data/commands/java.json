{
  "language": "java",
  "name": "java",
  "description": "Java application launcher",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-version",
      "description": "Display version"
    },
    {
      "name": "-jar",
      "description": "Execute a JAR file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-cp",
      "description": "Classpath",
      "type": "path",
      "takesValue": true
    },
    {
      "name": "-classpath",
      "description": "Classpath (alias)",
      "type": "path",
      "takesValue": true
    },
    {
      "name": "-Xmx",
      "description": "Maximum heap size",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-Xms",
      "description": "Initial heap size",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-Xss",
      "description": "Thread stack size",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Set system property",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-server",
      "description": "Use server JVM"
    },
    {
      "name": "-verbose",
      "description": "Verbose output"
    },
    {
      "name": "--enable-preview",
      "description": "Enable preview features"
    },
    {
      "name": "-ea",
      "description": "Enable assertions"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    }
  ],
  "subcommands": [],
  "examples": [
    "java -version",
    "java -jar app.jar",
    "java -Xmx512m -jar app.jar",
    "java -cp lib/*:. com.example.Main",
    "java -Dserver.port=8080 -jar app.jar",
    "java --enable-preview Main.java"
  ],
  "relatedCommands": [
    "javac",
    "mvn",
    "gradle",
    "jpackage",
    "jshell",
    "jar"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Java runtime version",
        "command": "java -version 2>&1 | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "java"
      },
      {
        "name": "home",
        "description": "JAVA_HOME in effect",
        "command": "echo \"${JAVA_HOME:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "installed",
        "description": "JDKs installed on this machine",
        "command": "ls /usr/lib/jvm 2>/dev/null || /usr/libexec/java_home -V 2>&1 | head -10",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "build_files",
        "description": "Java build files in this project",
        "command": "ls pom.xml build.gradle build.gradle.kts 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "jars",
        "description": "Runnable JARs in this project",
        "command": "find . -maxdepth 3 -name '*.jar' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
