{
  "name": "vue",
  "description": "Vue CLI",
  "category": "Frontend Frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "create",
      "description": "Create a new project powered by vue-cli-service",
      "options": [
        {
          "name": "--default",
          "description": "Use the default preset",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--force",
          "description": "Overwrite an existing directory",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--preset",
          "description": "Preset to scaffold from",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--merge",
          "description": "Merge into an existing directory",
          "type": "boolean",
          "takesValue": false,
          "short": "-m",
          "shorthand": "-m"
        }
      ]
    },
    {
      "name": "add",
      "description": "Install a plugin and invoke its generator in an already created project",
      "options": [
        {
          "name": "--registry",
          "description": "Registry to install the plugin from",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "invoke",
      "description": "Invoke the generator of a plugin in an already created project",
      "options": [
        {
          "name": "--registry",
          "description": "Registry to resolve the plugin from",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "serve",
      "description": "Serve a .js or .vue file in development mode with zero config",
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--open",
          "description": "Open a browser on start",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--copy",
          "description": "Copy the local URL to the clipboard",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "vue create my-app",
      "description": "Create a new Vue project"
    },
    {
      "command": "vue add router",
      "description": "Add Vue Router to project"
    }
  ],
  "relatedCommands": [
    "npm",
    "vite",
    "nuxt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "vue_config",
        "description": "Vue CLI Configuration",
        "command": "cat vue.config.js 2>/dev/null | head -10",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
