{
  "name": "kn",
  "description": "Knative CLI — manage serverless workloads on Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "service",
      "description": "Manage Knative services",
      "examples": [
        "kn service list",
        "kn service create my-svc --image gcr.io/my/image",
        "kn service create my-svc --image gcr.io/my/image --env KEY=value --port 8080",
        "kn service update my-svc --env KEY=newvalue",
        "kn service update my-svc --scale-min 1 --scale-max 10",
        "kn service describe my-svc",
        "kn service delete my-svc",
        "kn service apply my-svc --image gcr.io/my/image"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml, name or go-template",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against service, such as list",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "revision",
