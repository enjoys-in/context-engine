  "globalOptions": [
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output format (json, yaml, name, url)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--cluster",
      "description": "Cluster name",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "kn service list",
    "kn service create my-svc --image gcr.io/my/image",
    "kn service update my-svc --env KEY=value",
    "kn revision list",
    "kn source ping create my-ping --sink ksvc:my-svc --schedule '*/1 * * * *'",
    "kn broker create default",
    "kn trigger create my-trigger --broker default --sink ksvc:my-svc"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "serverless",
    "kamel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Knative CLI version",
        "command": "kn version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "kn"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "services",
        "description": "Knative services in the active namespace",
        "command": "kn service list -o name 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "kn"
      },
      {
        "name": "revisions",
        "description": "Knative revisions",
        "command": "kn revision list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "kn"
      }
    ]
  }
}
