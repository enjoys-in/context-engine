{
  "language": "flow9",
  "name": "flowc",
  "description": "Flow9 — functional programming language compiler (area9)",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--js",
      "description": "Compile to JavaScript output"
    },
    {
      "name": "--bytecode",
      "description": "Compile to Flow bytecode"
    },
    {
      "name": "--java",
      "description": "Compile to Java output"
    },
    {
      "name": "-I",
      "description": "Add include path for imports"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode"
    },
    {
      "name": "--verbose",
      "description": "Verbose compilation output"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "file.flow",
      "description": "Compile Flow9 program",
      "args": [
        {
          "name": "file",
          "description": "Flow source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose compiler output",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--js file.flow",
      "description": "Compile to JavaScript target",
      "args": [
        {
          "name": "file",
          "description": "Flow source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--jsmodule",
          "description": "JavaScript module format to emit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--esversion",
          "description": "ECMAScript version to target",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--bytecode file.flow",
      "description": "Compile to bytecode",
      "args": [
        {
          "name": "file",
          "description": "Flow source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose compiler output",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--java file.flow",
      "description": "Compile to Java target",
      "args": [
        {
          "name": "file",
          "description": "Flow source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--javapackage",
          "description": "Java package for the generated code",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--html file.flow",
      "description": "Compile and generate HTML wrapper",
      "args": [
        {
          "name": "file",
          "description": "Flow source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--jsmodule",
          "description": "JavaScript module format to emit",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "flowc1 --js myapp.flow",
    "flowc1 --bytecode myapp.flow",
    "flowc1 --java myapp.flow",
    "flowcpp myapp.flow"
  ],
  "relatedCommands": [
    "node",
    "java",
    "typescript"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Flow9 compiler version",
        "command": "flowc1 --version 2>/dev/null || flowc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "sources",
        "description": "Flow sources in this project",
        "command": "find . -maxdepth 3 -name '*.flow' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "flow_config",
        "description": "Flow9 configuration",
        "command": "cat flow.config 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300
      }
    ]
  }
}
