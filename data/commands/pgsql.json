        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--quiet",
          "description": "Suppress informational output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--full",
          "description": "Reclaim space by rewriting the table",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--analyze",
          "description": "Update the planner statistics too",
          "type": "boolean",
          "takesValue": false,
          "short": "-z",
          "shorthand": "-z"
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ],
      "examples": [
