        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
