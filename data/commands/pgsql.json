    {
      "name": "dump",
      "description": "Dump database",
      "usage": "pg_dump -h localhost -U user dbname > backup.sql",
      "options": [
        {
          "name": "--host",
          "description": "Database server host",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Database server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--quiet",
          "description": "Suppress informational output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--format",
          "description": "Dump format: plain, custom, directory or tar",
          "type": "string",
          "takesValue": true,
          "short": "-F",
          "shorthand": "-F"
        },
        {
          "name": "--schema-only",
          "description": "Dump the schema without data",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--data-only",
          "description": "Dump the data without the schema",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--file",
          "description": "Write the dump here",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "psql dump"
      ]
    },
    {
      "name": "restore",
      "description": "Restore database",
      "usage": "pg_restore -h localhost -U user -d dbname backup.dump",
      "options": [
        {
          "name": "--host",
          "description": "Database server host",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Database server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--quiet",
          "description": "Suppress informational output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--clean",
          "description": "Drop objects before recreating them",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--jobs",
          "description": "Number of parallel restore jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--no-owner",
          "description": "Do not restore ownership",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Dump file to restore",
          "required": false,
          "type": "file"
        }
      ],
      "examples": [
        "psql restore file.txt"
      ]
    },
    {
      "name": "vacuum",
      "description": "Vacuum database",
      "usage": "vacuumdb -h localhost -U user dbname",
      "options": [
        {
          "name": "--host",
