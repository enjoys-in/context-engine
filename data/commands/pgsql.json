  ],
  "examples": [
    {
      "command": "psql -h localhost -U postgres mydb",
      "description": "Connect to PostgreSQL database"
    },
    {
      "command": "pg_dump -h localhost -U postgres mydb > backup.sql",
      "description": "Dump database to SQL"
    },
    {
      "command": "pg_restore -d mydb backup.dump",
      "description": "Restore from dump file"
    },
    {
      "command": "createdb mydb",
      "description": "Create a new database"
    }
  ],
  "relatedCommands": [
    "psql",
    "pg_dump",
    "pg_restore",
    "createdb"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "psql client version",
        "command": "psql --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "psql"
      },
      {
        "name": "connection",
        "description": "PostgreSQL connection settings in effect",
        "command": "echo \"host=${PGHOST:-localhost} port=${PGPORT:-5432} db=${PGDATABASE:-unset} user=${PGUSER:-$USER}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "databases",
        "description": "Databases on the configured server",
        "command": "psql -lqt 2>/dev/null | cut -d'|' -f1 | head -25",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "psql"
      },
      {
        "name": "service_file",
        "description": "PostgreSQL service definitions",
        "command": "grep -o '^\\[.*\\]' ~/.pg_service.conf 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
