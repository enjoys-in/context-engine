      "options": [
        {
          "name": "--host",
          "description": "Database server host",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Database server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
