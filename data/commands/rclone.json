{
  "name": "rclone",
  "description": "rclone — sync files to and from cloud storage",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "config",
      "description": "Interactive configuration",
      "examples": [
        "rclone config",
        "rclone config show",
        "rclone config create myremote s3 provider=AWS env_auth=true region=us-east-1"
      ],
      "options": [
        {
          "name": "--obscure",
          "description": "Obscure passwords in the config",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--non-interactive",
          "description": "Do not prompt",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "copy",
      "description": "Copy files src to dst",
      "examples": [
        "rclone copy /local/path remote:bucket/path",
        "rclone copy remote:bucket/path /local/path",
        "rclone copy src:path dst:path"
      ],
      "options": [
        {
          "name": "--update",
          "description": "Skip files newer at the destination",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--max-age",
          "description": "Only files younger than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--min-size",
          "description": "Only files at least this size",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ignore-existing",
          "description": "Skip files that already exist",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--create-empty-src-dirs",
          "description": "Recreate empty source directories",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path or URL",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path or URL",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "sync",
      "description": "Sync src to dst (make identical)",
      "examples": [
        "rclone sync /local/path remote:bucket/",
        "rclone sync remote:bucket/ /local/path",
        "rclone sync --dry-run /local/ remote:bucket/"
      ],
      "options": [
        {
          "name": "--delete-during",
          "description": "Delete during the transfer rather than after",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--track-renames",
          "description": "Detect renames instead of re-uploading",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--backup-dir",
          "description": "Move replaced files here",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--max-delete",
          "description": "Abort if more than this many files would be deleted",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "move",
      "description": "Move files src to dst",
      "examples": [
        "rclone move /local/path remote:bucket/",
        "rclone move --delete-empty-src-dirs /local/ remote:bucket/"
      ],
      "options": [
        {
          "name": "--delete-empty-src-dirs",
          "description": "Remove source directories left empty",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path or URL",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path or URL",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "ls",
      "description": "List objects with size",
      "examples": [
        "rclone ls remote:bucket/",
        "rclone ls remote:bucket/prefix/"
      ],
      "options": [
        {
          "name": "--max-depth",
          "description": "Directory depth to descend",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--include-from",
          "description": "Read include patterns from this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "lsd",
      "description": "List directories",
      "examples": [
        "rclone lsd remote:",
        "rclone lsd remote:bucket/"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--dry-run",
          "description": "Report what would change without doing it",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--transfers",
          "description": "Number of parallel transfers",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--progress",
          "description": "Show live transfer progress",
          "type": "boolean",
          "takesValue": false,
          "short": "-P",
          "shorthand": "-P"
        },
        {
          "name": "--recursive",
          "description": "Recurse into subdirectories",
          "type": "boolean",
          "takesValue": false,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--max-depth",
          "description": "Maximum recursion depth",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
