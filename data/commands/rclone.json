        {
          "name": "--max-lock",
          "description": "Lock timeout",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "serve",
      "description": "Serve remote over protocol",
      "examples": [
        "rclone serve http remote:bucket/ --addr :8080",
        "rclone serve webdav remote:bucket/ --addr :8080",
        "rclone serve sftp remote:bucket/ --addr :2022",
        "rclone serve docker remote:"
      ],
      "options": [
        {
          "name": "--addr",
          "description": "Address to listen on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--read-only",
          "description": "Refuse write operations",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "Username for authentication",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--pass",
          "description": "Password for authentication",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--vfs-cache-mode",
          "description": "VFS cache mode (off, minimal, writes, full)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
