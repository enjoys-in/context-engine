        "rclone bisync --resync /local/ remote:bucket/"
      ],
      "options": [
        {
          "name": "--resync",
          "description": "Rebuild the sync state from scratch",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--check-access",
          "description": "Verify marker files before syncing",
          "type": "boolean",
          "takesValue": false
