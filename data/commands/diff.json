{
  "name": "diff",
  "description": "Compare files line by line",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-u",
      "description": "Unified format (context diff)"
    },
    {
      "name": "-r",
      "description": "Recursively compare directories"
    },
    {
      "name": "-i",
      "description": "Ignore case differences"
    },
    {
      "name": "-w",
      "description": "Ignore all white space"
    },
    {
      "name": "-B",
      "description": "Ignore blank lines"
    },
    {
      "name": "--color",
      "description": "Colorize output",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Report only when files differ"
    },
    {
      "name": "-y",
      "description": "Side-by-side output"
    },
    {
      "name": "--brief",
      "description": "Report only whether files differ"
    },
    {
      "name": "-N",
      "description": "Treat absent files as empty"
    }
  ],
  "examples": [
    "diff file1.txt file2.txt",
    "diff -u old.txt new.txt",
    "diff -u old.txt new.txt > patch.diff",
    "diff -r dir1/ dir2/",
    "diff -y file1 file2",
    "diff --color=auto a.txt b.txt"
  ],
  "relatedCommands": [
    "patch",
    "cmp",
    "comm",
    "vimdiff"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "diff version",
        "command": "diff --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "diff"
      },
      {
        "name": "changed_files",
        "description": "Files differing from git HEAD",
        "command": "git diff --name-only 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 15
      },
      {
        "name": "repo",
        "description": "Git repository for comparison",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
