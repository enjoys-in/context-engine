{
  "name": "gitui",
  "description": "Fast terminal UI for git, written in Rust",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--directory",
      "description": "Repository to open",
      "type": "directory",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--workdir",
      "description": "Work tree path",
      "type": "directory",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--theme",
      "description": "Theme file to load",
      "type": "file",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--logging",
      "description": "Enable logging",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--watcher",
      "description": "Watch the work tree for changes",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--bugreport",
      "description": "Print diagnostics for a bug report",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "gitui",
      "description": "Open in the current repository"
    },
    {
      "command": "gitui -d ~/code/app",
      "description": "Open a specific repository"
    },
    {
      "command": "gitui -t mytheme.ron",
      "description": "Load a custom theme"
    }
  ],
  "relatedCommands": [
    "git",
    "lazygit",
    "tig",
    "delta"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "gitui version",
        "command": "gitui --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gitui"
      },
      {
        "name": "repo",
        "description": "Git repository gitui would open",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "git"
      },
      {
        "name": "branch",
        "description": "Active git branch",
        "command": "git rev-parse --abbrev-ref HEAD 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "git"
      },
      {
        "name": "status",
        "description": "Working tree status",
        "command": "git status --porcelain 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 15,
        "requiresCmd": "git"
      }
    ]
  }
}
