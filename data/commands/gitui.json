{
  "name": "gitui",
  "description": "Fast terminal UI for git, written in Rust",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--directory",
      "description": "Repository to open",
      "type": "directory",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--workdir",
      "description": "Work tree path",
      "type": "directory",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--theme",
      "description": "Theme file to load",
      "type": "file",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--logging",
      "description": "Enable logging",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--watcher",
      "description": "Watch the work tree for changes",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--bugreport",
      "description": "Print diagnostics for a bug report",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "gitui",
      "description": "Open in the current repository"
    },
    {
      "command": "gitui -d ~/code/app",
      "description": "Open a specific repository"
    },
    {
      "command": "gitui -t mytheme.ron",
      "description": "Load a custom theme"
    }
  ],
  "relatedCommands": [
    "git",
    "lazygit",
    "tig",
    "delta"
  ]
}
