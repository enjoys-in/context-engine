{
  "name": "ng",
  "description": "Angular CLI",
  "category": "Frontend Frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "serve",
      "description": "Builds and serves your app",
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host the dev server binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--open",
          "description": "Open a browser on start",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--configuration",
          "description": "Build configuration to serve",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--ssl",
          "description": "Serve over HTTPS",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "ng serve"
      ]
    },
    {
      "name": "build",
      "description": "Compiles an Angular app into an output directory.",
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output-path",
          "description": "Directory for the build output",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--base-href",
          "description": "Base href to embed",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--source-map",
          "description": "Emit source maps",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Rebuild on change",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "ng build"
      ]
    },
    {
      "name": "generate",
      "description": "Generates and/or modifies files based on a schematic.",
      "options": [
        {
          "name": "--project",
          "description": "Project to generate into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dry-run",
          "description": "Report what would be generated",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--skip-tests",
          "description": "Do not generate spec files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--flat",
          "description": "Do not create a containing directory",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "ng generate"
      ]
    },
    {
      "name": "test",
      "description": "Runs unit tests in a project.",
      "options": [
        {
          "name": "--watch",
          "description": "Re-run tests on change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--code-coverage",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--browsers",
          "description": "Browsers to run the tests in",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--configuration",
          "description": "Build configuration to test",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "ng test"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the Angular CLI version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dry-run",
      "description": "Report what would change without writing files",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--interactive",
      "description": "Prompt for missing options",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--defaults",
      "description": "Accept all defaults without prompting",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ng serve",
      "description": "Start development server"
    },
    {
      "command": "ng generate component my-comp",
      "description": "Generate a new component"
    },
    {
      "command": "ng build --configuration production",
      "description": "Build for production"
    }
  ],
  "relatedCommands": [
    "npm",
    "node",
    "nx"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "angular_json",
        "description": "Angular Projects",
        "command": "cat angular.json 2>/dev/null | jq '.projects | keys' -r 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
