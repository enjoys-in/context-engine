{
  "name": "ng",
  "description": "Angular CLI",
  "category": "Frontend Frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "serve",
      "description": "Builds and serves your app"
    },
    {
      "name": "build",
      "description": "Compiles an Angular app into an output directory."
    },
    {
      "name": "generate",
      "description": "Generates and/or modifies files based on a schematic."
    },
    {
      "name": "test",
      "description": "Runs unit tests in a project."
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the Angular CLI version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dry-run",
      "description": "Report what would change without writing files",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--interactive",
      "description": "Prompt for missing options",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--defaults",
      "description": "Accept all defaults without prompting",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ng serve",
      "description": "Start development server"
    },
    {
      "command": "ng generate component my-comp",
      "description": "Generate a new component"
    },
    {
      "command": "ng build --configuration production",
      "description": "Build for production"
    }
  ],
  "relatedCommands": [
    "npm",
    "node",
    "nx"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "angular_json",
        "description": "Angular Projects",
        "command": "cat angular.json 2>/dev/null | jq '.projects | keys' -r 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
