{
  "language": "cpp",
  "name": "g++",
  "aliases": [
    "c++"
  ],
  "description": "G++ — GNU C++ Compiler toolchain",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Specify output file name"
    },
    {
      "name": "-O0 / -O1 / -O2 / -O3 / -Os",
      "description": "Optimization level"
    },
    {
      "name": "-Wall",
      "description": "Enable all common warnings"
    },
    {
      "name": "-Werror",
      "description": "Treat all warnings as errors"
    },
    {
      "name": "-std=c++17 / -std=c++20 / -std=c++23",
      "description": "Set C++ language standard"
    },
    {
      "name": "-I<dir>",
      "description": "Add include directory for header search"
    },
    {
      "name": "-L<dir>",
      "description": "Add library search directory"
    },
    {
      "name": "-l<lib>",
      "description": "Link with library"
    },
    {
      "name": "-fsanitize=address",
      "description": "Enable AddressSanitizer"
    },
    {
      "name": "-fno-exceptions",
      "description": "Disable C++ exceptions"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    }
  ],
  "subcommands": [
    {
      "name": "file.cpp -o output",
      "description": "Compile C++ file to executable",
      "args": [],
      "options": [
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-I",
          "description": "Add a header search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-L",
          "description": "Add a library search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Link against this library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-std",
          "description": "Language standard to compile against",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-Wall",
          "description": "Enable the common warnings",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "g++ file.cpp -o output"
      ]
    },
