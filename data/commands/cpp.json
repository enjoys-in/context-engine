  "examples": [
    "g++ -std=c++20 -Wall -Wextra main.cpp -o main",
    "g++ -O2 -o app main.cpp utils.cpp -lstdc++fs",
    "g++ -g -fsanitize=address main.cpp -o debug_app",
    "g++ -c module.cpp && g++ -c main.cpp && g++ module.o main.o -o app",
    "g++ -std=c++23 -fmodules-ts module.cppm"
  ],
  "relatedCommands": [
    "cmake",
    "make",
    "gdb",
    "clang++",
    "c"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "g++ version",
        "command": "g++ --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "g++"
      },
      {
        "name": "std_default",
        "description": "Default C++ standard",
        "command": "g++ -dM -E -x c++ /dev/null 2>/dev/null | grep __cplusplus",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "g++"
      },
      {
        "name": "sources",
        "description": "C++ sources in this project",
        "command": "find . -maxdepth 3 -name '*.cpp' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "build_files",
        "description": "C++ build files present",
        "command": "ls Makefile CMakeLists.txt meson.build conanfile.txt vcpkg.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
