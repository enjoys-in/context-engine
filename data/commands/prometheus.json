{
  "name": "prometheus",
  "description": "Prometheus monitoring system and time series database",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--config.file",
      "description": "Configuration file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--web.listen-address",
      "description": "Listen address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--storage.tsdb.path",
      "description": "Storage path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--storage.tsdb.retention.time",
      "description": "Data retention period",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--web.enable-lifecycle",
      "description": "Enable lifecycle API"
    },
    {
      "name": "--web.enable-admin-api",
      "description": "Enable admin API"
    },
    {
      "name": "--log.level",
      "description": "Log level (debug, info, warn, error)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "prometheus --config.file=prometheus.yml",
    "prometheus --config.file=prometheus.yml --web.listen-address=0.0.0.0:9090",
    "prometheus --storage.tsdb.retention.time=30d",
    "promtool check config prometheus.yml",
    "promtool check rules rules.yml"
  ],
  "relatedCommands": [
    "grafana-cli",
    "alertmanager",
    "node-exporter",
    "promtool"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Prometheus version",
        "command": "prometheus --version 2>&1 | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "prometheus"
      },
      {
        "name": "config",
        "description": "Prometheus scrape configuration",
        "command": "cat /etc/prometheus/prometheus.yml 2>/dev/null | head -50 || cat prometheus.yml 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "service",
        "description": "Prometheus service state",
        "command": "systemctl is-active prometheus 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "targets",
        "description": "Scrape targets Prometheus reports",
        "command": "curl -s localhost:9090/api/v1/targets 2>/dev/null | head -c 2000",
        "parser": "json",
        "cacheFor": 60
      }
    ]
  }
}
