{
  "name": "influxd",
  "description": "InfluxDB time-series database server",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run the server",
      "options": [
        {
          "name": "--http-bind-address",
          "description": "HTTP listen address",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--bolt-path",
          "description": "Path to the bolt metadata store",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--engine-path",
          "description": "Path to the storage engine data",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Logging level",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--reporting-disabled",
          "description": "Disable usage reporting",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "influxd run"
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect on-disk storage",
      "options": [
        {
          "name": "--bolt-path",
          "description": "Path to the BoltDB file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--engine-path",
          "description": "Path to the engine data directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Log verbosity level",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "influxd inspect"
      ]
    },
    {
      "name": "recovery",
      "description": "Recover organisations, users and tokens",
      "options": [
        {
          "name": "--bolt-path",
          "description": "Path to the BoltDB file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--engine-path",
          "description": "Path to the engine data directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Log verbosity level",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "influxd recovery"
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade a 1.x instance to 2.x",
      "options": [
        {
          "name": "--config-file",
          "description": "1.x configuration to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--bucket",
          "description": "Target bucket name",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "influxd upgrade"
      ]
    },
    {
      "name": "downgrade",
      "description": "Downgrade the metadata schema",
      "args": [
        {
          "name": "version",
          "description": "Target version",
          "type": "version",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--bolt-path",
          "description": "Path to the BoltDB file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--engine-path",
          "description": "Path to the engine data directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Log verbosity level",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "influxd downgrade 1.2.3"
      ]
    },
    {
      "name": "print-config",
      "description": "Print the resolved configuration",
      "options": [
        {
          "name": "--bolt-path",
          "description": "Path to the BoltDB file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--engine-path",
          "description": "Path to the engine data directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Log verbosity level",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "influxd print-config"
      ]
    },
    {
      "name": "version",
      "description": "Show the server version",
      "options": [],
      "examples": [
        "influxd version"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--config-path",
      "description": "Directory holding the configuration",
      "type": "directory",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "influxd run",
      "description": "Start the server"
    },
    {
      "command": "influxd print-config",
      "description": "Show the resolved configuration"
    },
    {
      "command": "influxd upgrade --config-file influxdb.conf",
      "description": "Migrate a 1.x instance"
    },
    {
      "command": "influxd inspect report-tsm",
      "description": "Inspect the storage engine"
    }
  ],
  "relatedCommands": [
    "influx",
    "telegraf",
    "prometheus",
    "grafana-cli"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "InfluxDB server version",
        "command": "influxd version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "influxd"
      },
      {
        "name": "config",
        "description": "InfluxDB server configuration",
        "command": "cat /etc/influxdb/config.toml 2>/dev/null | head -30 || cat ~/.influxdbv2/configs 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "service",
        "description": "InfluxDB service state",
        "command": "systemctl is-active influxdb 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "data_dir",
        "description": "InfluxDB engine data directory",
        "command": "ls ~/.influxdbv2 2>/dev/null || ls /var/lib/influxdb 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
