{
  "name": "influxd",
  "description": "InfluxDB time-series database server",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run the server",
      "options": [
        {
          "name": "--http-bind-address",
          "description": "HTTP listen address",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--bolt-path",
          "description": "Path to the bolt metadata store",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--engine-path",
          "description": "Path to the storage engine data",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Logging level",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--reporting-disabled",
          "description": "Disable usage reporting",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect on-disk storage"
    },
    {
      "name": "recovery",
      "description": "Recover organisations, users and tokens"
    },
    {
      "name": "upgrade",
      "description": "Upgrade a 1.x instance to 2.x",
      "options": [
        {
          "name": "--config-file",
          "description": "1.x configuration to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--bucket",
          "description": "Target bucket name",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "downgrade",
      "description": "Downgrade the metadata schema",
      "args": [
        {
          "name": "version",
          "description": "Target version",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "print-config",
      "description": "Print the resolved configuration"
    },
    {
      "name": "version",
      "description": "Show the server version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--config-path",
      "description": "Directory holding the configuration",
      "type": "directory",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "influxd run",
      "description": "Start the server"
    },
    {
      "command": "influxd print-config",
      "description": "Show the resolved configuration"
    },
    {
      "command": "influxd upgrade --config-file influxdb.conf",
      "description": "Migrate a 1.x instance"
    },
    {
      "command": "influxd inspect report-tsm",
      "description": "Inspect the storage engine"
    }
  ],
  "relatedCommands": [
    "influx",
    "telegraf",
    "prometheus",
    "grafana-cli"
  ]
}
