{
  "name": "civo",
  "description": "Civo Cloud CLI — fast Kubernetes cloud",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
