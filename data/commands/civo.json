  "subcommands": [
    {
      "name": "kubernetes",
      "description": "Manage Kubernetes clusters",
      "examples": [
        "civo kubernetes list",
        "civo kubernetes create my-cluster --nodes 3",
        "civo kubernetes config my-cluster --save",
        "civo kubernetes delete my-cluster",
        "civo kubernetes show my-cluster",
        "civo kubernetes scale my-cluster --nodes 5",
        "civo kubernetes applications add Traefik2-nodeport --cluster my-cluster"
      ],
      "options": [
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, custom or human",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--fields",
          "description": "Restrict output to these fields",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress non-essential output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
