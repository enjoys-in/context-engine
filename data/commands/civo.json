  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Civo CLI version",
        "command": "civo version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "civo"
      },
      {
        "name": "region",
        "description": "Civo region in effect",
        "command": "civo region current 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "civo"
      },
      {
        "name": "config",
        "description": "Civo CLI configuration",
        "command": "cat ~/.civo.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300
      }
    ]
  }
