{
  "name": "tox",
  "description": "Automate and standardise Python testing across environments",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run the configured environments",
      "options": [
        {
          "name": "--env",
          "description": "Environments to run",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--recreate",
          "description": "Rebuild the environments",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--parallel",
          "description": "Run environments in parallel",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "list",
      "description": "List the environments defined in the configuration",
      "options": [
        {
          "name": "--default",
          "description": "Show only the default environment list",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "devenv",
      "description": "Create a development environment",
      "args": [
        {
          "name": "path",
          "description": "Directory to create it in",
          "type": "path",
          "required": true
        }
      ]
    },
    {
      "name": "config",
      "description": "Show the resolved configuration",
      "options": [
        {
          "name": "--env",
          "description": "Environment to describe",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "depends",
      "description": "Show the environment dependency graph"
    },
    {
      "name": "quickstart",
      "description": "Generate a starter tox configuration"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--conf",
      "description": "Path to the tox configuration",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--workdir",
      "description": "Directory for the environments",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--result-json",
      "description": "Write a JSON report to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "tox",
      "description": "Run every default environment"
    },
    {
      "command": "tox -e py312",
      "description": "Run a single environment"
    },
    {
      "command": "tox -p auto",
      "description": "Run environments in parallel"
    },
    {
      "command": "tox -r",
      "description": "Recreate the environments first"
    }
  ],
  "relatedCommands": [
    "pytest",
    "nox",
    "python",
    "pipx"
  ]
}
