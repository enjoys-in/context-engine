{
  "name": "chamber",
  "description": "CLI for managing secrets via AWS SSM Parameter Store",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "write",
      "description": "Write a secret",
      "examples": [
        "chamber write my-service db-password supersecret",
        "chamber write production/api SECRET_KEY abc123"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to write to",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--kms-key-alias",
          "description": "KMS key alias to encrypt with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "read",
      "description": "Read a single secret",
      "examples": [
        "chamber read my-service db-password"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to read from",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--version",
          "description": "Secret version to read",
          "type": "integer",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--quiet",
          "description": "Print the value only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ],
      "args": [
        {
          "name": "service",
          "description": "Service holding the secret",
          "required": true,
          "type": "string"
        },
        {
          "name": "key",
          "description": "Secret key to read",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "list",
      "description": "List secrets for a service",
      "examples": [
        "chamber list my-service",
        "chamber list my-service -e"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to list",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--expand",
          "description": "Show the secret values too",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute command with secrets as env vars",
      "examples": [
        "chamber exec my-service -- node server.js",
        "chamber exec production/api -- ./start.sh",
        "chamber exec my-service another-service -- env"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to read from",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--pristine",
          "description": "Pass only the loaded secrets as the environment",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--strict-value",
          "description": "Only replace variables set to this sentinel",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "service",
          "description": "Service whose secrets to load",
          "required": true,
          "type": "string"
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "env",
      "description": "Print secrets as env vars",
      "examples": [
        "chamber env my-service",
        "chamber env my-service --backend ssm"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to read from",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--format",
          "description": "Output format: bash, fish, json, dotenv or tfvars",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete a secret",
      "examples": [
        "chamber delete my-service db-password"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to delete from",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--exact-key",
          "description": "Delete only this exact key",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "service",
          "description": "Service holding the secret",
          "required": true,
          "type": "string"
        },
        {
          "name": "key",
          "description": "Secret key to delete",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "history",
      "description": "View secret version history",
      "examples": [
        "chamber history my-service db-password"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to read from",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        }
      ]
    },
    {
      "name": "export",
      "description": "Export secrets in various formats",
      "examples": [
        "chamber export my-service",
        "chamber export my-service --format json",
        "chamber export my-service --format dotenv",
        "chamber export my-service --format csv"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to read from",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--format",
          "description": "Output format: json, yaml, dotenv or tfvars",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--output-file",
          "description": "Write the export to this file",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "service",
          "description": "Service whose secrets to export",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "import",
      "description": "Import secrets from JSON",
      "examples": [
        "chamber import my-service secrets.json"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to write to",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        }
      ],
      "args": [
        {
          "name": "service",
          "description": "Service to import into",
          "required": true,
          "type": "string"
        },
        {
          "name": "file",
          "description": "File holding the secrets",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "find",
      "description": "Find services matching pattern",
      "examples": [
        "chamber find db"
      ],
      "options": [
        {
          "name": "--backend",
          "description": "Secret backend to search",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--by-value",
          "description": "Search values rather than keys",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or value to search for",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--backend",
      "short": "-b",
      "description": "Backend (ssm, s3, null)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-b"
    },
    {
      "name": "--kms-key-alias",
      "description": "KMS key alias",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--region",
      "description": "AWS region",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "chamber write my-service db-password secret123",
    "chamber list my-service",
    "chamber exec my-service -- node server.js",
    "chamber export my-service --format json",
    "chamber read my-service db-password",
    "chamber env my-service"
  ],
  "relatedCommands": [
    "aws",
    "vault",
    "sops",
    "doppler"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "chamber version",
        "command": "chamber version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "chamber"
      },
      {
        "name": "backend",
        "description": "Chamber secret backend in effect",
        "command": "echo \"${CHAMBER_SECRET_BACKEND:-ssm}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "kms_key",
        "description": "Chamber KMS key alias in effect",
        "command": "echo \"${CHAMBER_KMS_KEY_ALIAS:-alias/parameter_store_key}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
