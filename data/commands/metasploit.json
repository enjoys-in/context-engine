{
  "name": "metasploit",
  "aliases": [
    "msfconsole",
    "msfvenom",
    "msfdb"
  ],
  "description": "Penetration testing framework — msfconsole and companions",
  "category": "security",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "msfconsole",
      "description": "Start the interactive framework console",
      "options": [
        {
          "name": "-q",
          "description": "Suppress the banner",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-r",
          "description": "Run this resource script",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-x",
          "description": "Run these console commands on start",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-n",
          "description": "Skip loading the database",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "msfvenom",
      "description": "Generate and encode payloads",
      "options": [
        {
          "name": "-p",
          "description": "Payload to generate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-f",
          "description": "Output format",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-e",
          "description": "Encoder to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-o",
          "description": "Write the payload here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--list",
          "description": "List payloads, encoders or formats",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "msfdb",
      "description": "Manage the framework database",
      "options": [
        {
          "name": "--component",
          "description": "Database component to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--debug",
          "description": "Enable debug output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "msfrpcd",
      "description": "Run the framework RPC daemon",
      "options": [
        {
          "name": "-P",
          "description": "RPC password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-p",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-S",
          "description": "Disable TLS",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "msfconsole -q",
      "description": "Start the console without the banner"
    },
    {
      "command": "msfconsole -q -x \"use auxiliary/scanner/ssh/ssh_version; run\"",
      "description": "Run a module non-interactively"
    },
    {
      "command": "msfvenom --list payloads",
      "description": "List the available payloads"
    },
    {
      "command": "msfdb init",
      "description": "Initialise the database"
    }
  ],
  "relatedCommands": [
    "nmap",
    "nuclei",
    "sqlmap",
    "hydra"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Metasploit Framework version",
        "command": "msfconsole --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "msfconsole"
      },
      {
        "name": "database",
        "description": "Metasploit database configuration",
        "command": "cat ~/.msf4/database.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "modules",
        "description": "Locally installed custom modules",
        "command": "ls ~/.msf4/modules 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "workspace_logs",
        "description": "Metasploit loot and logs directory",
        "command": "ls ~/.msf4/loot 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
