{
  "name": "rustup",
  "description": "Rust toolchain installer and manager",
  "category": "rust-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "show",
      "description": "Show installed and active toolchains",
      "subcommands": [
        {
          "name": "active-toolchain",
          "description": "Show active toolchain"
        },
        {
          "name": "home",
          "description": "Show RUSTUP_HOME"
        },
        {
          "name": "profile",
          "description": "Show current profile"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update toolchains and rustup",
      "args": [
        {
          "name": "toolchain",
          "description": "Specific toolchain to update",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--no-self-update",
          "description": "Do not update rustup itself",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Reinstall even if up to date",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force-non-host",
          "description": "Allow a non-host toolchain",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "default",
      "description": "Set default toolchain",
      "args": [
        {
          "name": "toolchain",
          "description": "Toolchain name (stable, beta, nightly, etc.)",
          "required": true
        }
      ]
    },
    {
      "name": "toolchain",
      "description": "Manage toolchains",
      "subcommands": [
        {
          "name": "list",
          "description": "List installed toolchains",
          "options": [
            {
              "name": "--verbose",
              "description": "Show the installed targets",
              "type": "boolean",
              "takesValue": false,
              "short": "-v",
              "shorthand": "-v"
            }
          ]
        },
        {
          "name": "install",
          "description": "Install a toolchain",
          "args": [
            {
              "name": "toolchain",
              "description": "Toolchain name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--profile",
              "description": "Component profile (minimal, default, complete)",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--component",
              "description": "Extra components to add",
              "type": "string",
              "takesValue": true,
              "short": "-c",
              "shorthand": "-c"
            },
            {
              "name": "--target",
              "description": "Extra targets to add",
              "type": "string",
              "takesValue": true,
              "short": "-t",
              "shorthand": "-t"
            },
            {
              "name": "--force-non-host",
              "description": "Allow a non-host toolchain",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "uninstall",
          "description": "Uninstall a toolchain",
          "args": [
            {
              "name": "toolchain",
              "description": "Toolchain name",
              "required": true
            }
          ]
        },
        {
          "name": "link",
          "description": "Symlink a custom toolchain",
          "args": [
            {
              "name": "toolchain",
              "description": "Name",
              "required": true
            },
            {
              "name": "path",
              "description": "Path",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "name": "target",
      "description": "Manage compilation targets",
      "subcommands": [
        {
          "name": "list",
          "description": "List available targets",
          "options": [
            {
              "name": "--installed",
              "description": "Only installed targets",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--toolchain",
              "description": "Toolchain to query",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "add",
          "description": "Add a target",
          "args": [
            {
              "name": "target",
              "description": "Target triple",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--toolchain",
              "description": "Toolchain to modify",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "remove",
          "description": "Remove a target",
          "args": [
            {
              "name": "target",
              "description": "Target triple",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--toolchain",
              "description": "Toolchain to modify",
              "type": "string",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "component",
      "description": "Manage components",
      "subcommands": [
        {
          "name": "list",
          "description": "List available components",
          "options": [
            {
              "name": "--installed",
              "description": "Only installed components",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--toolchain",
              "description": "Toolchain to query",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "add",
          "description": "Add a component",
          "args": [
            {
              "name": "component",
              "description": "Component name (clippy, rustfmt, etc.)",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--toolchain",
              "description": "Toolchain to modify",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--target",
              "description": "Target the component applies to",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "remove",
          "description": "Remove a component",
          "args": [
            {
              "name": "component",
              "description": "Component name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--toolchain",
              "description": "Toolchain to modify",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--target",
              "description": "Target the component applies to",
              "type": "string",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "override",
      "description": "Manage directory toolchain overrides",
      "subcommands": [
        {
          "name": "set",
          "description": "Set override for current directory",
          "args": [
            {
              "name": "toolchain",
              "description": "Toolchain name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--path",
              "description": "Directory to override",
              "type": "directory",
              "takesValue": true
            }
          ]
        },
        {
          "name": "unset",
          "description": "Remove override",
          "options": [
            {
              "name": "--path",
              "description": "Directory to clear",
              "type": "directory",
              "takesValue": true
            },
            {
              "name": "--nonexistent",
              "description": "Remove overrides for missing directories",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "list",
          "description": "List overrides"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a command with a specific toolchain",
      "args": [
        {
          "name": "toolchain",
          "description": "Toolchain",
          "required": true
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--install",
          "description": "Install the toolchain if missing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "which",
      "description": "Show path to a binary",
      "args": [
        {
          "name": "command",
          "description": "Binary name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--toolchain",
          "description": "Toolchain to query",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "doc",
      "description": "Open Rust docs in browser",
      "options": [
        {
          "name": "--book",
          "description": "Open the Rust book",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--std",
          "description": "Open the standard library docs",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--path",
          "description": "Print the path instead of opening",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "self",
      "description": "Manage rustup itself",
      "subcommands": [
        {
          "name": "update",
          "description": "Update rustup"
        },
        {
          "name": "uninstall",
          "description": "Uninstall rustup",
          "options": [
            {
              "name": "--no-prompt",
              "description": "Do not prompt for confirmation",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            }
          ]
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet output",
      "short": "-q"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-V",
      "description": "Show version",
      "short": "-V"
    }
  ],
  "examples": [
    {
      "command": "rustup show",
      "description": "Show installed toolchains"
    },
    {
      "command": "rustup update",
      "description": "Update all toolchains"
    },
    {
      "command": "rustup default nightly",
      "description": "Switch to nightly"
    },
    {
      "command": "rustup target add wasm32-unknown-unknown",
      "description": "Add WASM target"
    },
    {
      "command": "rustup component add clippy rustfmt",
      "description": "Add clippy and rustfmt"
    },
    {
      "command": "rustup toolchain install nightly",
      "description": "Install nightly toolchain"
    },
    {
      "command": "rustup override set nightly",
      "description": "Use nightly in current dir"
    }
  ],
  "relatedCommands": [
    "cargo",
    "rust"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed_toolchains",
        "description": "Installed Rust toolchains",
        "command": "rustup toolchain list 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "rustup"
      },
      {
        "name": "active_toolchain",
        "description": "Active toolchain",
        "command": "rustup show active-toolchain 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "rustup"
      },
      {
        "name": "installed_targets",
        "description": "Installed compilation targets",
        "command": "rustup target list --installed 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "rustup"
      },
      {
        "name": "installed_components",
        "description": "Installed components",
        "command": "rustup component list --installed 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "rustup"
      },
      {
        "name": "rust_toolchain_file",
        "description": "Project toolchain override",
        "command": "cat rust-toolchain.toml 2>/dev/null || cat rust-toolchain 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
