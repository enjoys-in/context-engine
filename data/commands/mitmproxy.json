{
  "name": "mitmproxy",
  "description": "Interactive TLS-capable intercepting HTTP proxy",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--listen-port",
      "description": "Port to listen on",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--listen-host",
      "description": "Address to bind to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--mode",
      "description": "Proxy mode (regular, transparent, reverse, upstream, socks5)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--scripts",
      "description": "Addon script to load",
      "type": "file",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--set",
      "description": "Set an option, key=value",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--save-stream-file",
      "description": "Write the flows to this file",
      "type": "file",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--rfile",
      "description": "Read flows from this file",
      "type": "file",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--flow-detail",
      "description": "Detail level for console output",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--ssl-insecure",
      "description": "Do not verify upstream certificates",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--ignore-hosts",
      "description": "Do not intercept hosts matching this regex",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--allow-hosts",
      "description": "Only intercept hosts matching this regex",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--anticache",
      "description": "Strip cache headers from requests",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "mitmproxy",
      "description": "Start the interactive TUI proxy"
    },
    {
      "command": "mitmdump -w flows.mitm",
      "description": "Record traffic to a file"
    },
    {
      "command": "mitmproxy --mode reverse:https://api.example.com",
      "description": "Proxy in reverse mode"
    },
    {
      "command": "mitmdump -s addon.py",
      "description": "Run with a Python addon"
    }
  ],
  "relatedCommands": [
    "tcpdump",
    "wireshark",
    "curl",
    "nmap",
    "socat"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "mitmproxy version",
        "command": "mitmproxy --version 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mitmproxy"
      },
      {
        "name": "ca_cert",
        "description": "mitmproxy CA certificate present",
        "command": "ls ~/.mitmproxy/mitmproxy-ca-cert.pem 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "mitmproxy configuration",
        "command": "cat ~/.mitmproxy/config.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "scripts",
        "description": "mitmproxy addon scripts here",
        "command": "find . -maxdepth 2 -name '*.py' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
