{
  "name": "mysqldump",
  "description": "Back up MySQL and MariaDB databases to SQL",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--user",
      "description": "Username to connect as",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--password",
      "description": "Password to connect with",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--host",
      "description": "Server host",
      "type": "string",
      "takesValue": true,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--port",
      "description": "Server port",
      "type": "integer",
      "takesValue": true,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--all-databases",
      "description": "Dump every database",
      "type": "boolean",
      "takesValue": false,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--databases",
      "description": "Dump these databases",
      "type": "string",
      "takesValue": true,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--single-transaction",
      "description": "Dump consistently without locking InnoDB",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-data",
      "description": "Dump the schema only",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--no-create-info",
      "description": "Dump the data only",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--routines",
      "description": "Include stored procedures and functions",
      "type": "boolean",
      "takesValue": false,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--triggers",
      "description": "Include triggers",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--events",
      "description": "Include scheduled events",
      "type": "boolean",
      "takesValue": false,
      "short": "-E",
      "shorthand": "-E"
    },
    {
      "name": "--where",
      "description": "Only rows matching this condition",
      "type": "string",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--result-file",
      "description": "Write output to this file",
      "type": "file",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--compress",
      "description": "Compress the client-server protocol",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    }
  ],
  "examples": [
    {
      "command": "mysqldump -u root -p mydb > mydb.sql",
      "description": "Dump one database"
    },
    {
      "command": "mysqldump --single-transaction --routines mydb > mydb.sql",
      "description": "Consistent dump including routines"
    },
    {
      "command": "mysqldump -A | gzip > all.sql.gz",
      "description": "Dump everything, compressed"
    },
    {
      "command": "mysqldump -d mydb > schema.sql",
      "description": "Dump the schema only"
    }
  ],
  "relatedCommands": [
    "mysql",
    "pg_dump",
    "mongodump",
    "sql"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "mysqldump version",
        "command": "mysqldump --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mysqldump"
      },
      {
        "name": "connection",
        "description": "MySQL connection defaults",
        "command": "grep -A8 '\\[client\\]' ~/.my.cnf 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300
      },
      {
        "name": "existing_dumps",
        "description": "SQL dump files in this directory",
        "command": "find . -maxdepth 2 -name '*.sql' -o -name '*.sql.gz' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
