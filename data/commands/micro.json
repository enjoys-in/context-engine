{
  "name": "micro",
  "description": "Modern terminal-based text editor with familiar keybindings",
  "category": "editor",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--clean",
      "description": "Reset configuration to the defaults",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config-dir",
      "description": "Directory holding the configuration",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--plugin",
      "description": "Run a plugin command",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--options",
      "description": "List every available option",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Enable debug mode",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--readonly",
      "description": "Open without allowing writes",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "micro notes.md",
      "description": "Open a file"
    },
    {
      "command": "micro +42 main.go",
      "description": "Open at line 42"
    },
    {
      "command": "micro --plugin install fzf",
      "description": "Install a plugin"
    }
  ],
  "relatedCommands": [
    "nano",
    "vim",
    "helix",
    "emacs"
  ]
}
