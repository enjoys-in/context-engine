{
  "name": "saml2aws",
  "description": "Obtain AWS temporary credentials through a SAML identity provider",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "configure",
      "description": "Set up an account profile",
      "options": [
        {
          "name": "--idp-provider",
          "description": "Identity provider type",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--idp-account",
          "description": "Account name to configure",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--username",
          "description": "Username to authenticate as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--url",
          "description": "Identity provider URL",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--role",
          "description": "Default role ARN to assume",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "login",
      "description": "Authenticate and write credentials",
      "options": [
        {
          "name": "--idp-account",
          "description": "Account profile to use",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--role",
          "description": "Role ARN to assume",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--session-duration",
          "description": "Credential lifetime in seconds",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Re-authenticate even if credentials are valid",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--mfa",
          "description": "MFA method to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--skip-prompt",
          "description": "Do not prompt for input",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "exec",
      "description": "Run a command with the credentials in the environment",
      "options": [
        {
          "name": "--idp-account",
          "description": "Account profile to use",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--exec-profile",
          "description": "Profile to assume before running",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "list-roles",
      "description": "List the roles available to you",
      "options": [
        {
          "name": "--idp-account",
          "description": "Account profile to use",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "script",
      "description": "Print shell commands that export the credentials",
      "options": [
        {
          "name": "--shell",
          "description": "Shell to generate for",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "console",
      "description": "Open the AWS console in a browser",
      "options": [
        {
          "name": "--idp-account",
          "description": "Account profile to use",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--link",
          "description": "Print the link instead of opening it",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--profile",
      "description": "AWS profile to write credentials into",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--region",
      "description": "AWS region to use",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "saml2aws configure",
      "description": "Set up an identity provider account"
    },
    {
      "command": "saml2aws login",
      "description": "Authenticate and write credentials"
    },
    {
      "command": "saml2aws list-roles",
      "description": "See which roles you can assume"
    },
    {
      "command": "saml2aws exec -- aws s3 ls",
      "description": "Run a command with the credentials loaded"
    }
  ],
  "relatedCommands": [
    "aws",
    "aws-vault",
    "aws-sso",
    "kubelogin"
  ]
}
