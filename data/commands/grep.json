{
  "name": "grep",
  "description": "Search for patterns in files",
  "category": "text-processing",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--extended-regexp",
      "short": "-E",
      "description": "Extended regex (egrep)",
      "shorthand": "-E"
    },
    {
      "name": "--fixed-strings",
      "short": "-F",
      "description": "Fixed string matching (fgrep)",
      "shorthand": "-F"
    },
    {
      "name": "--perl-regexp",
      "short": "-P",
      "description": "Perl-compatible regex",
      "shorthand": "-P"
    },
    {
      "name": "--ignore-case",
      "short": "-i",
      "description": "Case-insensitive matching",
      "shorthand": "-i"
    },
    {
      "name": "--invert-match",
      "short": "-v",
      "description": "Invert match (non-matching lines)",
      "shorthand": "-v"
    },
    {
      "name": "--word-regexp",
      "short": "-w",
      "description": "Match whole words only",
      "shorthand": "-w"
    },
    {
      "name": "--line-regexp",
      "short": "-x",
      "description": "Match whole lines only",
      "shorthand": "-x"
    },
    {
      "name": "--count",
      "short": "-c",
      "description": "Print count of matching lines",
      "shorthand": "-c"
    },
    {
      "name": "--files-with-matches",
      "short": "-l",
      "description": "Print filenames with matches",
      "shorthand": "-l"
    },
    {
      "name": "--line-number",
      "short": "-n",
      "description": "Print line numbers",
      "shorthand": "-n"
    },
    {
      "name": "--with-filename",
      "short": "-H",
      "description": "Print filename for each match",
      "shorthand": "-H"
    },
    {
      "name": "--no-filename",
      "short": "-h",
      "description": "Suppress filename in output",
      "shorthand": "-h"
    },
    {
      "name": "--recursive",
      "short": "-r",
      "description": "Search recursively",
      "shorthand": "-r"
    },
    {
      "name": "-R",
      "description": "Search recursively (follow symlinks)"
    },
    {
      "name": "--include",
      "description": "Search only matching files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Skip matching files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude-dir",
      "description": "Skip matching directories",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--context",
      "short": "-C",
      "description": "Print N lines of context",
      "type": "number",
      "takesValue": true,
      "shorthand": "-C"
    },
    {
      "name": "--before-context",
      "short": "-B",
      "description": "Print N lines before match",
      "type": "number",
      "takesValue": true,
      "shorthand": "-B"
    },
    {
      "name": "--after-context",
      "short": "-A",
      "description": "Print N lines after match",
      "type": "number",
      "takesValue": true,
      "shorthand": "-A"
    },
    {
      "name": "--only-matching",
      "short": "-o",
      "description": "Print only the matching part",
      "shorthand": "-o"
    },
    {
      "name": "--color",
      "description": "Highlight matches (auto, always, never)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--max-count",
      "short": "-m",
      "description": "Stop after N matches",
      "type": "number",
      "takesValue": true,
      "shorthand": "-m"
    },
    {
      "name": "--quiet",
      "short": "-q",
      "description": "Suppress output (exit status only)",
      "shorthand": "-q"
    }
  ],
  "examples": [
    "grep 'pattern' file.txt",
    "grep -r 'TODO' src/",
    "grep -rn 'function' --include='*.js' .",
    "grep -i 'error' /var/log/syslog",
    "grep -v '^#' config.conf",
    "grep -c 'pattern' file.txt",
    "grep -E 'error|warning|critical' logfile",
    "grep -l 'import' *.py",
    "grep -P '\\d{3}-\\d{4}' contacts.txt",
    "ps aux | grep nginx"
  ],
  "relatedCommands": [
    "rg",
    "ag",
    "ack",
    "sed",
    "awk",
    "find"
  ]
}
