  "globalOptions": [
    {
      "name": "--repository",
      "shorthand": "-R",
      "description": "Repository path",
      "takesValue": true,
      "short": "-R"
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet output",
      "short": "-q"
    },
    {
      "name": "--config",
      "description": "Set config option",
      "takesValue": true
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    }
  ],
  "examples": [
    {
      "command": "hg clone https://example.com/repo",
      "description": "Clone a repository"
    },
    {
      "command": "hg commit -m 'Fix issue'",
      "description": "Commit changes"
    },
    {
      "command": "hg log -l 5 -G",
      "description": "Show last 5 commits with graph"
    },
    {
      "command": "hg pull -u",
      "description": "Pull and update"
    },
    {
      "command": "hg branch feature-x",
      "description": "Create a named branch"
    }
  ],
  "relatedCommands": [
    "git",
    "svn"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "current_branch",
        "description": "Current branch",
        "command": "hg branch 2>/dev/null",
        "parser": "text",
        "cacheFor": 10,
        "requiresCmd": "hg"
      },
      {
        "name": "branches",
        "description": "All branches",
        "command": "hg branches 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "hg"
      },
      {
        "name": "status",
        "description": "Working directory status",
        "command": "hg status 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 10,
        "requiresCmd": "hg"
      },
      {
        "name": "tags",
        "description": "Repository tags",
        "command": "hg tags 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "hg"
      },
      {
        "name": "bookmarks",
        "description": "Bookmarks",
        "command": "hg bookmarks 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "hg"
      }
    ]
  }
}
