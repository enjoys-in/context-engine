{
  "name": "hg",
  "description": "Mercurial distributed version control system",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "clone",
      "description": "Clone a repository",
      "args": [
        {
          "name": "source",
          "description": "Source repository",
          "required": true
        },
        {
          "name": "dest",
          "description": "Destination directory",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--branch",
          "shorthand": "-b",
          "description": "Clone specific branch",
          "takesValue": true,
          "short": "-b"
        },
        {
          "name": "--rev",
          "shorthand": "-r",
          "description": "Clone up to revision",
          "takesValue": true,
          "short": "-r"
        }
      ]
    },
    {
      "name": "init",
      "description": "Create a new repository",
      "args": [
        {
          "name": "dest",
          "description": "Directory",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--repository",
          "description": "Repository root directory",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--cwd",
          "description": "Change working directory first",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
