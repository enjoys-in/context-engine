          "required": false
        }
      ],
      "options": [
        {
          "name": "--repository",
          "description": "Repository root directory",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--cwd",
          "description": "Change working directory first",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--include",
          "description": "Only include names matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--exclude",
          "description": "Exclude names matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-X",
          "shorthand": "-X"
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
