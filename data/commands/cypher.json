{
  "language": "cypher",
  "name": "cypher-shell",
  "description": "Cypher Shell — Neo4j graph database command-line client",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-u / --username",
      "description": "Neo4j username"
    },
    {
      "name": "-p / --password",
      "description": "Neo4j password"
    },
    {
      "name": "-a / --address",
      "description": "Server address (bolt://host:port)"
    },
    {
      "name": "--database",
      "description": "Target database name"
    },
    {
      "name": "--format",
      "description": "Output format (auto, verbose, plain)"
    },
    {
      "name": "--encryption",
      "description": "Connection encryption (true, false, default)"
    },
    {
      "name": "-f / --file",
      "description": "Cypher script file to execute"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    }
  ],
  "subcommands": [
    {
      "name": "-u neo4j -p pass",
      "description": "Connect to Neo4j with credentials",
      "args": [],
      "options": [
        {
          "name": "--address",
          "description": "Bolt address to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--database",
          "description": "Database to run against",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--format",
          "description": "Output format: auto, verbose or plain",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--format plain",
      "description": "Output results in plain text format",
      "args": [],
      "options": [
        {
          "name": "--address",
          "description": "Bolt address to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "-f script.cypher",
      "description": "Execute Cypher script from file",
      "args": [
        {
          "name": "file",
          "description": "Cypher script to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--fail-fast",
          "description": "Stop at the first failing statement",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--fail-at-end",
          "description": "Run every statement and report failures at the end",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "--database neo4j",
      "description": "Connect to a specific database",
      "args": [
        {
          "name": "database",
          "description": "Database to connect to",
          "type": "database",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--address",
          "description": "Bolt address to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "-a bolt://host:7687",
      "description": "Connect to specific server address",
      "args": [
        {
          "name": "address",
          "description": "Address to connect to",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--encryption",
          "description": "Whether to use an encrypted connection",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "cypher-shell -u neo4j -p password",
    "cypher-shell -u neo4j -p password -f import.cypher",
    "echo 'MATCH (n) RETURN count(n);' | cypher-shell -u neo4j -p password",
    "cypher-shell -a bolt://localhost:7687 --database mydb",
    "cypher-shell --format plain -u neo4j -p password <<< 'MATCH (n:Person) RETURN n.name LIMIT 10;'"
  ],
  "relatedCommands": [
    "sql",
    "mongosh",
    "redis-cli",
    "psql"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Cypher Shell version",
        "command": "cypher-shell --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cypher-shell"
      },
      {
        "name": "connection",
        "description": "Neo4j connection settings in effect",
        "command": "echo \"uri=${NEO4J_URI:-bolt://localhost:7687} user=${NEO4J_USERNAME:-neo4j}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "scripts",
        "description": "Cypher scripts in this project",
        "command": "find . -maxdepth 2 -name '*.cypher' -o -name '*.cql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
