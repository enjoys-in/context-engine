{
  "name": "swc",
  "description": "Super-fast TypeScript/JavaScript compiler written in Rust",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "compile",
      "description": "Compile files (default)",
      "examples": [
        "swc src -d dist"
      ],
      "options": [
        {
          "name": "--out-dir",
          "description": "Directory for the compiled output",
          "type": "directory",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--out-file",
          "description": "Path for the compiled output",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--config-file",
          "description": "SWC config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--source-maps",
          "description": "Emit source maps",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--watch",
          "description": "Recompile on change",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files or directories to compile",
          "required": true,
          "type": "path"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Generate source maps"
    },
    {
      "name": "--config-file",
      "description": "Path to .swcrc config",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-w",
      "description": "Watch for changes"
    },
    {
      "name": "--only",
      "description": "Only compile matching files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ignore",
      "description": "Skip matching files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-C",
      "description": "Override config values",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "swc src -d dist",
    "swc src/index.ts -o dist/index.js",
    "swc src -d dist -w",
    "swc src -d dist -s",
    "npx @swc/cli src -d dist"
  ],
  "relatedCommands": [
    "esbuild",
    "babel",
    "tsc",
    "webpack"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "SWC version",
        "command": "swc --version 2>/dev/null || npx swc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "SWC configuration",
        "command": "cat .swcrc 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
