{
  "name": "flask",
  "description": "Flask CLI for running and managing Flask web applications",
  "category": "python-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run the development server",
      "options": [
        {
          "name": "--host",
          "shorthand": "-h",
          "description": "Bind host",
          "takesValue": true,
          "short": "-h"
        },
        {
          "name": "--port",
          "shorthand": "-p",
          "description": "Bind port",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--reload",
          "description": "Enable reloader"
        },
        {
          "name": "--no-reload",
          "description": "Disable reloader"
        },
        {
          "name": "--debugger",
          "description": "Enable debugger"
        },
        {
          "name": "--no-debugger",
          "description": "Disable debugger"
        },
        {
          "name": "--with-threads",
          "description": "Enable threading"
        },
        {
          "name": "--cert",
          "description": "SSL cert file",
          "takesValue": true
        },
        {
          "name": "--key",
          "description": "SSL key file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "shell",
      "description": "Open interactive shell with app context",
      "options": [
        {
          "name": "--app",
          "description": "Application to load",
          "type": "string",
          "takesValue": true,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--debug",
          "description": "Enable debug mode",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "routes",
      "description": "Show all registered URL routes",
      "options": [
        {
          "name": "--sort",
          "shorthand": "-s",
          "description": "Sort by (endpoint, methods, rule, match)",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--all-methods",
          "description": "Show HEAD and OPTIONS"
        }
      ]
    },
    {
      "name": "db",
      "description": "Database commands (Flask-Migrate)",
      "subcommands": [
        {
          "name": "init",
          "description": "Initialize migrations directory",
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--multidb",
              "description": "Set up migrations for multiple databases",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "migrate",
          "description": "Generate migration",
          "options": [
            {
              "name": "--message",
              "shorthand": "-m",
              "description": "Migration message",
              "takesValue": true,
              "short": "-m"
            }
          ]
        },
        {
          "name": "upgrade",
          "description": "Apply migrations",
          "args": [
            {
              "name": "revision",
              "description": "Target revision",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--tag",
              "description": "Arbitrary tag passed to the migration",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "downgrade",
          "description": "Revert migrations",
          "args": [
            {
              "name": "revision",
              "description": "Target revision",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--tag",
              "description": "Arbitrary tag passed to the migration",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "history",
          "description": "Show migration history",
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--verbose",
              "description": "Verbose output",
              "type": "boolean",
              "takesValue": false,
              "short": "-v",
              "shorthand": "-v"
            },
            {
              "name": "--rev-range",
              "description": "Revision range to show",
              "type": "string",
              "takesValue": true,
              "short": "-r",
              "shorthand": "-r"
            }
          ]
        },
        {
          "name": "current",
          "description": "Show current migration",
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--verbose",
              "description": "Verbose output",
              "type": "boolean",
              "takesValue": false,
              "short": "-v",
              "shorthand": "-v"
            }
          ]
        },
        {
          "name": "heads",
          "description": "Show head migrations",
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--verbose",
              "description": "Verbose output",
              "type": "boolean",
              "takesValue": false,
              "short": "-v",
              "shorthand": "-v"
            },
            {
              "name": "--resolve-dependencies",
              "description": "Treat dependencies as down revisions",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "stamp",
          "description": "Stamp revision without migrating",
          "args": [
            {
              "name": "revision",
              "description": "Revision",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--directory",
              "description": "Migration directory to use",
              "type": "directory",
              "takesValue": true,
              "short": "-d",
              "shorthand": "-d"
            },
            {
              "name": "--message",
              "description": "Revision message",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            },
            {
              "name": "--sql",
              "description": "Emit SQL rather than running it",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--tag",
              "description": "Arbitrary tag passed to the migration",
              "type": "string",
              "takesValue": true
            }
          ]
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--app",
      "shorthand": "-A",
      "description": "Flask application module",
      "takesValue": true,
      "short": "-A"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode"
    },
    {
      "name": "--env-file",
      "shorthand": "-e",
      "description": "Environment file",
      "takesValue": true,
      "short": "-e"
    },
    {
      "name": "--help",
      "description": "Show help"
    },
    {
      "name": "--version",
      "description": "Show version"
    }
  ],
  "examples": [
    {
      "command": "flask run",
      "description": "Run development server"
    },
    {
      "command": "flask run --host 0.0.0.0 --port 5000",
      "description": "Run on all interfaces"
    },
    {
      "command": "flask routes",
      "description": "Show URL routes"
    },
    {
      "command": "flask shell",
      "description": "Open Python shell with app context"
    },
    {
      "command": "flask db migrate -m 'Add users table'",
      "description": "Create migration"
    },
    {
      "command": "flask db upgrade",
      "description": "Apply pending migrations"
    },
    {
      "command": "FLASK_APP=app.py flask run --debug",
      "description": "Run with debug mode"
    }
  ],
  "relatedCommands": [
    "python",
    "gunicorn",
    "uvicorn"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "flask_app",
        "description": "Flask app entry point",
        "command": "echo $FLASK_APP 2>/dev/null; grep -rl 'Flask(__name__)' *.py 2>/dev/null | head -3",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "routes",
        "description": "Registered routes",
        "command": "flask routes 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "flask"
      },
      {
        "name": "blueprints",
        "description": "Flask blueprints",
        "command": "grep -rl 'Blueprint(' . --include='*.py' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "migrations",
        "description": "Migration files",
        "command": "ls migrations/versions/*.py 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "env_file",
        "description": "Flask environment config",
        "command": "cat .flaskenv 2>/dev/null || cat .env 2>/dev/null | head -10",
        "parser": "text",
        "cacheFor": 30
      }
    ]
  }
}
