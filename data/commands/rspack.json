{
  "name": "rspack",
  "description": "Rust-based bundler with webpack-compatible configuration",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build the project",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file to use",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--mode",
          "description": "Build mode (development, production, none)",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--watch",
          "description": "Rebuild on change",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--analyze",
          "description": "Emit a bundle analysis",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output-path",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "serve",
      "description": "Start the development server",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file to use",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host to bind to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--open",
          "description": "Open a browser",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--hot",
          "description": "Enable hot module replacement",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "preview",
      "description": "Serve the production build",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--dir",
          "description": "Directory to serve",
          "type": "directory",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--node-env",
      "description": "Value to set NODE_ENV to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--devtool",
      "description": "Source map style",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--json",
      "description": "Write build stats as JSON",
      "type": "file",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    }
  ],
  "examples": [
    {
      "command": "rspack build",
      "description": "Build with the default config"
    },
    {
      "command": "rspack serve --port 3000",
      "description": "Start the dev server"
    },
    {
      "command": "rspack build -m production --analyze",
      "description": "Production build with analysis"
    },
    {
      "command": "rspack build -c rspack.prod.js",
      "description": "Build with a specific config"
    }
  ],
  "relatedCommands": [
    "webpack",
    "vite",
    "parcel",
    "esbuild",
    "swc"
  ]
}
