{
  "name": "podman",
  "description": "Daemonless container engine compatible with Docker CLI",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a container",
      "examples": [
        "podman run -it ubuntu bash",
        "podman run -d -p 8080:80 nginx"
      ],
      "options": [
        {
          "name": "--detach",
          "description": "Run in the background",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--name",
          "description": "Container name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--publish",
          "description": "Publish a port",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--env",
          "description": "Environment variable",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--volume",
          "description": "Mount a volume",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--rm",
          "description": "Remove on exit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--interactive",
          "description": "Keep stdin open",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--tty",
          "description": "Allocate a pseudo-terminal",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--network",
          "description": "Network to attach",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--pod",
          "description": "Pod to join",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--userns",
          "description": "User namespace mode",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "build",
      "description": "Build an image",
      "examples": [
        "podman build -t myapp ."
      ],
      "options": [
        {
          "name": "--tag",
          "description": "Image name and tag",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--file",
          "description": "Containerfile to use",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--no-cache",
          "description": "Ignore the build cache",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Target platform",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--build-arg",
          "description": "Build argument, key=value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--squash",
          "description": "Squash the layers",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ps",
      "description": "List containers",
      "examples": [
        "podman ps",
        "podman ps -a"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include stopped containers",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--format",
          "description": "Output format template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--filter",
          "description": "Filter the output",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "images",
      "description": "List images",
      "examples": [
        "podman images"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include intermediate images",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--format",
          "description": "Output format template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--digests",
          "description": "Show image digests",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "pull",
      "description": "Pull an image",
      "examples": [
        "podman pull docker.io/library/nginx"
      ],
      "options": [
        {
          "name": "--platform",
          "description": "Platform to pull",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--tls-verify",
          "description": "Require a valid registry certificate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry credentials file",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "push",
      "description": "Push an image",
      "examples": [
        "podman push myimage registry.example.com/myimage"
      ],
      "options": [
        {
          "name": "--tls-verify",
          "description": "Require a valid registry certificate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry credentials file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Manifest format",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute command in container",
      "examples": [
        "podman exec -it mycontainer bash"
      ],
      "options": [
        {
          "name": "--interactive",
          "description": "Keep stdin open",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--tty",
          "description": "Allocate a pseudo-terminal",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--user",
          "description": "User to run as",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--workdir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--env",
          "description": "Environment variable",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to exec into",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop a container",
      "examples": [
        "podman stop mycontainer"
      ],
      "options": [
        {
          "name": "--time",
          "description": "Seconds to wait before killing",
          "type": "integer",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--all",
          "description": "Stop every container",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to act on",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove a container",
      "examples": [
        "podman rm mycontainer"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Remove a running container",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--all",
          "description": "Remove every container",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--volumes",
          "description": "Also remove anonymous volumes",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to act on",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "rmi",
      "description": "Remove an image",
      "examples": [
        "podman rmi myimage"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Remove even if tagged or in use",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--all",
          "description": "Remove every image",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "logs",
      "description": "Fetch container logs",
      "examples": [
        "podman logs mycontainer"
      ],
      "options": [
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tail",
          "description": "Lines to show from the end",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--since",
          "description": "Only logs after this time",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--timestamps",
          "description": "Prefix each line with a timestamp",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to act on",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "pod",
      "description": "Manage pods",
      "examples": [
        "podman pod create --name mypod",
        "podman pod list"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Pod name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--publish",
          "description": "Publish a port",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--share",
          "description": "Namespaces to share",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Pod operation, such as create, list, start, stop or rm",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "generate",
      "description": "Generate Kubernetes YAML",
      "examples": [
        "podman generate kube mypod > pod.yaml"
      ],
      "options": [
        {
          "name": "--files",
          "description": "Write the output to files",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--service",
          "description": "Generate a systemd service unit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--new",
          "description": "Generate units that create the container",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Generate operation, such as kube or systemd",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "play",
      "description": "Play Kubernetes YAML",
      "examples": [
        "podman play kube pod.yaml"
      ],
      "options": [
        {
          "name": "--down",
          "description": "Tear down the resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--replace",
          "description": "Replace existing resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--build",
          "description": "Build images referenced in the manifest",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Play operation, such as kube",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "compose",
      "description": "Run compose files",
      "examples": [
        "podman compose up -d"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Compose file to use",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--project-name",
          "description": "Project name",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "arguments",
          "description": "Compose arguments to pass through, such as up -d",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--root",
      "description": "Storage root dir",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--log-level",
      "description": "Log level",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "podman run -it ubuntu bash",
    "podman build -t myapp .",
    "podman ps -a",
    "podman compose up -d",
    "podman generate kube mypod"
  ],
  "relatedCommands": [
    "docker",
    "buildah",
    "skopeo",
    "kubectl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Podman version",
        "command": "podman version --format json 2>/dev/null",
        "parser": "json",
        "cacheFor": 3600,
        "requiresCmd": "podman"
      },
      {
        "name": "containers",
        "description": "Podman containers",
        "command": "podman ps --all --format '{{.Names}}\\t{{.Status}}' 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 15,
        "requiresCmd": "podman"
      },
      {
        "name": "images",
        "description": "Podman images",
        "command": "podman images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "podman"
      },
      {
        "name": "pods",
        "description": "Podman pods",
        "command": "podman pod ps --format '{{.Name}}\\t{{.Status}}' 2>/dev/null",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "podman"
      },
      {
        "name": "machines",
        "description": "Podman machines (rootless VM)",
        "command": "podman machine list --format '{{.Name}}\\t{{.Running}}' 2>/dev/null",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "podman"
      }
    ]
  }
}
