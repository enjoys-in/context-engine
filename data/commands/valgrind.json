{
  "name": "valgrind",
  "description": "Instrumentation framework for memory and threading errors",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--tool",
      "description": "Tool to run (memcheck, cachegrind, callgrind, helgrind, massif)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--leak-check",
      "description": "Leak reporting detail (no, summary, yes, full)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show-leak-kinds",
      "description": "Leak kinds to report",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--track-origins",
      "description": "Trace the origin of uninitialised values",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--log-file",
      "description": "Write the report to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--xml",
      "description": "Emit XML output",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--error-exitcode",
      "description": "Exit with this code when errors are found",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--suppressions",
      "description": "Suppression file to apply",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--gen-suppressions",
      "description": "Print suppressions for each error",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--trace-children",
      "description": "Also instrument child processes",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "valgrind ./prog",
      "description": "Run under memcheck"
    },
    {
      "command": "valgrind --leak-check=full --track-origins=yes ./prog",
      "description": "Full leak report with origins"
    },
    {
      "command": "valgrind --tool=callgrind ./prog",
      "description": "Profile call counts"
    },
    {
      "command": "valgrind --error-exitcode=1 ./tests",
      "description": "Fail a build on memory errors"
    }
  ],
  "relatedCommands": [
    "gdb",
    "perf",
    "asan",
    "strace"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Valgrind version",
        "command": "valgrind --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "valgrind"
      },
      {
        "name": "tools",
        "description": "Valgrind tools available",
        "command": "valgrind --help 2>/dev/null | grep -A8 'tool selection'",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "valgrind"
      },
      {
        "name": "suppressions",
        "description": "Valgrind suppression files present",
        "command": "find . -maxdepth 2 -name '*.supp' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "executables",
        "description": "Executables Valgrind can instrument",
        "command": "find . -maxdepth 2 -type f -perm -u+x 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
