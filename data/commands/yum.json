{
  "name": "yum",
  "description": "Package manager for RHEL/CentOS (legacy, replaced by dnf)",
  "category": "package-manager",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true,
          "type": "package"
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Assume yes"
        },
        {
          "name": "--enablerepo",
          "description": "Enable repository",
          "takesValue": true
        },
        {
          "name": "--disablerepo",
          "description": "Disable repository",
          "takesValue": true
        }
      ],
      "examples": [
        "yum install httpd"
      ]
    },
    {
      "name": "update",
      "description": "Update packages",
      "args": [
        {
          "name": "packages",
          "description": "Specific packages (optional)",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--security",
          "description": "Only security updates",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclude",
          "description": "Packages to skip",
          "type": "string",
          "takesValue": true,
          "short": "-x",
          "shorthand": "-x"
        }
      ],
      "examples": [
        "yum update httpd"
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "examples": [
        "yum remove httpd"
      ]
    },
    {
      "name": "erase",
      "description": "Alias for remove",
