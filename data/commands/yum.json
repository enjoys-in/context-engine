  "globalOptions": [
    {
      "name": "-y",
      "description": "Assume yes"
    },
    {
      "name": "-q",
      "description": "Quiet"
    },
    {
      "name": "-v",
      "description": "Verbose"
    },
    {
      "name": "--enablerepo",
      "description": "Enable repo",
      "takesValue": true
    },
    {
      "name": "--disablerepo",
      "description": "Disable repo",
      "takesValue": true
    },
    {
      "name": "--nogpgcheck",
      "description": "Skip GPG checks"
    },
    {
      "name": "--skip-broken",
      "description": "Skip broken packages"
    },
