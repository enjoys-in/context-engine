{
  "name": "yum",
  "description": "Package manager for RHEL/CentOS (legacy, replaced by dnf)",
  "category": "package-manager",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Assume yes"
        },
        {
          "name": "--enablerepo",
          "description": "Enable repository",
          "takesValue": true
        },
        {
          "name": "--disablerepo",
          "description": "Disable repository",
          "takesValue": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Update packages",
      "args": [
        {
          "name": "packages",
          "description": "Specific packages (optional)",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--security",
          "description": "Only security updates",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclude",
          "description": "Packages to skip",
          "type": "string",
          "takesValue": true,
          "short": "-x",
          "shorthand": "-x"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "erase",
      "description": "Alias for remove",
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "list",
      "description": "List packages",
      "options": [
        {
          "name": "installed",
          "description": "Only installed"
        },
        {
          "name": "available",
          "description": "Only available"
        },
        {
          "name": "updates",
          "description": "Only updates"
        }
      ]
    },
    {
      "name": "search",
      "description": "Search packages",
      "args": [
        {
          "name": "query",
          "description": "Search term",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--all",
          "description": "Search descriptions too",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "info",
      "description": "Show package information",
      "args": [
        {
          "name": "package",
          "description": "Package name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--available",
          "description": "Only available packages",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--installed",
          "description": "Only installed packages",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "provides",
      "description": "Find package providing a file",
      "args": [
        {
          "name": "file",
          "description": "File path or glob",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--quiet",
          "description": "Print names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "check-update",
      "description": "Check for available updates",
      "options": [
        {
          "name": "--security",
          "description": "Only security updates",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade all packages",
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--exclude",
          "description": "Packages to skip",
          "type": "string",
          "takesValue": true,
          "short": "-x",
          "shorthand": "-x"
        }
      ]
    },
    {
      "name": "downgrade",
      "description": "Downgrade a package",
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "reinstall",
      "description": "Reinstall a package",
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean caches",
      "subcommands": [
        {
          "name": "all",
          "description": "Clean all caches"
        },
        {
          "name": "metadata",
          "description": "Clean metadata"
        },
        {
          "name": "packages",
          "description": "Clean packages"
        },
        {
          "name": "dbcache",
          "description": "Clean dbcache"
        },
        {
          "name": "expire-cache",
          "description": "Expire cache"
        }
      ]
    },
    {
      "name": "makecache",
      "description": "Generate metadata cache",
      "options": [
        {
          "name": "--timer",
          "description": "Run as the background timer would",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "groupinstall",
      "description": "Install a group",
      "args": [
        {
          "name": "group",
          "description": "Group name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--setopt",
          "description": "Set a configuration option, key=value",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "grouplist",
      "description": "List groups",
      "options": [
        {
          "name": "--available",
          "description": "Only available groups",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--installed",
          "description": "Only installed groups",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "groupinfo",
      "description": "Group details"
    },
    {
      "name": "repolist",
      "description": "List repositories",
      "options": [
        {
          "name": "--all",
          "description": "Include disabled repositories",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--enabled",
          "description": "Only enabled repositories",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "repoinfo",
      "description": "Repository details"
    },
    {
      "name": "deplist",
      "description": "List dependencies"
    },
    {
      "name": "history",
      "description": "Transaction history"
    },
    {
      "name": "localinstall",
      "description": "Install local RPM",
      "options": [
        {
          "name": "--assumeyes",
          "description": "Answer yes to every question",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--nogpgcheck",
          "description": "Skip GPG signature checks",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-y",
      "description": "Assume yes"
    },
    {
      "name": "-q",
      "description": "Quiet"
    },
    {
      "name": "-v",
      "description": "Verbose"
    },
    {
      "name": "--enablerepo",
      "description": "Enable repo",
      "takesValue": true
    },
    {
      "name": "--disablerepo",
      "description": "Disable repo",
      "takesValue": true
    },
    {
      "name": "--nogpgcheck",
      "description": "Skip GPG checks"
    },
    {
      "name": "--skip-broken",
      "description": "Skip broken packages"
    },
    {
      "name": "-C",
      "description": "Use cache only"
    },
    {
      "name": "--downloadonly",
      "description": "Download without installing"
    },
    {
      "name": "--setopt",
      "description": "Set config option",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "sudo yum install nginx",
      "description": "Install nginx"
    },
    {
      "command": "sudo yum install -y git curl wget",
      "description": "Install with auto-yes"
    },
    {
      "command": "sudo yum update",
      "description": "Update all packages"
    },
    {
      "command": "sudo yum remove httpd",
      "description": "Remove package"
    },
    {
      "command": "yum search redis",
      "description": "Search packages"
    },
    {
      "command": "yum info nginx",
      "description": "Package details"
    },
    {
      "command": "yum list installed",
      "description": "List installed"
    },
    {
      "command": "yum check-update",
      "description": "Check for updates"
    },
    {
      "command": "yum repolist",
      "description": "List enabled repos"
    },
    {
      "command": "sudo yum clean all",
      "description": "Clean all caches"
    }
  ],
  "relatedCommands": [
    "dnf",
    "rpm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed",
        "description": "Installed packages",
        "command": "yum list installed 2>/dev/null | tail -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "yum"
      },
      {
        "name": "repos",
        "description": "Configured repositories",
        "command": "yum repolist 2>/dev/null | tail -10",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "yum"
      },
      {
        "name": "updates",
        "description": "Available updates",
        "command": "yum check-update 2>/dev/null | tail -15",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "yum"
      }
    ]
  }
}
