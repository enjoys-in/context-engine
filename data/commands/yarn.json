{
  "name": "yarn",
  "description": "Fast, reliable, and secure JavaScript package manager",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Create a new package.json",
      "options": [
        {
          "name": "--yes",
          "short": "-y",
          "description": "Accept defaults",
          "shorthand": "-y"
        }
      ],
      "examples": [
        "yarn init",
        "yarn init -y"
      ]
    },
    {
      "name": "add",
      "description": "Add a package",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": true,
          "description": "Package name"
        }
      ],
      "options": [
        {
          "name": "--dev",
          "short": "-D",
          "description": "Add to devDependencies",
          "shorthand": "-D"
        },
        {
          "name": "--peer",
          "short": "-P",
          "description": "Add to peerDependencies",
          "shorthand": "-P"
        },
        {
          "name": "--exact",
          "short": "-E",
          "description": "Add exact version",
          "shorthand": "-E"
        }
      ],
      "examples": [
        "yarn add react",
        "yarn add -D typescript",
        "yarn add react@^18.0.0"
      ]
    },
    {
      "name": "remove",
      "description": "Remove a package",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": true,
          "description": "Package name"
        }
      ],
      "examples": [
        "yarn remove lodash"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "install",
      "description": "Install all dependencies",
      "options": [
        {
          "name": "--frozen-lockfile",
          "description": "Don't generate lockfile changes"
        },
        {
          "name": "--production",
          "description": "Only install production dependencies"
        }
      ],
      "examples": [
        "yarn install",
        "yarn install --frozen-lockfile"
      ]
    },
    {
      "name": "run",
      "description": "Run a script from package.json",
      "args": [
        {
          "name": "<script>",
          "type": "string",
          "required": true,
          "description": "Script name"
        }
      ],
      "examples": [
        "yarn run build",
        "yarn run dev"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade packages",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": false,
          "description": "Package name"
        }
      ],
      "options": [
        {
          "name": "--latest",
          "description": "Upgrade to latest version"
        }
      ],
      "examples": [
        "yarn upgrade",
        "yarn upgrade --latest"
      ]
    },
    {
      "name": "outdated",
      "description": "Check for outdated packages",
      "examples": [
        "yarn outdated"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cache clean",
      "description": "Clean cache",
      "examples": [
        "yarn cache clean"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--mirror",
          "description": "Also clean the local mirror",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "link",
      "description": "Symlink a local package",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": false,
          "description": "Package name"
        }
      ],
      "examples": [
        "yarn link",
        "yarn link my-package"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--all",
          "description": "Link every workspace",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--private",
          "description": "Include private packages",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "dlx",
      "description": "Run a package without installing (Yarn Berry)",
      "args": [
        {
          "name": "<command>",
          "type": "string",
          "required": true,
          "description": "Command to run"
        }
      ],
      "examples": [
        "yarn dlx create-react-app myapp"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--package",
          "description": "Package to run the binary from",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "workspace",
      "description": "Run command in workspace",
      "examples": [
        "yarn workspace @myapp/server add express"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "workspaces foreach",
      "description": "Run command in all workspaces",
      "examples": [
        "yarn workspaces foreach run build"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cwd",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--parallel",
          "description": "Run in every workspace at once",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--topological",
          "description": "Respect dependency order",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--all",
          "description": "Include every workspace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "short": "-v",
      "description": "Show version",
      "shorthand": "-v"
    },
    {
      "name": "--verbose",
      "description": "Verbose output"
    }
  ],
  "examples": [
    "yarn add react react-dom",
    "yarn install --frozen-lockfile",
    "yarn run build"
  ],
  "relatedCommands": [
    "npm",
    "pnpm",
    "npx",
    "node"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Yarn version",
        "command": "yarn --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "yarn"
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "workspaces",
        "description": "Yarn workspace globs declared",
        "command": "grep -A8 '\"workspaces\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Yarn configuration for this project",
        "command": "cat .yarnrc.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
