{
  "name": "biome",
  "description": "Fast formatter, linter and import sorter for JavaScript and TypeScript",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "check",
      "description": "Run the formatter, linter and import sorter",
      "options": [
        {
          "name": "--write",
          "description": "Apply the safe fixes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--unsafe",
          "description": "Also apply unsafe fixes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--changed",
          "description": "Only check files changed against the VCS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--staged",
          "description": "Only check staged files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--reporter",
          "description": "Report format (json, junit, github, summary)",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "paths",
          "description": "Files or directories to check",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "format",
      "description": "Format files",
      "options": [
        {
          "name": "--write",
          "description": "Write the formatted output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--indent-style",
          "description": "Indent style (tab, space)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--line-width",
          "description": "Maximum line width",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "paths",
          "description": "Files or directories to format",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "lint",
      "description": "Lint files",
      "options": [
        {
          "name": "--write",
          "description": "Apply the safe fixes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--only",
          "description": "Only run these rules",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--skip",
          "description": "Skip these rules",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "paths",
          "description": "Files or directories to lint",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "ci",
      "description": "Run every check in CI mode, without writing",
      "options": [
        {
          "name": "--reporter",
          "description": "Report format",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "init",
      "description": "Create a biome.json"
    },
    {
      "name": "migrate",
      "description": "Migrate configuration from ESLint or Prettier",
      "options": [
        {
          "name": "--write",
          "description": "Apply the migration",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "explain",
      "description": "Explain a rule or concept",
      "args": [
        {
          "name": "name",
          "description": "Rule or topic",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "search",
      "description": "Search the codebase with a GritQL pattern",
      "args": [
        {
          "name": "pattern",
          "description": "GritQL pattern",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Remove the Biome cache"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config-path",
      "description": "Directory holding biome.json",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--colors",
      "description": "When to colour output (off, force)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log-level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--max-diagnostics",
      "description": "Cap the reported diagnostics",
      "type": "integer",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "biome check .",
      "description": "Check formatting, lints and imports"
    },
    {
      "command": "biome check --write .",
      "description": "Apply the safe fixes"
    },
    {
      "command": "biome format --write src/",
      "description": "Format a directory"
    },
    {
      "command": "biome ci .",
      "description": "Run in CI without writing"
    },
    {
      "command": "biome migrate eslint --write",
      "description": "Import an ESLint configuration"
    }
  ],
  "relatedCommands": [
    "eslint",
    "prettier",
    "ruff",
    "oxlint",
    "tsc"
  ]
}
