{
  "name": "syft",
  "description": "Software Bill of Materials (SBOM) generator for containers and filesystems",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "scan",
      "description": "Generate SBOM from source",
      "examples": [
        "syft scan dir:.",
        "syft scan image:tag"
      ],
      "options": [
        {
          "name": "--output",
          "description": "SBOM format to emit",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--scope",
          "description": "Cataloguing scope: squashed or all-layers",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--file",
          "description": "Write the SBOM here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--platform",
          "description": "Platform of the image to scan",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "packages",
      "description": "List packages (alias for scan)",
      "examples": [
        "syft packages image:tag"
      ],
      "options": [
        {
          "name": "--output",
          "description": "SBOM format to emit",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--scope",
          "description": "Cataloguing scope: squashed or all-layers",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "attest",
      "description": "Generate SBOM attestation",
      "examples": [
        "syft attest --key cosign.key image:tag"
      ],
      "options": [
        {
          "name": "--key",
          "description": "Private key to sign the attestation with",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--output",
          "description": "SBOM format to emit",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "convert",
      "description": "Convert SBOM format",
      "examples": [
        "syft convert sbom.json -o spdx-json"
      ],
      "options": [
        {
          "name": "--output",
          "description": "SBOM format to emit",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--file",
          "description": "Write the converted SBOM here",
          "type": "file",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Output format (syft-json, spdx-json, cyclonedx-json, table)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--scope",
      "description": "Analysis scope (squashed, all-layers)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Exclude paths",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "syft scan image:tag",
    "syft scan dir:.",
    "syft scan image:tag -o spdx-json",
    "syft packages image:tag -o cyclonedx-json",
    "syft scan image:tag -o table"
  ],
  "relatedCommands": [
    "grype",
    "cosign",
    "trivy",
    "docker"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "syft version",
        "command": "syft version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "syft"
      },
      {
        "name": "config",
        "description": "syft configuration",
        "command": "cat .syft.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "manifests",
        "description": "Package manifests syft can catalogue",
        "command": "ls package.json go.mod requirements.txt Gemfile.lock pom.xml Cargo.lock 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "images",
        "description": "Local images syft can scan",
        "command": "docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "docker"
      }
    ]
  }
}
