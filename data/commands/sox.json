{
  "name": "sox",
  "description": "Sound eXchange — convert, play and apply effects to audio",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--rate",
      "description": "Sample rate in hertz",
      "type": "integer",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--channels",
      "description": "Channel count",
      "type": "integer",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--bits",
      "description": "Sample size in bits",
      "type": "integer",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--type",
      "description": "File type of the next file",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--volume",
      "description": "Scale the input volume",
      "type": "number",
      "takesValue": true,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--norm",
      "description": "Normalise the output level",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show-progress",
      "description": "Display progress",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--no-show-progress",
      "description": "Hide progress",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--combine",
      "description": "How to combine inputs (concatenate, mix, merge)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "sox in.wav out.mp3",
      "description": "Convert between formats"
    },
    {
      "command": "sox in.wav out.wav trim 0 30",
      "description": "Keep the first 30 seconds"
    },
    {
      "command": "sox -m a.wav b.wav mixed.wav",
      "description": "Mix two files"
    },
    {
      "command": "sox in.wav out.wav rate 44100 channels 1",
      "description": "Resample to mono at 44.1 kHz"
    }
  ],
  "relatedCommands": [
    "ffmpeg",
    "imagemagick",
    "yt-dlp"
  ]
}
