{
  "name": "dive",
  "description": "Explore a Docker image layer by layer and find wasted space",
  "category": "container",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--source",
      "description": "Image source (docker, podman, docker-archive)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ci",
      "description": "Run non-interactively and enforce the rules",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--ci-config",
      "description": "CI rules file to apply",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--lowestEfficiency",
      "description": "Fail below this efficiency ratio",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--highestUserWastedPercent",
      "description": "Fail above this wasted percentage",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--highestWastedBytes",
      "description": "Fail above this many wasted bytes",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--json",
      "description": "Write the analysis to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--ignore-errors",
      "description": "Continue when a layer cannot be read",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "dive nginx:latest",
      "description": "Explore an image interactively"
    },
    {
      "command": "dive --ci app:dev",
      "description": "Enforce efficiency rules in CI"
    },
    {
      "command": "dive --json report.json app:dev",
      "description": "Export the analysis"
    },
    {
      "command": "dive --source podman app:dev",
      "description": "Analyse a podman image"
    }
  ],
  "relatedCommands": [
    "docker",
    "lazydocker",
    "nerdctl",
    "syft"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "dive version",
        "command": "dive --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dive"
      },
      {
        "name": "images",
        "description": "Local images dive can analyse",
        "command": "docker images --format '{{.Repository}}:{{.Tag}}\\t{{.Size}}' 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "docker"
      },
      {
        "name": "config",
        "description": "dive configuration",
        "command": "cat ~/.dive.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "dockerfiles",
        "description": "Dockerfiles in this project",
        "command": "ls Dockerfile* 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
