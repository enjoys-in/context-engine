{
  "name": "watch",
  "description": "Execute a program periodically, showing output fullscreen",
  "category": "system",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Interval in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Highlight differences between updates"
    },
    {
      "name": "-t",
      "description": "Turn off header"
    },
    {
      "name": "-g",
      "description": "Exit when output changes"
    },
    {
      "name": "-e",
      "description": "Exit on error"
    },
    {
      "name": "-c",
      "description": "Interpret ANSI color sequences"
    },
    {
      "name": "-x",
      "description": "Pass command to exec instead of sh -c"
    }
  ],
  "examples": [
    "watch -n 2 'df -h'",
    "watch -d 'ls -la'",
    "watch -n 1 'kubectl get pods'",
    "watch -g 'cat status.txt'",
    "watch -n 5 -d 'free -h'",
    "watch -tc 'docker ps'"
  ],
  "relatedCommands": [
    "while",
    "cron",
    "entr"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "watch version",
        "command": "watch --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "watch"
      },
      {
        "name": "interval_default",
        "description": "Default watch interval in seconds",
        "command": "echo 2",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "term",
        "description": "Terminal type watch will render into",
        "command": "echo \"${TERM:-unknown}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
