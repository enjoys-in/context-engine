{
  "name": "nim",
  "description": "Nim programming language compiler",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "c",
      "description": "Compile to C and build",
      "examples": [
        "nim c src/main.nim"
      ],
      "options": [
        {
          "name": "-d",
          "description": "Define a conditional symbol",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--opt",
          "description": "Optimisation target: none, speed or size",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--out",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--threads",
          "description": "Enable thread support",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-r",
          "description": "Run the binary after compiling",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Nim source file to compile",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "cpp",
      "description": "Compile to C++",
      "examples": [
        "nim cpp src/main.nim"
      ],
      "options": [
        {
          "name": "-d",
          "description": "Define a conditional symbol",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--opt",
          "description": "Optimisation target: none, speed or size",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--out",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Nim source file to compile",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "js",
      "description": "Compile to JavaScript",
      "examples": [
        "nim js src/main.nim"
      ],
      "options": [
        {
          "name": "-d",
          "description": "Define a conditional symbol",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--out",
          "description": "Path for the output file",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Nim source file to compile",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "r",
      "description": "Compile and run",
      "examples": [
        "nim r src/main.nim"
      ],
      "options": [
        {
          "name": "-d",
          "description": "Define a conditional symbol",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--opt",
          "description": "Optimisation target: none, speed or size",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Nim source file to compile",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "check",
      "description": "Check for errors without compiling",
      "examples": [
        "nim check src/main.nim"
      ],
      "options": [
        {
          "name": "--hints",
          "description": "Whether to print hints",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Nim source file to compile",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "doc",
      "description": "Generate documentation",
      "examples": [
        "nim doc src/main.nim"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Document the whole project",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--outdir",
          "description": "Directory to write the docs to",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--index",
          "description": "Generate an index",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Nim source file to compile",
          "required": true,
          "type": "file"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-d:release",
      "description": "Release build"
    },
    {
      "name": "-d:danger",
      "description": "Danger build (no checks)"
    },
    {
      "name": "--opt:speed",
      "description": "Optimize for speed"
    },
    {
      "name": "--opt:size",
      "description": "Optimize for size"
    },
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--run",
      "description": "Run after compiling"
    },
    {
      "name": "--threads:on",
      "description": "Enable threading"
    }
  ],
  "examples": [
    "nim c -r src/main.nim",
    "nim c -d:release src/main.nim",
    "nim js src/main.nim",
    "nimble install package",
    "nimble build"
  ],
  "relatedCommands": [
    "nimble",
    "gcc",
    "zig",
    "crystal"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Nim compiler version",
        "command": "nim --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "nim"
      },
      {
        "name": "project",
        "description": "Nimble package definition",
        "command": "cat *.nimble 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Nim project configuration",
        "command": "cat nim.cfg 2>/dev/null || cat config.nims 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "sources",
        "description": "Nim sources",
        "command": "find . -maxdepth 3 -name '*.nim' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
