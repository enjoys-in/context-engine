{
  "name": "dig",
  "description": "DNS lookup utility",
  "category": "networking",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "+short",
      "description": "Short (terse) output"
    },
    {
      "name": "+trace",
      "description": "Trace delegation path"
    },
    {
      "name": "+noall",
      "description": "Turn off all display flags"
    },
    {
      "name": "+answer",
      "description": "Display answer section"
    },
    {
      "name": "@",
      "description": "Use specified DNS server",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-x",
      "description": "Reverse DNS lookup"
    },
    {
      "name": "-t",
      "description": "Query type (A, AAAA, MX, NS, TXT, CNAME, SOA)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "+nocmd",
      "description": "Do not print query line"
    }
  ],
  "examples": [
    "dig example.com",
    "dig example.com +short",
    "dig @8.8.8.8 example.com",
    "dig -t MX example.com",
    "dig -t TXT example.com",
    "dig -x 8.8.8.8",
    "dig +trace example.com",
    "dig example.com NS +short"
  ],
  "relatedCommands": [
    "nslookup",
    "host",
    "whois",
    "ping"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "dig version",
        "command": "dig -v 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dig"
      },
      {
        "name": "resolvers",
        "description": "DNS resolvers configured",
        "command": "cat /etc/resolv.conf 2>/dev/null | grep nameserver",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "search_domains",
        "description": "DNS search domains",
        "command": "grep -E '^(search|domain)' /etc/resolv.conf 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
