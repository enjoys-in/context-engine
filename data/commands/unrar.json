{
  "name": "unrar",
  "aliases": [
    "rar"
  ],
  "description": "Extract RAR archives",
  "category": "archive",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "x",
      "description": "Extract with full paths",
      "options": [
        {
          "name": "-p",
          "description": "Archive password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-o+",
          "description": "Overwrite existing files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-y",
          "description": "Assume yes to every prompt",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "archive",
          "description": "Archive to extract",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "e",
      "description": "Extract, flattening paths",
      "args": [
        {
          "name": "archive",
          "description": "Archive to extract",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Password to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-o+",
          "description": "Overwrite existing files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-y",
          "description": "Assume yes to all prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-inul",
          "description": "Suppress all output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "l",
      "description": "List the archive contents",
      "args": [
        {
          "name": "archive",
          "description": "Archive to inspect",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Password to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose listing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "t",
      "description": "Test archive integrity",
      "args": [
        {
          "name": "archive",
          "description": "Archive to verify",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Password to use",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-y",
      "description": "Assume yes to every prompt",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-inul",
      "description": "Suppress all output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "unrar l archive.rar",
      "description": "List the contents"
    },
    {
      "command": "unrar x archive.rar",
      "description": "Extract preserving paths"
    },
    {
      "command": "unrar t archive.rar",
      "description": "Verify integrity"
    }
  ],
  "relatedCommands": [
    "7z",
    "unzip",
    "tar"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "unrar version",
        "command": "unrar 2>&1 | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "unrar"
      },
      {
        "name": "archives",
        "description": "RAR archives in this directory",
        "command": "find . -maxdepth 2 -name '*.rar' -o -name '*.r00' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
