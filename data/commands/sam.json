{
  "name": "sam",
  "description": "AWS Serverless Application Model CLI",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a new SAM project",
      "examples": [
        "sam init",
        "sam init --runtime nodejs20.x"
      ],
      "options": [
        {
          "name": "--runtime",
          "description": "Runtime for the new application",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--name",
          "description": "Name for the new application",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--app-template",
          "description": "Template to scaffold from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-interactive",
          "description": "Fail rather than prompting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--package-type",
          "description": "Package type: Zip or Image",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "build",
      "description": "Build serverless application",
      "examples": [
        "sam build"
      ],
      "options": [
        {
          "name": "--use-container",
          "description": "Build inside a Lambda-like container",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--parallel",
          "description": "Build functions in parallel",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cached",
          "description": "Reuse cached build artifacts",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--template",
          "description": "Template file to build from",
          "type": "file",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--parameter-overrides",
          "description": "Override template parameters",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy to AWS",
      "examples": [
        "sam deploy --guided",
        "sam deploy"
      ],
      "options": [
        {
          "name": "--guided",
          "description": "Prompt for the deployment settings",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--stack-name",
          "description": "CloudFormation stack name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--capabilities",
          "description": "Capabilities to acknowledge",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--parameter-overrides",
          "description": "Override template parameters",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-confirm-changeset",
          "description": "Deploy without confirming the change set",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--region",
          "description": "Region to deploy to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "local invoke",
      "description": "Invoke function locally",
      "examples": [
        "sam local invoke MyFunction"
      ],
      "options": [
        {
          "name": "--event",
          "description": "Event payload file to invoke with",
          "type": "file",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--env-vars",
          "description": "Environment variables file",
          "type": "file",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--docker-network",
          "description": "Docker network to attach to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--debug-port",
          "description": "Port to expose for the debugger",
          "type": "integer",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "function",
          "description": "Logical id of the function to invoke",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "local start-api",
      "description": "Start local API Gateway",
      "examples": [
        "sam local start-api"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the local API listens on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--host",
          "description": "Host the local API binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--warm-containers",
          "description": "Container reuse strategy",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env-vars",
          "description": "Environment variables file",
          "type": "file",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "local start-lambda",
      "description": "Start local Lambda endpoint",
      "examples": [
        "sam local start-lambda"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the local endpoint listens on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--host",
          "description": "Host the local endpoint binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env-vars",
          "description": "Environment variables file",
          "type": "file",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "validate",
      "description": "Validate template",
      "examples": [
        "sam validate"
      ],
      "options": [
        {
          "name": "--template",
          "description": "Template file to validate",
          "type": "file",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--lint",
          "description": "Also run the cfn-lint checks",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "logs",
      "description": "Fetch function logs",
      "examples": [
        "sam logs -n MyFunction --tail"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Function whose logs to fetch",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--stack-name",
          "description": "Stack the function belongs to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tail",
          "description": "Stream new log entries",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--filter",
          "description": "Only show entries matching this pattern",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete deployed stack",
      "examples": [
        "sam delete"
      ],
      "options": [
        {
          "name": "--stack-name",
          "description": "Stack to delete",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-prompts",
          "description": "Delete without confirming",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--region",
          "description": "Region the stack lives in",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "sync",
      "description": "Sync local changes to AWS",
      "examples": [
        "sam sync --watch"
      ],
      "options": [
        {
          "name": "--watch",
          "description": "Watch for changes and sync continuously",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--code",
          "description": "Sync code changes only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--stack-name",
          "description": "Stack to sync",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dependency-layer",
          "description": "Move dependencies into a layer",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--region",
      "description": "AWS region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--profile",
      "description": "AWS profile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--template-file",
      "short": "-t",
      "description": "SAM template file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-t"
    }
  ],
  "examples": [
    "sam init",
    "sam build",
    "sam deploy --guided",
    "sam local invoke MyFunction",
    "sam local start-api",
    "sam sync --watch"
  ],
  "relatedCommands": [
    "serverless",
    "cdk",
    "aws",
    "cloudformation"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "AWS SAM CLI version",
        "command": "sam --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "sam"
      },
      {
        "name": "template",
        "description": "SAM template for this project",
        "command": "cat template.yaml 2>/dev/null | head -60 || cat template.yml 2>/dev/null | head -60",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "SAM deployment configuration",
        "command": "cat samconfig.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "build_dir",
        "description": "SAM build artifacts present",
        "command": "ls .aws-sam/build 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
