  ],
  "examples": [
    "sphinx-build -b html docs/ docs/_build/html",
    "sphinx-build -b latex docs/ docs/_build/latex && cd docs/_build/latex && make",
    "sphinx-build -W -n -b linkcheck docs/ docs/_build/linkcheck",
    "sphinx-quickstart docs/",
    "rst2html.py README.rst README.html",
    "sphinx-autobuild docs/ docs/_build/html"
  ],
  "relatedCommands": [
    "pandoc",
    "python",
    "markdown",
    "pip"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Sphinx version",
        "command": "sphinx-build --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "sphinx-build"
      },
      {
        "name": "config",
        "description": "Sphinx project configuration",
        "command": "cat conf.py 2>/dev/null | head -40 || cat docs/conf.py 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "documents",
        "description": "reStructuredText documents in this project",
        "command": "find . -maxdepth 3 -name '*.rst' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "build_dir",
        "description": "Sphinx build output",
        "command": "ls _build docs/_build 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
