{
  "language": "restructuredtext",
  "name": "sphinx-build",
  "description": "Sphinx — reStructuredText documentation builder",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-b",
      "description": "Builder to use (html, latex, epub, man, linkcheck, doctest)"
    },
    {
      "name": "-j",
      "description": "Number of parallel build processes"
    },
    {
      "name": "-W",
      "description": "Turn warnings into errors"
    },
    {
      "name": "-n",
      "description": "Warn about all missing references"
    },
    {
      "name": "-c",
      "description": "Path to conf.py directory"
    },
    {
      "name": "-D",
      "description": "Override a conf.py setting (key=value)"
    },
    {
      "name": "-a",
      "description": "Write all output files (not just new/changed)"
    },
    {
      "name": "-E",
      "description": "Don't use saved environment, always read all files"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    }
  ],
  "subcommands": [
    {
      "name": "-b html source build",
      "description": "Build HTML documentation",
      "args": [
        {
          "name": "source",
          "description": "Directory holding the reStructuredText sources",
          "type": "directory",
          "required": true
        },
        {
          "name": "build",
          "description": "Directory to write the build into",
          "type": "directory",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-a",
          "description": "Write all files, not just changed ones",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-E",
          "description": "Do not use a saved environment",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-j",
          "description": "Number of parallel workers",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Override a config setting",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-q",
          "description": "Suppress output except warnings",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-W",
          "description": "Turn warnings into errors",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
