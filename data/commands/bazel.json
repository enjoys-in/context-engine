          "takesValue": false
        },
        {
          "name": "--incremental",
          "description": "Install incrementally",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--device",
          "description": "Target device serial",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "shutdown",
      "description": "Stop Bazel server",
      "options": [
        {
          "name": "--iff_heap_size_greater_than",
          "description": "Only shut down above this heap size in MB",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "options": [
        {
          "name": "--gnu_format",
          "description": "Print the version in GNU format",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "help",
      "description": "Show help",
      "options": [
        {
          "name": "--short",
          "description": "Print a brief listing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--long",
          "description": "Print full option detail",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--output_base",
      "description": "Output base directory",
      "takesValue": true
    },
    {
      "name": "--batch",
      "description": "Run without server"
    },
    {
      "name": "--blazerc",
      "description": "Bazelrc file",
      "takesValue": true
    },
    {
      "name": "--norc",
      "description": "Don't read bazelrc"
    }
  ],
  "examples": [
    {
      "command": "bazel build //...",
      "description": "Build all targets"
    },
    {
      "command": "bazel test //...",
      "description": "Run all tests"
    },
    {
      "command": "bazel build //src:main -c opt",
      "description": "Optimized build"
    },
    {
      "command": "bazel test //tests:unit --test_output=all",
      "description": "Tests with full output"
    },
    {
      "command": "bazel run //cmd:server",
      "description": "Build and run"
    },
    {
      "command": "bazel query 'deps(//src:main)'",
      "description": "Query dependencies"
    },
    {
      "command": "bazel clean --expunge",
      "description": "Full clean"
    },
    {
      "command": "bazel info workspace",
      "description": "Show workspace path"
    }
  ],
  "relatedCommands": [
    "make",
    "cmake"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "workspace",
        "description": "Workspace configuration",
        "command": "cat WORKSPACE 2>/dev/null || cat WORKSPACE.bazel 2>/dev/null || cat MODULE.bazel 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "build_targets",
        "description": "Available targets in current package",
        "command": "bazel query '//...' --output=label 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "bazel"
      },
      {
        "name": "build_files",
        "description": "BUILD files",
        "command": "find . -name 'BUILD' -o -name 'BUILD.bazel' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "bazelrc",
        "description": "Bazel configuration",
        "command": "cat .bazelrc 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "info",
        "description": "Bazel workspace info",
        "command": "bazel info 2>/dev/null | head -15",
        "parser": "keyvalue",
        "cacheFor": 60,
        "requiresCmd": "bazel"
      }
    ]
  }
}
