        {
          "name": "--test_output",
          "description": "Test output verbosity",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "mobile-install",
      "description": "Install on Android device",
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose_failures",
          "description": "Show full command lines for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output_base",
          "description": "Output base directory",
          "type": "directory",
