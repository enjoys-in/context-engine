{
  "name": "bazel",
  "description": "Google's build and test tool for multi-language, multi-platform projects",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build specified targets",
      "args": [
        {
          "name": "targets",
          "description": "Build targets (//package:target)",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Use build configuration",
          "takesValue": true
        },
        {
          "name": "--compilation_mode",
          "shorthand": "-c",
          "description": "Compilation mode (fastbuild, dbg, opt)",
          "takesValue": true,
          "short": "-c"
        },
        {
          "name": "--jobs",
          "shorthand": "-j",
          "description": "Concurrent jobs",
          "takesValue": true,
          "short": "-j"
        },
        {
          "name": "--platforms",
          "description": "Target platform",
          "takesValue": true
        },
        {
          "name": "--define",
          "description": "Define variable",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "shorthand": "-k",
          "description": "Continue on errors",
          "short": "-k"
        },
        {
          "name": "--verbose_failures",
          "description": "Verbose failure output"
        },
        {
          "name": "--sandbox_debug",
          "description": "Debug sandboxing"
        },
        {
          "name": "--remote_cache",
          "description": "Remote cache URL",
          "takesValue": true
        }
      ]
    },
    {
      "name": "test",
      "description": "Build and run tests",
      "args": [
        {
          "name": "targets",
          "description": "Test targets",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--test_output",
          "description": "Test output (summary, errors, all, streamed)",
          "takesValue": true
        },
        {
          "name": "--test_filter",
          "description": "Test name filter",
          "takesValue": true
        },
        {
          "name": "--test_timeout",
          "description": "Test timeout",
          "takesValue": true
        },
        {
          "name": "--cache_test_results",
          "description": "Cache results (yes, no, auto)",
          "takesValue": true
        },
        {
          "name": "--test_env",
          "description": "Set test env variable",
          "takesValue": true
        },
        {
          "name": "--test_arg",
          "description": "Pass arg to test runner",
          "takesValue": true
        },
        {
          "name": "--runs_per_test",
          "description": "Run count per test",
          "takesValue": true
        },
        {
          "name": "--flaky_test_attempts",
          "description": "Retry attempts for flaky tests",
          "takesValue": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run a target",
      "args": [
        {
          "name": "target",
          "description": "Target to run",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose_failures",
          "description": "Show full command lines for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output_base",
          "description": "Output base directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--run_under",
          "description": "Run the target under this wrapper command",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "query",
      "description": "Query the build graph",
      "args": [
        {
          "name": "expression",
          "description": "Query expression",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format (label, label_kind, build, graph, proto, xml)",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cquery",
      "description": "Configured query",
      "args": [
        {
          "name": "expression",
          "description": "Query expression",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose_failures",
          "description": "Show full command lines for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output_base",
          "description": "Output base directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: label, build, proto or files",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "aquery",
      "description": "Action query",
      "args": [
        {
          "name": "expression",
          "description": "Query expression",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose_failures",
          "description": "Show full command lines for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output_base",
          "description": "Output base directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: text, proto or jsonproto",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Remove output files",
      "options": [
        {
          "name": "--expunge",
          "description": "Remove entire output base"
        }
      ]
    },
    {
      "name": "fetch",
      "description": "Fetch external dependencies",
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose_failures",
          "description": "Show full command lines for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output_base",
          "description": "Output base directory",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "sync",
      "description": "Sync all repos",
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose_failures",
          "description": "Show full command lines for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output_base",
          "description": "Output base directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--configure",
          "description": "Only sync configure-like repository rules",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "info",
      "description": "Show runtime info",
      "args": [
        {
          "name": "key",
          "description": "Info key",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
