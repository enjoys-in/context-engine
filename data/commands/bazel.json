    },
    {
      "name": "coverage",
      "description": "Generate code coverage",
      "options": [
        {
          "name": "--config",
          "description": "Apply this config section from .bazelrc",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--keep_going",
          "description": "Keep building after a failure",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent jobs",
          "type": "integer",
          "takesValue": true,
