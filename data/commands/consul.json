{
  "name": "consul",
  "description": "HashiCorp Consul - service mesh, service discovery, and configuration",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "agent",
      "description": "Run a Consul agent",
      "options": [
        {
          "name": "-dev",
          "description": "Development mode"
        },
        {
          "name": "-server",
          "description": "Server mode"
        },
        {
          "name": "-client",
          "description": "Client mode"
        },
        {
          "name": "-config-file",
          "description": "Config file",
          "takesValue": true
        },
        {
          "name": "-config-dir",
          "description": "Config directory",
          "takesValue": true
        },
        {
          "name": "-data-dir",
          "description": "Data directory",
          "takesValue": true
        },
        {
          "name": "-bind",
          "description": "Bind address",
          "takesValue": true
        },
        {
          "name": "-bootstrap-expect",
          "description": "Expected servers for bootstrap",
          "takesValue": true
        },
        {
          "name": "-datacenter",
          "shorthand": "-dc",
          "description": "Datacenter name",
          "takesValue": true,
          "short": "-dc"
        },
        {
          "name": "-node",
          "description": "Node name",
          "takesValue": true
        },
        {
          "name": "-join",
          "description": "Join cluster address",
          "takesValue": true
        },
        {
          "name": "-ui",
          "description": "Enable web UI"
        }
      ]
    },
    {
      "name": "members",
      "description": "List cluster members",
      "options": [
        {
          "name": "--detailed",
          "description": "Include Serf tags",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wan",
          "description": "Show WAN members",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--status",
          "description": "Filter by status regex",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "catalog",
      "description": "Catalog operations",
      "subcommands": [
        {
          "name": "services",
          "description": "List services",
          "options": [
            {
              "name": "--tags",
              "description": "Show the tags for each service",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--node",
              "description": "Only services on this node",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--datacenter",
              "description": "Datacenter to query",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "nodes",
          "description": "List nodes",
          "options": [
            {
              "name": "--detailed",
              "description": "Include node metadata",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--service",
              "description": "Only nodes running this service",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--datacenter",
              "description": "Datacenter to query",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "datacenters",
          "description": "List datacenters"
        }
      ]
    },
    {
      "name": "kv",
      "description": "KV store operations",
      "subcommands": [
        {
          "name": "put",
          "description": "Set KV pair",
          "args": [
            {
              "name": "key",
              "description": "Key",
              "required": true
            },
            {
              "name": "value",
              "description": "Value",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--cas",
              "description": "Only write if at this index",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--modify-index",
              "description": "Index to compare against",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--flags",
              "description": "Unsigned flag value",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--acquire",
              "description": "Acquire a lock with this session",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--release",
              "description": "Release the lock",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "get",
          "description": "Get KV pair",
          "args": [
            {
              "name": "key",
              "description": "Key",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--recurse",
              "description": "Fetch every key under the prefix",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--keys",
              "description": "Return keys only",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--detailed",
              "description": "Include metadata",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--raw",
              "description": "Print the raw value",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "delete",
          "description": "Delete KV pair",
          "options": [
            {
              "name": "--recurse",
              "description": "Delete every key under the prefix",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--cas",
              "description": "Only delete if at this index",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--modify-index",
              "description": "Index to compare against",
              "type": "integer",
              "takesValue": true
            }
          ]
        },
        {
          "name": "export",
          "description": "Export KV tree"
        },
        {
          "name": "import",
          "description": "Import KV tree"
        }
      ]
    },
    {
      "name": "services",
      "description": "Service management",
      "subcommands": [
        {
          "name": "register",
          "description": "Register a service",
          "options": [
            {
              "name": "--name",
              "description": "Service name",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--id",
              "description": "Service id",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--address",
              "description": "Service address",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--port",
              "description": "Service port",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--tag",
              "description": "Service tag",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--meta",
              "description": "Service metadata, key=value",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "deregister",
          "description": "Deregister a service",
          "options": [
            {
              "name": "--id",
              "description": "Service id to remove",
              "type": "string",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "connect",
      "description": "Service mesh (Connect)",
      "subcommands": [
        {
          "name": "proxy",
          "description": "Run connect proxy",
          "options": [
            {
              "name": "--sidecar-for",
              "description": "Run as a sidecar for this service",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--service",
              "description": "Service to proxy",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--upstream",
              "description": "Upstream to expose, name:port",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--listen",
              "description": "Listen address",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "envoy",
          "description": "Run Envoy proxy",
          "options": [
            {
              "name": "--sidecar-for",
              "description": "Run as a sidecar for this service",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--gateway",
              "description": "Run as a gateway (mesh, ingress, terminating)",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--admin-bind",
              "description": "Envoy admin bind address",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--bootstrap",
              "description": "Print the bootstrap configuration",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "ca",
          "description": "CA management",
          "options": [
            {
              "name": "--config-file",
              "description": "CA configuration file",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--format",
              "description": "Output format (table, json, yaml)",
              "type": "string",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "intention",
      "description": "Service intentions",
      "subcommands": [
        {
          "name": "create",
          "description": "Create intention",
          "options": [
            {
              "name": "--allow",
              "description": "Allow the traffic",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--deny",
              "description": "Deny the traffic",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--meta",
              "description": "Intention metadata, key=value",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--replace",
              "description": "Overwrite an existing intention",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "delete",
          "description": "Delete intention"
        },
        {
          "name": "list",
          "description": "List intentions"
        },
        {
          "name": "check",
          "description": "Check intention"
        },
        {
          "name": "match",
          "description": "Match intentions",
          "options": [
            {
              "name": "--source",
              "description": "Match by source",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--destination",
              "description": "Match by destination",
              "type": "boolean",
              "takesValue": false
            }
          ]
        }
      ]
    },
    {
