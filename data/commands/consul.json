              "takesValue": false
            },
            {
              "name": "--append-filename",
              "description": "Append metadata to the filename",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "restore",
          "description": "Restore snapshot"
        },
        {
          "name": "inspect",
          "description": "Inspect snapshot",
          "options": [
            {
              "name": "--kvdetails",
