{
  "name": "hugo",
  "description": "Fast static site generator written in Go",
  "category": "static-site",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create new content",
      "examples": [
        "hugo new site mysite",
        "hugo new posts/my-post.md"
      ],
      "options": [
        {
          "name": "--kind",
          "description": "Archetype to use for the new content",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--force",
          "description": "Overwrite existing files",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--editor",
          "description": "Editor to open the new file in",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "What to create: site, theme or a content path",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "server",
      "description": "Start development server",
      "examples": [
        "hugo server",
        "hugo server -D"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--bind",
          "description": "Address the server binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--buildDrafts",
          "description": "Include content marked as draft",
          "type": "boolean",
          "takesValue": false,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--disableFastRender",
          "description": "Always do a full rebuild",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--navigateToChanged",
          "description": "Navigate to the changed content",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build the site",
      "examples": [
        "hugo",
        "hugo --minify"
      ],
      "options": [
        {
          "name": "--destination",
          "description": "Directory to write the site to",
          "type": "directory",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--minify",
          "description": "Minify the generated output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--buildDrafts",
          "description": "Include content marked as draft",
          "type": "boolean",
          "takesValue": false,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--cleanDestinationDir",
          "description": "Empty the destination first",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "mod",
      "description": "Manage modules",
      "examples": [
        "hugo mod init",
        "hugo mod tidy"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Module operation, such as init, get, tidy, vendor or graph",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy site to cloud provider",
      "examples": [
        "hugo deploy"
      ],
      "options": [
        {
          "name": "--target",
          "description": "Deployment target to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dryRun",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--confirm",
          "description": "Prompt before making changes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Print version",
      "examples": [
        "hugo version"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "-D",
      "description": "Include draft content"
    },
    {
      "name": "--minify",
      "description": "Minify output"
    },
    {
      "name": "-d",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--baseURL",
      "description": "Base URL",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Theme to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--gc",
      "description": "Enable garbage collection after build"
    }
  ],
  "examples": [
    "hugo new site mysite",
    "hugo server -D",
    "hugo --minify",
    "hugo new posts/hello.md",
    "hugo server --bind 0.0.0.0"
  ],
  "relatedCommands": [
    "jekyll",
    "gatsby",
    "eleventy",
    "astro"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Hugo version",
        "command": "hugo version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hugo"
      },
      {
        "name": "config",
        "description": "Hugo site configuration",
        "command": "cat hugo.toml 2>/dev/null || cat config.toml 2>/dev/null || cat config.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "theme",
        "description": "Hugo themes installed",
        "command": "ls themes 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "content",
        "description": "Content sections in this site",
        "command": "ls content 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "modules",
        "description": "Hugo modules this site depends on",
        "command": "hugo mod graph 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "hugo"
      }
    ]
  }
}
