{
  "name": "gh",
  "description": "GitHub CLI - work with GitHub from the command line",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "auth login",
      "description": "Authenticate with GitHub",
      "examples": [
        "gh auth login",
        "gh auth login --with-token < token.txt"
      ],
      "options": [
        {
          "name": "--hostname",
          "description": "GitHub host",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--with-token",
          "description": "Read the token from stdin",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--scopes",
          "description": "Scopes to request",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--web",
          "description": "Authenticate in a browser",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--git-protocol",
          "description": "Git protocol to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "auth status",
      "description": "Check auth status",
      "examples": [
        "gh auth status"
      ],
      "options": [
        {
          "name": "--hostname",
          "description": "Host to check",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--show-token",
          "description": "Print the stored token",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "repo create",
      "description": "Create a new repository",
      "args": [
        {
          "name": "<name>",
          "type": "string",
          "required": true,
          "description": "Repo name"
        }
      ],
      "options": [
        {
          "name": "--public",
          "description": "Public repo"
        },
        {
          "name": "--private",
          "description": "Private repo"
        },
        {
          "name": "--clone",
          "description": "Clone after creating"
        }
      ],
      "examples": [
        "gh repo create myrepo --public",
        "gh repo create myrepo --private --clone"
      ]
    },
    {
      "name": "repo clone",
      "description": "Clone a repository",
      "args": [
        {
          "name": "<repo>",
          "type": "string",
          "required": true,
          "description": "Repository (owner/repo)"
        }
      ],
      "examples": [
        "gh repo clone owner/repo"
      ],
      "options": [
        {
          "name": "--upstream-remote-name",
          "description": "Name for the upstream remote",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--depth",
          "description": "Create a shallow clone",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "repo fork",
      "description": "Fork a repository",
      "args": [
        {
          "name": "<repo>",
          "type": "string",
          "required": false,
          "description": "Repository"
        }
      ],
      "examples": [
        "gh repo fork",
        "gh repo fork owner/repo --clone"
      ],
      "options": [
        {
          "name": "--clone",
          "description": "Clone the fork locally",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--remote",
          "description": "Add a git remote",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--org",
          "description": "Fork into this organisation",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--fork-name",
          "description": "Name for the fork",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "pr create",
      "description": "Create a pull request",
      "options": [
        {
          "name": "--title",
          "short": "-t",
          "description": "PR title",
          "type": "string",
          "takesValue": true,
          "shorthand": "-t"
        },
        {
          "name": "--body",
          "short": "-b",
          "description": "PR body",
          "type": "string",
          "takesValue": true,
          "shorthand": "-b"
        },
        {
          "name": "--base",
          "short": "-B",
          "description": "Base branch",
          "type": "string",
          "takesValue": true,
          "shorthand": "-B"
        },
        {
          "name": "--draft",
          "short": "-d",
          "description": "Create as draft",
          "shorthand": "-d"
        },
        {
          "name": "--fill",
          "short": "-f",
          "description": "Use commit info for title/body",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "gh pr create --title 'feat: add login' --body 'Description'",
        "gh pr create --fill",
        "gh pr create --draft"
      ]
    },
    {
      "name": "pr list",
      "description": "List pull requests",
      "options": [
        {
          "name": "--state",
          "short": "-s",
          "description": "Filter by state (open, closed, merged, all)",
          "type": "string",
          "takesValue": true,
          "shorthand": "-s"
        },
        {
          "name": "--author",
          "description": "Filter by author",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "gh pr list",
        "gh pr list --state closed"
      ]
    },
    {
      "name": "pr merge",
      "description": "Merge a pull request",
      "args": [
        {
          "name": "<number>",
          "type": "number",
          "required": false,
          "description": "PR number"
        }
      ],
      "options": [
        {
          "name": "--squash",
          "short": "-s",
          "description": "Squash merge",
          "shorthand": "-s"
        },
        {
          "name": "--rebase",
          "short": "-r",
          "description": "Rebase merge",
          "shorthand": "-r"
        },
        {
          "name": "--delete-branch",
          "short": "-d",
          "description": "Delete branch after merge",
          "shorthand": "-d"
        }
      ],
      "examples": [
        "gh pr merge 42 --squash --delete-branch",
        "gh pr merge --rebase"
      ]
    },
    {
      "name": "pr checkout",
      "description": "Check out a pull request locally",
      "args": [
        {
          "name": "<number>",
          "type": "number",
          "required": true,
          "description": "PR number"
        }
      ],
      "examples": [
        "gh pr checkout 42"
      ],
      "options": [
        {
          "name": "--branch",
          "description": "Local branch name",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--detach",
          "description": "Check out in detached HEAD",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Reset the branch to match",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--recurse-submodules",
          "description": "Update submodules too",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "pr view",
      "description": "View a pull request",
      "args": [
        {
          "name": "<number>",
          "type": "number",
          "required": false,
          "description": "PR number"
        }
      ],
      "options": [
        {
          "name": "--web",
          "short": "-w",
          "description": "Open in browser",
          "shorthand": "-w"
        }
      ],
      "examples": [
        "gh pr view 42",
        "gh pr view --web"
      ]
    },
    {
      "name": "issue create",
      "description": "Create an issue",
      "options": [
        {
          "name": "--title",
          "short": "-t",
          "description": "Issue title",
          "type": "string",
          "takesValue": true,
          "shorthand": "-t"
        },
        {
          "name": "--body",
          "short": "-b",
          "description": "Issue body",
          "type": "string",
          "takesValue": true,
          "shorthand": "-b"
        },
        {
          "name": "--label",
          "short": "-l",
          "description": "Labels",
          "type": "string",
          "takesValue": true,
          "shorthand": "-l"
        }
      ],
      "examples": [
        "gh issue create --title 'Bug: crash on startup' --body 'Steps to reproduce...'"
      ]
    },
    {
      "name": "issue list",
      "description": "List issues",
      "options": [
        {
          "name": "--state",
          "short": "-s",
          "description": "Filter by state",
          "type": "string",
          "takesValue": true,
          "shorthand": "-s"
        },
        {
          "name": "--label",
          "short": "-l",
          "description": "Filter by label",
          "type": "string",
          "takesValue": true,
          "shorthand": "-l"
        }
      ],
      "examples": [
        "gh issue list",
        "gh issue list --label bug"
      ]
    },
    {
      "name": "release create",
      "description": "Create a release",
      "args": [
        {
          "name": "<tag>",
          "type": "tag",
          "required": true,
          "description": "Tag name",
          "completion": {
            "detector": "branch"
          }
        }
      ],
      "options": [
        {
          "name": "--title",
          "short": "-t",
          "description": "Release title",
          "type": "string",
          "takesValue": true,
          "shorthand": "-t"
        },
        {
          "name": "--notes",
          "short": "-n",
          "description": "Release notes",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--draft",
          "short": "-d",
          "description": "Create as draft",
          "shorthand": "-d"
        },
        {
          "name": "--prerelease",
          "short": "-p",
          "description": "Mark as pre-release",
          "shorthand": "-p"
        },
        {
          "name": "--generate-notes",
          "description": "Auto-generate release notes"
        }
      ],
      "examples": [
        "gh release create v1.0.0 --title 'Release 1.0' --generate-notes"
      ]
    },
    {
      "name": "release list",
      "description": "List releases",
      "examples": [
        "gh release list"
      ],
      "options": [
        {
          "name": "--limit",
          "description": "Maximum releases",
          "type": "integer",
          "takesValue": true,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--exclude-drafts",
          "description": "Skip drafts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclude-pre-releases",
          "description": "Skip pre-releases",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "workflow run",
      "description": "Run a GitHub Actions workflow",
      "args": [
        {
          "name": "<workflow>",
          "type": "job",
          "required": true,
          "description": "Workflow file or name"
        }
      ],
      "examples": [
        "gh workflow run deploy.yml",
        "gh workflow run deploy.yml -f environment=production"
      ],
      "options": [
        {
          "name": "--ref",
          "description": "Branch or tag to run on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--field",
          "description": "Input field, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--json",
          "description": "Read inputs as JSON from stdin",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw-field",
          "description": "Raw input field",
          "type": "string",
          "takesValue": true,
          "short": "-F",
          "shorthand": "-F"
        }
      ]
    },
    {
      "name": "workflow list",
      "description": "List workflows",
      "examples": [
        "gh workflow list"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include disabled workflows",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--limit",
          "description": "Maximum workflows",
          "type": "integer",
          "takesValue": true,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "run list",
      "description": "List workflow runs",
      "examples": [
        "gh run list"
      ],
      "options": [
        {
          "name": "--workflow",
          "description": "Only this workflow",
          "type": "string",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--branch",
          "description": "Only this branch",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--status",
          "description": "Only this status",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--limit",
          "description": "Maximum runs",
          "type": "integer",
          "takesValue": true,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "run view",
      "description": "View a workflow run",
      "args": [
        {
          "name": "<run-id>",
          "type": "number",
          "required": true,
          "description": "Run ID"
        }
      ],
      "options": [
        {
          "name": "--log",
          "description": "Show run log"
        }
      ],
      "examples": [
        "gh run view 12345",
        "gh run view 12345 --log"
      ]
    },
    {
      "name": "gist create",
      "description": "Create a gist",
      "args": [
        {
          "name": "<files>",
          "type": "file",
          "required": true,
          "description": "Files to include"
        }
      ],
      "options": [
        {
          "name": "--public",
          "short": "-p",
          "description": "Create public gist",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "gh gist create file.txt",
        "gh gist create -p script.sh"
      ]
    },
    {
      "name": "api",
      "description": "Make authenticated GitHub API requests",
      "args": [
        {
          "name": "<endpoint>",
          "type": "string",
          "required": true,
          "description": "API endpoint"
        }
      ],
      "options": [
        {
          "name": "--method",
          "short": "-X",
          "description": "HTTP method",
          "type": "string",
          "takesValue": true,
          "shorthand": "-X"
        },
        {
          "name": "--field",
          "short": "-f",
          "description": "Key-value pairs",
          "type": "string",
          "takesValue": true,
          "shorthand": "-f"
        }
      ],
      "examples": [
        "gh api repos/owner/repo",
        "gh api -X POST repos/owner/repo/issues -f title='Bug'"
      ]
    },
    {
      "name": "codespace create",
      "description": "Create a GitHub Codespace",
      "examples": [
        "gh codespace create"
      ],
      "options": [
        {
          "name": "--repo",
          "description": "Repository to create for",
          "type": "string",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--branch",
          "description": "Branch to open",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--machine",
          "description": "Machine type",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--devcontainer-path",
          "description": "Dev container configuration",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "codespace list",
      "description": "List codespaces",
      "examples": [
        "gh codespace list"
      ],
      "options": [
        {
          "name": "--limit",
          "description": "Maximum codespaces",
          "type": "integer",
          "takesValue": true,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--repo",
          "description": "Only this repository",
          "type": "string",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "copilot suggest",
      "description": "Get command suggestion from Copilot",
      "examples": [
        "gh copilot suggest 'list all running docker containers'"
      ],
      "options": [
        {
          "name": "--target",
          "description": "What to suggest for (shell, gh, git)",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "args": [
        {
          "name": "prompt",
          "description": "What you want a command for",
          "required": false,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    },
    {
      "name": "--repo",
      "short": "-R",
      "description": "Target repository (owner/repo)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-R"
    }
  ],
  "examples": [
    "gh auth login",
    "gh pr create --fill",
    "gh release create v1.0.0 --generate-notes",
    "gh workflow run deploy.yml"
  ],
  "relatedCommands": [
    "git",
    "hub"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GitHub CLI version",
        "command": "gh --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gh"
      },
      {
        "name": "auth",
        "description": "Authenticated GitHub accounts",
        "command": "gh auth status 2>&1 | head -15",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "gh"
      },
      {
        "name": "repo",
        "description": "Repository gh commands resolve to",
        "command": "gh repo view --json nameWithOwner,defaultBranchRef 2>/dev/null",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "gh"
      },
      {
        "name": "branch",
        "description": "Active git branch",
        "command": "git rev-parse --abbrev-ref HEAD 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "git"
      },
      {
        "name": "extensions",
        "description": "gh extensions installed",
        "command": "gh extension list 2>/dev/null",
        "parser": "table",
        "cacheFor": 3600,
        "requiresCmd": "gh"
      }
    ]
  }
}
