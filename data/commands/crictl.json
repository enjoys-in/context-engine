{
  "name": "crictl",
  "description": "CLI for CRI-compatible container runtimes",
  "category": "container",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "ps",
      "description": "List containers",
      "options": [
        {
          "name": "--all",
          "description": "Include stopped containers",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--output",
          "description": "Output format (table, json, yaml)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "pods",
      "description": "List pod sandboxes",
      "options": [
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "images",
      "description": "List images",
      "options": [
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "pull",
      "description": "Pull an image",
      "options": [
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "rmi",
      "description": "Remove images",
      "options": [
        {
          "name": "--all",
          "description": "Remove every image",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--prune",
          "description": "Remove unused images",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "logs",
      "description": "Fetch container logs",
      "options": [
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tail",
          "description": "Lines to show from the end",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "exec",
      "description": "Run a command in a container",
      "options": [
        {
          "name": "--interactive",
          "description": "Keep stdin open",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--tty",
          "description": "Allocate a pseudo-TTY",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Show container details",
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "inspectp",
      "description": "Show pod sandbox details",
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "stats",
      "description": "Show container resource usage"
    },
    {
      "name": "stop",
      "description": "Stop containers",
      "options": [
        {
          "name": "--timeout",
          "description": "Seconds to wait before killing",
          "type": "integer",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove containers",
      "options": [
        {
          "name": "--force",
          "description": "Remove a running container",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "info",
      "description": "Show runtime information"
    },
    {
      "name": "version",
      "description": "Show the runtime version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--runtime-endpoint",
      "description": "CRI runtime socket",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--image-endpoint",
      "description": "CRI image service socket",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--timeout",
      "description": "Request timeout",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    }
  ],
  "examples": [
    {
      "command": "crictl ps -a",
      "description": "List every container"
    },
    {
      "command": "crictl pods",
      "description": "List pod sandboxes"
    },
    {
      "command": "crictl logs -f abc123",
      "description": "Stream container logs"
    },
    {
      "command": "crictl exec -it abc123 sh",
      "description": "Open a shell in a container"
    },
    {
      "command": "crictl rmi --prune",
      "description": "Remove unused images"
    }
  ],
  "relatedCommands": [
    "kubectl",
    "nerdctl",
    "ctr",
    "docker",
    "k9s"
  ]
}
