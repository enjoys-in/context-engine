{
  "name": "crictl",
  "description": "CLI for CRI-compatible container runtimes",
  "category": "container",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "ps",
      "description": "List containers",
      "options": [
        {
          "name": "--all",
          "description": "Include stopped containers",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--output",
          "description": "Output format (table, json, yaml)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "pods",
      "description": "List pod sandboxes",
      "options": [
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "images",
      "description": "List images",
      "options": [
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "pull",
      "description": "Pull an image",
      "options": [
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "rmi",
      "description": "Remove images",
      "options": [
        {
          "name": "--all",
          "description": "Remove every image",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--prune",
          "description": "Remove unused images",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "logs",
      "description": "Fetch container logs",
      "options": [
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tail",
          "description": "Lines to show from the end",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container id to read logs from",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "exec",
      "description": "Run a command in a container",
      "options": [
        {
          "name": "--interactive",
          "description": "Keep stdin open",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--tty",
          "description": "Allocate a pseudo-TTY",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container id to exec into",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Show container details",
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container id to inspect",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "inspectp",
      "description": "Show pod sandbox details",
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "stats",
      "description": "Show container resource usage",
      "options": [
        {
          "name": "--output",
          "description": "Output format: json, yaml or table",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--seconds",
          "description": "Sample interval in seconds",
          "type": "integer",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop containers",
      "options": [
        {
          "name": "--timeout",
          "description": "Seconds to wait before killing",
          "type": "integer",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container id to stop",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove containers",
      "options": [
        {
          "name": "--force",
          "description": "Remove a running container",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container id to remove",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "info",
      "description": "Show runtime information",
      "options": [
        {
          "name": "--output",
          "description": "Output format: json, yaml or go-template",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "version",
      "description": "Show the runtime version",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--runtime-endpoint",
      "description": "CRI runtime socket",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--image-endpoint",
      "description": "CRI image service socket",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--timeout",
      "description": "Request timeout",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    }
  ],
  "examples": [
    {
      "command": "crictl ps -a",
      "description": "List every container"
    },
    {
      "command": "crictl pods",
      "description": "List pod sandboxes"
    },
    {
      "command": "crictl logs -f abc123",
      "description": "Stream container logs"
    },
    {
      "command": "crictl exec -it abc123 sh",
      "description": "Open a shell in a container"
    },
    {
      "command": "crictl rmi --prune",
      "description": "Remove unused images"
    }
  ],
  "relatedCommands": [
    "kubectl",
    "nerdctl",
    "ctr",
    "docker",
    "k9s"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "crictl and runtime versions",
        "command": "crictl version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "crictl"
      },
      {
        "name": "info",
        "description": "Container runtime configuration",
        "command": "crictl info 2>/dev/null | head -c 2000",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "crictl"
      },
      {
        "name": "pods",
        "description": "Pod sandboxes on this node",
        "command": "crictl pods 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "crictl"
      },
      {
        "name": "containers",
        "description": "Containers on this node",
        "command": "crictl ps -a 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "crictl"
      },
      {
        "name": "images",
        "description": "Images in the node image store",
        "command": "crictl images -o json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "crictl"
      },
      {
        "name": "config",
        "description": "crictl endpoint configuration",
        "command": "cat /etc/crictl.yaml 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600
      }
    ]
  }
}
