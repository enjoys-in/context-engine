{
  "name": "ranlib",
  "description": "Generate the symbol index for a static archive",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-v",
      "description": "Report progress",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-t",
      "description": "Update the archive timestamp only",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-D",
      "description": "Use zero for timestamps and uids, for reproducible output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ranlib libmine.a",
      "description": "Regenerate the archive index"
    },
    {
      "command": "ranlib -D libmine.a",
      "description": "Produce a reproducible index"
    }
  ],
  "relatedCommands": [
    "ar",
    "nm",
    "ld"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GNU ranlib version",
        "command": "ranlib --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ranlib"
      },
      {
        "name": "archives",
        "description": "Static libraries whose index ranlib maintains",
        "command": "find . -maxdepth 3 -name '*.a' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
