{
  "name": "jupyter",
  "description": "Interactive notebooks and the JupyterLab environment",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "notebook",
      "description": "Start the classic notebook server",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--no-browser",
          "description": "Do not open a browser",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ip",
          "description": "Address to bind to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--NotebookApp.token",
          "description": "Token required to connect",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "lab",
      "description": "Start JupyterLab",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--no-browser",
          "description": "Do not open a browser",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ip",
          "description": "Address to bind to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "console",
      "description": "Start a terminal console against a kernel",
      "options": [
        {
          "name": "--kernel",
          "description": "Kernel to connect to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "nbconvert",
      "description": "Convert notebooks to another format",
      "options": [
        {
          "name": "--to",
          "description": "Target format (html, pdf, script, markdown)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output file name",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--execute",
          "description": "Run the notebook before converting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--inplace",
          "description": "Overwrite the input notebook",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "notebook",
          "description": "Notebook to convert",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "kernelspec",
      "description": "Manage installed kernels"
    },
    {
      "name": "kernel",
      "description": "Start a kernel directly",
      "options": [
        {
          "name": "--kernel",
          "description": "Kernel name",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "server",
      "description": "Manage Jupyter server instances"
    },
    {
      "name": "troubleshoot",
      "description": "Print environment detail for bug reports"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config-dir",
      "description": "Show the configuration directory",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--data-dir",
      "description": "Show the data directory",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--paths",
      "description": "Show all Jupyter paths",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "jupyter lab",
      "description": "Start JupyterLab"
    },
    {
      "command": "jupyter notebook --port 9999",
      "description": "Start the notebook server on a specific port"
    },
    {
      "command": "jupyter nbconvert --to html analysis.ipynb",
      "description": "Export a notebook to HTML"
    },
    {
      "command": "jupyter nbconvert --to script --execute run.ipynb",
      "description": "Execute then export to a script"
    }
  ],
  "relatedCommands": [
    "python",
    "pip",
    "ipython",
    "papermill"
  ]
}
