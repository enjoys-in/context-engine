{
  "name": "tldr",
  "description": "Simplified, community-maintained command examples",
  "category": "environment",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--update",
      "description": "Refresh the local page cache",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--list",
      "description": "List every available page",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--platform",
      "description": "Platform pages to use (linux, osx, windows, common)",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--language",
      "description": "Page language",
      "type": "string",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--search",
      "description": "Search page contents for this text",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--render",
      "description": "Render a local page file",
      "type": "file",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--clear-cache",
      "description": "Delete the cached pages",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--color",
      "description": "Force coloured output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress status messages",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "tldr tar",
      "description": "Show examples for tar"
    },
    {
      "command": "tldr -u",
      "description": "Update the cached pages"
    },
    {
      "command": "tldr -s \"compress a directory\"",
      "description": "Search across pages"
    },
    {
      "command": "tldr -p osx brew",
      "description": "Show the macOS page for a command"
    }
  ],
  "relatedCommands": [
    "man",
    "cheat",
    "navi",
    "help"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tldr client version",
        "command": "tldr --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tldr"
      },
      {
        "name": "cache",
        "description": "tldr page cache location and age",
        "command": "ls -ld ~/.cache/tldr 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "platform",
        "description": "Platform tldr will show pages for",
        "command": "uname -s 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
