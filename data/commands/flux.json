{
  "name": "flux",
  "description": "Flux CD — GitOps toolkit for Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "bootstrap",
      "description": "Bootstrap Flux on cluster",
      "examples": [
        "flux bootstrap github --owner=myorg --repository=fleet-infra --branch=main --path=clusters/my-cluster --personal",
        "flux bootstrap gitlab --owner=myorg --repository=fleet-infra --branch=main --path=clusters/my-cluster"
      ],
      "options": [
        {
          "name": "--owner",
          "description": "Git provider owner or organisation",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--repository",
          "description": "Repository name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--branch",
          "description": "Branch to write to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Path inside the repository",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--personal",
          "description": "Treat the owner as a user rather than an organisation",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--private",
          "description": "Create the repository as private",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--token-auth",
          "description": "Authenticate with a token rather than SSH",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--read-write-key",
          "description": "Create a deploy key with write access",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "provider",
          "description": "Git provider, such as github, gitlab or git",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install Flux components",
      "examples": [
        "flux install"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to install into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--components",
          "description": "Toolkit components to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--components-extra",
          "description": "Optional components to also install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Toolkit version to install",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--export",
          "description": "Print the manifests instead of applying them",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would happen without applying it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--registry",
          "description": "Container registry to pull from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--watch-all-namespaces",
          "description": "Reconcile resources in every namespace",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall Flux",
      "examples": [
        "flux uninstall"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to uninstall from",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--keep-namespace",
          "description": "Leave the namespace in place",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would happen without applying it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--silent",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "check",
      "description": "Check prerequisites",
      "examples": [
        "flux check",
        "flux check --pre"
      ],
      "options": [
        {
          "name": "--pre",
          "description": "Check prerequisites only, before installing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--components",
          "description": "Components expected to be present",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace holding the installation",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "create source git",
      "description": "Create a Git source",
      "examples": [
        "flux create source git my-repo --url=https://github.com/org/repo --branch=main --interval=1m"
      ],
      "options": [
        {
          "name": "--url",
          "description": "Repository URL to sync from",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--branch",
          "description": "Branch to track",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tag",
          "description": "Tag to track",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--interval",
          "description": "How often to poll the source",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--secret-ref",
          "description": "Secret holding the credentials",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--export",
          "description": "Print the manifest rather than applying it",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Name for the GitRepository source",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "create source helm",
      "description": "Create a Helm source",
      "examples": [
        "flux create source helm bitnami --url=https://charts.bitnami.com/bitnami --interval=1h"
      ],
      "options": [
        {
          "name": "--url",
          "description": "Helm repository URL",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--interval",
          "description": "How often to poll the repository",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--secret-ref",
          "description": "Secret holding the credentials",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--export",
          "description": "Print the manifest rather than applying it",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Name for the HelmRepository source",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "create kustomization",
      "description": "Create a Kustomization",
      "examples": [
        "flux create kustomization my-app --source=my-repo --path=./deploy --prune=true --interval=5m"
      ],
      "options": [
        {
          "name": "--source",
          "description": "Source to build from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Path within the source to build",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--prune",
          "description": "Garbage-collect removed resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--interval",
          "description": "How often to reconcile",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--export",
          "description": "Print the manifest rather than applying it",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Name for the Kustomization",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "create helmrelease",
      "description": "Create a HelmRelease",
      "examples": [
        "flux create hr my-app --source=HelmRepository/bitnami --chart=nginx --interval=1h"
      ],
      "options": [
        {
          "name": "--source",
          "description": "Chart source to install from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--chart",
          "description": "Chart name to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--chart-version",
          "description": "Chart version to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--values",
          "description": "Values file to apply",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--export",
          "description": "Print the manifest rather than applying it",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "get",
      "description": "Get Flux resources",
      "examples": [
        "flux get all",
        "flux get sources git",
        "flux get kustomizations",
        "flux get helmreleases",
        "flux get sources helm"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to query",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all-namespaces",
          "description": "Operate across every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--status-selector",
          "description": "Filter by reconciliation status",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--watch",
          "description": "Stream updates as they happen",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to list",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "reconcile",
      "description": "Trigger reconciliation",
      "examples": [
        "flux reconcile source git my-repo",
        "flux reconcile kustomization my-app",
        "flux reconcile hr my-app"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace of the resource",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--with-source",
          "description": "Also reconcile the source first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timeout",
          "description": "How long to wait before giving up, e.g. 5m",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to reconcile, such as source git",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "suspend",
      "description": "Suspend reconciliation",
      "examples": [
        "flux suspend kustomization my-app",
        "flux suspend hr my-app"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace of the resource",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Suspend every resource of this kind",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to suspend",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "resume",
      "description": "Resume reconciliation",
      "examples": [
        "flux resume kustomization my-app",
        "flux resume hr my-app"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace of the resource",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Resume every resource of this kind",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wait",
          "description": "Block until reconciliation finishes",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to resume",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete Flux resources",
      "examples": [
        "flux delete source git my-repo",
        "flux delete kustomization my-app"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace of the resource",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--silent",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to delete",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name to delete",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "logs",
      "description": "View Flux controller logs",
      "examples": [
        "flux logs",
        "flux logs --follow",
        "flux logs --kind=Kustomization --name=my-app"
      ],
      "options": [
        {
          "name": "--follow",
          "description": "Stream new log lines",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tail",
          "description": "Lines to show from the end",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--level",
          "description": "Minimum log level to show",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kind",
          "description": "Only logs for this kind",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--all-namespaces",
          "description": "Operate across every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        }
      ]
    },
    {
      "name": "tree",
      "description": "Show resource tree",
      "examples": [
        "flux tree kustomization my-app"
      ],
      "options": [
        {
          "name": "--compact",
          "description": "Hide resources that are not managed",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output",
          "description": "Output format: yaml or json",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to walk",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "export",
      "description": "Export resources as YAML",
      "examples": [
        "flux export source git my-repo",
        "flux export kustomization my-app > my-app.yaml"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace of the resource",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Export every resource of this kind",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--with-credentials",
          "description": "Include the referenced secrets",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to export",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "diff",
      "description": "Diff local vs cluster",
      "examples": [
        "flux diff kustomization my-app --path=./deploy"
      ],
      "options": [
        {
          "name": "--path",
          "description": "Path to the kustomization",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--progress-bar",
          "description": "Show a progress bar",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to diff",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace (default: flux-system)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--timeout",
      "description": "Timeout duration",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "flux bootstrap github --owner=myorg --repository=fleet-infra --branch=main --path=clusters/my-cluster --personal",
    "flux check",
    "flux get all",
    "flux create source git my-repo --url=https://github.com/org/repo --branch=main",
    "flux reconcile kustomization my-app",
    "flux logs --follow",
    "flux tree kustomization my-app"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "argocd",
    "kustomize",
    "git"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Flux CLI version",
        "command": "flux version --client 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "flux"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "sources",
        "description": "Flux sources being reconciled",
        "command": "flux get sources all 2>/dev/null",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "flux"
      },
      {
        "name": "kustomizations",
        "description": "Flux kustomizations",
        "command": "flux get kustomizations 2>/dev/null",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "flux"
      }
    ]
  }
}
