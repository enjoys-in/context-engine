{
  "name": "telegraf",
  "description": "Plugin-driven agent for collecting and reporting metrics",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--config-directory",
      "description": "Directory of configuration files",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--test",
      "description": "Gather once and print to stdout",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--test-wait",
      "description": "Seconds to wait for service inputs during a test",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--input-filter",
      "description": "Only enable these inputs",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output-filter",
      "description": "Only enable these outputs",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sample-config",
      "description": "Print a full sample configuration",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--once",
      "description": "Gather and write one batch, then exit",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Log errors only",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--watch-config",
      "description": "Reload on configuration change",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "telegraf --config telegraf.conf",
      "description": "Run the agent"
    },
    {
      "command": "telegraf --test --input-filter cpu",
      "description": "Gather one CPU sample and print it"
    },
    {
      "command": "telegraf --sample-config > telegraf.conf",
      "description": "Write a starter configuration"
    },
    {
      "command": "telegraf --once",
      "description": "Collect and write a single batch"
    }
  ],
  "relatedCommands": [
    "prometheus",
    "vector",
    "fluent-bit",
    "influx"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Telegraf version",
        "command": "telegraf --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "telegraf"
      },
      {
        "name": "config",
        "description": "Telegraf configuration",
        "command": "cat /etc/telegraf/telegraf.conf 2>/dev/null | grep -v '^ *#' | grep . | head -40",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "plugins",
        "description": "Telegraf input plugins enabled",
        "command": "grep -o '^\\[\\[inputs\\.[a-z_]*\\]\\]' /etc/telegraf/telegraf.conf 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "service",
        "description": "Telegraf service state",
        "command": "systemctl is-active telegraf 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
