{
  "name": "bzip2",
  "description": "Compress or expand files with the Burrows-Wheeler algorithm (.bz2)",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--decompress",
      "description": "Expand instead of compress",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--best",
      "description": "Use the largest block size",
      "type": "boolean",
      "takesValue": false,
      "short": "-9",
      "shorthand": "-9"
    },
    {
      "name": "--fast",
      "description": "Use the smallest block size",
      "type": "boolean",
      "takesValue": false,
      "short": "-1",
      "shorthand": "-1"
    },
    {
      "name": "--verbose",
      "description": "Report each file",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "bzip2 -k dump.sql",
      "description": "Compress and keep the original"
    },
    {
      "command": "bzip2 -d dump.sql.bz2",
      "description": "Expand an archive"
    },
    {
      "command": "bzip2 -t dump.sql.bz2",
      "description": "Verify integrity"
    }
  ],
  "relatedCommands": [
    "bunzip2",
    "gzip",
    "xz",
    "tar"
  ]
}
