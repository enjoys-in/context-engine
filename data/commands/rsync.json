{
  "name": "rsync",
  "description": "Fast, versatile remote (and local) file-copying tool",
  "category": "networking",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-a",
      "description": "Archive mode (preserves permissions, symlinks, etc.)"
    },
    {
      "name": "-v",
      "description": "Verbose"
    },
    {
      "name": "-z",
      "description": "Compress during transfer"
    },
    {
      "name": "-P",
      "description": "Show progress and keep partial transfers"
    },
    {
      "name": "--progress",
      "description": "Show transfer progress"
    },
    {
      "name": "-r",
      "description": "Recursive"
    },
    {
      "name": "--delete",
      "description": "Delete files in dest not in source"
    },
    {
      "name": "-e",
      "description": "Specify remote shell (e.g., ssh)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Exclude pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--include",
      "description": "Include pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-n",
      "description": "Dry run"
    },
    {
      "name": "--dry-run",
      "description": "Dry run"
    },
    {
      "name": "-h",
      "description": "Human-readable sizes"
    },
    {
      "name": "--bwlimit",
      "description": "Bandwidth limit (KBps)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--partial",
      "description": "Keep partially transferred files"
    },
    {
      "name": "-u",
      "description": "Skip files newer on receiver"
    },
    {
      "name": "--checksum",
      "short": "-c",
      "description": "Use checksum instead of mod-time",
      "shorthand": "-c"
    },
    {
      "name": "--archive",
      "description": "Recurse and preserve almost everything",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--compress",
      "description": "Compress data in transit",
      "type": "boolean",
      "takesValue": false,
      "short": "-z",
      "shorthand": "-z"
    },
    {
      "name": "--info",
      "description": "Fine-grained output control, e.g. progress2",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--delete-excluded",
      "description": "Also delete excluded files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--delete-after",
      "description": "Delete after transferring rather than before",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--max-delete",
      "description": "Abort above this many deletions",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--exclude-from",
      "description": "Read exclude patterns from this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--filter",
      "description": "Add a filter rule",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--itemize-changes",
      "description": "Print a change summary per file",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--update",
      "description": "Skip files newer at the destination",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--inplace",
      "description": "Write updates in place",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--append",
      "description": "Append to files that are shorter at the destination",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--rsh",
      "description": "Remote shell command to use",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--rsync-path",
      "description": "Path to rsync on the remote host",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--numeric-ids",
      "description": "Do not map user and group names",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--hard-links",
      "description": "Preserve hard links",
      "type": "boolean",
      "takesValue": false,
      "short": "-H",
      "shorthand": "-H"
    },
    {
      "name": "--acls",
      "description": "Preserve ACLs",
      "type": "boolean",
      "takesValue": false,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--xattrs",
      "description": "Preserve extended attributes",
      "type": "boolean",
      "takesValue": false,
      "short": "-X",
      "shorthand": "-X"
    },
    {
      "name": "--sparse",
      "description": "Handle sparse files efficiently",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--relative",
      "description": "Use relative path names",
      "type": "boolean",
      "takesValue": false,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--prune-empty-dirs",
      "description": "Omit empty directories",
      "type": "boolean",
      "takesValue": false,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--link-dest",
      "description": "Hard-link unchanged files from this directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--backup",
      "description": "Make backups of replaced files",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--backup-dir",
      "description": "Put backups in this directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--stats",
      "description": "Print a transfer summary",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--human-readable",
      "description": "Print sizes in human units",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--remove-source-files",
      "description": "Delete source files after a successful transfer",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--files-from",
      "description": "Read the file list from here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--timeout",
      "description": "I/O timeout in seconds",
      "type": "integer",
      "takesValue": true
    }
  ],
  "examples": [
    "rsync -avz src/ dest/",
    "rsync -avzP src/ user@host:/path/dest/",
    "rsync -avz --delete src/ dest/",
    "rsync -avz --exclude='node_modules' --exclude='.git' . user@host:/app/",
    "rsync -avz -e 'ssh -p 2222' src/ user@host:/dest/",
    "rsync -avzn src/ dest/"
  ],
  "relatedCommands": [
    "scp",
    "sftp",
    "cp",
    "rclone"
  ]
}
