{
  "language": "hcl",
  "name": "terraform",
  "description": "HCL command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    },
    {
      "name": "--env",
      "description": "Set environment (development, staging, production)",
      "valueHint": "name"
    },
    {
      "name": "--timeout",
      "description": "Set operation timeout in seconds",
      "valueHint": "seconds"
    }
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize config",
      "args": [],
      "options": [
        {
          "name": "-var",
          "description": "Set an input variable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-var-file",
          "description": "Read variables from this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-input",
          "description": "Prompt for missing input",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-no-color",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-lock",
          "description": "Hold a state lock during the operation",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-upgrade",
          "description": "Upgrade the provider and module versions",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-backend-config",
          "description": "Backend configuration to merge in",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-reconfigure",
          "description": "Reconfigure the backend from scratch",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terraform init"
      ]
    },
    {
      "name": "plan",
      "description": "Create execution plan",
      "args": [],
      "options": [
        {
          "name": "-var",
          "description": "Set an input variable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-var-file",
          "description": "Read variables from this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-input",
          "description": "Prompt for missing input",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-no-color",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-lock",
          "description": "Hold a state lock during the operation",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-out",
          "description": "Write the plan to this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-target",
          "description": "Only plan this resource address",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-refresh",
          "description": "Refresh state before planning",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-destroy",
          "description": "Plan a destroy run",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terraform plan"
      ]
    },
    {
      "name": "apply",
      "description": "Apply changes",
      "args": [],
      "options": [
        {
          "name": "-var",
          "description": "Set an input variable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-var-file",
          "description": "Read variables from this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-input",
          "description": "Prompt for missing input",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-no-color",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-lock",
          "description": "Hold a state lock during the operation",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-auto-approve",
          "description": "Apply without prompting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-target",
          "description": "Only apply this resource address",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-parallelism",
          "description": "Number of concurrent operations",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "terraform apply"
      ]
    },
    {
      "name": "destroy",
      "description": "Destroy infrastructure",
      "args": [],
      "options": [
        {
          "name": "-var",
          "description": "Set an input variable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-var-file",
          "description": "Read variables from this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-input",
          "description": "Prompt for missing input",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-no-color",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-lock",
          "description": "Hold a state lock during the operation",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-auto-approve",
          "description": "Destroy without prompting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-target",
          "description": "Only destroy this resource address",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "terraform destroy"
      ]
    },
    {
      "name": "fmt",
      "description": "Format files",
      "args": [],
      "options": [
        {
          "name": "-recursive",
          "description": "Format files in subdirectories too",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-check",
          "description": "Fail rather than rewriting files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-diff",
          "description": "Show the changes that would be made",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-list",
          "description": "List the files that would change",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "terraform fmt"
      ]
    },
    {
      "name": "validate",
      "description": "Validate config",
      "args": [],
      "options": [
        {
          "name": "-json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-no-color",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terraform validate"
      ]
    }
  ],
  "examples": [
    {
      "command": "terraform init",
      "description": "Initialize Terraform configuration"
    },
    {
      "command": "terraform plan",
      "description": "Preview infrastructure changes"
    },
    {
      "command": "terraform apply",
      "description": "Apply infrastructure changes"
    },
    {
      "command": "terraform fmt",
      "description": "Format HCL files"
    },
    {
      "command": "terraform validate",
      "description": "Validate configuration"
    }
  ],
  "relatedCommands": [
    "terraform",
    "tofu",
    "terragrunt",
    "packer",
    "vault"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Terraform version and providers",
        "command": "terraform version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "terraform"
      },
      {
        "name": "workspace",
        "description": "Active Terraform workspace",
        "command": "terraform workspace show 2>/dev/null",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "terraform"
      },
      {
        "name": "root_module",
        "description": "Terraform root module files",
        "command": "ls *.tf 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "backend",
        "description": "Terraform backend configuration",
        "command": "grep -A8 'backend \"' *.tf 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "variables",
        "description": "Variables declared in this module",
        "command": "grep -h '^variable' *.tf 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
