{
  "name": "docker-machine",
  "description": "Provision and manage Docker hosts (legacy)",
  "category": "container",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "create",
      "description": "Create a Docker host",
      "options": [
        {
          "name": "--driver",
          "description": "Provider driver (virtualbox, amazonec2, digitalocean)",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--engine-opt",
          "description": "Docker engine option",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "ls",
      "description": "List the machines",
      "options": [
        {
          "name": "--quiet",
          "description": "Print names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--filter",
          "description": "Filter the output",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "start",
      "description": "Start a machine",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "stop",
      "description": "Stop a machine",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "restart",
      "description": "Restart a machine",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "rm",
      "description": "Remove a machine",
      "options": [
        {
          "name": "--force",
          "description": "Remove without confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "ssh",
      "description": "Run a command over SSH on a machine",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "env",
      "description": "Print the shell commands to point Docker at a machine",
      "options": [
        {
          "name": "--shell",
          "description": "Shell to generate for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--unset",
          "description": "Print commands to unset the variables",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "ip",
      "description": "Print a machine IP address",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "status",
      "description": "Show a machine status",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "scp",
      "description": "Copy files between machines",
      "options": [
        {
          "name": "--recursive",
          "description": "Copy directories",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade the Docker engine on a machine",
      "args": [
        {
          "name": "name",
          "description": "Machine name",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--storage-path",
      "description": "Directory holding machine state",
      "type": "directory",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    }
  ],
  "examples": [
    {
      "command": "docker-machine create -d virtualbox dev",
      "description": "Create a local machine"
    },
    {
      "command": "eval $(docker-machine env dev)",
      "description": "Point Docker at a machine"
    },
    {
      "command": "docker-machine ls",
      "description": "List the machines"
    },
    {
      "command": "docker-machine ssh dev",
      "description": "Open a shell on a machine"
    }
  ],
  "relatedCommands": [
    "docker",
    "colima",
    "lima",
    "vagrant"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "docker-machine version",
        "command": "docker-machine --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "docker-machine"
      },
      {
        "name": "machines",
        "description": "Docker machines on this host",
        "command": "docker-machine ls 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "docker-machine"
      },
      {
        "name": "active",
        "description": "Active docker-machine",
        "command": "docker-machine active 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "docker-machine"
      },
      {
        "name": "drivers",
        "description": "Virtualisation drivers available",
        "command": "which VBoxManage virsh qemu-system-x86_64 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
