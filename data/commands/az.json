{
  "name": "az",
  "description": "Azure CLI for managing Azure resources",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Log in to Azure",
      "options": [
        {
          "name": "--use-device-code",
          "description": "Use device code flow"
        },
        {
          "name": "--service-principal",
          "description": "Log in as service principal"
        }
      ],
      "examples": [
        "az login",
        "az login --use-device-code"
      ]
    },
    {
      "name": "account set",
      "description": "Set active subscription",
      "options": [
        {
          "name": "--subscription",
          "short": "-s",
          "description": "Subscription ID or name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-s"
        }
      ],
      "examples": [
        "az account set -s my-subscription-id"
      ]
    },
    {
      "name": "account list",
      "description": "List subscriptions",
      "examples": [
        "az account list --output table"
      ]
    },
    {
      "name": "group create",
      "description": "Create a resource group",
      "options": [
        {
          "name": "--name",
          "short": "-n",
          "description": "Resource group name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--location",
          "short": "-l",
          "description": "Location",
          "type": "string",
          "takesValue": true,
          "shorthand": "-l"
        }
      ],
      "examples": [
        "az group create -n mygroup -l eastus"
      ]
    },
    {
      "name": "group list",
      "description": "List resource groups",
      "examples": [
        "az group list --output table"
      ]
    },
    {
      "name": "vm create",
      "description": "Create a virtual machine",
      "options": [
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        },
        {
          "name": "--name",
          "short": "-n",
          "description": "VM name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--image",
          "description": "OS image",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--size",
          "description": "VM size",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--admin-username",
          "description": "Admin user",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--generate-ssh-keys",
          "description": "Generate SSH key pair"
        }
      ],
      "examples": [
        "az vm create -g mygroup -n myvm --image Ubuntu2204 --generate-ssh-keys"
      ]
    },
    {
      "name": "vm list",
      "description": "List virtual machines",
      "options": [
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Filter by resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        }
      ],
      "examples": [
        "az vm list --output table",
        "az vm list -g mygroup"
      ]
    },
    {
      "name": "aks create",
      "description": "Create an AKS cluster",
      "options": [
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        },
        {
          "name": "--name",
          "short": "-n",
          "description": "Cluster name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--node-count",
          "description": "Node count",
          "type": "number",
          "takesValue": true
        }
      ],
      "examples": [
        "az aks create -g mygroup -n mycluster --node-count 3"
      ]
    },
    {
      "name": "aks get-credentials",
      "description": "Get AKS credentials for kubectl",
      "options": [
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        },
        {
          "name": "--name",
          "short": "-n",
          "description": "Cluster name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        }
      ],
      "examples": [
        "az aks get-credentials -g mygroup -n mycluster"
      ]
    },
    {
      "name": "acr login",
      "description": "Log in to Azure Container Registry",
      "options": [
        {
          "name": "--name",
          "short": "-n",
          "description": "Registry name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        }
      ],
      "examples": [
        "az acr login -n myregistry"
      ]
    },
    {
      "name": "storage account create",
      "description": "Create a storage account",
      "options": [
        {
          "name": "--name",
          "short": "-n",
          "description": "Account name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        },
        {
          "name": "--sku",
          "description": "SKU",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "az storage account create -n mystorage -g mygroup --sku Standard_LRS"
      ]
    },
    {
      "name": "webapp create",
      "description": "Create a web app",
      "options": [
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        },
        {
          "name": "--name",
          "short": "-n",
          "description": "App name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--plan",
          "description": "App Service plan",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "az webapp create -g mygroup -n myapp --plan myplan"
      ]
    },
    {
      "name": "functionapp create",
      "description": "Create a function app",
      "options": [
        {
          "name": "--resource-group",
          "short": "-g",
          "description": "Resource group",
          "type": "string",
          "takesValue": true,
          "shorthand": "-g"
        },
        {
          "name": "--name",
          "short": "-n",
          "description": "Function app name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        },
        {
          "name": "--runtime",
          "description": "Runtime",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "az functionapp create -g mygroup -n myfunc --runtime node --consumption-plan-location eastus"
      ]
    },
