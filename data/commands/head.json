{
  "name": "head",
  "description": "Output the first part of files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Print the first N lines",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Print the first N bytes",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Never print headers for multiple files"
    },
    {
      "name": "-v",
      "description": "Always print headers"
    }
  ],
  "examples": [
    "head file.txt",
    "head -n 20 file.txt",
    "head -c 100 file.txt",
    "head -n 5 *.log",
    "cat log.txt | head -n 50"
  ],
  "relatedCommands": [
    "tail",
    "cat",
    "less",
    "more"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "head version",
        "command": "head --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "head"
      },
      {
        "name": "text_files",
        "description": "Text and log files in this directory",
        "command": "find . -maxdepth 2 -name '*.txt' -o -name '*.log' -o -name '*.csv' -o -name '*.md' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
