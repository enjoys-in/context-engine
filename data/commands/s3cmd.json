{
  "name": "s3cmd",
  "description": "Command line tool for managing Amazon S3 and S3-compatible storage",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "ls",
      "description": "List buckets or objects",
      "examples": [
        "s3cmd ls",
        "s3cmd ls s3://my-bucket/",
        "s3cmd ls s3://my-bucket/prefix/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Operate recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--long-listing",
          "description": "Show size and modification time",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "S3 URL to list",
          "required": false,
          "type": "path"
        }
      ]
    },
    {
      "name": "mb",
      "description": "Make bucket",
      "examples": [
        "s3cmd mb s3://new-bucket"
      ],
      "options": [
        {
          "name": "--bucket-location",
          "description": "Region to create the bucket in",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "S3 bucket URL to create",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "rb",
      "description": "Remove bucket",
      "examples": [
        "s3cmd rb s3://my-bucket"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Delete the bucket contents too",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--force",
          "description": "Delete without confirming",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "S3 bucket URL to remove",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "put",
      "description": "Upload files",
      "examples": [
        "s3cmd put file.txt s3://my-bucket/",
        "s3cmd put --recursive ./dir/ s3://my-bucket/dir/",
        "s3cmd put --acl-public file.txt s3://my-bucket/"
      ],
      "options": [
        {
          "name": "--acl-private",
          "description": "Keep the object private",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--guess-mime-type",
          "description": "Infer Content-Type from the extension",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--add-header",
          "description": "Extra header to send, key:value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--storage-class",
          "description": "Storage class to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--encrypt",
          "description": "Encrypt before upload",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Local files to upload",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "S3 URL to upload to",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "get",
      "description": "Download files",
      "examples": [
        "s3cmd get s3://my-bucket/file.txt",
        "s3cmd get --recursive s3://my-bucket/dir/ ./local/"
      ],
      "options": [
        {
          "name": "--skip-existing",
          "description": "Do not overwrite local files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--continue",
          "description": "Resume a partial download",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Object URL to download",
          "required": true,
          "type": "string"
        },
        {
          "name": "destination",
          "description": "Local path to write to",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "del",
      "description": "Delete objects",
      "examples": [
        "s3cmd del s3://my-bucket/file.txt",
        "s3cmd del --recursive s3://my-bucket/dir/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Delete recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--force",
          "description": "Continue past errors",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "S3 URL to delete",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "sync",
      "description": "Sync directories",
      "examples": [
        "s3cmd sync ./local/ s3://my-bucket/",
        "s3cmd sync s3://my-bucket/ ./local/",
        "s3cmd sync --delete-removed ./local/ s3://my-bucket/"
      ],
      "options": [
        {
          "name": "--delete-removed",
          "description": "Delete destination files missing from the source",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclude",
          "description": "Skip paths matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--rexclude",
          "description": "Skip paths matching this regex",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--check-md5",
          "description": "Compare checksums",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-check-md5",
          "description": "Compare only size and timestamp",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--delete-after",
          "description": "Delete after transferring rather than before",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path or S3 URL",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path or S3 URL",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "cp",
      "description": "Copy objects",
      "examples": [
        "s3cmd cp s3://bucket1/file.txt s3://bucket2/file.txt"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Operate recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--acl-public",
          "description": "Make the object publicly readable",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Object URL to copy from",
          "required": true,
          "type": "string"
        },
        {
          "name": "destination",
          "description": "Object URL to copy to",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "mv",
      "description": "Move objects",
      "examples": [
        "s3cmd mv s3://my-bucket/old.txt s3://my-bucket/new.txt"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Operate recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--acl-public",
          "description": "Make the object publicly readable",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Object URL to move from",
          "required": true,
          "type": "string"
        },
        {
          "name": "destination",
          "description": "Object URL to move to",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "du",
      "description": "Disk usage",
      "examples": [
        "s3cmd du",
        "s3cmd du s3://my-bucket/"
      ],
      "options": [
        {
          "name": "--human-readable-sizes",
          "description": "Print sizes in human units",
          "type": "boolean",
          "takesValue": false,
          "short": "-H",
          "shorthand": "-H"
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "S3 URL to total",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "info",
      "description": "Object info",
      "examples": [
        "s3cmd info s3://my-bucket/file.txt"
      ],
      "options": [],
      "args": [
        {
          "name": "path",
          "description": "S3 URL to describe",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "setacl",
      "description": "Set ACL",
      "examples": [
        "s3cmd setacl --acl-public s3://my-bucket/file.txt"
      ],
      "options": [
        {
          "name": "--acl-grant",
          "description": "Grant a permission, permission:email",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--acl-revoke",
          "description": "Revoke a permission",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "signurl",
      "description": "Generate presigned URL",
      "examples": [
        "s3cmd signurl s3://my-bucket/file.txt 3600"
      ],
      "options": [],
      "args": [
        {
          "name": "url",
          "description": "S3 URL to sign",
          "required": true,
          "type": "string"
        },
        {
          "name": "expiry",
          "description": "Seconds until the link expires",
          "required": true,
          "type": "integer"
        }
      ]
    },
    {
      "name": "expire",
      "description": "Set expiration policy",
      "examples": [
        "s3cmd expire s3://my-bucket/ --expiry-days 30"
      ],
      "options": [
        {
          "name": "--expiry-days",
          "description": "Days before objects expire",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--expiry-prefix",
          "description": "Only objects with this prefix",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "S3 bucket URL to set an expiry policy on",
          "required": true,
          "type": "path"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--configure",
      "description": "Run interactive configuration"
    },
    {
      "name": "--acl-public",
      "description": "Set public ACL"
    },
    {
      "name": "--acl-private",
      "description": "Set private ACL"
    },
    {
      "name": "--recursive",
      "short": "-r",
      "description": "Recursive operation",
      "shorthand": "-r"
    },
    {
      "name": "--dry-run",
      "description": "Simulate operation"
    },
    {
      "name": "--delete-removed",
      "description": "Delete files not in source (sync)"
    },
    {
      "name": "--exclude",
      "description": "Exclude files matching pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--include",
      "description": "Include files matching pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    },
    {
      "name": "--progress",
      "description": "Show progress"
    },
    {
      "name": "--no-progress",
      "description": "Hide progress"
    },
    {
      "name": "--host",
      "description": "S3 endpoint",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--host-bucket",
      "description": "Bucket endpoint pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Configuration file to read",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--region",
      "description": "Bucket region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--multipart-chunk-size-mb",
      "description": "Chunk size for multipart uploads",
      "type": "integer",
      "takesValue": true
    }
  ],
  "examples": [
    "s3cmd ls",
    "s3cmd put file.txt s3://my-bucket/",
    "s3cmd get s3://my-bucket/file.txt .",
    "s3cmd sync ./dir/ s3://my-bucket/dir/",
    "s3cmd del --recursive s3://my-bucket/old/",
    "s3cmd du s3://my-bucket/",
    "s3cmd mb s3://new-bucket",
    "s3cmd signurl s3://my-bucket/file.txt 3600"
  ],
  "relatedCommands": [
    "aws",
    "gsutil",
    "rclone",
    "mc"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "s3cmd version",
        "command": "s3cmd --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "s3cmd"
      },
      {
        "name": "config",
        "description": "s3cmd configuration",
        "command": "grep -E '^(host_base|bucket_location|access_key)' ~/.s3cfg 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300
      },
      {
        "name": "buckets",
        "description": "Buckets visible to s3cmd",
        "command": "s3cmd ls 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "s3cmd"
      }
    ]
  }
}
