{
  "name": "tee",
  "description": "Read from stdin and write to stdout and files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-a",
      "description": "Append to files instead of overwriting"
    },
    {
      "name": "-i",
      "description": "Ignore interrupt signals"
    }
  ],
  "examples": [
    "echo 'hello' | tee output.txt",
    "ls -la | tee listing.txt",
    "make 2>&1 | tee build.log",
    "echo 'data' | tee file1.txt file2.txt",
    "echo 'line' | tee -a log.txt",
    "command | tee /dev/tty | next_command"
  ],
  "relatedCommands": [
    "cat",
    "echo",
    "script"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tee version",
        "command": "tee --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tee"
      },
      {
        "name": "writable",
        "description": "Whether the current directory is writable",
        "command": "test -w . && echo writable || echo read-only",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "umask",
        "description": "Permission mask applied to new files",
        "command": "umask 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
