{
  "name": "opam",
  "description": "OCaml package manager",
  "category": "language",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize opam",
      "examples": [
        "opam init"
      ],
      "options": [
        {
          "name": "--bare",
          "description": "Set up opam without creating a switch",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--compiler",
          "description": "Compiler to create the initial switch with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--disable-sandboxing",
          "description": "Do not sandbox package builds",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--reinit",
          "description": "Reinitialise an existing opam root",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "install",
      "description": "Install packages",
      "examples": [
        "opam install dune merlin",
        "opam install ."
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--deps-only",
          "description": "Install only the dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--with-test",
          "description": "Include test dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--with-doc",
          "description": "Include documentation dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--switch",
          "description": "Switch to install into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "required": true,
          "type": "package"
        }
      ]
    },
    {
      "name": "switch",
      "description": "Manage OCaml installations",
      "examples": [
        "opam switch create 5.1.0",
        "opam switch list"
      ],
      "options": [
        {
          "name": "--packages",
          "description": "Packages to install in the new switch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--empty",
          "description": "Create the switch with no packages",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--repositories",
          "description": "Repositories to use for the switch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "args": [
        {
          "name": "switch",
          "description": "Switch to select or create",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update package list",
      "examples": [
        "opam update"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Update every configured repository",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--upgrade",
          "description": "Also upgrade packages afterwards",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--check",
          "description": "Report whether an update is available",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade installed packages",
      "examples": [
        "opam upgrade"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--all",
          "description": "Upgrade every switch",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--fixup",
          "description": "Attempt to repair a broken switch",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "env",
      "description": "Show environment setup",
      "examples": [
        "eval $(opam env)"
      ],
      "options": [
        {
          "name": "--switch",
          "description": "Switch whose environment to print",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--shell",
          "description": "Shell syntax to emit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--revert",
          "description": "Emit commands that undo the environment",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "examples": [
        "opam list"
      ],
      "options": [
        {
          "name": "--installed",
          "description": "Only list installed packages",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--available",
          "description": "Only list installable packages",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--short",
          "description": "Print package names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--columns",
          "description": "Columns to display",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "search",
      "description": "Search for packages",
      "examples": [
        "opam search json"
      ],
      "options": [
        {
          "name": "--case-sensitive",
          "description": "Match case exactly",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--short",
          "description": "Print package names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "pattern",
          "description": "Pattern to search for",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "pin",
      "description": "Pin a package",
      "examples": [
        "opam pin add mylib ."
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--edit",
          "description": "Edit the pinned opam file",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--kind",
          "description": "Pin kind: version, path, git or none",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--no-action",
          "description": "Pin without installing or upgrading",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to pin",
          "required": false,
          "type": "package"
        },
        {
          "name": "target",
          "description": "Version or source to pin to",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "examples": [
        "opam remove package"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--autoremove",
          "description": "Also remove orphaned dependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--force",
          "description": "Remove even when it breaks dependents",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to remove",
          "required": true,
          "type": "package"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-y",
      "description": "Auto-confirm prompts"
    },
    {
      "name": "--verbose",
      "description": "Verbose output"
    }
  ],
  "examples": [
    "opam init",
    "opam install dune merlin",
    "opam switch create 5.1.0",
    "eval $(opam env)",
    "opam update && opam upgrade"
  ],
  "relatedCommands": [
    "ocaml",
    "dune",
    "ocamlfind",
    "utop"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "opam version",
        "command": "opam --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "opam"
      },
      {
        "name": "switch",
        "description": "Active opam switch",
        "command": "opam switch show 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "opam"
      },
      {
        "name": "switches",
        "description": "opam switches available",
        "command": "opam switch list --short 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "opam"
      },
      {
        "name": "repositories",
        "description": "opam repositories configured",
        "command": "opam repository list --short 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "opam"
      }
    ]
  }
}
