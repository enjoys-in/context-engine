{
  "name": "scons",
  "description": "Software construction tool with Python build scripts",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--jobs",
      "description": "Parallel jobs to run",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--clean",
      "description": "Remove the build targets",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--file",
      "description": "SConstruct file to read",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--directory",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--dry-run",
      "description": "Print commands without running them",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--keep-going",
      "description": "Keep building after failures",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--silent",
      "description": "Suppress command output",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--tree",
      "description": "Print the dependency tree",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Enable a debug mode",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--cache-disable",
      "description": "Do not use the build cache",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "scons",
      "description": "Build the default targets"
    },
    {
      "command": "scons -j 8",
      "description": "Build with 8 jobs"
    },
    {
      "command": "scons -c",
      "description": "Clean the build outputs"
    },
    {
      "command": "scons --tree=all",
      "description": "Print the full dependency tree"
    }
  ],
  "relatedCommands": [
    "make",
    "ninja",
    "cmake",
    "bazel"
  ]
}
