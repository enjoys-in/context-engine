{
  "name": "at",
  "description": "Schedule commands for a single later execution",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-f",
      "description": "Read commands from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-l",
      "description": "List pending jobs (alias for atq)"
    },
    {
      "name": "-d",
      "description": "Delete jobs (alias for atrm)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-m",
      "description": "Send mail even if no output"
    },
    {
      "name": "-v",
      "description": "Show time the job will be executed"
    },
    {
      "name": "--file",
      "description": "Read the job from this file",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--mail",
      "description": "Mail the user when the job finishes",
      "type": "boolean",
      "takesValue": false,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--no-mail",
      "description": "Do not send mail",
      "type": "boolean",
      "takesValue": false,
      "short": "-M",
      "shorthand": "-M"
    },
    {
      "name": "--queue",
      "description": "Queue letter to use",
      "type": "string",
      "takesValue": true,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--list",
      "description": "List the pending jobs",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--remove",
      "description": "Remove these jobs",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--cat",
      "description": "Print a job script",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--time",
      "description": "Run at this time, [[CC]YY]MMDDhhmm",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--verbose",
      "description": "Show the scheduled time",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    "echo 'backup.sh' | at 2:00 AM",
    "at now + 1 hour -f script.sh",
    "at -l",
    "atrm 5",
    "echo 'reboot' | at midnight"
  ],
  "relatedCommands": [
    "cron",
    "crontab",
    "batch",
    "systemd-timer"
  ]
}
