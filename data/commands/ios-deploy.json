{
  "name": "ios-deploy",
  "description": "Install and debug iOS apps on a device from the command line",
  "category": "mobile",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--bundle",
      "description": "App bundle to install",
      "type": "path",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--id",
      "description": "Device udid to target",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--detect",
      "description": "List the connected devices",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--debug",
      "description": "Install and attach a debugger",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--justlaunch",
      "description": "Launch without attaching",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--uninstall",
      "description": "Uninstall before installing",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--bundle_id",
      "description": "Bundle identifier to operate on",
      "type": "string",
      "takesValue": true,
      "short": "-1",
      "shorthand": "-1"
    },
    {
      "name": "--download",
      "description": "Download the app container",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--list",
      "description": "List the files in the app container",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--timeout",
      "description": "Seconds to wait for a device",
      "type": "integer",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--noninteractive",
      "description": "Do not enter the interactive debugger",
      "type": "boolean",
      "takesValue": false,
      "short": "-N",
      "shorthand": "-N"
    }
  ],
  "examples": [
    {
      "command": "ios-deploy -c",
      "description": "List the connected devices"
    },
    {
      "command": "ios-deploy -b App.app",
      "description": "Install a build on the device"
    },
    {
      "command": "ios-deploy -b App.app -d",
      "description": "Install and attach the debugger"
    },
    {
      "command": "ios-deploy -b App.app -L",
      "description": "Install and launch without attaching"
    }
  ],
  "relatedCommands": [
    "xcrun",
    "simctl",
    "xcodebuild",
    "fastlane"
  ]
}
