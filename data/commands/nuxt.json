{
  "name": "nuxt",
  "description": "Nuxt CLI",
  "category": "Frontend Frameworks",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "dev",
      "description": "Start the development server",
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--host",
          "description": "Host the dev server binds to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--https",
          "description": "Serve over HTTPS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--open",
          "description": "Open a browser on start",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "examples": [
        "nuxt dev"
      ]
    },
    {
      "name": "build",
      "description": "Build the application for production",
      "options": [
        {
          "name": "--prerender",
          "description": "Prerender the static routes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dotenv",
          "description": "Env file to load",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--log-level",
          "description": "Log verbosity level",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "nuxt build"
      ]
    },
    {
      "name": "generate",
      "description": "Build the application and generate static HTML files",
      "options": [
        {
          "name": "--dotenv",
          "description": "Env file to load",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--preset",
          "description": "Nitro preset to build for",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "nuxt generate"
      ]
    },
    {
      "name": "start",
      "description": "Start the production server",
      "options": [
        {
          "name": "--port",
          "description": "Port the server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--host",
          "description": "Host the server binds to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        }
      ],
      "examples": [
        "nuxt start"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--cwd",
      "description": "Directory to run in",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--dotenv",
      "description": "Path to the .env file to load",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--log-level",
      "description": "Logging level (silent, info, verbose)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "npx nuxi dev",
      "description": "Start Nuxt dev server"
    },
    {
      "command": "npx nuxi build",
      "description": "Build Nuxt app"
    }
  ],
  "relatedCommands": [
    "vue",
    "npm",
    "vite"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "nuxt_config",
        "description": "Nuxt Configuration",
        "command": "cat nuxt.config.ts 2>/dev/null || cat nuxt.config.js 2>/dev/null | head -15",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
