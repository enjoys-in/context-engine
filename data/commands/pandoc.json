{
  "name": "pandoc",
  "description": "Universal document converter",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-f",
      "description": "Input format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Output format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Standalone document"
    },
    {
      "name": "--toc",
      "description": "Include table of contents"
    },
    {
      "name": "--template",
      "description": "Custom template",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--css",
      "description": "CSS stylesheet",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--metadata",
      "description": "Set metadata",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--filter",
      "description": "JSON filter",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--lua-filter",
      "description": "Lua filter",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--reference-doc",
      "description": "Reference document for styling",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--pdf-engine",
      "description": "PDF engine (xelatex, wkhtmltopdf, etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--highlight-style",
      "description": "Syntax highlight theme",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--number-sections",
      "description": "Number section headings"
    }
  ],
  "examples": [
    "pandoc README.md -o readme.pdf",
    "pandoc input.md -t html -s -o output.html",
    "pandoc input.md -t docx -o output.docx",
    "pandoc -f latex -t markdown input.tex -o output.md",
    "pandoc --toc -s input.md -o output.html",
    "pandoc input.md --pdf-engine=xelatex -o output.pdf"
  ],
  "relatedCommands": [
    "latex",
    "markdown",
    "asciidoctor",
    "groff"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Pandoc version",
        "command": "pandoc --version 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pandoc"
      },
      {
        "name": "input_formats",
        "description": "Input formats Pandoc accepts",
        "command": "pandoc --list-input-formats 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "pandoc"
      },
      {
        "name": "output_formats",
        "description": "Output formats Pandoc can produce",
        "command": "pandoc --list-output-formats 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "pandoc"
      },
      {
        "name": "pdf_engine",
        "description": "PDF engines available to Pandoc",
        "command": "which pdflatex xelatex wkhtmltopdf weasyprint 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "documents",
        "description": "Documents Pandoc can convert",
        "command": "find . -maxdepth 2 -name '*.md' -o -name '*.rst' -o -name '*.docx' -o -name '*.tex' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
