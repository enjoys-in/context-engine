{
  "name": "amplify",
  "description": "AWS Amplify CLI — full-stack cloud development framework",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize Amplify in a project",
      "examples": [
        "amplify init",
        "amplify init --envName dev"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Accept the defaults",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--amplify",
          "description": "Amplify project configuration",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--frontend",
          "description": "Frontend configuration",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--providers",
          "description": "Provider configuration",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "add",
      "description": "Add a category/resource",
      "examples": [
        "amplify add auth",
        "amplify add api",
        "amplify add storage",
        "amplify add function",
        "amplify add hosting",
        "amplify add analytics",
        "amplify add notifications"
      ],
      "options": [
        {
          "name": "--headless",
          "description": "Run without prompts",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "category",
          "description": "Category to add, such as api or auth",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "push",
      "description": "Push local changes to cloud",
      "examples": [
        "amplify push",
        "amplify push --yes"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--codegen",
          "description": "Generate client code",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--allow-destructive-graphql-schema-updates",
          "description": "Permit destructive schema changes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "pull",
      "description": "Pull backend environment",
      "examples": [
        "amplify pull",
        "amplify pull --appId xxx --envName dev"
      ],
      "options": [
        {
          "name": "--appId",
          "description": "Amplify app id",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--envName",
          "description": "Environment to pull",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Skip prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "publish",
      "description": "Build and publish (hosting)",
      "examples": [
        "amplify publish"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--invalidateCloudFront",
          "description": "Invalidate the CloudFront cache",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "status",
      "description": "Show current backend status",
      "examples": [
        "amplify status"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Include resource detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove a category/resource",
      "examples": [
        "amplify remove auth",
        "amplify remove api"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "args": [
        {
          "name": "category",
          "description": "Category to remove",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete entire Amplify project",
      "examples": [
        "amplify delete"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Delete without confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "env",
      "description": "Manage environments",
      "examples": [
        "amplify env list",
        "amplify env add --envName staging",
        "amplify env checkout dev",
        "amplify env remove staging"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Environment name",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against env, such as list",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "configure",
      "description": "Configure CLI and project",
      "examples": [
        "amplify configure",
        "amplify configure project"
      ],
      "options": [
        {
          "name": "--usage-data-off",
          "description": "Disable usage data collection",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against configure, such as project",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "mock",
      "description": "Run local mock server",
      "examples": [
        "amplify mock api",
        "amplify mock function"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Local port",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against mock, such as function",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "codegen",
      "description": "Generate API code",
      "examples": [
        "amplify codegen add",
        "amplify codegen generate"
      ],
      "options": [
        {
          "name": "--maxDepth",
          "description": "Maximum nesting depth for generated queries",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--target",
          "description": "Target language",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against codegen, such as add",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Update a category",
      "examples": [
        "amplify update auth",
        "amplify update api",
        "amplify update function"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against update, such as function",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "console",
      "description": "Open Amplify console",
      "examples": [
        "amplify console"
      ],
      "options": [
        {
          "name": "--app-id",
          "description": "Amplify app to open",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--yes",
      "short": "-y",
      "description": "Skip prompts with defaults",
      "shorthand": "-y"
    },
    {
      "name": "--envName",
      "description": "Environment name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--appId",
      "description": "Amplify app ID",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--providers",
      "description": "Provider plugins",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "amplify init",
    "amplify add api",
    "amplify add auth",
    "amplify push",
    "amplify publish",
    "amplify status",
    "amplify env list",
    "amplify mock api",
    "amplify console",
    "amplify codegen generate"
  ],
  "relatedCommands": [
    "aws",
    "firebase",
    "cdk",
    "serverless"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Amplify CLI version",
        "command": "amplify --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "amplify"
      },
      {
        "name": "project",
        "description": "Amplify project configuration",
        "command": "cat amplify/.config/project-config.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "backend_categories",
        "description": "Amplify backend categories in this project",
        "command": "ls amplify/backend 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "environments",
        "description": "Amplify environments",
        "command": "cat amplify/.config/local-env-info.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
