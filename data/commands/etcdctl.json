{
  "name": "etcdctl",
  "description": "Command-line client for the etcd key-value store",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "get",
      "description": "Read a key or range",
      "options": [
        {
          "name": "--prefix",
          "description": "Treat the key as a prefix",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--limit",
          "description": "Maximum results",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--keys-only",
          "description": "Print keys without values",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rev",
          "description": "Read at this revision",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or range start",
          "type": "string",
          "required": true
        }
      ],
      "examples": [
        "etcdctl get key"
      ]
    },
    {
      "name": "put",
      "description": "Write a key",
      "options": [
        {
          "name": "--lease",
          "description": "Attach this lease id",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key to write",
          "type": "string",
          "required": true
        },
        {
          "name": "value",
          "description": "Value to store",
          "type": "string",
          "required": true
        }
      ],
      "examples": [
        "etcdctl put key value"
      ]
    },
    {
      "name": "del",
      "description": "Delete a key or range",
      "options": [
        {
          "name": "--prefix",
          "description": "Treat the key as a prefix",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--prev-kv",
          "description": "Return the deleted pairs",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or range start",
          "type": "string",
          "required": true
        }
      ],
      "examples": [
        "etcdctl del key"
      ]
    },
    {
      "name": "watch",
      "description": "Watch a key or range for changes",
      "options": [
        {
          "name": "--prefix",
          "description": "Treat the key as a prefix",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rev",
          "description": "Start from this revision",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or range start",
          "type": "string",
          "required": true
        }
      ],
      "examples": [
        "etcdctl watch key"
      ]
    },
    {
      "name": "lease",
      "description": "Manage leases",
      "options": [
        {
          "name": "--endpoints",
          "description": "etcd endpoints to contact",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--write-out",
          "description": "Output format: simple, fields, json or table",
          "type": "string",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--dial-timeout",
          "description": "Connection timeout",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cacert",
          "description": "CA bundle to verify the server with",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "etcdctl lease"
      ]
    },
    {
      "name": "member",
      "description": "Manage cluster membership",
      "options": [
        {
          "name": "--endpoints",
          "description": "etcd endpoints to contact",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--write-out",
          "description": "Output format: simple, fields, json or table",
          "type": "string",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--dial-timeout",
          "description": "Connection timeout",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cacert",
          "description": "CA bundle to verify the server with",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
