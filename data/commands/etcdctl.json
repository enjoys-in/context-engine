  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--endpoints",
      "description": "Comma-separated etcd endpoints",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--cacert",
      "description": "CA certificate for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--cert",
      "description": "Client certificate for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--key",
      "description": "Client key for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--user",
      "description": "username:password to authenticate with",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--write-out",
      "description": "Output format (simple, json, table, fields)",
      "type": "string",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--dial-timeout",
      "description": "Timeout when connecting",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--insecure-skip-tls-verify",
      "description": "Do not verify the server certificate",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "etcdctl get / --prefix --keys-only",
      "description": "List every key"
    },
    {
      "command": "etcdctl put /config/mode strict",
      "description": "Write a key"
    },
    {
      "command": "etcdctl watch /config --prefix",
      "description": "Watch a prefix for changes"
    },
    {
      "command": "etcdctl endpoint health --cluster",
      "description": "Check cluster health"
    },
    {
      "command": "etcdctl snapshot save backup.db",
      "description": "Take a snapshot"
    }
  ],
  "relatedCommands": [
    "kubectl",
    "consul",
    "vault",
    "redis-cli"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "etcdctl version",
        "command": "etcdctl version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "etcdctl"
      },
      {
        "name": "endpoints",
        "description": "etcd endpoints in effect",
        "command": "echo \"${ETCDCTL_ENDPOINTS:-http://127.0.0.1:2379}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "health",
        "description": "etcd endpoint health",
        "command": "etcdctl endpoint health 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "etcdctl"
      },
      {
        "name": "members",
        "description": "etcd cluster members",
        "command": "etcdctl member list 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "etcdctl"
      }
    ]
  }
}
