{
  "name": "etcdctl",
  "description": "Command-line client for the etcd key-value store",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "get",
      "description": "Read a key or range",
      "options": [
        {
          "name": "--prefix",
          "description": "Treat the key as a prefix",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--limit",
          "description": "Maximum results",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--keys-only",
          "description": "Print keys without values",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rev",
          "description": "Read at this revision",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or range start",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "put",
      "description": "Write a key",
      "options": [
        {
          "name": "--lease",
          "description": "Attach this lease id",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key to write",
          "type": "string",
          "required": true
        },
        {
          "name": "value",
          "description": "Value to store",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "del",
      "description": "Delete a key or range",
      "options": [
        {
          "name": "--prefix",
          "description": "Treat the key as a prefix",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--prev-kv",
          "description": "Return the deleted pairs",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or range start",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "watch",
      "description": "Watch a key or range for changes",
      "options": [
        {
          "name": "--prefix",
          "description": "Treat the key as a prefix",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rev",
          "description": "Start from this revision",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "key",
          "description": "Key or range start",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "lease",
      "description": "Manage leases"
    },
    {
      "name": "member",
      "description": "Manage cluster membership"
    },
    {
      "name": "endpoint",
      "description": "Inspect endpoint health and status",
      "options": [
        {
          "name": "--cluster",
          "description": "Query every cluster member",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "snapshot",
      "description": "Save or restore a cluster snapshot"
    },
    {
      "name": "alarm",
      "description": "List or disarm cluster alarms"
    },
    {
      "name": "defrag",
      "description": "Defragment the backend database"
    },
    {
      "name": "txn",
      "description": "Run a transaction interactively"
    },
    {
      "name": "role",
      "description": "Manage roles"
    },
    {
      "name": "user",
      "description": "Manage users"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--endpoints",
      "description": "Comma-separated etcd endpoints",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--cacert",
      "description": "CA certificate for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--cert",
      "description": "Client certificate for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--key",
      "description": "Client key for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--user",
      "description": "username:password to authenticate with",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--write-out",
      "description": "Output format (simple, json, table, fields)",
      "type": "string",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--dial-timeout",
      "description": "Timeout when connecting",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--insecure-skip-tls-verify",
      "description": "Do not verify the server certificate",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "etcdctl get / --prefix --keys-only",
      "description": "List every key"
    },
    {
      "command": "etcdctl put /config/mode strict",
      "description": "Write a key"
    },
    {
      "command": "etcdctl watch /config --prefix",
      "description": "Watch a prefix for changes"
    },
    {
      "command": "etcdctl endpoint health --cluster",
      "description": "Check cluster health"
    },
    {
      "command": "etcdctl snapshot save backup.db",
      "description": "Take a snapshot"
    }
  ],
  "relatedCommands": [
    "kubectl",
    "consul",
    "vault",
    "redis-cli"
  ]
}
