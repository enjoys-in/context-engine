{
  "language": "nextjs",
  "name": "nextjs",
  "description": "Next.js CLI and development commands",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    }
  ],
  "subcommands": [
    {
      "name": "next dev",
      "description": "Starts the Next.js development server with Hot Module Replacement and Fast Refresh.",
      "options": [
        {
          "name": "--port",
          "description": "Specify the port number (default: 3000)",
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--hostname",
          "description": "Specify the hostname (default: 0.0.0.0)",
          "short": "-H",
          "shorthand": "-H"
        },
        {
          "name": "--turbo",
          "description": "Enable Turbopack for faster development builds"
        },
        {
          "name": "--experimental-https",
          "description": "Start the server with HTTPS and generate a self-signed certificate"
        },
        {
          "name": "--experimental-https-key",
          "description": "Path to HTTPS key file"
        },
        {
          "name": "--experimental-https-cert",
          "description": "Path to HTTPS certificate file"
        }
      ],
      "examples": [
        "next dev",
        "next dev --port 4000 --turbo"
      ]
    },
    {
      "name": "next build",
      "description": "Creates an optimized production build of the Next.js application.",
      "options": [
        {
          "name": "--debug",
          "description": "Enable verbose build output"
        },
        {
          "name": "--profile",
          "description": "Enable production profiling for React"
        },
        {
          "name": "--no-lint",
          "description": "Disable linting during build"
        },
        {
          "name": "--experimental-build-mode",
          "description": "Set build mode: compile or generate"
        }
      ],
      "examples": [
        "next build",
        "next build --profile"
      ]
    },
    {
      "name": "next start",
      "description": "Starts the Next.js production server. Requires next build to be run first.",
      "options": [
        {
          "name": "--port",
          "description": "Specify the port number (default: 3000)",
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--hostname",
          "description": "Specify the hostname (default: 0.0.0.0)",
          "short": "-H",
          "shorthand": "-H"
        },
        {
          "name": "--keepAliveTimeout",
          "description": "Max milliseconds to wait before closing inactive connections"
        }
      ],
      "examples": [
        "next start",
        "next start --port 8080"
      ]
    },
    {
      "name": "next lint",
      "description": "Runs ESLint for all files in the pages/, app/, components/, lib/, and src/ directories.",
      "options": [
        {
          "name": "--dir",
          "description": "Specify directories to lint",
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--file",
          "description": "Specify files to lint"
        },
        {
          "name": "--fix",
          "description": "Automatically fix linting issues"
        },
        {
          "name": "--strict",
          "description": "Create .eslintrc.json with strict configuration"
        },
        {
          "name": "--quiet",
          "description": "Report errors only"
        },
        {
          "name": "--max-warnings",
          "description": "Max number of warnings before non-zero exit"
        }
      ],
      "examples": [
        "next lint",
        "next lint --fix --dir app"
      ]
    },
    {
      "name": "next telemetry",
      "description": "Manage Next.js anonymous telemetry collection.",
      "options": [
        {
          "name": "status",
          "description": "Check if telemetry is enabled"
        },
        {
          "name": "enable",
          "description": "Enable telemetry"
        },
        {
          "name": "disable",
          "description": "Disable telemetry"
        }
      ],
      "examples": [
        "next telemetry status",
        "next telemetry disable"
      ],
      "args": [
        {
          "name": "operation",
          "description": "Telemetry operation: status, enable or disable",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "next info",
      "description": "Prints relevant system information for reporting Next.js bugs.",
      "options": [
        {
          "name": "--verbose",
          "description": "Show additional system information"
        }
      ],
      "examples": [
        "next info",
        "next info --verbose"
      ]
    },
    {
      "name": "next experimental-compile",
      "description": "Runs the compilation step of next build without generating static pages.",
      "options": [
        {
          "name": "--build-mode",
          "description": "Build mode to compile in",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "next experimental-compile"
      ]
    },
    {
      "name": "next experimental-generate",
      "description": "Runs the static generation step of next build after experimental-compile.",
      "options": [
        {
          "name": "--build-mode",
          "description": "Build mode to generate in",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "next experimental-generate"
      ]
    },
    {
      "name": "npx create-next-app@latest",
      "description": "Scaffolds a new Next.js application with interactive setup.",
      "options": [
        {
          "name": "--typescript",
          "description": "Initialize with TypeScript",
          "short": "--ts",
          "shorthand": "--ts"
        },
        {
          "name": "--javascript",
          "description": "Initialize with JavaScript",
          "short": "--js",
          "shorthand": "--js"
        },
        {
          "name": "--tailwind",
          "description": "Initialize with Tailwind CSS"
        },
        {
          "name": "--eslint",
          "description": "Initialize with ESLint"
        },
        {
          "name": "--app",
          "description": "Initialize with App Router"
        },
        {
          "name": "--src-dir",
          "description": "Initialize inside a src/ directory"
        },
        {
          "name": "--import-alias",
          "description": "Specify import alias (default: @/*)"
        },
        {
          "name": "--use-npm",
          "description": "Use npm as the package manager"
        },
        {
          "name": "--use-yarn",
          "description": "Use Yarn as the package manager"
        },
        {
          "name": "--use-pnpm",
          "description": "Use pnpm as the package manager"
        },
        {
          "name": "--use-bun",
          "description": "Use Bun as the package manager"
        },
        {
          "name": "--example",
          "description": "Bootstrap with a specific example",
          "short": "-e",
          "shorthand": "-e"
        }
      ],
      "examples": [
        "npx create-next-app@latest my-app",
        "npx create-next-app@latest my-app --typescript --tailwind --app"
      ],
      "args": [
        {
          "name": "name",
          "description": "Directory for the new app",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "NEXT_PUBLIC_*",
      "description": "Environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.",
      "options": [],
      "examples": [
        "NEXT_PUBLIC_API_URL=https://api.example.com next build"
      ]
    },
    {
      "name": "NODE_ENV",
      "description": "Set to 'development', 'production', or 'test' to control Next.js behavior.",
      "options": [],
      "examples": [
        "NODE_ENV=production next start"
      ],
      "args": [
        {
          "name": "value",
          "description": "Value to assign, such as production, development or test",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "NEXT_RUNTIME",
      "description": "Set to 'nodejs' or 'edge' to specify the runtime for Route Handlers and Server Components.",
      "options": [],
      "examples": [
        "NEXT_RUNTIME=edge next build"
      ],
      "args": [
        {
          "name": "value",
          "description": "Value to assign, such as nodejs or edge",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "ANALYZE",
      "description": "Enable bundle analysis with @next/bundle-analyzer when set to 'true'.",
      "options": [],
      "examples": [
        "ANALYZE=true next build"
      ],
      "args": [
        {
          "name": "value",
          "description": "Value to assign, such as true",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "PORT",
      "description": "Set the port for the Next.js server (alternative to --port flag).",
      "options": [],
      "examples": [
        "PORT=8080 next start"
      ],
      "args": [
        {
          "name": "value",
          "description": "Value to assign, such as 8080",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "HOSTNAME",
      "description": "Set the hostname for the Next.js server (alternative to --hostname flag).",
      "options": [],
      "examples": [
        "HOSTNAME=0.0.0.0 next start"
      ],
      "args": [
        {
          "name": "value",
          "description": "Value to assign, such as 0.0.0.0",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "examples": [
    {
      "command": "npx create-next-app@latest my-app",
      "description": "Create new Next.js project"
    },
    {
      "command": "next dev",
      "description": "Start development server"
    },
    {
      "command": "next build",
      "description": "Build for production"
    },
    {
      "command": "next start",
      "description": "Start production server"
    },
    {
      "command": "next lint",
      "description": "Run ESLint"
    }
  ],
  "relatedCommands": [
    "next",
    "npm",
    "react",
    "vercel",
    "turbo"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Next.js version",
        "command": "next --version 2>/dev/null || npx next --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Next.js configuration",
        "command": "cat next.config.js 2>/dev/null || cat next.config.mjs 2>/dev/null || cat next.config.ts 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "router",
        "description": "Router layout in use (app or pages)",
        "command": "ls -d app src/app pages src/pages 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "routes",
        "description": "Route entry points",
        "command": "find app src/app pages src/pages -maxdepth 3 -name 'page.tsx' -o -maxdepth 3 -name 'page.js' -o -maxdepth 3 -name 'index.tsx' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
