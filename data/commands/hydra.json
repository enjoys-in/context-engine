{
  "name": "hydra",
  "description": "Parallelised network login auditing tool",
  "category": "security",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "-l",
      "description": "Single username to try",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-L",
      "description": "File of usernames",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "Single password to try",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-P",
      "description": "File of passwords",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-C",
      "description": "File of colon-separated user:password pairs",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Parallel tasks per host",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Port to connect to",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "-S",
      "description": "Connect with TLS",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-f",
      "description": "Stop after the first success",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-M",
      "description": "File of targets",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Write results here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-V",
      "description": "Print every attempt",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-e",
      "description": "Extra tries: n null, s same as login, r reversed",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-w",
      "description": "Response timeout in seconds",
      "type": "integer",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "hydra -l admin -P pass.txt ssh://10.0.0.5",
      "description": "Audit SSH for one account"
    },
    {
      "command": "hydra -L users.txt -P pass.txt -t 4 -f ftp://10.0.0.5",
      "description": "Audit FTP, stopping at the first success"
    },
    {
      "command": "hydra -C creds.txt -M hosts.txt ssh",
      "description": "Audit many hosts with paired credentials"
    }
  ],
  "relatedCommands": [
    "john",
    "hashcat",
    "nmap",
    "ssh"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "hydra version",
        "command": "hydra -h 2>&1 | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hydra"
      },
      {
        "name": "services",
        "description": "Protocols this hydra build supports",
        "command": "hydra -h 2>&1 | grep -A4 'Supported services'",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hydra"
      },
      {
        "name": "wordlists",
        "description": "Wordlists available locally",
        "command": "ls /usr/share/wordlists 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
