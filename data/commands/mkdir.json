{
  "name": "mkdir",
  "description": "Create directories",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-p",
      "description": "Create parent directories as needed"
    },
    {
      "name": "-v",
      "description": "Print each directory created"
    },
    {
      "name": "-m",
      "description": "Set file mode (permissions)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "mkdir mydir",
    "mkdir -p path/to/nested/dir",
    "mkdir -m 755 secure_dir",
    "mkdir -pv a/b/c"
  ],
  "relatedCommands": [
    "rmdir",
    "ls",
    "touch"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "mkdir version",
        "command": "mkdir --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mkdir"
      },
      {
        "name": "subdirs",
        "description": "Directories already present here",
        "command": "ls -d */ 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "writable",
        "description": "Whether the current directory is writable",
        "command": "test -w . && echo writable || echo read-only",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "umask",
        "description": "Permission mask applied to new directories",
        "command": "umask 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
