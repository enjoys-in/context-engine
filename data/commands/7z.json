{
  "name": "7z",
  "aliases": [
    "7za",
    "7zr"
  ],
  "description": "7-Zip archiver with high compression (.7z and many others)",
  "category": "archive",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "a",
      "description": "Add files to an archive",
      "options": [
        {
          "name": "-t",
          "description": "Archive type (7z, zip, tar, gzip)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-mx",
          "description": "Compression level 0-9",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-p",
          "description": "Encrypt with this password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-mhe",
          "description": "Encrypt the file names too",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Split into volumes of this size",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "archive",
          "description": "Archive to create",
          "type": "file",
          "required": true
        },
        {
          "name": "files",
          "description": "Files to add",
          "type": "path",
          "required": true
        }
      ]
    },
    {
      "name": "x",
      "description": "Extract with full paths",
      "options": [
        {
          "name": "-o",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-p",
          "description": "Archive password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-y",
          "description": "Assume yes to every prompt",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "archive",
          "description": "Archive to extract",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "e",
      "description": "Extract, flattening paths",
      "options": [
        {
          "name": "-o",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "archive",
          "description": "Archive to extract",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "l",
      "description": "List the archive contents",
      "options": [
        {
          "name": "-slt",
          "description": "Show detailed technical information",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "archive",
          "description": "Archive to inspect",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "t",
      "description": "Test archive integrity",
      "args": [
        {
          "name": "archive",
          "description": "Archive to verify",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "d",
      "description": "Delete files from an archive",
      "args": [
        {
          "name": "archive",
          "description": "Archive to modify",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "u",
      "description": "Update files in an archive",
      "args": [
        {
          "name": "archive",
          "description": "Archive to update",
          "type": "file",
          "required": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-y",
      "description": "Assume yes to every prompt",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-bd",
      "description": "Disable the progress indicator",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-r",
      "description": "Recurse into subdirectories",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "7z a backup.7z docs/",
      "description": "Create an archive from a directory"
    },
    {
      "command": "7z x backup.7z -o/tmp/out",
      "description": "Extract to a directory"
    },
    {
      "command": "7z l backup.7z",
      "description": "List the contents"
    },
    {
      "command": "7z a -p -mhe=on secret.7z files/",
      "description": "Create an encrypted archive with hidden names"
    }
  ],
  "relatedCommands": [
    "zip",
    "unzip",
    "tar",
    "zstd"
  ]
}
