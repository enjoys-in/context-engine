{
  "name": "dmesg",
  "description": "Print or control the kernel ring buffer",
  "category": "system",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-H",
      "description": "Human-readable output"
    },
    {
      "name": "-T",
      "description": "Print human-readable timestamps"
    },
    {
      "name": "-w",
      "description": "Wait for new messages (follow)"
    },
    {
      "name": "-l",
      "description": "Restrict output to given level list",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Restrict to given facility list",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--color",
      "description": "Colorize output",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Clear buffer after printing"
    },
    {
      "name": "-t",
      "description": "Do not print timestamps"
    }
  ],
  "examples": [
    "dmesg | tail -20",
    "dmesg -T",
    "dmesg -H",
    "dmesg -w",
    "dmesg -l err,warn",
    "sudo dmesg -c",
    "dmesg | grep -i usb"
  ],
  "relatedCommands": [
    "journalctl",
    "syslog",
    "kern.log"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "dmesg version",
        "command": "dmesg --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dmesg"
      },
      {
        "name": "recent",
        "description": "Most recent kernel messages",
        "command": "dmesg 2>/dev/null | tail -25",
        "parser": "lines",
        "cacheFor": 15
      },
      {
        "name": "restrict",
        "description": "Whether unprivileged dmesg is restricted",
        "command": "cat /proc/sys/kernel/dmesg_restrict 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
