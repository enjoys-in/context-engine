{
  "name": "act",
  "description": "Run GitHub Actions locally",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-l",
      "description": "List available actions"
    },
    {
      "name": "-j",
      "description": "Run specific job",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-W",
      "description": "Workflow file path",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-n",
      "description": "Dry run"
    },
    {
      "name": "--secret",
      "description": "Set a secret",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--env",
      "description": "Set an env var",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-P",
      "description": "Platform mapping (e.g. ubuntu-latest=image)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--artifact-server-path",
      "description": "Local artifact path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-v",
      "description": "Verbose output"
    },
    {
      "name": "--container-architecture",
      "description": "Force container arch",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "act",
    "act -l",
    "act -j build",
    "act push",
    "act pull_request",
    "act -n",
    "act --secret GITHUB_TOKEN=xxx",
    "act -j test -P ubuntu-latest=catthehacker/ubuntu:act-latest"
  ],
  "relatedCommands": [
    "gh",
    "docker",
    "nektos",
    "make"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "act version",
        "command": "act --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "act"
      },
      {
        "name": "workflows",
        "description": "GitHub Actions workflows act can run",
        "command": "ls .github/workflows 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "jobs",
        "description": "Jobs act found in this repository",
        "command": "act --list 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "act"
      },
      {
        "name": "docker",
        "description": "Docker daemon act needs",
        "command": "docker info --format '{{.ServerVersion}}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "docker"
      },
      {
        "name": "config",
        "description": "act default flags",
        "command": "cat ~/.actrc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
