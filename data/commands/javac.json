{
  "name": "javac",
  "description": "Java compiler",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-cp",
      "description": "Classpath",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-source",
      "description": "Source version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-target",
      "description": "Target bytecode version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-g",
      "description": "Generate debug info"
    },
    {
      "name": "-Werror",
      "description": "Treat warnings as errors"
    },
    {
      "name": "-deprecation",
      "description": "Show deprecation details"
    },
    {
      "name": "-Xlint",
      "description": "Enable lint checks"
    },
    {
      "name": "-encoding",
      "description": "Source file encoding",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-verbose",
      "description": "Verbose output"
    },
    {
      "name": "--release",
      "description": "Compile for specific version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-sourcepath",
      "description": "Source file path",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "javac Main.java",
    "javac -d out/ src/*.java",
    "javac -cp lib/* Main.java",
    "javac --release 17 Main.java",
    "javac -Xlint:all Main.java"
  ],
  "relatedCommands": [
    "java",
    "jar",
    "gradle",
    "mvn"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "javac version",
        "command": "javac -version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "javac"
      },
      {
        "name": "java_home",
        "description": "JAVA_HOME in effect",
        "command": "echo \"${JAVA_HOME:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "classpath",
        "description": "CLASSPATH in effect",
        "command": "echo \"${CLASSPATH:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "sources",
        "description": "Java sources",
        "command": "find . -maxdepth 3 -name '*.java' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "build_files",
        "description": "Java build files present",
        "command": "ls pom.xml build.gradle build.gradle.kts build.xml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
