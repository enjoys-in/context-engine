{
  "name": "crossplane",
  "description": "Crossplane CLI for composing cloud infrastructure from Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install provider",
      "description": "Install a Provider",
      "examples": [
        "crossplane install provider crossplane/provider-aws:v0.40.0",
        "crossplane install provider crossplane/provider-gcp:v0.22.0"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml or wide",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--package-pull-secrets",
          "description": "Secrets to pull the package with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait until the package is healthy",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--manual-activation",
          "description": "Require manual activation of the revision",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "install configuration",
      "description": "Install a Configuration",
      "examples": [
        "crossplane install configuration my-org/my-platform:v1.0.0"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml or wide",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--package-pull-secrets",
          "description": "Secrets to pull the package with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait until the package is healthy",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "install function",
      "description": "Install a Composition Function",
      "examples": [
        "crossplane install function crossplane-contrib/function-patch-and-transform:v0.1.0"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml or wide",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--package-pull-secrets",
          "description": "Secrets to pull the package with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait until the package is healthy",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "xpkg build",
      "description": "Build a Crossplane package",
      "examples": [
        "crossplane xpkg build --package-root=. --examples-root=./examples"
      ],
      "options": [
        {
          "name": "--package-root",
          "description": "Directory holding the package metadata",
          "type": "directory",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--package-file",
          "description": "Path for the built package",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--examples-root",
          "description": "Directory of examples to embed",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "xpkg push",
      "description": "Push a Crossplane package",
      "examples": [
        "crossplane xpkg push my-org/my-config:v1.0.0 -f package.xpkg"
      ],
      "options": [
        {
          "name": "--package-files",
          "description": "Package files to push",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--create",
          "description": "Create the repository if it does not exist",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--domain",
          "description": "Registry domain to push to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "xpkg init",
      "description": "Initialize a new package",
      "examples": [
        "crossplane xpkg init my-provider provider-template"
      ],
      "options": [
        {
          "name": "--directory",
          "description": "Directory to initialise the package in",
          "type": "directory",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--type",
          "description": "Package type to scaffold",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "beta trace",
      "description": "Trace a composite resource",
      "examples": [
        "crossplane beta trace compositeresource.apiextensions.crossplane.io/my-resource"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml or wide",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--show-connection-secrets",
          "description": "Include connection secret detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--show-package-dependencies",
          "description": "Include package dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "beta validate",
      "description": "Validate compositions",
      "examples": [
        "crossplane beta validate extensions/ claims/"
      ],
      "options": [
        {
          "name": "--cache-dir",
          "description": "Directory to cache schemas in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--clean-cache",
          "description": "Clear the schema cache first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-success-results",
          "description": "Only report failures",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "beta convert",
      "description": "Convert resources between versions",
      "examples": [
        "crossplane beta convert composition composition.yaml"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Write the converted manifest here",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "beta top",
      "description": "Resource usage",
      "examples": [
        "crossplane beta top"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml or wide",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--summary",
          "description": "Show a resource summary only",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--verbose",
      "description": "Verbose output"
    }
  ],
  "examples": [
    "crossplane install provider crossplane/provider-aws:v0.40.0",
    "crossplane xpkg build",
    "crossplane xpkg push my-org/my-config:v1.0.0 -f package.xpkg",
    "crossplane beta trace compositeresource/my-resource",
    "crossplane xpkg init my-provider provider-template"
  ],
  "relatedCommands": [
    "kubectl",
    "terraform",
    "pulumi",
    "helm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Crossplane CLI version",
        "command": "crossplane version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "crossplane"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "providers",
        "description": "Crossplane providers installed",
        "command": "kubectl get providers 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "kubectl"
      },
      {
        "name": "claims",
        "description": "Crossplane composite resources",
        "command": "kubectl get composite 2>/dev/null",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      }
    ]
  }
}
