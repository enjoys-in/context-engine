{
  "name": "cabal",
  "description": "Haskell build tool and package manager",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize project",
      "examples": [
        "cabal init"
      ],
      "options": [
        {
          "name": "--interactive",
          "description": "Prompt for the package fields",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--non-interactive",
          "description": "Use defaults without prompting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--package-name",
          "description": "Name for the new package",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--lib",
          "description": "Create a library package",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exe",
          "description": "Create an executable package",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build project",
      "examples": [
        "cabal build"
      ],
      "options": [
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--enable-tests",
          "description": "Also build the test suites",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--enable-benchmarks",
          "description": "Also build the benchmarks",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--builddir",
          "description": "Directory for build artifacts",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--flags",
          "description": "Cabal flags to set",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run",
      "examples": [
        "cabal run"
      ],
      "options": [
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--flags",
          "description": "Cabal flags to set",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Target to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "cabal test"
      ],
      "options": [
        {
          "name": "--test-show-details",
          "description": "How much test output to show",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--test-options",
          "description": "Options to pass to the test binary",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install packages",
      "examples": [
        "cabal install pandoc"
      ],
      "options": [
        {
          "name": "--overwrite-policy",
          "description": "Whether to overwrite existing binaries",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--installdir",
          "description": "Directory to install binaries into",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--lib",
          "description": "Install as a library rather than an executable",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update package list",
      "examples": [
        "cabal update"
      ],
      "options": [
        {
          "name": "--index-state",
          "description": "Fetch the index as of this timestamp",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean build artifacts",
      "examples": [
        "cabal clean"
      ],
      "options": [
        {
          "name": "--save-config",
          "description": "Keep the saved configuration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--builddir",
          "description": "Directory to clean",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "repl",
      "description": "Start interactive session",
      "examples": [
        "cabal repl"
      ],
      "options": [
        {
          "name": "--build-depends",
          "description": "Add an extra dependency to the session",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--repl-options",
          "description": "Options to pass to GHCi",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "haddock",
      "description": "Generate documentation",
      "examples": [
        "cabal haddock"
      ],
      "options": [
        {
          "name": "--haddock-html",
          "description": "Generate HTML documentation",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--haddock-hyperlink-source",
          "description": "Hyperlink the source code",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--haddock-internal",
          "description": "Document internal modules too",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--enable-tests",
      "description": "Enable test suites"
    },
    {
      "name": "--enable-benchmarks",
      "description": "Enable benchmarks"
    },
    {
      "name": "-j",
      "description": "Parallel build jobs",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-O",
      "description": "Optimization level",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "cabal init",
    "cabal build",
    "cabal run",
    "cabal test",
    "cabal update && cabal install pandoc"
  ],
  "relatedCommands": [
    "ghc",
    "stack",
    "ghci",
    "haskell"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "cabal version",
        "command": "cabal --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cabal"
      },
      {
        "name": "project",
        "description": "Cabal package description",
        "command": "cat *.cabal 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "ghc",
        "description": "GHC version cabal will use",
        "command": "ghc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ghc"
      },
      {
        "name": "build_dir",
        "description": "Cabal build artifacts",
        "command": "ls dist-newstyle 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
