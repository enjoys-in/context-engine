{
  "language": "twig",
  "name": "twig",
  "description": "Twig template engine tools — linting, debugging (Symfony, Craft CMS)",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--format",
      "description": "Output format (txt, json, github)"
    },
    {
      "name": "--show-deprecations",
      "description": "Show deprecation warnings"
    },
    {
      "name": "--env",
      "description": "Symfony environment (dev, prod, test)"
    },
    {
      "name": "--no-debug",
      "description": "Disable debug mode"
    },
    {
      "name": "--ansi",
      "description": "Force colored output"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "lint",
      "description": "Lint Twig template files for syntax errors",
      "args": [
        {
          "name": "path",
          "description": "Path to lint",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format (txt, json, github)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--show-deprecations",
          "description": "Report deprecated Twig usage",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "debug",
      "description": "Display Twig functions, filters, and tests available",
      "args": [],
      "options": [
        {
          "name": "--filter",
          "description": "Only show entries matching this name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Output format (txt, json, github)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "render",
      "description": "Render a Twig template with given data",
      "args": [
        {
          "name": "template",
          "description": "Template to render",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--data",
          "description": "Data file to render the template with",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the rendered output to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cache:clear",
      "description": "Clear compiled Twig template cache",
      "args": [],
      "options": [
        {
          "name": "--no-warmup",
          "description": "Do not warm the cache afterwards",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Symfony environment to target",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "check",
      "description": "Check Twig templates for deprecated features",
      "args": [
        {
          "name": "path",
          "description": "Path to lint",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--show-deprecations",
          "description": "Report deprecated Twig usage",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "php bin/console lint:twig templates/",
    "php bin/console debug:twig --filter=date",
    "php bin/console lint:twig templates/ --format=json",
    "php bin/console cache:clear",
    "twig-lint lint templates/"
  ],
  "relatedCommands": [
    "php",
    "composer",
    "symfony",
    "html"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Symfony console availability",
        "command": "php bin/console --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "php"
      },
      {
        "name": "templates",
        "description": "Twig templates in this project",
        "command": "find templates -maxdepth 3 -name '*.twig' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "composer",
        "description": "PHP project manifest",
        "command": "cat composer.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "twig_config",
        "description": "Twig configuration for this Symfony app",
        "command": "cat config/packages/twig.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
