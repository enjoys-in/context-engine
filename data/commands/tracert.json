{
  "name": "tracert",
  "description": "Trace route to a network host (Windows)",
  "category": "networking",
  "platforms": [
    "windows"
  ],
  "shells": [
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Do not resolve addresses"
    },
    {
      "name": "-h",
      "description": "Maximum hops",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-w",
      "description": "Timeout in milliseconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-4",
      "description": "Force IPv4"
    },
    {
      "name": "-6",
      "description": "Force IPv6"
    }
  ],
  "examples": [
    "tracert google.com",
    "tracert -d 8.8.8.8",
    "tracert -h 15 example.com",
    "tracert -w 3000 server.local"
  ],
  "relatedCommands": [
    "traceroute",
    "ping",
    "pathping",
    "netstat"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tracert availability (Windows counterpart of traceroute)",
        "command": "tracert 2>&1 | head -3",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "default_gateway",
        "description": "Default gateway",
        "command": "ip route 2>/dev/null | grep default || netstat -rn 2>/dev/null | grep default",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
