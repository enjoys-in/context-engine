{
  "name": "twine",
  "description": "Publish Python packages to PyPI",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "upload",
      "description": "Upload distributions to an index",
      "options": [
        {
          "name": "--repository",
          "description": "Named repository from .pypirc",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--repository-url",
          "description": "Index URL to upload to",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--password",
          "description": "Password or token",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--skip-existing",
          "description": "Ignore files already on the index",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--sign",
          "description": "Sign the files with GPG",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "dist",
          "description": "Distribution files to upload",
          "type": "file",
          "required": true
        }
      ],
      "examples": [
        "twine upload file.txt"
      ]
    },
    {
      "name": "check",
      "description": "Check that the long description will render",
      "options": [
        {
          "name": "--strict",
          "description": "Treat warnings as errors",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "dist",
          "description": "Distribution files to check",
          "type": "file",
          "required": true
        }
      ],
      "examples": [
        "twine check file.txt"
      ]
    },
    {
      "name": "register",
      "description": "Pre-register a package name on an index",
      "options": [
        {
          "name": "--repository",
          "description": "Named repository from .pypirc",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "examples": [
        "twine register"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-color",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "twine check dist/*",
      "description": "Verify the metadata renders"
    },
    {
      "command": "twine upload dist/*",
      "description": "Publish to PyPI"
    },
    {
      "command": "twine upload -r testpypi dist/*",
      "description": "Publish to TestPyPI"
    }
  ],
  "relatedCommands": [
    "uv",
    "poetry",
    "hatch",
    "build"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "twine version",
        "command": "twine --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "twine"
      },
      {
        "name": "distributions",
        "description": "Distributions ready to upload",
        "command": "ls dist 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "repositories",
        "description": "Package repositories configured",
        "command": "grep -o '^\\[.*\\]' ~/.pypirc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "check",
        "description": "Whether built distributions pass metadata checks",
        "command": "twine check dist/* 2>/dev/null | tail -5",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "twine"
      }
    ]
  }
}
