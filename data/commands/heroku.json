{
  "name": "heroku",
  "description": "Heroku CLI — build, deploy, and manage Heroku apps",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "create",
      "description": "Create a new Heroku app",
      "examples": [
        "heroku create",
        "heroku create my-app",
        "heroku create --region eu"
      ],
      "options": [
        {
          "name": "--region",
          "description": "Region to create in",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--stack",
          "description": "Stack to use",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--team",
          "description": "Team to own the app",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--buildpack",
          "description": "Buildpack to set",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--no-remote",
          "description": "Do not add a git remote",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "app",
          "description": "Name for the new app",
          "required": false,
          "type": "app"
        }
      ]
    },
    {
      "name": "apps",
      "description": "List apps",
      "examples": [
        "heroku apps",
        "heroku apps --json",
        "heroku apps:info -a my-app"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include team apps",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--team",
          "description": "Team to list for",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "ps",
      "description": "List dynos",
      "examples": [
        "heroku ps -a my-app",
        "heroku ps:scale web=2 -a my-app",
        "heroku ps:type standard-1x -a my-app",
        "heroku ps:restart -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dyno",
          "description": "Only this dyno",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "logs",
      "description": "Display recent log output",
      "examples": [
        "heroku logs -a my-app",
        "heroku logs --tail -a my-app",
        "heroku logs -n 200 -a my-app",
        "heroku logs --source app -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--tail",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--num",
          "description": "Lines to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--source",
          "description": "Only this source",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--dyno",
          "description": "Only this dyno",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        }
      ]
    },
    {
      "name": "config",
      "description": "Display config vars",
      "examples": [
        "heroku config -a my-app",
        "heroku config:set KEY=value -a my-app",
        "heroku config:unset KEY -a my-app",
        "heroku config:get DATABASE_URL -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--shell",
          "description": "Emit shell export syntax",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "addons",
      "description": "Manage add-ons",
      "examples": [
        "heroku addons -a my-app",
        "heroku addons:create heroku-postgresql:mini -a my-app",
        "heroku addons:destroy heroku-postgresql -a my-app",
        "heroku addons:info heroku-postgresql -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all",
          "description": "Include every app",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run one-off dyno",
      "examples": [
        "heroku run bash -a my-app",
        "heroku run rails console -a my-app",
        "heroku run python manage.py migrate -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--size",
          "description": "Dyno size to use",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--exit-code",
          "description": "Return the command exit code",
          "type": "boolean",
          "takesValue": false,
          "short": "-x",
          "shorthand": "-x"
        },
        {
          "name": "--detached",
          "description": "Run detached",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run in a one-off dyno",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "releases",
      "description": "Display releases",
      "examples": [
        "heroku releases -a my-app",
        "heroku releases:info v10 -a my-app",
        "heroku releases:rollback v9 -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--num",
          "description": "Releases to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "pg",
      "description": "Manage Postgres databases",
      "examples": [
        "heroku pg:info -a my-app",
        "heroku pg:psql -a my-app",
        "heroku pg:backups -a my-app",
        "heroku pg:backups:capture -a my-app",
        "heroku pg:push local_db DATABASE_URL -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "domains",
      "description": "Manage custom domains",
      "examples": [
        "heroku domains -a my-app",
        "heroku domains:add example.com -a my-app",
        "heroku domains:remove example.com -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "certs",
      "description": "Manage SSL certificates",
      "examples": [
        "heroku certs -a my-app",
        "heroku certs:auto -a my-app",
        "heroku certs:auto:enable -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "pipelines",
      "description": "Manage deployment pipelines",
      "examples": [
        "heroku pipelines:create my-pipeline -a my-app",
        "heroku pipelines:promote -a my-app",
        "heroku pipelines:info my-pipeline"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "container",
      "description": "Manage container deploys",
      "examples": [
        "heroku container:push web -a my-app",
        "heroku container:release web -a my-app",
        "heroku container:login"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "buildpacks",
      "description": "Manage buildpacks",
      "examples": [
        "heroku buildpacks -a my-app",
        "heroku buildpacks:set heroku/nodejs -a my-app",
        "heroku buildpacks:add heroku/python -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--index",
          "description": "Position to insert at",
          "type": "integer",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "maintenance",
      "description": "Manage maintenance mode",
      "examples": [
        "heroku maintenance:on -a my-app",
        "heroku maintenance:off -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "drains",
      "description": "Manage log drains",
      "examples": [
        "heroku drains -a my-app",
        "heroku drains:add syslog://logs.example.com -a my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "auth",
      "description": "Authentication commands",
      "examples": [
        "heroku auth:whoami",
        "heroku auth:token",
        "heroku auth:login"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Heroku app to scope to",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "git",
      "description": "Git remote management",
      "examples": [
        "heroku git:remote -a my-app",
        "heroku git:clone my-app"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--remote",
          "description": "Git remote name",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "spaces",
      "description": "Manage Heroku Private Spaces",
      "examples": [
        "heroku spaces",
        "heroku spaces:create my-space --region virginia"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--team",
          "description": "Team to list for",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "reviewapps",
      "description": "Manage review apps",
      "examples": [
        "heroku reviewapps:enable -p my-pipeline",
        "heroku reviewapps:disable -p my-pipeline"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-a",
      "description": "App to run command against",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-r",
      "description": "Git remote to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--json",
      "description": "Output as JSON"
    },
    {
      "name": "--team",
      "short": "-t",
      "description": "Team name",
      "type": "string",
      "takesValue": true,
      "shorthand": "-t"
    }
  ],
  "examples": [
    "heroku create my-app",
    "heroku logs --tail -a my-app",
    "heroku config:set NODE_ENV=production -a my-app",
    "heroku ps:scale web=2 worker=1 -a my-app",
    "heroku run bash -a my-app",
    "heroku pg:backups:capture -a my-app",
    "heroku container:push web -a my-app",
    "heroku pipelines:promote -a my-app",
    "heroku addons:create heroku-redis:mini -a my-app",
    "heroku releases:rollback v9 -a my-app"
  ],
  "relatedCommands": [
    "git",
    "docker",
    "railway",
    "flyctl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Heroku CLI version",
        "command": "heroku --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "heroku"
      },
      {
        "name": "account",
        "description": "Authenticated Heroku account",
        "command": "heroku auth:whoami 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "heroku"
      },
      {
        "name": "apps",
        "description": "Heroku apps for this account",
        "command": "heroku apps --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "heroku"
      },
      {
        "name": "app_remote",
        "description": "Heroku app wired to this git remote",
        "command": "git config --get remote.heroku.url 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
