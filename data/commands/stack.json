{
  "name": "stack",
  "description": "Haskell build tool with reproducible builds",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create new project",
      "examples": [
        "stack new myproject"
      ],
      "options": [
        {
          "name": "--bare",
          "description": "Do not create a project directory",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build project",
      "examples": [
        "stack build"
      ],
      "options": [
        {
          "name": "--test",
          "description": "Also build and run the test suites",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--bench",
          "description": "Also build the benchmarks",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--fast",
          "description": "Disable optimisations",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--file-watch",
          "description": "Rebuild on file changes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pedantic",
          "description": "Turn warnings into errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run",
      "examples": [
        "stack run"
      ],
      "options": [
        {
          "name": "--fast",
          "description": "Disable optimisations",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Executable target to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "stack test"
      ],
      "options": [
        {
          "name": "--coverage",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ta",
          "description": "Arguments to pass to the test binary",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--fast",
          "description": "Disable optimisations",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--file-watch",
          "description": "Re-run on file changes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "setup",
      "description": "Install GHC",
      "examples": [
        "stack setup"
      ],
      "options": [
        {
          "name": "--reinstall",
          "description": "Reinstall the GHC toolchain",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--upgrade-cabal",
          "description": "Also upgrade the cabal library",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ghci",
      "description": "Start REPL",
      "examples": [
        "stack ghci"
      ],
      "options": [
        {
          "name": "--ghci-options",
          "description": "Options to pass to GHCi",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--main-is",
          "description": "Target whose main to load",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-load",
          "description": "Start without loading modules",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "install",
      "description": "Install executables",
      "examples": [
        "stack install hlint"
      ],
      "options": [
        {
          "name": "--copy-bins",
          "description": "Copy the built binaries to the local bin path",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "required": false,
          "type": "package"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean project",
      "examples": [
        "stack clean"
      ],
      "options": [
        {
          "name": "--full",
          "description": "Also delete the working directory",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute command in stack env",
      "examples": [
        "stack exec ghc -- --version"
      ],
      "options": [
        {
          "name": "--cwd",
          "description": "Directory to run the command in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--package",
          "description": "Make this package available",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run in the project environment",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--resolver",
      "description": "LTS resolver version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-j",
      "description": "Parallel build jobs",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--fast",
      "description": "Build without optimization"
    },
    {
      "name": "--pedantic",
      "description": "Turn on -Wall -Werror"
    }
  ],
  "examples": [
    "stack new myproject",
    "stack build",
    "stack run",
    "stack test",
    "stack ghci",
    "stack setup"
  ],
  "relatedCommands": [
    "cabal",
    "ghc",
    "ghci",
    "haskell"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Stack version",
        "command": "stack --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "stack"
      },
      {
        "name": "config",
        "description": "Stack project configuration",
        "command": "cat stack.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "resolver",
        "description": "Stackage resolver in use",
        "command": "grep -m1 '^resolver' stack.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "ghc",
        "description": "GHC version stack will use",
        "command": "stack ghc -- --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "stack"
      }
    ]
  }
}
