{
  "name": "rollup",
  "description": "JavaScript module bundler",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Use config file"
    },
    {
      "name": "-i",
      "description": "Input file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Output format (es, cjs, iife, umd, amd)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-w",
      "description": "Watch files for changes"
    },
    {
      "name": "-n",
      "description": "Name for UMD export",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sourcemap",
      "description": "Generate source maps"
    },
    {
      "name": "-p",
      "description": "Use a plugin",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "External modules",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "rollup -c",
    "rollup -i src/index.js -o dist/bundle.js -f es",
    "rollup -c rollup.prod.config.js",
    "rollup -c -w",
    "rollup src/main.js -f iife -n MyBundle -o dist/bundle.js"
  ],
  "relatedCommands": [
    "webpack",
    "esbuild",
    "vite",
    "babel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Rollup version",
        "command": "rollup --version 2>/dev/null || npx rollup --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Rollup configuration",
        "command": "cat rollup.config.js 2>/dev/null || cat rollup.config.mjs 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
