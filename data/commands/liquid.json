{
  "language": "liquid",
  "name": "shopify",
  "description": "Shopify CLI — Liquid template development and theme management",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--store",
      "description": "Shopify store URL (mystore.myshopify.com)"
    },
    {
      "name": "--path",
      "description": "Path to theme directory"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose output"
    },
    {
      "name": "--no-color",
      "description": "Disable color output"
    },
    {
      "name": "--environment",
      "description": "Environment to use from shopify.theme.toml"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    }
  ],
  "subcommands": [
    {
      "name": "theme dev",
      "description": "Start local development server for Shopify theme",
      "args": [],
      "options": [
        {
          "name": "--store",
          "description": "Store domain, e.g. my-shop.myshopify.com",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Local port for the development server",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--theme",
          "description": "Theme ID or name to operate on",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "shopify theme dev"
      ]
    },
    {
      "name": "theme push",
      "description": "Upload theme to Shopify store",
      "args": [],
      "options": [
        {
          "name": "--store",
          "description": "Store domain, e.g. my-shop.myshopify.com",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--theme",
          "description": "Theme ID or name to operate on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--allow-live",
          "description": "Permit the operation to target the live theme",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "shopify theme push"
      ]
    },
    {
      "name": "theme pull",
      "description": "Download theme from Shopify store",
      "args": [],
      "options": [
        {
          "name": "--store",
          "description": "Store domain, e.g. my-shop.myshopify.com",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--theme",
          "description": "Theme ID or name to operate on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Local theme directory",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "shopify theme pull"
      ]
    },
    {
      "name": "theme check",
      "description": "Lint Liquid and JSON theme files",
      "args": [],
      "options": [
        {
          "name": "--config",
          "description": "Theme Check configuration file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--category",
          "description": "Restrict checks to a category",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--auto-correct",
          "description": "Apply safe automatic corrections",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "shopify theme check"
      ]
    },
    {
      "name": "theme init",
      "description": "Clone a theme to start development",
      "args": [
        {
          "name": "name",
          "description": "Name for the new theme",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--clone-url",
          "description": "Git URL to clone the starter theme from",
          "type": "url",
          "takesValue": true
        }
      ],
      "examples": [
        "shopify theme init name"
      ]
    },
    {
      "name": "theme list",
      "description": "List all themes in the connected store",
      "args": [],
      "options": [
        {
          "name": "--store",
          "description": "Store domain, e.g. my-shop.myshopify.com",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "shopify theme list"
      ]
    },
    {
      "name": "theme package",
      "description": "Package theme into a zip file",
      "args": [],
      "options": [
        {
          "name": "--path",
          "description": "Local theme directory",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "shopify theme package"
      ]
    }
  ],
  "examples": [
    "shopify theme dev --store mystore.myshopify.com",
    "shopify theme check --auto-correct",
    "shopify theme push --store mystore.myshopify.com --allow-live",
    "shopify theme pull --store mystore.myshopify.com --theme 12345",
    "shopify theme init my-theme --clone-url https://github.com/Shopify/dawn.git"
  ],
  "relatedCommands": [
    "node",
    "npm",
    "html",
    "css"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Shopify CLI version",
        "command": "shopify version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "shopify"
      },
      {
        "name": "theme",
        "description": "Shopify theme configuration",
        "command": "cat .shopifyrc 2>/dev/null || cat shopify.theme.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "templates",
        "description": "Liquid templates in this theme",
        "command": "find . -maxdepth 3 -name '*.liquid' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "theme_dirs",
        "description": "Shopify theme directories present",
        "command": "ls -d sections snippets templates layout assets 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
