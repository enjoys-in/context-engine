{
  "language": "objective-c",
  "name": "clang",
  "aliases": [
    "clang++"
  ],
  "description": "Clang — Objective-C compiler (LLVM)",
  "category": "language",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh"
  ],
  "globalOptions": [
    {
      "name": "-fobjc-arc",
      "description": "Enable Automatic Reference Counting"
    },
    {
      "name": "-framework",
      "description": "Link with a named framework"
    },
    {
      "name": "-ObjC",
      "description": "Load all Objective-C classes and categories from static libs"
    },
    {
      "name": "-fmodules",
      "description": "Enable Clang modules for faster compilation"
    },
    {
      "name": "-isysroot",
      "description": "Set SDK root directory"
    },
    {
      "name": "-mios-version-min",
      "description": "Minimum iOS version target"
    },
    {
      "name": "-Wall -Wextra",
      "description": "Enable all common warnings"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    }
  ],
  "subcommands": [
    {
      "name": "-fobjc-arc file.m -o output",
      "description": "Compile with Automatic Reference Counting",
      "args": [
        {
          "name": "file",
          "description": "Objective-C source file to compile",
          "type": "file",
          "required": true
        },
        {
          "name": "output",
          "description": "Path for the compiled binary",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-I",
          "description": "Add a header search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-L",
          "description": "Add a library search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Link against this library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-Wall",
          "description": "Enable the common warnings",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-framework Foundation file.m",
      "description": "Compile linking Foundation framework",
      "args": [
        {
          "name": "file",
          "description": "Objective-C source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-I",
          "description": "Add a header search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-L",
          "description": "Add a library search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Link against this library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-Wall",
          "description": "Enable the common warnings",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-framework UIKit file.m",
      "description": "Compile linking UIKit framework (iOS)",
      "args": [
        {
          "name": "file",
          "description": "Objective-C source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-I",
          "description": "Add a header search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-L",
          "description": "Add a library search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Link against this library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-Wall",
          "description": "Enable the common warnings",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-ObjC file.m",
      "description": "Force load all Objective-C classes and categories",
      "args": [
        {
          "name": "file",
          "description": "Objective-C source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-I",
          "description": "Add a header search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-L",
          "description": "Add a library search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Link against this library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-Wall",
          "description": "Enable the common warnings",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-fobjc-exceptions file.m",
      "description": "Enable Objective-C exceptions",
      "args": [
        {
          "name": "file",
          "description": "Objective-C source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-I",
          "description": "Add a header search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-L",
          "description": "Add a library search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Link against this library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-Wall",
          "description": "Enable the common warnings",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "clang -fobjc-arc -framework Foundation main.m -o main",
    "clang -fobjc-arc -framework UIKit -framework Foundation app.m -o app",
    "clang -c -fobjc-arc module.m -o module.o",
    "xcodebuild -project MyApp.xcodeproj -scheme MyApp build",
    "clang -fobjc-arc -fmodules main.m -o main"
  ],
  "relatedCommands": [
    "xcodebuild",
    "swift",
    "gcc",
    "c"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Clang version",
        "command": "clang --version 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "clang"
      },
      {
        "name": "sdks",
        "description": "macOS SDKs available",
        "command": "xcodebuild -showsdks 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "sources",
        "description": "Objective-C sources",
        "command": "find . -maxdepth 3 -name '*.m' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "xcode_projects",
        "description": "Xcode projects here",
        "command": "ls -d *.xcodeproj *.xcworkspace 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
