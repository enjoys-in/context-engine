{
  "language": "mdx",
  "name": "mdx",
  "description": "MDX — Markdown with JSX components, compiler and CLI",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--output-format",
      "description": "Output format: program or function-body"
    },
    {
      "name": "--jsx",
      "description": "Keep JSX instead of compiling to React.createElement"
    },
    {
      "name": "--development",
      "description": "Enable development mode with extra diagnostics"
    },
    {
      "name": "--remarkPlugins",
      "description": "Remark plugins to use"
    },
    {
      "name": "--rehypePlugins",
      "description": "Rehype plugins to use"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    }
  ],
  "subcommands": [
    {
      "name": "compile",
      "description": "Compile MDX files to JavaScript",
      "args": [
        {
          "name": "file.mdx",
          "description": "MDX document to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format (program, function-body)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--jsx",
          "description": "Keep JSX instead of compiling it away",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npx @mdx-js/mdx compile doc.mdx",
        "npx @mdx-js/mdx compile 'content/**/*.mdx'"
      ]
    },
    {
      "name": "evaluate",
      "description": "Compile and evaluate MDX in one step",
      "args": [
        {
          "name": "file.mdx",
          "description": "MDX document to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--out-dir",
          "description": "Directory for the evaluated output",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "npx @mdx-js/mdx evaluate doc.mdx"
      ]
    },
    {
      "name": "lint",
      "description": "Lint MDX files with remark-lint",
      "args": [
        {
          "name": "files",
          "description": "MDX documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Path to the configuration file",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "npx remark 'content/**/*.mdx' --use remark-lint"
      ]
    },
    {
      "name": "format",
      "description": "Format MDX files with prettier",
      "args": [
        {
          "name": "files",
          "description": "MDX documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--write",
          "description": "Write formatted output back to the file",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npx prettier --write '**/*.mdx'"
      ]
    },
    {
      "name": "build",
      "description": "Build MDX content with next-mdx-remote or contentlayer",
      "args": [],
      "options": [
        {
          "name": "--config",
          "description": "Path to the configuration file",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "next build"
      ]
    }
  ],
  "examples": [
    "npx @mdx-js/mdx compile doc.mdx",
    "npx prettier --write '**/*.mdx'",
    "npx remark --use remark-mdx --use remark-lint 'docs/**/*.mdx'",
    "next build  # with @next/mdx configured",
    "npx contentlayer build"
  ],
  "relatedCommands": [
    "markdown",
    "react",
    "next",
    "prettier"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "MDX compiler version",
        "command": "npx @mdx-js/mdx --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "documents",
        "description": "MDX documents in this project",
        "command": "find . -maxdepth 4 -name '*.mdx' -not -path './node_modules/*' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "mdx_deps",
        "description": "MDX-related dependencies declared",
        "command": "grep -oE '\"@mdx-js/[^\"]*\": *\"[^\"]*\"' package.json 2>/dev/null | head -15",
        "parser": "keyvalue",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
