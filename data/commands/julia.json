{
  "language": "julia",
  "name": "julia",
  "description": "Julia command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    }
  ],
  "subcommands": [
    {
      "name": "script.jl",
      "description": "Run Julia script",
      "args": [],
      "options": [
        {
          "name": "--project",
          "description": "Project environment to activate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--threads",
          "description": "Number of threads to start",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--procs",
          "description": "Number of worker processes",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--optimize",
          "description": "Optimisation level",
          "type": "string",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        }
      ],
      "examples": [
        "julia script.jl"
      ]
    },
    {
      "name": "-e 'expression'",
      "description": "Evaluate expression",
      "args": [],
      "options": [
        {
          "name": "--project",
          "description": "Project environment to activate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--threads",
          "description": "Number of threads to start",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "examples": [
        "julia -e 'expression'"
      ]
    },
    {
      "name": "--project=.",
      "description": "Activate project environment",
      "args": [],
      "options": [
        {
          "name": "--threads",
          "description": "Number of threads to start",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--startup-file",
          "description": "Whether to load the startup file",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "julia --project=."
      ]
    },
    {
      "name": "-t auto",
      "description": "Start with auto threads",
      "args": [],
      "options": [
        {
          "name": "--project",
          "description": "Project environment to activate",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "julia -t auto"
      ]
    },
    {
      "name": "test",
      "description": "Run package tests",
      "usage": "julia -e 'using Pkg; Pkg.test()'",
      "options": [
        {
          "name": "--coverage",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--threads",
          "description": "Number of threads to start",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "examples": [
        "julia test"
      ]
    },
    {
      "name": "add",
      "description": "Add a package",
      "usage": "julia -e 'using Pkg; Pkg.add(\"PackageName\")'",
      "options": [
        {
          "name": "--preserve",
          "description": "Dependency preservation strategy",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to add",
          "required": true,
          "type": "package"
        }
      ],
      "examples": [
        "julia add DataFrames"
      ]
    },
    {
      "name": "build",
      "description": "Build a package",
      "usage": "julia -e 'using Pkg; Pkg.build()'",
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose build output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "julia build"
      ]
    },
    {
      "name": "precompile",
      "description": "Precompile packages",
      "usage": "julia -e 'using Pkg; Pkg.precompile()'",
      "options": [
        {
          "name": "--strict",
          "description": "Fail when any package cannot precompile",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "julia precompile"
      ]
    }
  ],
  "examples": [
    {
      "command": "julia script.jl",
      "description": "Run a Julia script"
    },
    {
      "command": "julia -e 'using Pkg; Pkg.add(\"DataFrames\")'",
      "description": "Install a package"
    },
    {
      "command": "julia -e 'using Pkg; Pkg.test()'",
      "description": "Run package tests"
    },
    {
      "command": "julia --project=. -e 'using Pkg; Pkg.instantiate()'",
      "description": "Install project dependencies"
    }
  ],
  "relatedCommands": [
    "python",
    "Rscript",
    "conda",
    "pkg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Julia version",
        "command": "julia --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "julia"
      },
      {
        "name": "project",
        "description": "Julia project definition",
        "command": "cat Project.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "depot",
        "description": "Julia depot path",
        "command": "echo \"${JULIA_DEPOT_PATH:-$HOME/.julia}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "sources",
        "description": "Julia sources",
        "command": "find . -maxdepth 3 -name '*.jl' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
