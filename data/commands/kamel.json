{
  "name": "kamel",
  "description": "Apache Camel K CLI — run Camel integrations on Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install Camel K operator",
      "examples": [
        "kamel install",
        "kamel install --olm=false",
        "kamel install --registry docker.io/myorg"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--registry",
          "description": "Container registry to push integration images to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait for the platform to be ready",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--olm",
          "description": "Install via the Operator Lifecycle Manager",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--global",
          "description": "Install the operator cluster-wide",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-cluster-setup",
          "description": "Do not create cluster-level resources",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run an integration",
      "examples": [
        "kamel run MyRoute.java",
        "kamel run MyRoute.groovy",
        "kamel run my-route.yaml",
        "kamel run MyRoute.java --dev",
        "kamel run MyRoute.java --name my-integration -t knative-service.enabled=true",
        "kamel run MyRoute.java -d camel-kafka"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--name",
          "description": "Name for the integration",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dev",
          "description": "Enable dev mode with live reload",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wait",
          "description": "Wait until the integration is running",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--dependency",
          "description": "Add a dependency",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--property",
          "description": "Set an integration property",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--trait",
          "description": "Configure a trait",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--profile",
          "description": "Trait profile to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Integration source file to run",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "get",
      "description": "List integrations",
      "examples": [
        "kamel get",
        "kamel get -n my-ns"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Integration to fetch",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "describe",
      "description": "Describe integration",
      "examples": [
        "kamel describe integration my-integration"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Integration to describe",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "log",
      "description": "View integration logs",
      "examples": [
        "kamel log my-integration"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--tail",
          "description": "Number of recent lines to show",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Integration to read logs from",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete integration",
      "examples": [
        "kamel delete my-integration",
        "kamel delete --all"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Delete every integration in the namespace",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Integration to delete",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "rebuild",
      "description": "Rebuild integration",
      "examples": [
        "kamel rebuild my-integration"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Rebuild every integration in the namespace",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "integration",
          "description": "Integration to rebuild",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "reset",
      "description": "Reset platform",
      "examples": [
        "kamel reset"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--skip-integrations",
          "description": "Leave integrations in place",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-kits",
          "description": "Leave integration kits in place",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "bind",
      "description": "Bind a source to a sink",
      "examples": [
        "kamel bind my-source my-sink",
        "kamel bind timer-source:tick kafka-sink:my-topic"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--name",
          "description": "Name for the binding",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error-handler",
          "description": "Error handler to configure",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--property",
          "description": "Set a binding property",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Event source to bind from",
          "required": true,
          "type": "string"
        },
        {
          "name": "sink",
          "description": "Sink to bind to",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "local",
      "description": "Local development commands",
      "examples": [
        "kamel local run MyRoute.java",
        "kamel local inspect MyRoute.java"
      ],
      "options": [
        {
          "name": "--containerize",
          "description": "Run the integration inside a container",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--image",
          "description": "Container image to build or run",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Local operation: run, build or inspect",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "kit",
      "description": "Manage integration kits",
      "examples": [
        "kamel kit get",
        "kamel kit delete my-kit"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Integration kit operation: get or delete",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "kamel version"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--operator",
          "description": "Show the operator version rather than the client",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall Camel K",
      "examples": [
        "kamel uninstall"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--skip-crd",
          "description": "Leave the custom resource definitions in place",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all",
          "description": "Remove cluster-level resources too",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--olm",
          "description": "Uninstall via the Operator Lifecycle Manager",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--config",
      "description": "Config file path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--kube-config",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "kamel install",
    "kamel run MyRoute.java",
    "kamel run MyRoute.java --dev",
    "kamel get",
    "kamel log my-integration",
    "kamel delete my-integration",
    "kamel bind timer-source:tick kafka-sink:my-topic",
    "kamel version"
  ],
  "relatedCommands": [
    "kubectl",
    "kn",
    "helm",
    "java"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Camel K CLI version",
        "command": "kamel version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "kamel"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "integrations",
        "description": "Camel K integrations in the active namespace",
        "command": "kamel get 2>/dev/null",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "kamel"
      },
      {
        "name": "routes",
        "description": "Camel route sources in this project",
        "command": "ls *.java *.xml *.yaml *.groovy *.js 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
