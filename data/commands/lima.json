{
  "name": "lima",
  "aliases": [
    "limactl"
  ],
  "description": "Linux virtual machines on macOS, with file and port forwarding",
  "category": "container",
  "platforms": [
    "macos",
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start an instance",
      "options": [
        {
          "name": "--name",
          "description": "Instance name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cpus",
          "description": "CPU cores to allocate",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--memory",
          "description": "Memory in GiB",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tty",
          "description": "Run the wizard interactively",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "template",
          "description": "Template name or file",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop an instance",
      "options": [
        {
          "name": "--force",
          "description": "Stop without a graceful shutdown",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "instance",
          "description": "Instance name",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete an instance",
      "options": [
        {
          "name": "--force",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "instance",
          "description": "Instance name",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "list",
      "description": "List the instances",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Print names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "shell",
      "description": "Open a shell inside an instance",
      "options": [
        {
          "name": "--workdir",
          "description": "Directory to start in",
          "type": "directory",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "instance",
          "description": "Instance name",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "copy",
      "description": "Copy files between host and instance",
      "options": [
        {
          "name": "--recursive",
          "description": "Copy directories",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "info",
      "description": "Show the Lima configuration and templates",
      "options": []
    },
    {
      "name": "edit",
      "description": "Edit an instance configuration",
      "options": [
        {
          "name": "--tty",
          "description": "Open the editor on a terminal",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "instance",
          "description": "Instance to edit",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "validate",
      "description": "Check a template file",
      "args": [
        {
          "name": "file",
          "description": "Template to validate",
          "type": "file",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "template",
      "description": "Inspect the bundled templates",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log-level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "limactl start",
      "description": "Start the default instance"
    },
    {
      "command": "limactl start --name=dev template://docker",
      "description": "Start a Docker-ready instance"
    },
    {
      "command": "limactl shell dev",
      "description": "Open a shell in an instance"
    },
    {
      "command": "limactl list",
      "description": "List the instances"
    }
  ],
  "relatedCommands": [
    "colima",
    "docker",
    "nerdctl",
    "vagrant"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Lima version",
        "command": "limactl --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "limactl"
      },
      {
        "name": "instances",
        "description": "Lima instances on this machine",
        "command": "limactl list 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "limactl"
      },
      {
        "name": "templates",
        "description": "Lima instance templates available",
        "command": "limactl start --list-templates 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "limactl"
      }
    ]
  }
}
