{
  "name": "mongodump",
  "description": "Create a binary export of MongoDB data",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--uri",
      "description": "Connection string",
      "type": "url",
      "takesValue": true
    },
    {
      "name": "--host",
      "description": "Server host",
      "type": "string",
      "takesValue": true,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--port",
      "description": "Server port",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--db",
      "description": "Database to dump",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--collection",
      "description": "Collection to dump",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--out",
      "description": "Directory to write the dump to",
      "type": "directory",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--archive",
      "description": "Write a single archive file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--gzip",
      "description": "Compress the output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--query",
      "description": "Only documents matching this JSON query",
      "type": "string",
      "takesValue": true,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--username",
      "description": "Username to authenticate as",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--password",
      "description": "Password to authenticate with",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--authenticationDatabase",
      "description": "Database holding the credentials",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--oplog",
      "description": "Include the oplog for a point-in-time snapshot",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--numParallelCollections",
      "description": "Collections to dump in parallel",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    }
  ],
  "examples": [
    {
      "command": "mongodump --uri \"mongodb://localhost:27017\" -d app",
      "description": "Dump one database"
    },
    {
      "command": "mongodump --archive=app.gz --gzip -d app",
      "description": "Write a compressed archive"
    },
    {
      "command": "mongodump -d app -c users -q '{\"active\":true}'",
      "description": "Dump a filtered collection"
    },
    {
      "command": "mongodump --oplog -o /backup",
      "description": "Point-in-time snapshot"
    }
  ],
  "relatedCommands": [
    "mongorestore",
    "mongosh",
    "mysqldump",
    "pg_dump"
  ]
}
