{
  "name": "du",
  "description": "Estimate file space usage",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-h",
      "description": "Human-readable sizes"
    },
    {
      "name": "-s",
      "description": "Display only a total for each argument"
    },
    {
      "name": "-a",
      "description": "Write counts for all files, not just directories"
    },
    {
      "name": "-d",
      "description": "Max depth of directories to report",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Produce a grand total"
    },
    {
      "name": "--max-depth",
      "description": "Print total for directory N levels deep",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-x",
      "description": "Skip directories on different file systems"
    },
    {
      "name": "--exclude",
      "description": "Exclude files matching pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-L",
      "description": "Follow symbolic links"
    },
    {
      "name": "--human-readable",
      "description": "Print sizes in powers of 1024",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--summarize",
      "description": "Print only a total per argument",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--all",
      "description": "Include files as well as directories",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--total",
      "description": "Add a grand total row",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--apparent-size",
      "description": "Report apparent size, not disk usage",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--one-file-system",
      "description": "Do not cross filesystem boundaries",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--exclude-from",
      "description": "Read exclude patterns from this file",
      "type": "file",
      "takesValue": true,
      "short": "-X",
      "shorthand": "-X"
    },
    {
      "name": "--block-size",
      "description": "Scale sizes by this unit",
      "type": "string",
      "takesValue": true,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--dereference",
      "description": "Follow symlinks",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--time",
      "description": "Show the last modification time",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--threshold",
      "description": "Only entries above this size",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    }
  ],
  "examples": [
    "du -sh *",
    "du -sh .",
    "du -h --max-depth=1",
    "du -ah | sort -rh | head -20",
    "du -sh /var/log/*",
    "du -shc dir1 dir2",
    "du -sh --exclude='*.log' /var"
  ],
  "relatedCommands": [
    "df",
    "ls",
    "ncdu",
    "tree"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "du version",
        "command": "du --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "du"
      },
      {
        "name": "cwd_size",
        "description": "Total size of the current directory",
        "command": "du -sh . 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "subdirs",
        "description": "Sizes of immediate subdirectories",
        "command": "du -sh */ 2>/dev/null | sort -rh | head -15",
        "parser": "table",
        "cacheFor": 120
      }
    ]
  }
}
