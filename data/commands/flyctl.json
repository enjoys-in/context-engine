              "name": "--vm-memory",
              "description": "Memory in MB",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--group",
              "description": "Process group to change",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "flyctl scale vm size"
          ]
        },
        {
          "name": "show",
          "description": "Show current scale",
          "options": [
            {
              "name": "--app",
              "description": "Application to act on",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "flyctl scale show"
          ]
        }
      ]
    },
