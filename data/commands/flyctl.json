{
  "name": "flyctl",
  "description": "Fly.io CLI for deploying and managing applications on Fly.io",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "launch",
      "description": "Create and configure a new app from source",
      "options": [
        {
          "name": "--name",
          "description": "App name",
          "takesValue": true
        },
        {
          "name": "--region",
          "shorthand": "-r",
          "description": "Region",
          "takesValue": true,
          "short": "-r"
        },
        {
          "name": "--org",
          "shorthand": "-o",
          "description": "Organization",
          "takesValue": true,
          "short": "-o"
        },
        {
          "name": "--no-deploy",
          "description": "Skip initial deploy"
        },
        {
          "name": "--copy-config",
          "description": "Copy config from existing fly.toml"
        }
      ],
      "examples": [
        "flyctl launch"
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy the application",
      "options": [
        {
          "name": "--image",
          "shorthand": "-i",
          "description": "Docker image to deploy",
          "takesValue": true,
          "short": "-i"
        },
        {
          "name": "--local-only",
          "description": "Build locally"
        },
        {
          "name": "--remote-only",
          "description": "Build remotely"
        },
        {
          "name": "--region",
          "shorthand": "-r",
          "description": "Deploy to specific region",
          "takesValue": true,
          "short": "-r"
        },
        {
          "name": "--strategy",
          "description": "Deployment strategy (canary, rolling, bluegreen)",
          "takesValue": true
        },
        {
          "name": "--detach",
          "description": "Don't follow deploy"
        }
      ],
      "examples": [
        "flyctl deploy"
      ]
    },
    {
      "name": "apps",
      "description": "Manage apps",
      "subcommands": [
        {
          "name": "list",
          "description": "List apps",
          "options": [
            {
              "name": "--org",
              "description": "Organisation to list for",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "flyctl apps list"
          ]
        },
        {
          "name": "create",
          "description": "Create an app",
          "args": [
            {
              "name": "name",
              "description": "App name",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--org",
              "shorthand": "-o",
              "description": "Organization",
              "takesValue": true,
              "short": "-o"
            }
          ],
          "examples": [
            "flyctl apps create name"
          ]
        },
        {
          "name": "destroy",
          "description": "Destroy an app",
          "args": [
            {
              "name": "name",
              "description": "App name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--yes",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            }
          ],
          "examples": [
            "flyctl apps destroy name"
          ]
        },
        {
          "name": "open",
          "description": "Open app in browser",
          "options": [
            {
              "name": "--app",
              "description": "Application to act on",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--path",
              "description": "Path to open",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "flyctl apps open"
          ]
        },
        {
          "name": "restart",
          "description": "Restart an app",
          "options": [
            {
              "name": "--app",
              "description": "Application to act on",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--force",
              "description": "Restart even if unhealthy",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "App to restart",
              "required": false,
              "type": "string"
            }
          ],
          "examples": [
            "flyctl apps restart name"
          ]
        },
        {
          "name": "move",
          "description": "Move an app to another org",
          "args": [
            {
              "name": "name",
              "description": "App name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--app",
              "description": "Application to act on",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--org",
              "description": "Organisation to operate in",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--yes",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            }
          ],
          "examples": [
            "flyctl apps move name"
          ]
        }
      ]
    },
    {
