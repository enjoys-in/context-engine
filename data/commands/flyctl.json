            {
              "name": "--group",
              "description": "Process group to change",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "flyctl scale memory size"
          ]
        },
        {
          "name": "vm",
          "description": "Set VM size",
          "args": [
            {
              "name": "size",
              "description": "VM size (shared-cpu-1x, etc)",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--app",
              "description": "Application to act on",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--vm-size",
              "description": "Preset VM size",
              "type": "string",
              "takesValue": true
