{
  "name": "nft",
  "description": "nftables - Linux kernel packet classification framework (iptables successor)",
  "category": "coreutils",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
