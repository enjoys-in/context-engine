  "globalOptions": [
    {
      "name": "-f",
      "description": "Read commands from file",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Interactive mode"
    },
    {
      "name": "-n",
      "description": "Numeric output (no hostname resolution)"
    },
    {
      "name": "-s",
      "description": "Stateless output"
    },
    {
      "name": "-a",
      "description": "Show rule handles in output"
    },
    {
      "name": "-j",
      "description": "JSON output"
    },
    {
      "name": "-c",
      "description": "Check commands without committing"
    },
    {
      "name": "-e",
      "description": "Echo what was added/inserted"
    },
    {
      "name": "--debug",
      "description": "Debug output",
      "takesValue": true
    },
    {
      "name": "--handle",
      "description": "Show handle numbers in output"
    }
  ],
  "examples": [
    {
      "command": "sudo nft list ruleset",
      "description": "Show all rules"
    },
    {
      "command": "sudo nft add table inet filter",
      "description": "Create table"
    },
    {
      "command": "sudo nft add chain inet filter input '{ type filter hook input priority 0; }'",
      "description": "Create input chain"
    },
    {
      "command": "sudo nft add rule inet filter input tcp dport 80 accept",
      "description": "Allow HTTP"
    },
    {
      "command": "sudo nft add rule inet filter input tcp dport 22 accept",
      "description": "Allow SSH"
    },
    {
      "command": "sudo nft -f /etc/nftables.conf",
      "description": "Load rules from file"
    },
    {
      "command": "sudo nft flush ruleset",
      "description": "Clear all rules"
    },
    {
      "command": "sudo nft list ruleset -j",
      "description": "JSON output"
    },
    {
      "command": "sudo nft delete rule inet filter input handle 10",
      "description": "Delete specific rule"
    }
  ],
  "relatedCommands": [
    "iptables",
    "ufw"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "ruleset",
        "description": "Current nftables ruleset",
        "command": "sudo nft list ruleset 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "nft"
      },
      {
        "name": "tables",
        "description": "Current tables",
        "command": "sudo nft list tables 2>/dev/null",
        "parser": "lines",
        "cacheFor": 15,
        "requiresCmd": "nft"
      },
      {
        "name": "config_file",
        "description": "nftables config file",
        "command": "cat /etc/nftables.conf 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "interfaces",
        "description": "Network interfaces",
        "command": "ip -br link show 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30
      }
    ]
  }
}
