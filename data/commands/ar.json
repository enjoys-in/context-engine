{
  "name": "ar",
  "description": "Create, modify and extract from static archives",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-r",
      "description": "Insert files, replacing any existing member",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-c",
      "description": "Create the archive without a warning",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-s",
      "description": "Write an index of the archive symbols",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-t",
      "description": "List the archive contents",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-x",
      "description": "Extract members from the archive",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-d",
      "description": "Delete members from the archive",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-v",
      "description": "Report each operation",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-q",
      "description": "Append files without replacing",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ar rcs libmine.a a.o b.o",
      "description": "Create a static library with an index"
    },
    {
      "command": "ar t libmine.a",
      "description": "List the members"
    },
    {
      "command": "ar x libmine.a",
      "description": "Extract every member"
    },
    {
      "command": "ar d libmine.a old.o",
      "description": "Remove a member"
    }
  ],
  "relatedCommands": [
    "ld",
    "nm",
    "ranlib",
    "gcc"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GNU ar version",
        "command": "ar --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ar"
      },
      {
        "name": "archives",
        "description": "Static libraries in this project",
        "command": "find . -maxdepth 3 -name '*.a' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "objects",
        "description": "Object files and libraries in this project",
        "command": "find . -maxdepth 3 -name '*.o' -o -name '*.a' -o -name '*.so' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
