{
  "name": "parcel",
  "description": "Zero-configuration build tool for the web",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "serve",
      "description": "Start a development server",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--host",
          "description": "Host to bind to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--open",
          "description": "Open a browser",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--https",
          "description": "Serve over HTTPS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-hmr",
          "description": "Disable hot module replacement",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "entries",
          "description": "Entry files",
          "type": "file",
          "required": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build for production",
      "options": [
        {
          "name": "--dist-dir",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--public-url",
          "description": "Public URL to serve from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-optimize",
          "description": "Skip minification",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-source-maps",
          "description": "Do not emit source maps",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--target",
          "description": "Only build this target",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "entries",
          "description": "Entry files",
          "type": "file",
          "required": false
        }
      ]
    },
    {
      "name": "watch",
      "description": "Build and rebuild on change",
      "options": [
        {
          "name": "--dist-dir",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Port for the HMR server",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--cache-dir",
      "description": "Directory for the build cache",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--no-cache",
      "description": "Disable the cache",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log-level",
      "description": "Logging level (none, error, warn, info, verbose)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Parcel config to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--detailed-report",
      "description": "Print a detailed bundle report",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "parcel index.html",
      "description": "Start the dev server"
    },
    {
      "command": "parcel build index.html",
      "description": "Build for production"
    },
    {
      "command": "parcel build --dist-dir out --public-url /app",
      "description": "Build to a directory with a base URL"
    },
    {
      "command": "parcel watch src/index.js",
      "description": "Rebuild on change"
    }
  ],
  "relatedCommands": [
    "vite",
    "webpack",
    "rollup",
    "esbuild",
    "rspack"
  ]
}
