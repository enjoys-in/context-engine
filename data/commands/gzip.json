{
  "name": "gzip",
  "description": "Compress or expand files with DEFLATE (.gz)",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--decompress",
      "description": "Expand instead of compress",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite an existing output and follow links",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout and keep the input",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--recursive",
      "description": "Descend into directories",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--list",
      "description": "Show the contents of an archive",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--best",
      "description": "Compress as hard as possible",
      "type": "boolean",
      "takesValue": false,
      "short": "-9",
      "shorthand": "-9"
    },
    {
      "name": "--fast",
      "description": "Compress faster with a weaker ratio",
      "type": "boolean",
      "takesValue": false,
      "short": "-1",
      "shorthand": "-1"
    },
    {
      "name": "--verbose",
      "description": "Report each file",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "gzip -k access.log",
      "description": "Compress and keep the original"
    },
    {
      "command": "gzip -d access.log.gz",
      "description": "Expand an archive"
    },
    {
      "command": "gzip -c file > file.gz",
      "description": "Compress to stdout"
    },
    {
      "command": "tar czf out.tgz dir/",
      "description": "Compress a directory through tar"
    }
  ],
  "relatedCommands": [
    "gunzip",
    "tar",
    "zstd",
    "xz",
    "bzip2"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "gzip version",
        "command": "gzip --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gzip"
      },
      {
        "name": "compressible",
        "description": "Files in this directory gzip could compress",
        "command": "find . -maxdepth 2 -type f -name '*.tar' -o -name '*.log' -o -name '*.sql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "alternatives",
        "description": "Faster gzip-compatible compressors available",
        "command": "which pigz zstd 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
