{
  "name": "tail",
  "description": "Output the last part of files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Output the last N lines",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Output the last N bytes",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Follow file as it grows (live)"
    },
    {
      "name": "-F",
      "description": "Follow by name (retry if renamed)"
    },
    {
      "name": "--pid",
      "description": "Terminate after process PID dies",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Never print headers"
    }
  ],
  "examples": [
    "tail file.txt",
    "tail -n 50 file.txt",
    "tail -f /var/log/syslog",
    "tail -F app.log",
    "tail -n +10 file.txt",
    "tail -f log1.txt log2.txt"
  ],
  "relatedCommands": [
    "head",
    "cat",
    "less",
    "journalctl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tail version",
        "command": "tail --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tail"
      },
      {
        "name": "log_files",
        "description": "Log files in this directory",
        "command": "find . -maxdepth 2 -name '*.log' -o -name '*.out' -o -name '*.err' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "system_logs",
        "description": "System log files available to follow",
        "command": "ls /var/log/*.log 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
