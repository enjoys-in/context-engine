{
  "name": "esbuild",
  "description": "Extremely fast JavaScript/TypeScript bundler",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--bundle",
      "description": "Bundle dependencies"
    },
    {
      "name": "--minify",
      "description": "Minify output"
    },
    {
      "name": "--outfile",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--outdir",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sourcemap",
      "description": "Generate source maps"
    },
    {
      "name": "--platform",
      "description": "Target platform (browser, node, neutral)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--target",
      "description": "Target environment",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--format",
      "description": "Output format (iife, cjs, esm)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--splitting",
      "description": "Enable code splitting"
    },
    {
      "name": "--watch",
      "description": "Watch mode"
    },
    {
      "name": "--serve",
      "description": "Start dev server"
    },
    {
      "name": "--loader",
      "description": "File type loader mapping",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--external",
      "description": "Exclude package from bundle",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "esbuild src/index.ts --bundle --outfile=dist/out.js",
    "esbuild src/*.ts --outdir=dist",
    "esbuild app.jsx --bundle --minify --sourcemap --outfile=out.js",
    "esbuild --bundle src/index.ts --platform=node --format=esm --outdir=dist",
    "esbuild --serve=8000 --bundle src/index.tsx"
  ],
  "relatedCommands": [
    "webpack",
    "rollup",
    "swc",
    "vite"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "esbuild version",
        "command": "esbuild --version 2>/dev/null || npx esbuild --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "esbuild build script in this project",
        "command": "find . -maxdepth 2 -name 'esbuild.config.*' -o -maxdepth 2 -name 'build.mjs' -o -maxdepth 2 -name 'build.js' 2>/dev/null | head -5",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
