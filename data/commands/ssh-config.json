{
  "language": "ssh-config",
  "name": "ssh",
  "description": "SSH client — secure remote shell and tunneling",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-i",
      "description": "Identity file (private key) for authentication"
    },
    {
      "name": "-p",
      "description": "Port to connect to on remote host"
    },
    {
      "name": "-L",
      "description": "Local port forwarding"
    },
    {
      "name": "-R",
      "description": "Remote port forwarding"
    },
    {
      "name": "-D",
      "description": "Dynamic SOCKS proxy"
    },
    {
      "name": "-J",
      "description": "Jump host (ProxyJump)"
    },
    {
      "name": "-N",
      "description": "Do not execute remote command (for tunnels)"
    },
    {
      "name": "-F",
      "description": "Specify alternative SSH config file"
    },
    {
      "name": "-o",
      "description": "Set SSH option (e.g., StrictHostKeyChecking=no)"
    },
    {
      "name": "-v / -vv / -vvv",
      "description": "Increase verbosity for debugging"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    }
  ],
  "subcommands": [
    {
      "name": "-T git@github.com",
      "description": "Test SSH connection without allocating TTY",
      "args": [
        {
          "name": "host",
          "description": "Host to connect to",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "Set an SSH option",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-F",
          "description": "Config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-N",
          "description": "Do not execute a remote command",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-f",
          "description": "Go to the background after authenticating",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-i key host",
      "description": "Connect using a specific identity file",
      "args": [
        {
          "name": "key",
          "description": "Private key to authenticate with",
          "type": "file",
          "required": true
        },
        {
          "name": "host",
          "description": "Host to connect to",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "Set an SSH option",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-F",
          "description": "Config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-N",
          "description": "Do not execute a remote command",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-f",
          "description": "Go to the background after authenticating",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-L port:host:port user@host",
      "description": "Local port forwarding (tunnel remote port to local)",
      "args": [
        {
          "name": "binding",
          "description": "Port-forwarding binding as port:host:port",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "Set an SSH option",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-F",
          "description": "Config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-N",
          "description": "Do not execute a remote command",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-f",
          "description": "Go to the background after authenticating",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-R port:host:port user@host",
      "description": "Remote port forwarding (tunnel local port to remote)",
      "args": [
        {
          "name": "binding",
          "description": "Port-forwarding binding as port:host:port",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "Set an SSH option",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-F",
          "description": "Config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-N",
          "description": "Do not execute a remote command",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-f",
          "description": "Go to the background after authenticating",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-D port user@host",
      "description": "Dynamic SOCKS proxy via SSH tunnel",
      "args": [
        {
          "name": "port",
          "description": "Local port to bind",
          "type": "integer",
          "required": true
        },
        {
          "name": "host",
          "description": "Host to connect to",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "Set an SSH option",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-F",
          "description": "Config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-N",
          "description": "Do not execute a remote command",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-f",
          "description": "Go to the background after authenticating",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-J jumphost user@destination",
      "description": "Connect via jump/bastion host",
      "args": [
        {
          "name": "jumphost",
          "description": "Jump host to tunnel through",
          "type": "string",
          "required": true
        },
        {
          "name": "destination",
          "description": "Destination host to reach",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-p",
          "description": "Port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "-v",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-o",
          "description": "Set an SSH option",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-F",
          "description": "Config file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-N",
          "description": "Do not execute a remote command",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-f",
          "description": "Go to the background after authenticating",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "ssh -T git@github.com",
    "ssh -i ~/.ssh/mykey user@server.example.com",
    "ssh -L 8080:localhost:80 user@remote-server",
    "ssh -J bastion user@internal-server",
    "ssh -D 1080 user@proxy-server",
    "ssh -o StrictHostKeyChecking=no user@host"
  ],
  "relatedCommands": [
    "ssh-keygen",
    "scp",
    "rsync",
    "sftp"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "OpenSSH client version",
        "command": "ssh -V 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ssh"
      },
      {
        "name": "hosts",
        "description": "Hosts defined in the SSH config",
        "command": "grep -i '^host ' ~/.ssh/config 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "includes",
        "description": "Config files included from the main SSH config",
        "command": "grep -i '^include' ~/.ssh/config 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "keys",
        "description": "SSH private keys available",
        "command": "ls ~/.ssh/id_* 2>/dev/null | grep -v '\\.pub$'",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "permissions",
        "description": "Permissions on the SSH config (must not be group-writable)",
        "command": "ls -l ~/.ssh/config 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
