{
  "name": "gdb",
  "description": "GNU debugger",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--args",
      "description": "Run the program with these arguments",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--pid",
      "description": "Attach to this process",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--core",
      "description": "Load this core dump",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--batch",
      "description": "Run the commands and exit",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--ex",
      "description": "Execute this gdb command",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--command",
      "description": "Run commands from this file",
      "type": "file",
      "takesValue": true,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--tui",
      "description": "Start the text user interface",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress the banner",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--directory",
      "description": "Add a source search directory",
      "type": "directory",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--symbols",
      "description": "Read symbols from this file",
      "type": "file",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    }
  ],
  "examples": [
    {
      "command": "gdb ./prog",
      "description": "Debug a binary"
    },
    {
      "command": "gdb --args ./prog --flag input.txt",
      "description": "Debug with program arguments"
    },
    {
      "command": "gdb -p 12345",
      "description": "Attach to a running process"
    },
    {
      "command": "gdb -c core ./prog",
      "description": "Inspect a core dump"
    },
    {
      "command": "gdb -q -batch -ex \"bt\" -c core ./prog",
      "description": "Print a backtrace non-interactively"
    }
  ],
  "relatedCommands": [
    "lldb",
    "valgrind",
    "objdump",
    "strace",
    "perf"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GDB version",
        "command": "gdb --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gdb"
      },
      {
        "name": "ptrace_scope",
        "description": "Whether ptrace attachment is restricted",
        "command": "cat /proc/sys/kernel/yama/ptrace_scope 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "init_file",
        "description": "GDB startup configuration",
        "command": "cat ~/.gdbinit 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "core_dumps",
        "description": "Core dumps available to inspect",
        "command": "find . -maxdepth 2 -name 'core' -o -name 'core.*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "debug_binaries",
        "description": "Executables with debug symbols here",
        "command": "find . -maxdepth 2 -type f -perm -u+x 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
