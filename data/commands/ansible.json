{
  "name": "ansible",
  "description": "IT automation tool for configuration management, deployment, and orchestration",
  "category": "devops",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "ansible-playbook",
      "description": "Run Ansible playbooks",
      "args": [
        {
          "name": "<playbook>",
          "type": "file",
          "required": true,
          "description": "Playbook YAML file"
        }
      ],
      "options": [
        {
          "name": "--inventory",
          "short": "-i",
          "description": "Inventory file or host list",
          "type": "file",
          "takesValue": true,
          "shorthand": "-i"
        },
        {
          "name": "--extra-vars",
          "short": "-e",
          "description": "Set additional variables",
          "type": "string",
          "takesValue": true,
          "shorthand": "-e"
        },
        {
          "name": "--tags",
          "short": "-t",
          "description": "Only run tagged tasks",
          "type": "string",
          "takesValue": true,
          "shorthand": "-t"
        },
        {
          "name": "--skip-tags",
          "description": "Skip tagged tasks",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--limit",
          "short": "-l",
          "description": "Limit to hosts",
          "type": "string",
          "takesValue": true,
          "shorthand": "-l"
        },
        {
          "name": "--check",
          "short": "-C",
          "description": "Dry run",
          "shorthand": "-C"
        },
        {
          "name": "--diff",
          "short": "-D",
          "description": "Show file diffs",
          "shorthand": "-D"
        },
        {
          "name": "--verbose",
          "short": "-v",
          "description": "Verbose mode",
          "shorthand": "-v"
        },
        {
          "name": "--become",
          "short": "-b",
          "description": "Run with elevated privileges",
          "shorthand": "-b"
        },
        {
          "name": "--ask-become-pass",
          "short": "-K",
          "description": "Prompt for privilege escalation password",
          "shorthand": "-K"
        },
        {
          "name": "--vault-password-file",
          "description": "Vault password file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--forks",
          "short": "-f",
          "description": "Number of parallel processes",
          "type": "number",
          "takesValue": true,
          "shorthand": "-f"
        }
      ],
      "examples": [
        "ansible-playbook site.yml",
        "ansible-playbook -i inventory.ini deploy.yml --tags deploy",
        "ansible-playbook site.yml --check --diff",
        "ansible-playbook -i hosts.yml playbook.yml -e 'env=production'"
      ]
    },
    {
      "name": "ansible",
      "description": "Run ad-hoc commands",
      "args": [
        {
          "name": "<pattern>",
          "type": "string",
          "required": true,
          "description": "Host pattern"
        }
      ],
      "options": [
        {
          "name": "--module-name",
          "short": "-m",
          "description": "Module name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-m"
        },
        {
          "name": "--args",
          "short": "-a",
          "description": "Module arguments",
          "type": "string",
          "takesValue": true,
          "shorthand": "-a"
        },
        {
          "name": "--inventory",
          "short": "-i",
          "description": "Inventory",
          "type": "file",
          "takesValue": true,
          "shorthand": "-i"
        },
        {
          "name": "--become",
          "short": "-b",
          "description": "Become root",
          "shorthand": "-b"
        }
      ],
      "examples": [
        "ansible all -m ping",
        "ansible webservers -m shell -a 'uptime'",
        "ansible all -m apt -a 'name=nginx state=present' -b"
      ]
    },
    {
      "name": "ansible-galaxy",
      "description": "Manage Ansible roles and collections",
      "options": [
        {
          "name": "install",
          "description": "Install role or collection"
        },
        {
          "name": "init",
          "description": "Create a new role"
        },
        {
          "name": "list",
          "description": "List installed roles"
        }
      ],
      "examples": [
        "ansible-galaxy install geerlingguy.docker",
        "ansible-galaxy collection install community.general",
        "ansible-galaxy init my_role"
      ],
      "args": [
        {
          "name": "operation",
          "description": "Galaxy operation, such as install, list or init",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "ansible-vault",
      "description": "Manage encrypted files",
      "options": [
        {
          "name": "create",
          "description": "Create encrypted file"
        },
        {
          "name": "edit",
          "description": "Edit encrypted file"
        },
        {
          "name": "encrypt",
          "description": "Encrypt a file"
        },
        {
          "name": "decrypt",
          "description": "Decrypt a file"
        },
        {
          "name": "view",
          "description": "View encrypted file"
        }
      ],
      "examples": [
        "ansible-vault create secrets.yml",
        "ansible-vault edit secrets.yml",
        "ansible-vault encrypt vars.yml",
        "ansible-vault decrypt vars.yml"
      ],
      "args": [
        {
          "name": "operation",
          "description": "Vault operation, such as create, edit, encrypt or decrypt",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "ansible-lint",
      "description": "Lint Ansible playbooks",
      "args": [
        {
          "name": "<file>",
          "type": "file",
          "required": false,
          "description": "Playbook file"
        }
      ],
      "examples": [
        "ansible-lint",
        "ansible-lint playbook.yml"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    }
  ],
  "examples": [
    "ansible-playbook -i inventory.ini site.yml",
    "ansible all -m ping -i hosts",
    "ansible-vault encrypt secrets.yml"
  ],
  "relatedCommands": [
    "terraform",
    "puppet",
    "chef",
    "salt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Ansible version and config file in use",
        "command": "ansible --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ansible"
      },
      {
        "name": "inventory",
        "description": "Ansible inventory in effect",
        "command": "ansible-inventory --list 2>/dev/null | head -c 2000",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "ansible"
      },
      {
        "name": "config",
        "description": "Ansible configuration for this project",
        "command": "cat ansible.cfg 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300
      },
      {
        "name": "playbooks",
        "description": "Playbooks in this project",
        "command": "find . -maxdepth 2 -name '*.yml' -o -maxdepth 2 -name '*.yaml' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "roles",
        "description": "Roles available to these playbooks",
        "command": "ls roles 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "collections",
        "description": "Ansible collections installed",
        "command": "ansible-galaxy collection list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 3600
      }
    ]
  }
}
