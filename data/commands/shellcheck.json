{
  "name": "shellcheck",
  "description": "Static analysis tool for shell scripts",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-e",
      "description": "Exclude specific error codes",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Shell dialect (sh, bash, dash, ksh)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Output format (gcc, json, tty, checkstyle, diff)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-S",
      "description": "Minimum severity (error, warning, info, style)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-x",
      "description": "Follow sourced files"
    },
    {
      "name": "--color",
      "description": "Color output (auto, always, never)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "shellcheck script.sh",
    "shellcheck -s bash script.sh",
    "shellcheck -f json script.sh",
    "shellcheck -e SC2034 script.sh",
    "shellcheck **/*.sh",
    "shellcheck -S warning script.sh"
  ],
  "relatedCommands": [
    "bash",
    "shfmt",
    "hadolint"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ShellCheck version",
        "command": "shellcheck --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "shellcheck"
      },
      {
        "name": "scripts",
        "description": "Shell scripts ShellCheck can lint",
        "command": "find . -maxdepth 3 -name '*.sh' -o -maxdepth 3 -name '*.bash' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "ShellCheck directives configured for this project",
        "command": "cat .shellcheckrc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
