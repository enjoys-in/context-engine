{
  "name": "earthly",
  "description": "Repeatable builds defined in an Earthfile, run in containers",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Run a target from the Earthfile",
      "options": [
        {
          "name": "--push",
          "description": "Push artifacts and images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ci",
          "description": "Run in CI mode: no cache export, strict",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Target platform",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--build-arg",
          "description": "Set a build argument",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Target to build, e.g. +build",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "bootstrap",
      "description": "Prepare the local environment and buildkit",
      "options": [
        {
          "name": "--with-autocomplete",
          "description": "Install shell completions",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ls",
      "description": "List the targets in the Earthfile",
      "options": [
        {
          "name": "--args",
          "description": "Show the build arguments each target accepts",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--long",
          "description": "Show fully qualified target names",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        }
      ]
    },
    {
      "name": "prune",
      "description": "Remove cached build data",
      "options": [
        {
          "name": "--all",
          "description": "Remove everything, including the cache volume",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--reset",
          "description": "Reset the buildkit cache",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "doc",
      "description": "Print documentation for the Earthfile targets",
      "options": [
        {
          "name": "--short",
          "description": "Print a compact listing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "account",
      "description": "Manage your Earthly account",
      "options": []
    },
    {
      "name": "org",
      "description": "Manage organisations",
      "options": []
    },
    {
      "name": "secret",
      "description": "Manage cloud secrets",
      "options": [
        {
          "name": "--org",
          "description": "Organization the secret belongs to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--project",
          "description": "Project the secret belongs to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--file",
          "description": "Read the secret value from this file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "registry",
      "description": "Manage registry credentials",
      "options": [
        {
          "name": "--org",
          "description": "Organization the credentials belong to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--project",
          "description": "Project the credentials belong to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cred-helper",
          "description": "Credential helper to use",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--allow-privileged",
      "description": "Permit privileged operations",
      "type": "boolean",
      "takesValue": false,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--interactive",
      "description": "Open a shell on failure",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-V",
      "shorthand": "-V"
    },
    {
      "name": "--no-cache",
      "description": "Ignore the cache",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strict",
      "description": "Disallow non-repeatable operations",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "earthly +build",
      "description": "Run the build target"
    },
    {
      "command": "earthly --push +docker",
      "description": "Build and push an image"
    },
    {
      "command": "earthly ls",
      "description": "List available targets"
    },
    {
      "command": "earthly prune --all",
      "description": "Clear all cached build data"
    }
  ],
  "relatedCommands": [
    "docker",
    "bazel",
    "make",
    "dagger"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Earthly version",
        "command": "earthly --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "earthly"
      },
      {
        "name": "earthfile",
        "description": "Earthfile targets in this project",
        "command": "grep -E '^[a-z0-9-]+:' Earthfile 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Earthly configuration",
        "command": "cat ~/.earthly/config.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "docker",
        "description": "Docker daemon Earthly builds against",
        "command": "docker info --format '{{.ServerVersion}}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "docker"
      }
    ]
  }
}
