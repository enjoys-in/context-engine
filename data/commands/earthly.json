{
  "name": "earthly",
  "description": "Repeatable builds defined in an Earthfile, run in containers",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Run a target from the Earthfile",
      "options": [
        {
          "name": "--push",
          "description": "Push artifacts and images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ci",
          "description": "Run in CI mode: no cache export, strict",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Target platform",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--build-arg",
          "description": "Set a build argument",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Target to build, e.g. +build",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "bootstrap",
      "description": "Prepare the local environment and buildkit",
      "options": [
        {
          "name": "--with-autocomplete",
          "description": "Install shell completions",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ls",
      "description": "List the targets in the Earthfile"
    },
    {
      "name": "prune",
      "description": "Remove cached build data",
      "options": [
        {
          "name": "--all",
          "description": "Remove everything, including the cache volume",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--reset",
          "description": "Reset the buildkit cache",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "doc",
      "description": "Print documentation for the Earthfile targets"
    },
    {
      "name": "account",
      "description": "Manage your Earthly account"
    },
    {
      "name": "org",
      "description": "Manage organisations"
    },
    {
      "name": "secret",
      "description": "Manage cloud secrets"
    },
    {
      "name": "registry",
      "description": "Manage registry credentials"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--allow-privileged",
      "description": "Permit privileged operations",
      "type": "boolean",
      "takesValue": false,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--interactive",
      "description": "Open a shell on failure",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-V",
      "shorthand": "-V"
    },
    {
      "name": "--no-cache",
      "description": "Ignore the cache",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strict",
      "description": "Disallow non-repeatable operations",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "earthly +build",
      "description": "Run the build target"
    },
    {
      "command": "earthly --push +docker",
      "description": "Build and push an image"
    },
    {
      "command": "earthly ls",
      "description": "List available targets"
    },
    {
      "command": "earthly prune --all",
      "description": "Clear all cached build data"
    }
  ],
  "relatedCommands": [
    "docker",
    "bazel",
    "make",
    "dagger"
  ]
}
