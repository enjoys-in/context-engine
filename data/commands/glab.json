{
  "name": "glab",
  "description": "GitLab CLI for managing GitLab repositories, issues, merge requests, and CI/CD",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "mr",
      "description": "Manage merge requests",
      "subcommands": [
        {
          "name": "create",
          "description": "Create a merge request",
          "options": [
            {
              "name": "--title",
              "shorthand": "-t",
              "description": "MR title",
              "takesValue": true,
              "short": "-t"
            },
            {
              "name": "--description",
              "shorthand": "-d",
              "description": "MR description",
              "takesValue": true,
              "short": "-d"
            },
            {
              "name": "--source-branch",
              "shorthand": "-s",
              "description": "Source branch",
              "takesValue": true,
              "short": "-s"
            },
            {
              "name": "--target-branch",
              "description": "Target branch",
              "takesValue": true
            },
            {
              "name": "--assignee",
              "shorthand": "-a",
              "description": "Assignee",
              "takesValue": true,
              "short": "-a"
            },
            {
              "name": "--label",
              "shorthand": "-l",
              "description": "Labels",
              "takesValue": true,
              "short": "-l"
            },
            {
              "name": "--draft",
              "description": "Create as draft"
            },
            {
              "name": "--squash-before-merge",
              "description": "Squash on merge"
            }
          ]
        },
        {
          "name": "list",
          "description": "List merge requests",
          "options": [
            {
              "name": "--state",
              "description": "Filter by state (opened, merged, closed)",
              "takesValue": true
            },
            {
              "name": "--author",
              "description": "Filter by author",
              "takesValue": true
            },
            {
              "name": "--assignee",
              "description": "Filter by assignee",
              "takesValue": true
            }
          ]
        },
        {
          "name": "view",
          "description": "View a merge request",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--web",
              "shorthand": "-w",
              "description": "Open in browser",
              "short": "-w"
            }
          ]
        },
        {
          "name": "merge",
          "description": "Merge a merge request",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--squash",
              "shorthand": "-s",
              "description": "Squash commits",
              "short": "-s"
            },
            {
              "name": "--remove-source-branch",
              "shorthand": "-d",
              "description": "Delete source branch",
              "short": "-d"
            }
          ]
        },
        {
          "name": "close",
          "description": "Close a merge request",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--repo",
              "description": "Repository to act on",
              "type": "string",
              "takesValue": true,
              "short": "-R",
              "shorthand": "-R"
            }
          ]
        },
        {
          "name": "approve",
          "description": "Approve a merge request",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--repo",
              "description": "Repository to act on",
              "type": "string",
              "takesValue": true,
              "short": "-R",
              "shorthand": "-R"
            }
          ]
        },
        {
          "name": "checkout",
          "description": "Checkout MR branch",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--branch",
              "description": "Local branch name",
              "type": "string",
              "takesValue": true,
              "short": "-b",
              "shorthand": "-b"
            },
            {
              "name": "--track",
              "description": "Set up branch tracking",
              "type": "string",
              "takesValue": true,
              "short": "-t",
              "shorthand": "-t"
            }
          ]
        },
        {
          "name": "diff",
          "description": "View MR diff",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--color",
              "description": "When to colour output",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "note",
          "description": "Add a comment to MR",
          "args": [
            {
              "name": "id",
              "description": "MR ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--message",
              "shorthand": "-m",
              "description": "Comment text",
              "takesValue": true,
              "short": "-m"
            }
          ]
        }
      ]
    },
    {
      "name": "issue",
      "description": "Manage issues",
      "subcommands": [
        {
          "name": "create",
          "description": "Create an issue",
          "options": [
            {
              "name": "--title",
              "shorthand": "-t",
              "description": "Issue title",
              "takesValue": true,
              "short": "-t"
            },
            {
              "name": "--description",
              "shorthand": "-d",
              "description": "Issue description",
              "takesValue": true,
              "short": "-d"
            },
            {
              "name": "--label",
              "shorthand": "-l",
              "description": "Labels",
              "takesValue": true,
              "short": "-l"
            },
            {
              "name": "--assignee",
              "shorthand": "-a",
              "description": "Assignee",
              "takesValue": true,
              "short": "-a"
            }
          ]
        },
        {
          "name": "list",
          "description": "List issues",
          "options": [
            {
              "name": "--state",
              "description": "Filter by state",
              "takesValue": true
            },
            {
              "name": "--label",
              "shorthand": "-l",
              "description": "Filter by label",
              "takesValue": true,
              "short": "-l"
            }
          ]
        },
        {
          "name": "view",
          "description": "View an issue",
          "args": [
            {
              "name": "id",
              "description": "Issue ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--web",
              "description": "Open in a browser",
              "type": "boolean",
              "takesValue": false,
              "short": "-w",
              "shorthand": "-w"
            },
            {
              "name": "--comments",
              "description": "Include comments",
              "type": "boolean",
              "takesValue": false,
              "short": "-c",
              "shorthand": "-c"
            },
            {
              "name": "--output",
              "description": "Output format",
              "type": "string",
              "takesValue": true,
              "short": "-F",
              "shorthand": "-F"
            }
          ]
        },
        {
          "name": "close",
          "description": "Close an issue",
          "args": [
            {
              "name": "id",
              "description": "Issue ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--repo",
              "description": "Repository to act on",
              "type": "string",
              "takesValue": true,
              "short": "-R",
              "shorthand": "-R"
            }
          ]
        },
        {
          "name": "reopen",
          "description": "Reopen an issue",
          "args": [
            {
              "name": "id",
              "description": "Issue ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--repo",
              "description": "Repository to act on",
              "type": "string",
              "takesValue": true,
              "short": "-R",
              "shorthand": "-R"
            }
          ]
        },
        {
          "name": "note",
          "description": "Add a comment",
          "args": [
            {
              "name": "id",
              "description": "Issue ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--message",
              "description": "Comment text",
              "type": "string",
              "takesValue": true,
              "short": "-m",
              "shorthand": "-m"
            }
          ]
        }
      ]
    },
    {
      "name": "ci",
      "description": "Manage CI/CD pipelines",
      "subcommands": [
        {
          "name": "list",
          "description": "List pipelines",
          "options": [
            {
              "name": "--status",
              "description": "Filter by status",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--per-page",
              "description": "Results per page",
              "type": "integer",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            },
            {
              "name": "--branch",
              "description": "Filter by branch",
              "type": "string",
              "takesValue": true,
              "short": "-b",
              "shorthand": "-b"
            }
          ]
        },
        {
          "name": "view",
          "description": "View a pipeline",
          "args": [
            {
              "name": "id",
              "description": "Pipeline ID",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--branch",
              "description": "Branch to view",
              "type": "string",
              "takesValue": true,
              "short": "-b",
              "shorthand": "-b"
            },
            {
              "name": "--web",
              "description": "Open in a browser",
              "type": "boolean",
              "takesValue": false,
              "short": "-w",
              "shorthand": "-w"
            }
          ]
        },
        {
          "name": "run",
          "description": "Trigger a pipeline",
          "options": [
            {
              "name": "--branch",
              "shorthand": "-b",
              "description": "Branch",
              "takesValue": true,
              "short": "-b"
            }
          ]
        },
        {
          "name": "retry",
          "description": "Retry a pipeline",
          "args": [
            {
              "name": "id",
              "description": "Pipeline ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--repo",
              "description": "Repository to act on",
              "type": "string",
              "takesValue": true,
              "short": "-R",
              "shorthand": "-R"
            },
            {
              "name": "--branch",
              "description": "Branch whose pipeline to retry",
              "type": "string",
              "takesValue": true,
              "short": "-b",
              "shorthand": "-b"
            }
          ]
        },
        {
          "name": "delete",
          "description": "Delete a pipeline",
          "args": [
            {
              "name": "id",
              "description": "Pipeline ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--status",
              "description": "Delete pipelines with this status",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--older-than",
              "description": "Delete pipelines older than this",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "trace",
          "description": "Trace a running pipeline",
          "options": [
            {
              "name": "--branch",
              "description": "Branch to trace",
              "type": "string",
              "takesValue": true,
              "short": "-b",
              "shorthand": "-b"
            }
          ]
        },
        {
          "name": "lint",
          "description": "Lint .gitlab-ci.yml",
          "options": [
            {
              "name": "--dry-run",
              "description": "Validate without simulating",
              "type": "boolean",
              "takesValue": false
            }
          ]
        }
      ]
    },
    {
      "name": "repo",
      "description": "Repository commands",
      "subcommands": [
        {
          "name": "clone",
          "description": "Clone a repository",
          "args": [
            {
              "name": "repo",
              "description": "Repository path",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--group",
              "description": "Clone every project in this group",
              "type": "string",
              "takesValue": true,
              "short": "-g",
              "shorthand": "-g"
            },
            {
              "name": "--archived",
              "description": "Include archived projects",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--paginate",
              "description": "Fetch every page",
              "type": "boolean",
              "takesValue": false,
              "short": "-p",
              "shorthand": "-p"
            }
          ]
        },
        {
          "name": "fork",
          "description": "Fork a repository",
          "options": [
            {
              "name": "--clone",
              "description": "Clone the fork locally",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--name",
              "description": "Name for the fork",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--remote",
              "description": "Add a git remote",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "repo",
              "description": "Repository to fork",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "name": "view",
          "description": "View repository",
          "options": [
            {
              "name": "--web",
              "shorthand": "-w",
              "description": "Open in browser",
              "short": "-w"
            }
          ],
          "args": [
            {
              "name": "repo",
              "description": "Repository to view",
              "required": false,
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "release",
      "description": "Manage releases",
      "subcommands": [
        {
          "name": "create",
          "description": "Create a release",
          "args": [
            {
              "name": "tag",
              "description": "Tag name",
              "required": true,
              "type": "tag",
              "completion": {
                "detector": "labels"
              }
            }
          ],
          "options": [
            {
              "name": "--name",
              "shorthand": "-n",
              "description": "Release name",
              "takesValue": true,
              "short": "-n"
            },
            {
              "name": "--notes",
              "description": "Release notes",
              "takesValue": true
            }
          ]
        },
        {
          "name": "list",
          "description": "List releases",
          "options": [
            {
              "name": "--per-page",
              "description": "Results per page",
              "type": "integer",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            }
          ]
        },
        {
          "name": "view",
          "description": "View a release",
          "args": [
            {
              "name": "tag",
              "description": "Tag",
              "required": true,
              "type": "tag",
              "completion": {
                "detector": "labels"
              }
            }
          ],
          "options": [
            {
              "name": "--web",
              "description": "Open in a browser",
              "type": "boolean",
              "takesValue": false,
              "short": "-w",
              "shorthand": "-w"
            }
          ]
        }
      ]
    },
    {
      "name": "label",
      "description": "Manage labels",
      "subcommands": [
        {
          "name": "list",
          "description": "List labels",
          "options": [
            {
              "name": "--per-page",
              "description": "Results per page",
              "type": "integer",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            }
          ]
        },
        {
          "name": "create",
          "description": "Create a label",
          "options": [
            {
              "name": "--name",
              "shorthand": "-n",
              "description": "Label name",
              "takesValue": true,
              "short": "-n"
            },
            {
              "name": "--color",
              "description": "Label color",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "auth",
      "description": "Manage authentication",
      "subcommands": [
        {
          "name": "login",
          "description": "Log in to GitLab",
          "options": [
            {
              "name": "--hostname",
              "description": "GitLab host",
              "type": "string",
              "takesValue": true,
              "short": "-h",
              "shorthand": "-h"
            },
            {
              "name": "--token",
              "description": "Access token",
              "type": "string",
              "takesValue": true,
              "short": "-t",
              "shorthand": "-t"
            },
            {
              "name": "--stdin",
              "description": "Read the token from stdin",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "status",
          "description": "Show auth status",
          "options": [
            {
              "name": "--hostname",
              "description": "Host to check",
              "type": "string",
              "takesValue": true,
              "short": "-h",
              "shorthand": "-h"
            },
            {
              "name": "--show-token",
              "description": "Print the stored token",
              "type": "boolean",
              "takesValue": false,
              "short": "-t",
              "shorthand": "-t"
            }
          ]
        }
      ]
    },
    {
      "name": "ssh-key",
      "description": "Manage SSH keys",
      "subcommands": [
        {
          "name": "list",
          "description": "List SSH keys",
          "options": [
            {
              "name": "--per-page",
              "description": "Results per page",
              "type": "integer",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            }
          ]
        },
        {
          "name": "add",
          "description": "Add an SSH key",
          "options": [
            {
              "name": "--title",
              "description": "Key title",
              "type": "string",
              "takesValue": true,
              "short": "-t",
              "shorthand": "-t"
            },
            {
              "name": "--expires-at",
              "description": "Expiry date",
              "type": "string",
              "takesValue": true,
              "short": "-e",
              "shorthand": "-e"
            }
          ],
          "args": [
            {
              "name": "key-file",
              "description": "Public key file to upload",
              "required": false,
              "type": "file"
            }
          ]
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--repo",
      "shorthand": "-R",
      "description": "Repository (owner/repo)",
      "takesValue": true,
      "short": "-R"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    }
  ],
  "examples": [
    {
      "command": "glab mr create --title 'Fix bug' --target-branch main",
      "description": "Create a merge request"
    },
    {
      "command": "glab mr list --state opened",
      "description": "List open MRs"
    },
    {
      "command": "glab ci view",
      "description": "View current pipeline"
    },
    {
      "command": "glab issue create -t 'New feature' -l enhancement",
      "description": "Create an issue"
    },
    {
      "command": "glab ci lint",
      "description": "Lint .gitlab-ci.yml"
    }
  ],
  "relatedCommands": [
    "git",
    "gh"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "current_branch",
        "description": "Current git branch",
        "command": "git branch --show-current 2>/dev/null",
        "parser": "text",
        "cacheFor": 10,
        "requiresCmd": "git"
      },
      {
        "name": "open_mrs",
        "description": "Open merge requests",
        "command": "glab mr list --state opened 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "glab"
      },
      {
        "name": "pipelines",
        "description": "Recent pipelines",
        "command": "glab ci list 2>/dev/null | head -10",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "glab"
      },
      {
        "name": "repo_info",
        "description": "Repository information",
        "command": "git remote get-url origin 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "git"
      },
      {
        "name": "labels",
        "description": "Project labels",
        "command": "glab label list 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "glab"
      }
    ]
  }
}
