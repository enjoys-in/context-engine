{
  "name": "meson",
  "description": "Fast, user-friendly build system generator",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "setup",
      "description": "Configure a build directory",
      "options": [
        {
          "name": "--buildtype",
          "description": "Build type (debug, release, debugoptimized)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--prefix",
          "description": "Installation prefix",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--reconfigure",
          "description": "Reconfigure an existing directory",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wipe",
          "description": "Wipe and reconfigure from cache",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "builddir",
          "description": "Directory to configure",
          "type": "directory",
          "required": true
        }
      ]
    },
    {
      "name": "compile",
      "description": "Build the configured project",
      "options": [
        {
          "name": "--jobs",
          "description": "Parallel jobs to run",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--clean",
          "description": "Clean before building",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Print every command",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run the test suite",
      "options": [
        {
          "name": "--suite",
          "description": "Only run this suite",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--repeat",
          "description": "Run each test this many times",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--print-errorlogs",
          "description": "Print logs for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timeout-multiplier",
          "description": "Scale the test timeouts",
          "type": "number",
          "takesValue": true
        }
      ]
    },
    {
      "name": "install",
      "description": "Install the built artifacts",
      "options": [
        {
          "name": "--destdir",
          "description": "Staging directory to install into",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--only-changed",
          "description": "Skip files that have not changed",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "configure",
      "description": "Show or change configuration options"
    },
    {
      "name": "introspect",
      "description": "Print project information as JSON",
      "options": [
        {
          "name": "--targets",
          "description": "List the build targets",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--projectinfo",
          "description": "Describe the project",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "dist",
      "description": "Create a release archive",
      "options": [
        {
          "name": "--formats",
          "description": "Archive formats to produce",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-tests",
          "description": "Do not build and test the archive",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "wrap",
      "description": "Manage subproject wraps"
    },
    {
      "name": "subprojects",
      "description": "Operate on all subprojects"
    },
    {
      "name": "devenv",
      "description": "Run a command in the build environment"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "meson setup build",
      "description": "Configure a build directory"
    },
    {
      "command": "meson compile -C build",
      "description": "Build the project"
    },
    {
      "command": "meson test -C build",
      "description": "Run the tests"
    },
    {
      "command": "meson install -C build",
      "description": "Install the artifacts"
    }
  ],
  "relatedCommands": [
    "ninja",
    "cmake",
    "make",
    "pkg-config"
  ]
}
