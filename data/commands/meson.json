{
  "name": "meson",
  "description": "Fast, user-friendly build system generator",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "setup",
      "description": "Configure a build directory",
      "options": [
        {
          "name": "--buildtype",
          "description": "Build type (debug, release, debugoptimized)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--prefix",
          "description": "Installation prefix",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--reconfigure",
          "description": "Reconfigure an existing directory",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wipe",
          "description": "Wipe and reconfigure from cache",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "builddir",
          "description": "Directory to configure",
          "type": "directory",
          "required": true
        }
      ],
      "examples": [
        "meson setup ./build"
      ]
    },
    {
      "name": "compile",
      "description": "Build the configured project",
      "options": [
        {
          "name": "--jobs",
          "description": "Parallel jobs to run",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--clean",
          "description": "Clean before building",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Print every command",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Targets to build",
          "required": false,
          "type": "string"
        }
      ],
      "examples": [
        "meson compile targets"
      ]
    },
    {
      "name": "test",
      "description": "Run the test suite",
      "options": [
        {
          "name": "--suite",
          "description": "Only run this suite",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--repeat",
          "description": "Run each test this many times",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--print-errorlogs",
          "description": "Print logs for failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timeout-multiplier",
          "description": "Scale the test timeouts",
          "type": "number",
          "takesValue": true
        }
      ],
      "examples": [
        "meson test"
      ]
    },
    {
      "name": "install",
      "description": "Install the built artifacts",
      "options": [
        {
          "name": "--destdir",
          "description": "Staging directory to install into",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--only-changed",
          "description": "Skip files that have not changed",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "meson install"
      ]
    },
    {
      "name": "configure",
      "description": "Show or change configuration options",
      "options": [
        {
          "name": "--prefix",
          "description": "Installation prefix",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--buildtype",
          "description": "Build type to configure",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Set a project option",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "meson configure"
      ]
    },
    {
      "name": "introspect",
      "description": "Print project information as JSON",
      "options": [
        {
          "name": "--targets",
          "description": "List the build targets",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--projectinfo",
          "description": "Describe the project",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "meson introspect"
      ]
    },
    {
      "name": "dist",
      "description": "Create a release archive",
      "options": [
        {
          "name": "--formats",
          "description": "Archive formats to produce",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-tests",
          "description": "Do not build and test the archive",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "meson dist"
      ]
    },
    {
      "name": "wrap",
      "description": "Manage subproject wraps",
      "options": [],
      "examples": [
        "meson wrap"
      ]
    },
    {
      "name": "subprojects",
      "description": "Operate on all subprojects",
      "options": [
        {
          "name": "--num-processes",
          "description": "Number of parallel processes",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "meson subprojects"
      ]
    },
    {
      "name": "devenv",
      "description": "Run a command in the build environment",
      "options": [
        {
          "name": "--workdir",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--dump",
          "description": "Print the environment rather than starting a shell",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "meson devenv"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "meson setup build",
      "description": "Configure a build directory"
    },
    {
      "command": "meson compile -C build",
      "description": "Build the project"
    },
    {
      "command": "meson test -C build",
      "description": "Run the tests"
    },
    {
      "command": "meson install -C build",
      "description": "Install the artifacts"
    }
  ],
  "relatedCommands": [
    "ninja",
    "cmake",
    "make",
    "pkg-config"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Meson version",
        "command": "meson --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "meson"
      },
      {
        "name": "project",
        "description": "Meson project definition",
        "command": "cat meson.build 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "build_dirs",
        "description": "Configured Meson build directories",
        "command": "ls -d build builddir 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "ninja",
        "description": "Ninja backend available",
        "command": "ninja --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
