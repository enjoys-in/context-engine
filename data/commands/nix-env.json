{
  "name": "nix-env",
  "description": "Classic Nix interface for managing user packages",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--install",
      "description": "Install packages",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--uninstall",
      "description": "Remove packages",
      "type": "boolean",
      "takesValue": false,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--upgrade",
      "description": "Upgrade packages",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--query",
      "description": "Query installed or available packages",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--available",
      "description": "Operate on available rather than installed packages",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--attr",
      "description": "Select by attribute path",
      "type": "string",
      "takesValue": true,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--file",
      "description": "Nix expression to read",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--rollback",
      "description": "Roll back to the previous generation",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--list-generations",
      "description": "List the profile generations",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--delete-generations",
      "description": "Delete these generations",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--switch-generation",
      "description": "Switch to this generation",
      "type": "string",
      "takesValue": true,
      "short": "-G",
      "shorthand": "-G"
    },
    {
      "name": "--dry-run",
      "description": "Report what would happen",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "nix-env -iA nixpkgs.ripgrep",
      "description": "Install a package by attribute"
    },
    {
      "command": "nix-env -q",
      "description": "List installed packages"
    },
    {
      "command": "nix-env -u",
      "description": "Upgrade everything"
    },
    {
      "command": "nix-env --list-generations",
      "description": "Show the profile history"
    },
    {
      "command": "nix-env --rollback",
      "description": "Undo the last change"
    }
  ],
  "relatedCommands": [
    "nix",
    "nix-shell",
    "brew",
    "apt"
  ]
}
