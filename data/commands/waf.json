{
  "name": "waf",
  "description": "Python-based build system with configure, build and install steps",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "configure",
      "description": "Configure the project",
      "options": [
        {
          "name": "--prefix",
          "description": "Installation prefix",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--out",
          "description": "Build output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--top",
          "description": "Project root directory",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "waf configure"
      ]
    },
    {
      "name": "build",
      "description": "Build the project",
      "options": [
        {
          "name": "--jobs",
          "description": "Parallel jobs to run",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--targets",
          "description": "Only build these targets",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--progress",
          "description": "Show a progress bar",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "waf build"
      ]
    },
    {
      "name": "install",
      "description": "Install the built artifacts",
      "options": [
        {
          "name": "--destdir",
          "description": "Staging directory to install into",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "waf install"
      ]
    },
    {
      "name": "uninstall",
      "description": "Remove the installed artifacts",
      "options": [
        {
          "name": "--destdir",
          "description": "Staging directory to remove from",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "waf uninstall"
      ]
    },
    {
      "name": "clean",
      "description": "Remove the build outputs",
      "options": [],
      "examples": [
        "waf clean"
      ]
    },
    {
      "name": "distclean",
      "description": "Remove the build outputs and configuration",
      "options": [],
      "examples": [
        "waf distclean"
      ]
    },
    {
      "name": "dist",
      "description": "Create a source archive",
      "options": [
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ],
      "examples": [
        "waf dist"
      ]
    },
    {
      "name": "list",
      "description": "List the available targets",
      "options": [],
      "examples": [
        "waf list"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--zones",
      "description": "Enable debugging for these zones",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--color",
      "description": "When to colour output",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "./waf configure --prefix=/usr/local",
      "description": "Configure the project"
    },
    {
      "command": "./waf build -j8",
      "description": "Build with 8 jobs"
    },
    {
      "command": "./waf install",
      "description": "Install the artifacts"
    },
    {
      "command": "./waf distclean",
      "description": "Reset the build directory"
    }
  ],
  "relatedCommands": [
    "scons",
    "meson",
    "make",
    "ninja"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "waf version",
        "command": "./waf --version 2>/dev/null || waf --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "script",
        "description": "waf build script",
        "command": "cat wscript 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "build_dir",
        "description": "waf build output directory",
        "command": "ls -d build 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "python",
        "description": "Python interpreter waf runs on",
        "command": "python3 --version 2>&1",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
