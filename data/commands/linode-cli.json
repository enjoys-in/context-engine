{
  "name": "linode-cli",
  "description": "Linode CLI for managing Akamai cloud computing services",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "linodes",
      "description": "Manage Linode instances",
      "subcommands": [
        {
          "name": "create",
          "description": "Create a Linode",
          "options": [
            {
              "name": "--type",
              "description": "Plan type",
              "takesValue": true
            },
            {
              "name": "--region",
              "description": "Region",
              "takesValue": true
            },
            {
              "name": "--image",
              "description": "Image",
              "takesValue": true
            },
            {
              "name": "--root_pass",
              "description": "Root password",
              "takesValue": true
            },
            {
              "name": "--label",
              "description": "Instance label",
              "takesValue": true
            }
          ],
          "examples": [
            "linode-cli linodes create"
          ]
        },
        {
          "name": "list",
          "description": "List Linodes",
          "options": [
            {
              "name": "--json",
              "description": "Output as JSON"
            }
          ],
          "examples": [
            "linode-cli linodes list"
          ]
        },
        {
          "name": "view",
          "description": "View a Linode",
          "args": [
            {
              "name": "id",
              "description": "Linode ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--text",
              "description": "Emit tab-separated text",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--format",
              "description": "Restrict output to these fields",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--no-headers",
              "description": "Omit the header row",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--all",
              "description": "Show every available column",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "linode-cli linodes view id"
          ]
        },
        {
          "name": "delete",
          "description": "Delete a Linode",
          "args": [
            {
              "name": "id",
              "description": "Linode ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--no-defaults",
              "description": "Ignore configured defaults",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "linode-cli linodes delete id"
          ]
        },
        {
          "name": "boot",
          "description": "Boot a Linode",
          "args": [
            {
              "name": "id",
              "description": "Linode ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--config_id",
              "description": "Boot into this configuration profile",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "linode-cli linodes boot id"
          ]
        },
        {
          "name": "shutdown",
          "description": "Shutdown a Linode",
          "args": [
            {
              "name": "id",
              "description": "Linode ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "linode-cli linodes shutdown id"
          ]
        },
        {
          "name": "reboot",
          "description": "Reboot a Linode",
          "args": [
            {
              "name": "id",
              "description": "Linode ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--config_id",
              "description": "Reboot into this configuration profile",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "linode-cli linodes reboot id"
          ]
        }
      ]
    },
