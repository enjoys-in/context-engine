{
  "name": "okteto",
  "description": "Okteto — develop applications directly in Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "context",
      "description": "Set Okteto context",
      "examples": [
        "okteto context",
        "okteto context use https://cloud.okteto.com",
        "okteto context use my-context"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to activate",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--token",
          "description": "Token to authenticate with",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy dev environment",
      "examples": [
        "okteto deploy",
        "okteto deploy --build",
        "okteto deploy --wait"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to deploy",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to deploy into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--build",
          "description": "Force a rebuild of the images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wait",
          "description": "Wait for the deployment to finish",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--var",
          "description": "Set a manifest variable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--timeout",
          "description": "How long to wait before giving up",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "up",
      "description": "Activate development container",
      "examples": [
        "okteto up",
        "okteto up --deploy",
        "okteto up my-service"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to develop in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--reset",
          "description": "Reset the development container",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pull",
          "description": "Pull the development image before starting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Set an environment variable in the container",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "down",
      "description": "Deactivate development container",
      "examples": [
        "okteto down",
        "okteto down -v"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Deactivate every development container",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--volumes",
          "description": "Remove the development volumes too",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "build",
      "description": "Build and push container images",
      "examples": [
        "okteto build -t my-registry/my-image:latest"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tag",
          "description": "Tag for the built image",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--no-cache",
          "description": "Build without the layer cache",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--build-arg",
          "description": "Set a build argument",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--platform",
          "description": "Target platform for the build",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "destroy",
      "description": "Destroy dev environment",
      "examples": [
        "okteto destroy",
        "okteto destroy --volumes"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--volumes",
          "description": "Remove persistent volumes too",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--force-destroy",
          "description": "Destroy even when resources are in a failed state",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "namespace",
      "description": "Manage namespaces",
      "examples": [
        "okteto namespace",
        "okteto namespace create my-ns",
        "okteto namespace delete my-ns",
        "okteto namespace list"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "pipeline",
      "description": "Manage pipelines",
      "examples": [
        "okteto pipeline deploy --branch main --repository https://github.com/org/repo",
        "okteto pipeline destroy"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--wait",
          "description": "Wait for the pipeline to finish",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timeout",
          "description": "How long to wait before giving up",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "preview",
      "description": "Manage preview environments",
      "examples": [
        "okteto preview deploy my-preview --branch feature",
        "okteto preview list",
        "okteto preview destroy my-preview"
      ],
      "options": [
        {
          "name": "--scope",
          "description": "Preview scope: personal or global",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--branch",
          "description": "Branch to deploy",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--wait",
          "description": "Wait for the preview to finish",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "exec",
      "description": "Exec a command in dev container",
      "examples": [
        "okteto exec -- bash"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run in the development container",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "logs",
      "description": "View container logs",
      "examples": [
        "okteto logs"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to read logs from",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Include logs from every development container",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timestamps",
          "description": "Prefix each line with a timestamp",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "status",
      "description": "Show status of dev environment",
      "examples": [
        "okteto status"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to inspect",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--info",
          "description": "Include synchronisation detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Diagnose issues",
      "examples": [
        "okteto doctor"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Okteto manifest to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--namespace",
          "description": "Namespace to inspect",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--context",
      "description": "Okteto context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--file",
      "short": "-f",
      "description": "Manifest file path",
      "type": "string",
      "takesValue": true,
      "shorthand": "-f"
    },
    {
      "name": "--loglevel",
      "short": "-l",
      "description": "Log level",
      "type": "string",
      "takesValue": true,
      "shorthand": "-l"
    }
  ],
  "examples": [
    "okteto context use https://cloud.okteto.com",
    "okteto up",
    "okteto deploy --build",
    "okteto down",
    "okteto destroy",
    "okteto namespace create my-ns",
    "okteto preview deploy my-preview --branch feature",
    "okteto doctor"
  ],
  "relatedCommands": [
    "kubectl",
    "skaffold",
    "tilt",
    "devspace"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Okteto CLI version",
        "command": "okteto version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "okteto"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "config",
        "description": "Okteto development manifest",
        "command": "cat okteto.yml 2>/dev/null || cat okteto.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "context",
        "description": "Active Okteto context",
        "command": "okteto context list 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "okteto"
      }
    ]
  }
}
