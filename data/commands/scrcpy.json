{
  "name": "scrcpy",
  "description": "Display and control an Android device from the desktop",
  "category": "mobile",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--serial",
      "description": "Device serial to target",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--max-size",
      "description": "Limit the longest dimension",
      "type": "integer",
      "takesValue": true,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--video-bit-rate",
      "description": "Video bitrate, e.g. 8M",
      "type": "string",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--max-fps",
      "description": "Cap the frame rate",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--record",
      "description": "Record the session to this file",
      "type": "file",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--no-audio",
      "description": "Disable audio forwarding",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--turn-screen-off",
      "description": "Turn the device screen off",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--stay-awake",
      "description": "Keep the device awake",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--fullscreen",
      "description": "Start fullscreen",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--always-on-top",
      "description": "Keep the window on top",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--tcpip",
      "description": "Connect over TCP/IP",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--select-usb",
      "description": "Use the USB device",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--no-control",
      "description": "Mirror without controlling",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--crop",
      "description": "Crop the mirrored area",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "scrcpy",
      "description": "Mirror the connected device"
    },
    {
      "command": "scrcpy -m 1024 -b 4M",
      "description": "Limit resolution and bitrate"
    },
    {
      "command": "scrcpy --tcpip=192.168.1.5:5555",
      "description": "Connect wirelessly"
    },
    {
      "command": "scrcpy -r demo.mp4",
      "description": "Record the session"
    }
  ],
  "relatedCommands": [
    "adb",
    "android-studio",
    "fastlane"
  ]
}
