{
  "name": "buildah",
  "description": "OCI container image builder",
  "category": "containers",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "from",
      "description": "Create a working container",
      "examples": [
        "buildah from ubuntu"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Name for the working container",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--pull",
          "description": "Pull policy for the base image",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress pull progress",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a command in container",
      "examples": [
        "buildah run ctr -- apt-get update"
      ],
      "options": [
        {
          "name": "--tty",
          "description": "Allocate a pseudo-terminal",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--volume",
          "description": "Bind mount a volume into the container",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--mount",
          "description": "Attach a filesystem mount",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--user",
          "description": "User to run as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--workingdir",
          "description": "Working directory inside the container",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Working container to run in",
          "required": true,
          "type": "string"
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "copy",
      "description": "Copy content into container",
      "examples": [
        "buildah copy ctr ./app /app"
      ],
      "options": [
        {
          "name": "--chown",
          "description": "Set ownership on the copied content",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--chmod",
          "description": "Set permissions on the copied content",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from",
          "description": "Copy from this image or container",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Working container to copy into",
          "required": true,
          "type": "string"
        },
        {
          "name": "source",
          "description": "Source path to copy",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "config",
      "description": "Set container config",
      "examples": [
        "buildah config --cmd /app/start ctr"
      ],
      "options": [
        {
          "name": "--entrypoint",
          "description": "Set the image entrypoint",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cmd",
          "description": "Set the default command",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env",
          "description": "Set an environment variable",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--label",
          "description": "Set an image label",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--port",
          "description": "Expose a port",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--workingdir",
          "description": "Set the working directory",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--user",
          "description": "Set the default user",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        }
      ]
    },
    {
      "name": "commit",
      "description": "Create image from container",
      "examples": [
        "buildah commit ctr myimage:latest"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Manifest format: oci or docker",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--squash",
          "description": "Squash the image into a single layer",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rm",
          "description": "Remove the working container afterwards",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "bud",
      "description": "Build using Dockerfile",
      "examples": [
        "buildah bud -t myimage ."
      ],
      "options": [
        {
          "name": "--file",
          "description": "Containerfile to build from",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tag",
          "description": "Tag for the built image",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--build-arg",
          "description": "Set a build argument",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-cache",
          "description": "Build without the layer cache",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Target platform for the build",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--layers",
          "description": "Cache intermediate layers",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "images",
      "description": "List images",
      "examples": [
        "buildah images"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include intermediate images",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print image IDs only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--format",
          "description": "Output format as a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "containers",
      "description": "List working containers",
      "examples": [
        "buildah containers"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include containers not created by buildah",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print container IDs only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove working container",
      "examples": [
        "buildah rm ctr"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Remove every working container",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to act on",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "rmi",
      "description": "Remove image",
      "examples": [
        "buildah rmi myimage"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Remove every image",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--force",
          "description": "Remove despite existing containers",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--prune",
          "description": "Remove dangling images only",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "push",
      "description": "Push image to registry",
      "examples": [
        "buildah push myimage docker://registry.example.com/myimage"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Manifest format to push",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--digestfile",
          "description": "Write the pushed digest to this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--root",
      "description": "Root directory for the local image store",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--runroot",
      "description": "Runtime state directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--storage-driver",
      "description": "Storage driver to use (overlay, vfs)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--log-level",
      "description": "Logging level (debug, info, warn, error)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "buildah from ubuntu",
    "buildah bud -t myimage .",
    "buildah commit ctr myimage",
    "buildah push myimage docker://registry/myimage"
  ],
  "relatedCommands": [
    "podman",
    "skopeo",
    "docker",
    "kaniko"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Buildah version",
        "command": "buildah version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "buildah"
      },
      {
        "name": "containers",
        "description": "Working containers buildah is holding",
        "command": "buildah containers 2>/dev/null",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "buildah"
      },
      {
        "name": "images",
        "description": "Images in buildah local storage",
        "command": "buildah images 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "buildah"
      },
      {
        "name": "containerfiles",
        "description": "Containerfiles in this project",
        "command": "ls Containerfile Dockerfile 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
