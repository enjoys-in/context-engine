{
  "name": "websocat",
  "description": "Netcat for WebSockets — connect, serve and pipe",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--text",
      "description": "Send and receive text frames",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--binary",
      "description": "Send and receive binary frames",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--listen",
      "description": "Listen instead of connecting",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--header",
      "description": "Add a request header",
      "type": "string",
      "takesValue": true,
      "short": "-H",
      "shorthand": "-H"
    },
    {
      "name": "--basic-auth",
      "description": "Credentials as user:password",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--origin",
      "description": "Origin header to send",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--protocol",
      "description": "Sec-WebSocket-Protocol to request",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--insecure",
      "description": "Do not verify TLS certificates",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--ping-interval",
      "description": "Seconds between pings",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--exit-on-eof",
      "description": "Close when stdin ends",
      "type": "boolean",
      "takesValue": false,
      "short": "-E",
      "shorthand": "-E"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--buffer-size",
      "description": "I/O buffer size",
      "type": "string",
      "takesValue": true,
      "short": "-B",
      "shorthand": "-B"
    }
  ],
  "examples": [
    {
      "command": "websocat ws://localhost:8080/ws",
      "description": "Connect to a WebSocket"
    },
    {
      "command": "websocat -s 8080",
      "description": "Serve a WebSocket echo endpoint"
    },
    {
      "command": "websocat -t ws://host/ws -H \"Authorization: Bearer t\"",
      "description": "Connect with a header"
    },
    {
      "command": "echo hello | websocat -E ws://host/ws",
      "description": "Send one message and exit"
    }
  ],
  "relatedCommands": [
    "nc",
    "curl",
    "socat",
    "grpcurl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "websocat version",
        "command": "websocat --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "websocat"
      },
      {
        "name": "listening",
        "description": "Ports listening on this host",
        "command": "ss -tlnp 2>/dev/null | head -20 || netstat -an 2>/dev/null | grep LISTEN | head -20",
        "parser": "table",
        "cacheFor": 30
      },
      {
        "name": "proxy",
        "description": "Proxy configuration in effect",
        "command": "echo \"http=${http_proxy:-unset} https=${https_proxy:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
