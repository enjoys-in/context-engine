{
  "name": "grpcurl",
  "description": "curl for gRPC servers",
  "category": "http-testing",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-plaintext",
      "description": "Use plaintext (no TLS)"
    },
    {
      "name": "-d",
      "description": "Request data (JSON)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-import-path",
      "description": "Proto import path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-proto",
      "description": "Proto file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-H",
      "description": "Custom header",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-v",
      "description": "Verbose output"
    },
    {
      "name": "-format",
      "description": "Output format (json, text)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-connect-timeout",
      "description": "Connection timeout",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-rpc-header",
      "description": "Additional RPC headers",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "grpcurl -plaintext localhost:50051 list",
    "grpcurl -plaintext localhost:50051 describe my.Service",
    "grpcurl -plaintext -d '{\"name\":\"world\"}' localhost:50051 helloworld.Greeter/SayHello",
    "grpcurl -plaintext localhost:50051 list my.Service"
  ],
  "relatedCommands": [
    "curl",
    "httpie",
    "protoc",
    "buf"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "grpcurl version",
        "command": "grpcurl --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "grpcurl"
      },
      {
        "name": "protos",
        "description": "Protocol buffer definitions in this project",
        "command": "find . -maxdepth 4 -name '*.proto' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "descriptors",
        "description": "Compiled descriptor sets available",
        "command": "find . -maxdepth 3 -name '*.protoset' -o -maxdepth 3 -name '*.pb' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
