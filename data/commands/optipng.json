{
  "name": "optipng",
  "description": "Lossless PNG optimiser",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-o",
      "description": "Optimisation level 0-7",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "-out",
      "description": "Write to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-dir",
      "description": "Write outputs into this directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "-strip",
      "description": "Strip metadata chunks, e.g. all",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-preserve",
      "description": "Preserve file attributes",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-fix",
      "description": "Repair broken PNG files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-backup",
      "description": "Keep a backup of the original",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "-simulate",
      "description": "Do not write anything",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "optipng -o7 image.png",
      "description": "Optimise at the highest level"
    },
    {
      "command": "optipng -o5 -strip all *.png",
      "description": "Optimise a directory and strip metadata"
    },
    {
      "command": "optipng -dir out/ *.png",
      "description": "Write results into a directory"
    }
  ],
  "relatedCommands": [
    "jpegoptim",
    "imagemagick",
    "gifsicle",
    "pngquant"
  ]
}
