{
  "name": "promtool",
  "description": "Prometheus rule, config and query tooling",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "check",
      "description": "Validate configuration, rules and metrics",
      "options": [
        {
          "name": "--syntax-only",
          "description": "Only check the syntax",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--lint",
          "description": "Lint checks to apply",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "query",
      "description": "Query a Prometheus server",
      "options": [
        {
          "name": "--time",
          "description": "Evaluate at this timestamp",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--start",
          "description": "Range start",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--end",
          "description": "Range end",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--step",
          "description": "Range step",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "subcommand",
          "description": "Query subcommand: instant, range, series or labels",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run unit tests for alerting rules",
      "args": [
        {
          "name": "files",
          "description": "Test files to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--junit",
          "description": "Write JUnit XML results here",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "debug",
      "description": "Fetch debug information from a server",
      "options": [
        {
          "name": "--server",
          "description": "Prometheus server to query",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "tsdb",
      "description": "Inspect and repair the time-series database",
      "options": [
        {
          "name": "--human-readable",
          "description": "Print sizes in human-readable units",
          "type": "boolean",
          "takesValue": false,
          "short": "-h",
          "shorthand": "-h"
        }
      ]
    },
    {
      "name": "promql",
      "description": "Format and inspect PromQL expressions",
      "options": [
        {
          "name": "--server",
          "description": "Prometheus server to query",
          "type": "url",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log.level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "promtool check config prometheus.yml",
      "description": "Validate the server configuration"
    },
    {
      "command": "promtool check rules alerts.yml",
      "description": "Validate alerting rules"
    },
    {
      "command": "promtool test rules tests.yml",
      "description": "Run rule unit tests"
    },
    {
      "command": "promtool query instant http://localhost:9090 \"up\"",
      "description": "Run an instant query"
    }
  ],
  "relatedCommands": [
    "prometheus",
    "amtool",
    "grafana-cli",
    "logcli"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "promtool version",
        "command": "promtool --version 2>&1 | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "promtool"
      },
      {
        "name": "config_check",
        "description": "Whether the Prometheus config validates",
        "command": "promtool check config /etc/prometheus/prometheus.yml 2>/dev/null || promtool check config prometheus.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "promtool"
      },
      {
        "name": "rule_files",
        "description": "Alerting and recording rule files present",
        "command": "find . /etc/prometheus -maxdepth 2 -name '*.rules' -o -maxdepth 2 -name '*rules*.yml' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
