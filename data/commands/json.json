  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "jq version",
        "command": "jq --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "jq"
      },
      {
        "name": "json_files",
        "description": "JSON files in this directory",
        "command": "find . -maxdepth 2 -name '*.json' -not -path './node_modules/*' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "jq_modules",
        "description": "jq library path",
        "command": "echo \"${JQ_LIBRARY_PATH:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
