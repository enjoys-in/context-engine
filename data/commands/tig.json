{
  "name": "tig",
  "description": "Text-mode interface for git",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "log",
      "description": "Browse the commit log",
      "options": [
        {
          "name": "--all",
          "description": "Include every reference",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--follow",
          "description": "Follow renames",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-merges",
          "description": "Skip merge commits",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "show",
      "description": "Browse a single commit",
      "args": [
        {
          "name": "commit",
          "description": "Commit to show",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include every reference",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--follow",
          "description": "Follow renames",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-merges",
          "description": "Skip merge commits",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "blame",
      "description": "Annotate a file with its last change per line",
      "args": [
        {
          "name": "file",
          "description": "File to blame",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--follow",
          "description": "Follow renames",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "status",
      "description": "Browse the working tree status",
      "options": []
    },
    {
      "name": "stash",
      "description": "Browse the stash",
      "options": []
    },
    {
      "name": "refs",
      "description": "Browse branches and tags",
      "options": []
    },
    {
      "name": "grep",
      "description": "Search the working tree",
      "args": [
        {
          "name": "pattern",
          "description": "Pattern to search for",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--ignore-case",
          "description": "Case-insensitive matching",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--all",
      "description": "Include every reference",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--after",
      "description": "Only commits after this date",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--author",
      "description": "Only commits by this author",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--grep",
      "description": "Only commits whose message matches",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "tig",
      "description": "Browse the commit log"
    },
    {
      "command": "tig status",
      "description": "Browse the working tree"
    },
    {
      "command": "tig blame src/main.c",
      "description": "Annotate a file"
    },
    {
      "command": "tig log --author=alice",
      "description": "Filter the log by author"
    }
  ],
  "relatedCommands": [
    "git",
    "lazygit",
    "gitui",
    "delta"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tig version",
        "command": "tig --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tig"
      },
      {
        "name": "repo",
        "description": "Git repository tig would browse",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "git"
      },
      {
        "name": "branch",
        "description": "Active git branch",
        "command": "git rev-parse --abbrev-ref HEAD 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "git"
      },
      {
        "name": "config",
        "description": "tig configuration",
        "command": "cat ~/.tigrc 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
