{
  "name": "buck",
  "description": "Fast, multi-language build system from Meta",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build one or more targets",
      "options": [
        {
          "name": "--num-threads",
          "description": "Worker threads",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--show-output",
          "description": "Print the output paths",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--out",
          "description": "Copy the output here",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--keep-going",
          "description": "Keep building after failures",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Build targets",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run a target",
      "args": [
        {
          "name": "target",
          "description": "Target to run",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "test",
      "description": "Build and run tests",
      "options": [
        {
          "name": "--all",
          "description": "Run every test",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--include",
          "description": "Only tests with these labels",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Test targets",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "query",
      "description": "Query the target graph",
      "options": [
        {
          "name": "--output-attribute",
          "description": "Attributes to print",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "expression",
          "description": "Query expression",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "targets",
      "description": "List the targets in a package",
      "options": [
        {
          "name": "--show-output",
          "description": "Print the output paths",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "pattern",
          "description": "Target pattern",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "clean",
      "description": "Remove the build outputs"
    },
    {
      "name": "install",
      "description": "Build and install onto a device",
      "options": [
        {
          "name": "--run",
          "description": "Launch after installing",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Target to install",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "audit",
      "description": "Inspect build configuration and rules"
    },
    {
      "name": "kill",
      "description": "Stop the buck daemon"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Verbosity level",
      "type": "integer",
      "takesValue": true,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--config",
      "description": "Override a config value, section.key=value",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--no-cache",
      "description": "Ignore the build cache",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "buck build //app:bin",
      "description": "Build a target"
    },
    {
      "command": "buck test //... --all",
      "description": "Run every test"
    },
    {
      "command": "buck query \"deps(//app:bin)\"",
      "description": "Inspect a dependency graph"
    },
    {
      "command": "buck run //tools:gen -- --flag",
      "description": "Build and run with arguments"
    }
  ],
  "relatedCommands": [
    "bazel",
    "pants",
    "ninja",
    "gradle"
  ]
}
