{
  "name": "volta",
  "description": "JavaScript tool manager — fast, reliable Node.js management",
  "category": "version-manager",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a tool",
      "examples": [
        "volta install node@20",
        "volta install npm",
        "volta install yarn"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "tool",
          "description": "Tool and optional version, as node@20",
          "required": true,
          "type": "package"
        }
      ]
    },
    {
      "name": "pin",
      "description": "Pin tool versions in package.json",
      "examples": [
        "volta pin node@20",
        "volta pin npm@10"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "tool",
          "description": "Tool and version to pin for this project",
          "required": true,
          "type": "package"
        }
      ]
    },
    {
      "name": "list",
      "description": "List installed tools",
      "examples": [
        "volta list",
        "volta list node"
      ],
      "options": [
        {
          "name": "--current",
          "description": "Only show the active tools",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--default",
          "description": "Only show the default tools",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--format",
          "description": "Output format: human or plain",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "tool",
          "description": "Tool whose versions to list",
          "required": false,
          "type": "package"
        }
      ]
    },
    {
      "name": "fetch",
      "description": "Fetch a tool without installing",
      "examples": [
        "volta fetch node@20"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "tool",
          "description": "Tool and version to download, as node@20",
          "required": true,
          "type": "package"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a tool with specific version",
      "examples": [
        "volta run node@18 -- script.js"
      ],
      "options": [
        {
          "name": "--node",
          "description": "Node version to run with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--npm",
          "description": "npm version to run with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env",
          "description": "Set an environment variable",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run under the pinned toolchain",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "which",
      "description": "Show path of installed tool",
      "examples": [
        "volta which node"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command whose resolved binary to print",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "description": "Verbose output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output"
    }
  ],
  "examples": [
    "volta install node@20",
    "volta pin node@20",
    "volta install yarn",
    "volta list",
    "volta which node"
  ],
  "relatedCommands": [
    "nvm",
    "fnm",
    "node",
    "npm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Volta version",
        "command": "volta --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "volta"
      },
      {
        "name": "installed",
        "description": "Tools Volta manages",
        "command": "volta list 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "volta"
      },
      {
        "name": "pinned",
        "description": "Toolchain pinned in this project",
        "command": "grep -A10 '\"volta\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "home",
        "description": "Volta installation directory",
        "command": "echo \"${VOLTA_HOME:-$HOME/.volta}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
