{
  "name": "env",
  "description": "Run a program in a modified environment",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-i",
      "description": "Start with an empty environment"
    },
    {
      "name": "-u",
      "description": "Remove variable from environment",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-0",
      "description": "End each output line with NUL"
    }
  ],
  "examples": [
    "env",
    "env | grep PATH",
    "env VAR=value command",
    "env -i /bin/sh",
    "env -u DISPLAY command",
    "env NODE_ENV=production node app.js"
  ],
  "relatedCommands": [
    "export",
    "printenv",
    "set"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "env version",
        "command": "env --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "env"
      },
      {
        "name": "variables",
        "description": "Environment variables set in this shell",
        "command": "env 2>/dev/null | sort | head -40",
        "parser": "keyvalue",
        "cacheFor": 30
      },
      {
        "name": "var_count",
        "description": "Environment variables defined",
        "command": "env 2>/dev/null | wc -l",
        "parser": "text",
        "cacheFor": 30
      }
    ]
  }
}
