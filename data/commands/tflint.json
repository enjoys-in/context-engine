{
  "name": "tflint",
  "description": "Terraform linter focused on possible errors and best practices",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize TFLint config and plugins",
      "examples": [
        "tflint --init"
      ],
      "options": [
        {
          "name": "--config",
          "description": "TFLint configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--chdir",
          "description": "Directory to run in",
          "type": "directory",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--init",
      "description": "Install plugins"
    },
    {
      "name": "--recursive",
      "description": "Run recursively on child modules"
    },
    {
      "name": "--config",
      "description": "Config file path",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--format",
      "short": "-f",
      "description": "Output format (default, json, checkstyle, junit, compact, sarif)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-f"
    },
    {
      "name": "--module",
      "description": "Inspect modules"
    },
    {
      "name": "--var-file",
      "description": "Terraform var file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--minimum-failure-severity",
      "description": "Minimum severity for failure (error, warning, notice)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--filter",
      "description": "Filter by rule name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--force",
      "description": "Return 0 even with errors"
    }
  ],
  "examples": [
    "tflint",
    "tflint --init",
    "tflint --recursive",
    "tflint -f json",
    "tflint --minimum-failure-severity=error",
    "tflint --var-file=vars.tfvars"
  ],
  "relatedCommands": [
    "terraform",
    "checkov",
    "hadolint",
    "semgrep"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "TFLint version and plugins",
        "command": "tflint --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tflint"
      },
      {
        "name": "config",
        "description": "TFLint rule configuration",
        "command": "cat .tflint.hcl 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "terraform_files",
        "description": "Terraform files TFLint can check",
        "command": "ls *.tf 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "terraform_version",
        "description": "Terraform version in this project",
        "command": "terraform version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
