{
  "name": "dotnet",
  "description": ".NET CLI — build, run, publish .NET applications",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create new project",
      "examples": [
        "dotnet new console",
        "dotnet new webapi -n MyApi",
        "dotnet new list"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Directory to place the output in",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--name",
          "description": "Name for the output being created",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--framework",
          "description": "Target framework",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--language",
          "description": "Template language: C#, F# or VB",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Overwrite existing files",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build project",
      "examples": [
        "dotnet build",
        "dotnet build -c Release"
      ],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--framework",
          "description": "Target framework",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--runtime",
          "description": "Target runtime identifier",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--no-restore",
          "description": "Skip the implicit restore",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output",
          "description": "Directory to place the build output in",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--verbosity",
          "description": "MSBuild verbosity level",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run project",
      "examples": [
        "dotnet run",
        "dotnet run --project src/MyApp"
      ],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--framework",
          "description": "Target framework",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--project",
          "description": "Project file to run",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--no-build",
          "description": "Run without building first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--launch-profile",
          "description": "Launch profile to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "dotnet test"
      ],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--filter",
          "description": "Only run tests matching this expression",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--logger",
          "description": "Test logger to use",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--collect",
          "description": "Data collector to enable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-build",
          "description": "Test without building first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--results-directory",
          "description": "Directory for the test results",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish for deployment",
      "examples": [
        "dotnet publish -c Release -o ./out"
      ],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--framework",
          "description": "Target framework",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--runtime",
          "description": "Target runtime identifier",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--output",
          "description": "Directory to publish into",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--self-contained",
          "description": "Publish the runtime alongside the app",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-build",
          "description": "Publish without building first",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "add",
      "description": "Add package/reference",
      "examples": [
        "dotnet add package Newtonsoft.Json",
        "dotnet add reference ../Lib/Lib.csproj"
      ],
      "options": [
        {
          "name": "--version",
          "description": "Package version to add",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--framework",
          "description": "Target framework for the reference",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--source",
          "description": "Package source to restore from",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--no-restore",
          "description": "Skip the implicit restore",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package or project reference to add",
          "required": true,
          "type": "package"
        }
      ]
    },
    {
      "name": "restore",
      "description": "Restore dependencies",
      "examples": [
        "dotnet restore"
      ],
      "options": [
        {
          "name": "--source",
          "description": "Package source to restore from",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--runtime",
          "description": "Target runtime identifier",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--force",
          "description": "Re-resolve every dependency",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-cache",
          "description": "Ignore the local package cache",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbosity",
          "description": "MSBuild verbosity level",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean build output",
      "examples": [
        "dotnet clean"
      ],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration to clean",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--framework",
          "description": "Target framework to clean",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--output",
          "description": "Output directory to clean",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--verbosity",
          "description": "MSBuild verbosity level",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "ef",
      "description": "Entity Framework commands",
      "examples": [
        "dotnet ef migrations add Init",
        "dotnet ef database update"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Project containing the DbContext",
          "type": "file",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--startup-project",
          "description": "Startup project to use",
          "type": "file",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--context",
          "description": "DbContext to act on",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Show verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "tool",
      "description": "Manage .NET tools",
      "examples": [
        "dotnet tool install -g dotnet-ef",
        "dotnet tool list -g"
      ],
      "options": [
        {
          "name": "--global",
          "description": "Act on globally installed tools",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--tool-path",
          "description": "Directory the tool is installed in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Tool version to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--add-source",
          "description": "Additional package source",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "watch",
      "description": "Watch for changes and restart",
      "examples": [
        "dotnet watch run"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Project to watch",
          "type": "file",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--quiet",
          "description": "Suppress watcher output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-hot-reload",
          "description": "Disable hot reload",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Show verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Configuration (Debug, Release)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-v",
      "description": "Verbosity (q, m, n, d, diag)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-restore",
      "description": "Skip restore"
    }
  ],
  "examples": [
    "dotnet new webapi -n MyApi",
    "dotnet build -c Release",
    "dotnet run",
    "dotnet test",
    "dotnet publish -c Release",
    "dotnet watch run"
  ],
  "relatedCommands": [
    "msbuild",
    "nuget",
    "csharp"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": ".NET SDK version",
        "command": "dotnet --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "sdks",
        "description": "Installed .NET SDKs",
        "command": "dotnet --list-sdks 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "runtimes",
        "description": "Installed .NET runtimes",
        "command": "dotnet --list-runtimes 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "projects",
        "description": "Projects and solutions here",
        "command": "find . -maxdepth 3 -name '*.csproj' -o -maxdepth 3 -name '*.fsproj' -o -maxdepth 3 -name '*.sln' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
