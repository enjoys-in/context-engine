{
  "name": "checkov",
  "description": "Static analysis tool for infrastructure as code security scanning",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Directory to scan",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "File to scan",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--framework",
      "description": "IaC framework (terraform, cloudformation, kubernetes, etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--check",
      "description": "Run specific check IDs",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--skip-check",
      "description": "Skip specific check IDs",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output format (cli, json, sarif, csv)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--compact",
      "description": "Show only failed checks"
    },
    {
      "name": "--soft-fail",
      "description": "Always return exit code 0"
    },
    {
      "name": "--download-external-modules",
      "description": "Download external Terraform modules"
    }
  ],
  "examples": [
    "checkov -d .",
    "checkov -f main.tf",
    "checkov -d . --framework terraform",
    "checkov -d . -o json",
    "checkov -d . --compact",
    "checkov -d k8s/ --framework kubernetes"
  ],
  "relatedCommands": [
    "terraform",
    "tflint",
    "trivy",
    "semgrep"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Checkov version",
        "command": "checkov --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "checkov"
      },
      {
        "name": "config",
        "description": "Checkov configuration",
        "command": "cat .checkov.yaml 2>/dev/null || cat .checkov.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "frameworks",
        "description": "Infrastructure files Checkov can scan",
        "command": "ls *.tf Dockerfile *.yaml docker-compose.yml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "skipped",
        "description": "Checks skipped inline in this project",
        "command": "grep -rho 'checkov:skip=[A-Z_0-9]*' . 2>/dev/null | sort -u | head -15",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
