{
  "name": "fluent-bit",
  "description": "Lightweight log and metrics processor and forwarder",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--input",
      "description": "Input plugin to enable",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--output",
      "description": "Output plugin to enable",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--filter",
      "description": "Filter plugin to enable",
      "type": "string",
      "takesValue": true,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--match",
      "description": "Tag pattern for the plugin",
      "type": "string",
      "takesValue": true,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--tag",
      "description": "Tag to apply to records",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--flush",
      "description": "Seconds between flushes",
      "type": "integer",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--daemon",
      "description": "Run in the background",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--log_level",
      "description": "Logging level (error, warn, info, debug, trace)",
      "type": "string",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--dry-run",
      "description": "Validate the configuration and exit",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--plugin",
      "description": "Load an external plugin",
      "type": "file",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    }
  ],
  "examples": [
    {
      "command": "fluent-bit -c fluent-bit.conf",
      "description": "Run with a configuration file"
    },
    {
      "command": "fluent-bit -i cpu -o stdout",
      "description": "Stream CPU metrics to stdout"
    },
    {
      "command": "fluent-bit -c fluent-bit.conf --dry-run",
      "description": "Validate the configuration"
    },
    {
      "command": "fluent-bit -i tail -p path=/var/log/app.log -o es -p host=localhost",
      "description": "Tail a file into Elasticsearch"
    }
  ],
  "relatedCommands": [
    "vector",
    "telegraf",
    "otelcol",
    "logcli"
  ]
}
