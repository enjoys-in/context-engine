  "subcommands": [
    {
      "name": "npx create-react-app",
      "description": "Create a new React application using Create React App scaffolding tool",
      "options": [
        {
          "name": "--template",
          "description": "Project template to scaffold from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--typescript",
          "description": "Scaffold with TypeScript",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--use-npm",
          "description": "Force npm rather than yarn",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--use-pnp",
          "description": "Enable Yarn Plug'n'Play",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npx create-react-app my-app [--template typescript]",
        "npx create-react-app my-app",
        "npx create-react-app my-app --template typescript",
        "npx create-react-app my-app --template cra-template-pwa"
      ]
    },
    {
      "name": "react-scripts start",
      "description": "Starts the development server with hot module replacement on port 3000",
      "options": [
        {
          "name": "--host",
          "description": "Host the dev server binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--https",
          "description": "Serve over HTTPS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--open",
          "description": "Open a browser on start",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "react-scripts start",
        "npm start",
        "react-scripts start",
        "PORT=4000 react-scripts start",
        "HTTPS=true react-scripts start"
      ]
    },
    {
      "name": "react-scripts build",
      "description": "Builds the app for production to the build folder. Bundles React in production mode and optimizes for best performance",
      "options": [
        {
          "name": "--profile",
          "description": "Enable React profiling in the production build",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--stats",
          "description": "Emit a webpack bundle stats file",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "react-scripts build",
        "npm run build",
        "react-scripts build",
        "GENERATE_SOURCEMAP=false react-scripts build",
        "BUILD_PATH=dist react-scripts build"
      ]
    },
    {
      "name": "react-scripts test",
      "description": "Launches the test runner in interactive watch mode using Jest",
      "options": [
        {
          "name": "--watch",
          "description": "Re-run tests on change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watchAll",
          "description": "Re-run every test on change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--coverage",
          "description": "Collect and report coverage",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ci",
          "description": "Run in CI mode without watch",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Test environment: jsdom or node",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--updateSnapshot",
          "description": "Rewrite outdated snapshots",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
