{
  "name": "exa",
  "description": "Modern replacement for ls (superseded by eza)",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--long",
      "description": "Show extended details",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--all",
      "description": "Include hidden entries",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--tree",
      "description": "Display as a tree",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--level",
      "description": "Depth limit for the tree",
      "type": "integer",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--git",
      "description": "Show git status per file",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--header",
      "description": "Add a header row",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--sort",
      "description": "Sort field (name, size, modified)",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--reverse",
      "description": "Reverse the sort order",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--grid",
      "description": "Display in a grid",
      "type": "boolean",
      "takesValue": false,
      "short": "-G",
      "shorthand": "-G"
    }
  ],
  "examples": [
    {
      "command": "exa -la --git",
      "description": "Long listing with git status"
    },
    {
      "command": "exa -T -L 2",
      "description": "Two-level tree"
    },
    {
      "command": "exa -l --sort modified",
      "description": "Most recently changed last"
    }
  ],
  "relatedCommands": [
    "eza",
    "ls",
    "tree"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "exa version",
        "command": "exa --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "exa"
      },
      {
        "name": "cwd_entries",
        "description": "Entries in the current directory",
        "command": "ls -A 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "git_repo",
        "description": "Git repository for exa's git columns",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
