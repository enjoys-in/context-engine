{
  "name": "ping",
  "description": "Send ICMP ECHO_REQUEST to network hosts",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Stop after N packets",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Interval between packets (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-W",
      "description": "Timeout for each reply (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Packet size in bytes",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-4",
      "description": "IPv4 only"
    },
    {
      "name": "-6",
      "description": "IPv6 only"
    },
    {
      "name": "-q",
      "description": "Quiet output (summary only)"
    },
    {
      "name": "-f",
      "description": "Flood ping (as fast as possible)"
    },
    {
      "name": "-t",
      "description": "Set TTL",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "ping google.com",
    "ping -c 4 8.8.8.8",
    "ping -c 3 -i 0.5 localhost",
    "ping -W 2 -c 5 server.local",
    "ping6 ::1"
  ],
  "relatedCommands": [
    "traceroute",
    "mtr",
    "nmap",
    "dig"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ping version",
        "command": "ping -V 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ping"
      },
      {
        "name": "default_gateway",
        "description": "Default gateway to test against",
        "command": "ip route 2>/dev/null | grep default || netstat -rn 2>/dev/null | grep default",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "resolvers",
        "description": "DNS resolvers configured",
        "command": "cat /etc/resolv.conf 2>/dev/null | grep nameserver",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
