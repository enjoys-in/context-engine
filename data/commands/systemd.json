{
  "language": "systemd",
  "name": "systemctl",
  "description": "systemd command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    },
    {
      "name": "--env",
      "description": "Set environment (development, staging, production)",
      "valueHint": "name"
    },
    {
      "name": "--timeout",
      "description": "Set operation timeout in seconds",
      "valueHint": "seconds"
    }
  ],
  "subcommands": [
    {
      "name": "start service",
      "description": "Start service",
      "args": [],
      "options": [
        {
          "name": "--no-block",
          "description": "Return without waiting for completion",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "Operate on the user manager",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "systemctl start service"
      ]
    },
    {
      "name": "stop service",
      "description": "Stop service",
      "args": [],
      "options": [
        {
          "name": "--no-block",
          "description": "Return without waiting for completion",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "Operate on the user manager",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "systemctl stop service"
      ]
    },
    {
      "name": "restart service",
      "description": "Restart service",
      "args": [],
      "options": [
        {
          "name": "--no-block",
          "description": "Return without waiting for completion",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "Operate on the user manager",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "systemctl restart service"
      ]
    },
    {
      "name": "status service",
      "description": "Check status",
      "args": [],
      "options": [
        {
          "name": "--no-pager",
          "description": "Do not pipe output into a pager",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--lines",
          "description": "Number of journal lines to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--full",
          "description": "Do not truncate long fields",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        }
      ],
      "examples": [
        "systemctl status service"
      ]
    },
    {
      "name": "enable service",
      "description": "Enable at boot",
      "args": [],
      "options": [
        {
          "name": "--now",
          "description": "Also start the unit immediately",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "Operate on the user manager",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "systemctl enable service"
      ]
    },
    {
      "name": "daemon-reload",
      "description": "Reload configs",
      "args": [],
      "options": [
        {
          "name": "--user",
          "description": "Operate on the user manager",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "systemctl daemon-reload"
      ]
    }
  ],
  "examples": [
    {
      "command": "systemctl start service.service",
      "description": "Start a systemd service"
    },
    {
      "command": "systemctl enable service.service",
      "description": "Enable service at boot"
    },
    {
      "command": "journalctl -u service.service",
      "description": "View service logs"
    },
    {
      "command": "systemd-analyze",
      "description": "Analyze system boot performance"
    }
  ],
  "relatedCommands": [
    "systemctl",
    "journalctl",
    "loginctl",
    "service"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "systemd version",
        "command": "systemctl --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "systemctl"
      },
      {
        "name": "failed_units",
        "description": "Units currently in a failed state",
        "command": "systemctl list-units --failed --no-legend --no-pager 2>/dev/null",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "systemctl"
      },
      {
        "name": "user_units",
        "description": "User units on this machine",
        "command": "systemctl --user list-unit-files --no-legend --no-pager 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "systemctl"
      },
      {
        "name": "local_units",
        "description": "Unit files defined locally",
        "command": "ls /etc/systemd/system 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
