{
  "name": "entr",
  "description": "Run arbitrary commands when files change",
  "category": "utilities",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Clear the screen before invocation"
    },
    {
      "name": "-r",
      "description": "Restart persistent child processes"
    },
    {
      "name": "-s",
      "description": "Execute command with the shell"
    },
    {
      "name": "-d",
      "description": "Track directory for new files"
    },
    {
      "name": "-p",
      "description": "Postpone first execution until change"
    }
  ],
  "examples": [
    "ls *.py | entr python main.py",
    "find . -name '*.rs' | entr -c cargo build",
    "ls src/**/*.ts | entr -r npm start",
    "echo main.go | entr -r go run main.go",
    "find . -name '*.test.js' | entr -c npm test"
  ],
  "relatedCommands": [
    "watch",
    "inotifywait",
    "fswatch",
    "nodemon"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "entr version",
        "command": "entr 2>&1 | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "entr"
      },
      {
        "name": "repo",
        "description": "Git repository whose files entr can watch",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "tracked_files",
        "description": "Files entr could watch",
        "command": "git ls-files 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
