{
  "name": "code",
  "description": "Visual Studio Code command line interface",
  "category": "editor",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--new-window",
      "description": "Open in a new window",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--reuse-window",
      "description": "Reuse the current window",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--goto",
      "description": "Open at file:line:column",
      "type": "string",
      "takesValue": true,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--diff",
      "description": "Compare two files",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--merge",
      "description": "Open a three-way merge",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--wait",
      "description": "Wait for the window to close before returning",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--add",
      "description": "Add a folder to the last window",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--install-extension",
      "description": "Install an extension by id or vsix",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--uninstall-extension",
      "description": "Remove an extension by id",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--list-extensions",
      "description": "List the installed extensions",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--disable-extensions",
      "description": "Start with extensions disabled",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--extensions-dir",
      "description": "Directory to load extensions from",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--user-data-dir",
      "description": "Directory for user data",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print verbose output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--status",
      "description": "Print process usage and diagnostics",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "code .",
      "description": "Open the current directory"
    },
    {
      "command": "code -g src/main.ts:42",
      "description": "Open a file at a line"
    },
    {
      "command": "code -d old.txt new.txt",
      "description": "Diff two files"
    },
    {
      "command": "code --install-extension dbaeumer.vscode-eslint",
      "description": "Install an extension"
    },
    {
      "command": "code --list-extensions",
      "description": "List installed extensions"
    }
  ],
  "relatedCommands": [
    "vim",
    "nvim",
    "subl",
    "git"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "VS Code version",
        "command": "code --version 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "code"
      },
      {
        "name": "extensions",
        "description": "Extensions installed in VS Code",
        "command": "code --list-extensions 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "code"
      },
      {
        "name": "workspace_settings",
        "description": "Workspace settings for this project",
        "command": "cat .vscode/settings.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "recommendations",
        "description": "Extensions this workspace recommends",
        "command": "cat .vscode/extensions.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300
      }
    ]
  }
}
