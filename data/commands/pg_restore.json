{
  "name": "pg_restore",
  "description": "Restore a PostgreSQL database from a pg_dump archive",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--host",
      "shorthand": "-h",
      "description": "Database server host",
      "takesValue": true,
      "short": "-h"
    },
    {
      "name": "--port",
      "shorthand": "-p",
      "description": "Database server port",
      "takesValue": true,
      "short": "-p"
    },
    {
      "name": "--username",
      "shorthand": "-U",
      "description": "Database user",
      "takesValue": true,
      "short": "-U"
    },
    {
      "name": "--dbname",
      "shorthand": "-d",
      "description": "Target database",
      "takesValue": true,
      "short": "-d"
    },
    {
      "name": "--password",
      "shorthand": "-W",
      "description": "Prompt for password",
      "short": "-W"
    },
    {
      "name": "--no-password",
      "shorthand": "-w",
      "description": "Never prompt for password",
      "short": "-w"
    },
    {
      "name": "--format",
      "shorthand": "-F",
      "description": "Archive format (c=custom, d=directory, t=tar)",
      "takesValue": true,
      "short": "-F"
    },
    {
      "name": "--clean",
      "shorthand": "-c",
      "description": "Drop objects before creating",
      "short": "-c"
    },
    {
      "name": "--create",
      "shorthand": "-C",
      "description": "Create the database",
      "short": "-C"
    },
    {
      "name": "--data-only",
      "shorthand": "-a",
      "description": "Restore only data",
      "short": "-a"
    },
    {
      "name": "--schema-only",
      "shorthand": "-s",
      "description": "Restore only schema",
      "short": "-s"
    },
    {
      "name": "--table",
      "shorthand": "-t",
      "description": "Restore specific table",
      "takesValue": true,
      "short": "-t"
    },
    {
      "name": "--schema",
      "shorthand": "-n",
      "description": "Restore specific schema",
      "takesValue": true,
      "short": "-n"
    },
    {
      "name": "--index",
      "shorthand": "-I",
      "description": "Restore specific index",
      "takesValue": true,
      "short": "-I"
    },
    {
      "name": "--function",
      "shorthand": "-P",
      "description": "Restore specific function",
      "takesValue": true,
      "short": "-P"
    },
    {
      "name": "--trigger",
      "shorthand": "-T",
      "description": "Restore specific trigger",
      "takesValue": true,
      "short": "-T"
    },
    {
      "name": "--no-owner",
      "shorthand": "-O",
      "description": "Skip ownership",
      "short": "-O"
    },
    {
      "name": "--no-privileges",
      "shorthand": "-x",
      "description": "Skip privileges",
      "short": "-x"
    },
    {
      "name": "--no-tablespaces",
      "description": "Skip tablespace assignments"
    },
    {
      "name": "--single-transaction",
      "description": "Restore as single transaction"
    },
    {
      "name": "--jobs",
      "shorthand": "-j",
      "description": "Parallel restore jobs",
      "takesValue": true,
      "short": "-j"
    },
    {
      "name": "--list",
      "shorthand": "-l",
      "description": "List archive contents",
      "short": "-l"
    },
    {
      "name": "--use-list",
      "shorthand": "-L",
      "description": "Restore using TOC list file",
      "takesValue": true,
      "short": "-L"
    },
    {
      "name": "--if-exists",
      "description": "Use IF EXISTS with DROP"
    },
    {
      "name": "--exit-on-error",
      "shorthand": "-e",
      "description": "Exit on error",
      "short": "-e"
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose mode",
      "short": "-v"
    },
    {
      "name": "--section",
      "description": "Section to restore (pre-data, data, post-data)",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "pg_restore -d mydb backup.dump",
      "description": "Restore custom format dump"
    },
    {
      "command": "pg_restore -Fd -j 4 -d mydb backup_dir/",
      "description": "Parallel directory restore"
    },
    {
      "command": "pg_restore -l backup.dump",
      "description": "List archive contents"
    },
    {
      "command": "pg_restore -c --if-exists -d mydb backup.dump",
      "description": "Clean restore"
    },
    {
      "command": "pg_restore -t users -d mydb backup.dump",
      "description": "Restore single table"
    },
    {
      "command": "pg_restore -s -d mydb backup.dump",
      "description": "Restore schema only"
    },
    {
      "command": "pg_restore --single-transaction -d mydb backup.dump",
      "description": "Transactional restore"
    }
  ],
  "relatedCommands": [
    "pg_dump",
    "psql"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "dump_files",
        "description": "Available dump files",
        "command": "ls -la *.dump *.sql *.tar *.backup 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 15
      },
      {
        "name": "databases",
        "description": "Available databases",
        "command": "psql -l -t 2>/dev/null | awk -F'|' '{print $1}' | sed 's/^ *//' | grep -v '^$' | head -20",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "psql"
      },
      {
        "name": "archive_contents",
        "description": "Contents of most recent dump",
        "command": "pg_restore -l $(ls -t *.dump 2>/dev/null | head -1) 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "pg_restore"
      }
    ]
  }
}
