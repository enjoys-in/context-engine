{
  "name": "rancher",
  "description": "Rancher CLI for managing Rancher and RKE clusters",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Login to Rancher server",
      "examples": [
        "rancher login https://rancher.example.com --token token-xxxxx",
        "rancher login https://rancher.example.com --token token-xxxxx --context c-xxxxx:p-xxxxx"
      ],
      "options": [
        {
          "name": "--token",
          "description": "Bearer token to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--name",
          "description": "Name for the stored server",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--skip-verify",
          "description": "Skip TLS certificate verification",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--context",
          "description": "Cluster or project to select",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "context",
      "description": "Switch project context",
      "examples": [
        "rancher context switch",
        "rancher context current"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "cluster",
      "description": "Manage clusters",
      "examples": [
        "rancher cluster ls",
        "rancher cluster create --name my-cluster",
        "rancher cluster delete my-cluster",
        "rancher cluster kubeconfig my-cluster"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "node",
      "description": "Manage nodes",
      "examples": [
        "rancher node ls",
        "rancher node delete node-id"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "project",
      "description": "Manage projects",
      "examples": [
        "rancher project ls",
        "rancher project create --name my-project --cluster cluster-id"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "app",
      "description": "Manage catalog apps",
      "examples": [
        "rancher app ls",
        "rancher app install cattle-global-data/chart-name myapp",
        "rancher app delete myapp"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "namespace",
      "description": "Manage namespaces",
      "examples": [
        "rancher namespace ls",
        "rancher namespace create my-ns"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "kubectl",
      "description": "Run kubectl commands",
      "examples": [
        "rancher kubectl get pods",
        "rancher kubectl get nodes",
        "rancher kubectl apply -f manifest.yaml"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Cluster context to run against",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ssh",
      "description": "SSH into a node",
      "examples": [
        "rancher ssh node-id"
      ],
      "options": [
        {
          "name": "--user",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--key",
          "description": "Private key to authenticate with",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect a resource",
      "examples": [
        "rancher inspect cluster-id"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--type",
          "description": "Resource type to inspect",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "resource",
          "description": "Resource to inspect",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "wait",
      "description": "Wait for resource state",
      "examples": [
        "rancher wait cluster-id"
      ],
      "options": [
        {
          "name": "--timeout",
          "description": "How long to wait before giving up",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--interval",
          "description": "How often to poll",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "token",
      "description": "Manage API tokens",
      "examples": [
        "rancher token ls",
        "rancher token delete token-id"
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: json, yaml or a Go template",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Print IDs only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--description",
          "description": "Description for the token",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--debug",
      "description": "Enable debug output"
    },
    {
      "name": "--config",
      "description": "Config file path",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "rancher login https://rancher.example.com --token token-xxxxx",
    "rancher cluster ls",
    "rancher context switch",
    "rancher kubectl get pods",
    "rancher app ls",
    "rancher ssh node-id",
    "rancher cluster kubeconfig my-cluster"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "k3s",
    "rke"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Rancher CLI version",
        "command": "rancher --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "rancher"
      },
      {
        "name": "context",
        "description": "Active Rancher cluster and project",
        "command": "rancher context current 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "rancher"
      },
      {
        "name": "clusters",
        "description": "Clusters Rancher manages",
        "command": "rancher clusters ls --format '{{.Cluster.Name}}' 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "rancher"
      }
    ]
  }
}
