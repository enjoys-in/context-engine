{
  "language": "pla",
  "name": "pla",
  "description": "PLA — Programmable Logic Array tools and synthesis",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Output file path"
    },
    {
      "name": "--method",
      "description": "Minimization method (espresso, exact, heuristic)"
    },
    {
      "name": "--verbose",
      "description": "Show detailed processing information"
    },
    {
      "name": "-f",
      "description": "Input format (pla, blif, truth-table)"
    },
    {
      "name": "-t",
      "description": "Output target format"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "minimize",
      "description": "Minimize PLA logic using Espresso algorithm",
      "args": [
        {
          "name": "input.pla",
          "description": "PLA truth table to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Write the minimized result to this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--method",
          "description": "Minimization method (espresso, exact, qm)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "simulate",
      "description": "Simulate PLA truth table with input vectors",
      "args": [
        {
          "name": "input.pla",
          "description": "PLA truth table to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--inputs",
          "description": "Input vector to simulate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Print detailed progress",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "convert",
      "description": "Convert between PLA, BLIF, and Verilog formats",
      "args": [
        {
          "name": "input",
          "description": "PLA truth table to convert",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-f",
          "description": "Source format to convert from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-t",
          "description": "Target format to convert to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "verify",
      "description": "Verify PLA against reference truth table",
      "args": [
        {
          "name": "design.pla",
          "description": "PLA design under test",
          "type": "file",
          "required": true
        },
        {
          "name": "reference.pla",
          "description": "Reference PLA to compare against",
          "type": "file",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "stats",
      "description": "Show PLA statistics (inputs, outputs, product terms)",
      "args": [
        {
          "name": "input.pla",
          "description": "PLA truth table to process",
          "type": "file",
          "required": true
        }
      ],
      "options": []
    }
  ],
  "examples": [
    "espresso input.pla > output.pla",
    "espresso -Dexact input.pla",
    "abc -c 'read_pla design.pla; print_stats'",
    "espresso -oeqntott input.pla"
  ],
  "relatedCommands": [
    "systemverilog",
    "abc",
    "yosys"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Espresso logic minimiser availability",
        "command": "espresso 2>&1 | head -2",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "sources",
        "description": "PLA truth-table files in this project",
        "command": "find . -maxdepth 2 -name '*.pla' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "tools",
        "description": "Logic synthesis tools available",
        "command": "which espresso abc sis 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
