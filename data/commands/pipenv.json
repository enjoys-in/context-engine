{
  "name": "pipenv",
  "description": "Python development workflow tool combining pip and virtualenv",
  "category": "python-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages or from Pipfile",
      "args": [
        {
          "name": "packages",
          "description": "Packages to install",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "pipfile"
          }
        }
      ],
      "options": [
        {
          "name": "--dev",
          "shorthand": "-d",
          "description": "Install dev dependencies",
          "short": "-d"
        },
        {
          "name": "--system",
          "description": "Use system pip"
        },
        {
          "name": "--deploy",
          "description": "Abort if Pipfile.lock is outdated"
        },
        {
          "name": "--ignore-pipfile",
          "description": "Install from Pipfile.lock only"
        },
        {
          "name": "--skip-lock",
          "description": "Skip locking"
        },
        {
          "name": "--python",
          "description": "Python version",
          "takesValue": true
        },
        {
          "name": "--categories",
          "description": "Package categories",
          "takesValue": true
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall packages",
      "args": [
        {
          "name": "packages",
          "description": "Packages to remove",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "pipfile"
          }
        }
      ],
      "options": [
        {
          "name": "--all",
          "description": "Remove all packages"
        },
        {
          "name": "--all-dev",
          "description": "Remove all dev packages"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update packages",
      "args": [
        {
          "name": "packages",
          "description": "Packages to update",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "pipfile"
          }
        }
      ],
      "options": [
        {
          "name": "--dry-run",
          "description": "Preview changes"
        }
      ]
    },
    {
      "name": "lock",
      "description": "Generate Pipfile.lock",
      "options": [
        {
          "name": "--dev",
          "description": "Include the development dependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--clear",
          "description": "Clear the dependency cache first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pre",
          "description": "Allow prerelease versions",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "sync",
      "description": "Install packages from Pipfile.lock",
      "options": [
        {
          "name": "--dev",
          "shorthand": "-d",
          "description": "Include dev packages",
          "short": "-d"
        }
      ]
    },
    {
      "name": "shell",
      "description": "Spawn a shell in the virtualenv",
      "options": [
        {
          "name": "--fancy",
          "description": "Use the fancy shell activation mode",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--anyway",
          "description": "Spawn a subshell even when already active",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run command in virtualenv",
      "args": [
        {
          "name": "command",
          "description": "Command to run",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "graph",
      "description": "Show dependency graph",
      "options": [
        {
          "name": "--json",
          "description": "JSON output"
        },
        {
          "name": "--reverse",
          "shorthand": "-r",
          "description": "Reverse dependencies",
          "short": "-r"
        }
      ]
    },
    {
      "name": "check",
      "description": "Check for security vulnerabilities",
      "options": [
        {
          "name": "--unused",
          "description": "Report packages not imported anywhere",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--db",
          "description": "Vulnerability database to check against",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ignore",
          "description": "Vulnerability id to ignore",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Uninstall packages not in Pipfile.lock",
      "options": [
        {
          "name": "--dry-run",
          "description": "Preview changes"
        }
      ]
    },
    {
      "name": "requirements",
      "description": "Generate requirements.txt",
      "options": [
        {
          "name": "--dev",
          "shorthand": "-d",
          "description": "Include dev packages",
          "short": "-d"
        }
      ]
    },
    {
      "name": "scripts",
      "description": "List scripts from Pipfile",
      "options": []
    },
    {
      "name": "open",
      "description": "Open a package in editor",
      "args": [
        {
          "name": "package",
          "description": "Package name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "pipfile"
          }
        }
      ],
      "options": []
    },
    {
      "name": "verify",
      "description": "Verify the hash of Pipfile.lock",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--where",
      "description": "Show project directory"
    },
    {
      "name": "--venv",
      "description": "Show virtualenv path"
    },
    {
      "name": "--py",
      "description": "Show Python interpreter path"
    },
    {
      "name": "--envs",
      "description": "Show environment variables"
    },
    {
      "name": "--rm",
      "description": "Remove the virtualenv"
    },
    {
      "name": "--python",
      "description": "Python version",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    }
  ],
  "examples": [
    {
      "command": "pipenv install",
      "description": "Install all dependencies"
    },
    {
      "command": "pipenv install requests",
      "description": "Install a package"
    },
    {
      "command": "pipenv install --dev pytest",
      "description": "Install dev dependency"
    },
    {
      "command": "pipenv run python main.py",
      "description": "Run in virtualenv"
    },
    {
      "command": "pipenv shell",
      "description": "Activate virtualenv"
    },
    {
      "command": "pipenv graph",
      "description": "Show dependency graph"
    },
    {
      "command": "pipenv check",
      "description": "Check for vulnerabilities"
    }
  ],
  "relatedCommands": [
    "pip",
    "poetry",
    "python"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "pipfile",
        "description": "Pipfile contents",
        "command": "cat Pipfile 2>/dev/null",
        "parser": "text",
        "cacheFor": 30
      },
      {
        "name": "venv_path",
        "description": "Virtual environment path",
        "command": "pipenv --venv 2>/dev/null",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "pipenv"
      },
      {
        "name": "scripts",
        "description": "Defined scripts",
        "command": "pipenv scripts 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "pipenv"
      },
      {
        "name": "dependency_graph",
        "description": "Dependency relationships",
        "command": "pipenv graph 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "pipenv"
      }
    ]
  }
}
