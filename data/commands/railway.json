{
  "name": "railway",
  "description": "Railway CLI for deploying and managing Railway projects",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a new Railway project",
      "options": [
        {
          "name": "--name",
          "description": "Project name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "examples": [
        "railway init"
      ]
    },
    {
      "name": "up",
      "description": "Deploy the current directory",
      "options": [
        {
          "name": "--detach",
          "shorthand": "-d",
          "description": "Don't follow logs",
          "short": "-d"
        },
        {
          "name": "--service",
          "shorthand": "-s",
          "description": "Service to deploy to",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--environment",
          "shorthand": "-e",
          "description": "Environment to deploy to",
          "takesValue": true,
          "short": "-e"
        }
      ],
      "examples": [
        "railway up"
      ]
    },
    {
      "name": "run",
      "description": "Run a command with Railway env vars",
      "args": [
        {
          "name": "command",
          "description": "Command to run",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--service",
          "shorthand": "-s",
          "description": "Service to use",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--environment",
          "shorthand": "-e",
          "description": "Environment",
          "takesValue": true,
          "short": "-e"
        }
      ],
      "examples": [
        "railway run command"
      ]
    },
    {
      "name": "link",
      "description": "Link to a Railway project",
      "options": [
        {
          "name": "--project",
          "shorthand": "-p",
          "description": "Project ID",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--service",
          "shorthand": "-s",
          "description": "Service",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--environment",
          "shorthand": "-e",
          "description": "Environment",
          "takesValue": true,
          "short": "-e"
        }
      ],
      "examples": [
        "railway link"
      ]
    },
    {
      "name": "unlink",
      "description": "Unlink from Railway project",
      "options": [],
      "examples": [
        "railway unlink"
      ]
    },
    {
      "name": "status",
      "description": "Show project status",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "railway status"
      ]
    },
    {
      "name": "logs",
      "description": "View deployment logs",
      "options": [
        {
          "name": "--deployment",
          "shorthand": "-d",
          "description": "Deployment ID",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--follow",
          "shorthand": "-f",
          "description": "Follow logs",
          "short": "-f"
        }
      ],
      "examples": [
        "railway logs"
      ]
    },
    {
      "name": "variables",
      "description": "Manage environment variables",
      "subcommands": [
        {
          "name": "set",
          "description": "Set a variable",
          "args": [
            {
              "name": "key=value",
              "description": "KEY=VALUE pair",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--service",
              "description": "Service to modify",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--environment",
              "description": "Environment to modify",
              "type": "string",
              "takesValue": true,
              "short": "-e",
              "shorthand": "-e"
            },
            {
              "name": "--skip-deploys",
              "description": "Do not redeploy",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "railway variables set key=value"
          ]
        },
        {
          "name": "get",
          "description": "Get a variable",
          "args": [
            {
              "name": "key",
              "description": "Variable name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--service",
              "description": "Service to read",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--environment",
              "description": "Environment to read",
              "type": "string",
              "takesValue": true,
              "short": "-e",
              "shorthand": "-e"
            },
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "railway variables get key"
          ]
        },
        {
          "name": "delete",
          "description": "Delete a variable",
          "args": [
            {
              "name": "key",
              "description": "Variable name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--service",
              "description": "Service to modify",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--environment",
              "description": "Environment to modify",
              "type": "string",
              "takesValue": true,
              "short": "-e",
              "shorthand": "-e"
            }
          ],
          "examples": [
            "railway variables delete key"
          ]
        }
      ]
    },
    {
      "name": "service",
      "description": "Manage services",
      "subcommands": [
        {
          "name": "list",
          "description": "List services",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "railway service list"
          ]
        }
      ]
    },
    {
      "name": "environment",
      "description": "Manage environments",
      "subcommands": [
        {
          "name": "list",
          "description": "List environments",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "railway environment list"
          ]
        }
      ]
    },
    {
      "name": "domain",
      "description": "Manage domains",
      "subcommands": [
        {
          "name": "add",
          "description": "Add custom domain",
          "args": [
            {
              "name": "domain",
              "description": "Domain name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--service",
              "description": "Service to attach to",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--port",
              "description": "Target port",
              "type": "integer",
              "takesValue": true
            }
          ],
          "examples": [
            "railway domain add domain"
          ]
        },
        {
          "name": "list",
          "description": "List domains",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "railway domain list"
          ]
        }
      ]
    },
    {
      "name": "volume",
      "description": "Manage volumes",
      "subcommands": [
        {
          "name": "add",
          "description": "Add a volume",
          "options": [
            {
              "name": "--mount-path",
              "shorthand": "-m",
              "description": "Mount path",
              "takesValue": true,
              "short": "-m"
            }
          ],
          "examples": [
            "railway volume add"
          ]
        },
        {
          "name": "list",
          "description": "List volumes",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--service",
              "description": "Service to query",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            }
          ],
          "examples": [
            "railway volume list"
          ]
        },
        {
          "name": "delete",
          "description": "Delete a volume",
          "args": [
            {
              "name": "id",
              "description": "Volume ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--yes",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            }
          ],
          "examples": [
            "railway volume delete id"
          ]
        }
      ]
    },
    {
      "name": "login",
      "description": "Log in to Railway",
      "options": [
        {
          "name": "--browserless",
          "description": "Log in without a browser",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "railway login"
      ]
    },
    {
      "name": "logout",
      "description": "Log out",
      "options": [],
      "examples": [
        "railway logout"
      ]
    },
    {
      "name": "whoami",
      "description": "Show current user",
      "options": [],
      "examples": [
        "railway whoami"
      ]
    },
    {
      "name": "shell",
      "description": "Open a shell with Railway env vars",
      "options": [
        {
          "name": "--service",
          "description": "Service environment to load",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--environment",
          "description": "Environment to load",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ],
      "examples": [
        "railway shell"
      ]
    },
    {
      "name": "add",
      "description": "Add a plugin (database)",
      "options": [
        {
          "name": "--plugin",
          "shorthand": "-p",
          "description": "Plugin type (postgres, mysql, redis, mongodb)",
          "takesValue": true,
          "short": "-p"
        }
      ],
      "examples": [
        "railway add"
      ]
    },
    {
      "name": "open",
      "description": "Open project in browser",
      "options": [],
      "examples": [
        "railway open"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--json",
      "description": "Output as JSON"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-V",
      "description": "Show version",
      "short": "-V"
    }
  ],
  "examples": [
    {
      "command": "railway up",
      "description": "Deploy current directory"
    },
    {
      "command": "railway run npm start",
      "description": "Run with Railway env vars"
    },
    {
      "command": "railway logs -f",
      "description": "Follow deployment logs"
    },
    {
      "command": "railway variables set DATABASE_URL=postgres://...",
      "description": "Set env variable"
    },
    {
      "command": "railway link",
      "description": "Link to a project interactively"
    }
  ],
  "relatedCommands": [
    "vercel",
    "netlify",
    "flyctl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "project_status",
        "description": "Current linked project",
        "command": "railway status --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 60,
        "requiresCmd": "railway"
      },
      {
        "name": "services",
        "description": "Project services",
        "command": "railway service list --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 60,
        "requiresCmd": "railway"
      },
      {
        "name": "environments",
        "description": "Available environments",
        "command": "railway environment list --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "railway"
      },
      {
        "name": "user",
        "description": "Current user",
        "command": "railway whoami 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "railway"
      }
    ]
  }
}
