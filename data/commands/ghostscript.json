{
  "name": "ghostscript",
  "description": "PostScript and PDF interpreter/converter",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-dBATCH",
      "description": "Exit after processing"
    },
    {
      "name": "-dNOPAUSE",
      "description": "No pause after each page"
    },
    {
      "name": "-dQUIET",
      "description": "Suppress output"
    },
    {
      "name": "-sDEVICE",
      "description": "Output device",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-sOutputFile",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-r",
      "description": "Resolution in DPI",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-dPDFSETTINGS",
      "description": "PDF quality (/screen, /ebook, /printer, /prepress)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-dCompatibilityLevel",
      "description": "PDF version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-dFirstPage",
      "description": "First page to process",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-dLastPage",
      "description": "Last page to process",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "gs -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -sOutputFile=compressed.pdf input.pdf",
    "gs -dBATCH -dNOPAUSE -sDEVICE=png16m -r300 -sOutputFile=page%d.png input.pdf",
    "gs -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dFirstPage=1 -dLastPage=5 -sOutputFile=extract.pdf input.pdf"
  ],
  "relatedCommands": [
    "pdftk",
    "qpdf",
    "imagemagick",
    "poppler"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Ghostscript version",
        "command": "gs --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gs"
      },
      {
        "name": "devices",
        "description": "Output devices Ghostscript supports",
        "command": "gs -h 2>/dev/null | head -25",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gs"
      },
      {
        "name": "documents",
        "description": "PDF and PostScript files here",
        "command": "find . -maxdepth 2 -name '*.pdf' -o -name '*.ps' -o -name '*.eps' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
