{
  "name": "next",
  "description": "Next.js CLI for building and running React applications with SSR/SSG",
  "category": "node-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "dev",
      "description": "Start development server with HMR",
      "options": [
        {
          "name": "--port",
          "shorthand": "-p",
          "description": "Port number",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--hostname",
          "shorthand": "-H",
          "description": "Hostname",
          "takesValue": true,
          "short": "-H"
        },
        {
          "name": "--turbo",
          "description": "Use Turbopack"
        },
        {
          "name": "--experimental-https",
          "description": "Enable HTTPS"
        }
      ],
      "examples": [
        "next dev"
      ]
    },
    {
      "name": "build",
      "description": "Build for production",
      "options": [
        {
          "name": "--debug",
          "description": "Enable debug output"
        },
        {
          "name": "--profile",
          "description": "Enable React profiling"
        },
        {
          "name": "--no-lint",
          "description": "Skip linting"
        }
      ],
      "examples": [
        "next build"
      ]
    },
    {
      "name": "start",
      "description": "Start production server",
      "options": [
        {
          "name": "--port",
          "shorthand": "-p",
          "description": "Port number",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--hostname",
          "shorthand": "-H",
          "description": "Hostname",
          "takesValue": true,
          "short": "-H"
        },
        {
          "name": "--keepAliveTimeout",
          "description": "Keep-alive timeout (ms)",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "directory",
          "description": "Project directory to serve",
          "required": false,
          "type": "directory"
        }
      ],
      "examples": [
        "next start ./build"
      ]
    },
    {
      "name": "lint",
      "description": "Run ESLint",
      "options": [
        {
          "name": "--dir",
          "shorthand": "-d",
          "description": "Directories to lint",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--fix",
          "description": "Auto-fix issues"
        },
        {
          "name": "--strict",
          "description": "Strict mode"
        },
        {
          "name": "--quiet",
          "description": "Only report errors"
        }
      ],
      "examples": [
        "next lint"
      ]
    },
    {
      "name": "info",
      "description": "Show system information for bug reports",
      "options": [
        {
          "name": "--verbose",
          "description": "Include the full environment report",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "next info"
      ]
    },
    {
      "name": "telemetry",
      "description": "Manage telemetry",
      "subcommands": [
        {
          "name": "status",
          "description": "Show telemetry status",
          "options": [],
          "examples": [
            "next telemetry status"
          ]
        },
        {
          "name": "enable",
          "description": "Enable telemetry",
          "options": [],
          "examples": [
            "next telemetry enable"
          ]
        },
        {
          "name": "disable",
          "description": "Disable telemetry",
          "options": [],
          "examples": [
            "next telemetry disable"
          ]
        }
      ]
    },
    {
      "name": "export",
      "description": "Export static HTML (legacy)",
      "options": [
        {
          "name": "--outdir",
          "shorthand": "-o",
          "description": "Output directory",
          "takesValue": true,
          "short": "-o"
        }
      ],
      "examples": [
        "next export"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-v",
      "description": "Show version",
      "short": "-v"
    }
  ],
  "examples": [
    {
      "command": "next dev",
      "description": "Start development server"
    },
    {
      "command": "next build",
      "description": "Build for production"
    },
    {
      "command": "next start -p 8080",
      "description": "Start production server on port 8080"
    },
    {
      "command": "next dev --turbo",
      "description": "Dev with Turbopack"
    },
    {
      "command": "next lint --fix",
      "description": "Lint and auto-fix"
    }
  ],
  "relatedCommands": [
    "vite",
    "vercel",
    "npm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "next_config",
        "description": "Next.js configuration",
        "command": "cat next.config.js 2>/dev/null || cat next.config.mjs 2>/dev/null || cat next.config.ts 2>/dev/null",
        "parser": "text",
        "cacheFor": 30
      },
      {
        "name": "pages",
        "description": "Pages/routes structure",
        "command": "find app pages src/app src/pages -name '*.tsx' -o -name '*.ts' -o -name '*.jsx' -o -name '*.js' 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "package_scripts",
        "description": "Package.json scripts",
        "command": "node -e \"const p=require('./package.json');Object.entries(p.scripts||{}).forEach(([k,v])=>console.log(k+': '+v))\" 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "dependencies",
        "description": "Project dependencies",
        "command": "node -e \"const p=require('./package.json');Object.keys({...p.dependencies,...p.devDependencies}).forEach(d=>console.log(d))\" 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "env_files",
        "description": "Environment files",
        "command": "ls -1 .env* 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30
      }
    ]
  }
}
