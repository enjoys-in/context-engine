{
  "name": "ps",
  "description": "Report a snapshot of current processes",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "aux",
      "description": "Show all processes with detailed info"
    },
    {
      "name": "-e",
      "description": "Select all processes"
    },
    {
      "name": "-f",
      "description": "Full-format listing"
    },
    {
      "name": "-u",
      "description": "User-oriented format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "Select by PID",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--sort",
      "description": "Sort output",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "User-defined format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--forest",
      "description": "ASCII art process tree"
    },
    {
      "name": "-C",
      "description": "Select by command name",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "ps",
    "ps aux",
    "ps -ef",
    "ps aux --sort=-%mem",
    "ps aux --sort=-%cpu",
    "ps -u username",
    "ps aux | grep nginx",
    "ps -o pid,user,%mem,%cpu,comm -e --sort=-%mem",
    "ps --forest"
  ],
  "relatedCommands": [
    "top",
    "htop",
    "kill",
    "pgrep",
    "pkill",
    "nice",
    "renice"
  ]
}
