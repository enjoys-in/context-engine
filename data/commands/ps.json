{
  "name": "ps",
  "description": "Report a snapshot of current processes",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "aux",
      "description": "Show all processes with detailed info"
    },
    {
      "name": "-e",
      "description": "Select all processes"
    },
    {
      "name": "-f",
      "description": "Full-format listing"
    },
    {
      "name": "-u",
      "description": "User-oriented format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "Select by PID",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--sort",
      "description": "Sort output",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "User-defined format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--forest",
      "description": "ASCII art process tree"
    },
    {
      "name": "-C",
      "description": "Select by command name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--every",
      "description": "Show every process",
      "type": "boolean",
      "takesValue": false,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--all",
      "description": "Show processes for all users",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--full",
      "description": "Full-format listing",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--long",
      "description": "Long format",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--user",
      "description": "Show processes for this effective user",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--User",
      "description": "Show processes for this real user",
      "type": "string",
      "takesValue": true,
      "short": "-U",
      "shorthand": "-U"
    },
    {
      "name": "--pid",
      "description": "Show only these process ids",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--ppid",
      "description": "Show children of these parents",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--format",
      "description": "Columns to display",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--no-headers",
      "description": "Omit the header row",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--threads",
      "description": "Show individual threads",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--command",
      "description": "Select by command name",
      "type": "string",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--tty",
      "description": "Select by terminal",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--group",
      "description": "Select by group",
      "type": "string",
      "takesValue": true,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--width",
      "description": "Output width; repeat for unlimited",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--cumulative",
      "description": "Include dead child data",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    }
  ],
  "examples": [
    "ps",
    "ps aux",
    "ps -ef",
    "ps aux --sort=-%mem",
    "ps aux --sort=-%cpu",
    "ps -u username",
    "ps aux | grep nginx",
    "ps -o pid,user,%mem,%cpu,comm -e --sort=-%mem",
    "ps --forest"
  ],
  "relatedCommands": [
    "top",
    "htop",
    "kill",
    "pgrep",
    "pkill",
    "nice",
    "renice"
  ]
}
