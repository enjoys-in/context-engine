{
  "name": "lazydocker",
  "description": "Terminal UI for docker and docker-compose",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Print the current configuration",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--composeFile",
      "description": "Compose file to use",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--logs",
      "description": "Tail the debug log",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--print-config-dir",
      "description": "Print the config directory",
      "type": "boolean",
      "takesValue": false,
      "short": "-cd",
      "shorthand": "-cd"
    }
  ],
  "examples": [
    {
      "command": "lazydocker",
      "description": "Open the dashboard"
    },
    {
      "command": "lazydocker -f docker-compose.dev.yml",
      "description": "Use a specific compose file"
    },
    {
      "command": "lazydocker -cd",
      "description": "Print the configuration directory"
    }
  ],
  "relatedCommands": [
    "docker",
    "docker-compose",
    "k9s",
    "dive"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "lazydocker version",
        "command": "lazydocker --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "lazydocker"
      },
      {
        "name": "docker_ok",
        "description": "Docker daemon reachability",
        "command": "docker info --format '{{.ServerVersion}}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "docker"
      },
      {
        "name": "containers",
        "description": "Docker containers lazydocker will show",
        "command": "docker ps -a --format '{{.Names}}\\t{{.Status}}' 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 15,
        "requiresCmd": "docker"
      },
      {
        "name": "compose",
        "description": "Compose project in this directory",
        "command": "ls docker-compose.yml compose.yaml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
