  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "AWS CLI version for Lightsail",
        "command": "aws --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "aws"
      },
      {
        "name": "region",
        "description": "AWS region in effect",
        "command": "aws configure get region 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "aws"
      },
      {
        "name": "instances",
        "description": "Lightsail instances in the active region",
        "command": "aws lightsail get-instances --query 'instances[].{name:name,state:state.name}' 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "aws"
      }
    ]
  }
}
