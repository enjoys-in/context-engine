{
  "name": "neo4j",
  "description": "Graph database server administration",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start the server in the background",
      "options": [],
      "examples": [
        "neo4j start"
      ]
    },
    {
      "name": "stop",
      "description": "Stop the running server",
      "options": [],
      "examples": [
        "neo4j stop"
      ]
    },
    {
      "name": "restart",
      "description": "Restart the server",
      "options": [],
      "examples": [
        "neo4j restart"
      ]
    },
    {
      "name": "status",
      "description": "Show whether the server is running",
      "options": [],
      "examples": [
        "neo4j status"
      ]
    },
    {
      "name": "console",
      "description": "Run the server in the foreground",
      "options": [
        {
          "name": "--dry-run",
          "description": "Print the command without running it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "neo4j console"
      ]
    },
    {
      "name": "version",
      "description": "Show the server version",
      "options": [],
      "examples": [
        "neo4j version"
      ]
    },
    {
      "name": "admin-report",
      "description": "Collect diagnostics for support",
      "options": [
        {
          "name": "--to-path",
          "description": "Directory to write the report to",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "neo4j admin-report"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--expand-commands",
      "description": "Allow command expansion in the configuration",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "neo4j start",
      "description": "Start the server"
    },
    {
      "command": "neo4j status",
      "description": "Check whether it is running"
    },
    {
      "command": "neo4j console",
      "description": "Run in the foreground for debugging"
    },
    {
      "command": "cypher-shell -u neo4j -p pass",
      "description": "Connect with the query shell"
    }
  ],
  "relatedCommands": [
    "cypher",
    "cqlsh",
    "psql",
    "mongosh"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Neo4j version",
        "command": "neo4j --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "neo4j"
      },
      {
        "name": "status",
        "description": "Neo4j server status",
        "command": "neo4j status 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "neo4j"
      },
      {
        "name": "config",
        "description": "Neo4j server configuration",
        "command": "grep -v '^#' /etc/neo4j/neo4j.conf 2>/dev/null | grep . | head -25",
        "parser": "keyvalue",
        "cacheFor": 300
      },
      {
        "name": "client",
        "description": "Cypher Shell available for queries",
        "command": "cypher-shell --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
