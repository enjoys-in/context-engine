{
  "name": "patch",
  "description": "Apply a diff file to an original",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-p",
      "description": "Strip N leading path components",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-R",
      "description": "Reverse patch"
    },
    {
      "name": "--dry-run",
      "description": "Print results without modifying files"
    },
    {
      "name": "-b",
      "description": "Make backup before patching"
    },
    {
      "name": "-i",
      "description": "Read patch from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Change to directory before doing anything",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "patch < fix.diff",
    "patch -p1 < fix.diff",
    "patch -R < fix.diff",
    "patch --dry-run < fix.diff",
    "patch -p1 -i changes.patch"
  ],
  "relatedCommands": [
    "diff",
    "git"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "patch version",
        "command": "patch --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "patch"
      },
      {
        "name": "patch_files",
        "description": "Patch and diff files in this directory",
        "command": "find . -maxdepth 2 -name '*.patch' -o -name '*.diff' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "repo",
        "description": "Git repository the patch would apply to",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
