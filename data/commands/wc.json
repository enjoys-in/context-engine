{
  "name": "wc",
  "description": "Print newline, word, and byte counts for files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-l",
      "description": "Print line count"
    },
    {
      "name": "-w",
      "description": "Print word count"
    },
    {
      "name": "-c",
      "description": "Print byte count"
    },
    {
      "name": "-m",
      "description": "Print character count"
    },
    {
      "name": "-L",
      "description": "Print length of longest line"
    }
  ],
  "examples": [
    "wc file.txt",
    "wc -l file.txt",
    "wc -w file.txt",
    "find . -name '*.js' | wc -l",
    "cat file.txt | wc -l",
    "wc -l *.py"
  ],
  "relatedCommands": [
    "cat",
    "grep",
    "sort"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "wc version",
        "command": "wc --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "wc"
      },
      {
        "name": "text_files",
        "description": "Countable text files in this directory",
        "command": "find . -maxdepth 2 -name '*.txt' -o -name '*.md' -o -name '*.csv' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "file_count",
        "description": "Entries in the current directory",
        "command": "ls -A 2>/dev/null | wc -l",
        "parser": "text",
        "cacheFor": 30
      }
    ]
  }
}
