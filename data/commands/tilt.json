{
  "name": "tilt",
  "description": "Tilt — smart rebuilds and live updates for Kubernetes dev",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "up",
      "description": "Start Tilt with UI",
      "examples": [
        "tilt up",
        "tilt up --stream",
        "tilt up --port 10350",
        "tilt up -- --my-flag"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Tiltfile to run",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--port",
          "description": "Port for the web UI",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host the web UI binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--stream",
          "description": "Stream logs to stdout rather than opening the UI",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--namespace",
          "description": "Kubernetes namespace to deploy into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--legacy",
          "description": "Use the terminal UI",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "down",
      "description": "Tear down resources",
      "examples": [
        "tilt down",
        "tilt down --delete-namespaces"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Tiltfile to read",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--delete-namespaces",
          "description": "Delete namespaces Tilt created",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--namespace",
          "description": "Kubernetes namespace to operate in",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ci",
      "description": "CI mode (run, wait, exit)",
      "examples": [
        "tilt ci",
        "tilt ci --timeout 10m"
      ],
      "options": [
        {
          "name": "--file",
          "description": "Tiltfile to run",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--timeout",
          "description": "How long to wait before failing",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output-snapshot-on-exit",
          "description": "Write a snapshot when the run ends",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "demo",
      "description": "Start demo project",
      "examples": [
        "tilt demo"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port for the web UI",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--tmpdir",
          "description": "Temporary directory for the demo project",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "get",
      "description": "Get resource info",
      "examples": [
        "tilt get uiresources",
        "tilt get cmd"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json, yaml or name",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--watch",
          "description": "Watch for changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to fetch",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "logs",
      "description": "View resource logs",
      "examples": [
        "tilt logs",
        "tilt logs my-resource"
      ],
      "options": [
        {
          "name": "--follow",
          "description": "Stream new log lines",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--resource",
          "description": "Only show logs for this resource",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--since",
          "description": "Only logs newer than this duration",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "trigger",
      "description": "Trigger an update",
      "examples": [
        "tilt trigger my-resource"
      ],
      "options": [
        {
          "name": "--build",
          "description": "Force a rebuild rather than just a redeploy",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "enable",
      "description": "Enable a resource",
      "examples": [
        "tilt enable my-resource"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Enable every resource",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--only",
          "description": "Enable only the named resources and disable the rest",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "resource",
          "description": "Resources to enable",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "disable",
      "description": "Disable a resource",
      "examples": [
        "tilt disable my-resource"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Disable every resource",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "resource",
          "description": "Resources to disable",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "describe",
      "description": "Describe a resource",
      "examples": [
        "tilt describe uiresource/my-resource"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to describe",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Diagnose issues",
      "examples": [
        "tilt doctor"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "dump",
      "description": "Dump internal state",
      "examples": [
        "tilt dump engine",
        "tilt dump cli"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "tilt version"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "description": "Default namespace",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--file",
      "short": "-f",
      "description": "Tiltfile path",
      "type": "string",
      "takesValue": true,
      "shorthand": "-f"
    },
    {
      "name": "--port",
      "description": "Web UI port",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--stream",
      "description": "Stream logs to stdout"
    }
  ],
  "examples": [
    "tilt up",
    "tilt up --stream",
    "tilt down",
    "tilt ci",
    "tilt logs",
    "tilt trigger my-resource",
    "tilt doctor",
    "tilt version"
  ],
  "relatedCommands": [
    "skaffold",
    "kubectl",
    "docker",
    "devspace"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Tilt version",
        "command": "tilt version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tilt"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "tiltfile",
        "description": "Tiltfile for this project",
        "command": "cat Tiltfile 2>/dev/null | head -60",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "resources",
        "description": "Resources Tilt is managing",
        "command": "tilt get uiresources -o name 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "tilt"
      }
    ]
  }
}
