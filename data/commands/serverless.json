  ],
  "globalOptions": [
    {
      "name": "--stage",
      "short": "-s",
      "description": "Deployment stage",
      "type": "string",
      "takesValue": true,
      "shorthand": "-s"
    },
    {
      "name": "--region",
      "short": "-r",
      "description": "AWS region",
      "type": "string",
      "takesValue": true,
      "shorthand": "-r"
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    },
    {
      "name": "--config",
      "short": "-c",
      "description": "Config file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-c"
    }
  ],
  "examples": [
    "sls deploy",
    "sls deploy --stage prod",
    "sls invoke -f hello",
    "sls logs -f hello -t",
    "sls create --template aws-nodejs --path my-svc"
  ],
  "relatedCommands": [
    "sam",
    "cdk",
    "aws",
    "lambda"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Serverless Framework version",
        "command": "serverless --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "serverless"
      },
      {
        "name": "config",
        "description": "Serverless service definition",
        "command": "cat serverless.yml 2>/dev/null | head -60 || cat serverless.yaml 2>/dev/null | head -60",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "stage",
        "description": "Serverless stage in effect",
        "command": "echo \"${SLS_STAGE:-dev}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "plugins",
        "description": "Serverless plugins declared",
        "command": "grep -A20 '^plugins:' serverless.yml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
