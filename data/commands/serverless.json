          "shorthand": "-t"
        },
        {
          "name": "--startTime",
          "description": "Only entries newer than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--filter",
          "description": "Only entries matching this pattern",
          "type": "string",
          "takesValue": true
        }
      ]
    },
