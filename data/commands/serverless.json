{
  "name": "serverless",
  "description": "Serverless Framework — build serverless applications",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "deploy",
      "description": "Deploy a service",
      "examples": [
        "serverless deploy",
        "sls deploy --stage prod"
      ],
      "options": [
        {
          "name": "--stage",
          "description": "Stage to target",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--config",
          "description": "Serverless config file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--aws-profile",
          "description": "AWS profile to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Deploy even when nothing changed",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--package",
          "description": "Deploy this pre-built package",
          "type": "directory",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--function",
          "description": "Deploy a single function",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "invoke",
      "description": "Invoke a function",
      "examples": [
        "sls invoke -f hello",
        "sls invoke local -f hello"
      ],
      "options": [
        {
          "name": "--stage",
          "description": "Stage to target",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
