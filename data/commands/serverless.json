          "name": "--aws-profile",
          "description": "AWS profile to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--httpPort",
          "description": "Port for the local HTTP server",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host the local server binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--noPrependStageInUrl",
          "description": "Do not prefix routes with the stage",
          "type": "boolean",
          "takesValue": false
        }
