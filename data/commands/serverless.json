          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--aws-profile",
          "description": "AWS profile to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--function",
          "description": "Function to invoke",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--data",
          "description": "Payload to send",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--path",
