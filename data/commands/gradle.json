{
  "name": "gradle",
  "description": "Build automation tool for multi-language software development",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Assemble and test the project",
      "examples": [
        "gradle build",
        "./gradlew build"
      ],
      "options": [
        {
          "name": "--parallel",
          "description": "Build projects in parallel",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Build without network access",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--build-cache",
          "description": "Use the build cache",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclude-task",
          "description": "Task to skip",
          "type": "string",
          "takesValue": true,
          "short": "-x",
          "shorthand": "-x"
        },
        {
          "name": "--info",
          "description": "Print info logging",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Delete build directory",
      "examples": [
        "gradle clean"
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "gradle test"
      ],
      "options": [
        {
          "name": "--tests",
          "description": "Test filter pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--fail-fast",
          "description": "Stop at the first failure",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--info",
          "description": "Print info logging",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "assemble",
      "description": "Assemble archives",
      "examples": [
        "gradle assemble"
      ],
      "options": [
        {
          "name": "--parallel",
          "description": "Build projects in parallel",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "check",
      "description": "Run all checks",
      "examples": [
        "gradle check"
      ],
      "options": [
        {
          "name": "--continue",
          "description": "Keep going after failures",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run the application",
      "examples": [
        "gradle run"
      ],
      "options": [
        {
          "name": "--args",
          "description": "Arguments to pass to the application",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--debug-jvm",
          "description": "Wait for a debugger to attach",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "bootRun",
      "description": "Run Spring Boot application",
      "examples": [
        "gradle bootRun"
      ],
      "options": [
        {
          "name": "--args",
          "description": "Arguments to pass to the application",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "dependencies",
      "description": "Show project dependencies",
      "examples": [
        "gradle dependencies"
      ],
      "options": [
        {
          "name": "--configuration",
          "description": "Only this configuration",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "tasks",
      "description": "List available tasks",
      "examples": [
        "gradle tasks",
        "gradle tasks --all"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include tasks from subprojects",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--group",
          "description": "Only this task group",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize a new Gradle project",
      "examples": [
        "gradle init --type java-application"
      ],
      "options": [
        {
          "name": "--type",
          "description": "Project type to generate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dsl",
          "description": "Build script DSL (groovy, kotlin)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--project-name",
          "description": "Project name",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "wrapper",
      "description": "Generate Gradle wrapper files",
      "examples": [
        "gradle wrapper --gradle-version 8.5"
      ],
      "options": [
        {
          "name": "--gradle-version",
          "description": "Gradle version to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--distribution-type",
          "description": "Distribution type (bin, all)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish to repository",
      "examples": [
        "gradle publish"
      ],
      "options": [
        {
          "name": "--dry-run",
          "description": "Report without publishing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "short": "-v",
      "description": "Show version",
      "shorthand": "-v"
    },
    {
      "name": "--build-file",
      "short": "-b",
      "description": "Build file path",
      "type": "file",
      "takesValue": true,
      "shorthand": "-b"
    },
    {
      "name": "--project-dir",
      "short": "-p",
      "description": "Project directory",
      "type": "directory",
      "takesValue": true,
      "shorthand": "-p"
    },
    {
      "name": "--parallel",
      "description": "Build projects in parallel"
    },
    {
      "name": "--daemon",
      "description": "Use Gradle daemon"
    },
    {
      "name": "--no-daemon",
      "description": "Don't use Gradle daemon"
    },
    {
      "name": "--stacktrace",
      "short": "-s",
      "description": "Show stacktrace",
      "shorthand": "-s"
    },
    {
      "name": "--info",
      "short": "-i",
      "description": "Info log level",
      "shorthand": "-i"
    },
    {
      "name": "--debug",
      "short": "-d",
      "description": "Debug log level",
      "shorthand": "-d"
    },
    {
      "name": "-x",
      "description": "Exclude task",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--offline",
      "description": "Don't access network"
    },
    {
      "name": "--refresh-dependencies",
      "description": "Refresh dependencies"
    }
  ],
  "examples": [
    "./gradlew clean build",
    "./gradlew test",
    "./gradlew bootRun",
    "./gradlew build -x test",
    "./gradlew dependencies --configuration runtimeClasspath"
  ],
  "relatedCommands": [
    "mvn",
    "java",
    "javac",
    "ant",
    "sbt"
  ]
}
