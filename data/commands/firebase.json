{
  "name": "firebase",
  "description": "Firebase CLI for managing Firebase projects and services",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a Firebase project in the current directory",
      "options": [
        {
          "name": "--project",
          "shorthand": "-P",
          "description": "Project to use",
          "takesValue": true,
          "short": "-P"
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy to Firebase",
      "options": [
        {
          "name": "--only",
          "description": "Deploy only specific targets (hosting, functions, firestore, storage)",
          "takesValue": true
        },
        {
          "name": "--except",
          "description": "Skip specific targets",
          "takesValue": true
        },
        {
          "name": "--project",
          "shorthand": "-P",
          "description": "Project to deploy to",
          "takesValue": true,
          "short": "-P"
        },
        {
          "name": "--message",
          "shorthand": "-m",
          "description": "Deploy message",
          "takesValue": true,
          "short": "-m"
        }
      ]
    },
    {
      "name": "serve",
      "description": "Start a local server for Firebase Hosting",
      "options": [
        {
          "name": "--only",
          "description": "Serve only specific targets",
          "takesValue": true
        },
        {
          "name": "--port",
          "shorthand": "-p",
          "description": "Port to serve on",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--host",
          "shorthand": "-o",
          "description": "Host to serve on",
          "takesValue": true,
          "short": "-o"
        }
      ]
    },
    {
      "name": "emulators",
      "description": "Manage Firebase emulators",
      "subcommands": [
        {
          "name": "start",
          "description": "Start emulators",
          "options": [
            {
              "name": "--only",
              "description": "Start only specific emulators",
              "takesValue": true
            },
            {
              "name": "--import",
              "description": "Import emulator data",
              "takesValue": true
            },
            {
              "name": "--export-on-exit",
              "description": "Export data on exit",
              "takesValue": true
            }
          ]
        },
        {
          "name": "exec",
          "description": "Start emulators and run a script",
          "args": [
            {
              "name": "script",
              "description": "Script to run",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--only",
              "description": "Emulators to start",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--project",
              "description": "Project to use",
              "type": "string",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            },
            {
              "name": "--import",
              "description": "Import data from this directory",
              "type": "directory",
              "takesValue": true
            },
            {
              "name": "--export-on-exit",
              "description": "Export data on exit",
              "type": "string",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "functions",
      "description": "Manage Cloud Functions",
      "subcommands": [
        {
          "name": "log",
          "description": "View function logs",
          "options": [
            {
              "name": "--only",
              "description": "Filter by function name",
              "takesValue": true
            }
          ]
        },
        {
          "name": "delete",
          "description": "Delete functions",
          "args": [
            {
              "name": "name",
              "description": "Function name",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--project",
              "description": "Project to use",
              "type": "string",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            },
            {
              "name": "--force",
              "description": "Proceed without confirmation",
              "type": "boolean",
              "takesValue": false,
              "short": "-f",
              "shorthand": "-f"
            },
            {
              "name": "--region",
              "description": "Function region",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "shell",
          "description": "Start an interactive functions shell",
          "options": [
            {
              "name": "--project",
              "description": "Project to use",
              "type": "string",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            },
            {
              "name": "--port",
              "description": "Port for the emulator",
              "type": "integer",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "hosting",
      "description": "Manage Firebase Hosting",
      "subcommands": [
        {
          "name": "channel",
          "description": "Manage preview channels",
          "subcommands": [
            {
              "name": "create",
              "description": "Create a preview channel",
              "args": [
                {
                  "name": "channelId",
                  "description": "Channel ID",
                  "required": true
                }
              ],
              "options": [
                {
                  "name": "--expires",
                  "description": "Channel lifetime, e.g. 7d",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--site",
                  "description": "Hosting site",
                  "type": "string",
                  "takesValue": true
                }
              ]
            },
            {
              "name": "delete",
              "description": "Delete a preview channel",
              "args": [
                {
                  "name": "channelId",
                  "description": "Channel ID",
                  "required": true
                }
              ],
              "options": [
                {
                  "name": "--force",
                  "description": "Proceed without confirmation",
                  "type": "boolean",
                  "takesValue": false,
                  "short": "-f",
                  "shorthand": "-f"
                },
                {
                  "name": "--site",
                  "description": "Hosting site",
                  "type": "string",
                  "takesValue": true
                }
              ]
            },
            {
              "name": "list",
              "description": "List preview channels",
              "options": [
                {
                  "name": "--site",
                  "description": "Hosting site",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--json",
                  "description": "Emit JSON",
                  "type": "boolean",
                  "takesValue": false
                }
              ]
            },
            {
              "name": "deploy",
              "description": "Deploy to a channel",
              "args": [
                {
                  "name": "channelId",
                  "description": "Channel ID",
                  "required": true
                }
              ],
              "options": [
                {
                  "name": "--expires",
                  "description": "Channel lifetime",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--only",
                  "description": "Only these targets",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--site",
                  "description": "Hosting site",
                  "type": "string",
                  "takesValue": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "firestore",
      "description": "Manage Firestore",
      "subcommands": [
        {
          "name": "indexes",
          "description": "List Firestore indexes",
          "options": [
            {
              "name": "--project",
              "description": "Project to use",
              "type": "string",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            },
            {
              "name": "--pretty",
              "description": "Pretty-print the output",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "delete",
          "description": "Delete documents",
          "args": [
            {
              "name": "path",
              "description": "Document path",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--recursive",
              "description": "Delete subcollections",
              "type": "boolean",
              "takesValue": false,
              "short": "-r",
              "shorthand": "-r"
            },
            {
              "name": "--shallow",
              "description": "Delete documents but keep subcollections",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--all-collections",
              "description": "Delete every collection",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--yes",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            }
          ]
        }
      ]
    },
    {
      "name": "auth",
      "description": "Manage Firebase Auth",
      "subcommands": [
        {
          "name": "export",
          "description": "Export user accounts",
          "args": [
            {
              "name": "file",
              "description": "Output file",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--format",
              "description": "Output format (csv, json)",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--project",
              "description": "Project to use",
              "type": "string",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            }
          ]
        },
        {
          "name": "import",
          "description": "Import user accounts",
          "args": [
            {
              "name": "file",
              "description": "Input file",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--hash-algo",
              "description": "Password hash algorithm",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--hash-key",
              "description": "Password hash key",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--rounds",
              "description": "Hash rounds",
              "type": "integer",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "use",
      "description": "Set active project",
      "args": [
        {
          "name": "project",
          "description": "Project ID or alias",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--add",
          "description": "Add a project alias",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--alias",
          "description": "Alias to assign",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--clear",
          "description": "Clear the active project",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "projects",
      "description": "Manage Firebase projects",
      "subcommands": [
        {
          "name": "list",
          "description": "List all projects",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "create",
          "description": "Create a new project",
          "args": [
            {
              "name": "projectId",
              "description": "Project ID",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--display-name",
              "description": "Human-readable name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            },
            {
              "name": "--organization",
              "description": "Organisation to create under",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            }
          ]
        }
      ]
    },
    {
      "name": "login",
      "description": "Log in to Firebase",
      "options": [
        {
          "name": "--no-localhost",
          "description": "Login without localhost"
        }
      ]
    },
    {
      "name": "logout",
      "description": "Log out of Firebase"
    },
    {
      "name": "apps",
      "description": "Manage Firebase apps",
      "subcommands": [
        {
          "name": "list",
          "description": "List apps",
          "options": [
            {
              "name": "--project",
              "description": "Project to use",
              "type": "string",
              "takesValue": true,
              "short": "-P",
              "shorthand": "-P"
            }
          ]
        },
        {
          "name": "create",
          "description": "Create an app",
          "options": [
            {
              "name": "--platform",
              "description": "Platform (web, ios, android)",
              "takesValue": true
            }
          ]
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--project",
      "shorthand": "-P",
      "description": "Firebase project to use",
      "takesValue": true,
      "short": "-P"
    },
    {
      "name": "--json",
      "description": "Output as JSON"
    },
    {
      "name": "--debug",
      "description": "Enable debug logging"
    },
    {
      "name": "--token",
      "description": "Auth token",
      "takesValue": true
    },
    {
      "name": "--non-interactive",
      "description": "Suppress prompts"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    }
  ],
  "examples": [
    {
      "command": "firebase deploy --only hosting",
      "description": "Deploy only hosting"
    },
    {
      "command": "firebase emulators:start --only functions,firestore",
      "description": "Start function and Firestore emulators"
    },
    {
      "command": "firebase use my-project",
      "description": "Switch to a project"
    },
    {
      "command": "firebase functions:log --only myFunction",
      "description": "View logs for a function"
    },
    {
      "command": "firebase hosting:channel:deploy preview",
      "description": "Deploy to preview channel"
    }
  ],
  "relatedCommands": [
    "gcloud",
    "vercel",
    "netlify"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "active_project",
        "description": "Current Firebase project",
        "command": "cat .firebaserc 2>/dev/null",
        "parser": "json",
        "cacheFor": 60
      },
      {
        "name": "projects",
        "description": "Available Firebase projects",
        "command": "firebase projects:list --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "firebase"
      },
      {
        "name": "firebase_config",
        "description": "Firebase configuration",
        "command": "cat firebase.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 60
      },
      {
        "name": "deployed_services",
        "description": "Services configured in firebase.json",
        "command": "cat firebase.json 2>/dev/null | python3 -c \"import sys,json;d=json.load(sys.stdin);print('\\n'.join(d.keys()))\" 2>/dev/null || cat firebase.json 2>/dev/null | node -e \"const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));console.log(Object.keys(d).join('\\n'))\" 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
