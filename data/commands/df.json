{
  "name": "df",
  "description": "Report file system disk space usage",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-h",
      "description": "Human-readable sizes (1K, 234M, 2G)"
    },
    {
      "name": "-T",
      "description": "Print file system type"
    },
    {
      "name": "-i",
      "description": "Show inode information instead of block"
    },
    {
      "name": "-a",
      "description": "Include pseudo/duplicate/inaccessible file systems"
    },
    {
      "name": "-l",
      "description": "Show only local file systems"
    },
    {
      "name": "-t",
      "description": "Show only file systems of given type",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-x",
      "description": "Exclude file systems of given type",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--total",
      "description": "Add a grand total row"
    },
    {
      "name": "--human-readable",
      "description": "Print sizes in powers of 1024",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--si",
      "description": "Print sizes in powers of 1000",
      "type": "boolean",
      "takesValue": false,
      "short": "-H",
      "shorthand": "-H"
    },
    {
      "name": "--type",
      "description": "Only these filesystem types",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--exclude-type",
      "description": "Skip these filesystem types",
      "type": "string",
      "takesValue": true,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--all",
      "description": "Include pseudo and duplicate filesystems",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--inodes",
      "description": "Report inode usage",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--local",
      "description": "Local filesystems only",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--output",
      "description": "Columns to display",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--print-type",
      "description": "Show the filesystem type",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--block-size",
      "description": "Scale sizes by this unit",
      "type": "string",
      "takesValue": true,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--no-sync",
      "description": "Do not sync before reporting",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "df -h",
    "df -hT",
    "df -i",
    "df -h /home",
    "df --total -h",
    "df -h -x tmpfs",
    "df -Th /dev/sda1"
  ],
  "relatedCommands": [
    "du",
    "mount",
    "lsblk",
    "fdisk"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "df version",
        "command": "df --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "df"
      },
      {
        "name": "filesystems",
        "description": "Mounted filesystems and usage",
        "command": "df -h 2>/dev/null",
        "parser": "table",
        "cacheFor": 30
      },
      {
        "name": "inodes",
        "description": "Inode usage per filesystem",
        "command": "df -i 2>/dev/null | head -15",
        "parser": "table",
        "cacheFor": 60
      }
    ]
  }
}
