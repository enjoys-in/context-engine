{
  "name": "mvn",
  "description": "Apache Maven build automation and project management tool for Java",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "clean",
      "description": "Clean build output",
      "examples": [
        "mvn clean"
      ],
      "options": [
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--offline",
          "description": "Build without network access",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "compile",
      "description": "Compile source code",
      "examples": [
        "mvn compile"
      ],
      "options": [
        {
          "name": "--offline",
          "description": "Build without network access",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--threads",
          "description": "Parallel build threads",
          "type": "string",
          "takesValue": true,
          "short": "-T",
          "shorthand": "-T"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "mvn test"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--fail-at-end",
          "description": "Keep going and fail at the end",
          "type": "boolean",
          "takesValue": false,
          "short": "-fae",
          "shorthand": "-fae"
        },
        {
          "name": "--skip-tests",
          "description": "Skip the tests",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "package",
      "description": "Package compiled code (JAR/WAR)",
      "examples": [
        "mvn package"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--skip-tests",
          "description": "Skip the tests",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--threads",
          "description": "Parallel build threads",
          "type": "string",
          "takesValue": true,
          "short": "-T",
          "shorthand": "-T"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install to local repository",
      "examples": [
        "mvn install"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--skip-tests",
          "description": "Skip the tests",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--offline",
          "description": "Build without network access",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy to remote repository",
      "examples": [
        "mvn deploy"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--settings",
          "description": "Settings file to use",
          "type": "file",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "verify",
      "description": "Run integration tests",
      "examples": [
        "mvn verify"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--profile",
          "description": "Profiles to activate",
          "type": "string",
          "takesValue": true,
          "short": "-P",
          "shorthand": "-P"
        }
      ]
    },
    {
      "name": "site",
      "description": "Generate project site documentation",
      "examples": [
        "mvn site"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        }
      ]
    },
    {
      "name": "dependency:tree",
      "description": "Show dependency tree",
      "examples": [
        "mvn dependency:tree"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--Dincludes",
          "description": "Only these dependencies",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "dependency:resolve",
      "description": "Resolve dependencies",
      "examples": [
        "mvn dependency:resolve"
      ],
      "options": [
        {
          "name": "--offline",
          "description": "Resolve from the local repository",
          "type": "boolean",
          "takesValue": false,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "versions:display-dependency-updates",
      "description": "Show available dependency updates",
      "examples": [
        "mvn versions:display-dependency-updates"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        }
      ]
    },
    {
      "name": "archetype:generate",
      "description": "Generate project from archetype",
      "examples": [
        "mvn archetype:generate -DgroupId=com.example -DartifactId=myapp -DarchetypeArtifactId=maven-archetype-quickstart"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--batch-mode",
          "description": "Run non-interactively",
          "type": "boolean",
          "takesValue": false,
          "short": "-B",
          "shorthand": "-B"
        }
      ]
    },
    {
      "name": "spring-boot:run",
      "description": "Run Spring Boot application",
      "examples": [
        "mvn spring-boot:run"
      ],
      "options": [
        {
          "name": "--define",
          "description": "Define a property, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-D",
          "shorthand": "-D"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "short": "-v",
      "description": "Show version",
      "shorthand": "-v"
    },
    {
      "name": "-DskipTests",
      "description": "Skip running tests"
    },
    {
      "name": "-Dmaven.test.skip",
      "description": "Skip compiling and running tests"
    },
    {
      "name": "-P",
      "description": "Activate profile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-pl",
      "description": "Build specific modules",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-am",
      "description": "Also build dependencies"
    },
    {
      "name": "-U",
      "description": "Force update of snapshots"
    },
    {
      "name": "-o",
      "description": "Offline mode"
    },
    {
      "name": "-X",
      "description": "Debug output"
    },
    {
      "name": "-f",
      "description": "Use alternate POM file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-T",
      "description": "Thread count for parallel build",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "mvn clean install",
    "mvn clean package -DskipTests",
    "mvn test -pl module-name",
    "mvn clean install -P production",
    "mvn dependency:tree",
    "mvn clean package -T 4"
  ],
  "relatedCommands": [
    "gradle",
    "java",
    "javac",
    "ant"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Maven version",
        "command": "mvn --version 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mvn"
      },
      {
        "name": "project",
        "description": "Maven project coordinates",
        "command": "grep -m4 -E '<(groupId|artifactId|version|packaging)>' pom.xml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "modules",
        "description": "Modules in this Maven build",
        "command": "grep -A15 '<modules>' pom.xml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "settings",
        "description": "Maven settings and configured repositories",
        "command": "grep -o '<id>[^<]*</id>' ~/.m2/settings.xml 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
