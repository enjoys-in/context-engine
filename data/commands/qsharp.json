{
  "language": "qsharp",
  "name": "dotnet",
  "description": "Q# — quantum computing language via .NET SDK",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--project",
      "description": "Path to Q# project file (.csproj)"
    },
    {
      "name": "--configuration",
      "description": "Build configuration (Debug, Release)"
    },
    {
      "name": "--simulator",
      "description": "Quantum simulator to use"
    },
    {
      "name": "--verbosity",
      "description": "Output verbosity level (q, m, n, d, diag)"
    },
    {
      "name": "--output",
      "description": "Output directory"
    },
    {
      "name": "--framework",
      "description": "Target framework"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    }
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a Q# project",
      "args": [],
      "options": [
        {
          "name": "--project",
          "description": "Project or solution file to act on",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--simulator",
          "description": "Quantum simulator to run against",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "build",
      "description": "Build a Q# project",
      "args": [],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration (Debug, Release)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "new -lang Q# -o project",
      "description": "Create a new Q# project from template",
      "args": [
        {
          "name": "name",
          "description": "Name for the new Q# project",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output",
          "description": "Directory to place the project in",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--name",
          "description": "Name for the new project",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run Q# unit tests",
      "args": [],
      "options": [
        {
          "name": "--filter",
          "description": "Expression selecting which tests to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--logger",
          "description": "Test logger, e.g. trx or console",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "add package",
      "description": "Add a Q# / NuGet package to project",
      "args": [
        {
          "name": "package",
          "description": "Package to add",
          "type": "package",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--version",
          "description": "Package version to add",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish Q# project for distribution",
      "args": [],
      "options": [
        {
          "name": "--output",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--configuration",
          "description": "Build configuration (Debug, Release)",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "dotnet new console -lang Q# -o QuantumApp",
    "dotnet run --project QuantumApp",
    "dotnet build --configuration Release",
    "dotnet add package Microsoft.Quantum.Standard",
    "dotnet test --filter \"TestCategory=Quantum\""
  ],
  "relatedCommands": [
    "dotnet",
    "csharp",
    "python",
    "az"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": ".NET SDK version for Q#",
        "command": "dotnet --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "qsharp_projects",
        "description": "Q# projects here",
        "command": "grep -rl 'Microsoft.Quantum' --include='*.csproj' . 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "sources",
        "description": "Q# sources",
        "command": "find . -maxdepth 3 -name '*.qs' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
