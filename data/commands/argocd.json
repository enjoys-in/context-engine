{
  "name": "argocd",
  "description": "Argo CD CLI for declarative GitOps continuous delivery on Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Login to Argo CD server",
      "examples": [
        "argocd login argocd.example.com",
        "argocd login argocd.example.com --username admin --password secret",
        "argocd login argocd.example.com --sso",
        "argocd login argocd.example.com --insecure"
      ],
      "options": [
        {
          "name": "--username",
          "description": "Username to authenticate as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--sso",
          "description": "Authenticate through the configured SSO provider",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--insecure",
          "description": "Skip server certificate verification",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--grpc-web",
          "description": "Use gRPC-web, for proxies that block HTTP/2",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--name",
          "description": "Context name to save the session under",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "app",
      "description": "Manage applications",
      "examples": [
        "argocd app list",
        "argocd app create my-app --repo https://github.com/org/repo.git --path k8s --dest-server https://kubernetes.default.svc --dest-namespace default",
        "argocd app get my-app",
        "argocd app sync my-app",
        "argocd app sync my-app --prune",
        "argocd app diff my-app",
        "argocd app history my-app",
        "argocd app rollback my-app 1",
        "argocd app set my-app --values values-prod.yaml",
        "argocd app wait my-app",
        "argocd app delete my-app",
        "argocd app logs my-app",
        "argocd app manifests my-app",
        "argocd app terminate-op my-app",
        "argocd app resources my-app"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format (json, yaml, wide, name)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--refresh",
          "description": "Refresh application state from git before reporting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--selector",
          "description": "Label selector to filter by",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        }
      ]
    },
    {
      "name": "proj",
      "description": "Manage projects",
      "examples": [
        "argocd proj list",
        "argocd proj create my-project",
        "argocd proj get my-project",
        "argocd proj add-source my-project https://github.com/org/repo.git",
        "argocd proj add-destination my-project https://kubernetes.default.svc default",
        "argocd proj delete my-project"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format (json, yaml, wide, name)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--description",
          "description": "Project description",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dest",
          "description": "Permitted destination, server,namespace",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--src",
          "description": "Permitted source repository URL",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "repo",
      "description": "Manage repository connections",
      "examples": [
        "argocd repo add https://github.com/org/repo.git",
        "argocd repo add https://github.com/org/repo.git --ssh-private-key-path ~/.ssh/id_rsa",
        "argocd repo list",
        "argocd repo rm https://github.com/org/repo.git"
      ],
      "options": [
        {
          "name": "--username",
          "description": "Username for repository access",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password or token",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ssh-private-key-path",
          "description": "SSH key for repository access",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--insecure-skip-server-verification",
          "description": "Skip host key verification",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--type",
          "description": "Repository type (git, helm)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Name for a Helm repository",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cluster",
      "description": "Manage cluster connections",
      "examples": [
        "argocd cluster add my-context",
        "argocd cluster list",
        "argocd cluster get https://kubernetes.default.svc",
        "argocd cluster rm https://1.2.3.4"
      ],
      "options": [
        {
          "name": "--in-cluster",
          "description": "Use the in-cluster API server address",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--name",
          "description": "Name to register the cluster under",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--upsert",
          "description": "Overwrite an existing registration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--service-account",
          "description": "Service account to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "account",
      "description": "Manage accounts",
      "examples": [
        "argocd account list",
        "argocd account get --account admin",
        "argocd account update-password",
        "argocd account generate-token --account my-account",
        "argocd account can-i sync applications '*'"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format (json, yaml, wide, name)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--account",
          "description": "Account to act on",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cert",
      "description": "Manage repository certificates",
      "examples": [
        "argocd cert add-tls example.com --from server.crt",
        "argocd cert list",
        "argocd cert rm example.com"
      ],
      "options": [
        {
          "name": "--type",
          "description": "Certificate type (ssh, https)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from",
          "description": "File to read the certificate from",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "gpg",
      "description": "Manage GnuPG keys",
      "examples": [
        "argocd gpg add --from pubkey.gpg",
        "argocd gpg list",
        "argocd gpg rm KEYID"
      ]
    },
    {
      "name": "repocreds",
      "description": "Manage repository credentials",
      "examples": [
        "argocd repocreds add https://github.com/org --username user --password token",
        "argocd repocreds list"
      ]
    },
    {
      "name": "appset",
      "description": "Manage ApplicationSets",
      "examples": [
        "argocd appset list",
        "argocd appset create appset.yaml",
        "argocd appset get my-appset",
        "argocd appset delete my-appset"
      ]
    },
    {
      "name": "admin",
      "description": "Admin tools",
      "examples": [
        "argocd admin cluster kubeconfig",
        "argocd admin dashboard",
        "argocd admin settings validate"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace holding the Argo CD installation",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "logout",
      "description": "Logout",
      "examples": [
        "argocd logout argocd.example.com"
      ]
    },
    {
      "name": "context",
      "description": "Manage CLI contexts",
      "examples": [
        "argocd context",
        "argocd context argocd.example.com"
      ],
      "options": [
        {
          "name": "--delete",
          "description": "Remove the named context",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "argocd version",
        "argocd version --client"
      ],
      "options": [
        {
          "name": "--client",
          "description": "Print only the client version",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--short",
          "description": "Print just the version number",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--server",
      "description": "Argo CD server address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--auth-token",
      "description": "Auth token",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--grpc-web",
      "description": "Use gRPC-web"
    },
    {
      "name": "--insecure",
      "description": "Skip TLS verify"
    },
    {
      "name": "--plaintext",
      "description": "Use plaintext connection"
    },
    {
      "name": "--port-forward",
      "description": "Port-forward to ArgoCD"
    },
    {
      "name": "--port-forward-namespace",
      "description": "Namespace for port-forward",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--header",
      "description": "Additional headers",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "argocd login argocd.example.com",
    "argocd app list",
    "argocd app create my-app --repo https://github.com/org/repo.git --path deploy --dest-server https://kubernetes.default.svc",
    "argocd app sync my-app",
    "argocd app get my-app",
    "argocd repo add https://github.com/org/repo.git",
    "argocd cluster add my-context",
    "argocd account update-password",
    "argocd proj list",
    "argocd appset list",
    "argocd version"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "flux",
    "kustomize",
    "git"
  ]
}
