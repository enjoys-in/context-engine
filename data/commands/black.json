{
  "name": "black",
  "description": "The uncompromising Python code formatter",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--check",
      "description": "Report which files would change and exit non-zero",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--diff",
      "description": "Print the diff instead of writing",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--line-length",
      "description": "Maximum line length",
      "type": "integer",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--target-version",
      "description": "Python version to target (py38, py312)",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--skip-string-normalization",
      "description": "Leave string quotes as written",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--skip-magic-trailing-comma",
      "description": "Ignore an existing trailing comma",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--preview",
      "description": "Enable unstable style changes",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--include",
      "description": "Regex of files to include",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Regex of files to skip",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--fast",
      "description": "Skip the AST-equivalence safety check",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "black .",
      "description": "Format the current tree"
    },
    {
      "command": "black --check --diff .",
      "description": "Show what would change without writing"
    },
    {
      "command": "black -l 100 src/",
      "description": "Format with a 100-column limit"
    }
  ],
  "relatedCommands": [
    "ruff",
    "isort",
    "flake8",
    "autopep8"
  ]
}
