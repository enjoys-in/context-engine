{
  "name": "pipx",
  "description": "Install and run Python applications in isolated environments",
  "category": "python-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a package",
      "args": [
        {
          "name": "package",
          "description": "Package to install",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed_packages"
          }
        }
      ],
      "options": [
        {
          "name": "--include-deps",
          "description": "Include app deps"
        },
        {
          "name": "--force",
          "shorthand": "-f",
          "description": "Force reinstall",
          "short": "-f"
        },
        {
          "name": "--suffix",
          "description": "Suffix for command names",
          "takesValue": true
        },
        {
          "name": "--python",
          "description": "Python interpreter",
          "takesValue": true
        },
        {
          "name": "--pip-args",
          "description": "Extra pip args",
          "takesValue": true
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall a package",
      "args": [
        {
          "name": "package",
          "description": "Package to uninstall",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed_packages"
          }
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "uninstall-all",
      "description": "Uninstall all packages",
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "reinstall",
      "description": "Reinstall a package",
      "args": [
        {
          "name": "package",
          "description": "Package to reinstall",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed_packages"
          }
        }
      ],
      "options": [
        {
          "name": "--python",
          "description": "Python interpreter to reinstall with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "reinstall-all",
      "description": "Reinstall all packages",
      "options": [
        {
          "name": "--python",
          "description": "Python interpreter",
          "takesValue": true
        }
      ]
    },
    {
      "name": "inject",
      "description": "Install extra packages into an app's venv",
      "args": [
        {
          "name": "package",
          "description": "App to inject into",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed_packages"
          }
        },
        {
          "name": "dependencies",
          "description": "Packages to inject",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--include-apps",
          "description": "Also expose the injected package's apps",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--include-deps",
          "description": "Include the package dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Reinstall the injected package",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade a package",
      "args": [
        {
          "name": "package",
          "description": "Package to upgrade",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed_packages"
          }
        }
      ],
      "options": [
        {
          "name": "--include-injected",
          "description": "Also upgrade injected packages"
        }
      ]
    },
    {
      "name": "upgrade-all",
      "description": "Upgrade all packages",
      "options": [
        {
          "name": "--include-injected",
          "description": "Also upgrade injected packages"
        }
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        {
          "name": "--short",
          "description": "Short format"
        },
        {
          "name": "--json",
          "description": "JSON output"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a package without installing",
      "args": [
        {
          "name": "package",
          "description": "Package to run",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed_packages"
          }
        }
      ],
      "options": [
        {
          "name": "--spec",
          "description": "Package spec",
          "takesValue": true
        },
        {
          "name": "--python",
          "description": "Python interpreter",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ensurepath",
      "description": "Ensure pipx paths are in PATH",
      "options": [
        {
          "name": "--force",
          "description": "Add the path even if it looks present",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "environment",
      "description": "Show pipx environment info",
      "options": [
        {
          "name": "--value",
          "description": "Print just this environment value",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "description": "Verbose output"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    }
  ],
  "examples": [
    {
      "command": "pipx install black",
      "description": "Install black formatter"
    },
    {
      "command": "pipx run cowsay hello",
      "description": "Run cowsay without installing"
    },
    {
      "command": "pipx list",
      "description": "List installed packages"
    },
    {
      "command": "pipx upgrade-all",
      "description": "Upgrade all packages"
    },
    {
      "command": "pipx inject poetry poetry-plugin-export",
      "description": "Inject plugin into poetry venv"
    }
  ],
  "relatedCommands": [
    "pip",
    "python",
    "poetry"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed_packages",
        "description": "Packages installed via pipx",
        "command": "pipx list --short 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "pipx"
      },
      {
        "name": "python_version",
        "description": "Default Python version",
        "command": "python3 --version 2>/dev/null || python --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
