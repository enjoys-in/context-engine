{
  "name": "gotestsum",
  "description": "Run go test with readable output and JUnit reports",
  "category": "go",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--format",
      "description": "Output format (dots, testname, pkgname, standard-verbose)",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--junitfile",
      "description": "Write a JUnit XML report here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--jsonfile",
      "description": "Write the raw test JSON here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--rerun-fails",
      "description": "Retry failing tests this many times",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--packages",
      "description": "Packages to test",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--watch",
      "description": "Re-run tests when files change",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--post-run-command",
      "description": "Command to run after each run",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--format-hide-empty-pkg",
      "description": "Hide packages with no tests",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--raw-command",
      "description": "Treat the arguments as a full command",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "gotestsum",
      "description": "Run the tests with readable output"
    },
    {
      "command": "gotestsum -f testname ./...",
      "description": "Show each test name"
    },
    {
      "command": "gotestsum --junitfile report.xml ./...",
      "description": "Produce a JUnit report for CI"
    },
    {
      "command": "gotestsum --watch",
      "description": "Re-run tests on change"
    }
  ],
  "relatedCommands": [
    "go",
    "gotest",
    "golangci-lint",
    "task"
  ]
}
