{
  "name": "react-native",
  "description": "React Native CLI",
  "category": "mobile",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Starts the Metro bundler",
      "options": [
        {
          "name": "--port",
          "description": "Port the packager binds to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--reset-cache",
          "description": "Clear the transform cache first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--host",
          "description": "Host the packager binds to",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "react-native start"
      ]
    },
    {
      "name": "run-android",
      "description": "Builds your app and starts it on a connected Android emulator or device",
      "options": [
        {
          "name": "--variant",
          "description": "Build variant to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--device-id",
          "description": "Device to install onto",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Packager port to connect to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--no-packager",
          "description": "Do not start the packager",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "react-native run-android"
      ]
    },
    {
      "name": "run-ios",
      "description": "Builds your app and starts it on iOS simulator",
      "options": [
        {
          "name": "--simulator",
          "description": "Simulator to launch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--device",
          "description": "Physical device to install onto",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--scheme",
          "description": "Xcode scheme to build",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "react-native run-ios"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Print detailed output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "npx react-native start",
      "description": "Start Metro"
    },
    {
      "command": "npx react-native run-android",
      "description": "Run on Android"
    }
  ],
  "relatedCommands": [
    "expo",
    "adb",
    "pod",
    "npm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "metro_config",
        "description": "Metro Configuration",
        "command": "cat metro.config.js 2>/dev/null | head -10",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
