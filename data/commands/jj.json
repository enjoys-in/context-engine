{
  "name": "jj",
  "description": "Jujutsu — a git-compatible version control system",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Create a repository",
      "options": [
        {
          "name": "--git",
          "description": "Use the git backend",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--git-repo",
          "description": "Colocate with this git repository",
          "type": "directory",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "destination",
          "description": "Directory to initialise",
          "type": "directory",
          "required": false
        }
      ],
      "examples": [
        "jj init ./dist"
      ]
    },
    {
      "name": "status",
      "description": "Show the working copy changes",
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        }
      ],
      "examples": [
        "jj status"
      ]
    },
    {
      "name": "log",
      "description": "Show the commit graph",
      "options": [
        {
          "name": "--revisions",
          "description": "Revset to display",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--limit",
          "description": "Maximum commits to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--template",
          "description": "Output template",
          "type": "string",
          "takesValue": true,
          "short": "-T",
          "shorthand": "-T"
        },
        {
          "name": "--patch",
          "description": "Include the diff",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "revisions",
          "description": "Revset to display",
          "required": false,
          "type": "string"
        }
      ],
      "examples": [
        "jj log revisions"
      ]
    },
    {
      "name": "diff",
      "description": "Show changes",
      "options": [
        {
          "name": "--revision",
          "description": "Revision to diff",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--from",
          "description": "Diff from this revision",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--to",
          "description": "Diff to this revision",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--stat",
          "description": "Show a diffstat",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "paths",
          "description": "Limit the diff to these paths",
          "required": false,
          "type": "path"
        }
      ],
      "examples": [
        "jj diff ./src"
      ]
    },
    {
      "name": "new",
      "description": "Create a new empty change",
      "options": [
        {
          "name": "--message",
          "description": "Description for the change",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        }
      ],
      "args": [
        {
          "name": "parents",
          "description": "Parent revisions",
          "type": "string",
          "required": false
        }
      ],
      "examples": [
        "jj new parents"
      ]
    },
    {
      "name": "describe",
      "description": "Set the description of a change",
      "options": [
        {
          "name": "--message",
          "description": "Description text",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to describe",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "args": [
        {
          "name": "revision",
          "description": "Revision to describe",
          "required": false,
          "type": "string"
        }
      ],
      "examples": [
        "jj describe revision"
      ]
    },
    {
      "name": "commit",
      "description": "Describe the working copy and start a new change",
      "options": [
        {
          "name": "--message",
          "description": "Description text",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        }
      ],
      "examples": [
        "jj commit"
      ]
    },
    {
      "name": "edit",
      "description": "Make a revision the working copy",
      "args": [
        {
          "name": "revision",
          "description": "Revision to edit",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--ignore-immutable",
          "description": "Allow rewriting immutable commits",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "jj edit revision"
      ]
    },
    {
      "name": "rebase",
      "description": "Move revisions elsewhere in the graph",
      "options": [
        {
          "name": "--revision",
          "description": "Revision to move",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--source",
          "description": "Move this revision and its descendants",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--destination",
          "description": "New parent",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--branch",
          "description": "Move a whole branch",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        }
      ],
      "examples": [
        "jj rebase"
      ]
    },
    {
      "name": "squash",
      "description": "Move changes into the parent revision",
      "options": [
        {
          "name": "--revision",
          "description": "Revision to squash",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--interactive",
          "description": "Choose the changes to move",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ],
      "examples": [
        "jj squash"
      ]
    },
    {
      "name": "split",
      "description": "Split a revision in two",
      "options": [
        {
          "name": "--revision",
          "description": "Revision to split",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--interactive",
          "description": "Choose the changes for the first part",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ],
      "examples": [
        "jj split"
      ]
    },
    {
      "name": "abandon",
      "description": "Discard a revision, keeping its descendants",
      "args": [
        {
          "name": "revisions",
          "description": "Revisions to abandon",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--summary",
          "description": "Print a summary of what was abandoned",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--retain-bookmarks",
          "description": "Leave bookmarks pointing at the abandoned commits",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "jj abandon revisions"
      ]
    },
    {
      "name": "undo",
      "description": "Undo the last operation",
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        }
      ],
      "examples": [
        "jj undo"
      ]
    },
    {
      "name": "op",
      "description": "Inspect and restore the operation log",
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--limit",
          "description": "Number of operations to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "examples": [
        "jj op"
      ]
    },
    {
      "name": "bookmark",
      "description": "Manage bookmarks, the equivalent of git branches",
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--revision",
          "description": "Revision the bookmark points at",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "examples": [
        "jj bookmark"
      ]
    },
    {
      "name": "git",
      "description": "Interoperate with a git remote",
      "options": [
        {
          "name": "--repository",
          "description": "Repository to operate on",
          "type": "directory",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        }
      ],
      "examples": [
        "jj git"
      ]
    },
    {
      "name": "restore",
      "description": "Restore paths from another revision",
      "options": [
        {
          "name": "--from",
          "description": "Revision to restore from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--to",
          "description": "Revision to restore into",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "paths",
          "description": "Paths to restore",
          "required": false,
          "type": "path"
        }
      ],
      "examples": [
        "jj restore ./src"
      ]
    },
    {
      "name": "resolve",
      "description": "Resolve conflicts",
      "options": [
        {
          "name": "--list",
          "description": "List the conflicted paths",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "jj resolve"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--repository",
      "description": "Repository to operate on",
      "type": "directory",
      "takesValue": true,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--at-operation",
      "description": "Operate as of this operation id",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config-toml",
      "description": "Inline TOML configuration to apply",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--color",
      "description": "When to colour output (always, never, auto)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-pager",
      "description": "Do not page the output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress progress output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "jj git init --colocate",
      "description": "Start a jj repo alongside git"
    },
    {
      "command": "jj status",
      "description": "See the working copy changes"
    },
    {
      "command": "jj new -m \"add parser\"",
      "description": "Start a new described change"
    },
    {
      "command": "jj log -r ::@",
      "description": "Show the ancestry of the working copy"
    },
    {
      "command": "jj squash -i",
      "description": "Move selected changes into the parent"
    },
    {
      "command": "jj undo",
      "description": "Undo the last operation"
    }
  ],
  "relatedCommands": [
    "git",
    "gh",
    "tig",
    "lazygit",
    "hg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Jujutsu version",
        "command": "jj --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "jj"
      },
      {
        "name": "status",
        "description": "Working-copy status in this jj repo",
        "command": "jj status 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "jj"
      },
      {
        "name": "log",
        "description": "Recent revisions in this jj repo",
        "command": "jj log --no-graph -r 'ancestors(@, 10)' -T 'change_id.short() ++ \" \" ++ description.first_line() ++ \"\\n\"' 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "jj"
      },
      {
        "name": "colocated",
        "description": "Whether this repo is colocated with git",
        "command": "ls -d .jj .git 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "config",
        "description": "Jujutsu configuration",
        "command": "jj config list 2>/dev/null | head -20",
        "parser": "keyvalue",
        "cacheFor": 300,
        "requiresCmd": "jj"
      }
    ]
  }
}
