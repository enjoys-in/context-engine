{
  "name": "killall",
  "description": "Kill processes by name",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-s",
      "description": "Send specified signal",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-9",
      "description": "Send SIGKILL"
    },
    {
      "name": "-i",
      "description": "Ask for confirmation before killing"
    },
    {
      "name": "-v",
      "description": "Report if signal was sent"
    },
    {
      "name": "-w",
      "description": "Wait for processes to die"
    },
    {
      "name": "-u",
      "description": "Kill only processes owned by user",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "Require exact match for long names"
    },
    {
      "name": "--signal",
      "description": "Signal to send",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--interactive",
      "description": "Ask before killing each process",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--exact",
      "description": "Require an exact name match",
      "type": "boolean",
      "takesValue": false,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--ignore-case",
      "description": "Match the name case-insensitively",
      "type": "boolean",
      "takesValue": false,
      "short": "-I",
      "shorthand": "-I"
    },
    {
      "name": "--regexp",
      "description": "Treat the name as a regex",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--user",
      "description": "Only processes owned by this user",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--wait",
      "description": "Wait for the processes to die",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--quiet",
      "description": "Do not complain when nothing matches",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Report what is signalled",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--younger-than",
      "description": "Only processes younger than this",
      "type": "string",
      "takesValue": true,
      "short": "-y",
      "shorthand": "-y"
    },
    {
      "name": "--older-than",
      "description": "Only processes older than this",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--process-group",
      "description": "Kill the whole process group",
      "type": "boolean",
      "takesValue": false,
      "short": "-g",
      "shorthand": "-g"
    }
  ],
  "examples": [
    "killall firefox",
    "killall -9 node",
    "killall -i python",
    "killall -u www-data apache2",
    "killall -w myapp"
  ],
  "relatedCommands": [
    "kill",
    "pkill",
    "pgrep",
    "ps"
  ]
}
