{
  "language": "javascript",
  "name": "node",
  "description": "Node.js — JavaScript runtime CLI",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--inspect",
      "description": "Activate inspector on default port (9229)"
    },
    {
      "name": "--inspect-brk",
      "description": "Activate inspector and break on first line"
    },
    {
      "name": "--watch",
      "description": "Run in watch mode, restart on file changes"
    },
    {
      "name": "--experimental-modules",
      "description": "Enable experimental ES module support"
    },
    {
      "name": "--max-old-space-size=<MB>",
      "description": "Set V8 heap memory limit"
    },
    {
      "name": "--env-file",
      "description": "Load environment variables from a file"
    },
    {
      "name": "--test",
      "description": "Run Node.js built-in test runner"
    },
    {
      "name": "-r / --require",
      "description": "Preload a module before executing"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    }
  ],
  "subcommands": [
    {
      "name": "file.js",
      "description": "Run a JavaScript file",
      "args": [
        {
          "name": "file",
          "description": "JavaScript file to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--inspect",
          "description": "Enable the inspector",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--experimental-modules",
          "description": "Enable ES module support",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--max-old-space-size",
          "description": "Heap size limit in MB",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "node file.js"
      ]
    },
    {
      "name": "-e \"code\"",
      "description": "Evaluate JavaScript expression",
      "args": [
        {
          "name": "code",
          "description": "Code to execute",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--input-type",
          "description": "Treat the input as module or commonjs",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--print",
          "description": "Print the result",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "node -e \"code\""
      ]
    },
    {
      "name": "--inspect file.js",
      "description": "Run with Chrome DevTools debugger attached",
      "args": [
        {
          "name": "file",
          "description": "JavaScript file to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--inspect-brk",
          "description": "Break before the first line",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--inspect-port",
          "description": "Port for the inspector",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "node --inspect file.js"
      ]
    },
    {
      "name": "-p \"expression\"",
      "description": "Evaluate and print expression result",
      "args": [
        {
          "name": "expression",
          "description": "Expression to evaluate",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--input-type",
          "description": "Treat the input as module or commonjs",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "node -p \"expression\""
      ]
    },
    {
      "name": "--watch file.js",
      "description": "Watch for file changes and restart",
      "args": [
        {
          "name": "file",
          "description": "JavaScript file to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--watch-path",
          "description": "Additional path to watch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--watch-preserve-output",
          "description": "Do not clear the screen between runs",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "node --watch file.js"
      ]
    },
    {
      "name": "--test",
      "description": "Run built-in test runner",
      "args": [],
      "options": [
        {
          "name": "--test-reporter",
          "description": "Test reporter to use (spec, tap, dot, junit)",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "node --test"
      ]
    }
  ],
  "examples": [
    "node server.js",
    "node -e \"console.log(process.version)\"",
    "node --inspect-brk app.js",
    "node --watch src/index.js",
    "node --test 'test/**/*.test.js'",
    "node --max-old-space-size=4096 build.js"
  ],
  "relatedCommands": [
    "npm",
    "npx",
    "deno",
    "bun",
    "typescript"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Node.js version",
        "command": "node --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "node"
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "module_type",
        "description": "Whether this project is ESM or CommonJS",
        "command": "grep -o '\"type\": *\"[^\"]*\"' package.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "package_manager",
        "description": "Lockfile indicating the package manager",
        "command": "ls package-lock.json yarn.lock pnpm-lock.yaml bun.lockb 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
