{
  "name": "procs",
  "description": "Modern replacement for ps with colour and tree view",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--tree",
      "description": "Show the process tree",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--watch",
      "description": "Refresh continuously",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--sortd",
      "description": "Sort descending by this column",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sorta",
      "description": "Sort ascending by this column",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--or",
      "description": "Match any of the given keywords",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--and",
      "description": "Match all of the given keywords",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--thread",
      "description": "Include threads",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--insert",
      "description": "Add an extra column",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--pager",
      "description": "When to page (auto, always, disable)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "procs",
      "description": "List processes"
    },
    {
      "command": "procs --tree",
      "description": "Show the process tree"
    },
    {
      "command": "procs node",
      "description": "Filter to processes matching \"node\""
    },
    {
      "command": "procs --sortd cpu",
      "description": "Busiest processes first"
    }
  ],
  "relatedCommands": [
    "ps",
    "top",
    "htop",
    "btop",
    "kill"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "procs version",
        "command": "procs --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "procs"
      },
      {
        "name": "top_cpu",
        "description": "Processes by CPU usage",
        "command": "ps -eo pid,comm,pcpu --sort=-pcpu 2>/dev/null | head -15",
        "parser": "table",
        "cacheFor": 15
      },
      {
        "name": "config",
        "description": "procs configuration",
        "command": "cat ~/.config/procs/config.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
