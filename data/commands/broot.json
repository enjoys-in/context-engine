{
  "name": "broot",
  "description": "Navigate directory trees with a fuzzy, incremental view",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--sizes",
      "description": "Show file and directory sizes",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--hidden",
      "description": "Include hidden files",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--dates",
      "description": "Show modification dates",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--permissions",
      "description": "Show permissions",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--only-folders",
      "description": "Show directories only",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--sort-by-size",
      "description": "Sort by size",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--sort-by-date",
      "description": "Sort by modification date",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--cmd",
      "description": "Run these commands on start",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--install",
      "description": "Install the br shell function",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--conf",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--git-status",
      "description": "Show git status per file",
      "type": "boolean",
      "takesValue": false,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--height",
      "description": "Height in rows",
      "type": "integer",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "broot",
      "description": "Browse the current tree"
    },
    {
      "command": "br",
      "description": "Browse using the shell function, so cd applies"
    },
    {
      "command": "broot -s -d",
      "description": "Show sizes and dates"
    },
    {
      "command": "broot --install",
      "description": "Install the br shell function"
    }
  ],
  "relatedCommands": [
    "fd",
    "eza",
    "tree",
    "fzf",
    "zoxide"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "broot version",
        "command": "broot --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "broot"
      },
      {
        "name": "config",
        "description": "broot configuration",
        "command": "cat ~/.config/broot/conf.hjson 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "cwd_entries",
        "description": "Entries in the current directory",
        "command": "ls -A 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 30
      }
    ]
  }
}
