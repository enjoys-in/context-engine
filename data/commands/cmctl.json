{
  "name": "cmctl",
  "description": "cert-manager CLI — manage TLS certificates in Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "check api",
      "description": "Check cert-manager API",
      "examples": [
        "cmctl check api"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--wait",
          "description": "How long to wait for the API to become ready",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--interval",
          "description": "How often to retry the check",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "status certificate",
      "description": "Certificate status",
      "examples": [
        "cmctl status certificate my-cert",
        "cmctl status certificate my-cert -n my-ns"
