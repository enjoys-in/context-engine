          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--reason",
          "description": "Reason recorded for the denial",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--message",
          "description": "Message recorded for the denial",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "request",
          "description": "CertificateRequest to deny",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "create certificatesigningrequest",
      "description": "Create CSR",
      "examples": [
        "cmctl create csr my-csr --cert my-cert --output-certificate-file cert.pem --output-key-file key.pem"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--from-certificate-file",
          "description": "Certificate manifest to derive the request from",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--fetch-certificate",
          "description": "Wait for and write the signed certificate",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--output-certificate-file",
          "description": "Write the signed certificate here",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "convert",
      "description": "Convert config versions",
      "examples": [
        "cmctl convert -f old-issuer.yaml"
