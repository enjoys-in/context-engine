          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--reason",
          "description": "Reason recorded for the approval",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--message",
          "description": "Message recorded for the approval",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "request",
          "description": "CertificateRequest to approve",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "deny",
      "description": "Deny CertificateRequest",
      "examples": [
        "cmctl deny my-cr -n my-ns"
