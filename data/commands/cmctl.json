  "globalOptions": [
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--all-namespaces",
      "short": "-A",
      "description": "All namespaces",
      "shorthand": "-A"
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "cmctl check api",
    "cmctl status certificate my-cert",
    "cmctl renew my-cert",
    "cmctl inspect secret my-tls-secret",
    "cmctl approve my-cr",
    "cmctl version",
    "cmctl install"
  ],
  "relatedCommands": [
    "kubectl",
    "openssl",
    "helm",
    "mkcert"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "cert-manager CLI version",
        "command": "cmctl version --client 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cmctl"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "certificates",
        "description": "cert-manager Certificates in the active namespace",
        "command": "kubectl get certificates 2>/dev/null",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "issuers",
        "description": "cert-manager Issuers and ClusterIssuers",
        "command": "kubectl get issuers,clusterissuers 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "kubectl"
      }
    ]
  }
}
