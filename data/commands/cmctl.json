          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "renew",
      "description": "Renew certificates",
      "examples": [
        "cmctl renew my-cert",
        "cmctl renew --all-namespaces",
        "cmctl renew -l app=web -n my-ns"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--all",
          "description": "Renew every certificate in the namespace",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all-namespaces",
          "description": "Renew certificates in every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--selector",
          "description": "Label selector to match certificates",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        }
      ],
      "args": [
        {
          "name": "certificate",
          "description": "Certificate to renew",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "approve",
      "description": "Approve CertificateRequest",
      "examples": [
        "cmctl approve my-cr -n my-ns"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
