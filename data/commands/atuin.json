{
  "name": "atuin",
  "description": "Shell history replacement with sync and search",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "search",
      "description": "Search the history",
      "options": [
        {
          "name": "--interactive",
          "description": "Open the interactive search",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--limit",
          "description": "Maximum results",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--exit",
          "description": "Filter by exit code",
          "type": "integer",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--cwd",
          "description": "Filter by working directory",
          "type": "directory",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--before",
          "description": "Only entries before this time",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--after",
          "description": "Only entries after this time",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "query",
          "description": "Text to search for",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "import",
      "description": "Import history from the shell",
      "args": [
        {
          "name": "shell",
          "description": "Source shell (auto, bash, zsh, fish)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "stats",
      "description": "Show statistics about your history",
      "options": [
        {
          "name": "--count",
          "description": "Number of rows to show",
          "type": "integer",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "sync",
      "description": "Sync with the server",
      "options": [
        {
          "name": "--force",
          "description": "Force a full re-sync",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "login",
      "description": "Log in to a sync server",
      "options": [
        {
          "name": "--username",
          "description": "Account username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--password",
          "description": "Account password",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--key",
          "description": "Encryption key",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ]
    },
    {
      "name": "register",
      "description": "Create a sync account",
      "options": [
        {
          "name": "--username",
          "description": "Account username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--email",
          "description": "Account email",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "logout",
      "description": "Log out of the sync server"
    },
    {
      "name": "key",
      "description": "Print the encryption key"
    },
    {
      "name": "init",
      "description": "Print the shell integration snippet",
      "options": [
        {
          "name": "--disable-up-arrow",
          "description": "Do not bind the up arrow",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--disable-ctrl-r",
          "description": "Do not bind Ctrl-R",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "history",
      "description": "Manage history entries"
    },
    {
      "name": "doctor",
      "description": "Report configuration and environment problems"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "atuin import auto",
      "description": "Import your existing shell history"
    },
    {
      "command": "eval \"$(atuin init zsh)\"",
      "description": "Enable the shell integration"
    },
    {
      "command": "atuin search --interactive",
      "description": "Open the interactive search"
    },
    {
      "command": "atuin stats",
      "description": "Show history statistics"
    }
  ],
  "relatedCommands": [
    "history",
    "fzf",
    "zoxide",
    "starship"
  ]
}
