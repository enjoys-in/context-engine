{
  "name": "lsof",
  "description": "List open files",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-i",
      "description": "List files with network connections",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "List files opened by PID",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-u",
      "description": "List files opened by user",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "List files opened by command name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "+D",
      "description": "List files in directory (recursive)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Terse output (PIDs only)"
    },
    {
      "name": "-n",
      "description": "No host name resolution"
    },
    {
      "name": "-P",
      "description": "No port name resolution"
    },
    {
      "name": "--pid",
      "description": "Only these process ids",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--user",
      "description": "Only these users",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--internet",
      "description": "Only network files; optionally TCP or UDP",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--command",
      "description": "Only processes whose command matches",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--no-hostname",
      "description": "Do not resolve hostnames",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--no-port-name",
      "description": "Do not resolve port names",
      "type": "boolean",
      "takesValue": false,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--repeat",
      "description": "Repeat the listing every N seconds",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--terse",
      "description": "Print only process ids",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--all",
      "description": "Combine the selection filters with AND",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--dir",
      "description": "Files open under this directory",
      "type": "directory",
      "takesValue": true,
      "short": "+D",
      "shorthand": "+D"
    },
    {
      "name": "--file-system",
      "description": "Report the filesystem for each file",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    }
  ],
  "examples": [
    "lsof -i :8080",
    "lsof -i TCP",
    "lsof -p 1234",
    "lsof -u root",
    "lsof +D /var/log",
    "lsof -t -i :3000 | xargs kill",
    "lsof -i -n -P"
  ],
  "relatedCommands": [
    "fuser",
    "netstat",
    "ss",
    "ps"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "lsof version",
        "command": "lsof -v 2>&1 | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "lsof"
      },
      {
        "name": "listening_ports",
        "description": "Processes listening on TCP ports",
        "command": "lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "lsof"
      },
      {
        "name": "cwd_open",
        "description": "Open files under the current directory",
        "command": "lsof +D . 2>/dev/null | head -15",
        "parser": "table",
        "cacheFor": 15,
        "requiresCmd": "lsof"
      }
    ]
  }
}
