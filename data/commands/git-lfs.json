{
  "name": "git-lfs",
  "description": "Git Large File Storage — manage large files with Git",
  "category": "git",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Set up Git LFS",
      "examples": [
        "git lfs install"
      ],
      "options": [
        {
          "name": "--local",
          "description": "Configure this repository only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--system",
          "description": "Configure system-wide",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Overwrite existing hooks",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-smudge",
          "description": "Skip the smudge filter for faster clones",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "track",
      "description": "Track file patterns",
      "examples": [
        "git lfs track '*.psd'",
        "git lfs track '*.zip'"
      ],
      "options": [
        {
          "name": "--lockable",
          "description": "Mark the pattern as lockable",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--filename",
          "description": "Treat the pattern as a literal filename",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "untrack",
      "description": "Stop tracking patterns",
      "examples": [
        "git lfs untrack '*.psd'"
      ],
      "options": []
    },
    {
      "name": "ls-files",
      "description": "List tracked LFS files",
      "examples": [
        "git lfs ls-files"
      ],
      "options": [
        {
          "name": "--long",
          "description": "Show the full object id",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--size",
          "description": "Show each object's size",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--all",
          "description": "List every object in history",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name-only",
          "description": "Print file names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "fetch",
      "description": "Download LFS objects",
      "examples": [
        "git lfs fetch"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Fetch every object in history",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--recent",
          "description": "Fetch objects for recent commits",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--prune",
          "description": "Prune old objects afterwards",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "pull",
      "description": "Fetch and checkout LFS files",
      "examples": [
        "git lfs pull"
      ],
      "options": [
        {
          "name": "--include",
          "description": "Only pull paths matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--exclude",
          "description": "Skip paths matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-X",
          "shorthand": "-X"
        }
      ],
      "args": [
        {
          "name": "remote",
          "description": "Remote to pull objects from",
          "required": false,
          "type": "remote"
        }
      ]
    },
    {
      "name": "push",
      "description": "Push LFS objects",
      "examples": [
        "git lfs push origin main"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Push every object in history",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would be pushed",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--object-id",
          "description": "Push these object ids",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "remote",
          "description": "Remote to push objects to",
          "required": false,
          "type": "remote"
        }
      ]
    },
    {
      "name": "status",
      "description": "Show LFS status",
      "examples": [
        "git lfs status"
      ],
      "options": [
        {
          "name": "--porcelain",
          "description": "Machine-readable output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "migrate",
      "description": "Migrate existing files to LFS",
      "examples": [
        "git lfs migrate import --include='*.bin'"
      ],
      "options": [
        {
          "name": "--include",
          "description": "Only migrate paths matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--exclude",
          "description": "Skip paths matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-X",
          "shorthand": "-X"
        },
        {
          "name": "--everything",
          "description": "Migrate every ref",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--include-ref",
          "description": "Only migrate this ref",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "git lfs install",
    "git lfs track '*.psd'",
    "git lfs ls-files",
    "git lfs migrate import --include='*.bin'",
    "git lfs fetch --all"
  ],
  "relatedCommands": [
    "git",
    "github-cli",
    "gitlab-cli"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Git LFS version",
        "command": "git-lfs version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "git-lfs"
      },
      {
        "name": "tracked_patterns",
        "description": "Patterns tracked by Git LFS",
        "command": "git lfs track 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "git"
      },
      {
        "name": "files",
        "description": "Files Git LFS is managing",
        "command": "git lfs ls-files 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "git"
      },
      {
        "name": "attributes",
        "description": "LFS filters declared in .gitattributes",
        "command": "grep lfs .gitattributes 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "env",
        "description": "Git LFS endpoint and storage configuration",
        "command": "git lfs env 2>/dev/null | head -15",
        "parser": "keyvalue",
        "cacheFor": 300,
        "requiresCmd": "git"
      }
    ]
  }
}
