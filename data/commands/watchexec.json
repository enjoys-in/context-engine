{
  "name": "watchexec",
  "description": "Run a command when files change",
  "category": "environment",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--exts",
      "description": "Only watch these extensions",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--watch",
      "description": "Path to watch",
      "type": "path",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--clear",
      "description": "Clear the screen before each run",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--restart",
      "description": "Restart the command instead of waiting",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--signal",
      "description": "Signal to send on restart",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--debounce",
      "description": "Milliseconds to coalesce events",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--ignore",
      "description": "Glob to ignore",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--no-vcs-ignore",
      "description": "Do not honour .gitignore",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--postpone",
      "description": "Wait for the first change before running",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--shell",
      "description": "Shell to run the command in",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--on-busy-update",
      "description": "What to do while running (queue, do-nothing, restart, signal)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--project-origin",
      "description": "Directory to treat as the project root",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "watchexec -e rs cargo test",
      "description": "Run tests when Rust files change"
    },
    {
      "command": "watchexec -r -e go go run .",
      "description": "Restart a server on change"
    },
    {
      "command": "watchexec -c -w src npm run build",
      "description": "Clear the screen and rebuild"
    },
    {
      "command": "watchexec -i \"target/**\" make",
      "description": "Rebuild while ignoring a directory"
    }
  ],
  "relatedCommands": [
    "entr",
    "nodemon",
    "air",
    "task",
    "fswatch"
  ]
}
