{
  "name": "aws-vault",
  "description": "A vault for securely storing and accessing AWS credentials in development environments",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "exec",
      "description": "Execute a command with AWS credentials",
      "args": [
        {
          "name": "profile",
          "description": "AWS profile name to use",
          "required": true,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        },
        {
          "name": "command",
          "description": "Command to execute",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--duration",
          "shorthand": "-d",
          "description": "Duration of the temporary credentials",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--no-session",
          "description": "Use master credentials without session token"
        },
        {
          "name": "--json",
          "shorthand": "-j",
          "description": "Output credentials as JSON",
          "short": "-j"
        },
        {
          "name": "--server",
          "description": "Run a credential server"
        },
        {
          "name": "--region",
          "description": "Override the AWS region",
          "takesValue": true
        },
        {
          "name": "--mfa-token",
          "shorthand": "-t",
          "description": "The MFA token to use",
          "takesValue": true,
          "short": "-t"
        }
      ],
      "examples": [
        "aws-vault exec default command"
      ]
    },
    {
      "name": "add",
      "description": "Add credentials to the vault",
      "args": [
        {
          "name": "profile",
          "description": "AWS profile name",
          "required": true,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        }
      ],
      "options": [
        {
          "name": "--env",
          "description": "Read credentials from environment variables"
        }
      ],
      "examples": [
        "aws-vault add default"
      ]
    },
    {
      "name": "list",
      "description": "List profiles and credentials stored in the vault",
      "options": [
        {
          "name": "--profiles",
          "description": "Only list profile names"
        },
        {
          "name": "--credentials",
          "description": "Only list credential names"
        }
      ],
      "examples": [
        "aws-vault list"
      ]
    },
    {
      "name": "remove",
      "description": "Remove credentials from the vault",
      "args": [
        {
          "name": "profile",
          "description": "AWS profile name to remove",
          "required": true,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        }
      ],
      "options": [
        {
          "name": "--sessions-only",
          "description": "Only remove sessions, keep credentials"
        }
      ],
      "examples": [
        "aws-vault remove default"
      ]
    },
    {
      "name": "rotate",
      "description": "Rotate credentials",
      "args": [
        {
          "name": "profile",
          "description": "AWS profile to rotate",
          "required": true,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        }
      ],
      "options": [
        {
          "name": "--no-session",
          "description": "Use master credentials without session token"
        }
      ],
      "examples": [
        "aws-vault rotate default"
      ]
    },
    {
      "name": "login",
      "description": "Generate a login link for the AWS Console",
      "args": [
        {
          "name": "profile",
          "description": "AWS profile to login with",
          "required": true,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        }
      ],
      "options": [
        {
          "name": "--duration",
          "shorthand": "-d",
          "description": "Duration of the console session",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--stdout",
          "description": "Print login URL to stdout instead of opening browser"
        }
      ],
      "examples": [
        "aws-vault login default"
      ]
    },
    {
      "name": "export",
      "description": "Export credentials as environment variables",
      "args": [
        {
          "name": "profile",
          "description": "AWS profile to export",
          "required": true,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        }
      ],
      "options": [
        {
          "name": "--format",
          "shorthand": "-f",
          "description": "Output format (env, json, ini)",
          "takesValue": true,
          "short": "-f"
        }
      ],
      "examples": [
        "aws-vault export default"
      ]
    },
    {
      "name": "clear",
      "description": "Clear temporary credentials from the session keyring",
      "args": [
        {
          "name": "profile",
          "description": "Profile to clear sessions for",
          "required": false,
          "type": "profile",
          "completion": {
            "detector": "profiles"
          }
        }
      ],
      "examples": [
        "aws-vault clear default"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--backend",
      "description": "Secret backend to use (keychain, kwallet, secret-service, file)",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Enable debug logging"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-v",
      "description": "Show version",
      "short": "-v"
    }
  ],
  "examples": [
    {
      "command": "aws-vault exec production -- aws s3 ls",
      "description": "Run aws s3 ls with production credentials"
    },
    {
      "command": "aws-vault add myprofile",
      "description": "Add new credentials for myprofile"
    },
    {
      "command": "aws-vault list",
      "description": "List all stored profiles"
    },
    {
      "command": "aws-vault login staging",
      "description": "Open AWS console for staging profile"
    },
    {
      "command": "aws-vault exec dev --duration=2h -- terraform plan",
      "description": "Run terraform with 2-hour session"
    }
  ],
  "relatedCommands": [
    "aws",
    "terraform"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "profiles",
        "description": "List configured AWS vault profiles",
        "command": "aws-vault list --profiles 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "aws-vault"
      },
      {
        "name": "credentials",
        "description": "List stored credentials and sessions",
        "command": "aws-vault list 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "aws-vault"
      },
      {
        "name": "aws_config_profiles",
        "description": "Profiles from AWS config file",
        "command": "grep '\\[profile' ~/.aws/config 2>/dev/null | sed 's/\\[profile //' | sed 's/\\]//'",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "backend",
        "description": "Detect the keychain backend in use",
        "command": "aws-vault --help 2>&1 | grep -i backend",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "aws-vault"
      }
    ]
  }
}
