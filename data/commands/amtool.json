{
  "name": "amtool",
  "description": "Alertmanager silence, alert and configuration tooling",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "alert",
      "description": "Query and add alerts",
      "options": [
        {
          "name": "--expired",
          "description": "Include expired alerts",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "silence",
      "description": "Manage silences",
      "options": [
        {
          "name": "--expired",
          "description": "Include expired silences",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "check-config",
      "description": "Validate an Alertmanager configuration",
      "args": [
        {
          "name": "file",
          "description": "Configuration file",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "config",
      "description": "Show the running configuration"
    },
    {
      "name": "cluster",
      "description": "Show the gossip cluster status"
    },
    {
      "name": "template",
      "description": "Render notification templates"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--alertmanager.url",
      "description": "Alertmanager base URL",
      "type": "url",
      "takesValue": true
    },
    {
      "name": "--output",
      "description": "Output format (simple, extended, json)",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--timeout",
      "description": "Request timeout",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "amtool check-config alertmanager.yml",
      "description": "Validate the configuration"
    },
    {
      "command": "amtool alert",
      "description": "List the firing alerts"
    },
    {
      "command": "amtool silence add alertname=HighCPU --duration=2h",
      "description": "Silence an alert for two hours"
    },
    {
      "command": "amtool silence query",
      "description": "List the active silences"
    }
  ],
  "relatedCommands": [
    "prometheus",
    "promtool",
    "grafana-cli"
  ]
}
