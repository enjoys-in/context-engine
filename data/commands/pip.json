{
  "name": "pip",
  "aliases": [
    "pip3"
  ],
  "description": "Python package installer",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "<package>",
          "type": "string",
          "required": true,
          "description": "Package name or requirements file"
        }
      ],
      "options": [
        {
          "name": "--requirement",
          "short": "-r",
          "description": "Install from requirements file",
          "type": "file",
          "takesValue": true,
          "shorthand": "-r"
        },
        {
          "name": "--upgrade",
          "short": "-U",
          "description": "Upgrade package to latest",
          "shorthand": "-U"
        },
        {
          "name": "--user",
          "description": "Install to user site-packages"
        },
        {
          "name": "--no-cache-dir",
          "description": "Disable pip cache"
        },
        {
          "name": "--pre",
          "description": "Include pre-release versions"
        },
        {
          "name": "--editable",
          "short": "-e",
          "description": "Install in editable mode",
          "type": "path",
          "takesValue": true,
          "shorthand": "-e"
        },
        {
          "name": "--target",
          "short": "-t",
          "description": "Install into directory",
          "type": "directory",
          "takesValue": true,
          "shorthand": "-t"
        },
        {
          "name": "--force-reinstall",
          "description": "Reinstall all packages"
        }
      ],
      "examples": [
        "pip install requests",
        "pip install -r requirements.txt",
        "pip install -U pip",
        "pip install -e ."
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall packages",
      "args": [
        {
          "name": "<package>",
          "type": "string",
          "required": true,
          "description": "Package name"
        }
      ],
      "options": [
        {
          "name": "--yes",
          "short": "-y",
          "description": "Don't ask for confirmation",
          "shorthand": "-y"
        }
      ],
      "examples": [
        "pip uninstall requests",
        "pip uninstall -y flask"
      ]
    },
    {
      "name": "freeze",
      "description": "Output installed packages in requirements format",
      "examples": [
        "pip freeze",
        "pip freeze > requirements.txt"
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        {
          "name": "--outdated",
          "short": "-o",
          "description": "List outdated packages",
          "shorthand": "-o"
        },
        {
          "name": "--format",
          "description": "Output format (columns, freeze, json)",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "pip list",
        "pip list --outdated",
        "pip list --format json"
      ]
    },
    {
      "name": "show",
      "description": "Show information about installed packages",
      "args": [
        {
          "name": "<package>",
          "type": "string",
          "required": true,
          "description": "Package name"
        }
      ],
      "examples": [
        "pip show flask",
        "pip show requests"
      ]
    },
    {
      "name": "search",
      "description": "Search PyPI for packages (deprecated on PyPI)",
      "args": [
        {
          "name": "<query>",
          "type": "string",
          "required": true,
          "description": "Search query"
        }
      ],
      "examples": [
        "pip search requests"
      ]
    },
    {
      "name": "download",
      "description": "Download packages without installing",
      "args": [
        {
          "name": "<package>",
          "type": "string",
          "required": true,
          "description": "Package name"
        }
      ],
      "options": [
        {
          "name": "--dest",
          "short": "-d",
          "description": "Download directory",
          "type": "directory",
          "takesValue": true,
          "shorthand": "-d"
        }
      ],
      "examples": [
        "pip download requests -d ./packages"
      ]
    },
    {
      "name": "check",
      "description": "Verify installed packages have compatible dependencies",
      "examples": [
        "pip check"
      ]
    },
    {
      "name": "cache purge",
      "description": "Remove all items from the cache",
      "examples": [
        "pip cache purge"
      ]
    },
    {
      "name": "wheel",
      "description": "Build wheels from requirements",
      "options": [
        {
          "name": "--wheel-dir",
          "description": "Directory to write wheels into",
          "type": "directory",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--no-deps",
          "description": "Do not build dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "config",
      "description": "Read and write pip configuration",
      "options": [
        {
          "name": "--global",
          "description": "Operate on the global configuration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "Operate on the user configuration",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "cache",
      "description": "Inspect and clear the wheel cache"
    },
    {
      "name": "debug",
      "description": "Print information useful for debugging pip"
    },
    {
      "name": "index",
      "description": "Query a package index",
      "options": [
        {
          "name": "--index-url",
          "description": "Index to query",
          "type": "url",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Emit a JSON report of the environment"
    },
    {
      "name": "hash",
      "description": "Print the hash of a distribution file",
      "options": [
        {
          "name": "--algorithm",
          "description": "Hash algorithm to use",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--version",
      "short": "-V",
      "description": "Show version",
      "shorthand": "-V"
    },
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "short": "-q",
      "description": "Quiet output",
      "shorthand": "-q"
    },
    {
      "name": "--proxy",
      "description": "Use proxy",
      "type": "url",
      "takesValue": true
    },
    {
      "name": "--trusted-host",
      "description": "Mark host as trusted",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--index-url",
      "short": "-i",
      "description": "Base URL of Python package index",
      "type": "url",
      "takesValue": true,
      "shorthand": "-i"
    }
  ],
  "examples": [
    "pip install flask",
    "pip install -r requirements.txt",
    "pip freeze > requirements.txt",
    "pip list --outdated"
  ],
  "relatedCommands": [
    "python",
    "pipx",
    "poetry",
    "conda",
    "virtualenv"
  ]
}
