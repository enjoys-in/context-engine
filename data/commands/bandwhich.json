{
  "name": "bandwhich",
  "description": "Terminal bandwidth utilisation by process, connection and remote host",
  "category": "network",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--interface",
      "description": "Network interface to watch",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--raw",
      "description": "Emit plain text rather than a TUI",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--no-resolve",
      "description": "Do not resolve hostnames",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--show-dns",
      "description": "Include DNS queries",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--total-utilization",
      "description": "Show cumulative totals rather than rates",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--processes",
      "description": "Show the process table only",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--connections",
      "description": "Show the connection table only",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--addresses",
      "description": "Show the remote address table only",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    }
  ],
  "examples": [
    {
      "command": "sudo bandwhich",
      "description": "Watch bandwidth by process"
    },
    {
      "command": "sudo bandwhich -i eth0",
      "description": "Watch a specific interface"
    },
    {
      "command": "sudo bandwhich -r > usage.txt",
      "description": "Log plain-text output"
    },
    {
      "command": "sudo bandwhich -n",
      "description": "Skip reverse DNS lookups"
    }
  ],
  "relatedCommands": [
    "iftop",
    "nethogs",
    "tcpdump",
    "ss",
    "btop"
  ]
}
