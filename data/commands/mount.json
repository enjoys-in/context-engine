{
  "name": "mount",
  "description": "Mount a filesystem",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-t",
      "description": "Filesystem type (ext4, ntfs, nfs, etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Mount options (ro, rw, noexec, etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-a",
      "description": "Mount all filesystems in /etc/fstab"
    },
    {
      "name": "-r",
      "description": "Mount read-only"
    },
    {
      "name": "-w",
      "description": "Mount read-write"
    },
    {
      "name": "-v",
      "description": "Verbose mode"
    },
    {
      "name": "--bind",
      "description": "Bind mount a directory"
    },
    {
      "name": "--types",
      "description": "Filesystem type to mount",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--options",
      "description": "Comma-separated mount options",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--all",
      "description": "Mount everything in fstab",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--read-only",
      "description": "Mount read-only",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--rw",
      "description": "Mount read-write",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--rbind",
      "description": "Bind-mount recursively",
      "type": "boolean",
      "takesValue": false,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--move",
      "description": "Move a mount to another place",
      "type": "boolean",
      "takesValue": false,
      "short": "-M",
      "shorthand": "-M"
    },
    {
      "name": "--make-shared",
      "description": "Mark the mount shared",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--make-private",
      "description": "Mark the mount private",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--fake",
      "description": "Go through the motions without mounting",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--namespace",
      "description": "Operate in this mount namespace",
      "type": "string",
      "takesValue": true,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--source",
      "description": "Device or image to mount",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--target",
      "description": "Mount point",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--mkdir",
      "description": "Create the mount point if needed",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--label",
      "description": "Mount the filesystem with this label",
      "type": "string",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--uuid",
      "description": "Mount the filesystem with this UUID",
      "type": "string",
      "takesValue": true,
      "short": "-U",
      "shorthand": "-U"
    }
  ],
  "examples": [
    "mount",
    "mount /dev/sdb1 /mnt/usb",
    "mount -t ext4 /dev/sdb1 /mnt",
    "mount -o ro /dev/sdb1 /mnt",
    "mount -a",
    "mount --bind /src /dst",
    "sudo mount -t nfs server:/share /mnt/nfs"
  ],
  "relatedCommands": [
    "umount",
    "df",
    "lsblk",
    "fstab",
    "findmnt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "mounts",
        "description": "Mounted filesystems",
        "command": "mount 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "fstab",
        "description": "Filesystems declared in fstab",
        "command": "cat /etc/fstab 2>/dev/null | grep -v '^#' | head -20",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "block_devices",
        "description": "Block devices available to mount",
        "command": "lsblk 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 300
      }
    ]
  }
}
