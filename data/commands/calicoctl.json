{
  "name": "calicoctl",
  "description": "Calico CLI — manage Calico network policies and configurations",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "get",
      "description": "Get resources",
      "examples": [
        "calicoctl get nodes",
        "calicoctl get globalnetworkpolicies",
        "calicoctl get networkpolicies -n my-ns",
        "calicoctl get ippool",
        "calicoctl get bgppeer",
        "calicoctl get hostendpoint",
        "calicoctl get workloadendpoint",
        "calicoctl get felixconfiguration",
        "calicoctl get -o yaml globalnetworkpolicy my-policy"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all-namespaces",
          "description": "Query every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--export",
          "description": "Strip cluster-specific metadata",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "resource",
          "description": "Resource kind to fetch",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "create",
      "description": "Create resources",
      "examples": [
        "calicoctl create -f policy.yaml"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--filename",
          "description": "Manifest to create from",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--skip-exists",
          "description": "Ignore resources that already exist",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "apply",
      "description": "Apply resources",
      "examples": [
        "calicoctl apply -f policy.yaml"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--filename",
          "description": "Manifest to apply",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "replace",
      "description": "Replace resources",
      "examples": [
        "calicoctl replace -f policy.yaml"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--filename",
          "description": "Manifest to replace with",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete resources",
      "examples": [
        "calicoctl delete globalnetworkpolicy my-policy",
        "calicoctl delete -f policy.yaml"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--filename",
          "description": "Manifest listing what to delete",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--skip-not-exists",
          "description": "Ignore resources that are already gone",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to delete",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name to delete",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "patch",
      "description": "Patch resources",
      "examples": [
        "calicoctl patch felixconfiguration default --patch '{\"spec\":{\"flowLogsFlushInterval\":\"10s\"}}'"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--patch",
          "description": "Patch to apply",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--type",
          "description": "Patch type: merge or json",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to patch",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name to patch",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "label",
      "description": "Label resources",
      "examples": [
        "calicoctl label nodes my-node env=production"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--remove",
          "description": "Remove the named label",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--overwrite",
          "description": "Replace an existing label value",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "Resource kind to label",
          "required": true,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Resource name to label",
          "required": true,
          "type": "string"
        },
        {
          "name": "labels",
          "description": "Label assignments to apply",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "node",
      "description": "Node operations",
      "examples": [
        "calicoctl node status",
        "calicoctl node diags",
        "calicoctl node checksystem"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--show-threshold",
          "description": "Only show entries above this threshold",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ipam",
      "description": "IP address management",
      "examples": [
        "calicoctl ipam show",
        "calicoctl ipam show --show-blocks",
        "calicoctl ipam release --ip=10.0.0.1",
        "calicoctl ipam check"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--show-blocks",
          "description": "Include IP block detail",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--show-borrowed",
          "description": "Include borrowed addresses",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Datastore operations",
      "examples": [
        "calicoctl datastore migrate lock",
        "calicoctl datastore migrate unlock"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "calicoctl version"
      ],
      "options": [
        {
          "name": "--config",
          "description": "calicoctl configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format: yaml, json, wide or ps",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--poll",
          "description": "Poll for the cluster version at this interval",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--config",
      "short": "-c",
      "description": "Config file path",
      "type": "string",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output format (yaml, json, ps, wide)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--all-namespaces",
      "short": "-A",
      "description": "All namespaces",
      "shorthand": "-A"
    },
    {
      "name": "--allow-version-mismatch",
      "description": "Allow client/cluster version mismatch"
    }
  ],
  "examples": [
    "calicoctl get nodes",
    "calicoctl get globalnetworkpolicies",
    "calicoctl apply -f policy.yaml",
    "calicoctl node status",
    "calicoctl ipam show",
    "calicoctl get ippool -o yaml",
    "calicoctl version"
  ],
  "relatedCommands": [
    "kubectl",
    "cilium",
    "networkpolicy",
    "helm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "calicoctl version",
        "command": "calicoctl version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "calicoctl"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "ippools",
        "description": "Calico IP pools",
        "command": "calicoctl get ippools -o wide 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "calicoctl"
      },
      {
        "name": "nodes",
        "description": "Calico nodes",
        "command": "calicoctl get nodes -o wide 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "calicoctl"
      }
    ]
  }
}
