{
  "name": "crane",
  "description": "Container registry tool for interacting with remote images",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "pull",
      "description": "Pull remote image as tarball",
      "examples": [
        "crane pull nginx:latest nginx.tar"
      ],
      "options": [
        {
          "name": "--platform",
          "description": "Platform to pull",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Output format: tarball, legacy or oci",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cache_path",
          "description": "Directory to cache layers in",
          "type": "directory",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to pull",
          "required": true,
          "type": "image"
        },
        {
          "name": "tarball",
          "description": "Path to write the image tarball to",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "push",
      "description": "Push tarball to registry",
      "examples": [
        "crane push image.tar registry/image:tag"
      ],
      "options": [
        {
          "name": "--image-refs",
          "description": "Write the pushed references to this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--index",
          "description": "Push as a multi-platform index",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "tarball",
          "description": "Image tarball to push",
          "required": true,
          "type": "file"
        },
        {
          "name": "image",
          "description": "Image reference to push to",
          "required": true,
          "type": "image"
        }
      ]
    },
    {
      "name": "copy",
      "description": "Copy image between registries",
      "examples": [
        "crane copy src/image:tag dest/image:tag"
      ],
      "options": [
        {
          "name": "--all-tags",
          "description": "Copy every tag in the repository",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--jobs",
          "description": "Number of concurrent copies",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--no-clobber",
          "description": "Do not overwrite an existing destination",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Image reference to copy from",
          "required": true,
          "type": "string"
        },
        {
          "name": "destination",
          "description": "Image reference to copy to",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "digest",
      "description": "Get image digest",
      "examples": [
        "crane digest nginx:latest"
      ],
      "options": [
        {
          "name": "--platform",
          "description": "Platform whose digest to print",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--full-ref",
          "description": "Print the fully qualified reference",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--tarball",
          "description": "Read the image from this tarball",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image whose digest to print",
          "required": true,
          "type": "image"
        }
      ]
    },
    {
      "name": "manifest",
      "description": "Get image manifest",
      "examples": [
        "crane manifest nginx:latest"
      ],
      "options": [
        {
          "name": "--platform",
          "description": "Platform whose manifest to print",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image whose manifest to print",
          "required": true,
          "type": "image"
        }
      ]
    },
    {
      "name": "ls",
      "description": "List tags",
      "examples": [
        "crane ls nginx"
      ],
      "options": [
        {
          "name": "--full-ref",
          "description": "Print fully qualified references",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--omit-digest-tags",
          "description": "Skip tags that are only digests",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "repository",
          "description": "Repository whose tags to list",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "config",
      "description": "Get image config",
      "examples": [
        "crane config nginx:latest"
      ],
      "options": [
        {
          "name": "--platform",
          "description": "Platform whose config to print",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image whose config to print",
          "required": true,
          "type": "image"
        }
      ]
    },
    {
      "name": "catalog",
      "description": "List repositories",
      "examples": [
        "crane catalog registry.example.com"
      ],
      "options": [
        {
          "name": "--full-ref",
          "description": "Print fully qualified references",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "registry",
          "description": "Registry whose repositories to list",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "auth login",
      "description": "Login to registry",
      "examples": [
        "crane auth login registry.example.com"
      ],
      "options": [
        {
          "name": "--username",
          "description": "Registry username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--password",
          "description": "Registry password",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--password-stdin",
          "description": "Read the password from stdin",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "registry",
          "description": "Registry to authenticate against",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--insecure",
      "description": "Allow insecure registry"
    },
    {
      "name": "--platform",
      "description": "Platform to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-v",
      "description": "Verbose logging"
    }
  ],
  "examples": [
    "crane ls nginx",
    "crane digest nginx:latest",
    "crane copy src/img:v1 dest/img:v1",
    "crane manifest nginx:latest",
    "crane pull nginx:latest nginx.tar"
  ],
  "relatedCommands": [
    "skopeo",
    "docker",
    "podman",
    "cosign"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "crane version",
        "command": "crane version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "crane"
      },
      {
        "name": "registry_auth",
        "description": "Registries with stored credentials",
        "command": "grep -o '\"[^\"]*\": *{' ~/.docker/config.json 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "dockerfiles",
        "description": "Image build files present",
        "command": "ls Dockerfile* 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
