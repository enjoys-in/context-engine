{
  "language": "powershell",
  "name": "pwsh",
  "description": "PowerShell — cross-platform task automation and scripting shell",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-File",
      "description": "Execute a PowerShell script file"
    },
    {
      "name": "-Command",
      "description": "Execute a PowerShell command"
    },
    {
      "name": "-NoProfile",
      "description": "Skip loading user profile on startup"
    },
    {
      "name": "-NonInteractive",
      "description": "Do not present interactive prompts"
    },
    {
      "name": "-ExecutionPolicy",
      "description": "Set session execution policy"
    },
    {
      "name": "-NoExit",
      "description": "Stay open after running startup commands"
    },
    {
      "name": "-OutputFormat",
      "description": "Output format: Text or XML"
    },
    {
      "name": "-WorkingDirectory",
      "description": "Set initial working directory"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    }
  ],
  "subcommands": [
    {
      "name": "-File script.ps1",
      "description": "Run a PowerShell script file",
      "args": [
        {
          "name": "file",
          "description": "PowerShell script to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-NoProfile",
          "description": "Do not load the PowerShell profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-ExecutionPolicy",
          "description": "Execution policy for this session",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-NonInteractive",
          "description": "Do not present an interactive prompt",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-Command \"cmd\"",
      "description": "Execute a PowerShell command string",
      "args": [
        {
          "name": "command",
          "description": "Command to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-NoProfile",
          "description": "Do not load the PowerShell profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-NoLogo",
          "description": "Hide the startup banner",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-OutputFormat",
          "description": "Output format: Text or XML",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-NoProfile",
      "description": "Start without loading any profile scripts",
      "args": [],
      "options": [
        {
          "name": "-Command",
          "description": "Command to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-File",
          "description": "Script file to run",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-ExecutionPolicy Bypass",
      "description": "Run with bypassed execution policy",
      "args": [],
      "options": [
        {
          "name": "-File",
          "description": "Script file to run",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-Command",
          "description": "Command to run",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-EncodedCommand",
      "description": "Execute a Base64-encoded command string",
      "args": [
        {
          "name": "encoded",
          "description": "Base64-encoded command to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-NoProfile",
          "description": "Do not load the PowerShell profile",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-Interactive",
      "description": "Start interactive PowerShell session",
      "args": [],
      "options": [
        {
          "name": "-NoLogo",
          "description": "Hide the startup banner",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "pwsh -File deploy.ps1",
    "pwsh -Command 'Get-Process | Sort-Object CPU -Descending | Select-Object -First 10'",
    "pwsh -NoProfile -ExecutionPolicy Bypass -File script.ps1",
    "pwsh -Command 'Install-Module -Name Az -Scope CurrentUser'",
    "pwsh -c '(Invoke-WebRequest https://example.com).StatusCode'"
  ],
  "relatedCommands": [
    "bash",
    "cmd",
    "dotnet",
    "shell"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "PowerShell version",
        "command": "pwsh --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pwsh"
      },
      {
        "name": "profile",
        "description": "PowerShell profile path",
        "command": "pwsh -NoProfile -Command '$PROFILE' 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pwsh"
      },
      {
        "name": "modules",
        "description": "PowerShell modules available",
        "command": "pwsh -NoProfile -Command 'Get-Module -ListAvailable | Select-Object -First 20 -ExpandProperty Name' 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "pwsh"
      },
      {
        "name": "scripts",
        "description": "PowerShell scripts in this project",
        "command": "find . -maxdepth 2 -name '*.ps1' -o -name '*.psm1' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
