{
  "name": "direnv",
  "description": "Load and unload environment variables per directory",
  "category": "environment",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "allow",
      "description": "Trust the .envrc in a directory",
      "args": [
        {
          "name": "path",
          "description": "Directory or .envrc",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "deny",
      "description": "Revoke trust for an .envrc",
      "args": [
        {
          "name": "path",
          "description": "Directory or .envrc",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "reload",
      "description": "Reload the current environment"
    },
    {
      "name": "status",
      "description": "Show the loader state and configuration"
    },
    {
      "name": "edit",
      "description": "Open the .envrc and trust it on save",
      "args": [
        {
          "name": "path",
          "description": "Directory",
          "type": "directory",
          "required": false
        }
      ]
    },
    {
      "name": "exec",
      "description": "Run a command with a directory environment loaded",
      "args": [
        {
          "name": "dir",
          "description": "Directory to load",
          "type": "directory",
          "required": true
        }
      ]
    },
    {
      "name": "export",
      "description": "Print the export statements for a shell",
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "hook",
      "description": "Print the shell hook to install",
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "prune",
      "description": "Remove stale allow entries"
    },
    {
      "name": "version",
      "description": "Show the installed version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    }
  ],
  "examples": [
    {
      "command": "eval \"$(direnv hook zsh)\"",
      "description": "Install the shell hook"
    },
    {
      "command": "direnv allow",
      "description": "Trust the .envrc in this directory"
    },
    {
      "command": "direnv status",
      "description": "Inspect the loader state"
    },
    {
      "command": "direnv exec /path/to/project make",
      "description": "Run a command with that project’s environment"
    }
  ],
  "relatedCommands": [
    "mise",
    "asdf",
    "nix",
    "dotenv",
    "starship"
  ]
}
