{
  "name": "direnv",
  "description": "Load and unload environment variables per directory",
  "category": "environment",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "allow",
      "description": "Trust the .envrc in a directory",
      "args": [
        {
          "name": "path",
          "description": "Directory or .envrc",
          "type": "path",
          "required": false
        }
      ],
      "options": [],
      "examples": [
        "direnv allow ./src"
      ]
    },
    {
      "name": "deny",
      "description": "Revoke trust for an .envrc",
      "args": [
        {
          "name": "path",
          "description": "Directory or .envrc",
          "type": "path",
          "required": false
        }
      ],
      "options": [],
      "examples": [
        "direnv deny ./src"
      ]
    },
    {
      "name": "reload",
      "description": "Reload the current environment",
      "options": [],
      "examples": [
        "direnv reload"
      ]
    },
    {
      "name": "status",
      "description": "Show the loader state and configuration",
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "direnv status"
      ]
    },
    {
      "name": "edit",
      "description": "Open the .envrc and trust it on save",
      "args": [
        {
          "name": "path",
          "description": "Directory",
          "type": "directory",
          "required": false
        }
      ],
      "options": [],
      "examples": [
        "direnv edit ./build"
      ]
    },
    {
      "name": "exec",
      "description": "Run a command with a directory environment loaded",
      "args": [
        {
          "name": "dir",
          "description": "Directory to load",
          "type": "directory",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "direnv exec ./dir"
      ]
    },
    {
      "name": "export",
      "description": "Print the export statements for a shell",
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "direnv export shell"
      ]
    },
    {
      "name": "hook",
      "description": "Print the shell hook to install",
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "direnv hook shell"
      ]
    },
    {
      "name": "prune",
      "description": "Remove stale allow entries",
      "options": [],
      "examples": [
        "direnv prune"
      ]
    },
    {
      "name": "version",
      "description": "Show the installed version",
      "options": [],
      "examples": [
        "direnv version"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    }
  ],
  "examples": [
    {
      "command": "eval \"$(direnv hook zsh)\"",
      "description": "Install the shell hook"
    },
    {
      "command": "direnv allow",
      "description": "Trust the .envrc in this directory"
    },
    {
      "command": "direnv status",
      "description": "Inspect the loader state"
    },
    {
      "command": "direnv exec /path/to/project make",
      "description": "Run a command with that project’s environment"
    }
  ],
  "relatedCommands": [
    "mise",
    "asdf",
    "nix",
    "dotenv",
    "starship"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "direnv version",
        "command": "direnv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "direnv"
      },
      {
        "name": "envrc",
        "description": "direnv configuration for this directory",
        "command": "cat .envrc 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "status",
        "description": "Whether this directory's .envrc is allowed",
        "command": "direnv status 2>/dev/null | head -15",
        "parser": "keyvalue",
        "cacheFor": 60,
        "requiresCmd": "direnv"
      },
      {
        "name": "allowed",
        "description": "direnv allow records on this machine",
        "command": "ls ~/.local/share/direnv/allow 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
