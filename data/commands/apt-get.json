{
  "name": "apt-get",
  "description": "Low-level APT package management tool for Debian/Ubuntu",
  "category": "package-manager",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true,
          "type": "package"
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Assume yes"
        },
        {
          "name": "--no-install-recommends",
          "description": "Skip recommended packages"
        },
        {
          "name": "--reinstall",
          "description": "Reinstall"
        },
        {
          "name": "-d",
          "description": "Download only"
        },
        {
          "name": "--allow-unauthenticated",
          "description": "Allow unauthenticated packages"
        },
        {
          "name": "--allow-downgrades",
          "description": "Allow downgrade"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--purge",
          "description": "Also remove configuration files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--autoremove",
          "description": "Remove orphaned dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "purge",
      "description": "Remove packages with config files",
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--autoremove",
          "description": "Remove orphaned dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "update",
      "description": "Update package index",
      "options": [
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--allow-releaseinfo-change",
          "description": "Accept changed release information",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade packages",
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--only-upgrade",
          "description": "Never install new packages",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--with-new-pkgs",
          "description": "Allow new packages to be installed",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "dist-upgrade",
      "description": "Distribution upgrade",
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--allow-downgrades",
          "description": "Permit downgrades",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "autoremove",
      "description": "Remove unneeded packages",
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--purge",
          "description": "Also remove configuration files",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "autoclean",
      "description": "Clean old package archives",
      "options": [
        {
          "name": "--assume-yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--option",
          "description": "Set an arbitrary configuration option",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--config-file",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clear local repository",
      "options": [
        {
          "name": "--assume-yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--option",
          "description": "Set an arbitrary configuration option",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--config-file",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "download",
      "description": "Download package .deb",
      "args": [
        {
          "name": "package",
          "description": "Package name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--print-uris",
          "description": "Print the URIs instead of downloading",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "source",
      "description": "Download source package",
      "options": [
        {
          "name": "--download-only",
          "description": "Download without unpacking",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--compile",
          "description": "Build the package after fetching",
          "type": "boolean",
          "takesValue": false,
          "short": "-b",
          "shorthand": "-b"
        }
      ]
    },
    {
      "name": "build-dep",
      "description": "Install build dependencies",
      "args": [
        {
          "name": "package",
          "description": "Package name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--host-architecture",
          "description": "Cross-build architecture",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check",
      "description": "Verify no broken dependencies",
      "options": [
        {
          "name": "--assume-yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--option",
          "description": "Set an arbitrary configuration option",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--config-file",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "changelog",
      "description": "Download and display changelog",
      "options": [
        {
          "name": "--assume-yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--option",
          "description": "Set an arbitrary configuration option",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--config-file",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "indextargets",
      "description": "List index targets",
      "options": [
        {
          "name": "--format",
          "description": "Output format template",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-y",
      "description": "Assume yes"
    },
    {
      "name": "-q",
      "description": "Quiet"
    },
    {
      "name": "-qq",
      "description": "Very quiet"
    },
    {
      "name": "-s",
      "description": "Simulate (dry run)"
    },
    {
      "name": "-d",
      "description": "Download only"
    },
    {
      "name": "-f",
      "description": "Fix broken dependencies"
    },
    {
      "name": "-o",
      "description": "Set config option",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Target release",
      "takesValue": true
    },
    {
      "name": "--force-yes",
      "description": "Force yes (deprecated)"
    },
    {
      "name": "--print-uris",
      "description": "Print URIs instead of downloading"
    }
  ],
  "examples": [
    {
      "command": "sudo apt-get update",
      "description": "Update package index"
    },
    {
      "command": "sudo apt-get upgrade -y",
      "description": "Upgrade all packages"
    },
    {
      "command": "sudo apt-get install -y curl wget",
      "description": "Install packages"
    },
    {
      "command": "sudo apt-get install --no-install-recommends nginx",
      "description": "Minimal install"
    },
    {
      "command": "sudo apt-get remove nginx",
      "description": "Remove package"
    },
    {
      "command": "sudo apt-get purge nginx",
      "description": "Remove with config"
    },
    {
      "command": "sudo apt-get autoremove",
      "description": "Remove unused"
    },
    {
      "command": "sudo apt-get dist-upgrade",
      "description": "Distribution upgrade"
    },
    {
      "command": "sudo apt-get build-dep python3",
      "description": "Install build deps"
    },
    {
      "command": "apt-get -s install nginx",
      "description": "Simulate install"
    }
  ],
  "relatedCommands": [
    "apt",
    "dpkg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed",
        "description": "Installed packages",
        "command": "dpkg -l 2>/dev/null | grep '^ii' | tail -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "broken",
        "description": "Broken packages",
        "command": "dpkg -l 2>/dev/null | grep -v '^ii' | grep -v '^||' | grep -v '^Desired' | grep -v '^+' | head -10",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "sources",
        "description": "Repository sources",
        "command": "cat /etc/apt/sources.list 2>/dev/null | grep -v '^#' | grep -v '^$' | head -10",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
