  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Azure CLI version",
        "command": "az version 2>/dev/null",
        "parser": "json",
        "cacheFor": 3600,
        "requiresCmd": "az"
      },
      {
        "name": "account",
        "description": "Active Azure subscription",
        "command": "az account show 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "az"
      },
      {
        "name": "extensions",
        "description": "Installed Azure CLI extensions",
        "command": "az extension list --query '[].name' 2>/dev/null",
        "parser": "json",
        "cacheFor": 3600,
        "requiresCmd": "az"
      },
      {
        "name": "defaults",
        "description": "Configured Azure CLI defaults",
        "command": "az configure --list-defaults 2>/dev/null",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "az"
      }
    ]
  }
}
