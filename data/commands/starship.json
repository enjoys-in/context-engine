{
  "name": "starship",
  "description": "Fast, customisable cross-shell prompt",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Print the shell integration snippet",
      "options": [
        {
          "name": "--print-full-init",
          "description": "Print the full script rather than a source line",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "prompt",
      "description": "Render the prompt",
      "options": [
        {
          "name": "--status",
          "description": "Exit status of the last command",
          "type": "integer",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--cmd-duration",
          "description": "Duration of the last command in ms",
          "type": "integer",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--jobs",
          "description": "Number of background jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ]
    },
    {
      "name": "config",
      "description": "Edit the configuration file",
      "args": [
        {
          "name": "name",
          "description": "Configuration key to set",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "explain",
      "description": "Explain what each prompt module is showing",
      "options": []
    },
    {
      "name": "module",
      "description": "Render a single module",
      "options": [
        {
          "name": "--list",
          "description": "List every module",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Module to render",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "preset",
      "description": "Print or write a built-in preset",
      "options": [
        {
          "name": "--output",
          "description": "Write the preset to this file",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--list",
          "description": "List the available presets",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Preset name",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "timings",
      "description": "Show how long each module took to render",
      "options": []
    },
    {
      "name": "bug-report",
      "description": "Open a pre-filled bug report",
      "options": []
    },
    {
      "name": "toggle",
      "description": "Enable or disable a module",
      "args": [
        {
          "name": "module",
          "description": "Module to toggle",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "completions",
      "description": "Print shell completions",
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "eval \"$(starship init zsh)\"",
      "description": "Enable the prompt in zsh"
    },
    {
      "command": "starship preset nerd-font-symbols -o ~/.config/starship.toml",
      "description": "Write a preset to the config"
    },
    {
      "command": "starship explain",
      "description": "Explain the current prompt"
    },
    {
      "command": "starship timings",
      "description": "Find slow prompt modules"
    }
  ],
  "relatedCommands": [
    "zoxide",
    "atuin",
    "oh-my-posh",
    "powerlevel10k"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Starship version",
        "command": "starship --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "starship"
      },
      {
        "name": "config",
        "description": "Starship prompt configuration",
        "command": "cat ~/.config/starship.toml 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "modules",
        "description": "Starship modules explicitly configured",
        "command": "grep -o '^\\[[a-z_]*\\]' ~/.config/starship.toml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "shell",
        "description": "Shell Starship is initialised in",
        "command": "echo \"${SHELL:-unknown}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
