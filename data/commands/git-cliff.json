{
  "name": "git-cliff",
  "description": "Generate a changelog from conventional commits",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--init",
      "description": "Write a starter cliff.toml",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--workdir",
      "description": "Repository to read",
      "type": "directory",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--output",
      "description": "Write the changelog to this file",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--tag",
      "description": "Treat unreleased commits as this tag",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--unreleased",
      "description": "Only the unreleased commits",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--latest",
      "description": "Only the latest release",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--current",
      "description": "Only the current tag",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--prepend",
      "description": "Prepend to an existing changelog",
      "type": "file",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--bump",
      "description": "Compute the next version automatically",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--bumped-version",
      "description": "Print the next version and exit",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--context",
      "description": "Emit the template context as JSON",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strip",
      "description": "Sections to strip (header, footer, all)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--include-path",
      "description": "Only commits touching these paths",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "git cliff --init",
      "description": "Write a starter configuration"
    },
    {
      "command": "git cliff -o CHANGELOG.md",
      "description": "Generate the full changelog"
    },
    {
      "command": "git cliff --unreleased --tag v1.2.0",
      "description": "Render the pending release"
    },
    {
      "command": "git cliff --bumped-version",
      "description": "Print the next semantic version"
    }
  ],
  "relatedCommands": [
    "git",
    "semantic-release",
    "conventional-commits",
    "commitlint",
    "changeset"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "git-cliff version",
        "command": "git-cliff --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "git-cliff"
      },
      {
        "name": "config",
        "description": "git-cliff changelog configuration",
        "command": "cat cliff.toml 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "last_tag",
        "description": "Most recent tag git-cliff would start from",
        "command": "git describe --tags --abbrev=0 2>/dev/null",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "git"
      },
      {
        "name": "commit_range",
        "description": "Commits since the last tag",
        "command": "git log $(git describe --tags --abbrev=0 2>/dev/null)..HEAD --oneline 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "git"
      }
    ]
  }
}
