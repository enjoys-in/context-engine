{
  "name": "celery",
  "description": "Distributed task queue for Python",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "worker",
      "description": "Start a worker process",
      "options": [
        {
          "name": "--concurrency",
          "description": "Number of worker processes or threads",
          "type": "integer",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--loglevel",
          "description": "Logging level",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--queues",
          "description": "Queues to consume from",
          "type": "string",
          "takesValue": true,
          "short": "-Q",
          "shorthand": "-Q"
        },
        {
          "name": "--hostname",
          "description": "Worker node name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--pool",
          "description": "Execution pool (prefork, eventlet, gevent, solo)",
          "type": "string",
          "takesValue": true,
          "short": "-P",
          "shorthand": "-P"
        }
      ]
    },
    {
      "name": "beat",
      "description": "Start the periodic task scheduler",
      "options": [
        {
          "name": "--loglevel",
          "description": "Logging level",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--schedule",
          "description": "Path to the schedule database",
          "type": "file",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "flower",
      "description": "Start the Flower monitoring web UI",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Query running workers",
      "options": [
        {
          "name": "--timeout",
          "description": "Seconds to wait for replies",
          "type": "number",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "control",
      "description": "Send control commands to workers"
    },
    {
      "name": "status",
      "description": "Show which workers are online"
    },
    {
      "name": "purge",
      "description": "Discard all queued messages",
      "options": [
        {
          "name": "--force",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "call",
      "description": "Send a task by name",
      "options": [
        {
          "name": "--args",
          "description": "Positional arguments as JSON",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--kwargs",
          "description": "Keyword arguments as JSON",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ]
    },
    {
      "name": "events",
      "description": "Watch the event stream"
    },
    {
      "name": "result",
      "description": "Show the result of a task id",
      "args": [
        {
          "name": "task_id",
          "description": "Task identifier",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--app",
      "description": "Application instance to use",
      "type": "string",
      "takesValue": true,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--broker",
      "description": "Broker URL",
      "type": "url",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--workdir",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "celery -A proj worker -l info",
      "description": "Start a worker for the proj app"
    },
    {
      "command": "celery -A proj beat -l info",
      "description": "Start the scheduler"
    },
    {
      "command": "celery -A proj status",
      "description": "List online workers"
    },
    {
      "command": "celery -A proj purge",
      "description": "Discard queued messages"
    }
  ],
  "relatedCommands": [
    "redis-cli",
    "rabbitmq",
    "python",
    "flower"
  ]
}
