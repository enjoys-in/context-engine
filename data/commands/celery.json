{
  "name": "celery",
  "description": "Distributed task queue for Python",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "worker",
      "description": "Start a worker process",
      "options": [
        {
          "name": "--concurrency",
          "description": "Number of worker processes or threads",
          "type": "integer",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--loglevel",
          "description": "Logging level",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--queues",
          "description": "Queues to consume from",
          "type": "string",
          "takesValue": true,
          "short": "-Q",
          "shorthand": "-Q"
        },
        {
          "name": "--hostname",
          "description": "Worker node name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--pool",
          "description": "Execution pool (prefork, eventlet, gevent, solo)",
          "type": "string",
          "takesValue": true,
          "short": "-P",
          "shorthand": "-P"
        }
      ],
      "examples": [
        "celery worker"
      ]
    },
    {
      "name": "beat",
      "description": "Start the periodic task scheduler",
      "options": [
        {
          "name": "--loglevel",
          "description": "Logging level",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--schedule",
          "description": "Path to the schedule database",
          "type": "file",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "examples": [
        "celery beat"
      ]
    },
    {
      "name": "flower",
      "description": "Start the Flower monitoring web UI",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "celery flower"
      ]
    },
    {
      "name": "inspect",
      "description": "Query running workers",
      "options": [
        {
          "name": "--timeout",
          "description": "Seconds to wait for replies",
          "type": "number",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "args": [
        {
          "name": "subcommand",
          "description": "Inspect subcommand, such as active or stats",
          "required": true,
          "type": "string"
        }
      ],
      "examples": [
        "celery inspect subcommand"
      ]
    },
    {
      "name": "control",
      "description": "Send control commands to workers",
      "options": [
        {
          "name": "--app",
          "description": "Celery application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--timeout",
          "description": "How long to wait for replies",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--destination",
          "description": "Only address these workers",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "examples": [
        "celery control"
      ]
    },
    {
      "name": "status",
      "description": "Show which workers are online",
      "options": [
        {
          "name": "--app",
          "description": "Celery application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--timeout",
          "description": "How long to wait for replies",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "celery status"
      ]
    },
    {
      "name": "purge",
      "description": "Discard all queued messages",
      "options": [
        {
          "name": "--force",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "celery purge"
      ]
    },
    {
      "name": "call",
      "description": "Send a task by name",
      "options": [
        {
          "name": "--args",
          "description": "Positional arguments as JSON",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--kwargs",
          "description": "Keyword arguments as JSON",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ],
      "examples": [
        "celery call"
      ]
    },
    {
      "name": "events",
      "description": "Watch the event stream",
      "options": [
        {
          "name": "--app",
          "description": "Celery application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--dump",
          "description": "Dump events rather than rendering the monitor",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--frequency",
          "description": "Screen refresh interval",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "celery events"
      ]
    },
    {
      "name": "result",
      "description": "Show the result of a task id",
      "args": [
        {
          "name": "task_id",
          "description": "Task identifier",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--app",
          "description": "Celery application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--task",
          "description": "Task name the id belongs to",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--traceback",
          "description": "Show the traceback for failures",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "celery result task_id"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--app",
      "description": "Application instance to use",
      "type": "string",
      "takesValue": true,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--broker",
      "description": "Broker URL",
      "type": "url",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--workdir",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "celery -A proj worker -l info",
      "description": "Start a worker for the proj app"
    },
    {
      "command": "celery -A proj beat -l info",
      "description": "Start the scheduler"
    },
    {
      "command": "celery -A proj status",
      "description": "List online workers"
    },
    {
      "command": "celery -A proj purge",
      "description": "Discard queued messages"
    }
  ],
  "relatedCommands": [
    "redis-cli",
    "rabbitmq",
    "python",
    "flower"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Celery version",
        "command": "celery --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "celery"
      },
      {
        "name": "app",
        "description": "Celery application module in this project",
        "command": "grep -rl 'Celery(' --include='*.py' . 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "broker",
        "description": "Broker URL configured in the environment",
        "command": "echo \"${CELERY_BROKER_URL:-${BROKER_URL:-unset}}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "workers",
        "description": "Celery workers currently running",
        "command": "ps -eo comm 2>/dev/null | grep -c celery",
        "parser": "text",
        "cacheFor": 30
      }
    ]
  }
}
