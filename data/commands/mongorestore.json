{
  "name": "mongorestore",
  "description": "Restore MongoDB data from a mongodump export",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--uri",
      "description": "Connection string",
      "type": "url",
      "takesValue": true
    },
    {
      "name": "--host",
      "description": "Server host",
      "type": "string",
      "takesValue": true,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--port",
      "description": "Server port",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--db",
      "description": "Database to restore into",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--collection",
      "description": "Collection to restore into",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--archive",
      "description": "Read from this archive file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--gzip",
      "description": "Input is gzip compressed",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--drop",
      "description": "Drop each collection before restoring",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dryRun",
      "description": "Report what would happen without writing",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--username",
      "description": "Username to authenticate as",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--password",
      "description": "Password to authenticate with",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--authenticationDatabase",
      "description": "Database holding the credentials",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--oplogReplay",
      "description": "Replay the oplog after restoring",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--numParallelCollections",
      "description": "Collections to restore in parallel",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--nsFrom",
      "description": "Rename namespaces matching this pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--nsTo",
      "description": "Target namespace pattern for the rename",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "mongorestore --archive=app.gz --gzip",
      "description": "Restore from a compressed archive"
    },
    {
      "command": "mongorestore --drop -d app dump/app",
      "description": "Replace a database from a dump directory"
    },
    {
      "command": "mongorestore --dryRun --archive=app.gz",
      "description": "Check a restore without writing"
    }
  ],
  "relatedCommands": [
    "mongodump",
    "mongosh",
    "pg_restore"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "mongorestore version",
        "command": "mongorestore --version 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mongorestore"
      },
      {
        "name": "connection",
        "description": "MongoDB connection string in effect",
        "command": "echo \"${MONGODB_URI:-mongodb://localhost:27017}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "dumps",
        "description": "Dump directories available to restore",
        "command": "ls -d dump */dump 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "bson_files",
        "description": "BSON collection files present",
        "command": "find . -maxdepth 3 -name '*.bson' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
