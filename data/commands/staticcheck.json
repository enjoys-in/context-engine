{
  "name": "staticcheck",
  "description": "Advanced static analysis for Go",
  "category": "go",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--checks",
      "description": "Checks to enable or disable",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tags",
      "description": "Build tags to apply",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tests",
      "description": "Include test files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--f",
      "description": "Output format (text, stylish, json)",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--explain",
      "description": "Explain a check by id",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--list-checks",
      "description": "List every available check",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-ignored",
      "description": "Include findings that are ignored",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--matrix",
      "description": "Analyse across multiple build configurations",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--fail",
      "description": "Categories that should cause a non-zero exit",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--debug.version",
      "description": "Print version details",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "staticcheck ./...",
      "description": "Analyse the whole module"
    },
    {
      "command": "staticcheck -checks \"all,-ST1000\" ./...",
      "description": "Enable everything except one check"
    },
    {
      "command": "staticcheck -explain SA4006",
      "description": "Explain a finding"
    },
    {
      "command": "staticcheck -f json ./... > report.json",
      "description": "Emit a machine-readable report"
    }
  ],
  "relatedCommands": [
    "golangci-lint",
    "go",
    "gopls",
    "gofmt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "staticcheck version",
        "command": "staticcheck --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "staticcheck"
      },
      {
        "name": "config",
        "description": "staticcheck configuration",
        "command": "cat staticcheck.conf 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "packages",
        "description": "Packages staticcheck would analyse",
        "command": "go list ./... 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "go"
      },
      {
        "name": "go_version",
        "description": "Go toolchain in use",
        "command": "go version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "go"
      }
    ]
  }
}
