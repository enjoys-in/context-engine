{
  "name": "mc",
  "description": "MinIO Client — S3-compatible cloud storage client",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "alias set",
      "description": "Add a cloud storage alias",
      "examples": [
        "mc alias set myminio https://minio.example.com accesskey secretkey",
        "mc alias set s3 https://s3.amazonaws.com AKID SKEY",
        "mc alias set gcs https://storage.googleapis.com GOOG_ACCESS_KEY GOOG_SECRET"
      ],
      "options": [
        {
          "name": "--api",
          "description": "S3 API signature to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Bucket lookup style",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "alias",
          "description": "Alias name to define",
          "required": true,
          "type": "alias",
          "completion": {
            "detector": "aliases"
          }
        },
        {
          "name": "url",
          "description": "S3 endpoint URL",
          "required": true,
          "type": "url"
        }
      ]
    },
    {
      "name": "alias list",
      "description": "List aliases",
      "examples": [
        "mc alias list"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ls",
      "description": "List objects",
      "examples": [
        "mc ls myminio/",
        "mc ls myminio/mybucket/",
        "mc ls --recursive myminio/mybucket/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "List recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--incomplete",
          "description": "Show incomplete uploads",
          "type": "boolean",
          "takesValue": false,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--versions",
          "description": "Include object versions",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--summarize",
          "description": "Print a summary",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Alias and path to list",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "cp",
      "description": "Copy objects",
      "examples": [
        "mc cp file.txt myminio/bucket/",
        "mc cp myminio/bucket/file.txt .",
        "mc cp --recursive ./dir/ myminio/bucket/dir/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Copy recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--attr",
          "description": "Object metadata, key=value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--preserve",
          "description": "Preserve filesystem attributes",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--storage-class",
          "description": "Storage class to set",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--encrypt-key",
          "description": "Encryption key to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path or URL",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path or URL",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "mv",
      "description": "Move objects",
      "examples": [
        "mc mv myminio/bucket/old.txt myminio/bucket/new.txt"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Move recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--preserve",
          "description": "Preserve filesystem attributes",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path or URL",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path or URL",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove objects",
      "examples": [
        "mc rm myminio/bucket/file.txt",
        "mc rm --recursive --force myminio/bucket/dir/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Remove recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--force",
          "description": "Allow a recursive removal",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dangerous",
          "description": "Allow removal of a whole bucket",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--older-than",
          "description": "Only objects older than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--incomplete",
          "description": "Remove incomplete uploads",
          "type": "boolean",
          "takesValue": false,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--versions",
          "description": "Remove every version",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Object or prefix to remove",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "mb",
      "description": "Make bucket",
      "examples": [
        "mc mb myminio/newbucket"
      ],
      "options": [
        {
          "name": "--region",
          "description": "Region to create the bucket in",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--with-lock",
          "description": "Enable object locking",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--ignore-existing",
          "description": "Do nothing if it exists",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Bucket path to create",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "rb",
      "description": "Remove bucket",
      "examples": [
        "mc rb myminio/oldbucket",
        "mc rb --force myminio/oldbucket"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Remove a non-empty bucket",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dangerous",
          "description": "Confirm removal of everything",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Bucket path to remove",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "mirror",
      "description": "Mirror (sync) objects",
      "examples": [
        "mc mirror ./local/ myminio/bucket/",
        "mc mirror myminio/bucket/ ./local/",
        "mc mirror --watch ./local/ myminio/bucket/"
      ],
      "options": [
        {
          "name": "--overwrite",
          "description": "Overwrite existing objects",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--remove",
          "description": "Delete extraneous objects at the target",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Keep mirroring on change",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--exclude",
          "description": "Skip paths matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--preserve",
          "description": "Preserve filesystem attributes",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source path or alias",
          "required": true,
          "type": "path"
        },
        {
          "name": "destination",
          "description": "Destination path or alias",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "cat",
      "description": "Display object content",
      "examples": [
        "mc cat myminio/bucket/file.txt"
      ],
      "options": [
        {
          "name": "--version-id",
          "description": "Object version to read",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--offset",
          "description": "Byte offset to start at",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Object to print",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "head",
      "description": "Display first lines",
      "examples": [
        "mc head myminio/bucket/file.txt"
      ],
      "options": [
        {
          "name": "--lines",
          "description": "Lines to print",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--version-id",
          "description": "Object version to read",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Object to read the start of",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "stat",
      "description": "Object statistics",
      "examples": [
        "mc stat myminio/bucket/file.txt"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Stat recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--versions",
          "description": "Include versions",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Object or bucket to describe",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "du",
      "description": "Disk usage",
      "examples": [
        "mc du myminio/bucket/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Include every prefix",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--depth",
          "description": "Prefix depth to report",
          "type": "integer",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Path to total",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "find",
      "description": "Find objects",
      "examples": [
        "mc find myminio/bucket/ --name '*.csv'",
        "mc find myminio/bucket/ --older-than 30d"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Match this glob",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--older-than",
          "description": "Only objects older than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--newer-than",
          "description": "Only objects newer than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--larger",
          "description": "Only objects larger than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--exec",
          "description": "Run this command per match",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Path to search under",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "diff",
      "description": "Diff objects",
      "examples": [
        "mc diff myminio/bucket1/ myminio/bucket2/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Compare recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "args": [
        {
          "name": "first",
          "description": "First path to compare",
          "required": true,
          "type": "path"
        },
        {
          "name": "second",
          "description": "Second path to compare",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "share",
      "description": "Generate presigned URLs",
      "examples": [
        "mc share download myminio/bucket/file.txt",
        "mc share upload myminio/bucket/ --expire 24h"
      ],
      "options": [
        {
          "name": "--expire",
          "description": "Link lifetime, e.g. 7d",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--recursive",
          "description": "Share recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        }
      ],
      "args": [
        {
          "name": "direction",
          "description": "Share direction: download or upload",
          "required": true,
          "type": "string"
        },
        {
          "name": "path",
          "description": "Object to share",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "admin",
      "description": "Admin operations",
      "examples": [
        "mc admin info myminio",
        "mc admin user list myminio",
        "mc admin user add myminio newuser newpassword",
        "mc admin policy list myminio",
        "mc admin service restart myminio"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Admin operation, such as info or user",
          "required": true,
          "type": "string"
        },
        {
          "name": "alias",
          "description": "Alias to administer",
          "required": true,
          "type": "alias"
        }
      ]
    },
    {
      "name": "encrypt",
      "description": "Manage encryption",
      "examples": [
        "mc encrypt set sse-s3 myminio/bucket/"
      ],
      "options": [],
      "args": [
        {
          "name": "operation",
          "description": "Encryption operation, such as set or clear",
          "required": true,
          "type": "string"
        },
        {
          "name": "path",
          "description": "Bucket to configure",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "event",
      "description": "Manage bucket notifications",
      "examples": [
        "mc event add myminio/bucket arn:xxx --event put",
        "mc event list myminio/bucket"
      ],
      "options": [
        {
          "name": "--event",
          "description": "Events to watch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--prefix",
          "description": "Only this prefix",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--suffix",
          "description": "Only this suffix",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Event operation, such as add, list or remove",
          "required": true,
          "type": "string"
        },
        {
          "name": "path",
          "description": "Bucket to configure",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "version",
      "description": "Manage bucket versioning",
      "examples": [
        "mc version enable myminio/bucket",
        "mc version info myminio/bucket"
      ],
      "options": [],
      "args": [
        {
          "name": "operation",
          "description": "Versioning operation: enable, suspend or info",
          "required": true,
          "type": "string"
        },
        {
          "name": "path",
          "description": "Bucket to configure",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "retention",
      "description": "Set object retention",
      "examples": [
        "mc retention set --default GOVERNANCE 30d myminio/bucket/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Apply recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--default",
          "description": "Set the bucket default",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--bypass",
          "description": "Bypass governance mode",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Retention operation, such as set or info",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "ilm",
      "description": "Object lifecycle management",
      "examples": [
        "mc ilm rule list myminio/bucket",
        "mc ilm rule add myminio/bucket --expire-days 90"
      ],
      "options": [
        {
          "name": "--expire-days",
          "description": "Expire objects after this many days",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--transition-days",
          "description": "Transition after this many days",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Lifecycle operation, such as rule list or rule add",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--recursive",
      "description": "Recursive operation"
    },
    {
      "name": "--json",
      "description": "JSON output"
    },
    {
      "name": "--quiet",
      "short": "-q",
      "description": "Suppress output",
      "shorthand": "-q"
    },
    {
      "name": "--insecure",
      "description": "Skip TLS verification"
    },
    {
      "name": "--config-dir",
      "short": "-C",
      "description": "Config directory",
      "type": "string",
      "takesValue": true,
      "shorthand": "-C"
    },
    {
      "name": "--debug",
      "description": "Debug output"
    },
    {
      "name": "--no-color",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "mc alias set myminio https://minio.example.com accesskey secretkey",
    "mc ls myminio/",
    "mc cp file.txt myminio/bucket/",
    "mc mirror ./local/ myminio/bucket/",
    "mc rm --recursive --force myminio/bucket/old/",
    "mc admin info myminio",
    "mc share download myminio/bucket/file.txt",
    "mc du myminio/bucket/"
  ],
  "relatedCommands": [
    "s3cmd",
    "aws",
    "gsutil",
    "rclone"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "MinIO client version",
        "command": "mc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mc"
      },
      {
        "name": "aliases",
        "description": "Configured MinIO aliases",
        "command": "mc alias list 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "mc"
      },
      {
        "name": "config",
        "description": "MinIO client configuration",
        "command": "cat ~/.mc/config.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300
      }
    ]
  }
}
