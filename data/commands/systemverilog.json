{
  "language": "systemverilog",
  "name": "vlog",
  "description": "SystemVerilog — HDL compiler and simulation tools (ModelSim/QuestaSim, Verilator, Icarus)",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-sv",
      "description": "Enable SystemVerilog features"
    },
    {
      "name": "+incdir+<path>",
      "description": "Add include search directory"
    },
    {
      "name": "+define+<macro>",
      "description": "Define a preprocessor macro"
    },
    {
      "name": "-work",
      "description": "Target library for compilation"
    },
    {
      "name": "-lint",
      "description": "Enable lint-style warnings"
    },
    {
      "name": "-timescale",
      "description": "Set default timescale"
    },
    {
      "name": "-Wall",
      "description": "Enable all warnings (Verilator)"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    }
  ],
  "subcommands": [
    {
      "name": "file.sv",
      "description": "Compile SystemVerilog file",
      "args": [
        {
          "name": "file",
          "description": "SystemVerilog source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-work",
          "description": "Library to compile into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "+incdir+",
          "description": "Add an include search directory",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-sv",
          "description": "Enable SystemVerilog features",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-timescale",
          "description": "Default timescale to apply",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-sv file.sv",
      "description": "Force SystemVerilog language mode",
      "args": [
        {
          "name": "file",
          "description": "SystemVerilog source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-work",
          "description": "Library to compile into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "+incdir+",
          "description": "Add an include search directory",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-sv",
          "description": "Enable SystemVerilog features",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-timescale",
          "description": "Default timescale to apply",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-lint file.sv",
      "description": "Run lint checks on SystemVerilog",
      "args": [
        {
          "name": "file",
          "description": "SystemVerilog source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-work",
          "description": "Library to compile into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "+incdir+",
          "description": "Add an include search directory",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-sv",
          "description": "Enable SystemVerilog features",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-timescale",
          "description": "Default timescale to apply",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "+incdir+path file.sv",
      "description": "Compile with include directory",
      "args": [
        {
          "name": "path",
          "description": "Include directory to add",
          "type": "directory",
          "required": true
        },
        {
          "name": "file",
          "description": "SystemVerilog source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-work",
          "description": "Library to compile into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "+incdir+",
          "description": "Add an include search directory",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-sv",
          "description": "Enable SystemVerilog features",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-timescale",
          "description": "Default timescale to apply",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-work library file.sv",
      "description": "Compile into a named library",
      "args": [
        {
          "name": "library",
          "description": "Library to compile into",
          "type": "string",
          "required": true
        },
        {
          "name": "file",
          "description": "SystemVerilog source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-work",
          "description": "Library to compile into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "+incdir+",
          "description": "Add an include search directory",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-sv",
          "description": "Enable SystemVerilog features",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-timescale",
          "description": "Default timescale to apply",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "vlog -sv design.sv testbench.sv",
    "verilator --lint-only -Wall design.sv",
    "iverilog -g2012 -o sim design.sv testbench.sv && vvp sim",
    "vlog +incdir+./rtl -sv top.sv && vsim work.top",
    "verilator --cc --exe --build design.sv sim_main.cpp"
  ],
  "relatedCommands": [
    "make",
    "gtkwave",
    "pla",
    "mips"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "SystemVerilog compiler version",
        "command": "vlog -version 2>/dev/null || verilator --version 2>/dev/null || iverilog -V 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "sources",
        "description": "SystemVerilog sources in this project",
        "command": "find . -maxdepth 3 -name '*.sv' -o -maxdepth 3 -name '*.svh' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "filelists",
        "description": "Compilation file lists present",
        "command": "ls *.f filelist.txt 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "work_library",
        "description": "ModelSim work library present",
        "command": "ls work 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
