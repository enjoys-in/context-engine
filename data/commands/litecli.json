{
  "name": "litecli",
  "description": "SQLite client with auto-completion and syntax highlighting",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--execute",
      "description": "Run this command and exit",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--table",
      "description": "Render output as a table",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--csv",
      "description": "Render output as CSV",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--liteclirc",
      "description": "Configuration file to use",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--auto-vertical-output",
      "description": "Switch to vertical output when rows are wide",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "litecli app.db",
      "description": "Open a database"
    },
    {
      "command": "litecli -e \"SELECT * FROM users LIMIT 5\" app.db",
      "description": "Run one query and exit"
    },
    {
      "command": "litecli --csv -e \"SELECT * FROM t\" app.db",
      "description": "Emit CSV"
    }
  ],
  "relatedCommands": [
    "sqlite3",
    "pgcli",
    "mycli",
    "sqlite-utils"
  ]
}
