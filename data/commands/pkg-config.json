{
  "name": "pkg-config",
  "description": "Report compiler and linker flags for installed libraries",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--cflags",
      "description": "Print the compile flags",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--libs",
      "description": "Print the link flags",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--libs-only-l",
      "description": "Print only the -l flags",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--libs-only-L",
      "description": "Print only the -L flags",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--cflags-only-I",
      "description": "Print only the -I flags",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--modversion",
      "description": "Print the module version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--exists",
      "description": "Exit zero if the module is present",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--list-all",
      "description": "List every known module",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--static",
      "description": "Include flags needed for static linking",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--atleast-version",
      "description": "Require at least this version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--variable",
      "description": "Print the value of this .pc variable",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--print-errors",
      "description": "Report errors for missing modules",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "pkg-config --cflags --libs openssl",
      "description": "Get the flags for a library"
    },
    {
      "command": "gcc app.c $(pkg-config --cflags --libs glib-2.0)",
      "description": "Compile against a library"
    },
    {
      "command": "pkg-config --modversion libcurl",
      "description": "Check an installed version"
    },
    {
      "command": "pkg-config --list-all",
      "description": "List every known module"
    }
  ],
  "relatedCommands": [
    "gcc",
    "cmake",
    "meson",
    "make"
  ]
}
