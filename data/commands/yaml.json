{
  "language": "yaml",
  "name": "yq",
  "description": "yq — YAML/JSON/XML processor (like jq for YAML)",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-i / --inplace",
      "description": "Edit file in-place"
    },
    {
      "name": "-o / --output-format",
      "description": "Output format: yaml, json, xml, tsv, csv, props"
    },
    {
      "name": "-P / --prettyPrint",
      "description": "Pretty print output"
    },
    {
      "name": "-C / --colors",
      "description": "Force color output"
    },
    {
      "name": "-N / --no-doc",
      "description": "Remove document separators (---)"
    },
    {
      "name": "-e / --expression",
      "description": "yq expression to evaluate"
    },
    {
      "name": "--front-matter",
      "description": "Process YAML front matter in files"
    },
    {
      "name": "--indent",
      "description": "Set indentation level (default: 2)"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    }
  ],
  "subcommands": [
    {
      "name": ".key file.yaml",
      "description": "Extract a value by key path",
      "args": [
        {
          "name": "expression",
          "description": "Expression to evaluate",
          "type": "string",
          "required": true
        },
        {
          "name": "file",
          "description": "YAML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--input-format",
          "description": "Input format to parse",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false,
          "short": "-M",
          "shorthand": "-M"
        }
      ]
    },
    {
      "name": "-i '.key = val' file.yaml",
      "description": "Update a value in-place",
      "args": [
        {
          "name": "expression",
          "description": "Expression to evaluate",
          "type": "string",
          "required": true
        },
        {
          "name": "file",
          "description": "YAML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--input-format",
          "description": "Input format to parse",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false,
          "short": "-M",
          "shorthand": "-M"
        }
      ]
    },
    {
      "name": "eval '.' file.yaml",
      "description": "Pretty-print YAML file",
      "args": [
        {
          "name": "expression",
          "description": "Expression to evaluate",
          "type": "string",
          "required": true
        },
        {
          "name": "file",
          "description": "YAML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--input-format",
          "description": "Input format to parse",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false,
          "short": "-M",
          "shorthand": "-M"
        }
      ]
    },
    {
      "name": "eval-all 'select(.kind==\"Deployment\")' *.yaml",
      "description": "Filter across multiple YAML files",
      "args": [
        {
          "name": "expression",
          "description": "Expression to evaluate",
          "type": "string",
          "required": true
        },
        {
          "name": "files",
          "description": "YAML files to act on",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--input-format",
          "description": "Input format to parse",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false,
          "short": "-M",
          "shorthand": "-M"
        }
      ]
    },
    {
      "name": "-o json file.yaml",
      "description": "Convert YAML to JSON",
      "args": [
        {
          "name": "file",
          "description": "YAML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--input-format",
          "description": "Input format to parse",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false,
          "short": "-M",
          "shorthand": "-M"
        }
      ]
    },
    {
      "name": "-P file.json",
      "description": "Convert JSON to YAML (pretty print)",
      "args": [
        {
          "name": "file",
          "description": "YAML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--input-format",
          "description": "Input format to parse",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false,
          "short": "-M",
          "shorthand": "-M"
        }
      ]
    }
  ],
  "examples": [
    "yq '.metadata.name' deployment.yaml",
    "yq -i '.spec.replicas = 3' deployment.yaml",
    "yq -o json config.yaml > config.json",
    "yq eval-all 'select(.kind == \"Service\")' *.yaml",
    "yq '. *= load(\"overrides.yaml\")' base.yaml",
    "cat values.yaml | yq '.image.tag'"
  ],
  "relatedCommands": [
    "jq",
    "toml",
    "ini",
    "kubectl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "yq version",
        "command": "yq --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "yq"
      },
      {
        "name": "yaml_files",
        "description": "YAML files in this directory",
        "command": "find . -maxdepth 2 -name '*.yaml' -o -maxdepth 2 -name '*.yml' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "alternatives",
        "description": "Other YAML tools available",
        "command": "which yamllint dasel 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
