{
  "name": "dlv",
  "description": "Delve — debugger for Go",
  "category": "go",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "debug",
      "description": "Compile and debug a package",
      "options": [
        {
          "name": "--headless",
          "description": "Run as a server with no terminal UI",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--listen",
          "description": "Address to listen on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--api-version",
          "description": "DAP or JSON-RPC API version",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--build-flags",
          "description": "Flags to pass to the compiler",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to debug",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "test",
      "description": "Compile and debug a test binary",
      "options": [
        {
          "name": "--headless",
          "description": "Run as a server with no terminal UI",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--build-flags",
          "description": "Flags to pass to the compiler",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package whose tests to debug",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "attach",
      "description": "Attach to a running process",
      "options": [
        {
          "name": "--headless",
          "description": "Run as a server with no terminal UI",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "pid",
          "description": "Process id",
          "type": "integer",
          "required": true
        }
      ]
    },
    {
      "name": "exec",
      "description": "Debug a pre-built binary",
      "options": [
        {
          "name": "--headless",
          "description": "Run as a server with no terminal UI",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "binary",
          "description": "Binary to debug",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "connect",
      "description": "Connect to a headless Delve server",
      "args": [
        {
          "name": "addr",
          "description": "Server address",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--headless",
          "description": "Run without an interactive client",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--api-version",
          "description": "Delve API version to speak",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "trace",
      "description": "Trace a function without stopping",
      "options": [
        {
          "name": "--exec",
          "description": "Binary to trace",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "regexp",
          "description": "Function pattern to trace",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "core",
      "description": "Debug a core dump",
      "args": [
        {
          "name": "binary",
          "description": "Binary",
          "type": "file",
          "required": true
        },
        {
          "name": "core",
          "description": "Core file",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--log",
          "description": "Enable debug logging",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "dap",
      "description": "Run a DAP server for editor integration",
      "options": [
        {
          "name": "--listen",
          "description": "Address to listen on",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log",
      "description": "Enable logging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log-output",
      "description": "Log components to enable",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--accept-multiclient",
      "description": "Allow more than one client to connect",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--check-go-version",
      "description": "Verify the Go version is supported",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--only-same-user",
      "description": "Reject connections from other users",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "dlv debug ./cmd/api",
      "description": "Compile and debug a package"
    },
    {
      "command": "dlv test ./pkg/store",
      "description": "Debug the tests for a package"
    },
    {
      "command": "dlv attach 12345",
      "description": "Attach to a running process"
    },
    {
      "command": "dlv debug --headless --listen=:2345 ./cmd/api",
      "description": "Run a debug server for an editor"
    }
  ],
  "relatedCommands": [
    "gdb",
    "lldb",
    "go",
    "gopls"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Delve version",
        "command": "dlv version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dlv"
      },
      {
        "name": "go_version",
        "description": "Go toolchain Delve will debug",
        "command": "go version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "go"
      },
      {
        "name": "main_packages",
        "description": "Main packages Delve can launch",
        "command": "grep -rl 'func main()' --include='*.go' . 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Delve configuration",
        "command": "cat ~/.config/dlv/config.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
