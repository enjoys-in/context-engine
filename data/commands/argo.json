{
  "name": "argo",
  "description": "Argo Workflows CLI for running workflows on Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "submit",
      "description": "Submit a workflow",
      "examples": [
        "argo submit workflow.yaml",
        "argo submit workflow.yaml -p message=hello",
        "argo submit workflow.yaml --watch",
        "argo submit workflow.yaml --wait"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--watch",
          "description": "Follow the workflow to completion",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--wait",
          "description": "Block until it finishes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--parameter",
          "description": "Workflow parameter, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--parameter-file",
          "description": "Parameter file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--generate-name",
          "description": "Name prefix to generate from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--serviceaccount",
          "description": "Service account to run as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from",
          "description": "Submit from a template",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "list",
      "description": "List workflows",
      "examples": [
        "argo list",
        "argo list -n my-ns",
        "argo list --status Running",
        "argo list --completed"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all-namespaces",
          "description": "Every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--status",
          "description": "Only these statuses",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--completed",
          "description": "Only completed workflows",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--running",
          "description": "Only running workflows",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "get",
      "description": "Get workflow details",
      "examples": [
        "argo get my-workflow",
        "argo get my-workflow -o json",
        "argo get my-workflow -o yaml"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format (wide, json, yaml)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--node-field-selector",
          "description": "Filter the displayed nodes",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "workflow",
          "description": "Workflow to fetch",
          "required": true,
          "type": "job",
          "completion": {
            "detector": "workflows"
          }
        }
      ]
    },
    {
      "name": "logs",
      "description": "View workflow logs",
      "examples": [
        "argo logs my-workflow",
        "argo logs my-workflow --follow",
        "argo logs my-workflow -c main"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--since",
          "description": "Look back this far",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tail",
          "description": "Lines to show from the end",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--container",
          "description": "Container to read from",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--previous",
          "description": "Read the previous container",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "workflow",
          "description": "Workflow to read logs from",
          "required": true,
          "type": "job",
          "completion": {
            "detector": "workflows"
          }
        }
      ]
    },
    {
      "name": "watch",
      "description": "Watch a workflow",
      "examples": [
        "argo watch my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--node-field-selector",
          "description": "Filter the displayed nodes",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete workflows",
      "examples": [
        "argo delete my-workflow",
        "argo delete --all",
        "argo delete --completed"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Delete every workflow",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--completed",
          "description": "Delete completed workflows",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--older",
          "description": "Delete workflows older than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Delete without waiting for cleanup",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "workflow",
          "description": "Workflow to delete",
          "required": false,
          "type": "job",
          "completion": {
            "detector": "workflows"
          }
        }
      ]
    },
    {
      "name": "retry",
      "description": "Retry a workflow",
      "examples": [
        "argo retry my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--restart-successful",
          "description": "Also rerun successful nodes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--node-field-selector",
          "description": "Nodes to retry",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "resubmit",
      "description": "Resubmit a workflow",
      "examples": [
        "argo resubmit my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--memoized",
          "description": "Reuse memoized results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--priority",
          "description": "Workflow priority",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "suspend",
      "description": "Suspend a workflow",
      "examples": [
        "argo suspend my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "resume",
      "description": "Resume a workflow",
      "examples": [
        "argo resume my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--node-field-selector",
          "description": "Nodes to resume",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop a workflow",
      "examples": [
        "argo stop my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--message",
          "description": "Message to record",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--node-field-selector",
          "description": "Nodes to stop",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "workflow",
          "description": "Workflow to stop",
          "required": true,
          "type": "job",
          "completion": {
            "detector": "workflows"
          }
        }
      ]
    },
    {
      "name": "terminate",
      "description": "Terminate a workflow",
      "examples": [
        "argo terminate my-workflow"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Terminate every workflow",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "lint",
      "description": "Lint workflow files",
      "examples": [
        "argo lint workflow.yaml",
        "argo lint ./workflows/"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--strict",
          "description": "Fail on warnings",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Workflow manifest to lint",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "cron",
      "description": "Manage cron workflows",
      "examples": [
        "argo cron list",
        "argo cron create cron-workflow.yaml",
        "argo cron get my-cron",
        "argo cron delete my-cron",
        "argo cron suspend my-cron",
        "argo cron resume my-cron"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "template",
      "description": "Manage workflow templates",
      "examples": [
        "argo template list",
        "argo template create template.yaml",
        "argo template get my-template",
        "argo template delete my-template"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "cluster-template",
      "description": "Manage cluster workflow templates",
      "examples": [
        "argo cluster-template list",
        "argo cluster-template create template.yaml"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "server",
      "description": "Start Argo UI server",
      "examples": [
        "argo server"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--auth-mode",
          "description": "Authentication mode",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namespaced",
          "description": "Run in namespaced mode",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "archive",
      "description": "Manage workflow archives",
      "examples": [
        "argo archive list",
        "argo archive get uid"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--server",
      "description": "Argo server address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--token",
      "description": "Bearer token",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output format (json, yaml, wide, name)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-o"
    }
  ],
  "examples": [
    "argo submit workflow.yaml --watch",
    "argo list",
    "argo get my-workflow",
    "argo logs my-workflow --follow",
    "argo delete --completed",
    "argo cron list",
    "argo lint workflow.yaml",
    "argo template list"
  ],
  "relatedCommands": [
    "kubectl",
    "argocd",
    "tkn",
    "flux"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Argo Workflows CLI version",
        "command": "argo version --short 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "argo"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "workflows",
        "description": "Argo workflows in the active namespace",
        "command": "argo list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "argo"
      },
      {
        "name": "templates",
        "description": "Workflow templates available",
        "command": "argo template list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "argo"
      }
    ]
  }
}
