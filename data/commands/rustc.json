{
  "name": "rustc",
  "description": "Rust compiler",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--edition",
      "description": "Rust edition (2015, 2018, 2021, 2024)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-O",
      "description": "Optimize"
    },
    {
      "name": "-g",
      "description": "Include debug info"
    },
    {
      "name": "--emit",
      "description": "Emit type (asm, llvm-ir, obj, link, dep-info)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--target",
      "description": "Target triple",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--crate-type",
      "description": "Crate type (bin, lib, dylib, staticlib)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-C",
      "description": "Codegen option",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--explain",
      "description": "Explain error code",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-W",
      "description": "Set lint to warn",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-A",
      "description": "Set lint to allow",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Set lint to deny",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "rustc main.rs",
    "rustc -O -o app main.rs",
    "rustc --edition 2021 main.rs",
    "rustc --explain E0308",
    "rustc --emit asm main.rs"
  ],
  "relatedCommands": [
    "cargo",
    "rust",
    "rustup",
    "clippy"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "rustc version",
        "command": "rustc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "rustc"
      },
      {
        "name": "host",
        "description": "rustc host triple and sysroot",
        "command": "rustc -vV 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "rustc"
      },
      {
        "name": "toolchain",
        "description": "Active Rust toolchain",
        "command": "rustup show active-toolchain 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "rustup"
      },
      {
        "name": "manifest",
        "description": "Cargo package manifest",
        "command": "cat Cargo.toml 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
