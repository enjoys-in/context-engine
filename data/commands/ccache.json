{
  "name": "ccache",
  "description": "Compiler cache that speeds up recompilation",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-stats",
      "description": "Print the cache statistics",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--zero-stats",
      "description": "Reset the statistics",
      "type": "boolean",
      "takesValue": false,
      "short": "-z",
      "shorthand": "-z"
    },
    {
      "name": "--clear",
      "description": "Empty the cache",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--cleanup",
      "description": "Trim the cache to its size limit",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--max-size",
      "description": "Maximum cache size, e.g. 5G",
      "type": "string",
      "takesValue": true,
      "short": "-M",
      "shorthand": "-M"
    },
    {
      "name": "--max-files",
      "description": "Maximum number of cached files",
      "type": "integer",
      "takesValue": true,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--set-config",
      "description": "Set a configuration key, key=value",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show-config",
      "description": "Print the current configuration",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--print-stats",
      "description": "Print statistics in machine-readable form",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ccache -s",
      "description": "Show hit and miss statistics"
    },
    {
      "command": "ccache -M 10G",
      "description": "Raise the cache size limit"
    },
    {
      "command": "ccache -C",
      "description": "Empty the cache"
    },
    {
      "command": "CC=\"ccache gcc\" make",
      "description": "Build through the cache"
    }
  ],
  "relatedCommands": [
    "gcc",
    "make",
    "ninja",
    "sccache"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ccache version",
        "command": "ccache --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ccache"
      },
      {
        "name": "statistics",
        "description": "ccache hit rate and cache size",
        "command": "ccache --show-stats 2>/dev/null | head -20",
        "parser": "keyvalue",
        "cacheFor": 60,
        "requiresCmd": "ccache"
      },
      {
        "name": "config",
        "description": "ccache configuration",
        "command": "ccache --show-config 2>/dev/null | head -20",
        "parser": "keyvalue",
        "cacheFor": 300,
        "requiresCmd": "ccache"
      },
      {
        "name": "cache_dir",
        "description": "ccache storage directory",
        "command": "echo \"${CCACHE_DIR:-$HOME/.ccache}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
