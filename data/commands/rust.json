{
  "language": "rust",
  "name": "rust",
  "description": "Rust programming language tools (rustc, cargo)",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "short": "-V",
      "description": "Show version",
      "shorthand": "-V"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    }
  ],
  "subcommands": [
    {
      "name": "cargo new",
      "description": "Create a new Cargo package",
      "args": [
        {
          "name": "<name>",
          "type": "string",
          "required": true,
          "description": "Package name"
        }
      ],
      "options": [
        {
          "name": "--lib",
          "description": "Create a library"
        },
        {
          "name": "--bin",
          "description": "Create a binary (default)"
        }
      ],
      "examples": [
        "cargo new myproject",
        "cargo new --lib mylib"
      ]
    },
    {
      "name": "cargo init",
      "description": "Create a new Cargo package in existing directory",
      "examples": [
        "cargo init",
        "cargo init --lib"
      ],
      "options": [
        {
          "name": "--bin",
          "description": "Create a binary crate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--lib",
          "description": "Create a library crate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--name",
          "description": "Package name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--edition",
          "description": "Rust edition to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--vcs",
          "description": "Version control system to initialise",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cargo build",
      "description": "Compile the current package",
      "options": [
        {
          "name": "--release",
          "description": "Build in release mode"
        },
        {
          "name": "--target",
          "description": "Target triple",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--features",
          "description": "Space/comma-separated features",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--all-features",
          "description": "Activate all features"
        }
      ],
      "examples": [
        "cargo build",
        "cargo build --release",
        "cargo build --target x86_64-unknown-linux-musl"
      ]
    },
    {
      "name": "cargo run",
      "description": "Run the main binary",
      "options": [
        {
          "name": "--release",
          "description": "Run in release mode"
        },
        {
          "name": "--bin",
          "description": "Run specific binary",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "cargo run",
        "cargo run --release",
        "cargo run -- arg1 arg2"
      ]
    },
    {
      "name": "cargo test",
      "description": "Run tests",
      "options": [
        {
          "name": "--release",
          "description": "Test in release mode"
        },
        {
          "name": "--lib",
          "description": "Only test library"
        },
        {
          "name": "--doc",
          "description": "Only run doc tests"
        },
        {
          "name": "--no-run",
          "description": "Compile but don't run"
        }
      ],
      "examples": [
        "cargo test",
        "cargo test -- --nocapture",
        "cargo test test_name"
      ],
      "args": [
        {
          "name": "filter",
          "description": "Only run tests whose name matches",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "cargo check",
      "description": "Check code without producing binary",
      "examples": [
        "cargo check",
        "cargo check --all-targets"
      ],
      "options": [
        {
          "name": "--all-targets",
          "description": "Check every target",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all-features",
          "description": "Enable every feature",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--workspace",
          "description": "Check every workspace member",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--release",
          "description": "Check with optimisations",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--target",
          "description": "Target triple to check for",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cargo clippy",
      "description": "Run lints",
      "options": [
        {
          "name": "--fix",
          "description": "Auto-fix warnings"
        },
        {
          "name": "-- -D warnings",
          "description": "Deny all warnings"
        }
      ],
      "examples": [
        "cargo clippy",
        "cargo clippy --fix",
        "cargo clippy -- -D warnings"
      ]
    },
    {
      "name": "cargo fmt",
      "description": "Format Rust code",
      "options": [
        {
          "name": "--check",
          "description": "Check formatting without modifying"
        }
      ],
      "examples": [
        "cargo fmt",
        "cargo fmt --check"
      ]
    },
    {
      "name": "cargo add",
      "description": "Add dependency to Cargo.toml",
      "args": [
        {
          "name": "<crate>",
          "type": "string",
          "required": true,
          "description": "Crate name"
        }
      ],
      "options": [
        {
          "name": "--dev",
          "short": "-D",
          "description": "Add as dev dependency",
          "shorthand": "-D"
        },
        {
          "name": "--features",
          "short": "-F",
          "description": "Activate features",
          "type": "string",
          "takesValue": true,
          "shorthand": "-F"
        }
      ],
      "examples": [
        "cargo add serde",
        "cargo add serde -F derive",
        "cargo add -D tokio-test"
      ]
    },
    {
      "name": "cargo remove",
      "description": "Remove dependency from Cargo.toml",
      "args": [
        {
          "name": "<crate>",
          "type": "string",
          "required": true,
          "description": "Crate name"
        }
      ],
      "examples": [
        "cargo remove serde"
      ],
      "options": [
        {
          "name": "--dev",
          "description": "Remove from dev-dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--build",
          "description": "Remove from build-dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--package",
          "description": "Package to remove the dependency from",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "cargo update",
      "description": "Update dependencies",
      "examples": [
        "cargo update",
        "cargo update -p serde"
      ],
      "options": [
        {
          "name": "--package",
          "description": "Only update this package",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--aggressive",
          "description": "Also update transitive dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--precise",
          "description": "Update to exactly this version",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cargo doc",
      "description": "Generate documentation",
      "options": [
        {
          "name": "--open",
          "description": "Open in browser"
        },
        {
          "name": "--no-deps",
          "description": "Skip dependencies"
        }
      ],
      "examples": [
        "cargo doc --open",
        "cargo doc --no-deps"
      ]
    },
    {
      "name": "cargo publish",
      "description": "Publish crate to crates.io",
      "options": [
        {
          "name": "--dry-run",
          "description": "Simulate publish"
        }
      ],
      "examples": [
        "cargo publish",
        "cargo publish --dry-run"
      ]
    },
    {
      "name": "cargo bench",
      "description": "Run benchmarks",
      "examples": [
        "cargo bench"
      ],
      "options": [
        {
          "name": "--bench",
          "description": "Only run this benchmark target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--all-features",
          "description": "Enable every feature",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-run",
          "description": "Compile the benchmarks without running them",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--package",
          "description": "Package to benchmark",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "cargo install",
      "description": "Install a Rust binary crate",
      "args": [
        {
          "name": "<crate>",
          "type": "string",
          "required": true,
          "description": "Crate name"
        }
      ],
      "examples": [
        "cargo install ripgrep",
        "cargo install cargo-edit"
      ],
      "options": [
        {
          "name": "--version",
          "description": "Version to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--locked",
          "description": "Use the lockfile as published",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Reinstall over an existing binary",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--path",
          "description": "Install from this local path",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--git",
          "description": "Install from this git repository",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--features",
          "description": "Features to enable",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cargo clean",
      "description": "Remove build artifacts",
      "examples": [
        "cargo clean"
      ],
      "options": [
        {
          "name": "--release",
          "description": "Only clean the release profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--target",
          "description": "Only clean this target triple",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--package",
          "description": "Only clean this package",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--doc",
          "description": "Only clean the documentation output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "rustup update",
      "description": "Update Rust toolchains",
      "examples": [
        "rustup update",
        "rustup update stable"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Update even when already current",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-self-update",
          "description": "Do not update rustup itself",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "toolchain",
          "description": "Toolchain to update, such as stable",
          "required": false,
          "type": "version"
        }
      ]
    },
    {
      "name": "rustup default",
      "description": "Set default toolchain",
      "args": [
        {
          "name": "<toolchain>",
          "type": "version",
          "required": true,
          "description": "Toolchain name"
        }
      ],
      "examples": [
        "rustup default stable",
        "rustup default nightly"
      ],
      "options": []
    },
    {
      "name": "rustup target add",
      "description": "Add compilation target",
      "args": [
        {
          "name": "<target>",
          "type": "string",
          "required": true,
          "description": "Target triple"
        }
      ],
      "examples": [
        "rustup target add wasm32-unknown-unknown",
        "rustup target add x86_64-unknown-linux-musl"
      ],
      "options": [
        {
          "name": "--toolchain",
          "description": "Toolchain to add the target to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "rustup component add",
      "description": "Add toolchain component",
      "args": [
        {
          "name": "<component>",
          "type": "string",
          "required": true,
          "description": "Component name"
        }
      ],
      "examples": [
        "rustup component add clippy",
        "rustup component add rustfmt"
      ],
      "options": [
        {
          "name": "--toolchain",
          "description": "Toolchain to add the component to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--target",
          "description": "Target the component applies to",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "cargo new myapp && cd myapp && cargo run",
    "cargo build --release",
    "cargo test && cargo clippy && cargo fmt --check"
  ],
  "relatedCommands": [
    "rustc",
    "rustup",
    "cargo-edit",
    "cargo-watch",
    "wasm-pack"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Rust toolchain version",
        "command": "rustc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "rustc"
      },
      {
        "name": "cargo_version",
        "description": "Cargo version",
        "command": "cargo --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cargo"
      },
      {
        "name": "toolchain",
        "description": "Active Rust toolchain",
        "command": "rustup show active-toolchain 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "rustup"
      },
      {
        "name": "manifest",
        "description": "Cargo package manifest",
        "command": "cat Cargo.toml 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "targets",
        "description": "Binary and library targets in this crate",
        "command": "cargo metadata --no-deps --format-version 1 2>/dev/null | head -c 2000",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "cargo"
      }
    ]
  }
}
