{
  "language": "sparql",
  "name": "sparql",
  "description": "SPARQL query tools for RDF/linked data (Apache Jena, Blazegraph, rdflib)",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--service",
      "description": "SPARQL endpoint URL"
    },
    {
      "name": "--data",
      "description": "Path to local RDF data file"
    },
    {
      "name": "--output",
      "description": "Output format (json, xml, csv, tsv, turtle)"
    },
    {
      "name": "--timeout",
      "description": "Query timeout in milliseconds"
    },
    {
      "name": "--graph",
      "description": "Named graph URI"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    }
  ],
  "subcommands": [
    {
      "name": "query",
      "description": "Execute a SPARQL query against an endpoint or local file",
      "args": [
        {
          "name": "query",
          "description": "SPARQL query to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--service",
          "description": "SPARQL endpoint URL to query",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--data",
          "description": "Local RDF data file to query",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the result to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Execute a SPARQL UPDATE operation",
      "args": [
        {
          "name": "update",
          "description": "Update statement to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--service",
          "description": "SPARQL endpoint URL to query",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--data",
          "description": "Local RDF data file to query",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "validate",
      "description": "Validate RDF data using SHACL shapes",
      "args": [
        {
          "name": "data",
          "description": "RDF data to validate",
          "type": "file",
          "required": true
        },
        {
          "name": "shapes",
          "description": "SHACL shapes file to validate against",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--format",
          "description": "Serialization format (turtle, ntriples, rdfxml, json)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "load",
      "description": "Load RDF data into a triplestore",
      "args": [
        {
          "name": "file",
          "description": "RDF data file to load",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--graph",
          "description": "Named graph IRI to target",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Serialization format (turtle, ntriples, rdfxml, json)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "export",
      "description": "Export triplestore data to file",
      "args": [],
      "options": [
        {
          "name": "--graph",
          "description": "Named graph IRI to target",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Serialization format (turtle, ntriples, rdfxml, json)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the result to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "server",
      "description": "Start SPARQL endpoint server (Fuseki)",
      "args": [],
      "options": [
        {
          "name": "--port",
          "description": "Port to serve the dataset on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--dataset",
          "description": "Dataset name to serve",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "rsparql --service http://dbpedia.org/sparql --query 'SELECT ?s WHERE { ?s a dbo:Country } LIMIT 10'",
    "arq --data data.ttl --query query.rq",
    "fuseki-server --mem /dataset --port 3030",
    "riot --validate data.ttl",
    "s-update --service http://localhost:3030/ds/update --update insert.ru"
  ],
  "relatedCommands": [
    "sql",
    "graphql",
    "curl",
    "jq"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "tools",
        "description": "SPARQL clients available on this host",
        "command": "which rsparql arq sparql roqet 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "queries",
        "description": "SPARQL query files in this project",
        "command": "find . -maxdepth 2 -name '*.rq' -o -name '*.sparql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "datasets",
        "description": "RDF datasets available to query",
        "command": "find . -maxdepth 2 -name '*.ttl' -o -name '*.nt' -o -name '*.rdf' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
