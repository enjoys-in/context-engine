{
  "name": "eb",
  "description": "AWS Elastic Beanstalk CLI",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize EB app",
      "examples": [
        "eb init",
        "eb init my-app --platform node.js-18 --region us-west-2"
      ],
      "options": [
        {
          "name": "--platform",
          "description": "Platform to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--region",
          "description": "Region to deploy in",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--keyname",
          "description": "EC2 key pair to use",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--interactive",
          "description": "Force the interactive wizard",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "create",
      "description": "Create an environment",
      "examples": [
        "eb create my-env",
        "eb create my-env --instance-type t3.small",
        "eb create my-env --single --instance-type t3.micro",
        "eb create --envvars KEY1=val1,KEY2=val2"
      ],
      "options": [
        {
          "name": "--cname",
          "description": "CNAME prefix",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--instance_type",
          "description": "EC2 instance type",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--single",
          "description": "Create a single-instance environment",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--elb-type",
          "description": "Load balancer type",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--scale",
          "description": "Initial instance count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--sample",
          "description": "Deploy the sample application",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--envvars",
          "description": "Environment variables, key=value",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy application",
      "examples": [
        "eb deploy",
        "eb deploy my-env",
        "eb deploy --staged"
      ],
      "options": [
        {
          "name": "--label",
          "description": "Version label",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--message",
          "description": "Version description",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--staged",
          "description": "Deploy the staged changes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timeout",
          "description": "Minutes to wait",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "status",
      "description": "Show environment status",
      "examples": [
        "eb status",
        "eb status my-env"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Include instance detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "health",
      "description": "Show detailed health info",
      "examples": [
        "eb health",
        "eb health --refresh"
      ],
      "options": [
        {
          "name": "--refresh",
          "description": "Refresh continuously",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--mono",
          "description": "Disable colour",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--view",
          "description": "View to show (status, request, cpu)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "logs",
      "description": "View logs",
      "examples": [
        "eb logs",
        "eb logs --all",
        "eb logs -cw enable"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Retrieve every log",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--zip",
          "description": "Download the logs as a zip",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--stream",
          "description": "Stream the logs",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--log-group",
          "description": "CloudWatch log group",
          "type": "string",
          "takesValue": true,
          "short": "-g",
          "shorthand": "-g"
        }
      ]
    },
    {
      "name": "open",
      "description": "Open app in browser",
      "examples": [
        "eb open"
      ]
    },
    {
      "name": "ssh",
      "description": "SSH into instance",
      "examples": [
        "eb ssh",
        "eb ssh my-env"
      ],
      "options": [
        {
          "name": "--instance",
          "description": "Instance to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--command",
          "description": "Command to run remotely",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--setup",
          "description": "Configure SSH access",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "config",
      "description": "Modify configuration",
      "examples": [
        "eb config",
        "eb config save",
        "eb config put my-config"
      ],
      "options": [
        {
          "name": "--display",
          "description": "Print the configuration",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--nohang",
          "description": "Do not wait for the update",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "scale",
      "description": "Scale environment",
      "examples": [
        "eb scale 3",
        "eb scale 3 my-env"
      ],
      "options": [
        {
          "name": "--timeout",
          "description": "Minutes to wait",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "setenv",
      "description": "Set environment variables",
      "examples": [
        "eb setenv KEY=value",
        "eb setenv DB_HOST=mydb.rds.amazonaws.com DB_PORT=5432"
      ],
      "options": [
        {
          "name": "--timeout",
          "description": "Minutes to wait",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "printenv",
      "description": "Print environment variables",
      "examples": [
        "eb printenv"
      ]
    },
    {
      "name": "terminate",
      "description": "Terminate environment",
      "examples": [
        "eb terminate",
        "eb terminate my-env --force"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all",
          "description": "Terminate the whole application",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--nohang",
          "description": "Do not wait for completion",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "list",
      "description": "List environments",
      "examples": [
        "eb list"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Include environment detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--all",
          "description": "Include every application",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "use",
      "description": "Set default environment",
      "examples": [
        "eb use my-env"
      ]
    },
    {
      "name": "clone",
      "description": "Clone an environment",
      "examples": [
        "eb clone my-env --clone-name my-env-clone"
      ],
      "options": [
        {
          "name": "--clone_name",
          "description": "Name for the clone",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--cname",
          "description": "CNAME prefix",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--exact",
          "description": "Keep the source platform version",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "swap",
      "description": "Swap environment CNAMEs",
      "examples": [
        "eb swap my-env --destination-name my-env-clone"
      ],
      "options": [
        {
          "name": "--destination_name",
          "description": "Environment to swap with",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "restore",
      "description": "Restore terminated environment",
      "examples": [
        "eb restore env-id"
      ]
    },
    {
      "name": "abort",
      "description": "Abort environment update",
      "examples": [
        "eb abort"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--profile",
      "description": "AWS CLI profile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--region",
      "description": "AWS region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Verbose output"
    }
  ],
  "examples": [
    "eb init my-app --platform node.js-18",
    "eb create my-env",
    "eb deploy",
    "eb status",
    "eb logs --all",
    "eb ssh",
    "eb open",
    "eb setenv NODE_ENV=production",
    "eb scale 3",
    "eb health --refresh"
  ],
  "relatedCommands": [
    "aws",
    "copilot",
    "docker",
    "heroku"
  ]
}
