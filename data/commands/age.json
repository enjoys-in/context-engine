{
  "name": "age",
  "description": "Simple, modern file encryption tool",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-e",
      "description": "Encrypt (default)"
    },
    {
      "name": "-d",
      "description": "Decrypt"
    },
    {
      "name": "-r",
      "description": "Recipient public key",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-R",
      "description": "Recipients file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Identity file for decryption",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-a",
      "description": "ASCII armor"
    },
    {
      "name": "-p",
      "description": "Passphrase encryption"
    }
  ],
  "examples": [
    "age -r age1... file.txt > file.txt.age",
    "age -d -i key.txt file.txt.age > file.txt",
    "age-keygen -o key.txt",
    "age -p file.txt > file.txt.age",
    "age -d -i key.txt -o file.txt file.txt.age"
  ],
  "relatedCommands": [
    "gpg",
    "sops",
    "openssl",
    "ssh"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "age version",
        "command": "age --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "age"
      },
      {
        "name": "recipients",
        "description": "age recipient files present",
        "command": "ls ~/.age 2>/dev/null; ls *.age-recipients 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "encrypted_files",
        "description": "age-encrypted files in this project",
        "command": "find . -maxdepth 3 -name '*.age' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
