{
  "name": "cheat",
  "description": "Create and view interactive cheatsheets on the command line",
  "category": "environment",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--list",
      "description": "List the available cheatsheets",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--edit",
      "description": "Edit a cheatsheet",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--search",
      "description": "Search cheatsheet contents",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--tag",
      "description": "Filter by tag",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--path",
      "description": "Filter by cheatpath",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--all",
      "description": "Search every cheatpath",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--colorize",
      "description": "Colour the output",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--regex",
      "description": "Treat the search as a regex",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--directories",
      "description": "List the configured cheatpaths",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--init",
      "description": "Print a starter configuration",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "cheat tar",
      "description": "Show the tar cheatsheet"
    },
    {
      "command": "cheat -l",
      "description": "List the available sheets"
    },
    {
      "command": "cheat -s \"ssh tunnel\"",
      "description": "Search across sheets"
    },
    {
      "command": "cheat -e docker",
      "description": "Edit a personal sheet"
    }
  ],
  "relatedCommands": [
    "tldr",
    "navi",
    "man",
    "help"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "cheat version",
        "command": "cheat --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cheat"
      },
      {
        "name": "cheatsheets",
        "description": "Cheatsheets available locally",
        "command": "cheat -l 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "cheat"
      },
      {
        "name": "config",
        "description": "cheat configuration",
        "command": "cat ~/.config/cheat/conf.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
