{
  "language": "markdown",
  "name": "markdownlint",
  "description": "Markdown linting, formatting, and conversion tools (markdownlint, pandoc, markdown-it)",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Path to markdownlint configuration file"
    },
    {
      "name": "--fix",
      "description": "Automatically fix lint violations"
    },
    {
      "name": "--ignore",
      "description": "Glob pattern of files to ignore"
    },
    {
      "name": "--output",
      "description": "Output file path"
    },
    {
      "name": "--dot",
      "description": "Include dotfiles in file search"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "lint",
      "description": "Lint markdown files for style violations",
      "args": [
        {
          "name": "files",
          "description": "Markdown documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Path to the configuration file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--fix",
          "description": "Apply automatic fixes where possible",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ignore",
          "description": "Glob of files to skip",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "fix",
      "description": "Automatically fix markdown lint violations",
      "args": [
        {
          "name": "files",
          "description": "Markdown documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Path to the configuration file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "convert",
      "description": "Convert markdown to other formats using pandoc",
      "args": [
        {
          "name": "input",
          "description": "Markdown document to convert",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-f",
          "description": "Input format to convert from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-t",
          "description": "Output format to convert to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-o",
          "description": "Write the output to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "render",
      "description": "Render markdown to HTML with markdown-it",
      "args": [
        {
          "name": "file",
          "description": "Markdown document to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--html",
          "description": "Render HTML output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--linkify",
          "description": "Turn bare URLs into links",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "toc",
      "description": "Generate table of contents for markdown file",
      "args": [
        {
          "name": "file",
          "description": "Markdown document to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--maxdepth",
          "description": "Deepest heading level to include in the table of contents",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--bullets",
          "description": "Bullet characters to use for list levels",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check-links",
      "description": "Check for broken links in markdown files",
      "args": [
        {
          "name": "files",
          "description": "Markdown documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--alive",
          "description": "HTTP status codes to treat as alive",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--retry",
          "description": "Retry requests that are rate limited",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "npx markdownlint '**/*.md' --fix",
    "npx markdownlint --config .markdownlint.json README.md",
    "pandoc README.md -f markdown -t html -o README.html",
    "pandoc input.md -o output.pdf",
    "npx markdown-link-check README.md"
  ],
  "relatedCommands": [
    "prettier",
    "pandoc",
    "html",
    "mdx"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "markdownlint version",
        "command": "markdownlint --version 2>/dev/null || npx markdownlint --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "markdownlint rule configuration",
        "command": "cat .markdownlint.json 2>/dev/null || cat .markdownlint.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "documents",
        "description": "Markdown documents in this project",
        "command": "find . -maxdepth 3 -name '*.md' -not -path './node_modules/*' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "pandoc",
        "description": "pandoc available for conversion",
        "command": "pandoc --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
