{
  "name": "ghc",
  "description": "Glasgow Haskell Compiler",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-O",
      "description": "Optimize (0, 1, 2)"
    },
    {
      "name": "-c",
      "description": "Compile only (no link)"
    },
    {
      "name": "-e",
      "description": "Evaluate expression",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--make",
      "description": "Build program and dependencies"
    },
    {
      "name": "-i",
      "description": "Add directory to import path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-Wall",
      "description": "Enable all warnings"
    },
    {
      "name": "-Werror",
      "description": "Treat warnings as errors"
    },
    {
      "name": "-dynamic",
      "description": "Dynamically linked"
    },
    {
      "name": "-threaded",
      "description": "Enable threaded runtime"
    },
    {
      "name": "-prof",
      "description": "Enable profiling"
    }
  ],
  "examples": [
    "ghc -o hello Main.hs",
    "ghc --make Main.hs",
    "ghc -O2 -o app Main.hs",
    "ghci",
    "ghc -e 'putStrLn \"Hello\"'"
  ],
  "relatedCommands": [
    "cabal",
    "stack",
    "ghci",
    "haskell"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GHC version",
        "command": "ghc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ghc"
      },
      {
        "name": "packages",
        "description": "Globally registered GHC packages",
        "command": "ghc-pkg list --simple-output 2>/dev/null | tr ' ' '\\n' | head -30",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "sources",
        "description": "Haskell sources",
        "command": "find . -maxdepth 3 -name '*.hs' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "project_files",
        "description": "Haskell project files present",
        "command": "ls *.cabal stack.yaml cabal.project 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
