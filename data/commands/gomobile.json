{
  "name": "gomobile",
  "description": "Build and bind Go packages for Android and iOS",
  "category": "mobile",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Prepare the gomobile toolchain",
      "options": [
        {
          "name": "-ndk",
          "description": "Android NDK path to use",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "gomobile init"
      ]
    },
    {
      "name": "build",
      "description": "Build an app for a mobile target",
      "options": [
        {
          "name": "-target",
          "description": "Target platform (android, ios)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-o",
          "description": "Output file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-bundleid",
          "description": "Bundle identifier for iOS",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-ldflags",
          "description": "Linker flags",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to build",
          "type": "package",
          "required": false,
          "completion": {
            "detector": "module"
          }
        }
      ],
      "examples": [
        "gomobile build golang.org/x/example/basic"
      ]
    },
    {
      "name": "bind",
      "description": "Generate a language binding library",
      "options": [
        {
          "name": "-target",
          "description": "Target platform (android, ios)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-o",
          "description": "Output file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-javapkg",
          "description": "Java package name for Android",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-prefix",
          "description": "Objective-C name prefix",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to bind",
          "type": "package",
          "required": false,
          "completion": {
            "detector": "module"
          }
        }
      ],
      "examples": [
        "gomobile bind golang.org/x/example/basic"
      ]
    },
    {
      "name": "install",
      "description": "Build and install on a connected Android device",
      "options": [
        {
          "name": "-target",
          "description": "Target platform",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Go package to build and install",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "module"
          }
        }
      ],
      "examples": [
        "gomobile install golang.org/x/example/basic"
      ]
    },
    {
      "name": "version",
      "description": "Show the gomobile version",
      "examples": [
        "gomobile version"
      ]
    },
    {
      "name": "clean",
      "description": "Remove the cached build artifacts",
      "examples": [
        "gomobile clean"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "-v",
      "description": "Print verbose output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-x",
      "description": "Print the commands that run",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-work",
      "description": "Keep the temporary work directory",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "gomobile init",
      "description": "Prepare the toolchain"
    },
    {
      "command": "gomobile build -target=android ./cmd/app",
      "description": "Build an Android app"
    },
    {
      "command": "gomobile bind -target=ios -o Core.xcframework ./core",
      "description": "Generate an iOS binding"
    },
    {
      "command": "gomobile install -target=android ./cmd/app",
      "description": "Build and install on a device"
    }
  ],
  "relatedCommands": [
    "go",
    "adb",
    "xcodebuild",
    "flutter"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "gomobile version",
        "command": "gomobile version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gomobile"
      },
      {
        "name": "go_version",
        "description": "Go toolchain gomobile uses",
        "command": "go version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "go"
      },
      {
        "name": "android_sdk",
        "description": "Android SDK location",
        "command": "echo \"${ANDROID_HOME:-${ANDROID_SDK_ROOT:-unset}}\"",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "ndk",
        "description": "Android NDK location",
        "command": "echo \"${ANDROID_NDK_HOME:-unset}\"",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "module",
        "description": "Go module gomobile will bind",
        "command": "head -3 go.mod 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
