{
  "name": "choco",
  "description": "Chocolatey package manager for Windows",
  "category": "package-manager",
  "platforms": [
    "windows"
  ],
  "shells": [
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true,
          "type": "package"
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Confirm all prompts"
        },
        {
          "name": "--version",
          "description": "Specific version",
          "takesValue": true
        },
        {
          "name": "--pre",
          "description": "Include prerelease"
        },
        {
          "name": "--force",
          "shorthand": "-f",
          "description": "Force install",
          "short": "-f"
        },
        {
          "name": "--params",
          "description": "Package parameters",
          "takesValue": true
        },
        {
          "name": "--install-arguments",
          "shorthand": "-ia",
          "description": "Install arguments",
          "takesValue": true,
          "short": "-ia"
        },
        {
          "name": "--override-arguments",
          "shorthand": "-o",
          "description": "Override default arguments",
          "short": "-o"
        },
        {
          "name": "--x86",
          "description": "Force 32-bit"
        },
        {
          "name": "--ignore-checksums",
          "description": "Ignore checksums"
        },
        {
          "name": "--no-progress",
          "description": "Hide progress"
        },
        {
          "name": "--source",
          "shorthand": "-s",
          "description": "Package source",
          "takesValue": true,
          "short": "-s"
        }
      ],
      "examples": [
        "choco install git"
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Confirm all"
        },
        {
          "name": "--force",
          "description": "Force uninstall"
        },
        {
          "name": "--all-versions",
          "description": "Remove all versions"
        }
      ],
      "examples": [
        "choco uninstall git"
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names (or all)",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Confirm all"
        },
        {
          "name": "--except",
          "description": "Exclude packages",
          "takesValue": true
        },
        {
          "name": "--pre",
          "description": "Include prerelease"
        },
        {
          "name": "--noop",
          "description": "Dry run / simulation"
        }
      ],
      "examples": [
        "choco upgrade git"
      ]
    },
    {
      "name": "search",
      "description": "Search packages",
      "args": [
        {
          "name": "query",
          "description": "Search term",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--exact",
          "description": "Exact match"
        },
        {
          "name": "--source",
          "shorthand": "-s",
          "description": "Source",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--pre",
          "description": "Include prerelease"
        },
        {
          "name": "--page",
          "description": "Page number",
          "takesValue": true
        },
        {
          "name": "--page-size",
          "description": "Page size",
          "takesValue": true
        }
      ],
      "examples": [
        "choco search query"
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        {
          "name": "--local-only",
          "shorthand": "-l",
          "description": "Local only (installed)",
          "short": "-l"
        },
        {
          "name": "--pre",
          "description": "Include prerelease"
        }
      ],
      "examples": [
        "choco list"
      ]
    },
    {
      "name": "info",
      "description": "Get package info",
      "args": [
        {
          "name": "package",
          "description": "Package name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--local-only",
          "description": "Query the local installation",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--version",
          "description": "Specific version to describe",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "choco info git"
      ]
    },
    {
      "name": "outdated",
      "description": "Show outdated packages",
      "options": [
        {
          "name": "--ignore-pinned",
          "description": "Skip pinned packages",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "choco outdated"
      ]
    },
    {
      "name": "pin",
      "description": "Pin a package version",
      "subcommands": [
        {
          "name": "add",
          "description": "Pin a package",
          "options": [
            {
              "name": "--name",
              "description": "Package to pin",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            },
            {
              "name": "--version",
              "description": "Version to pin at",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "choco pin add"
          ]
        },
        {
          "name": "remove",
          "description": "Unpin a package",
          "options": [
            {
              "name": "--name",
              "description": "Package to unpin",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "examples": [
            "choco pin remove"
          ]
        },
        {
          "name": "list",
          "description": "List pinned packages",
          "options": [
            {
              "name": "--limit-output",
              "description": "Machine-readable output",
              "type": "boolean",
              "takesValue": false,
              "short": "-r",
              "shorthand": "-r"
            },
            {
              "name": "--no-progress",
              "description": "Suppress progress reporting",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "choco pin list"
          ]
        }
      ]
    },
    {
      "name": "source",
      "description": "Manage sources",
      "subcommands": [
        {
          "name": "add",
          "description": "Add source",
          "options": [
            {
              "name": "--name",
              "description": "Source name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            },
            {
              "name": "--source",
              "description": "Source URL",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--user",
              "description": "Username",
              "type": "string",
              "takesValue": true,
              "short": "-u",
              "shorthand": "-u"
            },
            {
              "name": "--password",
              "description": "Password",
              "type": "string",
              "takesValue": true,
              "short": "-p",
              "shorthand": "-p"
            },
            {
              "name": "--priority",
              "description": "Source priority",
              "type": "integer",
              "takesValue": true
            }
          ],
          "examples": [
            "choco source add"
          ]
        },
        {
          "name": "remove",
          "description": "Remove source",
          "options": [
            {
              "name": "--name",
              "description": "Source name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Source to remove",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "choco source remove name"
          ]
        },
        {
          "name": "list",
          "description": "List sources",
          "options": [
            {
              "name": "--limit-output",
              "description": "Machine-readable output",
              "type": "boolean",
              "takesValue": false,
              "short": "-r",
              "shorthand": "-r"
            },
            {
              "name": "--no-progress",
              "description": "Suppress progress reporting",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "choco source list"
          ]
        },
        {
          "name": "enable",
          "description": "Enable source",
          "options": [
            {
              "name": "--name",
              "description": "Source name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Source to enable",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "choco source enable name"
          ]
        },
        {
          "name": "disable",
          "description": "Disable source",
          "options": [
            {
              "name": "--name",
              "description": "Source name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Source to disable",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "choco source disable name"
          ]
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage config",
      "subcommands": [
        {
          "name": "get",
          "description": "Get config value",
          "options": [
            {
              "name": "--name",
              "description": "Setting name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Configuration key to read",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "choco config get name"
          ]
        },
        {
          "name": "set",
          "description": "Set config value",
          "options": [
            {
              "name": "--name",
              "description": "Setting name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            },
            {
              "name": "--value",
              "description": "Setting value",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "choco config set"
          ]
        },
        {
          "name": "unset",
          "description": "Unset config",
          "options": [
            {
              "name": "--name",
              "description": "Setting name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "examples": [
            "choco config unset"
          ]
        },
        {
          "name": "list",
          "description": "List config",
          "options": [
            {
              "name": "--limit-output",
              "description": "Machine-readable output",
              "type": "boolean",
              "takesValue": false,
              "short": "-r",
              "shorthand": "-r"
            },
            {
              "name": "--no-progress",
              "description": "Suppress progress reporting",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "choco config list"
          ]
        }
      ]
    },
    {
      "name": "feature",
      "description": "Manage features",
      "subcommands": [
        {
          "name": "list",
          "description": "List features",
          "options": [
            {
              "name": "--limit-output",
              "description": "Machine-readable output",
              "type": "boolean",
              "takesValue": false,
              "short": "-r",
              "shorthand": "-r"
            },
            {
              "name": "--no-progress",
              "description": "Suppress progress reporting",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "choco feature list"
          ]
        },
        {
          "name": "enable",
          "description": "Enable feature",
          "options": [
            {
              "name": "--name",
              "description": "Feature name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Feature to enable",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "choco feature enable name"
          ]
        },
        {
          "name": "disable",
          "description": "Disable feature",
          "options": [
            {
              "name": "--name",
              "description": "Feature name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Feature to disable",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "choco feature disable name"
          ]
        }
      ]
    },
    {
      "name": "pack",
      "description": "Create a package from nuspec",
      "options": [
        {
          "name": "--version",
          "description": "Package version",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output-directory",
          "description": "Directory for the nupkg",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "choco pack"
      ]
    },
    {
      "name": "push",
      "description": "Push package to repository",
      "options": [
        {
          "name": "--source",
          "description": "Push target",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--api-key",
          "description": "API key to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package file to push",
          "required": false,
          "type": "file"
        }
      ],
      "examples": [
        "choco push file.txt"
      ]
    },
    {
      "name": "new",
      "description": "Create new package template",
      "options": [
        {
          "name": "--name",
          "description": "Package name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Package version",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--maintainer",
          "description": "Maintainer name",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "choco new"
      ]
    },
    {
      "name": "export",
      "description": "Export installed packages to file",
      "options": [
        {
          "name": "--include-version-numbers",
          "description": "Pin exact versions",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output-file-path",
          "description": "File to write",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "File to write the package list to",
          "required": false,
          "type": "file"
        }
      ],
      "examples": [
        "choco export file.txt"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-y",
      "description": "Confirm all prompts"
    },
    {
      "name": "-f",
      "description": "Force"
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--debug",
      "description": "Debug output"
    },
    {
      "name": "--trace",
      "description": "Trace output"
    },
    {
      "name": "--no-color",
      "description": "No colors"
    },
    {
      "name": "--limit-output",
      "shorthand": "-r",
      "description": "Limit output for parsing",
      "short": "-r"
    },
    {
      "name": "--timeout",
      "description": "Command timeout",
      "takesValue": true
    },
    {
      "name": "--cache-location",
      "shorthand": "-c",
      "description": "Cache location",
      "takesValue": true,
      "short": "-c"
    },
    {
      "name": "--allow-unofficial-build",
      "description": "Allow unofficial build"
    }
  ],
  "examples": [
    {
      "command": "choco install git -y",
      "description": "Install Git"
    },
    {
      "command": "choco install nodejs python3 -y",
      "description": "Install multiple packages"
    },
    {
      "command": "choco install nodejs --version 18.0.0",
      "description": "Specific version"
    },
    {
      "command": "choco upgrade all -y",
      "description": "Upgrade all packages"
    },
    {
      "command": "choco search redis",
      "description": "Search packages"
    },
    {
      "command": "choco list -l",
      "description": "List installed"
    },
    {
      "command": "choco outdated",
      "description": "Show outdated"
    },
    {
      "command": "choco uninstall nodejs -y",
      "description": "Uninstall"
    },
    {
      "command": "choco pin add -n nodejs --version 18.0.0",
      "description": "Pin version"
    },
    {
      "command": "choco export packages.config",
      "description": "Export package list"
    }
  ],
  "relatedCommands": [
    "winget",
    "scoop"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed",
        "description": "Installed packages",
        "command": "choco list -l -r 2>$null | Select-Object -Last 20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "choco"
      },
      {
        "name": "outdated",
        "description": "Outdated packages",
        "command": "choco outdated -r 2>$null | Select-Object -First 15",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "choco"
      },
      {
        "name": "sources",
        "description": "Configured sources",
        "command": "choco source list -r 2>$null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "choco"
      },
      {
        "name": "pinned",
        "description": "Pinned packages",
        "command": "choco pin list -r 2>$null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "choco"
      }
    ]
  }
}
