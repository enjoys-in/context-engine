{
  "language": "coffee",
  "name": "coffee",
  "description": "CoffeeScript command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "-c file.coffee",
      "description": "Compile CoffeeScript to JavaScript",
      "args": [],
      "options": [
        {
          "name": "--output",
          "description": "Directory to write compiled JavaScript to",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--map",
          "description": "Generate a source map",
          "type": "boolean",
          "takesValue": false,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--bare",
          "description": "Compile without the top-level function wrapper",
          "type": "boolean",
          "takesValue": false,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--no-header",
          "description": "Omit the generated-by header",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-w file.coffee",
      "description": "Watch and compile on changes",
      "args": [],
      "options": [
        {
          "name": "--output",
          "description": "Directory to write compiled JavaScript to",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--compile",
          "description": "Compile on each change",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--bare",
          "description": "Compile without the top-level function wrapper",
          "type": "boolean",
          "takesValue": false,
          "short": "-b",
          "shorthand": "-b"
        }
      ]
    },
    {
      "name": "-p file.coffee",
      "description": "Print compiled JS to stdout",
      "args": [],
      "options": [
        {
          "name": "--bare",
          "description": "Compile without the top-level function wrapper",
          "type": "boolean",
          "takesValue": false,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--no-header",
          "description": "Omit the generated-by header",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-e 'code'",
      "description": "Evaluate CoffeeScript expression",
      "args": [],
      "options": [
        {
          "name": "--bare",
          "description": "Compile without the top-level function wrapper",
          "type": "boolean",
          "takesValue": false,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--print",
          "description": "Print the result rather than running it",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "lint",
      "description": "Lint CoffeeScript",
      "usage": "coffeelint app.coffee",
      "options": [],
      "args": [
        {
          "name": "files",
          "description": "CoffeeScript files to lint",
          "required": false,
          "type": "path"
        }
      ]
    },
    {
      "name": "eval",
      "description": "Evaluate CoffeeScript expression",
      "usage": "coffee -e 'console.log 1 + 2'",
      "options": []
    },
    {
      "name": "repl",
      "description": "Start CoffeeScript REPL",
      "usage": "coffee",
      "options": []
    },
    {
      "name": "tokens",
      "description": "Print token stream",
      "usage": "coffee --tokens app.coffee",
      "options": []
    },
    {
      "name": "nodes",
      "description": "Print AST nodes",
      "usage": "coffee --nodes app.coffee",
      "options": []
    }
  ],
  "examples": [
    {
      "command": "coffee app.coffee",
      "description": "Run a CoffeeScript file"
    },
    {
      "command": "coffee -c app.coffee",
      "description": "Compile CoffeeScript to JavaScript"
    },
    {
      "command": "coffee -w -c src/",
      "description": "Watch and compile a directory"
    },
    {
      "command": "coffee --map app.coffee",
      "description": "Compile with source maps"
    }
  ],
  "relatedCommands": [
    "node",
    "npm",
    "babel",
    "tsc"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "CoffeeScript compiler version",
        "command": "coffee --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "coffee"
      },
      {
        "name": "sources",
        "description": "CoffeeScript sources in this project",
        "command": "find . -maxdepth 3 -name '*.coffee' -not -path './node_modules/*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
