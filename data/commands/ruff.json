{
  "name": "ruff",
  "description": "Extremely fast Python linter and formatter, written in Rust",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "check",
      "description": "Lint files and report violations",
      "options": [
        {
          "name": "--fix",
          "description": "Apply automatic fixes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--unsafe-fixes",
          "description": "Also apply fixes marked unsafe",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--select",
          "description": "Rule codes to enable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ignore",
          "description": "Rule codes to disable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--watch",
          "description": "Re-run when files change",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--statistics",
          "description": "Summarise counts per rule",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output-format",
          "description": "Report format (text, json, github, gitlab, sarif)",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files or directories to lint",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "format",
      "description": "Format files",
      "options": [
        {
          "name": "--check",
          "description": "Report which files would change and exit non-zero",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--diff",
          "description": "Print the formatting diff instead of writing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--line-length",
          "description": "Maximum line length",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files or directories to format",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "rule",
      "description": "Explain a rule",
      "options": [
        {
          "name": "--all",
          "description": "Describe every rule",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "code",
          "description": "Rule code, e.g. E501",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "linter",
      "description": "List the supported linters and their prefixes"
    },
    {
      "name": "clean",
      "description": "Delete the cache directories"
    },
    {
      "name": "config",
      "description": "Show the resolved configuration",
      "args": [
        {
          "name": "option",
          "description": "Configuration key to describe",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Show the ruff version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Path to a ruff.toml or pyproject.toml",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--isolated",
      "description": "Ignore all configuration files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-cache",
      "description": "Disable the cache",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "ruff check .",
      "description": "Lint the current tree"
    },
    {
      "command": "ruff check --fix .",
      "description": "Lint and apply safe fixes"
    },
    {
      "command": "ruff format .",
      "description": "Format the current tree"
    },
    {
      "command": "ruff check --select I --fix .",
      "description": "Sort imports only"
    },
    {
      "command": "ruff rule E501",
      "description": "Explain the line-too-long rule"
    }
  ],
  "relatedCommands": [
    "black",
    "flake8",
    "pylint",
    "isort",
    "mypy"
  ]
}
