{
  "name": "node",
  "description": "JavaScript runtime built on Chrome's V8 JavaScript engine",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Execute a script file",
      "args": [
        {
          "name": "<script>",
          "type": "file",
          "required": true,
          "description": "Script file to run"
        }
      ],
      "examples": [
        "node app.js",
        "node src/index.js"
      ],
      "options": [
        {
          "name": "--if-present",
          "description": "Do nothing when the script is missing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "eval",
      "description": "Evaluate a string as JavaScript",
      "args": [
        {
          "name": "<code>",
          "type": "string",
          "required": true,
          "description": "JavaScript code"
        }
      ],
      "examples": [
        "node -e \"console.log('hello')\"",
        "node -e \"process.versions\""
      ],
      "options": [
        {
          "name": "--input-type",
          "description": "Treat the input as module or commonjs",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--version",
      "short": "-v",
      "description": "Print Node.js version",
      "shorthand": "-v"
    },
    {
      "name": "--eval",
      "short": "-e",
      "description": "Evaluate string as JS",
      "type": "string",
      "takesValue": true,
      "shorthand": "-e"
    },
    {
      "name": "--print",
      "short": "-p",
      "description": "Evaluate and print result",
      "type": "string",
      "takesValue": true,
      "shorthand": "-p"
    },
    {
      "name": "--check",
      "short": "-c",
      "description": "Syntax check without executing",
      "shorthand": "-c"
    },
    {
      "name": "--inspect",
      "description": "Activate inspector on host:port",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--inspect-brk",
      "description": "Activate inspector and break on first line",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--require",
      "short": "-r",
      "description": "Preload module at startup",
      "type": "string",
      "takesValue": true,
      "shorthand": "-r"
    },
    {
      "name": "--experimental-modules",
      "description": "Enable ES module support"
    },
    {
      "name": "--max-old-space-size",
      "description": "Set V8 max old space size (MB)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--env-file",
      "description": "Load environment variables from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--watch",
      "description": "Run in watch mode (restart on file changes)"
    },
    {
      "name": "--test",
      "description": "Run test runner"
    }
  ],
  "examples": [
    "node app.js",
    "node --inspect app.js",
    "node -e \"console.log(process.version)\"",
    "node --max-old-space-size=4096 build.js",
    "node --watch src/server.js"
  ],
  "relatedCommands": [
    "npm",
    "npx",
    "yarn",
    "pnpm",
    "nvm",
    "fnm",
    "deno",
    "bun"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Node.js version",
        "command": "node --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "node"
      },
      {
        "name": "npm_version",
        "description": "npm version bundled with this Node",
        "command": "npm --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "npm"
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "engines",
        "description": "Node version this project requires",
        "command": "grep -A5 '\"engines\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "version_file",
        "description": "Node version pinned for this project",
        "command": "cat .nvmrc 2>/dev/null || cat .node-version 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
