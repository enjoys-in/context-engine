{
  "name": "http-server",
  "aliases": [
    "serve"
  ],
  "description": "Zero-configuration static file server",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--port",
      "description": "Port to listen on",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--address",
      "description": "Address to bind to",
      "type": "string",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--cors",
      "description": "Send permissive CORS headers",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--ssl",
      "description": "Serve over HTTPS",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--cert",
      "description": "TLS certificate file",
      "type": "file",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--key",
      "description": "TLS key file",
      "type": "file",
      "takesValue": true,
      "short": "-K",
      "shorthand": "-K"
    },
    {
      "name": "--gzip",
      "description": "Serve pre-compressed .gz files",
      "type": "boolean",
      "takesValue": false,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--brotli",
      "description": "Serve pre-compressed .br files",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--cache",
      "description": "Cache-Control max-age in seconds",
      "type": "integer",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--proxy",
      "description": "Proxy unhandled requests to this URL",
      "type": "url",
      "takesValue": true,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--silent",
      "description": "Suppress request logging",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--utc",
      "description": "Use UTC timestamps in logs",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--index",
      "description": "Serve this file for directory requests",
      "type": "string",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--no-dotfiles",
      "description": "Do not serve dotfiles",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "http-server",
      "description": "Serve the current directory on port 8080"
    },
    {
      "command": "http-server -p 3000 --cors",
      "description": "Serve on a port with CORS enabled"
    },
    {
      "command": "http-server dist -c-1",
      "description": "Serve a build directory with caching disabled"
    },
    {
      "command": "http-server -S -C cert.pem -K key.pem",
      "description": "Serve over HTTPS"
    }
  ],
  "relatedCommands": [
    "serve",
    "nginx",
    "caddy",
    "python",
    "vite"
  ]
}
