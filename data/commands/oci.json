  "subcommands": [
    {
      "name": "compute instance",
      "description": "Manage compute instances",
      "examples": [
        "oci compute instance list --compartment-id ocid",
        "oci compute instance launch --availability-domain AD-1 --compartment-id ocid --image-id img-ocid --shape VM.Standard2.1 --subnet-id subnet-ocid",
        "oci compute instance terminate --instance-id ocid --force",
        "oci compute instance action --action STOP --instance-id ocid"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Configuration profile to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format: json, table or yaml",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--query",
          "description": "JMESPath expression to filter the response",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--config-file",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--auth",
          "description": "Authentication method to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against compute instance, such as list",
          "type": "string",
          "required": true
        }
      ]
    },
