  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "OCI CLI version",
        "command": "oci --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "oci"
      },
      {
        "name": "profiles",
        "description": "OCI configuration profiles",
        "command": "grep -o '^\\[.*\\]' ~/.oci/config 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "region",
        "description": "OCI region in effect",
        "command": "grep -m1 '^region' ~/.oci/config 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
