{
  "language": "toml",
  "name": "toml",
  "description": "TOML file manipulation and validation tools (taplo, toml-cli, dasel)",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Path to taplo configuration file"
    },
    {
      "name": "--schema",
      "description": "JSON Schema URL or path for validation"
    },
    {
      "name": "--check",
      "description": "Check formatting without writing changes"
    },
    {
      "name": "--output",
      "description": "Output file path"
    },
    {
      "name": "--colors",
      "description": "Enable or disable colored output"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "format",
      "description": "Format TOML files with taplo",
      "args": [
        {
          "name": "files",
          "description": "TOML files to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Path to the configuration file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--check",
          "description": "Verify formatting without writing changes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "lint",
      "description": "Lint TOML files for schema compliance",
      "args": [
        {
          "name": "files",
          "description": "TOML files to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--schema",
          "description": "JSON Schema to validate against",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "get",
      "description": "Get a value from a TOML file by key path",
      "args": [
        {
          "name": "file",
          "description": "TOML file to act on",
          "type": "file",
          "required": true
        },
        {
          "name": "key",
          "description": "Key to act on",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: toml, json or value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--strip-newline",
          "description": "Omit the trailing newline",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "set",
      "description": "Set a value in a TOML file",
      "args": [
        {
          "name": "file",
          "description": "TOML file to act on",
          "type": "file",
          "required": true
        },
        {
          "name": "key",
          "description": "Key to act on",
          "type": "string",
          "required": true
        },
        {
          "name": "value",
          "description": "Value to set",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--type",
          "description": "Type of the value being set (string, integer, bool, array)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "validate",
      "description": "Validate TOML file syntax",
      "args": [
        {
          "name": "file",
          "description": "TOML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--schema",
          "description": "JSON Schema to validate against",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "convert",
      "description": "Convert TOML to JSON or YAML",
      "args": [
        {
          "name": "file",
          "description": "TOML file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--to",
          "description": "Format to convert to (json, yaml)",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "taplo format Cargo.toml",
    "taplo lint pyproject.toml --schema https://json.schemastore.org/pyproject",
    "taplo format --check '**/*.toml'",
    "toml get Cargo.toml package.version",
    "dasel -f config.toml '.database.port'"
  ],
  "relatedCommands": [
    "yaml",
    "json",
    "ini",
    "jq"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "taplo version",
        "command": "taplo --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "taplo"
      },
      {
        "name": "toml_files",
        "description": "TOML files in this project",
        "command": "find . -maxdepth 3 -name '*.toml' -not -path './node_modules/*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "taplo configuration",
        "command": "cat .taplo.toml 2>/dev/null || cat taplo.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "alternatives",
        "description": "Other TOML tools available",
        "command": "which dasel toml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
