{
  "name": "port",
  "description": "MacPorts package manager",
  "category": "package-manager",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install ports",
      "options": [
        {
          "name": "-v",
          "description": "Print verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-N",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "port",
          "description": "Port to install",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Remove ports",
      "options": [
        {
          "name": "--follow-dependents",
          "description": "Also remove dependents",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "port",
          "description": "Port to remove",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "selfupdate",
      "description": "Update MacPorts and the ports tree"
    },
    {
      "name": "upgrade",
      "description": "Upgrade installed ports",
      "options": [
        {
          "name": "--enforce-variants",
          "description": "Rebuild to match the requested variants",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "port",
          "description": "Port to upgrade, or outdated",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "search",
      "description": "Search the ports tree",
      "options": [
        {
          "name": "--name",
          "description": "Match the name only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--glob",
          "description": "Treat the query as a glob",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "query",
          "description": "Search terms",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "info",
      "description": "Show details about a port",
      "args": [
        {
          "name": "port",
          "description": "Port name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "installed",
      "description": "List the installed ports",
      "options": [
        {
          "name": "--requested",
          "description": "Only explicitly requested ports",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "outdated",
      "description": "List ports with newer versions available"
    },
    {
      "name": "deps",
      "description": "Show the dependencies of a port",
      "args": [
        {
          "name": "port",
          "description": "Port name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "variants",
      "description": "List the build variants of a port",
      "args": [
        {
          "name": "port",
          "description": "Port name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Remove build artifacts",
      "options": [
        {
          "name": "--all",
          "description": "Clean everything for the port",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "port",
          "description": "Port name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "reclaim",
      "description": "Free disk space by removing unused files"
    },
    {
      "name": "contents",
      "description": "List the files a port installed",
      "args": [
        {
          "name": "port",
          "description": "Port name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "provides",
      "description": "Show which port owns a file",
      "args": [
        {
          "name": "file",
          "description": "File path",
          "type": "file",
          "required": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-d",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-q",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-f",
      "description": "Force the operation",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "sudo port selfupdate",
      "description": "Update MacPorts and the ports tree"
    },
    {
      "command": "sudo port install wget",
      "description": "Install a port"
    },
    {
      "command": "port search --name python",
      "description": "Search by name"
    },
    {
      "command": "sudo port upgrade outdated",
      "description": "Upgrade everything outdated"
    },
    {
      "command": "port provides /opt/local/bin/wget",
      "description": "Find which port owns a file"
    }
  ],
  "relatedCommands": [
    "brew",
    "apt",
    "nix",
    "scoop"
  ]
}
