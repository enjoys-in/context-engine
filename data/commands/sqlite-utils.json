{
  "name": "sqlite-utils",
  "description": "CLI tool and Python library for manipulating SQLite databases",
  "category": "data",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "insert",
      "description": "Insert data from JSON/CSV",
      "examples": [
        "sqlite-utils insert db.sqlite data data.csv --csv",
        "sqlite-utils insert db.sqlite data data.json"
      ],
      "options": [
        {
          "name": "--table",
          "description": "Table to act on",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--nl",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--csv",
          "description": "Emit CSV",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pk",
          "description": "Column to use as the primary key",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--replace",
          "description": "Replace rows with a matching primary key",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--alter",
          "description": "Add any missing columns",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--batch-size",
          "description": "Rows per insert batch",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "query",
      "description": "Execute SQL and return results",
      "examples": [
        "sqlite-utils query db.sqlite 'SELECT * FROM data'"
      ],
      "options": [
        {
          "name": "--table",
          "description": "Table to act on",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--nl",
          "description": "Emit newline-delimited JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--csv",
          "description": "Emit CSV",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--param",
          "description": "Bind a named parameter",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--table",
          "description": "Render the results as a table",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw",
          "description": "Emit raw values rather than JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "tables",
      "description": "List tables",
      "examples": [
        "sqlite-utils tables db.sqlite"
      ],
      "options": [
        {
          "name": "--table",
          "description": "Table to act on",
