  "globalOptions": [
    {
      "name": "--csv",
      "description": "Input is CSV"
    },
    {
      "name": "--json-lines",
      "description": "Input is newline-delimited JSON"
    },
    {
      "name": "--fmt",
      "description": "Output format (json, csv, table)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "sqlite-utils insert db.sqlite data data.csv --csv",
    "sqlite-utils query db.sqlite 'SELECT * FROM data'",
    "sqlite-utils tables db.sqlite",
    "sqlite-utils memory data.csv 'SELECT count(*) FROM data'"
  ],
  "relatedCommands": [
    "sqlite3",
    "csvkit",
    "q",
    "datasette"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "sqlite-utils version",
        "command": "sqlite-utils --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "sqlite-utils"
      },
      {
        "name": "databases",
        "description": "SQLite databases in this directory",
        "command": "find . -maxdepth 2 -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "sqlite_version",
        "description": "SQLite library version available",
        "command": "sqlite3 --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "importable",
        "description": "Files sqlite-utils can import",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.json' -o -name '*.tsv' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
