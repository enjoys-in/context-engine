{
  "name": "hatch",
  "description": "Modern Python project manager and build backend",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create a new project",
      "options": [
        {
          "name": "--init",
          "description": "Initialise in the current directory",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cli",
          "description": "Include a CLI scaffold",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Project name",
          "type": "string",
          "required": false
        }
      ],
      "examples": [
        "hatch new name"
      ]
    },
    {
      "name": "env",
      "description": "Manage project environments",
      "options": [],
      "examples": [
        "hatch env"
      ]
    },
    {
      "name": "run",
      "description": "Run a command in an environment",
      "options": [],
      "args": [
        {
          "name": "command",
          "description": "Script or command to run",
          "required": true,
          "type": "string"
        }
      ],
      "examples": [
        "hatch run command"
      ]
    },
    {
      "name": "build",
      "description": "Build source and wheel distributions",
      "options": [
        {
          "name": "--target",
          "description": "Target to build (sdist, wheel)",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--clean",
          "description": "Remove artifacts first",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "hatch build"
      ]
    },
    {
      "name": "publish",
      "description": "Upload distributions to an index",
      "options": [
        {
          "name": "--repo",
          "description": "Repository to publish to",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--user",
          "description": "Username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--auth",
          "description": "Token or password",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "hatch publish"
      ]
    },
    {
      "name": "version",
      "description": "Show or set the project version",
      "args": [
        {
          "name": "version",
          "description": "New version or bump segment",
          "type": "version",
          "required": false
        }
      ],
      "options": [],
      "examples": [
        "hatch version 1.2.3"
      ]
    },
    {
      "name": "test",
      "description": "Run the test suite",
      "options": [
        {
          "name": "--cover",
          "description": "Measure coverage",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "hatch test"
      ]
    },
    {
      "name": "fmt",
      "description": "Format and lint the project",
      "options": [
        {
          "name": "--check",
          "description": "Report without writing",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "hatch fmt"
      ]
    },
    {
      "name": "shell",
      "description": "Open a shell inside an environment",
      "options": [],
      "examples": [
        "hatch shell"
      ]
    },
    {
      "name": "clean",
      "description": "Remove build artifacts",
      "options": [
        {
          "name": "--env",
          "description": "Environment to clean",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--project",
          "description": "Project to clean",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "hatch clean"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--env",
      "description": "Environment to operate in",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--project",
      "description": "Project to operate on",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "hatch new my-project",
      "description": "Scaffold a new project"
    },
    {
      "command": "hatch run test",
      "description": "Run the test script in the default environment"
    },
    {
      "command": "hatch build",
      "description": "Build sdist and wheel"
    },
    {
      "command": "hatch version minor",
      "description": "Bump the minor version"
    }
  ],
  "relatedCommands": [
    "uv",
    "poetry",
    "pdm",
    "twine"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Hatch version",
        "command": "hatch --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hatch"
      },
      {
        "name": "pyproject",
        "description": "Python project configuration",
        "command": "cat pyproject.toml 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "environments",
        "description": "Hatch environments declared",
        "command": "hatch env show --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "hatch"
      },
      {
        "name": "scripts",
        "description": "Hatch scripts declared",
        "command": "grep -A15 '\\[tool.hatch.envs' pyproject.toml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
