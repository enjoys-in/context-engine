{
  "name": "which",
  "description": "Locate a command",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-a",
      "description": "Print all matching executables in PATH"
    }
  ],
  "examples": [
    "which python",
    "which -a python",
    "which node",
    "which gcc",
    "which npm"
  ],
  "relatedCommands": [
    "whereis",
    "type",
    "command",
    "hash"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "which version",
        "command": "which --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "which"
      },
      {
        "name": "path_entries",
        "description": "Directories searched for executables",
        "command": "echo \"${PATH}\" | tr ':' '\\n'",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "shell",
        "description": "Shell whose builtins may shadow PATH",
        "command": "echo \"${SHELL:-unknown}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
