{
  "name": "cqlsh",
  "description": "Interactive shell for Cassandra CQL",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--username",
      "description": "Username to authenticate as",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--password",
      "description": "Password to authenticate with",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--keyspace",
      "description": "Keyspace to use",
      "type": "string",
      "takesValue": true,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--execute",
      "description": "Run this statement and exit",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--file",
      "description": "Run statements from this file",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--ssl",
      "description": "Connect using TLS",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--connect-timeout",
      "description": "Seconds to wait when connecting",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--request-timeout",
      "description": "Seconds to wait for a request",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--cqlversion",
      "description": "CQL version to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-color",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "cqlsh localhost 9042",
      "description": "Connect to a node"
    },
    {
      "command": "cqlsh -u cassandra -p cassandra",
      "description": "Connect with credentials"
    },
    {
      "command": "cqlsh -e \"DESCRIBE KEYSPACES\"",
      "description": "Run one statement and exit"
    },
    {
      "command": "cqlsh -f schema.cql",
      "description": "Apply a schema file"
    }
  ],
  "relatedCommands": [
    "clickhouse-client",
    "psql",
    "mongosh",
    "sql"
  ]
}
