{
  "name": "nohup",
  "description": "Run a command immune to hangups, with output to a non-tty",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "nohup ./long_script.sh &",
    "nohup python train.py > output.log 2>&1 &",
    "nohup ./server &",
    "nohup command > /dev/null 2>&1 &"
  ],
  "relatedCommands": [
    "screen",
    "tmux",
    "disown",
    "bg"
  ]
}
