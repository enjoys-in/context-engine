{
  "name": "ctr",
  "description": "Low-level containerd client",
  "category": "container",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "images",
      "description": "Manage images"
    },
    {
      "name": "containers",
      "description": "Manage containers"
    },
    {
      "name": "tasks",
      "description": "Manage running tasks"
    },
    {
      "name": "run",
      "description": "Create and start a container",
      "options": [
        {
          "name": "--rm",
          "description": "Remove the container on exit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--tty",
          "description": "Allocate a pseudo-TTY",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--detach",
          "description": "Run in the background",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--env",
          "description": "Set an environment variable",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "pull",
      "description": "Pull an image",
      "options": [
        {
          "name": "--platform",
          "description": "Platform to pull",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--all-platforms",
          "description": "Pull every platform",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "push",
      "description": "Push an image",
      "options": [
        {
          "name": "--platform",
          "description": "Platform to push",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "namespaces",
      "description": "Manage namespaces"
    },
    {
      "name": "snapshots",
      "description": "Manage snapshots"
    },
    {
      "name": "content",
      "description": "Manage the content store"
    },
    {
      "name": "events",
      "description": "Watch the containerd event stream"
    },
    {
      "name": "version",
      "description": "Show the client and server version"
    },
    {
      "name": "plugins",
      "description": "List the loaded plugins"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--namespace",
      "description": "containerd namespace to use",
      "type": "string",
      "takesValue": true,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--address",
      "description": "containerd socket address",
      "type": "string",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--timeout",
      "description": "Request timeout",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ctr images ls",
      "description": "List images"
    },
    {
      "command": "ctr -n k8s.io containers ls",
      "description": "List containers in a namespace"
    },
    {
      "command": "ctr images pull docker.io/library/nginx:latest",
      "description": "Pull an image"
    },
    {
      "command": "ctr run --rm -t docker.io/library/alpine:latest test sh",
      "description": "Run a throwaway container"
    }
  ],
  "relatedCommands": [
    "nerdctl",
    "crictl",
    "docker",
    "containerd"
  ]
}
