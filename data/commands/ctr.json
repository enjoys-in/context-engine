  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "containerd and ctr versions",
        "command": "ctr version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "ctr"
      },
      {
        "name": "namespaces",
        "description": "containerd namespaces",
        "command": "ctr namespaces list 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "ctr"
      },
      {
        "name": "images",
        "description": "Images in the containerd store",
        "command": "ctr images list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "ctr"
      },
      {
        "name": "containers",
        "description": "Containers containerd is holding",
        "command": "ctr containers list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "ctr"
      }
    ]
  }
