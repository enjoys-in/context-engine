{
  "name": "jekyll",
  "description": "Static site generator — transform text into static websites",
  "category": "static-site",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create a new Jekyll site",
      "examples": [
        "jekyll new myblog"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Initialise into a non-empty directory",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--blank",
          "description": "Create an empty scaffold",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-bundle",
          "description": "Do not run bundle install",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Directory for the new site",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "build",
      "description": "Build the site",
      "examples": [
        "jekyll build",
        "jekyll build --destination ./output"
      ],
      "options": [
        {
          "name": "--destination",
          "description": "Directory to write the site to",
          "type": "directory",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--drafts",
          "description": "Include posts in _drafts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--future",
          "description": "Include posts dated in the future",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--incremental",
          "description": "Rebuild only changed posts",
          "type": "boolean",
          "takesValue": false,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--config",
          "description": "Config files to read",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "serve",
      "description": "Start local server",
      "examples": [
        "jekyll serve",
        "jekyll serve --livereload"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-P",
          "shorthand": "-P"
        },
        {
          "name": "--host",
          "description": "Host the server binds to",
          "type": "string",
          "takesValue": true,
          "short": "-H",
          "shorthand": "-H"
        },
        {
          "name": "--livereload",
          "description": "Reload the browser on change",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--drafts",
          "description": "Include posts in _drafts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--detach",
          "description": "Run the server in the background",
          "type": "boolean",
          "takesValue": false,
          "short": "-B",
          "shorthand": "-B"
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Check for issues",
      "examples": [
        "jekyll doctor"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Config files to read",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean the build output",
      "examples": [
        "jekyll clean"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Config files to read",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-s",
      "description": "Source directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Destination directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--drafts",
      "description": "Include drafts"
    },
    {
      "name": "--livereload",
      "description": "Enable live reload"
    },
    {
      "name": "-H",
      "description": "Host to bind to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-P",
      "description": "Port number",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--baseurl",
      "description": "Base URL",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--future",
      "description": "Include future-dated posts"
    }
  ],
  "examples": [
    "jekyll new myblog",
    "jekyll serve",
    "jekyll build",
    "jekyll serve --livereload",
    "jekyll serve --drafts -P 4001"
  ],
  "relatedCommands": [
    "hugo",
    "gatsby",
    "eleventy",
    "bundler"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Jekyll version",
        "command": "jekyll --version 2>/dev/null || bundle exec jekyll --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Jekyll site configuration",
        "command": "cat _config.yml 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "gemfile",
        "description": "Ruby dependencies for this site",
        "command": "cat Gemfile 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "posts",
        "description": "Posts in this Jekyll site",
        "command": "ls _posts 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "collections",
        "description": "Jekyll collections declared",
        "command": "grep -A10 '^collections:' _config.yml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
