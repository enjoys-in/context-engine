{
  "name": "pnpm",
  "description": "Fast, disk space efficient package manager",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Create package.json",
      "examples": [
        "pnpm init"
      ],
      "options": []
    },
    {
      "name": "add",
      "description": "Install a package",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": true,
          "description": "Package name"
        }
      ],
      "options": [
        {
          "name": "--save-dev",
          "short": "-D",
          "description": "Add to devDependencies",
          "shorthand": "-D"
        },
        {
          "name": "--global",
          "short": "-g",
          "description": "Install globally",
          "shorthand": "-g"
        },
        {
          "name": "--save-exact",
          "short": "-E",
          "description": "Save exact version",
          "shorthand": "-E"
        }
      ],
      "examples": [
        "pnpm add express",
        "pnpm add -D typescript",
        "pnpm add -g nodemon"
      ]
    },
    {
      "name": "remove",
      "description": "Remove a package",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": true,
          "description": "Package name"
        }
      ],
      "examples": [
        "pnpm remove lodash"
      ],
      "options": [
        {
          "name": "--save-dev",
          "description": "Remove from devDependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--global",
          "description": "Remove from the global store",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--recursive",
          "description": "Remove from every workspace package",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install all dependencies",
      "options": [
        {
          "name": "--frozen-lockfile",
          "description": "Fail if lockfile needs update"
        },
        {
          "name": "--prod",
          "description": "Only production dependencies"
        }
      ],
      "examples": [
        "pnpm install",
        "pnpm install --frozen-lockfile"
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "required": false,
          "type": "package"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a script",
      "args": [
        {
          "name": "<script>",
          "type": "string",
          "required": true,
          "description": "Script name"
        }
      ],
      "examples": [
        "pnpm run build",
        "pnpm run dev"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Run in every workspace package",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--parallel",
          "description": "Run in every package at once",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--filter",
          "description": "Only run in matching packages",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--if-present",
          "description": "Do nothing when the script is missing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute a command in project scope",
      "args": [
        {
          "name": "<command>",
          "type": "string",
          "required": true,
          "description": "Command"
        }
      ],
      "examples": [
        "pnpm exec tsc --version"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Run in every workspace package",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--parallel",
          "description": "Run in every package at once",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "dlx",
      "description": "Run a package without installing",
      "args": [
        {
          "name": "<command>",
          "type": "string",
          "required": true,
          "description": "Command to run"
        }
      ],
      "examples": [
        "pnpm dlx create-react-app myapp"
      ],
      "options": [
        {
          "name": "--package",
          "description": "Package to run the binary from",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--allow-build",
          "description": "Permit build scripts for these packages",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Update packages",
      "options": [
        {
          "name": "--latest",
          "short": "-L",
          "description": "Update to latest",
          "shorthand": "-L"
        }
      ],
      "examples": [
        "pnpm update",
        "pnpm update --latest"
      ]
    },
    {
      "name": "outdated",
      "description": "Check for outdated packages",
      "examples": [
        "pnpm outdated"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Check every workspace package",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--long",
          "description": "Include the package details",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--format",
          "description": "Output format: table or json",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "store prune",
      "description": "Remove unreferenced packages from store",
      "examples": [
        "pnpm store prune"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Prune despite version mismatches",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "list",
      "description": "List packages",
      "options": [
        {
          "name": "--depth",
          "description": "Depth",
          "type": "number",
          "takesValue": true
        }
      ],
      "examples": [
        "pnpm list",
        "pnpm list --depth 0"
      ]
    },
    {
      "name": "recursive",
      "description": "Run command in all workspace packages",
      "examples": [
        "pnpm -r run build"
      ],
      "options": [
        {
          "name": "--filter",
          "description": "Only act on matching packages",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--parallel",
          "description": "Run in every package at once",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "short": "-v",
      "description": "Show version",
      "shorthand": "-v"
    },
    {
      "name": "--filter",
      "description": "Filter packages in workspace",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--recursive",
      "short": "-r",
      "description": "Run in all packages",
      "shorthand": "-r"
    }
  ],
  "examples": [
    "pnpm add react react-dom",
    "pnpm install --frozen-lockfile",
    "pnpm run build"
  ],
  "relatedCommands": [
    "npm",
    "yarn",
    "npx",
    "node"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "pnpm version",
        "command": "pnpm --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pnpm"
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "workspaces",
        "description": "pnpm workspace packages",
        "command": "cat pnpm-workspace.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "store",
        "description": "pnpm content-addressable store location",
        "command": "pnpm store path 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pnpm"
      }
    ]
  }
}
