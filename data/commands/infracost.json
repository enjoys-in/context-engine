{
  "name": "infracost",
  "description": "Show cloud cost estimates for Terraform changes",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "breakdown",
      "description": "Show a full cost breakdown",
      "options": [
        {
          "name": "--path",
          "description": "Terraform directory or plan file",
          "type": "path",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--format",
          "description": "Output format (table, json, html)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--terraform-var-file",
          "description": "Variable file to use",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--out-file",
          "description": "Write the report here",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "diff",
      "description": "Show the cost difference a change introduces",
      "options": [
        {
          "name": "--path",
          "description": "Terraform directory or plan file",
          "type": "path",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--compare-to",
          "description": "Baseline JSON to compare against",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Output format",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "output",
      "description": "Combine or convert saved reports",
      "options": [
        {
          "name": "--path",
          "description": "Report files to read",
          "type": "path",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--format",
          "description": "Output format",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--show-skipped",
          "description": "Include unsupported resources",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "comment",
      "description": "Post the estimate to a pull request",
      "options": [
        {
          "name": "--repo",
          "description": "Repository to comment on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--pull-request",
          "description": "Pull request number",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--behavior",
          "description": "Comment behaviour (update, new, hide-and-new)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "configure",
      "description": "Set or read configuration values",
      "options": []
    },
    {
      "name": "auth",
      "description": "Log in to Infracost Cloud",
      "options": []
    },
    {
      "name": "generate",
      "description": "Generate an Infracost config file",
      "options": [
        {
          "name": "--repo-path",
          "description": "Repository path to scan",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--template-path",
          "description": "Config template to render",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--out-file",
          "description": "Write the generated config here",
          "type": "file",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log-level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-color",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "infracost breakdown --path .",
      "description": "Estimate the cost of a Terraform directory"
    },
    {
      "command": "infracost diff --path . --compare-to before.json",
      "description": "Show the cost delta"
    },
    {
      "command": "infracost breakdown --path plan.json --format json --out-file out.json",
      "description": "Save a machine-readable report"
    },
    {
      "command": "infracost comment github --repo org/app --pull-request 42 --path out.json",
      "description": "Comment on a pull request"
    }
  ],
  "relatedCommands": [
    "terraform",
    "terragrunt",
    "tflint",
    "checkov",
    "driftctl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Infracost version",
        "command": "infracost --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "infracost"
      },
      {
        "name": "config",
        "description": "Infracost configuration file",
        "command": "cat infracost.yml 2>/dev/null || cat infracost.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "terraform_dirs",
        "description": "Terraform directories Infracost can price",
        "command": "find . -maxdepth 3 -name '*.tf' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
