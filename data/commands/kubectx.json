{
  "name": "kubectx",
  "description": "Switch between Kubernetes contexts quickly",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "(none — use directly)",
      "description": "List or switch contexts",
      "examples": [
        "kubectx",
        "kubectx my-context",
        "kubectx -",
        "kubectx -c",
        "kubectx -d old-context",
        "kubectx new-name=old-name"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Show current context"
    },
    {
      "name": "-d",
      "description": "Delete context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-u",
      "description": "Unset current context"
    }
  ],
  "examples": [
    "kubectx",
    "kubectx my-context",
    "kubectx -",
    "kubectx -c",
    "kubectx -d old-context",
    "kubectx new-name=old-name"
  ],
  "relatedCommands": [
    "kubectl",
    "kubens",
    "k9s"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "kubectx version",
        "command": "kubectx --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "kubectx"
      },
      {
        "name": "current",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "kubectl"
      },
      {
        "name": "contexts",
        "description": "Kubeconfig contexts available",
        "command": "kubectl config get-contexts -o name 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "kubectl"
      }
    ]
  }
}
