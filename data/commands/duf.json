{
  "name": "duf",
  "description": "Disk usage and free space, with a readable table",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--all",
      "description": "Include pseudo, duplicate and inaccessible filesystems",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--only",
      "description": "Only show these device types (local, network, fuse, special)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--hide",
      "description": "Hide these device types",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "description": "Columns to display",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sort",
      "description": "Sort by this column (size, used, avail, usage)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--json",
      "description": "Emit JSON",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--inodes",
      "description": "Report inode usage instead of blocks",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--theme",
      "description": "Colour theme (dark, light, ansi)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--width",
      "description": "Output width in columns",
      "type": "integer",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "duf",
      "description": "Show mounted filesystems"
    },
    {
      "command": "duf --only local",
      "description": "Local filesystems only"
    },
    {
      "command": "duf --sort usage",
      "description": "Fullest filesystems first"
    },
    {
      "command": "duf --json",
      "description": "Emit machine-readable output"
    }
  ],
  "relatedCommands": [
    "df",
    "du",
    "dust",
    "ncdu"
  ]
}
