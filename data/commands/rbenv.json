{
  "name": "rbenv",
  "description": "Simple Ruby version management",
  "category": "version-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a Ruby version",
      "examples": [
        "rbenv install 3.3.0"
      ],
      "options": [
        {
          "name": "--list",
          "description": "List the installable versions",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--force",
          "description": "Reinstall over an existing version",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--skip-existing",
          "description": "Do nothing if already installed",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--verbose",
          "description": "Verbose build output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ],
      "args": [
        {
          "name": "version",
          "description": "Ruby version to install",
          "required": false,
          "type": "version",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "versions",
      "description": "List installed versions",
      "examples": [
        "rbenv versions"
      ],
      "options": [
        {
          "name": "--bare",
          "description": "Print version names only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "global",
      "description": "Set global Ruby version",
      "examples": [
        "rbenv global 3.3.0"
      ],
      "options": [],
      "args": [
        {
          "name": "version",
          "description": "Ruby version to set globally",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "local",
      "description": "Set local Ruby version",
      "examples": [
        "rbenv local 3.2.0"
      ],
      "options": [
        {
          "name": "--unset",
          "description": "Remove the local version file",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "version",
          "description": "Ruby version to set for this directory",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "shell",
      "description": "Set shell-specific version",
      "examples": [
        "rbenv shell 3.3.0"
      ],
      "options": [
        {
          "name": "--unset",
          "description": "Clear the shell version",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "version",
          "description": "Ruby version to set for this shell",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall a version",
      "examples": [
        "rbenv uninstall 3.1.0"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Uninstall without confirming",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "version",
          "description": "Ruby version to uninstall",
          "required": true,
          "type": "version",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "which",
      "description": "Show full path for command",
      "examples": [
        "rbenv which ruby"
      ],
      "options": [],
      "args": [
        {
          "name": "command",
          "description": "Command whose resolved path to print",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "rehash",
      "description": "Rehash shims",
      "examples": [
        "rbenv rehash"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Print debug output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "rbenv install 3.3.0",
    "rbenv global 3.3.0",
    "rbenv versions",
    "rbenv local 3.2.0"
  ],
  "relatedCommands": [
    "ruby",
    "gem",
    "bundle",
    "rvm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "rbenv version",
        "command": "rbenv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "rbenv"
      },
      {
        "name": "current",
        "description": "Ruby version rbenv has active",
        "command": "rbenv version 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "rbenv"
      },
      {
        "name": "installed",
        "description": "Ruby versions rbenv manages",
        "command": "rbenv versions 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "rbenv"
      },
      {
        "name": "version_file",
        "description": "Ruby version pinned for this project",
        "command": "cat .ruby-version 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
