{
  "name": "radare2",
  "aliases": [
    "r2"
  ],
  "description": "Reverse engineering framework and binary analysis toolkit",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-A",
      "description": "Analyse the binary on load",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-w",
      "description": "Open in write mode",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-d",
      "description": "Start a debug session",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-c",
      "description": "Run this r2 command on load",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Run this script file on load",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Quit after running the commands",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-n",
      "description": "Do not analyse or load symbols",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-b",
      "description": "Assume this bit width",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "-a",
      "description": "Assume this architecture",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-B",
      "description": "Load at this base address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "Use this project",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "Set a configuration variable, key=value",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "radare2 ./prog",
      "description": "Open a binary"
    },
    {
      "command": "r2 -A ./prog",
      "description": "Open and analyse"
    },
    {
      "command": "r2 -qc \"afl\" ./prog",
      "description": "List functions and exit"
    },
    {
      "command": "r2 -d ./prog",
      "description": "Start a debug session"
    }
  ],
  "relatedCommands": [
    "objdump",
    "gdb",
    "binwalk",
    "nm",
    "strip"
  ]
}
