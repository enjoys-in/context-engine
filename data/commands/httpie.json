{
  "name": "httpie",
  "description": "User-friendly HTTP client (http/https commands)",
  "category": "http-testing",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--json",
      "short": "-j",
      "description": "JSON request/response",
      "shorthand": "-j"
    },
    {
      "name": "--form",
      "short": "-f",
      "description": "Form encoded data",
      "shorthand": "-f"
    },
    {
      "name": "--headers",
      "short": "-h",
      "description": "Print only headers",
      "shorthand": "-h"
    },
    {
      "name": "--body",
      "short": "-b",
      "description": "Print only body",
      "shorthand": "-b"
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Print full request/response",
      "shorthand": "-v"
    },
    {
      "name": "--auth",
      "short": "-a",
      "description": "Authentication (user:pass)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-a"
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--download",
      "short": "-d",
      "description": "Download mode",
      "shorthand": "-d"
    },
    {
      "name": "--follow",
      "description": "Follow redirects"
    },
    {
      "name": "--verify",
      "description": "SSL verification (yes/no)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--timeout",
      "description": "Timeout in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--session",
      "description": "Named session",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--style",
      "short": "-s",
      "description": "Output color scheme",
      "type": "string",
      "takesValue": true,
      "shorthand": "-s"
    }
  ],
  "examples": [
    "http GET httpbin.org/get",
    "http POST httpbin.org/post name=John",
    "http -v GET api.example.com/users",
    "http -a user:pass GET api.example.com/secret",
    "http PUT api.example.com/user/1 name=Jane",
    "http --download example.com/file.zip",
    "https api.example.com Authorization:Bearer\\ token123"
  ],
  "relatedCommands": [
    "curl",
    "wget",
    "postman",
    "ab"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "HTTPie version",
        "command": "http --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "http"
      },
      {
        "name": "config",
        "description": "HTTPie configuration",
        "command": "cat ~/.config/httpie/config.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300
      },
      {
        "name": "sessions",
        "description": "HTTPie sessions stored locally",
        "command": "ls ~/.config/httpie/sessions 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "proxy",
        "description": "Proxy configuration in effect",
        "command": "echo \"http=${http_proxy:-unset} https=${https_proxy:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
