            {
              "name": "path",
              "description": "Secret path",
              "required": true
            }
          ],
          "options": [
            {
              "name": "-format",
              "description": "Output format",
              "takesValue": true
            },
            {
              "name": "-field",
              "description": "Specific field",
              "takesValue": true
            }
          ]
        },
        {
          "name": "delete",
          "description": "Delete a secret",
          "options": [
            {
              "name": "--mount",
              "description": "Secret mount path",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--versions",
              "description": "Versions to delete",
              "type": "string",
              "takesValue": true
