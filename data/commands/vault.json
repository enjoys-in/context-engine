              "options": [
                {
                  "name": "--mount",
                  "description": "Secret mount path",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--format",
                  "description": "Output format (table, json, yaml)",
                  "type": "string",
                  "takesValue": true
                }
              ]
            },
            {
              "name": "put",
              "description": "Set metadata",
              "options": [
                {
                  "name": "--mount",
                  "description": "Secret mount path",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--max-versions",
                  "description": "Versions to retain",
                  "type": "integer",
                  "takesValue": true
                },
                {
                  "name": "--cas-required",
                  "description": "Require a CAS parameter on writes",
                  "type": "boolean",
                  "takesValue": false
