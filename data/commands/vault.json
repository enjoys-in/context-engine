            {
              "name": "--mount",
              "description": "Secret mount path",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--versions",
              "description": "Versions to destroy permanently",
              "type": "string",
              "takesValue": true
            }
          ]
        }
