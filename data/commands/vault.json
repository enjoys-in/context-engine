        {
          "name": "undelete",
          "description": "Undelete versions",
          "options": [
            {
              "name": "--mount",
              "description": "Secret mount path",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--versions",
              "description": "Versions to restore",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "destroy",
