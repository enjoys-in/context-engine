{
  "name": "youtube-dl",
  "description": "Download video and audio from the web (superseded by yt-dlp)",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--format",
      "description": "Format selector",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--list-formats",
      "description": "List the available formats",
      "type": "boolean",
      "takesValue": false,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--output",
      "description": "Output filename template",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--extract-audio",
      "description": "Keep only the audio track",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--audio-format",
      "description": "Audio format to convert to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--write-sub",
      "description": "Download subtitles",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-playlist",
      "description": "Download only the linked video",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--limit-rate",
      "description": "Maximum download rate",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--cookies",
      "description": "Cookie file to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--simulate",
      "description": "Do not download anything",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    }
  ],
  "examples": [
    {
      "command": "youtube-dl URL",
      "description": "Download at the best quality"
    },
    {
      "command": "youtube-dl -x --audio-format mp3 URL",
      "description": "Extract audio as MP3"
    },
    {
      "command": "youtube-dl -F URL",
      "description": "List the available formats"
    }
  ],
  "relatedCommands": [
    "yt-dlp",
    "ffmpeg",
    "wget"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "youtube-dl version",
        "command": "youtube-dl --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "youtube-dl"
      },
      {
        "name": "config",
        "description": "youtube-dl default options",
        "command": "cat ~/.config/youtube-dl/config 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "ffmpeg",
        "description": "ffmpeg available for post-processing",
        "command": "ffmpeg -version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "successor",
        "description": "yt-dlp available as the maintained fork",
        "command": "yt-dlp --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
