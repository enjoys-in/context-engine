  "globalOptions": [
    {
      "name": "-y",
      "description": "Assume yes"
    },
    {
      "name": "-q",
      "description": "Quiet"
    },
    {
      "name": "-v",
      "description": "Verbose"
    },
    {
      "name": "--enablerepo",
      "description": "Enable repo",
      "takesValue": true
    },
    {
      "name": "--disablerepo",
      "description": "Disable repo",
      "takesValue": true
    },
    {
      "name": "--best",
      "description": "Best available version"
    },
    {
      "name": "--nobest",
      "description": "Allow non-best version"
    },
    {
      "name": "--nogpgcheck",
      "description": "Skip GPG checks"
    },
    {
      "name": "--refresh",
      "description": "Refresh metadata"
    },
    {
      "name": "--downloadonly",
      "description": "Download only"
    },
    {
      "name": "--setopt",
      "description": "Set option",
      "takesValue": true
    },
