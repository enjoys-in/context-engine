{
  "name": "dnf",
  "description": "Next-generation package manager for Fedora/RHEL/CentOS",
  "category": "package-manager",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-y",
          "description": "Assume yes"
        },
        {
          "name": "--allowerasing",
          "description": "Allow erasing to resolve deps"
        },
        {
          "name": "--enablerepo",
          "description": "Enable repo",
          "takesValue": true
        },
        {
          "name": "--disablerepo",
          "description": "Disable repo",
          "takesValue": true
        },
        {
          "name": "--skip-broken",
          "description": "Skip broken packages"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "packages",
          "description": "Package names",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--noautoremove",
          "description": "Keep orphaned dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--assumeno",
          "description": "Answer no to every question",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "update",
