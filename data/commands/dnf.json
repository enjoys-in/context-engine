          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--security",
          "description": "Only security updates",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--bugfix",
          "description": "Only bugfix updates",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--advisory",
          "description": "Only this advisory",
