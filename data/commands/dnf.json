  "examples": [
    {
      "command": "sudo dnf install nginx",
      "description": "Install package"
    },
    {
      "command": "sudo dnf install -y git curl",
      "description": "Install with auto-yes"
    },
    {
      "command": "sudo dnf upgrade",
      "description": "Upgrade all packages"
    },
    {
      "command": "sudo dnf upgrade --security",
      "description": "Security updates only"
    },
    {
      "command": "dnf search redis",
      "description": "Search packages"
    },
    {
      "command": "dnf info nginx",
      "description": "Package info"
    },
    {
      "command": "dnf list --installed",
      "description": "List installed"
    },
    {
      "command": "sudo dnf remove httpd",
      "description": "Remove package"
    },
    {
      "command": "dnf repolist",
      "description": "List repos"
    },
    {
      "command": "sudo dnf module list nodejs",
      "description": "List nodejs modules"
    },
    {
      "command": "sudo dnf history undo last",
      "description": "Undo last transaction"
    }
  ],
  "relatedCommands": [
    "yum",
    "rpm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed",
        "description": "Installed packages",
        "command": "dnf list --installed 2>/dev/null | tail -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "dnf"
      },
      {
        "name": "repos",
        "description": "Configured repositories",
        "command": "dnf repolist 2>/dev/null | tail -10",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "dnf"
      },
      {
        "name": "modules",
        "description": "Available modules",
        "command": "dnf module list 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "dnf"
      },
      {
        "name": "updates",
        "description": "Available updates",
        "command": "dnf check-update 2>/dev/null | tail -15",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "dnf"
      }
    ]
  }
}
