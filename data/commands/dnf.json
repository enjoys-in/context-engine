      "options": [
        {
          "name": "-y",
          "description": "Assume yes"
        },
        {
          "name": "--security",
          "description": "Security updates only"
        },
        {
          "name": "--bugfix",
          "description": "Bugfix updates only"
        }
      ]
    },
    {
      "name": "downgrade",
