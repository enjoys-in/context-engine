{
  "language": "csharp",
  "name": "dotnet",
  "description": "C# command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    },
    {
      "name": "--env",
      "description": "Set environment (development, staging, production)",
      "valueHint": "name"
    },
    {
      "name": "--timeout",
      "description": "Set operation timeout in seconds",
      "valueHint": "seconds"
    },
    {
      "name": "--parallel",
      "description": "Run operations in parallel where possible"
    }
  ],
  "subcommands": [
    {
      "name": "new console",
      "description": "Create console app",
      "args": [],
      "options": [
        {
          "name": "--output",
          "description": "Directory to place the output in",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--name",
          "description": "Name for the new project",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--framework",
          "description": "Target framework",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "build",
      "description": "Build project",
      "args": [],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--no-restore",
          "description": "Skip the implicit restore",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbosity",
          "description": "MSBuild verbosity level",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run project",
      "args": [],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--project",
          "description": "Project file to run",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--no-build",
          "description": "Run without building first",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "args": [],
      "options": [
        {
          "name": "--filter",
          "description": "Only run tests matching this expression",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--logger",
          "description": "Test logger to use",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--no-build",
          "description": "Test without building first",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish project",
      "args": [],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: Debug or Release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--runtime",
          "description": "Target runtime identifier",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--output",
          "description": "Directory to publish into",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--self-contained",
          "description": "Publish the runtime alongside the app",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    {
      "command": "dotnet new console -n MyApp",
      "description": "Create new C# console project"
    },
    {
      "command": "dotnet run",
      "description": "Build and run the project"
    },
    {
      "command": "dotnet test",
      "description": "Run unit tests"
    },
    {
      "command": "dotnet build --configuration Release",
      "description": "Build in release mode"
    },
    {
      "command": "dotnet add package Newtonsoft.Json",
      "description": "Add NuGet package"
    }
  ],
  "relatedCommands": [
    "msbuild",
    "nuget",
    "dotnet",
    "csc"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": ".NET SDK version",
        "command": "dotnet --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "sdks",
        "description": "Installed .NET SDKs",
        "command": "dotnet --list-sdks 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "projects",
        "description": "C# projects and solutions here",
        "command": "find . -maxdepth 3 -name '*.csproj' -o -maxdepth 3 -name '*.sln' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "target_framework",
        "description": "Target frameworks declared",
        "command": "grep -ho '<TargetFramework[s]*>[^<]*<' *.csproj **/*.csproj 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
