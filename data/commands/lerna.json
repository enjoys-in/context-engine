{
  "name": "lerna",
  "description": "Multi-package repository management tool",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a lerna repo",
      "examples": [
        "lerna init"
      ],
      "options": [
        {
          "name": "--independent",
          "description": "Use independent versioning",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--exact",
          "description": "Pin sibling dependencies exactly",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dryRun",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run npm script in each package",
      "examples": [
        "lerna run build",
        "lerna run test --parallel"
      ],
      "options": [
        {
          "name": "--scope",
          "description": "Only run in packages matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--stream",
          "description": "Stream output prefixed by package",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--parallel",
          "description": "Run in every package at once",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-bail",
          "description": "Keep going after a failure",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--concurrency",
          "description": "Number of concurrent tasks",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "script",
          "description": "npm script to run in each package",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute command in each package",
      "examples": [
        "lerna exec -- rm -rf node_modules"
      ],
      "options": [
        {
          "name": "--scope",
          "description": "Only run in packages matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--stream",
          "description": "Stream output prefixed by package",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--parallel",
          "description": "Run in every package at once",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--concurrency",
          "description": "Number of concurrent tasks",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run in each package",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish changed packages",
      "examples": [
        "lerna publish",
        "lerna publish from-package"
      ],
      "options": [
        {
          "name": "--canary",
          "description": "Publish a prerelease from the current commit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dist-tag",
          "description": "npm dist-tag to publish under",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-git-tag-version",
          "description": "Do not create a git tag",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--registry",
          "description": "Registry to publish to",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "version",
      "description": "Bump versions of changed packages",
      "examples": [
        "lerna version patch"
      ],
      "options": [
        {
          "name": "--conventional-commits",
          "description": "Derive the version from conventional commits",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-push",
          "description": "Do not push the version commit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exact",
          "description": "Pin sibling dependencies exactly",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--preid",
          "description": "Prerelease identifier to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "bootstrap",
      "description": "Link local packages and install deps",
      "examples": [
        "lerna bootstrap"
      ],
      "options": [
        {
          "name": "--hoist",
          "description": "Hoist common dependencies to the root",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--scope",
          "description": "Only bootstrap packages matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ci",
          "description": "Use a clean install",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "list",
      "description": "List local packages",
      "examples": [
        "lerna list",
        "lerna list --json"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all",
          "description": "Include private packages",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--long",
          "description": "Include version and location",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--toposort",
          "description": "Sort by dependency order",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "changed",
      "description": "List changed packages since last release",
      "examples": [
        "lerna changed"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all",
          "description": "Include private packages",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--long",
          "description": "Include version and location",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        }
      ]
    },
    {
      "name": "diff",
      "description": "Show diff since last release",
      "examples": [
        "lerna diff"
      ],
      "options": [
        {
          "name": "--ignore-changes",
          "description": "Glob to ignore when diffing",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to diff",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "packages"
          }
        }
      ]
    },
    {
      "name": "add",
      "description": "Add a dependency to packages",
      "examples": [
        "lerna add lodash --scope=my-pkg"
      ],
      "options": [
        {
          "name": "--dev",
          "description": "Add to devDependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-D",
          "shorthand": "-D"
        },
        {
          "name": "--exact",
          "description": "Pin the exact version",
          "type": "boolean",
          "takesValue": false,
          "short": "-E",
          "shorthand": "-E"
        },
        {
          "name": "--scope",
          "description": "Only add to packages matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--peer",
          "description": "Add to peerDependencies",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to add as a dependency",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "packages"
          }
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--scope",
      "description": "Restrict to matching packages",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ignore",
      "description": "Exclude matching packages",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--concurrency",
      "description": "Limit parallel tasks",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--stream",
      "description": "Stream output with prefix"
    }
  ],
  "examples": [
    "lerna run build",
    "lerna publish",
    "lerna run test --parallel",
    "lerna list --json",
    "lerna version patch"
  ],
  "relatedCommands": [
    "nx",
    "turborepo",
    "npm",
    "pnpm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Lerna version",
        "command": "lerna --version 2>/dev/null || npx lerna --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Lerna configuration",
        "command": "cat lerna.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "packages",
        "description": "Packages in this monorepo",
        "command": "lerna list 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "workspaces",
        "description": "Workspace globs declared",
        "command": "grep -A8 '\"workspaces\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
