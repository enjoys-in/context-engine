{
  "name": "strace",
  "description": "Trace system calls and signals",
  "category": "system",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-p",
      "description": "Attach to running process by PID",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "Filter expression (trace=open, network, etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Follow forks (trace child processes)"
    },
    {
      "name": "-o",
      "description": "Write output to file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Count time, calls, and errors per syscall"
    },
    {
      "name": "-t",
      "description": "Prefix each line with time of day"
    },
    {
      "name": "-T",
      "description": "Show time spent in each system call"
    },
    {
      "name": "-s",
      "description": "Maximum string size to print",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-y",
      "description": "Print paths associated with file descriptors"
    },
    {
      "name": "--follow-forks",
      "description": "Trace child processes too",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--attach",
      "description": "Attach to this process id",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--trace",
      "description": "Only these system calls, e.g. openat,read",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--output",
      "description": "Write the trace here",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--summary-only",
      "description": "Print only the call summary",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--summary",
      "description": "Print the summary as well as the trace",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--absolute-timestamps",
      "description": "Print wall-clock timestamps",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--relative-timestamps",
      "description": "Print time between calls",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--syscall-times",
      "description": "Print time spent in each call",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--string-limit",
      "description": "Bytes of strings to print",
      "type": "integer",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--successful-only",
      "description": "Only calls that succeeded",
      "type": "string",
      "takesValue": true,
      "short": "-z",
      "shorthand": "-z"
    },
    {
      "name": "--failed-only",
      "description": "Only calls that failed",
      "type": "string",
      "takesValue": true,
      "short": "-Z",
      "shorthand": "-Z"
    },
    {
      "name": "--stack-traces",
      "description": "Print a stack trace per call",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--user",
      "description": "Run the command as this user",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    }
  ],
  "examples": [
    "strace ls",
    "strace -p 1234",
    "strace -e trace=open,read ls",
    "strace -f -o trace.log ./myapp",
    "strace -c ls",
    "strace -e trace=network curl example.com",
    "strace -T -e trace=file cat /etc/hosts"
  ],
  "relatedCommands": [
    "ltrace",
    "gdb",
    "perf",
    "lsof"
  ]
}
