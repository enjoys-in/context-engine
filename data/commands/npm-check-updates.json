{
  "name": "npm-check-updates",
  "description": "Find and apply newer versions of package.json dependencies",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--upgrade",
      "description": "Write the new versions to package.json",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--interactive",
      "description": "Choose upgrades interactively",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--target",
      "description": "Version target (latest, minor, patch, newest, greatest)",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--filter",
      "description": "Only these packages",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--reject",
      "description": "Exclude these packages",
      "type": "string",
      "takesValue": true,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--dep",
      "description": "Dependency sections to check",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--doctor",
      "description": "Upgrade iteratively and run tests to find breakage",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--packageFile",
      "description": "package.json to read",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--deep",
      "description": "Check every package file in the tree",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--jsonUpgraded",
      "description": "Emit the upgrades as JSON",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--peer",
      "description": "Respect peer dependency ranges",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--format",
      "description": "Extra output detail (group, repo, time)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "ncu",
      "description": "Show which dependencies are outdated"
    },
    {
      "command": "ncu -u",
      "description": "Update package.json to the latest versions"
    },
    {
      "command": "ncu -t minor -u",
      "description": "Only take minor and patch upgrades"
    },
    {
      "command": "ncu -i",
      "description": "Pick upgrades interactively"
    },
    {
      "command": "ncu --doctor -u",
      "description": "Upgrade iteratively, running tests to find breakage"
    }
  ],
  "relatedCommands": [
    "npm",
    "yarn",
    "pnpm",
    "renovate",
    "dependabot"
  ]
}
