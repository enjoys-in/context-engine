{
  "name": "conventional-commits",
  "description": "Conventional Commits CLI for structured commit messages",
  "category": "git",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--type",
      "description": "Commit type (feat, fix, docs, refactor, ...)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--scope",
      "description": "Scope the change applies to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--breaking",
      "description": "Mark the change as breaking (adds !)",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-verify",
      "description": "Skip commit hooks",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dry-run",
      "description": "Print the message without committing",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "npx cz",
    "npx git-cz",
    "npx commitizen init cz-conventional-changelog --save-dev",
    "git cz"
  ],
  "relatedCommands": [
    "commitlint",
    "husky",
    "semantic-release",
    "changeset"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "tooling",
        "description": "Conventional-commit tooling available in this project",
        "command": "grep -oE '\"(commitizen|cz-conventional-changelog|@commitlint/[a-z-]+|standard-version)\": *\"[^\"]*\"' package.json 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Commitizen adapter configured",
        "command": "grep -A8 '\"config\"' package.json 2>/dev/null | head -15 || cat .czrc 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "recent_subjects",
        "description": "Recent commit subjects in this repository",
        "command": "git log --oneline -15 --format='%s' 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "git"
      },
      {
        "name": "types_used",
        "description": "Conventional types already used here",
        "command": "git log --format='%s' -200 2>/dev/null | grep -oE '^[a-z]+(\\([^)]*\\))?!?:' | sort | uniq -c | sort -rn | head -15",
        "parser": "table",
        "cacheFor": 300
      }
    ]
  }
}
