{
  "name": "conventional-commits",
  "description": "Conventional Commits CLI for structured commit messages",
  "category": "git",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--type",
      "description": "Commit type (feat, fix, docs, refactor, ...)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--scope",
      "description": "Scope the change applies to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--breaking",
      "description": "Mark the change as breaking (adds !)",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-verify",
      "description": "Skip commit hooks",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dry-run",
      "description": "Print the message without committing",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "npx cz",
    "npx git-cz",
    "npx commitizen init cz-conventional-changelog --save-dev",
    "git cz"
  ],
  "relatedCommands": [
    "commitlint",
    "husky",
    "semantic-release",
    "changeset"
  ]
}
