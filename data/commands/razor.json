{
  "language": "razor",
  "name": "dotnet",
  "description": "Razor Pages — ASP.NET Core web framework via .NET CLI",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--configuration",
      "description": "Build configuration (Debug, Release)"
    },
    {
      "name": "--output",
      "description": "Output directory"
    },
    {
      "name": "--urls",
      "description": "Set listening URLs"
    },
    {
      "name": "--launch-profile",
      "description": "Launch profile from launchSettings.json"
    },
    {
      "name": "--no-https",
      "description": "Disable HTTPS in project template"
    },
    {
      "name": "--auth",
      "description": "Authentication type (None, Individual, etc.)"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    }
  ],
  "subcommands": [
    {
      "name": "new razor -o project",
      "description": "Create a new Razor Pages project",
      "args": [
        {
          "name": "name",
          "description": "Name for the new Razor project",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--auth",
          "description": "Authentication type for the new project",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-https",
          "description": "Do not configure HTTPS",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run the Razor Pages application",
      "args": [],
      "options": [
        {
          "name": "--urls",
          "description": "URLs the server should listen on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--launch-profile",
          "description": "Launch profile from launchSettings.json",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "watch run",
      "description": "Run with hot reload on file changes",
      "args": [],
      "options": [
        {
          "name": "--project",
          "description": "Project to watch",
          "type": "file",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--no-hot-reload",
          "description": "Disable hot reload",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build the Razor Pages project",
      "args": [],
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration (Debug, Release)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish for deployment",
      "args": [],
      "options": [
        {
          "name": "--output",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--configuration",
          "description": "Build configuration (Debug, Release)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "add package",
      "description": "Add a NuGet package",
      "args": [
        {
          "name": "package",
          "description": "Package to add",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--version",
          "description": "Package version to add",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "dotnet new razor -o MyWebApp",
    "dotnet run --urls 'https://localhost:5001'",
    "dotnet watch run",
    "dotnet publish -c Release -o ./publish",
    "dotnet add package Microsoft.AspNetCore.Identity.UI"
  ],
  "relatedCommands": [
    "dotnet",
    "csharp",
    "html",
    "css"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": ".NET SDK version",
        "command": "dotnet --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dotnet"
      },
      {
        "name": "views",
        "description": "Razor views and components in this project",
        "command": "find . -maxdepth 4 -name '*.cshtml' -o -maxdepth 4 -name '*.razor' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "projects",
        "description": "ASP.NET projects here",
        "command": "find . -maxdepth 3 -name '*.csproj' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
