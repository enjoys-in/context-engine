{
  "name": "yq",
  "description": "Portable command-line YAML processor",
  "category": "Text Processing & Utilities",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "eval",
      "shorthand": "e",
      "description": "Evaluate an expression",
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: yaml, json, props, csv or xml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--inplace",
          "description": "Rewrite the file in place",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--indent",
          "description": "Number of spaces to indent by",
          "type": "integer",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--null-input",
          "description": "Do not read any input",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "examples": [
        "yq eval"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-r",
      "description": "Output raw format"
    },
    {
      "name": "-i",
      "description": "In-place update"
    }
  ],
  "examples": [
    {
      "command": "yq e '.a.b' file.yaml",
      "description": "Read a value"
    },
    {
      "command": "yq e '.a.b = \"new value\"' -i file.yaml",
      "description": "Update a value in place"
    }
  ],
  "relatedCommands": [
    "jq",
    "cat"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "yaml_files",
        "description": "YAML files in current directory",
        "command": "ls *.yaml *.yml 2>/dev/null | head -5",
        "parser": "lines",
        "cacheFor": 30
      }
    ]
  }
}
