{
  "name": "dust",
  "description": "More intuitive du — disk usage as a sorted tree",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--depth",
      "description": "Maximum directory depth to display",
      "type": "integer",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--number-of-lines",
      "description": "Rows to print",
      "type": "integer",
      "takesValue": true,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--reverse",
      "description": "Print the largest last",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--apparent-size",
      "description": "Report apparent size instead of disk usage",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--files-only",
      "description": "Show files rather than directories",
      "type": "boolean",
      "takesValue": false,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--ignore-directory",
      "description": "Skip this directory",
      "type": "path",
      "takesValue": true,
      "short": "-X",
      "shorthand": "-X"
    },
    {
      "name": "--filter",
      "description": "Only include paths matching this regex",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--full-paths",
      "description": "Print full paths rather than a tree",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--only-dir",
      "description": "Show directories only",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    }
  ],
  "examples": [
    {
      "command": "dust",
      "description": "Show usage for the current directory"
    },
    {
      "command": "dust -d 2 /var",
      "description": "Limit the tree to two levels"
    },
    {
      "command": "dust -n 30 -r",
      "description": "Show 30 rows, largest last"
    },
    {
      "command": "dust -X node_modules .",
      "description": "Ignore a directory"
    }
  ],
  "relatedCommands": [
    "du",
    "ncdu",
    "duf",
    "df"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "dust version",
        "command": "dust --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dust"
      },
      {
        "name": "cwd_size",
        "description": "Total size of the current directory",
        "command": "du -sh . 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "largest_dirs",
        "description": "Largest immediate subdirectories",
        "command": "du -sh */ 2>/dev/null | sort -rh | head -12",
        "parser": "table",
        "cacheFor": 120
      }
    ]
  }
}
