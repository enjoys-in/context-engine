{
  "name": "mix",
  "description": "Elixir build tool and task runner",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create new project",
      "examples": [
        "mix new myapp",
        "mix new myapp --sup"
      ],
      "options": [
        {
          "name": "--app",
          "description": "OTP application name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--module",
          "description": "Root module name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--sup",
          "description": "Generate an OTP application with a supervision tree",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--umbrella",
          "description": "Generate an umbrella project",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "compile",
      "description": "Compile project",
      "examples": [
        "mix compile"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Recompile everything",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--warnings-as-errors",
          "description": "Treat warnings as errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-deps-check",
          "description": "Skip the dependency check",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all-warnings",
          "description": "Print warnings from every file",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "mix test",
        "mix test --cover"
      ],
      "options": [
        {
          "name": "--cover",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--trace",
          "description": "Run synchronously and print each test",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--only",
          "description": "Only run tests with this tag",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--failed",
          "description": "Only re-run previously failed tests",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--max-failures",
          "description": "Stop after this many failures",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--seed",
          "description": "Seed for test ordering",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deps.get",
      "description": "Fetch dependencies",
      "examples": [
        "mix deps.get"
      ],
      "options": [
        {
          "name": "--only",
          "description": "Only fetch dependencies for this environment",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--check-locked",
          "description": "Fail if the lockfile would change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "deps.update",
      "description": "Update dependencies",
      "examples": [
        "mix deps.update --all"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Update every dependency",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--only",
          "description": "Restrict to this environment",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "format",
      "description": "Format code",
      "examples": [
        "mix format"
      ],
      "options": [
        {
          "name": "--check-formatted",
          "description": "Fail rather than rewriting files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dot-formatter",
          "description": "Formatter config file to use",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files to format",
          "required": false,
          "type": "path"
        }
      ]
    },
    {
      "name": "ecto.create",
      "description": "Create database",
      "examples": [
        "mix ecto.create"
      ],
      "options": [
        {
          "name": "--repo",
          "description": "Repository to act on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-compile",
          "description": "Skip compilation first",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ecto.migrate",
      "description": "Run migrations",
      "examples": [
        "mix ecto.migrate"
      ],
      "options": [
        {
          "name": "--repo",
          "description": "Repository to act on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--all",
          "description": "Run every pending migration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--step",
          "description": "Run this many migrations",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--to",
          "description": "Migrate up to this version",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--log-sql",
          "description": "Log the SQL that is executed",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "phx.new",
      "description": "Create Phoenix project",
      "examples": [
        "mix phx.new myapp"
      ],
      "options": [
        {
          "name": "--database",
          "description": "Database adapter to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-html",
          "description": "Skip the HTML layer",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-ecto",
          "description": "Skip Ecto and the database layer",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--live",
          "description": "Include Phoenix LiveView",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--umbrella",
          "description": "Generate an umbrella project",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--binary-id",
          "description": "Use binary ids for schemas",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "phx.server",
      "description": "Start Phoenix server",
      "examples": [
        "mix phx.server"
      ],
      "options": [
        {
          "name": "--open",
          "description": "Open a browser once the server starts",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "release",
      "description": "Build release",
      "examples": [
        "mix release"
      ],
      "options": [
        {
          "name": "--overwrite",
          "description": "Overwrite an existing release",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--path",
          "description": "Directory to assemble the release into",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Version to assign the release",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "hex.publish",
      "description": "Publish to Hex.pm",
      "examples": [
        "mix hex.publish"
      ],
      "options": [
        {
          "name": "--dry-run",
          "description": "Build the package without publishing it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--replace",
          "description": "Replace an already-published version",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--organization",
          "description": "Organization to publish under",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--no-deps-check",
      "description": "Skip dependency check"
    },
    {
      "name": "--force",
      "description": "Force operation"
    }
  ],
  "examples": [
    "mix new myapp",
    "mix deps.get",
    "mix compile",
    "mix test",
    "mix phx.server",
    "iex -S mix"
  ],
  "relatedCommands": [
    "elixir",
    "iex",
    "rebar3",
    "hex"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Elixir and Mix versions",
        "command": "mix --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mix"
      },
      {
        "name": "project",
        "description": "Mix project definition",
        "command": "cat mix.exs 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "deps",
        "description": "Dependencies declared in mix.lock",
        "command": "grep -o '\"[a-z_]*\":' mix.lock 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "env",
        "description": "Mix environment in effect",
        "command": "echo \"${MIX_ENV:-dev}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
