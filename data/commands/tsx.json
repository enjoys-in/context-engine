{
  "name": "tsx",
  "description": "Run TypeScript and ESM directly in Node without a build step",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--watch",
      "description": "Restart when files change",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--tsconfig",
      "description": "tsconfig file to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--no-cache",
      "description": "Disable the transform cache",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--conditions",
      "description": "Resolution conditions to apply",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--env-file",
      "description": "Load environment variables from this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--inspect",
      "description": "Enable the Node inspector",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--clear-screen",
      "description": "Clear the screen on each watch restart",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "tsx script.ts",
      "description": "Run a TypeScript file"
    },
    {
      "command": "tsx watch server.ts",
      "description": "Restart on change"
    },
    {
      "command": "tsx --env-file .env script.ts",
      "description": "Run with environment variables loaded"
    },
    {
      "command": "tsx --tsconfig tsconfig.build.json src/index.ts",
      "description": "Use a specific tsconfig"
    }
  ],
  "relatedCommands": [
    "ts-node",
    "node",
    "typescript",
    "tsc",
    "esbuild"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tsx version",
        "command": "tsx --version 2>/dev/null || npx tsx --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "tsconfig",
        "description": "TypeScript configuration tsx will read",
        "command": "cat tsconfig.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "entry_points",
        "description": "TypeScript entry points in this project",
        "command": "find . -maxdepth 2 -name 'index.ts' -o -maxdepth 2 -name 'main.ts' -not -path './node_modules/*' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
