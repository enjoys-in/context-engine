{
  "name": "isort",
  "description": "Sort and group Python imports",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--check-only",
      "description": "Report which files would change and exit non-zero",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--diff",
      "description": "Print the diff instead of writing",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--profile",
      "description": "Preset compatibility profile, e.g. black",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--line-length",
      "description": "Maximum line length",
      "type": "integer",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--multi-line",
      "description": "Multi-line output mode",
      "type": "integer",
      "takesValue": true,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--force-single-line",
      "description": "One import per line",
      "type": "boolean",
      "takesValue": false,
      "short": "-sl",
      "shorthand": "-sl"
    },
    {
      "name": "--skip",
      "description": "Files or directories to skip",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--settings-path",
      "description": "Directory holding the configuration",
      "type": "path",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "isort .",
      "description": "Sort imports across the tree"
    },
    {
      "command": "isort --profile black .",
      "description": "Sort in a black-compatible style"
    },
    {
      "command": "isort --check-only --diff .",
      "description": "Show what would change without writing"
    }
  ],
  "relatedCommands": [
    "ruff",
    "black",
    "flake8"
  ]
}
