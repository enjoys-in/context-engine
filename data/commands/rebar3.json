{
  "name": "rebar3",
  "description": "Erlang build tool",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create new project",
      "examples": [
        "rebar3 new app myapp",
        "rebar3 new lib mylib"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Overwrite existing files",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "compile",
      "description": "Compile project",
      "examples": [
        "rebar3 compile"
      ],
      "options": [
        {
          "name": "--deps_only",
          "description": "Only compile dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "eunit",
      "description": "Run EUnit tests",
      "examples": [
        "rebar3 eunit"
      ],
      "options": [
        {
          "name": "--module",
          "description": "Only run tests in these modules",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--suite",
          "description": "Only run these test suites",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--cover",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "ct",
      "description": "Run Common Test suites",
      "examples": [
        "rebar3 ct"
      ],
      "options": [
        {
          "name": "--suite",
          "description": "Test suites to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--group",
          "description": "Test groups to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--case",
          "description": "Test cases to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cover",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "release",
      "description": "Build release",
      "examples": [
        "rebar3 release"
      ],
      "options": [
        {
          "name": "--relname",
          "description": "Release name to build",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--relvsn",
          "description": "Release version to build",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--dev-mode",
          "description": "Symlink rather than copy the release",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--include-erts",
          "description": "Bundle the Erlang runtime",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "shell",
      "description": "Start Erlang shell with project",
      "examples": [
        "rebar3 shell"
      ],
      "options": [
        {
          "name": "--apps",
          "description": "Applications to start in the shell",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Long node name for the shell",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--sname",
          "description": "Short node name for the shell",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--setcookie",
          "description": "Distribution cookie to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "dialyzer",
      "description": "Run Dialyzer",
      "examples": [
        "rebar3 dialyzer"
      ],
      "options": [
        {
          "name": "--update-plt",
          "description": "Rebuild the persistent lookup table",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--succ-typings",
          "description": "Run success typing analysis",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--base-plt-location",
          "description": "Where to store the base PLT",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean build",
      "examples": [
        "rebar3 clean"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Clean dependencies too",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--apps",
          "description": "Only clean these applications",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deps",
      "description": "List dependencies",
      "examples": [
        "rebar3 deps"
      ],
      "options": []
    },
    {
      "name": "upgrade",
      "description": "Upgrade dependencies",
      "examples": [
        "rebar3 upgrade"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Upgrade every dependency",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "hex publish",
      "description": "Publish to Hex.pm",
      "examples": [
        "rebar3 hex publish"
      ],
      "options": [
        {
          "name": "--repo",
          "description": "Repository to publish to",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Build the package without publishing it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--replace",
          "description": "Replace an already-published version",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the rebar3 version",
      "type": "boolean",
      "takesValue": false,
      "short": "-V",
      "shorthand": "-V"
    },
    {
      "name": "--verbose",
      "description": "Print detailed output",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    "rebar3 new app myapp",
    "rebar3 compile",
    "rebar3 eunit",
    "rebar3 release",
    "rebar3 shell"
  ],
  "relatedCommands": [
    "erlang",
    "mix",
    "erl",
    "erlc"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "rebar3 version",
        "command": "rebar3 --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "rebar3"
      },
      {
        "name": "config",
        "description": "rebar3 project configuration",
        "command": "cat rebar.config 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "profiles",
        "description": "Build profiles declared",
        "command": "grep -A10 '{profiles' rebar.config 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "build_dir",
        "description": "rebar3 build output",
        "command": "ls _build 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
