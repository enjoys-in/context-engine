{
  "language": "protobuf",
  "name": "protoc",
  "description": "Protocol Buffers — protoc compiler for generating language bindings",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--proto_path / -I",
      "description": "Specify import search path for proto files"
    },
    {
      "name": "--encode",
      "description": "Encode text-format message from stdin to binary"
    },
    {
      "name": "--decode",
      "description": "Decode binary message from stdin to text-format"
    },
    {
      "name": "--descriptor_set_in",
      "description": "Read descriptor set from file instead of proto"
    },
    {
      "name": "--plugin",
      "description": "Specify a plugin executable for code generation"
    },
    {
      "name": "--error_format",
      "description": "Error output format (gcc, msvs)"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    }
  ],
  "subcommands": [
    {
      "name": "--go_out=. file.proto",
      "description": "Generate Go code from proto definitions",
      "args": [
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--python_out=. file.proto",
      "description": "Generate Python code from proto definitions",
      "args": [
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--js_out=. file.proto",
      "description": "Generate JavaScript code from proto definitions",
      "args": [
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--java_out=. file.proto",
      "description": "Generate Java code from proto definitions",
      "args": [
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--cpp_out=. file.proto",
      "description": "Generate C++ code from proto definitions",
      "args": [
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--grpc-web_out=. file.proto",
      "description": "Generate gRPC-Web client stubs",
      "args": [
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--descriptor_set_out=desc.pb file.proto",
      "description": "Output a serialized descriptor set",
      "args": [
        {
          "name": "output",
          "description": "Path for the descriptor set",
          "type": "file",
          "required": true
        },
        {
          "name": "file",
          "description": "Protocol buffer definition to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--proto_path",
          "description": "Directory to resolve imports from",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--descriptor_set_in",
          "description": "Read descriptors from these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--error_format",
          "description": "Diagnostic format: gcc or msvs",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "protoc --go_out=. --go-grpc_out=. -I proto/ service.proto",
    "protoc --python_out=. -I proto/ message.proto",
    "protoc --java_out=src/main/java -I proto/ *.proto",
    "protoc --decode=MyMessage message.proto < data.bin",
    "buf generate"
  ],
  "relatedCommands": [
    "grpcurl",
    "buf",
    "go",
    "python"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "protoc version",
        "command": "protoc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "protoc"
      },
      {
        "name": "definitions",
        "description": "Protocol buffer definitions in this project",
        "command": "find . -maxdepth 4 -name '*.proto' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "plugins",
        "description": "protoc code-generator plugins available",
        "command": "which protoc-gen-go protoc-gen-grpc-java protoc-gen-ts 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "buf_config",
        "description": "buf configuration if this project uses it",
        "command": "cat buf.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
