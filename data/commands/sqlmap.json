{
  "name": "sqlmap",
  "description": "Automated SQL injection detection and exploitation for authorised testing",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--url",
      "description": "Target URL to test",
      "type": "url",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--data",
      "description": "POST body to test",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--cookie",
      "description": "Cookie header to send",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--headers",
      "description": "Extra headers to send",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--request",
      "description": "Load the request from this file",
      "type": "file",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--level",
      "description": "Test thoroughness, 1-5",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--risk",
      "description": "Risk of the payloads used, 1-3",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--technique",
      "description": "Injection techniques to try (BEUSTQ)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--dbs",
      "description": "Enumerate the databases",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--tables",
      "description": "Enumerate the tables",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--columns",
      "description": "Enumerate the columns",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dump",
      "description": "Dump the table contents",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--batch",
      "description": "Never prompt, take the defaults",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--threads",
      "description": "Concurrent requests",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--proxy",
      "description": "Proxy to route requests through",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tamper",
      "description": "Tamper scripts to apply",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--random-agent",
      "description": "Use a random User-Agent",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--output-dir",
      "description": "Directory for session and results",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--flush-session",
      "description": "Discard the cached session",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "sqlmap -u \"https://example.com/item?id=1\" --batch",
      "description": "Test a parameter non-interactively"
    },
    {
      "command": "sqlmap -r request.txt --level 3 --dbs",
      "description": "Test a saved request and list databases"
    },
    {
      "command": "sqlmap -u URL -D app -T users --columns",
      "description": "Enumerate a table’s columns"
    },
    {
      "command": "sqlmap -u URL --batch --technique=B",
      "description": "Restrict to boolean-based injection"
    }
  ],
  "relatedCommands": [
    "nuclei",
    "nmap",
    "burpsuite",
    "semgrep"
  ]
}
