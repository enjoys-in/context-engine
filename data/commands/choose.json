{
  "name": "choose",
  "description": "Human-friendly alternative to cut and awk for field selection",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--field-separator",
      "description": "Regex separating input fields",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--output-field-separator",
      "description": "String to join output fields with",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--character-wise",
      "description": "Select characters rather than fields",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--exclusive",
      "description": "Treat ranges as exclusive of the end",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--non-greedy",
      "description": "Use non-greedy field matching",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--input",
      "description": "Read from this file rather than stdin",
      "type": "file",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    }
  ],
  "examples": [
    {
      "command": "choose 0 2 < data.tsv",
      "description": "Print the first and third fields"
    },
    {
      "command": "choose -f \":\" 0 < /etc/passwd",
      "description": "Split on colons"
    },
    {
      "command": "choose 1:3 < data.txt",
      "description": "Print a range of fields"
    },
    {
      "command": "ps aux | choose 1 10:",
      "description": "Print the pid and the whole command"
    }
  ],
  "relatedCommands": [
    "cut",
    "awk",
    "sd",
    "rg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "choose version",
        "command": "choose --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "choose"
      },
      {
        "name": "delimited_files",
        "description": "Delimited files choose can slice",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.tsv' -o -name '*.txt' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
