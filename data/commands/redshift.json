  ],
  "examples": [
    "psql -h mycluster.abc123.us-east-1.redshift.amazonaws.com -U admin -d mydb -p 5439",
    "psql -h cluster.redshift.amazonaws.com -U user -d db -c 'SELECT * FROM sales LIMIT 10;'",
    "COPY sales FROM 's3://mybucket/data/' IAM_ROLE 'arn:aws:iam::role/RedshiftRole' CSV;",
    "UNLOAD ('SELECT * FROM sales') TO 's3://mybucket/export/' IAM_ROLE 'arn:aws:iam::role/RedshiftRole';",
    "aws redshift describe-clusters --query 'Clusters[*].Endpoint'"
  ],
  "relatedCommands": [
    "psql",
    "aws",
    "sql",
    "pgsql"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "psql client version used for Redshift",
        "command": "psql --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "psql"
      },
      {
        "name": "connection",
        "description": "Redshift connection settings in effect",
        "command": "echo \"host=${PGHOST:-unset} port=${PGPORT:-5439} db=${PGDATABASE:-unset} user=${PGUSER:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "service_file",
        "description": "Connection profiles defined locally",
        "command": "grep -o '^\\[.*\\]' ~/.pg_service.conf 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "sql_scripts",
        "description": "SQL scripts in this project",
        "command": "find . -maxdepth 2 -name '*.sql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
