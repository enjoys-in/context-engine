{
  "language": "redshift",
  "name": "psql",
  "description": "Amazon Redshift — cloud data warehouse accessed via psql client",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-h / --host",
      "description": "Redshift cluster endpoint hostname"
    },
    {
      "name": "-p / --port",
      "description": "Port number (default: 5439)"
    },
    {
      "name": "-U / --username",
      "description": "Database username"
    },
    {
      "name": "-d / --dbname",
      "description": "Target database name"
    },
    {
      "name": "-c / --command",
      "description": "Execute a single SQL command"
    },
    {
      "name": "-f / --file",
      "description": "Execute SQL from file"
    },
    {
      "name": "--csv",
      "description": "Output in CSV format"
    },
    {
      "name": "-o / --output",
      "description": "Write output to file"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    }
  ],
  "subcommands": [
    {
      "name": "-h cluster.redshift.amazonaws.com -U user -d db -p 5439",
      "description": "Connect to Redshift cluster",
      "args": [
        {
          "name": "host",
          "description": "Host to connect to",
          "type": "string",
          "required": true
        },
        {
          "name": "user",
          "description": "User to act as",
          "type": "string",
          "required": true
        },
        {
          "name": "db",
          "description": "Database to connect to",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--host",
          "description": "Cluster endpoint to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Port to connect on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "-c \"SELECT ...\" -h host -U user -d db",
      "description": "Execute a single SQL query",
      "args": [
        {
          "name": "query",
          "description": "Query to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--host",
          "description": "Cluster endpoint to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Port to connect on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "-f script.sql -h host -U user -d db",
      "description": "Execute SQL script file",
      "args": [
        {
          "name": "file",
          "description": "File to operate on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--host",
          "description": "Cluster endpoint to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Port to connect on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "--csv -c \"SELECT ...\" -h host",
      "description": "Output results in CSV format",
      "args": [
        {
          "name": "query",
          "description": "Query to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--host",
          "description": "Cluster endpoint to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Port to connect on",
          "type": "integer",
