          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "-l -h host -U user",
      "description": "List available databases",
      "args": [],
      "options": [
        {
          "name": "--host",
          "description": "Cluster endpoint to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Port to connect on",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--username",
          "description": "User to connect as",
          "type": "string",
          "takesValue": true,
          "short": "-U",
          "shorthand": "-U"
        },
        {
          "name": "--dbname",
          "description": "Database to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-password",
          "description": "Never prompt for a password",
          "type": "boolean",
          "takesValue": false,
