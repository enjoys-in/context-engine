{
  "name": "helix",
  "aliases": [
    "hx"
  ],
  "description": "Post-modern modal text editor",
  "category": "editor",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--health",
      "description": "Report language and tool availability",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tutor",
      "description": "Open the interactive tutorial",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Path to the configuration file",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--log",
      "description": "Write a log to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--vsplit",
      "description": "Open the given files in vertical splits",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--hsplit",
      "description": "Open the given files in horizontal splits",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--working-dir",
      "description": "Directory to treat as the workspace",
      "type": "directory",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--grammar",
      "description": "Fetch or build tree-sitter grammars",
      "type": "string",
      "takesValue": true,
      "short": "-g",
      "shorthand": "-g"
    }
  ],
  "examples": [
    {
      "command": "hx .",
      "description": "Open the file picker in the current directory"
    },
    {
      "command": "hx src/main.rs",
      "description": "Open a file"
    },
    {
      "command": "hx --health rust",
      "description": "Check the Rust language support"
    },
    {
      "command": "hx --tutor",
      "description": "Work through the tutorial"
    }
  ],
  "relatedCommands": [
    "vim",
    "nvim",
    "kakoune",
    "micro"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Helix version",
        "command": "hx --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hx"
      },
      {
        "name": "config",
        "description": "Helix configuration",
        "command": "cat ~/.config/helix/config.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "languages",
        "description": "Language servers Helix has configured",
        "command": "hx --health 2>/dev/null | head -30",
        "parser": "table",
        "cacheFor": 3600,
        "requiresCmd": "hx"
      },
      {
        "name": "runtime",
        "description": "Helix runtime directory",
        "command": "echo \"${HELIX_RUNTIME:-default}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
