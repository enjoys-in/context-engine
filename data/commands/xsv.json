{
  "name": "xsv",
  "description": "Fast CSV command-line toolkit written in Rust",
  "category": "data",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "headers",
      "description": "Show column headers",
      "examples": [
        "xsv headers data.csv"
      ],
      "options": [
        {
          "name": "--just-names",
          "description": "Print the header names only",
          "type": "boolean",
          "takesValue": false,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--intersect",
          "description": "Show only headers common to every file",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "CSV file whose headers to print",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "stats",
      "description": "Show column statistics",
      "examples": [
        "xsv stats data.csv | xsv table"
      ],
      "options": [
        {
          "name": "--select",
          "description": "Columns to compute statistics for",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--everything",
          "description": "Compute every available statistic",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--median",
          "description": "Include the median",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cardinality",
          "description": "Include the distinct value count",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "CSV file to summarise",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "select",
      "description": "Select columns",
      "examples": [
        "xsv select name,age data.csv"
      ],
      "options": [
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--delimiter",
          "description": "Field delimiter to use",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--output",
          "description": "Write output to this file",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "selection",
          "description": "Columns to select",
          "required": true,
          "type": "string"
        },
        {
          "name": "file",
          "description": "CSV file to read",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "search",
      "description": "Search for regex patterns",
      "examples": [
        "xsv search 'Alice' data.csv"
      ],
      "options": [
        {
          "name": "--select",
          "description": "Columns to search",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--invert-match",
          "description": "Print rows that do not match",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--ignore-case",
          "description": "Case-insensitive matching",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "pattern",
          "description": "Regular expression to search for",
          "required": true,
          "type": "string"
        },
        {
          "name": "file",
          "description": "CSV file to read",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "sort",
      "description": "Sort rows",
      "examples": [
        "xsv sort -s age data.csv"
      ],
      "options": [
        {
          "name": "--select",
          "description": "Columns to sort by",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--numeric",
          "description": "Sort numerically",
          "type": "boolean",
          "takesValue": false,
          "short": "-N",
          "shorthand": "-N"
        },
        {
          "name": "--reverse",
          "description": "Sort in descending order",
          "type": "boolean",
          "takesValue": false,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "count",
      "description": "Count rows",
      "examples": [
        "xsv count data.csv"
      ],
      "options": [
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--delimiter",
          "description": "Field delimiter to use",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "CSV file whose rows to count",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "table",
      "description": "Pretty-print as table",
      "examples": [
        "xsv table data.csv"
      ],
      "options": [
        {
          "name": "--width",
          "description": "Minimum column width",
          "type": "integer",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--pad",
          "description": "Padding between columns",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--align",
          "description": "Column alignment: left, right or center",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "CSV file to align",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "slice",
      "description": "Slice rows by index",
      "examples": [
        "xsv slice -i 0 -l 10 data.csv"
      ],
      "options": [
        {
          "name": "--start",
          "description": "First record to include",
          "type": "integer",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--end",
          "description": "Record to stop before",
          "type": "integer",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--len",
          "description": "Number of records to include",
          "type": "integer",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--index",
          "description": "Single record to select",
          "type": "integer",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "join",
      "description": "Join two CSVs",
      "examples": [
        "xsv join id a.csv id b.csv"
      ],
      "options": [
        {
          "name": "--left",
          "description": "Perform a left outer join",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--right",
          "description": "Perform a right outer join",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--full",
          "description": "Perform a full outer join",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ignore-case",
          "description": "Case-insensitive key matching",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "columns1",
          "description": "Join columns in the first file",
          "required": true,
          "type": "string"
        },
        {
          "name": "file1",
          "description": "First CSV file",
          "required": true,
          "type": "file"
        },
        {
          "name": "columns2",
          "description": "Join columns in the second file",
          "required": true,
          "type": "string"
        },
        {
          "name": "file2",
          "description": "Second CSV file",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "frequency",
      "description": "Show value frequencies",
      "examples": [
        "xsv frequency -s city data.csv"
      ],
      "options": [
        {
          "name": "--select",
          "description": "Columns to count values for",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--limit",
          "description": "Number of values to report per column",
          "type": "integer",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--asc",
          "description": "Sort ascending by count",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "flatten",
      "description": "Show records one field per line",
      "examples": [
        "xsv flatten data.csv"
      ],
      "options": [
        {
          "name": "--condense",
          "description": "Truncate values to this width",
          "type": "integer",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--separator",
          "description": "Separator between records",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-headers",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "CSV file to flatten",
          "required": false,
          "type": "file"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Delimiter",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-headers",
      "description": "No header row"
    }
  ],
  "examples": [
    "xsv headers data.csv",
    "xsv stats data.csv | xsv table",
    "xsv select name,age data.csv",
    "xsv search 'pattern' data.csv",
    "xsv count data.csv"
  ],
  "relatedCommands": [
    "csvkit",
    "miller",
    "awk",
    "jq"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "xsv version",
        "command": "xsv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "xsv"
      },
      {
        "name": "csv_files",
        "description": "CSV files in this directory",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.tsv' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "successor",
        "description": "qsv available as the maintained fork",
        "command": "qsv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
