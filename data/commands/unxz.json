{
  "name": "unxz",
  "description": "Expand files compressed with xz",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--verbose",
      "description": "Report progress",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "unxz image.iso.xz",
      "description": "Expand in place"
    },
    {
      "command": "unxz -c backup.tar.xz | tar x",
      "description": "Stream into tar"
    }
  ],
  "relatedCommands": [
    "xz",
    "gunzip",
    "tar"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "XZ Utils version",
        "command": "unxz --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "unxz"
      },
      {
        "name": "archives",
        "description": "XZ archives in this directory",
        "command": "find . -maxdepth 2 -name '*.xz' -o -name '*.txz' -o -name '*.lzma' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
