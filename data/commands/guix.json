{
  "name": "guix",
  "description": "Functional package manager and system distribution",
  "category": "package-manager",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages into a profile",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to modify",
          "type": "path",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--dry-run",
          "description": "Report what would happen",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "type": "package",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages from a profile",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to modify",
          "type": "path",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to remove",
          "type": "package",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade the installed packages",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to modify",
          "type": "path",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "pattern",
          "description": "Only packages matching this regex",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "search",
      "description": "Search for packages",
      "args": [
        {
          "name": "query",
          "description": "Search terms",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "show",
      "description": "Show details about a package",
      "args": [
        {
          "name": "package",
          "description": "Package name",
          "type": "package",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": []
    },
    {
      "name": "pull",
      "description": "Update the Guix package definitions",
      "options": [
        {
          "name": "--commit",
          "description": "Pull this commit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--branch",
          "description": "Pull this branch",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "build",
      "description": "Build a package without installing it",
      "options": [
        {
          "name": "--keep-going",
          "description": "Keep building after failures",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--check",
          "description": "Rebuild to verify reproducibility",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to build",
          "type": "package",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "shell",
      "description": "Enter an environment with packages available",
      "options": [
        {
          "name": "--pure",
          "description": "Clear the inherited environment",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--development",
          "description": "Include a package’s build inputs",
          "type": "boolean",
          "takesValue": false,
          "short": "-D",
          "shorthand": "-D"
        }
      ]
    },
    {
      "name": "package",
      "description": "Manage profiles the classic way",
      "options": [
        {
          "name": "--install",
          "description": "Install these packages",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--remove",
          "description": "Remove these packages",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--list-installed",
          "description": "List the installed packages",
          "type": "string",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "system",
      "description": "Build and deploy whole system configurations",
      "options": [
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--no-grub",
          "description": "Do not install the bootloader",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "gc",
      "description": "Reclaim disk space",
      "options": [
        {
          "name": "--delete",
          "description": "Delete these store items",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--free-space",
          "description": "Free up to this much space",
          "type": "string",
          "takesValue": true,
          "short": "-F",
          "shorthand": "-F"
        }
      ]
    },
    {
      "name": "describe",
      "description": "Show which Guix revision is in use",
      "options": [
        {
          "name": "--format",
          "description": "Output format: human, channels or json",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "guix install ripgrep",
      "description": "Install a package"
    },
    {
      "command": "guix pull",
      "description": "Update the package definitions"
    },
    {
      "command": "guix shell -D guile -- bash",
      "description": "Enter a development environment"
    },
    {
      "command": "guix gc -F 10G",
      "description": "Reclaim disk space"
    }
  ],
  "relatedCommands": [
    "nix",
    "nix-env",
    "apt",
    "port"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Guix version",
        "command": "guix --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "guix"
      },
      {
        "name": "generations",
        "description": "Guix profile generations",
        "command": "guix package --list-generations 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "guix"
      },
      {
        "name": "installed",
        "description": "Packages in the current Guix profile",
        "command": "guix package --list-installed 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "guix"
      },
      {
        "name": "manifest",
        "description": "Guix manifest in this project",
        "command": "cat manifest.scm 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
