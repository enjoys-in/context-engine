{
  "name": "binwalk",
  "description": "Analyse and extract firmware images and embedded files",
  "category": "security",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--signature",
      "description": "Scan for file signatures",
      "type": "boolean",
      "takesValue": false,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--extract",
      "description": "Extract the files found",
      "type": "boolean",
      "takesValue": false,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--dd",
      "description": "Extract signatures matching this type",
      "type": "string",
      "takesValue": true,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--matryoshka",
      "description": "Recursively scan extracted files",
      "type": "boolean",
      "takesValue": false,
      "short": "-M",
      "shorthand": "-M"
    },
    {
      "name": "--depth",
      "description": "Recursion depth limit",
      "type": "integer",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--entropy",
      "description": "Plot the file entropy",
      "type": "boolean",
      "takesValue": false,
      "short": "-E",
      "shorthand": "-E"
    },
    {
      "name": "--raw",
      "description": "Search for this raw byte sequence",
      "type": "string",
      "takesValue": true,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--directory",
      "description": "Directory to extract into",
      "type": "directory",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--include",
      "description": "Only report signatures matching this",
      "type": "string",
      "takesValue": true,
      "short": "-y",
      "shorthand": "-y"
    },
    {
      "name": "--exclude",
      "description": "Skip signatures matching this",
      "type": "string",
      "takesValue": true,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--length",
      "description": "Bytes to scan",
      "type": "integer",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--offset",
      "description": "Byte offset to start at",
      "type": "integer",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--quiet",
      "description": "Suppress the header",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "binwalk firmware.bin",
      "description": "Scan for embedded file signatures"
    },
    {
      "command": "binwalk -e firmware.bin",
      "description": "Extract what it finds"
    },
    {
      "command": "binwalk -Me firmware.bin",
      "description": "Extract recursively"
    },
    {
      "command": "binwalk -E firmware.bin",
      "description": "Plot the entropy to spot compression"
    }
  ],
  "relatedCommands": [
    "radare2",
    "strings",
    "file",
    "exiftool",
    "objdump"
  ]
}
