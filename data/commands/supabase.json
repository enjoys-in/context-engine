{
  "name": "supabase",
  "description": "Supabase CLI for managing Supabase projects locally and in the cloud",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a Supabase project",
      "options": [
        {
          "name": "--with-vscode-settings",
          "description": "Generate VS Code settings",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Overwrite an existing project",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "supabase init"
      ]
    },
    {
      "name": "start",
      "description": "Start local Supabase stack",
      "options": [
        {
          "name": "--ignore-health-check",
          "description": "Skip health check"
        }
      ],
      "examples": [
        "supabase start"
      ]
    },
    {
      "name": "stop",
      "description": "Stop local Supabase stack",
      "options": [
        {
          "name": "--backup",
          "description": "Backup local database"
        }
      ],
      "examples": [
        "supabase stop"
      ]
    },
    {
      "name": "status",
      "description": "Show local Supabase status",
      "options": [
        {
          "name": "--output",
          "description": "Output format (pretty, env, json)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "examples": [
        "supabase status"
      ]
    },
    {
      "name": "login",
      "description": "Log in to Supabase",
      "options": [
        {
          "name": "--token",
          "description": "Access token to store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-browser",
          "description": "Do not open a browser",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "supabase login"
      ]
    },
    {
      "name": "link",
      "description": "Link to a remote Supabase project",
      "options": [
        {
          "name": "--project-ref",
          "description": "Project reference ID",
          "takesValue": true
        }
      ],
      "examples": [
        "supabase link"
      ]
    },
    {
      "name": "db",
      "description": "Manage database",
      "subcommands": [
        {
          "name": "push",
          "description": "Push local migrations to remote database",
          "options": [
            {
              "name": "--dry-run",
              "description": "Print SQL without executing"
            }
          ],
          "examples": [
            "supabase db push"
          ]
        },
        {
          "name": "pull",
          "description": "Pull remote schema changes",
          "options": [
            {
              "name": "--schema",
              "shorthand": "-s",
              "description": "Schemas to pull",
              "takesValue": true,
              "short": "-s"
            }
          ],
          "examples": [
            "supabase db pull"
          ]
        },
        {
          "name": "reset",
          "description": "Reset local database to clean state",
          "options": [
            {
              "name": "--db-url",
              "description": "Database URL to reset",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--linked",
              "description": "Reset the linked project",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--local",
              "description": "Reset the local database",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--no-seed",
              "description": "Skip the seed script",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "supabase db reset"
          ]
        },
        {
          "name": "diff",
          "description": "Show diff between local and remote",
          "options": [
            {
              "name": "--schema",
              "shorthand": "-s",
              "description": "Schemas to diff",
              "takesValue": true,
              "short": "-s"
            },
            {
              "name": "--file",
              "shorthand": "-f",
              "description": "Save diff to file",
              "takesValue": true,
              "short": "-f"
            }
          ],
          "examples": [
            "supabase db diff"
          ]
        },
        {
          "name": "dump",
          "description": "Dump database to file",
          "options": [
            {
              "name": "--data-only",
              "description": "Dump only data"
            },
            {
              "name": "--file",
              "shorthand": "-f",
              "description": "Output file",
              "takesValue": true,
              "short": "-f"
            }
          ],
          "examples": [
            "supabase db dump"
          ]
        },
        {
          "name": "lint",
          "description": "Lint local database for errors",
          "options": [
            {
              "name": "--level",
              "description": "Minimum level to report",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--schema",
              "description": "Schemas to lint",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--linked",
              "description": "Lint the linked project",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "supabase db lint"
          ]
        }
      ]
    },
    {
      "name": "migration",
      "description": "Manage migrations",
      "subcommands": [
        {
          "name": "new",
          "description": "Create a new migration",
          "args": [
            {
              "name": "name",
              "description": "Migration name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--workdir",
              "description": "Project directory to act on",
              "type": "directory",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase migration new name"
          ]
        },
        {
          "name": "list",
          "description": "List migrations",
          "options": [
            {
              "name": "--linked",
              "description": "List the linked project",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--local",
              "description": "List the local database",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--db-url",
              "description": "Database URL",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase migration list"
          ]
        },
        {
          "name": "repair",
          "description": "Repair migration history",
          "options": [
            {
              "name": "--status",
              "description": "Set migration status",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase migration repair"
          ]
        },
        {
          "name": "squash",
          "description": "Squash migrations",
          "options": [
            {
              "name": "--version",
              "description": "Target version",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase migration squash"
          ]
        }
      ]
    },
    {
      "name": "functions",
      "description": "Manage Edge Functions",
      "subcommands": [
        {
          "name": "new",
          "description": "Create a new function",
          "args": [
            {
              "name": "name",
              "description": "Function name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--workdir",
              "description": "Project directory to act on",
              "type": "directory",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase functions new name"
          ]
        },
        {
          "name": "serve",
          "description": "Serve functions locally",
          "options": [
            {
              "name": "--env-file",
              "description": "Path to env file",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase functions serve"
          ]
        },
        {
          "name": "deploy",
          "description": "Deploy functions",
          "args": [
            {
              "name": "name",
              "description": "Function name",
              "required": false
            }
          ],
          "options": [
            {
              "name": "--no-verify-jwt",
              "description": "Disable JWT verification"
            }
          ],
          "examples": [
            "supabase functions deploy name"
          ]
        },
        {
          "name": "delete",
          "description": "Delete a function",
          "args": [
            {
              "name": "name",
              "description": "Function name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--project",
              "description": "Project to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-p",
              "shorthand": "-p"
            },
            {
              "name": "--project-ref",
              "description": "Project reference",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase functions delete name"
          ]
        }
      ]
    },
    {
      "name": "secrets",
      "description": "Manage secrets",
      "subcommands": [
        {
          "name": "list",
          "description": "List all secrets",
          "options": [
            {
              "name": "--project-ref",
              "description": "Project reference",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase secrets list"
          ]
        },
        {
          "name": "set",
          "description": "Set secrets from stdin or env file",
          "options": [
            {
              "name": "--env-file",
              "description": "Load from env file",
              "takesValue": true
            }
          ],
          "args": [
            {
              "name": "assignment",
              "description": "Secret assignment as NAME=VALUE",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "supabase secrets set assignment"
          ]
        },
        {
          "name": "unset",
          "description": "Unset secrets",
          "args": [
            {
              "name": "names",
              "description": "Secret names",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--project-ref",
              "description": "Project reference",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase secrets unset names"
          ]
        }
      ]
    },
    {
      "name": "gen",
      "description": "Generate types and keys",
      "subcommands": [
        {
          "name": "types",
          "description": "Generate TypeScript types",
          "subcommands": [
            {
              "name": "typescript",
              "description": "Generate TS types from schema",
              "options": [
                {
                  "name": "--local",
                  "description": "Use local database"
                },
                {
                  "name": "--linked",
                  "description": "Use linked project"
                },
                {
                  "name": "--schema",
                  "shorthand": "-s",
                  "description": "Schemas to include",
                  "takesValue": true,
                  "short": "-s"
                }
              ],
              "examples": [
                "supabase gen types typescript"
              ]
            }
          ]
        },
        {
          "name": "keys",
          "description": "Generate project API keys",
          "options": [
            {
              "name": "--project-ref",
              "description": "Project reference",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--experimental",
              "description": "Enable experimental behaviour",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "supabase gen keys"
          ]
        }
      ]
    },
    {
      "name": "projects",
      "description": "Manage Supabase projects",
      "subcommands": [
        {
          "name": "list",
          "description": "List all projects",
          "options": [
            {
              "name": "--output",
              "description": "Output format: pretty, json, toml or yaml",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            }
          ],
          "examples": [
            "supabase projects list"
          ]
        },
        {
          "name": "create",
          "description": "Create a new project",
          "args": [
            {
              "name": "name",
              "description": "Project name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--org-id",
              "description": "Organization ID",
              "takesValue": true
            },
            {
              "name": "--db-password",
              "description": "Database password",
              "takesValue": true
            },
            {
              "name": "--region",
              "description": "Region",
              "takesValue": true
            }
          ],
          "examples": [
            "supabase projects create name"
          ]
        }
      ]
    },
    {
      "name": "orgs",
      "description": "Manage organizations",
      "subcommands": [
        {
          "name": "list",
          "description": "List organizations",
          "options": [
            {
              "name": "--output",
              "description": "Output format: pretty, json, toml or yaml",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            }
          ],
          "examples": [
            "supabase orgs list"
          ]
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--debug",
      "description": "Enable debug output"
    },
    {
      "name": "--workdir",
      "description": "Working directory",
      "takesValue": true
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    }
  ],
  "examples": [
    {
      "command": "supabase init",
      "description": "Initialize new Supabase project"
    },
    {
      "command": "supabase start",
      "description": "Start local dev stack"
    },
    {
      "command": "supabase db push",
      "description": "Push migrations to remote"
    },
    {
      "command": "supabase migration new add_users_table",
      "description": "Create a new migration"
    },
    {
      "command": "supabase gen types typescript --local > types/supabase.ts",
      "description": "Generate TypeScript types"
    },
    {
      "command": "supabase functions deploy my-function",
      "description": "Deploy an edge function"
    }
  ],
  "relatedCommands": [
    "firebase",
    "psql"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "local_status",
        "description": "Local Supabase status",
        "command": "supabase status 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "supabase"
      },
      {
        "name": "projects",
        "description": "Linked Supabase projects",
        "command": "supabase projects list 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "supabase"
      },
      {
        "name": "migrations",
        "description": "Database migrations",
        "command": "ls -1 supabase/migrations/*.sql 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "edge_functions",
        "description": "Edge functions",
        "command": "ls -1d supabase/functions/*/ 2>/dev/null | xargs -I{} basename {}",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "config",
        "description": "Supabase config",
        "command": "cat supabase/config.toml 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
