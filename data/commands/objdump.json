{
  "name": "objdump",
  "description": "Display information from object files",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--disassemble",
      "description": "Disassemble the executable sections",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--disassemble-all",
      "description": "Disassemble every section",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--source",
      "description": "Interleave source with disassembly",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--headers",
      "description": "Print the section headers",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--all-headers",
      "description": "Print every header",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--syms",
      "description": "Print the symbol table",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--dynamic-syms",
      "description": "Print the dynamic symbol table",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--demangle",
      "description": "Decode C++ symbol names",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--reloc",
      "description": "Print the relocation entries",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--section",
      "description": "Only process this section",
      "type": "string",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--line-numbers",
      "description": "Include line numbers",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    }
  ],
  "examples": [
    {
      "command": "objdump -d prog",
      "description": "Disassemble a binary"
    },
    {
      "command": "objdump -S -C prog",
      "description": "Disassemble with source and demangled names"
    },
    {
      "command": "objdump -h libx.so",
      "description": "List the section headers"
    },
    {
      "command": "objdump -T libx.so",
      "description": "List the dynamic symbols"
    }
  ],
  "relatedCommands": [
    "nm",
    "readelf",
    "gdb",
    "strip"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GNU objdump version",
        "command": "objdump --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "objdump"
      },
      {
        "name": "architectures",
        "description": "Architectures this objdump supports",
        "command": "objdump --info 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "objdump"
      },
      {
        "name": "objects",
        "description": "Object files and libraries in this project",
        "command": "find . -maxdepth 3 -name '*.o' -o -name '*.a' -o -name '*.so' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
