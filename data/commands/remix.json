{
  "name": "remix",
  "description": "Full-stack React framework with nested routing",
  "category": "static-site",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Create a new Remix project",
      "examples": [
        "npx create-remix@latest"
      ],
      "options": []
    },
    {
      "name": "dev",
      "description": "Start development server",
      "examples": [
        "remix dev",
        "npx remix dev"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host the dev server binds to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "build",
      "description": "Build for production",
      "examples": [
        "remix build"
      ],
      "options": [
        {
          "name": "--sourcemap",
          "description": "Emit source maps for the build",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--mode",
          "description": "Env mode to build for",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "routes",
      "description": "Show application routes",
      "examples": [
        "remix routes"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "reveal",
      "description": "Reveal Remix entry files",
      "examples": [
        "remix reveal entry.server",
        "remix reveal entry.client"
      ],
      "options": [
        {
          "name": "--no-typescript",
          "description": "Emit JavaScript rather than TypeScript",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Hidden file to reveal, such as entry.server",
          "required": false,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--port",
      "description": "Dev server port",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--app-directory",
      "description": "App directory path",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "npx create-remix@latest",
    "remix dev",
    "remix build",
    "remix routes",
    "remix reveal entry.server"
  ],
  "relatedCommands": [
    "next",
    "astro",
    "vite",
    "react-router"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Remix version declared in this project",
        "command": "grep -oE '\"@remix-run/[a-z-]+\": *\"[^\"]*\"' package.json 2>/dev/null | head -10",
        "parser": "keyvalue",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Remix configuration",
        "command": "cat remix.config.js 2>/dev/null || cat vite.config.ts 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "routes",
        "description": "Routes in this Remix app",
        "command": "find app/routes -maxdepth 2 -type f 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
