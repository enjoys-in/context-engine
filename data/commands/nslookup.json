{
  "name": "nslookup",
  "description": "Query Internet name servers interactively",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-type",
      "description": "Query type (A, MX, NS, TXT, SOA, CNAME)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-timeout",
      "description": "Timeout in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-debug",
      "description": "Show full response packets"
    }
  ],
  "examples": [
    "nslookup example.com",
    "nslookup -type=MX example.com",
    "nslookup example.com 8.8.8.8",
    "nslookup -type=TXT example.com",
    "nslookup -type=NS example.com"
  ],
  "relatedCommands": [
    "dig",
    "host",
    "whois",
    "ping"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "nslookup version",
        "command": "nslookup -version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "nslookup"
      },
      {
        "name": "resolvers",
        "description": "DNS resolvers configured",
        "command": "cat /etc/resolv.conf 2>/dev/null | grep nameserver",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "hosts_file",
        "description": "Static host overrides",
        "command": "cat /etc/hosts 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
