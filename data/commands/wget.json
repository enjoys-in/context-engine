{
  "name": "wget",
  "description": "Non-interactive network downloader",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-O",
      "description": "Output file name",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-P",
      "description": "Output directory prefix",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Continue partially downloaded file"
    },
    {
      "name": "-r",
      "description": "Recursive download"
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "-v",
      "description": "Verbose mode"
    },
    {
      "name": "--no-check-certificate",
      "description": "Skip SSL verification"
    },
    {
      "name": "-b",
      "description": "Go to background after startup"
    },
    {
      "name": "--limit-rate",
      "description": "Limit download speed",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tries",
      "short": "-t",
      "description": "Number of retries",
      "type": "number",
      "takesValue": true,
      "shorthand": "-t"
    },
    {
      "name": "--timeout",
      "short": "-T",
      "description": "Timeout in seconds",
      "type": "number",
      "takesValue": true,
      "shorthand": "-T"
    },
    {
      "name": "--user",
      "description": "HTTP user",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--password",
      "description": "HTTP password",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--header",
      "description": "Custom header",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Download URLs from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--mirror",
      "short": "-m",
      "description": "Mirror a website",
      "shorthand": "-m"
    },
    {
      "name": "-np",
      "description": "Don't ascend to parent directory"
    },
    {
      "name": "-k",
      "description": "Convert links for local viewing"
    },
    {
      "name": "--output-document",
      "description": "Write the download to this file",
      "type": "file",
      "takesValue": true,
      "short": "-O",
      "shorthand": "-O"
    },
    {
      "name": "--output-file",
      "description": "Write the log to this file",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--append-output",
      "description": "Append the log to this file",
      "type": "file",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--quiet",
      "description": "Suppress all output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--no-verbose",
      "description": "Print less detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-nv",
      "shorthand": "-nv"
    },
    {
      "name": "--continue",
      "description": "Resume a partial download",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--timestamping",
      "description": "Only download when newer than the local copy",
      "type": "boolean",
      "takesValue": false,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--wait",
      "description": "Seconds to wait between retrievals",
      "type": "integer",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--random-wait",
      "description": "Randomise the wait between retrievals",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--recursive",
      "description": "Follow links recursively",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--level",
      "description": "Recursion depth limit; 0 is infinite",
      "type": "integer",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--no-parent",
      "description": "Do not ascend above the start directory",
      "type": "boolean",
      "takesValue": false,
      "short": "-np",
      "shorthand": "-np"
    },
    {
      "name": "--convert-links",
      "description": "Rewrite links for local viewing",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--page-requisites",
      "description": "Also fetch the page assets",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--accept",
      "description": "Only download these extensions",
      "type": "string",
      "takesValue": true,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--reject",
      "description": "Skip these extensions",
      "type": "string",
      "takesValue": true,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--directory-prefix",
      "description": "Save files under this directory",
      "type": "directory",
      "takesValue": true,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--no-clobber",
      "description": "Do not overwrite existing files",
      "type": "boolean",
      "takesValue": false,
      "short": "-nc",
      "shorthand": "-nc"
    },
    {
      "name": "--user-agent",
      "description": "User-Agent header to send",
      "type": "string",
      "takesValue": true,
      "short": "-U",
      "shorthand": "-U"
    },
    {
      "name": "--post-data",
      "description": "Send this body as a POST",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--load-cookies",
      "description": "Read cookies from this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--save-cookies",
      "description": "Write cookies to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--spider",
      "description": "Check the URL without downloading",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--background",
      "description": "Detach and download in the background",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--input-file",
      "description": "Read URLs from this file",
      "type": "file",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    }
  ],
  "examples": [
    "wget https://example.com/file.tar.gz",
    "wget -O output.html https://example.com",
    "wget -c https://example.com/large-file.iso",
    "wget --limit-rate=1m https://example.com/file.zip",
    "wget -r -np https://example.com/docs/",
    "wget -i urls.txt",
    "wget --mirror -k -p https://example.com"
  ],
  "relatedCommands": [
    "curl",
    "aria2c",
    "axel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "wget version",
        "command": "wget --version 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "wget"
      },
      {
        "name": "proxy",
        "description": "Proxy configuration in effect",
        "command": "echo \"http=${http_proxy:-unset} https=${https_proxy:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "rc_file",
        "description": "Default wget options from .wgetrc",
        "command": "cat ~/.wgetrc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
