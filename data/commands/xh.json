{
  "name": "xh",
  "description": "Friendly and fast HTTP client, a Rust take on httpie",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--json",
      "description": "Send the body as JSON",
      "type": "boolean",
      "takesValue": false,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--form",
      "description": "Send the body as a form",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--multipart",
      "description": "Send a multipart form",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--headers",
      "description": "Print only the response headers",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--body",
      "description": "Print only the response body",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--verbose",
      "description": "Print the request and response",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--download",
      "description": "Save the response to a file",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--output",
      "description": "Write the body to this file",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--follow",
      "description": "Follow redirects",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--auth",
      "description": "Credentials as user:password",
      "type": "string",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--bearer",
      "description": "Bearer token to send",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--timeout",
      "description": "Request timeout in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--proxy",
      "description": "Proxy to use, protocol:URL",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verify",
      "description": "Verify TLS certificates, or a CA path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ignore-stdin",
      "description": "Do not read a body from stdin",
      "type": "boolean",
      "takesValue": false,
      "short": "-I",
      "shorthand": "-I"
    }
  ],
  "examples": [
    {
      "command": "xh example.com",
      "description": "Make a GET request"
    },
    {
      "command": "xh POST api.example.com/users name=alice age:=30",
      "description": "Post typed JSON fields"
    },
    {
      "command": "xh -a user:pass GET api.example.com/me",
      "description": "Send basic auth"
    },
    {
      "command": "xh --download example.com/file.zip",
      "description": "Save the response to a file"
    }
  ],
  "relatedCommands": [
    "httpie",
    "curl",
    "curlie",
    "wget"
  ]
}
