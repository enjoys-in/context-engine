{
  "name": "traceroute",
  "description": "Print the route packets trace to network host",
  "category": "networking",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "No DNS resolution (numeric only)"
    },
    {
      "name": "-m",
      "description": "Maximum TTL (hops)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-w",
      "description": "Wait time per probe (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Number of probes per hop",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-I",
      "description": "Use ICMP ECHO instead of UDP"
    },
    {
      "name": "-T",
      "description": "Use TCP SYN"
    },
    {
      "name": "-p",
      "description": "Destination port",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-4",
      "description": "IPv4 only"
    },
    {
      "name": "-6",
      "description": "IPv6 only"
    }
  ],
  "examples": [
    "traceroute google.com",
    "traceroute -n 8.8.8.8",
    "traceroute -I -n google.com",
    "traceroute -m 15 example.com",
    "traceroute -T -p 443 example.com"
  ],
  "relatedCommands": [
    "ping",
    "mtr",
    "dig",
    "nmap"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "traceroute version",
        "command": "traceroute --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "traceroute"
      },
      {
        "name": "default_gateway",
        "description": "First hop on the default route",
        "command": "ip route 2>/dev/null | grep default",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "resolvers",
        "description": "DNS resolvers configured",
        "command": "cat /etc/resolv.conf 2>/dev/null | grep nameserver",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
