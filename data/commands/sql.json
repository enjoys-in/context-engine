{
  "language": "sql",
  "name": "sql",
  "description": "SQL — Structured Query Language for relational databases",
  "category": "database",
  "contextEngine": {
    "detectors": [
      {
        "name": "scripts",
        "description": "SQL scripts in this project",
        "command": "find . -maxdepth 3 -name '*.sql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "clients",
        "description": "SQL clients available on this host",
        "command": "which psql mysql sqlite3 duckdb cqlsh sqlcmd 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "migrations",
        "description": "Migration directories in this project",
        "command": "ls -d migrations db/migrate prisma/migrations 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  },
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-h / --host",
      "description": "Database server hostname"
    },
    {
      "name": "-p / --port",
      "description": "Database server port"
    },
    {
      "name": "-U / --user",
      "description": "Database username"
    },
    {
      "name": "-d / --database",
      "description": "Target database name"
    },
    {
      "name": "-f / --file",
      "description": "Execute SQL from file"
    },
    {
      "name": "-o / --output",
      "description": "Write results to output file"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    }
  ],
  "subcommands": [
    {
      "name": "sqlite3",
      "description": "SQLite3 interactive shell and command-line tool",
      "args": [
        {
          "name": "database",
          "description": "Database file or name to open",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-cmd",
          "description": "Run this command before reading stdin",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-csv",
          "description": "Output results as CSV",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-json",
          "description": "Output results as JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-header",
          "description": "Show column headers",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "mysql",
      "description": "MySQL command-line client",
      "args": [
        {
          "name": "database",
          "description": "Database file or name to open",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-u",
          "description": "Username to connect as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-p",
          "description": "Prompt for a password",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-h",
          "description": "Server host to connect to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-e",
          "description": "Execute this statement and exit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--batch",
          "description": "Non-interactive, tab-separated output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "psql",
      "description": "PostgreSQL interactive terminal",
      "args": [
        {
          "name": "database",
          "description": "Database file or name to open",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-U",
          "description": "Username to connect as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-h",
          "description": "Server host to connect to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-c",
          "description": "Run a single command and exit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-f",
          "description": "Execute commands from this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--csv",
          "description": "Output results as CSV",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "sqlcmd",
      "description": "SQL Server command-line utility",
      "args": [],
      "options": [
        {
          "name": "-S",
          "description": "Server to connect to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-U",
          "description": "Username to connect as",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-P",
          "description": "Password to connect with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-Q",
          "description": "Run this query and exit",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-i",
          "description": "Execute commands from this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "sqlfmt",
      "description": "SQL formatter for standardized code style",
      "args": [
        {
          "name": "file.sql",
          "description": "SQL script to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--uppercase",
          "description": "Uppercase SQL keywords",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--indent",
          "description": "Number of spaces per indent level",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "sqlfluff",
      "description": "SQL linter and auto-fixer",
      "args": [
        {
          "name": "file.sql",
          "description": "SQL script to process",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--dialect",
          "description": "SQL dialect to parse as (ansi, postgres, mysql, snowflake)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--fix",
          "description": "Apply automatic fixes where possible",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "SELECT * FROM users;",
    "SELECT id, name FROM users WHERE active = 1;",
    "INSERT INTO users (name, email) VALUES ('John', 'john@example.com');",
    "UPDATE users SET active = 0 WHERE id = 5;",
    "DELETE FROM users WHERE id = 5;",
    "CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(100));",
    "ALTER TABLE users ADD COLUMN email VARCHAR(255);",
    "DROP TABLE IF EXISTS temp_users;",
    "CREATE INDEX idx_email ON users(email);",
    "SELECT u.name, o.total FROM users u JOIN orders o ON u.id = o.user_id;",
    "SELECT department, COUNT(*) FROM employees GROUP BY department HAVING COUNT(*) > 5;",
    "SELECT * FROM users ORDER BY created_at DESC LIMIT 10;",
    "BEGIN TRANSACTION; UPDATE accounts SET balance = balance - 100 WHERE id = 1; COMMIT;",
    "CREATE VIEW active_users AS SELECT * FROM users WHERE active = 1;",
    "EXPLAIN ANALYZE SELECT * FROM users WHERE email = 'test@example.com';",
    "WITH cte AS (SELECT * FROM users WHERE active = 1) SELECT * FROM cte;",
    "SELECT COALESCE(nickname, name) AS display_name FROM users;",
    "GRANT SELECT, INSERT ON users TO readonly_user;",
    "CREATE TRIGGER log_update AFTER UPDATE ON users FOR EACH ROW EXECUTE FUNCTION log_changes();"
  ],
  "relatedCommands": [
    "psql",
    "mysql",
    "sqlite3",
    "mongosh",
    "redis-cli"
  ]
}
