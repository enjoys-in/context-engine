{
  "name": "commitlint",
  "description": "Lint commit messages against conventional commit format",
  "category": "git",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--edit",
      "description": "Read commit message from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--from",
      "description": "Lower end of commit range",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--to",
      "description": "Upper end of commit range",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--extends",
      "description": "Config modules to extend",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Path to config file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--format",
      "description": "Output format",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "echo 'fix: typo' | npx commitlint",
    "npx commitlint --edit",
    "npx commitlint --from HEAD~5",
    "npx commitlint --from HEAD~1 --to HEAD"
  ],
  "relatedCommands": [
    "husky",
    "conventional-commits",
    "semantic-release"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "commitlint version",
        "command": "commitlint --version 2>/dev/null || npx commitlint --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "commitlint configuration",
        "command": "cat commitlint.config.js 2>/dev/null || cat .commitlintrc.json 2>/dev/null || grep -A10 '\"commitlint\"' package.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "hooks",
        "description": "Git hooks that would run commitlint",
        "command": "ls .husky 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "recent_subjects",
        "description": "Recent commit subjects to check convention against",
        "command": "git log --oneline -10 --format='%s' 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "git"
      }
    ]
  }
}
