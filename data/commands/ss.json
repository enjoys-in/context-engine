{
  "name": "ss",
  "description": "Utility to investigate sockets",
  "category": "networking",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-t",
      "description": "TCP sockets"
    },
    {
      "name": "-u",
      "description": "UDP sockets"
    },
    {
      "name": "-l",
      "description": "Listening sockets"
    },
    {
      "name": "-a",
      "description": "All sockets"
    },
    {
      "name": "-n",
      "description": "Numeric (no name resolution)"
    },
    {
      "name": "-p",
      "description": "Show process using socket"
    },
    {
      "name": "-e",
      "description": "Show detailed socket information"
    },
    {
      "name": "-s",
      "description": "Print summary statistics"
    },
    {
      "name": "-4",
      "description": "IPv4 only"
    },
    {
      "name": "-6",
      "description": "IPv6 only"
    },
    {
      "name": "-o",
      "description": "Show timer information"
    }
  ],
  "examples": [
    "ss -tlnp",
    "ss -tunap",
    "ss -s",
    "ss -lt",
    "ss -t state established",
    "ss -tlnp | grep :80",
    "ss -tunap | grep node"
  ],
  "relatedCommands": [
    "netstat",
    "lsof",
    "ip",
    "nmap"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ss version",
        "command": "ss -V 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ss"
      },
      {
        "name": "listening",
        "description": "Ports listening on this host",
        "command": "ss -tlnp 2>/dev/null | head -20 || netstat -an 2>/dev/null | grep LISTEN | head -20",
        "parser": "table",
        "cacheFor": 30
      },
      {
        "name": "established",
        "description": "Established TCP connections",
        "command": "ss -tn state established 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 30,
        "requiresCmd": "ss"
      },
      {
        "name": "summary",
        "description": "Socket count by type",
        "command": "ss -s 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "ss"
      }
    ]
  }
}
