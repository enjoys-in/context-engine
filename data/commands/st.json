{
  "language": "st",
  "name": "st",
  "description": "Structured Text — IEC 61131-3 PLC programming tools (CODESYS, OpenPLC, matiec)",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--target",
      "description": "Target PLC platform"
    },
    {
      "name": "--output",
      "description": "Output file or directory"
    },
    {
      "name": "-I",
      "description": "Include directory for library files"
    },
    {
      "name": "-T",
      "description": "Build output directory for matiec"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose compilation output"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    }
  ],
  "subcommands": [
    {
      "name": "compile",
      "description": "Compile Structured Text to PLC bytecode",
      "args": [
        "file.st"
      ],
      "options": [
        {
          "name": "--target",
          "description": "PLC target platform",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the result to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check",
      "description": "Syntax-check Structured Text source files",
      "args": [
        "file.st"
      ],
      "options": [
        {
          "name": "--strict",
          "description": "Treat warnings as errors",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "simulate",
      "description": "Run PLC simulation with Structured Text program",
      "args": [
        "file.st"
      ],
      "options": [
        {
          "name": "--cycle-time",
          "description": "Simulated PLC cycle time",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--duration",
          "description": "How long to run the simulation",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "download",
      "description": "Download compiled program to PLC controller",
      "args": [
        "file"
      ],
      "options": [
        {
          "name": "--target-ip",
          "description": "IP address of the PLC to download to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--protocol",
          "description": "Download protocol to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "generate",
      "description": "Generate C code from Structured Text using matiec",
      "args": [
        "file.st"
      ],
      "options": [
        {
          "name": "-I",
          "description": "Add a directory to the include search path",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-T",
          "description": "Template to generate from",
          "type": "file",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "iec2c -I lib/ -T build/ program.st",
    "matiec program.st -o output.c",
    "openplc_editor program.st",
    "codesys --build project.project --compile"
  ],
  "relatedCommands": [
    "gcc",
    "make",
    "systemverilog"
  ]
}
