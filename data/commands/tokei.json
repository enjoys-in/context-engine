{
  "name": "tokei",
  "description": "Count lines of code by language, quickly",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--languages",
      "description": "List every supported language",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--exclude",
      "description": "Paths to skip",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--output",
      "description": "Report format (json, yaml, cbor, toml)",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--files",
      "description": "List each file individually",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--sort",
      "description": "Sort by field (lines, code, comments, blanks, files)",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--type",
      "description": "Only count these languages",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--hidden",
      "description": "Include hidden files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-ignore",
      "description": "Ignore .gitignore rules",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--compact",
      "description": "Omit the per-language table",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    }
  ],
  "examples": [
    {
      "command": "tokei",
      "description": "Count the current tree"
    },
    {
      "command": "tokei -s code",
      "description": "Sort by lines of code"
    },
    {
      "command": "tokei -t Rust,Python src/",
      "description": "Count only two languages"
    },
    {
      "command": "tokei -o json > loc.json",
      "description": "Export a machine-readable report"
    }
  ],
  "relatedCommands": [
    "cloc",
    "scc",
    "wc",
    "rg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "tokei version",
        "command": "tokei --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "tokei"
      },
      {
        "name": "languages",
        "description": "Lines of code by language in this project",
        "command": "tokei --output json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "tokei"
      },
      {
        "name": "config",
        "description": "tokei configuration",
        "command": "cat tokei.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
