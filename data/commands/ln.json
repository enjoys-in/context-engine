{
  "name": "ln",
  "description": "Create links between files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-s",
      "description": "Create symbolic link"
    },
    {
      "name": "-f",
      "description": "Remove existing destination files"
    },
    {
      "name": "-n",
      "description": "Treat symlink to directory as a normal file"
    },
    {
      "name": "-v",
      "description": "Verbose — print name of each linked file"
    },
    {
      "name": "-r",
      "description": "Create relative symbolic links"
    },
    {
      "name": "-b",
      "description": "Make backup of each existing destination file"
    }
  ],
  "examples": [
    "ln -s /path/to/target link_name",
    "ln -sf /usr/bin/python3 /usr/bin/python",
    "ln original.txt hardlink.txt",
    "ln -sv target link",
    "ln -sr ../shared/config.yaml config.yaml"
  ],
  "relatedCommands": [
    "ls",
    "readlink",
    "stat",
    "cp"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ln version",
        "command": "ln --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ln"
      },
      {
        "name": "symlinks",
        "description": "Symbolic links in this directory",
        "command": "find . -maxdepth 1 -type l -ls 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "writable",
        "description": "Whether the current directory accepts new links",
        "command": "test -w . && echo writable || echo read-only",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
