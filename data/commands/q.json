{
  "name": "q",
  "description": "Run SQL directly on delimited files and multi-file sqlite databases",
  "category": "data",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-H",
      "description": "Input has header row"
    },
    {
      "name": "-d",
      "description": "Input delimiter",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Output delimiter",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-O",
      "description": "Output includes header"
    },
    {
      "name": "-b",
      "description": "Beautify output"
    },
    {
      "name": "-f",
      "description": "Read query from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "Input encoding",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "q -H \"SELECT * FROM data.csv WHERE age > 30\"",
    "q -H -d, \"SELECT name,count(*) FROM data.csv GROUP BY name\"",
    "q -H \"SELECT * FROM data.csv ORDER BY age DESC LIMIT 10\"",
    "q -H -b \"SELECT * FROM prices.csv JOIN names.csv ON prices.id=names.id\""
  ],
  "relatedCommands": [
    "csvkit",
    "miller",
    "sqlite3",
    "xsv"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "q version",
        "command": "q --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "q"
      },
      {
        "name": "data_files",
        "description": "Delimited files q can query with SQL",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.tsv' -o -name '*.txt' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "q default options",
        "command": "cat ~/.qrc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
