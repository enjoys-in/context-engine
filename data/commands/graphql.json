{
  "language": "graphql",
  "name": "graphql-codegen",
  "description": "GraphQL Code Generator and CLI tools for schema management",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Path to codegen config file (default: codegen.ts)"
    },
    {
      "name": "--watch",
      "description": "Watch for changes and regenerate"
    },
    {
      "name": "--overwrite",
      "description": "Overwrite existing generated files"
    },
    {
      "name": "--profile",
      "description": "Enable performance profiling"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose logging"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "generate",
      "description": "Generate code from GraphQL schema and operations",
      "args": [],
      "options": [
        {
          "name": "--config",
          "description": "Path to the codegen configuration file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--watch",
          "description": "Regenerate automatically when files change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--overwrite",
          "description": "Overwrite existing generated files",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "graphql-codegen generate"
      ]
    },
    {
      "name": "init",
      "description": "Initialize a codegen configuration file",
      "args": [],
      "options": [
        {
          "name": "--config",
          "description": "Path for the generated config",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "graphql-codegen init"
      ]
    },
    {
      "name": "get-schema",
      "description": "Download and save GraphQL schema from endpoint",
      "args": [
        {
          "name": "endpoint",
          "description": "GraphQL endpoint URL",
          "type": "url",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--header",
          "description": "Extra HTTP header to send when fetching the schema",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the result to this file",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "graphql-codegen get-schema https://example.com"
      ]
    },
    {
      "name": "validate",
      "description": "Validate GraphQL operations against schema",
      "args": [
        {
          "name": "schema",
          "description": "Schema to inspect",
          "type": "file",
          "required": true
        },
        {
          "name": "documents",
          "description": "Operation documents to check",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--strict",
          "description": "Treat warnings as errors",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "graphql-codegen validate file.txt ./src"
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect a GraphQL schema and display type information",
      "args": [
        {
          "name": "schema",
          "description": "Schema to inspect",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format for the report",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "graphql-codegen inspect file.txt"
      ]
    },
    {
      "name": "diff",
      "description": "Compare two GraphQL schemas for breaking changes",
      "args": [
        {
          "name": "old-schema",
          "description": "Baseline schema to compare against",
          "type": "file",
          "required": true
        },
        {
          "name": "new-schema",
          "description": "Updated schema to compare",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--fail-on-breaking",
          "description": "Exit non-zero when breaking schema changes are found",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "graphql-codegen diff file.txt file.txt"
      ]
    }
  ],
  "examples": [
    "npx graphql-codegen --config codegen.ts",
    "npx graphql-codegen --watch",
    "npx graphql-codegen init",
    "graphql-inspector diff old.graphql new.graphql --fail-on-breaking",
    "npx get-graphql-schema https://api.example.com/graphql > schema.graphql"
  ],
  "relatedCommands": [
    "npm",
    "typescript",
    "node",
    "apollo"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GraphQL Code Generator version",
        "command": "graphql-codegen --version 2>/dev/null || npx graphql-codegen --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Code generator configuration",
        "command": "cat codegen.yml 2>/dev/null || cat codegen.ts 2>/dev/null || cat .graphqlrc 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "schemas",
        "description": "GraphQL schema and operation documents",
        "command": "find . -maxdepth 3 -name '*.graphql' -o -maxdepth 3 -name '*.gql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
