{
  "name": "turbo",
  "description": "Turborepo - high-performance build system for JavaScript/TypeScript monorepos",
  "category": "node-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run tasks across packages",
      "args": [
        {
          "name": "tasks",
          "description": "Tasks to run",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--filter",
          "shorthand": "-F",
          "description": "Filter packages",
          "takesValue": true,
          "short": "-F"
        },
        {
          "name": "--parallel",
          "description": "Run tasks in parallel"
        },
        {
          "name": "--concurrency",
          "description": "Max concurrent tasks",
          "takesValue": true
        },
        {
          "name": "--continue",
          "description": "Continue on error"
        },
        {
          "name": "--dry-run",
          "description": "Show task plan without executing"
        },
        {
          "name": "--graph",
          "description": "Generate task graph (dot format)",
          "takesValue": true
        },
        {
          "name": "--cache-dir",
          "description": "Cache directory",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Ignore cache"
        },
        {
          "name": "--no-cache",
          "description": "Disable caching"
        },
        {
          "name": "--output-logs",
          "description": "Log output mode (full, hash-only, new-only, errors-only, none)",
          "takesValue": true
        },
        {
          "name": "--only",
          "description": "Run only specified tasks, no deps"
        },
        {
          "name": "--env-mode",
          "description": "Environment variable mode (strict, loose)",
          "takesValue": true
        }
      ]
    },
    {
      "name": "prune",
      "description": "Prune workspace for deployment",
      "options": [
        {
          "name": "--scope",
          "description": "Package to prune for",
          "takesValue": true
        },
        {
          "name": "--docker",
          "description": "Output Docker-optimized structure"
        },
        {
          "name": "--out-dir",
          "description": "Output directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "gen",
      "description": "Generate code",
      "subcommands": [
        {
          "name": "workspace",
          "description": "Add a new package to the monorepo",
          "options": [
            {
              "name": "--name",
              "description": "Package name",
              "takesValue": true
            },
            {
              "name": "--copy",
              "description": "Copy from existing package",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "login",
      "description": "Login to Vercel Remote Cache",
      "options": [
        {
          "name": "--sso-team",
          "description": "Team to log in with via SSO",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--api",
          "description": "API URL to authenticate against",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "logout",
      "description": "Logout from Vercel Remote Cache",
      "options": []
    },
    {
      "name": "link",
      "description": "Link to a Vercel team for Remote Cache",
      "options": [
        {
          "name": "--scope",
          "description": "Team or user scope to link to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "unlink",
      "description": "Unlink from Vercel team",
      "options": [
        {
          "name": "--target",
          "description": "What to unlink: remote-cache or spaces",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "daemon",
      "description": "Manage turbo daemon",
      "subcommands": [
        {
          "name": "status",
          "description": "Show daemon status",
          "options": [
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "start",
          "description": "Start the daemon",
          "options": []
        },
        {
          "name": "stop",
          "description": "Stop the daemon",
          "options": []
        }
      ]
    },
    {
      "name": "bin",
      "description": "Show turbo binary path",
      "options": []
    },
    {
      "name": "ls",
      "description": "List packages in the monorepo",
      "options": [
        {
          "name": "--filter",
          "shorthand": "-F",
          "description": "Filter packages",
          "takesValue": true,
          "short": "-F"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    },
    {
      "name": "--cwd",
      "description": "Working directory",
      "takesValue": true
    },
    {
      "name": "--verbosity",
      "description": "Verbosity level",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "turbo run build",
      "description": "Build all packages"
    },
    {
      "command": "turbo run test --filter=@myorg/web",
      "description": "Test a specific package"
    },
    {
      "command": "turbo run lint build test --parallel",
      "description": "Run multiple tasks in parallel"
    },
    {
      "command": "turbo run build --dry-run",
      "description": "Preview build plan"
    },
    {
      "command": "turbo prune --scope=@myorg/web --docker",
      "description": "Prune for Docker deployment"
    },
    {
      "command": "turbo run dev --filter=./apps/*",
      "description": "Dev all apps"
    }
  ],
  "relatedCommands": [
    "nx",
    "npm",
    "pnpm",
    "yarn"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "turbo_config",
        "description": "Turbo configuration",
        "command": "cat turbo.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 30
      },
      {
        "name": "workspaces",
        "description": "Monorepo packages",
        "command": "turbo ls --json 2>/dev/null || node -e \"const p=require('./package.json');(p.workspaces||[]).forEach(w=>console.log(w))\" 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "tasks",
        "description": "Available pipeline tasks",
        "command": "cat turbo.json 2>/dev/null | node -e \"const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));console.log(Object.keys(d.tasks||d.pipeline||{}).join('\\n'))\" 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "package_scripts",
        "description": "Root package.json scripts",
        "command": "node -e \"const p=require('./package.json');Object.keys(p.scripts||{}).forEach(s=>console.log(s))\" 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30
      }
    ]
  }
}
