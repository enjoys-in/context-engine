{
  "language": "typescript",
  "name": "tsc",
  "description": "TypeScript command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "--init",
      "description": "Create tsconfig.json",
      "args": [],
      "options": [
        {
          "name": "--rootDir",
          "description": "Root directory of the input files",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--outDir",
          "description": "Directory for the emitted output",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--strict",
          "description": "Enable every strict type-checking option",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc --init"
      ]
    },
    {
      "name": "--watch",
      "description": "Watch mode",
      "args": [],
      "options": [
        {
          "name": "--preserveWatchOutput",
          "description": "Do not clear the screen between rebuilds",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--incremental",
          "description": "Reuse information from a previous compile",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc --watch"
      ]
    },
    {
      "name": "file.ts",
      "description": "Compile file",
      "args": [],
      "options": [
        {
          "name": "--outFile",
          "description": "Concatenate the output into this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--target",
          "description": "ECMAScript target version",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--module",
          "description": "Module system to emit",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "tsc file.ts"
      ]
    },
    {
      "name": "--noEmit",
      "description": "Type check only",
      "args": [],
      "options": [
        {
          "name": "--pretty",
          "description": "Use colour and formatting in diagnostics",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--incremental",
          "description": "Reuse information from a previous compile",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc --noEmit"
      ]
    },
    {
      "name": "check",
      "description": "Type-check without emitting",
      "usage": "tsc --noEmit",
      "options": [
        {
          "name": "--noEmit",
          "description": "Type-check without emitting output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pretty",
          "description": "Use colour and formatting in diagnostics",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc check"
      ]
    },
    {
      "name": "init",
      "description": "Create tsconfig.json",
      "usage": "tsc --init",
      "options": [
        {
          "name": "--strict",
          "description": "Enable every strict type-checking option",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc init"
      ]
    },
    {
      "name": "watch",
      "description": "Watch mode compilation",
      "usage": "tsc --watch",
      "options": [
        {
          "name": "--preserveWatchOutput",
          "description": "Do not clear the screen between rebuilds",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc watch"
      ]
    },
    {
      "name": "build",
      "description": "Build project references",
      "usage": "tsc --build",
      "options": [
        {
          "name": "--clean",
          "description": "Delete the outputs of the referenced projects",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Rebuild even when up to date",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry",
          "description": "Report what would be built",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--verbose",
          "description": "Explain the build ordering",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc build"
      ]
    },
    {
      "name": "declaration",
      "description": "Generate declaration files",
      "usage": "tsc --declaration",
      "options": [
        {
          "name": "--declarationDir",
          "description": "Directory for the emitted declarations",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--declarationMap",
          "description": "Emit source maps for the declarations",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--emitDeclarationOnly",
          "description": "Emit declarations without JavaScript",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "tsc declaration"
      ]
    }
  ],
  "examples": [
    {
      "command": "tsc",
      "description": "Compile TypeScript"
    },
    {
      "command": "tsc --init",
      "description": "Create tsconfig.json"
    },
    {
      "command": "tsc --noEmit",
      "description": "Type-check without emitting files"
    },
    {
      "command": "tsc --watch",
      "description": "Watch mode compilation"
    },
    {
      "command": "tsc --build",
      "description": "Build project references"
    }
  ],
  "relatedCommands": [
    "tsc",
    "ts-node",
    "tsx",
    "eslint"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "TypeScript compiler version",
        "command": "tsc --version 2>/dev/null || npx tsc --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "TypeScript compiler configuration",
        "command": "cat tsconfig.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "project_refs",
        "description": "Project references declared",
        "command": "grep -A10 '\"references\"' tsconfig.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
