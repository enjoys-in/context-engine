{
  "name": "deno",
  "description": "Secure runtime for JavaScript and TypeScript",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a script",
      "args": [
        {
          "name": "<script>",
          "type": "file",
          "required": true,
          "description": "Script file or URL"
        }
      ],
      "options": [
        {
          "name": "--allow-read",
          "description": "Allow file system read access"
        },
        {
          "name": "--allow-write",
          "description": "Allow file system write access"
        },
        {
          "name": "--allow-net",
          "description": "Allow network access"
        },
        {
          "name": "--allow-env",
          "description": "Allow environment access"
        },
        {
          "name": "--allow-run",
          "description": "Allow running subprocesses"
        },
        {
          "name": "--allow-all",
          "short": "-A",
          "description": "Allow all permissions",
          "shorthand": "-A"
        },
        {
          "name": "--watch",
          "description": "Watch for file changes"
        }
      ],
      "examples": [
        "deno run main.ts",
        "deno run -A server.ts",
        "deno run --allow-net --allow-read main.ts",
        "deno run --watch main.ts"
      ]
    },
    {
      "name": "compile",
      "description": "Compile script into executable",
      "args": [
        {
          "name": "<script>",
          "type": "file",
          "required": true,
          "description": "Script file"
        }
      ],
      "options": [
        {
          "name": "--output",
          "short": "-o",
          "description": "Output binary name",
          "type": "file",
          "takesValue": true,
          "shorthand": "-o"
        },
        {
          "name": "--target",
          "description": "Target platform",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "deno compile -o myapp main.ts"
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "options": [
        {
          "name": "--filter",
          "description": "Filter tests",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--coverage",
          "description": "Enable coverage",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "deno test",
        "deno test --filter 'my test'"
      ]
    },
    {
      "name": "fmt",
      "description": "Format source files",
      "options": [
        {
          "name": "--check",
          "description": "Check formatting only"
        }
      ],
      "examples": [
        "deno fmt",
        "deno fmt --check"
      ]
    },
    {
      "name": "lint",
      "description": "Lint source files",
      "examples": [
        "deno lint"
      ],
      "options": [
        {
          "name": "--fix",
          "description": "Apply fixes that can be applied automatically",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rules",
          "description": "List the available lint rules",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ignore",
          "description": "Paths to skip",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files to lint",
          "required": false,
          "type": "path"
        }
      ]
    },
    {
      "name": "task",
      "description": "Run a task defined in deno.json",
      "args": [
        {
          "name": "<task>",
          "type": "job",
          "required": true,
          "description": "Task name",
          "completion": {
            "detector": "tasks"
          }
        }
      ],
      "examples": [
        "deno task dev",
        "deno task build"
      ],
      "options": [
        {
          "name": "--cwd",
          "description": "Directory to run the task in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--filter",
          "description": "Only run tasks in matching workspace members",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize a new project",
      "examples": [
        "deno init",
        "deno init my_project"
      ],
      "options": [
        {
          "name": "--lib",
          "description": "Scaffold a library rather than an app",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--serve",
          "description": "Scaffold an HTTP server project",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "directory",
          "description": "Directory for the new project",
          "required": false,
          "type": "directory"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install script as CLI command",
      "args": [
        {
          "name": "<script>",
          "type": "string",
          "required": true,
          "description": "Script URL"
        }
      ],
      "options": [
        {
          "name": "--name",
          "short": "-n",
          "description": "Command name",
          "type": "string",
          "takesValue": true,
          "shorthand": "-n"
        }
      ],
      "examples": [
        "deno install -A -n myapp https://deno.land/x/app/cli.ts"
      ]
    },
    {
      "name": "bench",
      "description": "Run benchmarks",
      "examples": [
        "deno bench"
      ],
      "options": [
        {
          "name": "--filter",
          "description": "Only run benchmarks matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-run",
          "description": "Type-check without running",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "check",
      "description": "Type-check without running",
      "examples": [
        "deno check main.ts"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Also type-check remote modules",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--doc",
          "description": "Also type-check code in doc comments",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Entry point to type-check",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "info",
      "description": "Show information about a module",
      "args": [
        {
          "name": "<module>",
          "type": "package",
          "required": false,
          "description": "Module URL"
        }
      ],
      "examples": [
        "deno info",
        "deno info main.ts"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--location",
          "description": "Base location to resolve against",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cache",
      "description": "Cache and compile remote dependencies",
      "args": [
        {
          "name": "<files>",
          "type": "file",
          "required": true,
          "description": "Files to cache"
        }
      ],
      "examples": [
        "deno cache deps.ts"
      ],
      "options": [
        {
          "name": "--reload",
          "description": "Ignore the cache and refetch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--frozen",
          "description": "Fail if the lockfile would change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "short": "-V",
      "description": "Print version",
      "shorthand": "-V"
    },
    {
      "name": "--unstable",
      "description": "Enable unstable APIs"
    },
    {
      "name": "--config",
      "short": "-c",
      "description": "Config file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-c"
    }
  ],
  "examples": [
    "deno run -A server.ts",
    "deno test",
    "deno fmt && deno lint",
    "deno compile -o app main.ts"
  ],
  "relatedCommands": [
    "node",
    "bun",
    "npm",
    "tsx"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Deno version",
        "command": "deno --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "deno"
      },
      {
        "name": "config",
        "description": "Deno project configuration",
        "command": "cat deno.json 2>/dev/null || cat deno.jsonc 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "tasks",
        "description": "Deno tasks declared",
        "command": "deno task 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "deno"
      },
      {
        "name": "import_map",
        "description": "Import map in effect",
        "command": "grep -A15 '\"imports\"' deno.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
