{
  "name": "emacs",
  "description": "Extensible, customisable text editor and computing environment",
  "category": "editor",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-window-system",
      "description": "Run in the terminal",
      "type": "boolean",
      "takesValue": false,
      "short": "-nw",
      "shorthand": "-nw"
    },
    {
      "name": "--daemon",
      "description": "Start as a background server",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--eval",
      "description": "Evaluate a Lisp expression",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--load",
      "description": "Load a Lisp file",
      "type": "file",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--batch",
      "description": "Run non-interactively",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-init-file",
      "description": "Skip the init file",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--debug-init",
      "description": "Debug errors in the init file",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--find-file",
      "description": "Open this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--kill",
      "description": "Stop the running daemon",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "emacs -nw notes.org",
      "description": "Open in the terminal"
    },
    {
      "command": "emacs --daemon",
      "description": "Start the background server"
    },
    {
      "command": "emacsclient -nw file.txt",
      "description": "Connect a terminal client to the daemon"
    },
    {
      "command": "emacs --batch -l build.el",
      "description": "Run a script non-interactively"
    }
  ],
  "relatedCommands": [
    "vim",
    "nvim",
    "nano",
    "emacsclient"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Emacs version",
        "command": "emacs --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "emacs"
      },
      {
        "name": "config",
        "description": "Emacs init file in use",
        "command": "ls ~/.emacs.d/init.el ~/.emacs ~/.config/emacs/init.el 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "packages",
        "description": "Emacs packages installed",
        "command": "ls ~/.emacs.d/elpa 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "server",
        "description": "Whether an Emacs server is running",
        "command": "ls /tmp/emacs*/server 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
