{
  "name": "k3d",
  "description": "k3d — run k3s Kubernetes clusters in Docker",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "cluster create",
      "description": "Create a cluster",
      "examples": [
        "k3d cluster create",
        "k3d cluster create my-cluster",
        "k3d cluster create my-cluster --agents 3",
        "k3d cluster create my-cluster --servers 3 --agents 3",
        "k3d cluster create my-cluster -p '8080:80@loadbalancer'",
        "k3d cluster create my-cluster --api-port 6550",
        "k3d cluster create my-cluster --image rancher/k3s:v1.27.4-k3s1",
        "k3d cluster create my-cluster --volume /my/path:/some/path@all",
        "k3d cluster create my-cluster --registry-create my-registry:0.0.0.0:5000"
      ],
      "options": [
        {
          "name": "--servers",
          "description": "Server node count",
          "type": "integer",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--agents",
          "description": "Agent node count",
          "type": "integer",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--port",
          "description": "Port mapping",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--image",
          "description": "K3s image to use",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--registry-create",
          "description": "Create a registry for the cluster",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--k3s-arg",
          "description": "Extra K3s argument",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait for the server to be ready",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--volume",
          "description": "Volume mount",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "cluster list",
      "description": "List clusters",
      "examples": [
        "k3d cluster list"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format (json, yaml)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--no-headers",
          "description": "Omit the header row",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "cluster delete",
      "description": "Delete cluster(s)",
      "examples": [
        "k3d cluster delete my-cluster",
        "k3d cluster delete --all"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Delete every cluster",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "cluster start",
      "description": "Start a stopped cluster",
      "examples": [
        "k3d cluster start my-cluster"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Start every cluster",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--wait",
          "description": "Wait for the server to be ready",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--timeout",
          "description": "How long to wait",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cluster stop",
      "description": "Stop a running cluster",
      "examples": [
        "k3d cluster stop my-cluster"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Stop every cluster",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "node create",
      "description": "Create new node",
      "examples": [
        "k3d node create my-node --cluster my-cluster --role agent"
      ],
      "options": [
        {
          "name": "--cluster",
          "description": "Cluster to join",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--role",
          "description": "Node role (agent, server)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--replicas",
          "description": "Node count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--image",
          "description": "K3s image to use",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "node list",
      "description": "List nodes",
      "examples": [
        "k3d node list"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--no-headers",
          "description": "Omit the header row",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "node delete",
      "description": "Delete node",
      "examples": [
        "k3d node delete my-node"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Delete every node",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "registry create",
      "description": "Create a local registry",
      "examples": [
        "k3d registry create my-registry --port 5000"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port to expose",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--image",
          "description": "Registry image",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--no-help",
          "description": "Suppress the usage hint",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "registry list",
      "description": "List registries",
      "examples": [
        "k3d registry list"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--no-headers",
          "description": "Omit the header row",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "registry delete",
      "description": "Delete registry",
      "examples": [
        "k3d registry delete my-registry"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Delete every registry",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "image import",
      "description": "Import images into cluster",
      "examples": [
        "k3d image import my-image:latest -c my-cluster"
      ],
      "options": [
        {
          "name": "--cluster",
          "description": "Cluster to import into",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--keep-tarball",
          "description": "Keep the temporary tarball",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--mode",
          "description": "Import mode (auto, direct, tools-node)",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        }
      ]
    },
    {
      "name": "kubeconfig get",
      "description": "Get kubeconfig",
      "examples": [
        "k3d kubeconfig get my-cluster",
        "k3d kubeconfig merge my-cluster --kubeconfig-merge-default"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Merge every cluster",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "k3d version"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "description": "Enable verbose output"
    },
    {
      "name": "--timestamps",
      "description": "Enable timestamps in logs"
    },
    {
      "name": "--trace",
      "description": "Enable trace logging"
    }
  ],
  "examples": [
    "k3d cluster create my-cluster",
    "k3d cluster create my-cluster --agents 3 -p '8080:80@loadbalancer'",
    "k3d cluster list",
    "k3d cluster delete my-cluster",
    "k3d image import my-image:latest -c my-cluster",
    "k3d kubeconfig merge my-cluster --kubeconfig-merge-default",
    "k3d registry create my-registry --port 5000"
  ],
  "relatedCommands": [
    "k3s",
    "kubectl",
    "docker",
    "kind",
    "minikube"
  ]
}
