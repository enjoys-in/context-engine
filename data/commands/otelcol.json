{
  "name": "otelcol",
  "description": "OpenTelemetry Collector — receive, process and export telemetry",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "validate",
      "description": "Validate the configuration",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file or URI",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "components",
      "description": "List the built-in components",
      "options": []
    },
    {
      "name": "featuregate",
      "description": "List the feature gates",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file or URI",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--set",
      "description": "Override a configuration value, key=value",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--feature-gates",
      "description": "Feature gates to enable or disable",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "otelcol --config config.yaml",
      "description": "Run the collector"
    },
    {
      "command": "otelcol validate --config config.yaml",
      "description": "Validate the configuration"
    },
    {
      "command": "otelcol components",
      "description": "List the available components"
    },
    {
      "command": "otelcol --config config.yaml --set service.telemetry.logs.level=debug",
      "description": "Override a setting"
    }
  ],
  "relatedCommands": [
    "jaeger",
    "prometheus",
    "vector",
    "telegraf"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "OpenTelemetry Collector version",
        "command": "otelcol --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "otelcol"
      },
      {
        "name": "config",
        "description": "Collector pipeline configuration",
        "command": "cat /etc/otelcol/config.yaml 2>/dev/null | head -50 || cat otel-collector-config.yaml 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "service",
        "description": "Collector service state",
        "command": "systemctl is-active otelcol 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "endpoint",
        "description": "OTLP exporter endpoint in effect",
        "command": "echo \"${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4317}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
