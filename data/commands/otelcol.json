{
  "name": "otelcol",
  "description": "OpenTelemetry Collector — receive, process and export telemetry",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "validate",
      "description": "Validate the configuration",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file or URI",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "components",
      "description": "List the built-in components"
    },
    {
      "name": "featuregate",
      "description": "List the feature gates"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file or URI",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--set",
      "description": "Override a configuration value, key=value",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--feature-gates",
      "description": "Feature gates to enable or disable",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "otelcol --config config.yaml",
      "description": "Run the collector"
    },
    {
      "command": "otelcol validate --config config.yaml",
      "description": "Validate the configuration"
    },
    {
      "command": "otelcol components",
      "description": "List the available components"
    },
    {
      "command": "otelcol --config config.yaml --set service.telemetry.logs.level=debug",
      "description": "Override a setting"
    }
  ],
  "relatedCommands": [
    "jaeger",
    "prometheus",
    "vector",
    "telegraf"
  ]
}
