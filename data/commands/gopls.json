{
  "name": "gopls",
  "description": "Official Go language server",
  "category": "go",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "serve",
      "description": "Run the language server",
      "options": [
        {
          "name": "--listen",
          "description": "Address to listen on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--logfile",
          "description": "Write logs to this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--rpc.trace",
          "description": "Log the RPC traffic",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check",
      "description": "Report diagnostics for files",
      "args": [
        {
          "name": "files",
          "description": "Files to check",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--severity",
          "description": "Minimum diagnostic severity to report",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "format",
      "description": "Format files",
      "options": [
        {
          "name": "--write",
          "description": "Write the result back",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--diff",
          "description": "Print the diff",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files to format",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "imports",
      "description": "Fix the import block",
      "options": [
        {
          "name": "--write",
          "description": "Write the result back",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ],
      "args": [
        {
          "name": "files",
          "description": "Files to fix",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "definition",
      "description": "Print the definition location of a symbol",
      "args": [
        {
          "name": "position",
          "description": "file:line:col",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--markdown",
          "description": "Render the hover text as Markdown",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "references",
      "description": "List the references to a symbol",
      "args": [
        {
          "name": "position",
          "description": "file:line:col",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--declaration",
          "description": "Include the declaration itself",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ]
    },
    {
      "name": "rename",
      "description": "Rename a symbol",
      "options": [
        {
          "name": "--write",
          "description": "Write the result back",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ],
      "args": [
        {
          "name": "position",
          "description": "file:line:col",
          "type": "string",
          "required": true
        },
        {
          "name": "newname",
          "description": "New name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "symbols",
      "description": "List the symbols in a file",
      "args": [
        {
          "name": "file",
          "description": "File to inspect",
          "type": "file",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "version",
      "description": "Show the gopls version",
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "stats",
      "description": "Print cache and workspace statistics",
      "options": []
    },
    {
      "name": "api-diff",
      "description": "Compare the API of two package versions",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--remote",
      "description": "Connect to a shared gopls daemon",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Serve a debug page on this address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--vv",
      "description": "Enable very verbose logging",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "gopls serve",
      "description": "Run the language server"
    },
    {
      "command": "gopls check ./...",
      "description": "Report diagnostics for the module"
    },
    {
      "command": "gopls format -w main.go",
      "description": "Format a file in place"
    },
    {
      "command": "gopls references main.go:10:6",
      "description": "List references to a symbol"
    }
  ],
  "relatedCommands": [
    "go",
    "staticcheck",
    "golangci-lint",
    "dlv"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "gopls version",
        "command": "gopls version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gopls"
      },
      {
        "name": "module",
        "description": "Go module gopls will index",
        "command": "head -3 go.mod 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "workspace",
        "description": "Go workspace file if this is a multi-module setup",
        "command": "cat go.work 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "go_env",
        "description": "Go environment gopls inherits",
        "command": "go env GOPATH GOMODCACHE GOFLAGS 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "go"
      }
    ]
  }
}
