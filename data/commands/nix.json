{
  "name": "nix",
  "description": "Purely functional package manager and build system",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build a derivation or flake output",
      "options": [
        {
          "name": "--out-link",
          "description": "Symlink to create for the result",
          "type": "path",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--no-link",
          "description": "Do not create a result symlink",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-out-paths",
          "description": "Print the store paths",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rebuild",
          "description": "Rebuild even if cached",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "installable",
          "description": "Flake output or derivation",
          "type": "string",
          "required": false
        }
      ],
      "examples": [
        "nix build installable"
      ]
    },
    {
      "name": "develop",
      "description": "Enter a development shell for a flake",
      "options": [
        {
          "name": "--command",
          "description": "Run this command instead of a shell",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "nix develop"
      ]
    },
    {
      "name": "shell",
      "description": "Run a shell with these packages available",
      "options": [
        {
          "name": "--command",
          "description": "Run this command instead of a shell",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "nix shell"
      ]
    },
    {
      "name": "run",
      "description": "Build and run a flake output",
      "args": [
        {
          "name": "installable",
          "description": "Flake output to run",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--command",
          "description": "Command to run in the environment",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "nix run installable"
      ]
    },
    {
      "name": "profile",
      "description": "Manage the user package profile",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--profile",
          "description": "Profile directory to act on",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "nix profile"
      ]
    },
    {
      "name": "flake",
      "description": "Create and inspect flakes",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--all-systems",
          "description": "Evaluate for every supported system",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--update-input",
          "description": "Update just this flake input",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "nix flake"
      ]
    },
    {
      "name": "search",
      "description": "Search for packages",
      "args": [
        {
          "name": "query",
          "description": "Search terms",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclude",
          "description": "Exclude results matching this pattern",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ],
      "examples": [
        "nix search query"
      ]
    },
    {
      "name": "store",
      "description": "Operate on the Nix store",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--store",
          "description": "Store URI to act against",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "nix store"
      ]
    },
    {
      "name": "repl",
      "description": "Start an interactive Nix expression evaluator",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--file",
          "description": "Load this Nix expression file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "nix repl"
      ]
    },
    {
      "name": "eval",
      "description": "Evaluate a Nix expression",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw",
          "description": "Print the raw string result",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "nix eval"
      ]
    },
    {
      "name": "fmt",
      "description": "Format Nix files",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        }
      ],
      "examples": [
        "nix fmt"
      ]
    },
    {
      "name": "why-depends",
      "description": "Explain why one path depends on another",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        },
        {
          "name": "--all",
          "description": "Show every dependency path",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--precise",
          "description": "Show which files create the dependency",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "nix why-depends"
      ]
    },
    {
      "name": "copy",
      "description": "Copy paths between stores",
      "options": [
        {
          "name": "--to",
          "description": "Destination store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from",
          "description": "Source store",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "nix copy"
      ]
    },
    {
      "name": "registry",
      "description": "Manage the flake registry",
      "options": [
        {
          "name": "--impure",
          "description": "Allow access to mutable state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--offline",
          "description": "Do not access the network",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--refresh",
          "description": "Ignore cached evaluation results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-build-logs",
          "description": "Print full build logs",
          "type": "boolean",
          "takesValue": false,
          "short": "-L",
          "shorthand": "-L"
        }
      ],
      "examples": [
        "nix registry"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--extra-experimental-features",
      "description": "Enable extra experimental features",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--impure",
      "description": "Allow access to mutable state",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--offline",
      "description": "Work without network access",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--refresh",
      "description": "Ignore cached evaluations",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--print-build-logs",
      "description": "Stream build logs",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--max-jobs",
      "description": "Parallel build jobs",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "nix build .#default -L",
      "description": "Build a flake output, streaming logs"
    },
    {
      "command": "nix develop",
      "description": "Enter the project development shell"
    },
    {
      "command": "nix shell nixpkgs#ripgrep",
      "description": "Run a shell with a package available"
    },
    {
      "command": "nix search nixpkgs postgres",
      "description": "Search for a package"
    },
    {
      "command": "nix flake update",
      "description": "Refresh the flake inputs"
    }
  ],
  "relatedCommands": [
    "nix-env",
    "nix-shell",
    "brew",
    "apt",
    "mise"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Nix version",
        "command": "nix --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "nix"
      },
      {
        "name": "flake",
        "description": "Flake definition in this project",
        "command": "cat flake.nix 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Nix configuration and enabled features",
        "command": "nix config show 2>/dev/null | head -25 || cat /etc/nix/nix.conf 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600
      },
      {
        "name": "stores",
        "description": "Nix store paths in the current profile",
        "command": "ls ~/.nix-profile/bin 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
