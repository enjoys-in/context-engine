{
  "name": "nix",
  "description": "Purely functional package manager and build system",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build a derivation or flake output",
      "options": [
        {
          "name": "--out-link",
          "description": "Symlink to create for the result",
          "type": "path",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--no-link",
          "description": "Do not create a result symlink",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--print-out-paths",
          "description": "Print the store paths",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--rebuild",
          "description": "Rebuild even if cached",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "installable",
          "description": "Flake output or derivation",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "develop",
      "description": "Enter a development shell for a flake",
      "options": [
        {
          "name": "--command",
          "description": "Run this command instead of a shell",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "shell",
      "description": "Run a shell with these packages available",
      "options": [
        {
          "name": "--command",
          "description": "Run this command instead of a shell",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run a flake output",
      "args": [
        {
          "name": "installable",
          "description": "Flake output to run",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "profile",
      "description": "Manage the user package profile"
    },
    {
      "name": "flake",
      "description": "Create and inspect flakes"
    },
    {
      "name": "search",
      "description": "Search for packages",
      "args": [
        {
          "name": "query",
          "description": "Search terms",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "store",
      "description": "Operate on the Nix store"
    },
    {
      "name": "repl",
      "description": "Start an interactive Nix expression evaluator"
    },
    {
      "name": "eval",
      "description": "Evaluate a Nix expression",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw",
          "description": "Print the raw string result",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "fmt",
      "description": "Format Nix files"
    },
    {
      "name": "why-depends",
      "description": "Explain why one path depends on another"
    },
    {
      "name": "copy",
      "description": "Copy paths between stores",
      "options": [
        {
          "name": "--to",
          "description": "Destination store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from",
          "description": "Source store",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "registry",
      "description": "Manage the flake registry"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--extra-experimental-features",
      "description": "Enable extra experimental features",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--impure",
      "description": "Allow access to mutable state",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--offline",
      "description": "Work without network access",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--refresh",
      "description": "Ignore cached evaluations",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--print-build-logs",
      "description": "Stream build logs",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--max-jobs",
      "description": "Parallel build jobs",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "nix build .#default -L",
      "description": "Build a flake output, streaming logs"
    },
    {
      "command": "nix develop",
      "description": "Enter the project development shell"
    },
    {
      "command": "nix shell nixpkgs#ripgrep",
      "description": "Run a shell with a package available"
    },
    {
      "command": "nix search nixpkgs postgres",
      "description": "Search for a package"
    },
    {
      "command": "nix flake update",
      "description": "Refresh the flake inputs"
    }
  ],
  "relatedCommands": [
    "nix-env",
    "nix-shell",
    "brew",
    "apt",
    "mise"
  ]
}
