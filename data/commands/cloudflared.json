{
  "name": "cloudflared",
  "description": "Cloudflare Tunnel daemon — expose local services securely",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "tunnel",
      "description": "Manage tunnels",
      "examples": [
        "cloudflared tunnel create my-tunnel",
        "cloudflared tunnel list",
        "cloudflared tunnel delete my-tunnel",
        "cloudflared tunnel run my-tunnel",
        "cloudflared tunnel route dns my-tunnel app.example.com",
        "cloudflared tunnel route ip add 10.0.0.0/8 my-tunnel",
        "cloudflared tunnel info my-tunnel",
        "cloudflared tunnel cleanup my-tunnel"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--credentials-file",
          "description": "Tunnel credentials file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--url",
          "description": "Local service to expose",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--loglevel",
          "description": "Log verbosity level",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Tunnel operation: create, list, run, route or delete",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "tunnel login",
      "description": "Authenticate with Cloudflare",
      "examples": [
        "cloudflared tunnel login"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "access",
      "description": "Cloudflare Access helpers",
      "examples": [
        "cloudflared access login https://app.example.com",
        "cloudflared access ssh --hostname ssh.example.com",
        "cloudflared access tcp --hostname tcp.example.com --url localhost:5432"
      ],
      "options": [
        {
          "name": "--hostname",
          "description": "Protected hostname to reach",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--url",
          "description": "Local address to bind",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--service-token-id",
          "description": "Service token id to authenticate with",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Access operation: login, curl, ssh or token",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "service",
      "description": "Manage system service",
      "examples": [
        "cloudflared service install",
        "cloudflared service uninstall"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Service operation: install or uninstall",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "proxy-dns",
      "description": "Run DNS-over-HTTPS proxy",
      "examples": [
        "cloudflared proxy-dns",
        "cloudflared proxy-dns --port 5053 --upstream https://1.1.1.1/dns-query"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the DNS proxy listens on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--address",
          "description": "Address the DNS proxy binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--upstream",
          "description": "Upstream DNS-over-HTTPS endpoint",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Update cloudflared",
      "examples": [
        "cloudflared update"
      ],
      "options": [
        {
          "name": "--beta",
          "description": "Update to the latest beta build",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--version",
          "description": "Update to this specific version",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "cloudflared version"
      ],
      "options": []
    },
    {
      "name": "quick-tunnel",
      "description": "Start a quick tunnel (trycloudflare)",
      "examples": [
        "cloudflared tunnel --url http://localhost:8080"
      ],
      "options": [
        {
          "name": "--url",
          "description": "Local service to expose",
          "type": "url",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Config file path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--credentials-file",
      "description": "Tunnel credentials file",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--origincert",
      "description": "Origin certificate path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--loglevel",
      "description": "Log level (debug, info, warn, error, fatal)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--logfile",
      "description": "Log file path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--protocol",
      "description": "Protocol (auto, http2, quic)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "cloudflared tunnel login",
    "cloudflared tunnel create my-tunnel",
    "cloudflared tunnel run my-tunnel",
    "cloudflared tunnel route dns my-tunnel app.example.com",
    "cloudflared tunnel list",
    "cloudflared tunnel --url http://localhost:8080",
    "cloudflared access ssh --hostname ssh.example.com",
    "cloudflared proxy-dns"
  ],
  "relatedCommands": [
    "wrangler",
    "nginx",
    "ngrok",
    "caddy"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "cloudflared version",
        "command": "cloudflared --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cloudflared"
      },
      {
        "name": "tunnels",
        "description": "Cloudflare tunnels for this account",
        "command": "cloudflared tunnel list 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "cloudflared"
      },
      {
        "name": "config",
        "description": "cloudflared tunnel configuration",
        "command": "cat ~/.cloudflared/config.yml 2>/dev/null || cat /etc/cloudflared/config.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "credentials",
        "description": "Tunnel credential files present",
        "command": "ls ~/.cloudflared/*.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
