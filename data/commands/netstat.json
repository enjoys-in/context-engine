{
  "name": "netstat",
  "description": "Print network connections, routing tables, interface statistics",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-t",
      "description": "TCP connections"
    },
    {
      "name": "-u",
      "description": "UDP connections"
    },
    {
      "name": "-l",
      "description": "Listening sockets"
    },
    {
      "name": "-n",
      "description": "Numeric addresses (no DNS)"
    },
    {
      "name": "-p",
      "description": "Show PID/program name"
    },
    {
      "name": "-a",
      "description": "All sockets"
    },
    {
      "name": "-r",
      "description": "Routing table"
    },
    {
      "name": "-s",
      "description": "Statistics"
    },
    {
      "name": "-i",
      "description": "Interface table"
    },
    {
      "name": "-c",
      "description": "Continuous listing"
    }
  ],
  "examples": [
    "netstat -tlnp",
    "netstat -tunap",
    "netstat -an",
    "netstat -r",
    "netstat -s",
    "netstat -i",
    "netstat -tlnp | grep :80"
  ],
  "relatedCommands": [
    "ss",
    "lsof",
    "ip",
    "nmap"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "netstat version",
        "command": "netstat --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "netstat"
      },
      {
        "name": "listening",
        "description": "Ports listening on this host",
        "command": "ss -tlnp 2>/dev/null | head -20 || netstat -an 2>/dev/null | grep LISTEN | head -20",
        "parser": "table",
        "cacheFor": 30
      },
      {
        "name": "routes",
        "description": "Routing table",
        "command": "netstat -rn 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "netstat"
      },
      {
        "name": "statistics",
        "description": "Per-protocol network statistics",
        "command": "netstat -s 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "netstat"
      }
    ]
  }
}
