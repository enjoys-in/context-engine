{
  "name": "concurrently",
  "description": "Run multiple commands concurrently",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Comma-separated names for prefixes",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-k",
      "description": "Kill others on failure"
    },
    {
      "name": "--kill-others-on-fail",
      "description": "Kill all if one exits non-zero"
    },
    {
      "name": "-p",
      "description": "Prefix type (pid, name, command, time, none)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Comma-separated colors for prefixes",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--raw",
      "description": "Output raw (no prefix)"
    },
    {
      "name": "-m",
      "description": "Maximum parallel processes",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "concurrently \"npm:dev\" \"npm:watch\"",
    "concurrently -n server,client \"npm run server\" \"npm run client\"",
    "concurrently -k \"tsc -w\" \"node dist/index.js\"",
    "concurrently --kill-others-on-fail \"npm test\" \"npm run lint\""
  ],
  "relatedCommands": [
    "parallel",
    "npm-run-all",
    "make"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "concurrently version",
        "command": "concurrently --version 2>/dev/null || npx concurrently --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
