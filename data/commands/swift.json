{
  "language": "swift",
  "name": "swift",
  "description": "Swift — safe, fast, expressive language by Apple",
  "category": "language",
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Swift version",
        "command": "swift --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "swift"
      },
      {
        "name": "package_dump",
        "description": "Swift Package.swift dump",
        "command": "swift package dump-package 2>/dev/null | head -5",
        "parser": "json",
        "cacheFor": 60,
        "requiresCmd": "swift"
      }
    ]
  },
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "globalOptions": [
    {
      "name": "-O",
      "description": "Compile with optimizations"
    },
    {
      "name": "-g",
      "description": "Include debug information in compilation"
    },
    {
      "name": "-Onone",
      "description": "Compile without any optimizations"
    },
    {
      "name": "-Ounchecked",
      "description": "Compile with optimizations and remove runtime safety checks"
    },
    {
      "name": "-whole-module-optimization",
      "description": "Enable whole module optimization"
    },
    {
      "name": "-target",
      "description": "Generate code for the given target triple",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-sdk",
      "description": "Compile against the given SDK path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-I",
      "description": "Add directory to import search path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-L",
      "description": "Add directory to library link search path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-F",
      "description": "Add directory to framework search path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-swift-version",
      "description": "Specify Swift language version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-warnings-as-errors",
      "description": "Treat warnings as errors"
    },
    {
      "name": "-suppress-warnings",
      "description": "Suppress all warnings"
    },
    {
      "name": "-module-name",
      "description": "Specify the module name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-emit-library",
      "description": "Emit a linked library"
    },
    {
      "name": "-emit-executable",
      "description": "Emit a linked executable"
    },
    {
      "name": "-parse-as-library",
      "description": "Parse input files as libraries"
    },
    {
      "name": "-c",
      "description": "Build in the specified configuration (debug|release)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--product",
      "description": "Build the specified product",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--parallel",
      "description": "Build with parallelism enabled"
    }
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build Swift package",
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: debug or release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--product",
          "description": "Only build this product",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--target",
          "description": "Only build this target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--jobs",
          "description": "Number of parallel jobs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run an executable product",
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: debug or release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--skip-build",
          "description": "Run without building first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Executable target to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run package tests",
      "options": [
        {
          "name": "--filter",
          "description": "Only run tests matching this pattern",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--parallel",
          "description": "Run tests in parallel",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--enable-code-coverage",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--configuration",
          "description": "Build configuration: debug or release",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--list-tests",
          "description": "List the tests without running them",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "package",
      "description": "Perform operations on Swift packages",
      "options": [
        {
          "name": "--package-path",
          "description": "Package directory to operate on",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "package init",
      "description": "Initialize a new Swift package",
      "options": [
        {
          "name": "--type",
          "description": "Package type: library, executable, tool or macro",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Package name",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "package update",
      "description": "Update package dependencies",
      "options": [
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--package-path",
          "description": "Package directory to operate on",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "package resolve",
      "description": "Resolve package dependencies",
      "options": [
        {
          "name": "--package-path",
          "description": "Package directory to operate on",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--force-resolved-versions",
          "description": "Resolve strictly to Package.resolved",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "package show-dependencies",
      "description": "Show resolved package dependencies",
      "options": [
        {
          "name": "--format",
          "description": "Output format: text, dot, json or flatlist",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output-path",
          "description": "Write the graph to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "package clean",
      "description": "Delete build artifacts",
      "options": [
        {
          "name": "--package-path",
          "description": "Package directory to operate on",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "package reset",
      "description": "Reset the complete cache/build directory",
      "options": [
        {
          "name": "--package-path",
          "description": "Package directory to operate on",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "package generate-xcodeproj",
      "description": "Generate an Xcode project",
      "options": [
        {
          "name": "--output",
          "description": "Path for the generated project",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--enable-code-coverage",
          "description": "Enable coverage in the generated scheme",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "swift main.swift",
    "swiftc -o app main.swift",
    "swiftc -O -o app main.swift",
    "swift build",
    "swift build -c release",
    "swift run",
    "swift run MyApp",
    "swift test",
    "swift test --filter MyTests",
    "swift package init --type executable",
    "swift package init --type library",
    "swift package resolve",
    "swift package update",
    "swift package show-dependencies",
    "swift package clean",
    "swift package generate-xcodeproj"
  ],
  "relatedCommands": [
    "swiftc",
    "xcodebuild",
    "swift-format",
    "sourcekit-lsp",
    "xcrun",
    "xcode-select"
  ]
}
