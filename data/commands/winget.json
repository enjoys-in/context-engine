{
  "name": "winget",
  "description": "Windows Package Manager CLI",
  "category": "package-manager",
  "platforms": [
    "windows"
  ],
  "shells": [
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a package",
      "args": [
        {
          "name": "query",
          "description": "Package identifier or name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--id",
          "description": "Filter by package ID",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Filter by package name",
          "takesValue": true
        },
        {
          "name": "--version",
          "shorthand": "-v",
          "description": "Specific version",
          "takesValue": true,
          "short": "-v"
        },
        {
          "name": "--source",
          "shorthand": "-s",
          "description": "Source (winget, msstore)",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--scope",
          "description": "Scope (user, machine)",
          "takesValue": true
        },
        {
          "name": "--architecture",
          "shorthand": "-a",
          "description": "Architecture (x64, x86, arm64)",
          "takesValue": true,
          "short": "-a"
        },
        {
          "name": "--interactive",
          "shorthand": "-i",
          "description": "Interactive install",
          "short": "-i"
        },
        {
          "name": "--silent",
          "shorthand": "-h",
          "description": "Silent install",
          "short": "-h"
        },
        {
          "name": "--accept-package-agreements",
          "description": "Accept agreements"
        },
        {
          "name": "--accept-source-agreements",
          "description": "Accept source agreements"
        },
        {
          "name": "--override",
          "shorthand": "-o",
          "description": "Override install arguments",
          "takesValue": true,
          "short": "-o"
        },
        {
          "name": "--location",
          "shorthand": "-l",
          "description": "Install location",
          "takesValue": true,
          "short": "-l"
        },
        {
          "name": "--force",
          "description": "Force install"
        },
        {
          "name": "--header",
          "description": "Custom REST header",
          "takesValue": true
        }
      ],
      "examples": [
        "winget install query"
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall a package",
      "args": [
        {
          "name": "query",
          "description": "Package name or ID",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--id",
          "description": "Package ID",
          "takesValue": true
        },
        {
          "name": "--version",
          "shorthand": "-v",
          "description": "Version",
          "takesValue": true,
          "short": "-v"
        },
        {
          "name": "--silent",
          "description": "Silent uninstall"
        },
        {
          "name": "--force",
          "description": "Force uninstall"
        },
        {
          "name": "--purge",
          "description": "Remove data and directories"
        }
      ],
      "examples": [
        "winget uninstall query"
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade packages",
      "args": [
        {
          "name": "query",
          "description": "Package (or --all)",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--all",
          "description": "Upgrade all packages"
        },
        {
          "name": "--id",
          "description": "Package ID",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Target version",
          "takesValue": true
        },
        {
          "name": "--silent",
          "description": "Silent upgrade"
        },
        {
          "name": "--include-unknown",
          "description": "Include packages with unknown versions"
        },
        {
          "name": "--accept-package-agreements",
          "description": "Accept agreements"
        },
        {
          "name": "--accept-source-agreements",
          "description": "Accept source agreements"
        }
      ],
      "examples": [
        "winget upgrade query"
      ]
    },
    {
      "name": "search",
      "description": "Search for packages",
      "args": [
        {
          "name": "query",
          "description": "Search term",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--id",
          "description": "Filter by ID",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Filter by name",
          "takesValue": true
        },
        {
          "name": "--tag",
          "description": "Filter by tag",
          "takesValue": true
        },
        {
          "name": "--source",
          "shorthand": "-s",
          "description": "Source",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--count",
          "shorthand": "-n",
          "description": "Max results",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--exact",
          "shorthand": "-e",
          "description": "Exact match",
          "short": "-e"
        }
      ],
      "examples": [
        "winget search query"
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        {
          "name": "--id",
          "description": "Filter by ID",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Filter by name",
          "takesValue": true
        },
        {
          "name": "--source",
          "shorthand": "-s",
          "description": "Source",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--upgrade-available",
          "description": "Show only upgradable"
        }
      ],
      "examples": [
        "winget list"
      ]
    },
    {
      "name": "show",
      "description": "Show package details",
      "args": [
        {
          "name": "query",
          "description": "Package identifier",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--versions",
          "description": "Show all versions"
        }
      ],
      "examples": [
        "winget show query"
      ]
    },
    {
      "name": "source",
      "description": "Manage sources",
      "subcommands": [
        {
          "name": "add",
          "description": "Add source",
          "options": [
            {
              "name": "--name",
              "description": "Source name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            },
            {
              "name": "--arg",
              "description": "Source URL",
              "type": "string",
              "takesValue": true,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--type",
              "description": "Source type",
              "type": "string",
              "takesValue": true
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Name for the source",
              "required": true,
              "type": "string"
            },
            {
              "name": "url",
              "description": "Source URL",
              "required": true,
              "type": "url"
            }
          ],
          "examples": [
            "winget source add name https://example.com"
          ]
        },
        {
          "name": "remove",
          "description": "Remove source",
          "options": [
            {
              "name": "--name",
              "description": "Source name",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "name",
              "description": "Source to remove",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "winget source remove name"
          ]
        },
        {
          "name": "list",
          "description": "List sources",
          "options": [
            {
              "name": "--name",
              "description": "Only this source",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "examples": [
            "winget source list"
          ]
        },
        {
          "name": "update",
          "description": "Update sources",
          "options": [
            {
              "name": "--name",
              "description": "Only this source",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "examples": [
            "winget source update"
          ]
        },
        {
          "name": "reset",
          "description": "Reset sources",
          "options": [
            {
              "name": "--name",
              "description": "Only this source",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            },
            {
              "name": "--force",
              "description": "Proceed without confirmation",
              "type": "boolean",
              "takesValue": false,
              "short": "-f",
              "shorthand": "-f"
            }
          ],
          "examples": [
            "winget source reset"
          ]
        },
        {
          "name": "export",
          "description": "Export sources",
          "options": [
            {
              "name": "--name",
              "description": "Only this source",
              "type": "string",
              "takesValue": true,
              "short": "-n",
              "shorthand": "-n"
            }
          ],
          "args": [
            {
              "name": "file",
              "description": "File to write the source list to",
              "required": false,
              "type": "file"
            }
          ],
          "examples": [
            "winget source export file.txt"
          ]
        }
      ]
    },
    {
      "name": "settings",
      "description": "Open settings (JSON)",
      "options": [
        {
          "name": "--enable",
          "description": "Enable an admin setting",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--disable",
          "description": "Disable an admin setting",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "winget settings"
      ]
    },
    {
      "name": "features",
      "description": "Show experimental features",
      "options": [],
      "examples": [
        "winget features"
      ]
    },
    {
      "name": "export",
      "description": "Export installed packages to JSON",
      "options": [
        {
          "name": "-o",
          "description": "Output file",
          "takesValue": true
        },
        {
          "name": "--source",
          "description": "Source",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "File to write the package list to",
          "required": true,
          "type": "file"
        }
      ],
      "examples": [
        "winget export file.txt"
      ]
    },
    {
      "name": "import",
      "description": "Import packages from JSON",
      "args": [
        {
          "name": "file",
          "description": "Import file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--import-file",
          "description": "Package list to import",
          "type": "file",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--ignore-unavailable",
          "description": "Skip packages that cannot be found",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ignore-versions",
          "description": "Install the latest version instead",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--accept-package-agreements",
          "description": "Accept package agreements",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "winget import file"
      ]
    },
    {
      "name": "pin",
      "description": "Manage package pins",
      "subcommands": [
        {
          "name": "add",
          "description": "Add pin",
          "options": [
            {
              "name": "--id",
              "description": "Package identifier",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--version",
              "description": "Version to pin",
              "type": "string",
              "takesValue": true,
              "short": "-v",
              "shorthand": "-v"
            },
            {
              "name": "--blocking",
              "description": "Block upgrades entirely",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--force",
              "description": "Overwrite an existing pin",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "package",
              "description": "Package to pin",
              "required": true,
              "type": "package",
              "completion": {
                "detector": "installed"
              }
            }
          ],
          "examples": [
            "winget pin add Git.Git"
          ]
        },
        {
          "name": "remove",
          "description": "Remove pin",
          "options": [
            {
              "name": "--id",
              "description": "Package identifier",
              "type": "string",
              "takesValue": true
            }
          ],
          "args": [
            {
              "name": "package",
              "description": "Package to unpin",
              "required": true,
              "type": "package",
              "completion": {
                "detector": "installed"
              }
            }
          ],
          "examples": [
            "winget pin remove Git.Git"
          ]
        },
        {
          "name": "list",
          "description": "List pins",
          "options": [
            {
              "name": "--id",
              "description": "Only this package",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "winget pin list"
          ]
        },
        {
          "name": "reset",
          "description": "Reset pins",
          "options": [
            {
              "name": "--force",
              "description": "Proceed without confirmation",
              "type": "boolean",
              "takesValue": false,
              "short": "-f",
              "shorthand": "-f"
            }
          ],
          "examples": [
            "winget pin reset"
          ]
        }
      ]
    },
    {
      "name": "repair",
      "description": "Repair package installations",
      "options": [
        {
          "name": "--id",
          "description": "Package identifier",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--silent",
          "description": "Run without UI",
          "type": "boolean",
          "takesValue": false,
          "short": "-h",
          "shorthand": "-h"
        }
      ],
      "examples": [
        "winget repair"
      ]
    },
    {
      "name": "download",
      "description": "Download installer",
      "options": [
        {
          "name": "--id",
          "description": "Package identifier",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--download-directory",
          "description": "Directory to save into",
          "type": "directory",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--architecture",
          "description": "Architecture to download",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--skip-dependencies",
          "description": "Do not download dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to download",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "examples": [
        "winget download Git.Git"
      ]
    },
    {
      "name": "configure",
      "description": "Configure winget",
      "options": [
        {
          "name": "--file",
          "description": "Configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--accept-configuration-agreements",
          "description": "Accept the configuration agreements",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Print more detail",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "winget configure"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "description": "Verbose output"
    },
    {
      "name": "--disable-interactivity",
      "description": "Disable interactive prompts"
    },
    {
      "name": "--help",
      "shorthand": "-?",
      "description": "Show help",
      "short": "-?"
    },
    {
      "name": "--version",
      "description": "Show version"
    },
    {
      "name": "--info",
      "description": "Show system info"
    }
  ],
  "examples": [
    {
      "command": "winget install Git.Git",
      "description": "Install Git"
    },
    {
      "command": "winget install -e --id Microsoft.VisualStudioCode",
      "description": "Install VS Code by exact ID"
    },
    {
      "command": "winget install Python.Python.3.12 --silent",
      "description": "Silent install"
    },
    {
      "command": "winget upgrade --all",
      "description": "Upgrade all packages"
    },
    {
      "command": "winget search nodejs",
      "description": "Search for Node.js"
    },
    {
      "command": "winget list",
      "description": "List installed packages"
    },
    {
      "command": "winget list --upgrade-available",
      "description": "Show upgradable"
    },
    {
      "command": "winget show Git.Git",
      "description": "Package details"
    },
    {
      "command": "winget uninstall Git.Git",
      "description": "Uninstall Git"
    },
    {
      "command": "winget export -o packages.json",
      "description": "Export package list"
    },
    {
      "command": "winget import packages.json",
      "description": "Import packages"
    }
  ],
  "relatedCommands": [
    "choco",
    "scoop"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed",
        "description": "Installed packages",
        "command": "winget list 2>$null | Select-Object -Last 20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "winget"
      },
      {
        "name": "upgradable",
        "description": "Upgradable packages",
        "command": "winget list --upgrade-available 2>$null | Select-Object -Last 15",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "winget"
      },
      {
        "name": "sources",
        "description": "Configured sources",
        "command": "winget source list 2>$null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "winget"
      }
    ]
  }
}
