{
  "name": "conda",
  "description": "Conda package, dependency, and environment management for any language",
  "category": "python-ecosystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "create",
      "description": "Create a new environment",
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Environment name",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--prefix",
          "shorthand": "-p",
          "description": "Environment path",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--file",
          "description": "Environment file",
          "takesValue": true
        },
        {
          "name": "--channel",
          "shorthand": "-c",
          "description": "Channel",
          "takesValue": true,
          "short": "-c"
        },
        {
          "name": "--python",
          "description": "Python version",
          "takesValue": true
        }
      ]
    },
    {
      "name": "activate",
      "description": "Activate an environment",
      "args": [
        {
          "name": "environment",
          "description": "Environment name or path",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "deactivate",
      "description": "Deactivate current environment",
      "options": []
    },
    {
      "name": "install",
      "description": "Install packages",
      "args": [
        {
          "name": "packages",
          "description": "Packages to install",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Environment name",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--channel",
          "shorthand": "-c",
          "description": "Channel",
          "takesValue": true,
          "short": "-c"
        },
        {
          "name": "--file",
          "description": "Requirements file",
          "takesValue": true
        },
        {
          "name": "--force-reinstall",
          "description": "Force reinstall"
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove packages",
      "args": [
        {
          "name": "packages",
          "description": "Packages to remove",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Environment name",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--all",
          "description": "Remove entire environment"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update packages",
      "args": [
        {
          "name": "packages",
          "description": "Packages to update",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Environment name",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--all",
          "description": "Update all packages"
        }
      ]
    },
    {
      "name": "list",
      "description": "List installed packages",
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Environment name",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--export",
          "description": "Export format"
        },
        {
          "name": "--revisions",
          "description": "Show history"
        }
      ]
    },
    {
      "name": "search",
      "description": "Search for packages",
      "args": [
        {
          "name": "query",
          "description": "Search query",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--channel",
          "description": "Channel to search",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--info",
          "description": "Show full package metadata",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Platform to search for",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "info",
      "description": "Show conda information",
      "options": [
        {
          "name": "--envs",
          "shorthand": "-e",
          "description": "List environments",
          "short": "-e"
        },
        {
          "name": "--json",
          "description": "JSON output"
        }
      ]
    },
    {
      "name": "env",
      "description": "Manage environments",
      "subcommands": [
        {
          "name": "list",
          "description": "List environments",
          "options": [
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "create",
          "description": "Create environment from file",
          "options": [
            {
              "name": "--file",
              "shorthand": "-f",
              "description": "Environment file",
              "takesValue": true,
              "short": "-f"
            }
          ]
        },
        {
          "name": "remove",
          "description": "Remove environment",
          "options": [
            {
              "name": "--name",
              "shorthand": "-n",
              "description": "Environment name",
              "takesValue": true,
              "short": "-n"
            }
          ]
        },
        {
          "name": "export",
          "description": "Export environment",
          "options": [
            {
              "name": "--name",
              "shorthand": "-n",
              "description": "Environment name",
              "takesValue": true,
              "short": "-n"
            },
            {
              "name": "--file",
              "shorthand": "-f",
              "description": "Output file",
              "takesValue": true,
              "short": "-f"
            },
            {
              "name": "--from-history",
              "description": "Only explicitly requested packages"
            }
          ]
        },
        {
          "name": "update",
          "description": "Update environment from file",
          "options": [
            {
              "name": "--file",
              "shorthand": "-f",
              "description": "Environment file",
              "takesValue": true,
              "short": "-f"
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage configuration",
      "subcommands": [
        {
          "name": "--show",
          "description": "Show all config",
          "options": [
            {
              "name": "--json",
              "description": "Emit raw JSON",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "--set",
          "description": "Set a config value",
          "options": [
            {
              "name": "--env",
              "description": "Write to the active environment's config",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "--add",
          "description": "Add a config value",
          "options": [
            {
              "name": "--env",
              "description": "Write to the active environment's config",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "--remove",
          "description": "Remove a config value",
          "options": [
            {
              "name": "--env",
              "description": "Write to the active environment's config",
              "type": "boolean",
              "takesValue": false
            }
          ]
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean unused packages and caches",
      "options": [
        {
          "name": "--all",
          "shorthand": "-a",
          "description": "Remove all",
          "short": "-a"
        },
        {
          "name": "--packages",
          "shorthand": "-p",
          "description": "Remove unused packages",
          "short": "-p"
        },
        {
          "name": "--tarballs",
          "shorthand": "-t",
          "description": "Remove tarballs",
          "short": "-t"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a command in an environment",
      "args": [
        {
          "name": "command",
          "description": "Command to run",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Environment",
          "takesValue": true,
          "short": "-n"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet output",
      "short": "-q"
    },
    {
      "name": "--json",
      "description": "JSON output"
    },
    {
      "name": "--yes",
      "shorthand": "-y",
      "description": "Auto-confirm",
      "short": "-y"
    },
    {
      "name": "--dry-run",
      "description": "Preview changes"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-V",
      "description": "Show version",
      "short": "-V"
    }
  ],
  "examples": [
    {
      "command": "conda create -n myenv python=3.11",
      "description": "Create environment with Python 3.11"
    },
    {
      "command": "conda activate myenv",
      "description": "Activate environment"
    },
    {
      "command": "conda install numpy pandas",
      "description": "Install packages"
    },
    {
      "command": "conda env export > environment.yml",
      "description": "Export environment"
    },
    {
      "command": "conda env create -f environment.yml",
      "description": "Create from file"
    },
    {
      "command": "conda list",
      "description": "List installed packages"
    },
    {
      "command": "conda env list",
      "description": "List environments"
    }
  ],
  "relatedCommands": [
    "pip",
    "python",
    "poetry"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "environments",
        "description": "Conda environments",
        "command": "conda env list --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "conda"
      },
      {
        "name": "active_env",
        "description": "Currently active environment",
        "command": "echo $CONDA_DEFAULT_ENV 2>/dev/null",
        "parser": "text",
        "cacheFor": 10
      },
      {
        "name": "installed_packages",
        "description": "Installed packages in active env",
        "command": "conda list --no-banner 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "conda"
      },
      {
        "name": "environment_file",
        "description": "Environment definition file",
        "command": "cat environment.yml 2>/dev/null || cat environment.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 30
      },
      {
        "name": "channels",
        "description": "Configured channels",
        "command": "conda config --show channels 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "conda"
      }
    ]
  }
}
