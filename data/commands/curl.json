{
  "name": "curl",
  "description": "Transfer data from or to a server using various protocols",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--request",
      "short": "-X",
      "description": "HTTP method (GET, POST, PUT, DELETE, PATCH)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-X"
    },
    {
      "name": "--header",
      "short": "-H",
      "description": "Pass custom header",
      "type": "string",
      "takesValue": true,
      "shorthand": "-H"
    },
    {
      "name": "--data",
      "short": "-d",
      "description": "HTTP POST data",
      "type": "string",
      "takesValue": true,
      "shorthand": "-d"
    },
    {
      "name": "--data-raw",
      "description": "HTTP POST data (no special interpretation)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--form",
      "short": "-F",
      "description": "Multipart form data",
      "type": "string",
      "takesValue": true,
      "shorthand": "-F"
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Write output to file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--silent",
      "short": "-s",
      "description": "Silent mode",
      "shorthand": "-s"
    },
    {
      "name": "--show-error",
      "short": "-S",
      "description": "Show error even in silent mode",
      "shorthand": "-S"
    },
    {
      "name": "--location",
      "short": "-L",
      "description": "Follow redirects",
      "shorthand": "-L"
    },
    {
      "name": "--insecure",
      "short": "-k",
      "description": "Skip SSL verification",
      "shorthand": "-k"
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    },
    {
      "name": "--user",
      "short": "-u",
      "description": "User:password for authentication",
      "type": "string",
      "takesValue": true,
      "shorthand": "-u"
    },
    {
      "name": "--cookie",
      "short": "-b",
      "description": "Send cookies",
      "type": "string",
      "takesValue": true,
      "shorthand": "-b"
    },
    {
      "name": "--cookie-jar",
      "short": "-c",
      "description": "Write cookies to file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--max-time",
      "short": "-m",
      "description": "Maximum time in seconds",
      "type": "number",
      "takesValue": true,
      "shorthand": "-m"
    },
    {
      "name": "--connect-timeout",
      "description": "Connection timeout in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--retry",
      "description": "Number of retries",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--upload-file",
      "short": "-T",
      "description": "Upload a file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-T"
    },
    {
      "name": "--compressed",
      "description": "Request compressed response"
    },
    {
      "name": "--write-out",
      "short": "-w",
      "description": "Define output format",
      "type": "string",
      "takesValue": true,
      "shorthand": "-w"
    },
    {
      "name": "--head",
      "short": "-I",
      "description": "Show headers only",
      "shorthand": "-I"
    },
    {
      "name": "--proxy",
      "short": "-x",
      "description": "Use proxy",
      "type": "url",
      "takesValue": true,
      "shorthand": "-x"
    },
    {
      "name": "--cert",
      "short": "-E",
      "description": "Client certificate file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-E"
    },
    {
      "name": "--cacert",
      "description": "CA certificate",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--data-binary",
      "description": "Request body, no newline translation",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--data-urlencode",
      "description": "URL-encode this field",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--json",
      "description": "Send the body as JSON and set the headers",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--remote-name",
      "description": "Save using the remote filename",
      "type": "boolean",
      "takesValue": false,
      "short": "-O",
      "shorthand": "-O"
    },
    {
      "name": "--max-redirs",
      "description": "Redirect limit",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--fail",
      "description": "Exit non-zero on an HTTP error",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--fail-with-body",
      "description": "Fail but still write the body",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--include",
      "description": "Include the response headers",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--trace",
      "description": "Write a full trace here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--oauth2-bearer",
      "description": "Bearer token to send",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--key",
      "description": "Client private key",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--retry-delay",
      "description": "Seconds between retries",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--retry-all-errors",
      "description": "Retry on any error, not just transient ones",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--resolve",
      "description": "Pin a host to an address, host:port:addr",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--interface",
      "description": "Network interface to bind to",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--limit-rate",
      "description": "Cap the transfer rate, e.g. 200k",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--range",
      "description": "Byte range to fetch",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--continue-at",
      "description": "Resume from this offset, or - to detect",
      "type": "string",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--http2",
      "description": "Use HTTP/2",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--http3",
      "description": "Use HTTP/3",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--ipv4",
      "description": "Resolve names to IPv4 only",
      "type": "boolean",
      "takesValue": false,
      "short": "-4",
      "shorthand": "-4"
    },
    {
      "name": "--ipv6",
      "description": "Resolve names to IPv6 only",
      "type": "boolean",
      "takesValue": false,
      "short": "-6",
      "shorthand": "-6"
    },
    {
      "name": "--parallel",
      "description": "Run the given transfers in parallel",
      "type": "boolean",
      "takesValue": false,
      "short": "-Z",
      "shorthand": "-Z"
    },
    {
      "name": "--config",
      "description": "Read arguments from this file",
      "type": "file",
      "takesValue": true,
      "short": "-K",
      "shorthand": "-K"
    },
    {
      "name": "--url",
      "description": "URL to work with",
      "type": "url",
      "takesValue": true
    },
    {
      "name": "--referer",
      "description": "Referer header to send",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--user-agent",
      "description": "User-Agent header to send",
      "type": "string",
      "takesValue": true,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--netrc",
      "description": "Read credentials from .netrc",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    }
  ],
  "examples": [
    "curl https://api.example.com/data",
    "curl -X POST -H 'Content-Type: application/json' -d '{\"key\":\"value\"}' https://api.example.com/resource",
    "curl -sS -o output.html https://example.com",
    "curl -L -O https://example.com/file.tar.gz",
    "curl -u user:pass https://api.example.com/private",
    "curl -I https://example.com",
    "curl -F 'file=@photo.jpg' https://api.example.com/upload"
  ],
  "relatedCommands": [
    "wget",
    "httpie",
    "http"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "curl version and protocols",
        "command": "curl --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "curl"
      },
      {
        "name": "proxy",
        "description": "Proxy configuration in effect",
        "command": "echo \"http=${http_proxy:-unset} https=${https_proxy:-unset} no=${no_proxy:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "rc_file",
        "description": "Default curl options from .curlrc",
        "command": "cat ~/.curlrc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "ca_bundle",
        "description": "CA bundle curl will verify against",
        "command": "curl-config --ca 2>/dev/null || echo \"${CURL_CA_BUNDLE:-system default}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
