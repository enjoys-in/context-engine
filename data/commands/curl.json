{
  "name": "curl",
  "description": "Transfer data from or to a server using various protocols",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--request",
      "short": "-X",
      "description": "HTTP method (GET, POST, PUT, DELETE, PATCH)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-X"
    },
    {
      "name": "--header",
      "short": "-H",
      "description": "Pass custom header",
      "type": "string",
      "takesValue": true,
      "shorthand": "-H"
    },
    {
      "name": "--data",
      "short": "-d",
      "description": "HTTP POST data",
      "type": "string",
      "takesValue": true,
      "shorthand": "-d"
    },
    {
      "name": "--data-raw",
      "description": "HTTP POST data (no special interpretation)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--form",
      "short": "-F",
      "description": "Multipart form data",
      "type": "string",
      "takesValue": true,
      "shorthand": "-F"
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Write output to file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--silent",
      "short": "-s",
      "description": "Silent mode",
      "shorthand": "-s"
    },
    {
      "name": "--show-error",
      "short": "-S",
      "description": "Show error even in silent mode",
      "shorthand": "-S"
    },
    {
      "name": "--location",
      "short": "-L",
      "description": "Follow redirects",
      "shorthand": "-L"
    },
    {
      "name": "--insecure",
      "short": "-k",
      "description": "Skip SSL verification",
      "shorthand": "-k"
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    },
    {
      "name": "--user",
      "short": "-u",
      "description": "User:password for authentication",
      "type": "string",
      "takesValue": true,
      "shorthand": "-u"
    },
    {
      "name": "--cookie",
      "short": "-b",
      "description": "Send cookies",
      "type": "string",
      "takesValue": true,
      "shorthand": "-b"
    },
    {
      "name": "--cookie-jar",
      "short": "-c",
      "description": "Write cookies to file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--max-time",
      "short": "-m",
      "description": "Maximum time in seconds",
      "type": "number",
      "takesValue": true,
      "shorthand": "-m"
    },
    {
      "name": "--connect-timeout",
      "description": "Connection timeout in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--retry",
      "description": "Number of retries",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--upload-file",
      "short": "-T",
      "description": "Upload a file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-T"
    },
    {
      "name": "--compressed",
      "description": "Request compressed response"
    },
    {
      "name": "--write-out",
      "short": "-w",
      "description": "Define output format",
      "type": "string",
      "takesValue": true,
      "shorthand": "-w"
    },
    {
      "name": "--head",
      "short": "-I",
      "description": "Show headers only",
      "shorthand": "-I"
    },
    {
      "name": "--proxy",
      "short": "-x",
      "description": "Use proxy",
      "type": "url",
      "takesValue": true,
      "shorthand": "-x"
    },
    {
      "name": "--cert",
      "short": "-E",
      "description": "Client certificate file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-E"
    },
    {
      "name": "--cacert",
      "description": "CA certificate",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    "curl https://api.example.com/data",
    "curl -X POST -H 'Content-Type: application/json' -d '{\"key\":\"value\"}' https://api.example.com/resource",
    "curl -sS -o output.html https://example.com",
    "curl -L -O https://example.com/file.tar.gz",
    "curl -u user:pass https://api.example.com/private",
    "curl -I https://example.com",
    "curl -F 'file=@photo.jpg' https://api.example.com/upload"
  ],
  "relatedCommands": [
    "wget",
    "httpie",
    "http"
  ]
}
