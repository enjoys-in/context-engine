{
  "language": "html",
  "name": "html-validate",
  "description": "HTML validation, formatting, and linting tools",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Path to configuration file"
    },
    {
      "name": "--formatter",
      "description": "Output formatter (stylish, json, codeframe)"
    },
    {
      "name": "--max-warnings",
      "description": "Max number of warnings before failing"
    },
    {
      "name": "--ext",
      "description": "File extensions to process (default: .html)"
    },
    {
      "name": "--ignore-path",
      "description": "Path to ignore file"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    }
  ],
  "subcommands": [
    {
      "name": "validate",
      "description": "Validate HTML files for standards compliance",
      "args": [
        {
          "name": "files",
          "description": "HTML documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--config",
          "description": "Path to the configuration file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--formatter",
          "description": "Output formatter (stylish, json, checkstyle)",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "npx html-validate index.html",
        "npx html-validate 'src/**/*.html' --formatter stylish"
      ]
    },
    {
      "name": "lint",
      "description": "Lint HTML files for common errors",
      "args": [
        {
          "name": "files",
          "description": "HTML documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--rule",
          "description": "Enable or configure a single rule",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--fix",
          "description": "Apply automatic fixes where possible",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npx html-validate 'src/**/*.html'"
      ]
    },
    {
      "name": "format",
      "description": "Format HTML files with Prettier",
      "args": [
        {
          "name": "files",
          "description": "HTML documents to process",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--write",
          "description": "Write formatted output back to the file",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--tab-width",
          "description": "Number of spaces per indent level",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "npx prettier --write 'src/**/*.html'"
      ]
    },
    {
      "name": "minify",
      "description": "Minify HTML files using html-minifier-terser",
      "args": [
        {
          "name": "file",
          "description": "HTML document to minify",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--collapse-whitespace",
          "description": "Collapse runs of whitespace when minifying",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--remove-comments",
          "description": "Strip comments when minifying",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npx html-minifier-terser --collapse-whitespace --minify-css -o dist/index.html index.html"
      ]
    },
    {
      "name": "serve",
      "description": "Serve HTML files with a local dev server",
      "args": [
        {
          "name": "directory",
          "description": "Directory to serve",
          "type": "directory",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port to serve on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--open",
          "description": "Open the page in a browser after starting",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npx http-server . -p 8080",
        "npx serve ."
      ]
    },
    {
      "name": "init",
      "description": "Initialize html-validate configuration",
      "args": [],
      "options": [
        {
          "name": "--config",
          "description": "Path for the generated configuration",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "npx html-validate --init"
      ]
    }
  ],
  "examples": [
    "npx html-validate index.html",
    "npx html-validate 'src/**/*.html' --formatter stylish",
    "npx prettier --write --parser html '**/*.html'",
    "npx html-minifier-terser --collapse-whitespace --remove-comments index.html -o index.min.html",
    "npx serve ./public --port 3000"
  ],
  "relatedCommands": [
    "prettier",
    "css",
    "javascript",
    "eslint"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "html-validate version",
        "command": "html-validate --version 2>/dev/null || npx html-validate --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "html-validate configuration",
        "command": "cat .htmlvalidate.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "documents",
        "description": "HTML documents in this project",
        "command": "find . -maxdepth 3 -name '*.html' -not -path './node_modules/*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  },
  "aliases": [
    "html"
  ]
}
