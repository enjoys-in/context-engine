{
  "name": "xcrun",
  "description": "Locate and run Xcode developer tools",
  "category": "mobile",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "simctl",
      "description": "Control the iOS, watchOS and tvOS simulators"
    },
    {
      "name": "altool",
      "description": "Validate and upload apps to App Store Connect (legacy)"
    },
    {
      "name": "notarytool",
      "description": "Submit and check notarisation requests"
    },
    {
      "name": "stapler",
      "description": "Attach a notarisation ticket to a bundle"
    },
    {
      "name": "swift",
      "description": "Run the Swift toolchain"
    },
    {
      "name": "xctrace",
      "description": "Record and inspect Instruments traces"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--find",
      "description": "Print the path of a tool",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--run",
      "description": "Run the named tool",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--sdk",
      "description": "SDK to resolve against",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--toolchain",
      "description": "Toolchain to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show-sdk-path",
      "description": "Print the SDK path",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-sdk-version",
      "description": "Print the SDK version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-sdk-platform-path",
      "description": "Print the SDK platform path",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log",
      "description": "Log the command that is run",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "xcrun --find clang",
      "description": "Locate a developer tool"
    },
    {
      "command": "xcrun simctl list devices",
      "description": "List the simulators"
    },
    {
      "command": "xcrun --sdk iphoneos --show-sdk-path",
      "description": "Print an SDK path"
    },
    {
      "command": "xcrun notarytool submit app.zip --keychain-profile prof",
      "description": "Submit a build for notarisation"
    }
  ],
  "relatedCommands": [
    "xcodebuild",
    "simctl",
    "swift",
    "fastlane",
    "pod"
  ]
}
