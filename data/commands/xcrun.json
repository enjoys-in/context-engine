{
  "name": "xcrun",
  "description": "Locate and run Xcode developer tools",
  "category": "mobile",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "simctl",
      "description": "Control the iOS, watchOS and tvOS simulators",
      "options": [
        {
          "name": "--sdk",
          "description": "SDK to resolve the tool from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--toolchain",
          "description": "Toolchain to resolve the tool from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--find",
          "description": "Print the tool path without running it",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--log",
          "description": "Log the command being run",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
