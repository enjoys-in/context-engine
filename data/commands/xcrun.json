          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--find",
      "description": "Print the path of a tool",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--run",
      "description": "Run the named tool",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--sdk",
      "description": "SDK to resolve against",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--toolchain",
      "description": "Toolchain to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show-sdk-path",
      "description": "Print the SDK path",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-sdk-version",
      "description": "Print the SDK version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-sdk-platform-path",
      "description": "Print the SDK platform path",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--log",
      "description": "Log the command that is run",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "xcrun --find clang",
      "description": "Locate a developer tool"
    },
    {
      "command": "xcrun simctl list devices",
      "description": "List the simulators"
    },
    {
      "command": "xcrun --sdk iphoneos --show-sdk-path",
      "description": "Print an SDK path"
    },
    {
      "command": "xcrun notarytool submit app.zip --keychain-profile prof",
      "description": "Submit a build for notarisation"
    }
  ],
  "relatedCommands": [
    "xcodebuild",
    "simctl",
    "swift",
    "fastlane",
    "pod"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Xcode version and build",
        "command": "xcodebuild -version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "developer_dir",
        "description": "Active Xcode developer directory",
        "command": "xcode-select -p 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "sdks",
        "description": "SDKs available to xcrun",
        "command": "xcodebuild -showsdks 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 3600
      },
      {
        "name": "projects",
        "description": "Xcode projects and workspaces here",
        "command": "ls -d *.xcodeproj *.xcworkspace 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
