{
  "name": "ocaml",
  "description": "OCaml programming language compiler and toplevel",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Compile only (produce .cmo/.cmi)"
    },
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-I",
      "description": "Add include directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-g",
      "description": "Include debug info"
    },
    {
      "name": "-O",
      "description": "Optimize"
    },
    {
      "name": "-pp",
      "description": "Preprocessor",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-thread",
      "description": "Enable threading"
    },
    {
      "name": "-rectypes",
      "description": "Allow recursive types"
    }
  ],
  "examples": [
    "ocaml",
    "ocaml script.ml",
    "ocamlfind ocamlopt -package core -linkpkg main.ml -o main",
    "ocamlopt -o hello hello.ml",
    "dune build",
    "dune exec ./main.exe"
  ],
  "relatedCommands": [
    "opam",
    "dune",
    "ocamlfind",
    "utop"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "OCaml compiler version",
        "command": "ocaml -version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ocaml"
      },
      {
        "name": "switch",
        "description": "Active opam switch",
        "command": "opam switch show 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "opam"
      },
      {
        "name": "dune_project",
        "description": "Dune project definition",
        "command": "cat dune-project 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "sources",
        "description": "OCaml sources",
        "command": "find . -maxdepth 3 -name '*.ml' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
