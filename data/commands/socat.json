{
  "name": "socat",
  "description": "Multipurpose relay — bidirectional data transfer",
  "category": "networking",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Increase verbosity (use -d -d for more)"
    },
    {
      "name": "-v",
      "description": "Write data to stderr"
    },
    {
      "name": "-t",
      "description": "Timeout for second address",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "socat TCP-LISTEN:8080,fork TCP:remote:80",
    "socat - TCP:host:port",
    "socat TCP-LISTEN:1234 EXEC:/bin/bash",
    "socat UNIX-LISTEN:/tmp/sock,fork TCP:localhost:8080",
    "socat TCP-LISTEN:443,fork OPENSSL:remote:443"
  ],
  "relatedCommands": [
    "nc",
    "ssh",
    "ncat",
    "stunnel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "socat version",
        "command": "socat -V 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "socat"
      },
      {
        "name": "listening",
        "description": "Ports listening on this host",
        "command": "ss -tlnp 2>/dev/null | head -20 || netstat -an 2>/dev/null | grep LISTEN | head -20",
        "parser": "table",
        "cacheFor": 30
      }
    ]
  }
}
