{
  "name": "gunzip",
  "description": "Expand files compressed with gzip",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--list",
      "description": "Show the archive contents",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--recursive",
      "description": "Descend into directories",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--verbose",
      "description": "Report each file",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "gunzip archive.gz",
      "description": "Expand in place"
    },
    {
      "command": "gunzip -c archive.gz > out",
      "description": "Expand to stdout"
    },
    {
      "command": "gunzip -t archive.gz",
      "description": "Verify without extracting"
    }
  ],
  "relatedCommands": [
    "gzip",
    "tar",
    "zcat"
  ]
}
