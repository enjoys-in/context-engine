{
  "name": "pulumi",
  "description": "Infrastructure as Code using real programming languages (TypeScript, Python, Go, C#, Java)",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create a new Pulumi project",
      "args": [
        {
          "name": "template",
          "description": "Template name",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--name",
          "shorthand": "-n",
          "description": "Project name",
          "takesValue": true,
          "short": "-n"
        },
        {
          "name": "--dir",
          "description": "Target directory",
          "takesValue": true
        },
        {
          "name": "--description",
          "shorthand": "-d",
          "description": "Project description",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--stack",
          "shorthand": "-s",
          "description": "Stack name",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--yes",
          "shorthand": "-y",
          "description": "Skip prompts",
          "short": "-y"
        },
        {
          "name": "--force",
          "shorthand": "-f",
          "description": "Force create in non-empty dir",
          "short": "-f"
        }
      ]
    },
    {
      "name": "up",
      "description": "Create or update resources",
      "options": [
        {
          "name": "--stack",
          "shorthand": "-s",
          "description": "Stack name",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--yes",
          "shorthand": "-y",
          "description": "Skip confirmation",
          "short": "-y"
        },
        {
          "name": "--parallel",
          "shorthand": "-p",
          "description": "Parallelism",
          "takesValue": true,
          "short": "-p"
        },
        {
          "name": "--refresh",
          "shorthand": "-r",
          "description": "Refresh state first",
          "short": "-r"
        },
        {
          "name": "--target",
          "shorthand": "-t",
          "description": "Target specific resources",
          "takesValue": true,
          "short": "-t"
        },
        {
          "name": "--diff",
          "description": "Show detailed diff"
        },
        {
          "name": "--replace",
          "description": "Force replace resource",
          "takesValue": true
        }
      ]
    },
    {
      "name": "preview",
      "description": "Show preview of updates",
      "options": [
        {
          "name": "--stack",
          "shorthand": "-s",
          "description": "Stack name",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--diff",
          "description": "Show detailed diff"
        },
        {
          "name": "--json",
          "shorthand": "-j",
          "description": "JSON output",
          "short": "-j"
        }
      ]
    },
    {
      "name": "destroy",
      "description": "Destroy all resources",
      "options": [
        {
          "name": "--stack",
          "shorthand": "-s",
          "description": "Stack name",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--yes",
          "shorthand": "-y",
          "description": "Skip confirmation",
          "short": "-y"
        },
        {
          "name": "--target",
          "shorthand": "-t",
          "description": "Target specific resources",
          "takesValue": true,
          "short": "-t"
        }
      ]
    },
    {
      "name": "stack",
      "description": "Manage stacks",
      "subcommands": [
        {
          "name": "init",
          "description": "Create new stack",
          "args": [
            {
              "name": "name",
              "description": "Stack name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--secrets-provider",
              "description": "Secrets provider to use",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--copy-config-from",
              "description": "Copy configuration from this stack",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--non-interactive",
              "description": "Do not prompt",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "ls",
          "description": "List stacks",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--all",
              "description": "Include every organisation",
              "type": "boolean",
              "takesValue": false,
              "short": "-a",
              "shorthand": "-a"
            },
            {
              "name": "--organization",
              "description": "Organisation to list",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            }
          ]
        },
        {
          "name": "select",
          "description": "Switch stack",
          "args": [
            {
              "name": "name",
              "description": "Stack name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--create",
              "description": "Create the stack if missing",
              "type": "boolean",
              "takesValue": false,
              "short": "-c",
              "shorthand": "-c"
            },
            {
              "name": "--secrets-provider",
              "description": "Secrets provider to use",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "rm",
          "description": "Remove a stack",
          "options": [
            {
              "name": "--force",
              "description": "Remove even with resources",
              "type": "boolean",
              "takesValue": false,
              "short": "-f",
              "shorthand": "-f"
            },
            {
              "name": "--yes",
              "description": "Skip confirmation",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            },
            {
              "name": "--preserve-config",
              "description": "Keep the configuration file",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "stack",
              "description": "Stack to remove",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "name": "output",
          "description": "Show stack outputs",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--show-secrets",
              "description": "Reveal secret outputs",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--stack",
              "description": "Stack to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            }
          ]
        },
        {
          "name": "export",
          "description": "Export stack state",
          "options": [
            {
              "name": "--file",
              "description": "File to write",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--show-secrets",
              "description": "Include secret values",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--version",
              "description": "Checkpoint version",
              "type": "string",
              "takesValue": true
            }
          ]
        },
        {
          "name": "import",
          "description": "Import stack state",
          "options": [
            {
              "name": "--file",
              "description": "File to read",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--force",
              "description": "Import despite integrity errors",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "tag",
          "description": "Manage stack tags",
          "options": [
            {
              "name": "--stack",
              "description": "Stack to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            }
          ]
        },
        {
          "name": "history",
          "description": "Show update history",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--show-secrets",
              "description": "Reveal secret values",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--page-size",
              "description": "Entries per page",
              "type": "integer",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage configuration",
      "subcommands": [
        {
          "name": "set",
          "description": "Set config value",
          "options": [
            {
              "name": "--secret",
              "description": "Store the value encrypted",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--path",
              "description": "Treat the key as a path",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--stack",
              "description": "Stack to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--plaintext",
              "description": "Store the value in plain text",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "key",
              "description": "Configuration key to set",
              "required": true,
              "type": "string"
            },
            {
              "name": "value",
              "description": "Value to set",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "name": "get",
          "description": "Get config value",
          "options": [
            {
              "name": "--path",
              "description": "Treat the key as a path",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--stack",
              "description": "Stack to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            },
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "key",
              "description": "Configuration key to read",
              "required": true,
              "type": "string"
            }
          ]
        },
        {
          "name": "rm",
          "description": "Remove config key",
          "options": [
            {
              "name": "--path",
              "description": "Treat the key as a path",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--stack",
              "description": "Stack to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            }
          ],
          "args": [
            {
              "name": "key",
              "description": "Configuration key to remove",
              "required": true,
              "type": "string"
            }
          ]
        },
        {
          "name": "refresh",
          "description": "Update config from current values",
          "options": [
            {
              "name": "--force",
              "description": "Overwrite local changes",
              "type": "boolean",
              "takesValue": false,
              "short": "-f",
              "shorthand": "-f"
            },
            {
              "name": "--stack",
              "description": "Stack to operate on",
              "type": "string",
              "takesValue": true,
              "short": "-s",
              "shorthand": "-s"
            }
          ]
        }
      ]
    },
    {
      "name": "refresh",
      "description": "Refresh state with actual cloud state",
      "options": [
        {
          "name": "--yes",
          "description": "Skip confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--skip-preview",
          "description": "Do not show a preview",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--stack",
          "description": "Stack to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--target",
          "description": "Only these resource URNs",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--parallel",
          "description": "Parallel resource operations",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "import",
      "description": "Import existing resource",
      "options": [
        {
          "name": "--file",
          "description": "Bulk import file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--out",
          "description": "Write generated code here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Skip confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--protect",
          "description": "Mark imported resources protected",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "type",
          "description": "Resource type token to import",
          "required": false,
          "type": "string"
        },
        {
          "name": "name",
          "description": "Name for the imported resource",
          "required": false,
          "type": "string"
        },
        {
          "name": "id",
          "description": "Provider id of the existing resource",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "cancel",
      "description": "Cancel in-progress update",
      "options": [
        {
          "name": "--yes",
          "description": "Skip confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--stack",
          "description": "Stack to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "login",
      "description": "Login to Pulumi Cloud",
      "options": [
        {
          "name": "--local",
          "shorthand": "-l",
          "description": "Use local backend",
          "short": "-l"
        }
      ]
    },
    {
      "name": "logout",
      "description": "Logout from Pulumi Cloud",
      "options": [
        {
          "name": "--all",
          "description": "Log out of every backend",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--local",
          "description": "Log out of the local backend",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "whoami",
      "description": "Show current user",
      "options": [
        {
          "name": "--verbose",
          "description": "Include organisation detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "plugin",
      "description": "Plugin management",
      "subcommands": [
        {
          "name": "install",
          "description": "Install plugin",
          "options": [
            {
              "name": "--exact",
              "description": "Install exactly this version",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--file",
              "description": "Install from this file",
              "type": "file",
              "takesValue": true,
              "short": "-f",
              "shorthand": "-f"
            },
            {
              "name": "--reinstall",
              "description": "Reinstall even if present",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "kind",
              "description": "Plugin kind: resource, analyzer or language",
              "required": false,
              "type": "string"
            },
            {
              "name": "name",
              "description": "Plugin name",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "name": "ls",
          "description": "List plugins",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--project",
              "description": "Only plugins used by this project",
              "type": "boolean",
              "takesValue": false,
              "short": "-p",
              "shorthand": "-p"
            }
          ]
        },
        {
          "name": "rm",
          "description": "Remove plugin",
          "options": [
            {
              "name": "--all",
              "description": "Remove every version",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--yes",
              "description": "Skip confirmation",
              "type": "boolean",
              "takesValue": false,
              "short": "-y",
              "shorthand": "-y"
            }
          ],
          "args": [
            {
              "name": "kind",
              "description": "Plugin kind to remove",
              "required": false,
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "name": "watch",
      "description": "Watch for file changes and update",
      "options": [
        {
          "name": "--stack",
          "description": "Stack to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--path",
          "description": "Paths to watch",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--secrets-provider",
          "description": "Secrets provider to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "logs",
      "description": "Show aggregated logs",
      "options": [
        {
          "name": "--stack",
          "description": "Stack to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--since",
          "description": "Look back this far",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--resource",
          "description": "Only this resource",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "about",
      "description": "Show environment info",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--transitive",
          "description": "Include transitive dependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--cwd",
      "shorthand": "-C",
      "description": "Working directory",
      "takesValue": true,
      "short": "-C"
    },
    {
      "name": "--stack",
      "shorthand": "-s",
      "description": "Stack name",
      "takesValue": true,
      "short": "-s"
    },
    {
      "name": "--color",
      "description": "Colorize output (always, never, raw, auto)",
      "takesValue": true
    },
    {
      "name": "--logflow",
      "description": "Log to stderr"
    },
    {
      "name": "--logtostderr",
      "description": "Log to stderr"
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose (0-9)",
      "takesValue": true,
      "short": "-v"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    }
  ],
  "examples": [
    {
      "command": "pulumi new typescript",
      "description": "Create TypeScript project"
    },
    {
      "command": "pulumi up",
      "description": "Deploy infrastructure"
    },
    {
      "command": "pulumi up -y",
      "description": "Deploy without confirmation"
    },
    {
      "command": "pulumi preview --diff",
      "description": "Preview with diff"
    },
    {
      "command": "pulumi destroy -y",
      "description": "Destroy all resources"
    },
    {
      "command": "pulumi stack ls",
      "description": "List stacks"
    },
    {
      "command": "pulumi config set aws:region us-east-1",
      "description": "Set config"
    },
    {
      "command": "pulumi stack output",
      "description": "Show outputs"
    }
  ],
  "relatedCommands": [
    "terraform",
    "terragrunt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "stacks",
        "description": "Available stacks",
        "command": "pulumi stack ls --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 30,
        "requiresCmd": "pulumi"
      },
      {
        "name": "current_stack",
        "description": "Current stack",
        "command": "pulumi stack --show-name 2>/dev/null",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "pulumi"
      },
      {
        "name": "config",
        "description": "Stack configuration",
        "command": "pulumi config --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 30,
        "requiresCmd": "pulumi"
      },
      {
        "name": "project",
        "description": "Project configuration",
        "command": "cat Pulumi.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "outputs",
        "description": "Stack outputs",
        "command": "pulumi stack output --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 30,
        "requiresCmd": "pulumi"
      }
    ]
  }
}
