{
  "name": "ninja",
  "description": "Small, fast build system focused on speed",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--jobs",
      "description": "Parallel jobs to run",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--file",
      "description": "Build file to read",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--dir",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--targets",
      "description": "List targets by rule or depth",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--verbose",
      "description": "Print every command",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--dry-run",
      "description": "Print commands without running them",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--keep-going",
      "description": "Keep building after failures",
      "type": "integer",
      "takesValue": true,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--load-average",
      "description": "Do not start jobs above this load",
      "type": "number",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    }
  ],
  "examples": [
    {
      "command": "ninja",
      "description": "Build the default target"
    },
    {
      "command": "ninja -j 8 install",
      "description": "Build a target with 8 jobs"
    },
    {
      "command": "ninja -t clean",
      "description": "Clean the build outputs"
    },
    {
      "command": "ninja -t targets",
      "description": "List the available targets"
    }
  ],
  "relatedCommands": [
    "cmake",
    "meson",
    "make",
    "bazel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Ninja version",
        "command": "ninja --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ninja"
      },
      {
        "name": "build_file",
        "description": "Ninja build manifest present",
        "command": "ls build.ninja 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "targets",
        "description": "Targets in the Ninja manifest",
        "command": "ninja -t targets 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "ninja"
      },
      {
        "name": "generator",
        "description": "Tool that generated this Ninja file",
        "command": "head -3 build.ninja 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
