{
  "name": "storybook",
  "description": "UI component development environment",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "dev",
      "description": "Start Storybook in development mode",
      "examples": [
        "storybook dev -p 6006"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--host",
          "description": "Host the dev server binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-open",
          "description": "Do not open a browser on start",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build static Storybook",
      "examples": [
        "storybook build -o storybook-static"
      ],
      "options": [
        {
          "name": "--output-dir",
          "description": "Directory for the static build",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--webpack-stats-json",
          "description": "Emit webpack build statistics",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize Storybook in a project",
      "examples": [
        "storybook init"
      ],
      "options": [
        {
          "name": "--type",
          "description": "Framework to configure Storybook for",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--builder",
          "description": "Builder to use: webpack5 or vite",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--yes",
          "description": "Accept the defaults without prompting",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade Storybook",
      "examples": [
        "storybook upgrade"
      ],
      "options": [
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--yes",
          "description": "Accept the defaults without prompting",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Check for common issues",
      "examples": [
        "storybook doctor"
      ],
      "options": [
        {
          "name": "--config-dir",
          "description": "Storybook config directory",
          "type": "directory",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-p",
      "description": "Port number",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output directory for build",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ci",
      "description": "CI mode (skip interactive prompts)"
    },
    {
      "name": "--docs",
      "description": "Build docs mode"
    },
    {
      "name": "--quiet",
      "description": "Suppress verbose output"
    }
  ],
  "examples": [
    "storybook dev -p 6006",
    "storybook build",
    "storybook init",
    "npx storybook@latest init",
    "storybook build --docs"
  ],
  "relatedCommands": [
    "vite",
    "webpack",
    "jest",
    "chromatic"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Storybook version",
        "command": "storybook --version 2>/dev/null || npx storybook --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Storybook configuration",
        "command": "cat .storybook/main.js 2>/dev/null || cat .storybook/main.ts 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "stories",
        "description": "Story files in this project",
        "command": "find . -maxdepth 4 -name '*.stories.*' -not -path './node_modules/*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
