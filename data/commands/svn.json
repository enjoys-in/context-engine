{
  "name": "svn",
  "description": "Apache Subversion - centralized version control system",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "checkout",
      "description": "Check out a working copy from a repository",
      "args": [
        {
          "name": "url",
          "description": "Repository URL",
          "required": true
        },
        {
          "name": "path",
          "description": "Local path",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--revision",
          "shorthand": "-r",
          "description": "Revision to check out",
          "takesValue": true,
          "short": "-r"
        },
        {
          "name": "--depth",
          "description": "Depth (infinity, immediates, files, empty)",
          "takesValue": true
        }
      ],
      "examples": [
        "svn checkout url path"
      ]
    },
    {
      "name": "update",
      "description": "Update working copy",
      "args": [
        {
          "name": "path",
          "description": "Path to update",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--revision",
          "shorthand": "-r",
          "description": "Update to revision",
          "takesValue": true,
          "short": "-r"
        }
      ],
      "examples": [
        "svn update path"
      ]
    },
    {
      "name": "commit",
      "description": "Commit changes",
      "args": [
        {
          "name": "path",
          "description": "Paths to commit",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--message",
          "shorthand": "-m",
          "description": "Commit message",
          "takesValue": true,
          "short": "-m"
        },
        {
          "name": "--file",
          "shorthand": "-F",
          "description": "Read message from file",
          "takesValue": true,
          "short": "-F"
        }
      ],
      "examples": [
        "svn commit path"
      ]
    },
    {
      "name": "add",
      "description": "Add files to version control",
      "args": [
        {
          "name": "path",
          "description": "Files to add",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--depth",
          "description": "Depth",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Force add"
        }
      ],
      "examples": [
        "svn add path"
      ]
    },
    {
      "name": "delete",
      "description": "Delete files from version control",
      "args": [
        {
          "name": "path",
          "description": "Files to delete",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--force",
          "description": "Force delete"
        },
        {
          "name": "--keep-local",
          "description": "Keep local copy"
        }
      ],
      "examples": [
        "svn delete path"
      ]
    },
    {
      "name": "status",
      "description": "Show working copy status",
      "args": [
        {
          "name": "path",
          "description": "Path to check",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "shorthand": "-v",
          "description": "Verbose output",
          "short": "-v"
        },
        {
          "name": "--show-updates",
          "shorthand": "-u",
          "description": "Show updates from server",
          "short": "-u"
        }
      ],
      "examples": [
        "svn status path"
      ]
    },
    {
      "name": "diff",
      "description": "Show changes",
      "args": [
        {
          "name": "path",
          "description": "Path to diff",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--revision",
          "shorthand": "-r",
          "description": "Revision range (N:M)",
          "takesValue": true,
          "short": "-r"
        },
        {
          "name": "--summarize",
          "description": "Show summary only"
        }
      ],
      "examples": [
        "svn diff path"
      ]
    },
    {
      "name": "log",
      "description": "Show commit logs",
      "args": [
        {
          "name": "path",
          "description": "Path to show logs for",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--revision",
          "shorthand": "-r",
          "description": "Revision range",
          "takesValue": true,
          "short": "-r"
        },
        {
          "name": "--limit",
          "shorthand": "-l",
          "description": "Max log entries",
          "takesValue": true,
          "short": "-l"
        },
        {
          "name": "--verbose",
          "shorthand": "-v",
          "description": "Show changed paths",
          "short": "-v"
        }
      ],
      "examples": [
        "svn log path"
      ]
    },
    {
      "name": "copy",
      "description": "Copy files (also used for branching/tagging)",
      "args": [
        {
          "name": "src",
          "description": "Source",
          "required": true
        },
        {
          "name": "dst",
          "description": "Destination",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--message",
          "shorthand": "-m",
          "description": "Commit message",
          "takesValue": true,
          "short": "-m"
        }
      ],
      "examples": [
        "svn copy src dst"
      ]
    },
    {
      "name": "move",
      "description": "Move/rename files",
      "args": [
        {
          "name": "src",
          "description": "Source",
          "required": true
        },
        {
          "name": "dst",
          "description": "Destination",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ],
      "examples": [
        "svn move src dst"
      ]
    },
    {
      "name": "merge",
      "description": "Merge changes",
      "args": [
        {
          "name": "source",
          "description": "Source URL/path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--revision",
          "shorthand": "-r",
          "description": "Revision range",
          "takesValue": true,
          "short": "-r"
        },
        {
          "name": "--dry-run",
          "description": "Preview merge"
        },
        {
          "name": "--reintegrate",
          "description": "Reintegrate a branch"
        }
      ],
      "examples": [
        "svn merge ./src"
      ]
    },
    {
      "name": "switch",
      "description": "Switch working copy to different branch",
      "args": [
        {
          "name": "url",
          "description": "Branch URL",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--ignore-ancestry",
          "description": "Switch without checking ancestry",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Switch despite obstructing items",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "svn switch url"
      ]
    },
    {
      "name": "revert",
      "description": "Revert local changes",
      "args": [
        {
          "name": "path",
          "description": "Paths to revert",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--recursive",
          "shorthand": "-R",
          "description": "Revert recursively",
          "short": "-R"
        }
      ],
      "examples": [
        "svn revert path"
      ]
    },
    {
      "name": "resolve",
      "description": "Resolve conflicts",
      "args": [
        {
          "name": "path",
          "description": "Conflicted path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--accept",
          "description": "Resolution action (base, working, mine-full, theirs-full)",
          "takesValue": true
        }
      ],
      "examples": [
        "svn resolve path"
      ]
    },
    {
      "name": "info",
      "description": "Show information about working copy or URL",
      "args": [
        {
          "name": "target",
          "description": "Path or URL",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--xml",
          "description": "Emit XML output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recursive",
          "description": "Recurse into subdirectories",
          "type": "boolean",
          "takesValue": false,
          "short": "-R",
          "shorthand": "-R"
        }
      ],
      "examples": [
        "svn info target"
      ]
    },
    {
      "name": "list",
      "description": "List repository contents",
      "args": [
        {
          "name": "url",
          "description": "Repository URL",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--recursive",
          "shorthand": "-R",
          "description": "List recursively",
          "short": "-R"
        }
      ],
      "examples": [
        "svn list url"
      ]
    },
    {
      "name": "blame",
      "description": "Show line-by-line author info",
      "args": [
        {
          "name": "file",
          "description": "File",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--xml",
          "description": "Emit XML output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Show the full author and date",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ],
      "examples": [
        "svn blame file"
      ]
    },
    {
      "name": "propset",
      "description": "Set a property",
      "args": [
        {
          "name": "propname",
          "description": "Property name",
          "required": true
        },
        {
          "name": "propval",
          "description": "Property value",
          "required": true
        },
        {
          "name": "path",
          "description": "Target path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--file",
          "description": "Read the property value from this file",
          "type": "file",
          "takesValue": true,
          "short": "-F",
          "shorthand": "-F"
        },
        {
          "name": "--recursive",
          "description": "Apply recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-R",
          "shorthand": "-R"
        }
      ],
      "examples": [
        "svn propset propname propval path"
      ]
    },
    {
      "name": "propget",
      "description": "Get a property",
      "args": [
        {
          "name": "propname",
          "description": "Property name",
          "required": true
        },
        {
          "name": "path",
          "description": "Target path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--xml",
          "description": "Emit XML output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recursive",
          "description": "Recurse into subdirectories",
          "type": "boolean",
          "takesValue": false,
          "short": "-R",
          "shorthand": "-R"
        },
        {
          "name": "--strict",
          "description": "Print the raw value only",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "svn propget propname path"
      ]
    },
    {
      "name": "export",
      "description": "Export clean directory tree",
      "args": [
        {
          "name": "url",
          "description": "Source URL/path",
          "required": true
        },
        {
          "name": "path",
          "description": "Destination",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--message",
          "description": "Log message for the operation",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--revision",
          "description": "Revision to operate on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--username",
          "description": "Username to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--non-interactive",
          "description": "Never prompt for input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--force",
          "description": "Overwrite existing files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--native-eol",
          "description": "Line endings to write",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "svn export url path"
      ]
    },
    {
      "name": "cleanup",
      "description": "Clean up working copy",
      "options": [
        {
          "name": "--remove-unversioned",
          "description": "Also delete unversioned files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--remove-ignored",
          "description": "Also delete ignored files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--vacuum-pristines",
          "description": "Remove unreferenced pristine copies",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "svn cleanup"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--username",
      "description": "Username",
      "takesValue": true
    },
    {
      "name": "--password",
      "description": "Password",
      "takesValue": true
    },
    {
      "name": "--no-auth-cache",
      "description": "Do not cache credentials"
    },
    {
      "name": "--non-interactive",
      "description": "No interactive prompts"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet output",
      "short": "-q"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    }
  ],
  "examples": [
    {
      "command": "svn checkout https://svn.example.com/trunk myproject",
      "description": "Check out a project"
    },
    {
      "command": "svn commit -m 'Fix bug #123'",
      "description": "Commit changes with message"
    },
    {
      "command": "svn update",
      "description": "Update working copy"
    },
    {
      "command": "svn log -l 10",
      "description": "Show last 10 log entries"
    },
    {
      "command": "svn copy trunk branches/feature-x -m 'Create branch'",
      "description": "Create a branch"
    },
    {
      "command": "svn diff -r 100:200 file.c",
      "description": "Diff between revisions"
    }
  ],
  "relatedCommands": [
    "git",
    "hg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "status",
        "description": "Working copy status",
        "command": "svn status 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 10,
        "requiresCmd": "svn"
      },
      {
        "name": "info",
        "description": "Working copy info",
        "command": "svn info 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 30,
        "requiresCmd": "svn"
      },
      {
        "name": "branches",
        "description": "Repository branches",
        "command": "svn list $(svn info --show-item repos-root-url 2>/dev/null)/branches 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "svn"
      }
    ]
  }
}
