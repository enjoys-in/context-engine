{
  "name": "hadolint",
  "description": "Dockerfile linter — best practice checker",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--ignore",
      "description": "Ignore specific rule",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--trusted-registry",
      "description": "Trusted registry for FROM",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Output format (tty, json, checkstyle, codeclimate, gitlab_codeclimate, gnu, codacy, sonarqube, sarif)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--failure-threshold",
      "description": "Minimum severity for exit code (error, warning, info, style, ignore, none)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-color",
      "description": "Disable colors"
    },
    {
      "name": "-t",
      "description": "Only show errors above threshold",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "hadolint Dockerfile",
    "hadolint --ignore DL3008 Dockerfile",
    "hadolint -f json Dockerfile",
    "cat Dockerfile | hadolint -",
    "hadolint --failure-threshold warning Dockerfile"
  ],
  "relatedCommands": [
    "docker",
    "shellcheck",
    "trivy",
    "dockle"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "hadolint version",
        "command": "hadolint --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hadolint"
      },
      {
        "name": "dockerfiles",
        "description": "Dockerfiles hadolint can lint",
        "command": "find . -maxdepth 3 -name 'Dockerfile*' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "hadolint rule configuration",
        "command": "cat .hadolint.yaml 2>/dev/null || cat .hadolint.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  }
}
