{
  "name": "navi",
  "description": "Interactive cheatsheet launcher that fills in arguments",
  "category": "environment",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "fn",
      "description": "Call an internal function",
      "args": [
        {
          "name": "name",
          "description": "Function name",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "navi fn name"
      ]
    },
    {
      "name": "repo",
      "description": "Manage cheatsheet repositories",
      "options": [],
      "examples": [
        "navi repo"
      ]
    },
    {
      "name": "widget",
      "description": "Print the shell widget to install",
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "navi widget shell"
      ]
    },
    {
      "name": "info",
      "description": "Print paths and configuration",
      "options": [],
      "examples": [
        "navi info"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--query",
      "description": "Pre-fill the search query",
      "type": "string",
      "takesValue": true,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--best-match",
      "description": "Run the best match without prompting",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--print",
      "description": "Print the command instead of running it",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--path",
      "description": "Cheatsheet search path",
      "type": "path",
      "takesValue": true
    },
    {
      "name": "--tag-rules",
      "description": "Only include sheets matching these tags",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--fzf-overrides",
      "description": "Extra flags to pass to fzf",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "navi",
      "description": "Browse the cheatsheets interactively"
    },
    {
      "command": "navi --query \"docker prune\"",
      "description": "Open with a pre-filled query"
    },
    {
      "command": "navi --print -q \"git log\"",
      "description": "Print the chosen command instead of running it"
    },
    {
      "command": "navi repo add denisidoro/cheats",
      "description": "Add a cheatsheet repository"
    }
  ],
  "relatedCommands": [
    "tldr",
    "cheat",
    "fzf",
    "atuin"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "navi version",
        "command": "navi --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "navi"
      },
      {
        "name": "cheatsheets",
        "description": "navi cheatsheet directories",
        "command": "navi info cheats-path 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "navi"
      },
      {
        "name": "config",
        "description": "navi configuration",
        "command": "cat ~/.config/navi/config.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
