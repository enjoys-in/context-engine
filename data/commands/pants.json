{
  "name": "pants",
  "description": "Scalable build system for monorepos",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "fmt",
      "description": "Format the targeted files",
      "options": [
        {
          "name": "--only",
          "description": "Only run these formatters",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "lint",
      "description": "Lint the targeted files",
      "options": [
        {
          "name": "--only",
          "description": "Only run these linters",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "test",
      "description": "Run the tests",
      "options": [
        {
          "name": "--force",
          "description": "Ignore cached results",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--debug",
          "description": "Run interactively for debugging",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--use-coverage",
          "description": "Measure coverage",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "package",
      "description": "Build the deployable artifacts",
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--changed-since",
          "description": "Only act on targets changed since this ref",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run a target",
      "args": [
        {
          "name": "target",
          "description": "Target spec",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--args",
          "description": "Arguments to pass to the program",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "check",
      "description": "Run type checking",
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--changed-since",
          "description": "Only act on targets changed since this ref",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--only",
          "description": "Only run these checkers",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "list",
      "description": "List the matching targets",
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--changed-since",
          "description": "Only list targets changed since this ref",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--documented",
          "description": "Only list documented targets",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "dependencies",
      "description": "Show the dependencies of targets",
      "options": [
        {
          "name": "--transitive",
          "description": "Include transitive dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "dependents",
      "description": "Show what depends on targets",
      "options": [
        {
          "name": "--transitive",
          "description": "Include transitive dependents",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "targets",
          "description": "Target specs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "tailor",
      "description": "Create or update BUILD files",
      "options": [
        {
          "name": "--check",
          "description": "Report without writing",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "generate-lockfiles",
      "description": "Regenerate the dependency lockfiles",
      "options": [
        {
          "name": "--resolve",
          "description": "Only this resolve",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "export",
      "description": "Export a virtualenv or IDE configuration",
      "options": [
        {
          "name": "--resolve",
          "description": "Resolve to export a virtualenv for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--py-editable-in-resolve",
          "description": "Install first-party code as editable",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--changed-since",
      "description": "Only targets changed since this revision",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--concurrent",
      "description": "Do not use the pantsd daemon",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--keep-sandboxes",
      "description": "Preserve the process sandboxes for debugging",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "pants tailor ::",
      "description": "Create the missing BUILD files"
    },
    {
      "command": "pants fmt lint ::",
      "description": "Format and lint everything"
    },
    {
      "command": "pants test ::",
      "description": "Run every test"
    },
    {
      "command": "pants --changed-since=main test",
      "description": "Test only what changed"
    }
  ],
  "relatedCommands": [
    "bazel",
    "buck",
    "make",
    "uv"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Pants version",
        "command": "pants --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pants"
      },
      {
        "name": "config",
        "description": "Pants configuration",
        "command": "cat pants.toml 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "build_files",
        "description": "Pants BUILD files in this project",
        "command": "find . -maxdepth 3 -name 'BUILD' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "targets",
        "description": "Pants targets in this project",
        "command": "pants list :: 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "pants"
      }
    ]
  }
}
