{
  "name": "eksctl",
  "description": "CLI tool for creating and managing EKS clusters",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "create cluster",
      "description": "Create EKS cluster",
      "examples": [
        "eksctl create cluster --name my-cluster --region us-west-2"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Cluster name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "AWS region",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Kubernetes version",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nodes",
          "description": "Node count",
          "type": "integer",
          "takesValue": true,
          "short": "-N",
          "shorthand": "-N"
        },
        {
          "name": "--node-type",
          "description": "EC2 instance type",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--managed",
          "description": "Create a managed node group",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--fargate",
          "description": "Create a Fargate profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--spot",
          "description": "Use spot instances",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--config-file",
          "description": "Cluster configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--without-nodegroup",
          "description": "Create the control plane only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Print the resolved configuration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--zones",
          "description": "Availability zones to use",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "delete cluster",
      "description": "Delete EKS cluster",
      "examples": [
        "eksctl delete cluster --name my-cluster"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Cluster name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "AWS region",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Block until deletion finishes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force",
          "description": "Continue past failures",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--disable-nodegroup-eviction",
          "description": "Skip draining nodes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--config-file",
          "description": "Cluster configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "get cluster",
      "description": "Get cluster info",
      "examples": [
        "eksctl get cluster"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Cluster name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "AWS region",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format (table, json, yaml)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--all-regions",
          "description": "Query every region",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "create nodegroup",
      "description": "Create a managed node group",
      "examples": [
        "eksctl create nodegroup --cluster my-cluster --name ng-1"
      ],
      "options": [
        {
          "name": "--cluster",
          "description": "Cluster to add the group to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Node group name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nodes",
          "description": "Node count",
          "type": "integer",
          "takesValue": true,
          "short": "-N",
          "shorthand": "-N"
        },
        {
          "name": "--nodes-min",
          "description": "Minimum node count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--nodes-max",
          "description": "Maximum node count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--node-type",
          "description": "EC2 instance type",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--managed",
          "description": "Create a managed node group",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--spot",
          "description": "Use spot instances",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--node-volume-size",
          "description": "Root volume size in GiB",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "scale nodegroup",
      "description": "Scale node group",
      "examples": [
        "eksctl scale nodegroup --cluster my-cluster --name ng-1 --nodes 5"
      ],
      "options": [
        {
          "name": "--cluster",
          "description": "Cluster the group belongs to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Node group name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nodes",
          "description": "Desired node count",
          "type": "integer",
          "takesValue": true,
          "short": "-N",
          "shorthand": "-N"
        },
        {
          "name": "--nodes-min",
          "description": "Minimum node count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--nodes-max",
          "description": "Maximum node count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Block until scaling finishes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "upgrade cluster",
      "description": "Upgrade control plane",
      "examples": [
        "eksctl upgrade cluster --name my-cluster"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Cluster name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Target Kubernetes version",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--approve",
          "description": "Apply the change rather than previewing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--region",
          "description": "AWS region",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "utils write-kubeconfig",
      "description": "Write kubeconfig",
      "examples": [
        "eksctl utils write-kubeconfig --cluster my-cluster"
      ],
      "options": [
        {
          "name": "--cluster",
          "description": "Cluster to write config for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Path to write to",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--set-kubeconfig-context",
          "description": "Also switch the current context",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "AWS region",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--region",
      "description": "AWS region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--profile",
      "description": "AWS profile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Config file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Verbosity level",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "eksctl create cluster --name mycluster --region us-west-2",
    "eksctl get cluster",
    "eksctl delete cluster --name mycluster",
    "eksctl create cluster -f cluster.yaml"
  ],
  "relatedCommands": [
    "kubectl",
    "aws",
    "helm",
    "cdk"
  ]
}
