{
  "name": "pdm",
  "description": "Modern Python package and dependency manager with PEP 582 support",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Create a pyproject.toml interactively",
      "options": [
        {
          "name": "--non-interactive",
          "description": "Accept the defaults",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "install",
      "description": "Install the locked dependencies",
      "options": [
        {
          "name": "--prod",
          "description": "Skip development dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--group",
          "description": "Dependency group to install",
          "type": "string",
          "takesValue": true,
          "short": "-G",
          "shorthand": "-G"
        },
        {
          "name": "--frozen-lockfile",
          "description": "Do not update the lockfile",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "add",
      "description": "Add a dependency",
      "options": [
        {
          "name": "--dev",
          "description": "Add to the development group",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--group",
          "description": "Group to add to",
          "type": "string",
          "takesValue": true,
          "short": "-G",
          "shorthand": "-G"
        },
        {
          "name": "--save-exact",
          "description": "Pin the exact version",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to add",
          "type": "package",
          "required": true
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove a dependency",
      "options": [
        {
          "name": "--dev",
          "description": "Remove from the development group",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to remove",
          "type": "package",
          "required": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Update locked dependencies",
      "options": [
        {
          "name": "--unconstrained",
          "description": "Ignore version constraints",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        }
      ]
    },
    {
      "name": "lock",
      "description": "Resolve dependencies and write pdm.lock",
      "options": [
        {
          "name": "--refresh",
          "description": "Re-resolve from scratch",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a command in the project environment",
      "options": [
        {
          "name": "--project",
          "description": "Project directory to act on",
          "type": "directory",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "script",
          "description": "Script or command to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "build",
      "description": "Build source and wheel distributions",
      "options": [
        {
          "name": "--dest",
          "description": "Directory to write artifacts to",
          "type": "directory",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        }
      ]
    },
    {
      "name": "publish",
      "description": "Upload distributions to an index",
      "options": [
        {
          "name": "--repository",
          "description": "Repository to publish to",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "venv",
      "description": "Manage virtual environments",
      "options": [
        {
          "name": "--project",
          "description": "Project directory to act on",
          "type": "directory",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "list",
      "description": "Show the installed packages",
      "options": [
        {
          "name": "--tree",
          "description": "Display as a dependency tree",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--project",
      "description": "Project root to use",
      "type": "directory",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "pdm init",
      "description": "Start a new project"
    },
    {
      "command": "pdm add requests",
      "description": "Add a dependency"
    },
    {
      "command": "pdm install --frozen-lockfile",
      "description": "Install exactly the lockfile"
    },
    {
      "command": "pdm run pytest",
      "description": "Run pytest in the project environment"
    }
  ],
  "relatedCommands": [
    "uv",
    "poetry",
    "hatch",
    "pip"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "PDM version",
        "command": "pdm --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pdm"
      },
      {
        "name": "pyproject",
        "description": "Python project configuration",
        "command": "cat pyproject.toml 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "python",
        "description": "Python interpreter PDM is using",
        "command": "pdm info --python 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "pdm"
      },
      {
        "name": "venv",
        "description": "PDM-managed virtual environments",
        "command": "pdm venv list 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "pdm"
      }
    ]
  }
}
