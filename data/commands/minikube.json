{
  "name": "minikube",
  "description": "minikube — local Kubernetes cluster for development",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start a local cluster",
      "examples": [
        "minikube start",
        "minikube start --driver=docker",
        "minikube start --cpus=4 --memory=8192",
        "minikube start --kubernetes-version=v1.27.0",
        "minikube start --nodes=3",
        "minikube start --container-runtime=containerd",
        "minikube start -p my-cluster"
      ],
      "options": [
        {
          "name": "--driver",
          "description": "VM or container driver",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cpus",
          "description": "CPU count",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--memory",
          "description": "Memory to allocate, e.g. 4g",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubernetes-version",
          "description": "Kubernetes version",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nodes",
          "description": "Node count",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--addons",
          "description": "Addons to enable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--container-runtime",
          "description": "Container runtime",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--profile",
          "description": "Profile to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop the cluster",
      "examples": [
        "minikube stop",
        "minikube stop -p my-cluster"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Stop every profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--profile",
          "description": "Profile to stop",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete the cluster",
      "examples": [
        "minikube delete",
        "minikube delete --all",
        "minikube delete -p my-cluster",
        "minikube delete --purge"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Delete every profile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--purge",
          "description": "Also remove the .minikube directory",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--profile",
          "description": "Profile to delete",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "status",
      "description": "Show cluster status",
      "examples": [
        "minikube status",
        "minikube status -p my-cluster"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format (text, json)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--profile",
          "description": "Profile to query",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "dashboard",
      "description": "Open Kubernetes dashboard",
      "examples": [
        "minikube dashboard",
        "minikube dashboard --url"
      ],
      "options": [
        {
          "name": "--url",
          "description": "Print the URL instead of opening it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--port",
          "description": "Port to serve on",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "service",
      "description": "Open a service URL",
      "examples": [
        "minikube service my-service",
        "minikube service my-service --url",
        "minikube service list"
      ],
      "options": [
        {
          "name": "--url",
          "description": "Print the URL instead of opening it",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all",
          "description": "Expose every service",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "tunnel",
      "description": "Create network tunnel for LoadBalancers",
      "examples": [
        "minikube tunnel",
        "minikube tunnel --cleanup"
      ],
      "options": [
        {
          "name": "--cleanup",
          "description": "Clean up leftover routes",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--bind-address",
          "description": "Address to bind",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "addons",
      "description": "Manage addons",
      "examples": [
        "minikube addons list",
        "minikube addons enable ingress",
        "minikube addons enable metrics-server",
        "minikube addons enable dashboard",
        "minikube addons disable ingress"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to modify",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "ssh",
      "description": "SSH into the node",
      "examples": [
        "minikube ssh",
        "minikube ssh -- ls /"
      ],
      "options": [
        {
          "name": "--node",
          "description": "Node to connect to",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "kubectl",
      "description": "Run kubectl",
      "examples": [
        "minikube kubectl -- get pods",
        "minikube kubectl -- apply -f manifest.yaml"
      ]
    },
    {
      "name": "docker-env",
      "description": "Configure Docker env for minikube",
      "examples": [
        "eval $(minikube docker-env)",
        "minikube docker-env"
      ],
      "options": [
        {
          "name": "--shell",
          "description": "Shell to emit for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--unset",
          "description": "Print commands to unset",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        }
      ]
    },
    {
      "name": "image",
      "description": "Manage images",
      "examples": [
        "minikube image load my-image:latest",
        "minikube image build -t my-image .",
        "minikube image ls"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to modify",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "cp",
      "description": "Copy files into minikube",
      "examples": [
        "minikube cp file.txt /home/docker/file.txt"
      ]
    },
    {
      "name": "mount",
      "description": "Mount host directory",
      "examples": [
        "minikube mount /host/path:/vm/path"
      ],
      "options": [
        {
          "name": "--gid",
          "description": "Group id for the mount",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--uid",
          "description": "User id for the mount",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--msize",
          "description": "Message size",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "node",
      "description": "Manage nodes",
      "examples": [
        "minikube node list",
        "minikube node add",
        "minikube node delete node-name"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to modify",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "profile",
      "description": "Manage profiles",
      "examples": [
        "minikube profile list",
        "minikube profile my-cluster"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage config settings",
      "examples": [
        "minikube config set cpus 4",
        "minikube config set memory 8192",
        "minikube config view"
      ]
    },
    {
      "name": "logs",
      "description": "View cluster logs",
      "examples": [
        "minikube logs",
        "minikube logs --follow"
      ],
      "options": [
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--problems",
          "description": "Show only detected problems",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--length",
          "description": "Lines to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "ip",
      "description": "Get cluster IP",
      "examples": [
        "minikube ip"
      ],
      "options": [
        {
          "name": "--node",
          "description": "Node to query",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "version",
      "description": "Print version",
      "examples": [
        "minikube version"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--components",
          "description": "Show component versions",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "update-check",
      "description": "Check for updates",
      "examples": [
        "minikube update-check"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--driver",
      "description": "Driver (docker, virtualbox, hyperv, qemu, ssh)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--cpus",
      "description": "Number of CPUs",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--memory",
      "description": "Memory in MB",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--disk-size",
      "description": "Disk size",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--kubernetes-version",
      "description": "K8s version",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--container-runtime",
      "description": "Runtime (docker, containerd, cri-o)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--profile",
      "short": "-p",
      "description": "Profile name",
      "type": "string",
      "takesValue": true,
      "shorthand": "-p"
    },
    {
      "name": "--nodes",
      "description": "Number of nodes",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--addons",
      "description": "Addons to enable",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "minikube start",
    "minikube start --driver=docker --cpus=4 --memory=8192",
    "minikube status",
    "minikube dashboard",
    "minikube service my-service --url",
    "minikube tunnel",
    "minikube addons enable ingress",
    "minikube image load my-image:latest",
    "eval $(minikube docker-env)",
    "minikube ssh",
    "minikube stop",
    "minikube delete --all"
  ],
  "relatedCommands": [
    "kubectl",
    "k3d",
    "kind",
    "docker",
    "helm"
  ]
}
