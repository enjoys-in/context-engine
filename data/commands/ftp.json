{
  "name": "ftp",
  "description": "Interactive file transfer over FTP",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "-i",
      "description": "Disable prompting during multi-file transfers",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-n",
      "description": "Do not attempt auto-login",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-v",
      "description": "Print verbose responses",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-p",
      "description": "Use passive mode",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-d",
      "description": "Enable debugging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-g",
      "description": "Disable filename globbing",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ftp ftp.example.com",
      "description": "Connect interactively"
    },
    {
      "command": "ftp -n -i ftp.example.com",
      "description": "Connect without auto-login or prompts"
    },
    {
      "command": "ftp -p files.example.com",
      "description": "Connect in passive mode"
    }
  ],
  "relatedCommands": [
    "sftp",
    "scp",
    "rsync",
    "curl",
    "lftp"
  ]
}
