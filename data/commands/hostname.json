{
  "name": "hostname",
  "description": "Show or set the system hostname",
  "category": "system",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-f",
      "description": "Display the FQDN"
    },
    {
      "name": "-i",
      "description": "Display the IP address"
    },
    {
      "name": "-d",
      "description": "Display the DNS domain name"
    },
    {
      "name": "-s",
      "description": "Display the short hostname"
    },
    {
      "name": "-I",
      "description": "Display all network addresses"
    }
  ],
  "examples": [
    "hostname",
    "hostname -f",
    "hostname -i",
    "hostname -I",
    "hostname newname",
    "hostnamectl set-hostname myserver"
  ],
  "relatedCommands": [
    "hostnamectl",
    "uname",
    "ip"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "hostname",
        "description": "Short hostname",
        "command": "hostname 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "hostname"
      },
      {
        "name": "fqdn",
        "description": "Fully qualified domain name",
        "command": "hostname -f 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "hostname"
      },
      {
        "name": "addresses",
        "description": "Addresses resolving to this host",
        "command": "hostname -I 2>/dev/null || hostname -i 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "hostname"
      },
      {
        "name": "hosts_file",
        "description": "Static host entries",
        "command": "cat /etc/hosts 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
