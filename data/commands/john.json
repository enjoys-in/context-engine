{
  "name": "john",
  "description": "John the Ripper — password hash auditing",
  "category": "security",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--wordlist",
      "description": "Wordlist to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--rules",
      "description": "Apply mangling rules, optionally a named set",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--incremental",
      "description": "Use incremental brute-force mode",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--single",
      "description": "Use single-crack mode",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--format",
      "description": "Hash format to assume",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show",
      "description": "Show already cracked passwords",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--session",
      "description": "Name this session for later resume",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--restore",
      "description": "Resume a saved session",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--fork",
      "description": "Fork this many processes",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--pot",
      "description": "Use this pot file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--mask",
      "description": "Mask to generate candidates from",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--min-length",
      "description": "Minimum candidate length",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--max-length",
      "description": "Maximum candidate length",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--test",
      "description": "Benchmark the supported formats",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--list",
      "description": "List formats, modes or subformats",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "john --wordlist=rockyou.txt hashes.txt",
      "description": "Audit hashes against a wordlist"
    },
    {
      "command": "john --show hashes.txt",
      "description": "Show what has been cracked"
    },
    {
      "command": "john --format=sha512crypt --fork=4 hashes.txt",
      "description": "Audit a specific format across four processes"
    },
    {
      "command": "john --restore=audit1",
      "description": "Resume a named session"
    }
  ],
  "relatedCommands": [
    "hashcat",
    "hydra",
    "gpg",
    "openssl"
  ]
}
