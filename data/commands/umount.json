{
  "name": "umount",
  "description": "Unmount a filesystem",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-f",
      "description": "Force unmount"
    },
    {
      "name": "-l",
      "description": "Lazy unmount (detach now, cleanup later)"
    },
    {
      "name": "-R",
      "description": "Recursively unmount"
    },
    {
      "name": "-v",
      "description": "Verbose mode"
    },
    {
      "name": "-a",
      "description": "Unmount all"
    },
    {
      "name": "--all",
      "description": "Unmount everything in fstab",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--force",
      "description": "Force unmount, even if busy",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--lazy",
      "description": "Detach now and clean up when idle",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--recursive",
      "description": "Unmount nested mounts too",
      "type": "boolean",
      "takesValue": false,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--types",
      "description": "Only unmount these filesystem types",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--no-canonicalize",
      "description": "Do not canonicalise paths",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--detach-loop",
      "description": "Also free the loop device",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--namespace",
      "description": "Operate in this mount namespace",
      "type": "string",
      "takesValue": true,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--quiet",
      "description": "Suppress not-mounted warnings",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    "umount /mnt/usb",
    "umount -l /mnt/stuck",
    "sudo umount -f /mnt/nfs",
    "umount /dev/sdb1"
  ],
  "relatedCommands": [
    "mount",
    "df",
    "lsblk",
    "fuser"
  ]
}
