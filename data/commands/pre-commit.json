{
  "name": "pre-commit",
  "description": "Framework for managing multi-language pre-commit hooks",
  "category": "git",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install hook scripts",
      "examples": [
        "pre-commit install"
      ],
      "options": [
        {
          "name": "--hook-type",
          "description": "Hook type to install",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--overwrite",
          "description": "Replace existing hooks",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--install-hooks",
          "description": "Install the hook environments now",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--allow-missing-config",
          "description": "Do not fail when the config is absent",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run hooks against staged files",
      "examples": [
        "pre-commit run",
        "pre-commit run --all-files"
      ],
      "options": [
        {
          "name": "--all-files",
          "description": "Run against every tracked file",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--files",
          "description": "Only run against these files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--hook-stage",
          "description": "Stage to run hooks for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--show-diff-on-failure",
          "description": "Print the diff when a hook changes files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "autoupdate",
      "description": "Update hooks to latest version",
      "examples": [
        "pre-commit autoupdate"
      ],
      "options": [
        {
          "name": "--bleeding-edge",
          "description": "Update to the tip of the default branch",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--freeze",
          "description": "Pin to the resolved commit hash",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--repo",
          "description": "Only update this repository",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "sample-config",
      "description": "Produce a sample config",
      "examples": [
        "pre-commit sample-config"
      ],
      "options": []
    },
    {
      "name": "validate-config",
      "description": "Validate config file",
      "examples": [
        "pre-commit validate-config .pre-commit-config.yaml"
      ],
      "options": [],
      "args": [
        {
          "name": "file",
          "description": "Config file to validate",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
      "name": "clean",
      "description": "Clean cached pre-commit files",
      "examples": [
        "pre-commit clean"
      ],
      "options": []
    },
    {
      "name": "uninstall",
      "description": "Uninstall hooks",
      "examples": [
        "pre-commit uninstall"
      ],
      "options": [
        {
          "name": "--hook-type",
          "description": "Hook type to uninstall",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--all-files",
      "description": "Run on all files, not just staged"
    },
    {
      "name": "--files",
      "description": "Run on specific files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--hook-stage",
      "description": "Which hook stage to run",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--show-diff-on-failure",
      "description": "Show diff on failure"
    }
  ],
  "examples": [
    "pre-commit install",
    "pre-commit run --all-files",
    "pre-commit autoupdate",
    "pre-commit run black --all-files",
    "pre-commit sample-config > .pre-commit-config.yaml"
  ],
  "relatedCommands": [
    "husky",
    "commitlint",
    "lint-staged",
    "black"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "pre-commit version",
        "command": "pre-commit --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pre-commit"
      },
      {
        "name": "config",
        "description": "pre-commit hook configuration",
        "command": "cat .pre-commit-config.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "installed",
        "description": "Whether pre-commit hooks are installed in this repo",
        "command": "ls .git/hooks/pre-commit 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "repos",
        "description": "Hook repositories this project pulls from",
        "command": "grep -E '^ *- repo:' .pre-commit-config.yaml 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
