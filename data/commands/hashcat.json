{
  "name": "hashcat",
  "description": "GPU-accelerated password hash auditing",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--hash-type",
      "description": "Hash mode number",
      "type": "integer",
      "takesValue": true,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--attack-mode",
      "description": "Attack mode: 0 wordlist, 3 mask, 6 hybrid",
      "type": "integer",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--outfile",
      "description": "Write cracked hashes here",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--show",
      "description": "Show already cracked hashes",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--left",
      "description": "Show the hashes still uncracked",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--rules-file",
      "description": "Mangling rules to apply",
      "type": "file",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--increment",
      "description": "Enable mask increment mode",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--increment-min",
      "description": "Minimum mask length",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--increment-max",
      "description": "Maximum mask length",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--workload-profile",
      "description": "Workload profile 1-4",
      "type": "integer",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--session",
      "description": "Name this session for later restore",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--restore",
      "description": "Resume a saved session",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--potfile-path",
      "description": "Use this pot file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--benchmark",
      "description": "Benchmark the hash modes",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--force",
      "description": "Ignore device warnings",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--status",
      "description": "Print status updates",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--example-hashes",
      "description": "Show an example for each mode",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "hashcat -m 0 -a 0 hashes.txt rockyou.txt",
      "description": "Audit MD5 hashes against a wordlist"
    },
    {
      "command": "hashcat -m 1000 -a 3 hashes.txt \"?u?l?l?l?d?d\"",
      "description": "Audit NTLM hashes with a mask"
    },
    {
      "command": "hashcat --show -m 0 hashes.txt",
      "description": "Show what has been cracked"
    },
    {
      "command": "hashcat -b",
      "description": "Benchmark the device"
    }
  ],
  "relatedCommands": [
    "john",
    "hydra",
    "openssl",
    "gpg"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "hashcat version",
        "command": "hashcat --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hashcat"
      },
      {
        "name": "devices",
        "description": "Compute devices hashcat can use",
        "command": "hashcat -I 2>/dev/null | head -25",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hashcat"
      },
      {
        "name": "hash_files",
        "description": "Hash files present for cracking",
        "command": "find . -maxdepth 2 -name '*.hash' -o -maxdepth 2 -name '*.hccapx' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "potfile",
        "description": "hashcat recovered-hash potfile",
        "command": "ls -l ~/.local/share/hashcat/hashcat.potfile 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
