{
  "name": "expo",
  "description": "Expo CLI for React Native",
  "category": "mobile",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start the local Expo development server",
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--clear",
          "description": "Clear the bundler cache",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--tunnel",
          "description": "Serve over a tunnel",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--localhost",
          "description": "Serve on localhost only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dev-client",
          "description": "Use a development build",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build the app for Android or iOS",
      "options": [
        {
          "name": "--platform",
          "description": "Platform to build for",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--profile",
          "description": "Build profile to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--clear-cache",
          "description": "Clear the build cache first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--non-interactive",
          "description": "Fail rather than prompting",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "install",
      "description": "Install a package and its dependencies",
      "options": [
        {
          "name": "--fix",
          "description": "Fix any mismatched dependency versions",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--check",
          "description": "Report mismatched dependency versions",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "required": false,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Clear bundler cache"
    }
  ],
  "examples": [
    {
      "command": "npx expo start",
      "description": "Start bundler"
    },
    {
      "command": "npx expo start -c",
      "description": "Start bundler and clear cache"
    },
    {
      "command": "npx expo install expo-camera",
      "description": "Install Expo module"
    }
  ],
  "relatedCommands": [
    "react-native",
    "adb",
    "npm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "app_json",
        "description": "Expo App Configuration",
        "command": "cat app.json 2>/dev/null | jq '.expo' -c 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
