{
  "name": "bfg",
  "description": "Fast rewriter for removing large files and secrets from git history",
  "category": "version-control",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--delete-files",
      "description": "Delete files matching this glob from history",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--delete-folders",
      "description": "Delete folders matching this glob",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--replace-text",
      "description": "Replace text using rules in this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--strip-blobs-bigger-than",
      "description": "Strip blobs above this size, e.g. 50M",
      "type": "string",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--strip-biggest-blobs",
      "description": "Strip the N largest blobs",
      "type": "integer",
      "takesValue": true,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--no-blob-protection",
      "description": "Also rewrite the current commit",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--private",
      "description": "Do not report the removed content",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--massive-non-file-objects-sized-up-to",
      "description": "Cap for huge non-file objects",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "bfg --delete-files id_rsa repo.git",
      "description": "Remove a file from all history"
    },
    {
      "command": "bfg -b 50M repo.git",
      "description": "Strip blobs larger than 50 MB"
    },
    {
      "command": "bfg --replace-text secrets.txt repo.git",
      "description": "Replace secret strings throughout history"
    },
    {
      "command": "git reflog expire --expire=now --all && git gc --prune=now",
      "description": "Finish the rewrite by pruning"
    }
  ],
  "relatedCommands": [
    "git",
    "git-filter-repo",
    "gitleaks",
    "trufflehog"
  ]
}
