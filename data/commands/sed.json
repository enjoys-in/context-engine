{
  "name": "sed",
  "description": "Stream editor for filtering and transforming text",
  "category": "text-processing",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-e",
      "description": "Add script command",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Script file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Edit files in-place (optionally create backup)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-n",
      "description": "Suppress automatic printing"
    },
    {
      "name": "-r",
      "description": "Use extended regex (GNU)"
    },
    {
      "name": "-E",
      "description": "Use extended regex (POSIX)"
    }
  ],
  "examples": [
    "sed 's/old/new/g' file.txt",
    "sed -i 's/old/new/g' file.txt",
    "sed -i.bak 's/old/new/g' file.txt",
    "sed -n '10,20p' file.txt",
    "sed '/pattern/d' file.txt",
    "sed '5i\\new line' file.txt",
    "sed -n '/start/,/end/p' file.txt",
    "sed 's/^/  /' file.txt",
    "sed '$ a\\last line' file.txt"
  ],
  "relatedCommands": [
    "awk",
    "grep",
    "tr",
    "cut",
    "perl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "sed implementation and version",
        "command": "sed --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "sed"
      },
      {
        "name": "in_place_flag",
        "description": "Whether this sed needs a suffix for -i (BSD vs GNU)",
        "command": "sed --version 2>/dev/null | head -1 | grep -q GNU && echo 'GNU: -i' || echo 'BSD: -i \\x27\\x27'",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "text_files",
        "description": "Text files sed could rewrite",
        "command": "find . -maxdepth 2 -name '*.txt' -o -name '*.md' -o -name '*.conf' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "repo",
        "description": "Git repository (so edits are recoverable)",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
