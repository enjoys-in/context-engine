{
  "name": "kill",
  "description": "Send a signal to a process",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-s",
      "description": "Specify signal to send",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-l",
      "description": "List signal names"
    },
    {
      "name": "-9",
      "description": "Send SIGKILL (force kill)"
    },
    {
      "name": "-15",
      "description": "Send SIGTERM (graceful)"
    },
    {
      "name": "-HUP",
      "description": "Send SIGHUP (hangup/reload)"
    },
    {
      "name": "-INT",
      "description": "Send SIGINT (interrupt)"
    },
    {
      "name": "--signal",
      "description": "Signal to send, by name or number",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--list",
      "description": "List the signal names",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--table",
      "description": "Print a table of signals",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--queue",
      "description": "Send a queued signal with this value",
      "type": "integer",
      "takesValue": true,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--pid",
      "description": "Print the pid without signalling",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Report what is signalled",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--timeout",
      "description": "Send a follow-up signal after this many ms",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "kill 1234",
    "kill -9 1234",
    "kill -SIGTERM 1234",
    "kill -l",
    "kill -HUP $(cat app.pid)",
    "kill -0 1234  # check if process exists"
  ],
  "relatedCommands": [
    "killall",
    "pkill",
    "ps",
    "top",
    "signal"
  ]
}
