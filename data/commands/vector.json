{
  "name": "vector",
  "description": "High-performance observability data pipeline",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "validate",
      "description": "Validate a configuration",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--no-environment",
          "description": "Skip environment checks",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "test",
      "description": "Run configuration unit tests",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "top",
      "description": "Show a live topology dashboard",
      "options": [
        {
          "name": "--url",
          "description": "GraphQL API endpoint",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "tap",
      "description": "Observe events flowing between components",
      "options": [
        {
          "name": "--inputs-of",
          "description": "Tap the inputs of these components",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--outputs-of",
          "description": "Tap the outputs of these components",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "vrl",
      "description": "Run and test Vector Remap Language programs",
      "options": [
        {
          "name": "--input",
          "description": "Input event file",
          "type": "file",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--program",
          "description": "VRL program file",
          "type": "file",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "generate",
      "description": "Generate a configuration skeleton",
      "args": [
        {
          "name": "expression",
          "description": "Pipeline expression, e.g. stdin//console",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "graph",
      "description": "Emit the topology as DOT",
      "options": [
        {
          "name": "--config",
          "description": "Configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "list",
      "description": "List the available components"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--config-dir",
      "description": "Directory of configuration files",
      "type": "directory",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--require-healthy",
      "description": "Exit if any sink is unhealthy",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--threads",
      "description": "Worker threads",
      "type": "integer",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--watch-config",
      "description": "Reload on configuration change",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    }
  ],
  "examples": [
    {
      "command": "vector --config vector.yaml",
      "description": "Run the pipeline"
    },
    {
      "command": "vector validate -c vector.yaml",
      "description": "Validate the configuration"
    },
    {
      "command": "vector top",
      "description": "Watch a live topology dashboard"
    },
    {
      "command": "vector tap --outputs-of parse_logs",
      "description": "Observe events leaving a component"
    }
  ],
  "relatedCommands": [
    "fluent-bit",
    "telegraf",
    "otelcol",
    "logcli"
  ]
}
