{
  "name": "ts-node",
  "description": "TypeScript execution and REPL for Node",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--project",
      "description": "tsconfig file to use",
      "type": "file",
      "takesValue": true,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--transpile-only",
      "description": "Skip type checking",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--compiler",
      "description": "TypeScript compiler to use",
      "type": "string",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--require",
      "description": "Module to require first",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--eval",
      "description": "Evaluate this code",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--print",
      "description": "Evaluate and print the result",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--interactive",
      "description": "Start the REPL",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--swc",
      "description": "Transpile with swc instead of tsc",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--esm",
      "description": "Enable ESM support",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--files",
      "description": "Load files from tsconfig include and files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--script-mode",
      "description": "Resolve config relative to the entry script",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    }
  ],
  "examples": [
    {
      "command": "ts-node script.ts",
      "description": "Run a TypeScript file"
    },
    {
      "command": "ts-node -T script.ts",
      "description": "Run without type checking"
    },
    {
      "command": "ts-node -e \"console.log(1+1)\"",
      "description": "Evaluate an expression"
    },
    {
      "command": "ts-node --esm src/index.ts",
      "description": "Run an ESM entry point"
    }
  ],
  "relatedCommands": [
    "tsx",
    "node",
    "tsc",
    "typescript",
    "swc"
  ]
}
