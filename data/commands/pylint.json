{
  "name": "pylint",
  "description": "Static code analyser and linter for Python",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--disable",
      "description": "Message codes or categories to disable",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--enable",
      "description": "Message codes to enable",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--rcfile",
      "description": "Path to the configuration file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--output-format",
      "description": "Report format (text, json, colorized, parseable)",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--jobs",
      "description": "Number of parallel processes; 0 uses all cores",
      "type": "integer",
      "takesValue": true,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--errors-only",
      "description": "Report errors only",
      "type": "boolean",
      "takesValue": false,
      "short": "-E",
      "shorthand": "-E"
    },
    {
      "name": "--fail-under",
      "description": "Exit zero if the score is at least this",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--reports",
      "description": "Include the full report section",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--ignore",
      "description": "Files or directories to skip",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--generate-rcfile",
      "description": "Print a sample configuration",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "pylint src/",
      "description": "Analyse a package"
    },
    {
      "command": "pylint -E src/",
      "description": "Report only errors"
    },
    {
      "command": "pylint --generate-rcfile > .pylintrc",
      "description": "Write a starter configuration"
    }
  ],
  "relatedCommands": [
    "ruff",
    "flake8",
    "mypy",
    "black"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "pylint version",
        "command": "pylint --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "pylint"
      },
      {
        "name": "config",
        "description": "pylint configuration",
        "command": "cat .pylintrc 2>/dev/null | head -40 || grep -A20 '\\[tool.pylint' pyproject.toml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "virtualenv",
        "description": "Active Python virtual environment",
        "command": "echo \"${VIRTUAL_ENV:-none}\"",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
