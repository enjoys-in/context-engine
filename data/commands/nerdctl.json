{
  "name": "nerdctl",
  "description": "Docker-compatible CLI for containerd",
  "category": "container",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Create and start a container",
      "options": [
        {
          "name": "--detach",
          "description": "Run in the background",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--name",
          "description": "Assign a name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--publish",
          "description": "Publish a port",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--env",
          "description": "Set an environment variable",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--volume",
          "description": "Mount a volume",
          "type": "string",
          "takesValue": true,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--rm",
          "description": "Remove the container on exit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--gpus",
          "description": "GPUs to expose",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "build",
      "description": "Build an image from a Dockerfile",
      "options": [
        {
          "name": "--tag",
          "description": "Name and tag for the image",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--file",
          "description": "Dockerfile to use",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--no-cache",
          "description": "Ignore the build cache",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Target platform",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ps",
      "description": "List containers",
      "options": [
        {
          "name": "--all",
          "description": "Include stopped containers",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "images",
      "description": "List images",
      "options": [
        {
          "name": "--quiet",
          "description": "Print ids only",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "pull",
      "description": "Pull an image",
      "options": [
        {
          "name": "--platform",
          "description": "Platform to pull",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "push",
      "description": "Push an image",
      "options": [
        {
          "name": "--platform",
          "description": "Platform to push",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "exec",
      "description": "Run a command in a running container",
      "options": [
        {
          "name": "--interactive",
          "description": "Keep stdin open",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--tty",
          "description": "Allocate a pseudo-TTY",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to exec into",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "logs",
      "description": "Fetch container logs",
      "options": [
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tail",
          "description": "Lines to show from the end",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to act on",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "compose",
      "description": "Run a compose file",
      "options": [
        {
          "name": "--file",
          "description": "Compose file to use",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove containers",
      "options": [
        {
          "name": "--force",
          "description": "Remove a running container",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "container",
          "description": "Container to act on",
          "required": true,
          "type": "container",
          "completion": {
            "detector": "containers"
          }
        }
      ]
    },
    {
      "name": "rmi",
      "description": "Remove images",
      "options": [
        {
          "name": "--force",
          "description": "Remove even if tagged",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image reference to act on",
          "required": true,
          "type": "image",
          "completion": {
            "detector": "images"
          }
        }
      ]
    },
    {
      "name": "stats",
      "description": "Show a live resource usage stream",
      "options": [
        {
          "name": "--no-stream",
          "description": "Print a single sample rather than streaming",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--format",
          "description": "Output format as a Go template",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "namespace",
      "description": "Manage containerd namespaces",
      "options": []
    },
    {
      "name": "system",
      "description": "Show system-wide information",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--namespace",
      "description": "containerd namespace to use",
      "type": "string",
      "takesValue": true,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--address",
      "description": "containerd socket address",
      "type": "string",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--snapshotter",
      "description": "Snapshotter to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "nerdctl run -d -p 8080:80 nginx",
      "description": "Run a container in the background"
    },
    {
      "command": "nerdctl build -t app:dev .",
      "description": "Build an image"
    },
    {
      "command": "nerdctl ps -a",
      "description": "List every container"
    },
    {
      "command": "nerdctl -n k8s.io ps",
      "description": "List containers in the Kubernetes namespace"
    }
  ],
  "relatedCommands": [
    "docker",
    "podman",
    "ctr",
    "crictl",
    "containerd"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "nerdctl and containerd versions",
        "command": "nerdctl version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "nerdctl"
      },
      {
        "name": "containers",
        "description": "Containers nerdctl can see",
        "command": "nerdctl ps -a --format '{{.Names}}\\t{{.Status}}' 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 15,
        "requiresCmd": "nerdctl"
      },
      {
        "name": "images",
        "description": "Images in the containerd store",
        "command": "nerdctl images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "nerdctl"
      },
      {
        "name": "namespace",
        "description": "containerd namespace nerdctl is using",
        "command": "echo \"${CONTAINERD_NAMESPACE:-default}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
