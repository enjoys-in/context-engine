{
  "name": "cut",
  "description": "Remove sections from each line of files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-d",
      "description": "Use delimiter instead of TAB",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Select only these fields",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Select only these characters",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-b",
      "description": "Select only these bytes",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--complement",
      "description": "Complement the set of selected bytes/chars/fields"
    },
    {
      "name": "-s",
      "description": "Only print lines containing delimiters"
    },
    {
      "name": "--output-delimiter",
      "description": "Use string as the output delimiter",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "cut -d ',' -f 1,3 data.csv",
    "cut -c 1-10 file.txt",
    "echo $PATH | cut -d ':' -f 1",
    "cut -d ':' -f 1 /etc/passwd",
    "cut -f 2 data.tsv"
  ],
  "relatedCommands": [
    "awk",
    "paste",
    "tr"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "cut version",
        "command": "cut --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cut"
      },
      {
        "name": "delimited_files",
        "description": "Delimited files in this directory",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.tsv' -o -name '*.txt' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
