{
  "name": "doppler",
  "description": "Doppler CLI — centralized secrets management",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Login to Doppler",
      "examples": [
        "doppler login"
      ],
      "options": [
        {
          "name": "--scope",
          "description": "Directory this login applies to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-check-version",
          "description": "Skip the CLI version check",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--overwrite",
          "description": "Replace existing credentials",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "setup",
      "description": "Setup project config",
      "examples": [
        "doppler setup",
        "doppler setup --project my-project --config dev"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to select",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to select",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--no-interactive",
          "description": "Fail rather than prompting",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-prompt",
          "description": "Do not prompt for missing values",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "secrets",
      "description": "Manage secrets",
      "examples": [
        "doppler secrets",
        "doppler secrets get MY_SECRET",
        "doppler secrets set MY_SECRET=value",
        "doppler secrets set MY_SECRET=value MY_OTHER=val2",
        "doppler secrets delete MY_SECRET",
        "doppler secrets download --format json --no-file"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--only-names",
          "description": "List secret names without values",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw",
          "description": "Print unresolved secret values",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against secrets, such as get",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Run command with injected secrets",
      "examples": [
        "doppler run -- node server.js",
        "doppler run --command 'echo $MY_SECRET'",
        "doppler run -p my-project -c production -- ./start.sh"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--command",
          "description": "Shell command to run with the secrets injected",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--preserve-env",
          "description": "Keep existing environment variables",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--mount",
          "description": "Mount the secrets as a file at this path",
          "type": "path",
          "takesValue": true
        },
        {
          "name": "--name-transformer",
          "description": "Transform secret names to this convention",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "projects",
      "description": "Manage projects",
      "examples": [
        "doppler projects",
        "doppler projects create my-project",
        "doppler projects delete my-project"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--number",
          "description": "Number of results per page",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--page",
          "description": "Page of results to fetch",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against projects, such as create",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "configs",
      "description": "Manage configs",
      "examples": [
        "doppler configs",
        "doppler configs create -p my-project -e dev staging",
        "doppler configs delete -p my-project -c staging"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--environment",
          "description": "Environment to list configs for",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against configs, such as create",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "environments",
      "description": "Manage environments",
      "examples": [
        "doppler environments",
        "doppler environments create -p my-project staging"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against environments, such as create",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "import",
      "description": "Import secrets",
      "examples": [
        "doppler secrets upload secrets.env",
        "doppler secrets upload secrets.json"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--file",
          "description": "File to import secrets from",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Format of the file being imported",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "changelog",
      "description": "View secret change history",
      "examples": [
        "doppler changelog"
      ],
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--number",
          "description": "Number of entries to show",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "activity",
      "description": "View activity logs",
      "examples": [
        "doppler activity"
      ],
      "options": [
        {
          "name": "--project",
          "description": "Doppler project to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--config",
          "description": "Doppler config to use",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--token",
          "description": "Service token to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--number",
          "description": "Number of entries to show",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--page",
          "description": "Page of results to fetch",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "update",
      "description": "Update CLI",
      "examples": [
        "doppler update"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Reinstall even when already current",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "configure",
      "description": "View/set CLI config",
      "examples": [
        "doppler configure",
        "doppler configure flags --enable-dns-resolver"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Show configuration for every scope",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--scope",
          "description": "Directory scope to read or write",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Configure operation, such as get, set, unset or flags",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--project",
      "short": "-p",
      "description": "Project",
      "type": "string",
      "takesValue": true,
      "shorthand": "-p"
    },
    {
      "name": "--config",
      "short": "-c",
      "description": "Config",
      "type": "string",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--token",
      "short": "-t",
      "description": "Service token",
      "type": "string",
      "takesValue": true,
      "shorthand": "-t"
    },
    {
      "name": "--json",
      "description": "Output as JSON"
    },
    {
      "name": "--no-file",
      "description": "Print to stdout"
    }
  ],
  "examples": [
    "doppler login",
    "doppler setup",
    "doppler secrets",
    "doppler run -- node server.js",
    "doppler secrets set DB_URL=postgres://...",
    "doppler secrets download --format json --no-file",
    "doppler projects",
    "doppler run -p api -c production -- ./start.sh"
  ],
  "relatedCommands": [
    "vault",
    "chamber",
    "sops",
    "infisical"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Doppler CLI version",
        "command": "doppler --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "doppler"
      },
      {
        "name": "setup",
        "description": "Doppler project and config for this directory",
        "command": "doppler configure get project config --plain 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "doppler"
      },
      {
        "name": "config_file",
        "description": "Doppler local configuration",
        "command": "cat doppler.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "me",
        "description": "Authenticated Doppler identity",
        "command": "doppler me --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300,
        "requiresCmd": "doppler"
      }
    ]
  }
}
