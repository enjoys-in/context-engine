{
  "name": "xz",
  "description": "Compress or expand files with LZMA2 (.xz)",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--decompress",
      "description": "Expand instead of compress",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--list",
      "description": "Show archive information",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--threads",
      "description": "Worker threads; 0 uses all cores",
      "type": "integer",
      "takesValue": true,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--extreme",
      "description": "Spend more time for a better ratio",
      "type": "boolean",
      "takesValue": false,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--compress",
      "description": "Force compression",
      "type": "boolean",
      "takesValue": false,
      "short": "-z",
      "shorthand": "-z"
    },
    {
      "name": "--verbose",
      "description": "Report progress",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "xz -k -T0 image.iso",
      "description": "Compress using every core, keeping the input"
    },
    {
      "command": "xz -d image.iso.xz",
      "description": "Expand an archive"
    },
    {
      "command": "xz -l image.iso.xz",
      "description": "Inspect an archive"
    },
    {
      "command": "tar cJf out.tar.xz dir/",
      "description": "Compress a directory through tar"
    }
  ],
  "relatedCommands": [
    "unxz",
    "gzip",
    "zstd",
    "bzip2",
    "tar"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "XZ Utils version",
        "command": "xz --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "xz"
      },
      {
        "name": "compressible",
        "description": "Files in this directory xz could compress",
        "command": "find . -maxdepth 2 -type f -name '*.tar' -o -name '*.log' -o -name '*.sql' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "cpu_count",
        "description": "CPUs available for threaded compression",
        "command": "nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
