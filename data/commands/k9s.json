{
  "name": "k9s",
  "description": "K9s — terminal UI for managing Kubernetes clusters",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "(default)",
      "description": "Launch interactive cluster UI",
      "examples": [
        "k9s",
        "k9s -n my-namespace",
        "k9s --context my-context"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to start in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--refresh",
          "description": "Refresh interval in seconds",
          "type": "integer",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "-c / --command",
      "description": "Jump to specific resource view",
      "examples": [
        "k9s -c pod",
        "k9s -c deploy",
        "k9s -c svc",
        "k9s -c ns",
        "k9s -c node",
        "k9s -c sts",
        "k9s -c job",
        "k9s -c cj",
        "k9s -c cm",
        "k9s -c secret",
        "k9s -c ingress",
        "k9s -c pv"
      ],
      "options": [
        {
          "name": "--command",
          "description": "Resource view to open on start",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "--readonly",
      "description": "Launch in read-only mode",
      "examples": [
        "k9s --readonly"
      ],
      "options": [
        {
          "name": "--readonly",
          "description": "Disable every modifying command",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "--all-namespaces",
      "description": "Launch watching all namespaces",
      "examples": [
        "k9s -A"
      ],
      "options": [
        {
          "name": "--all-namespaces",
          "description": "Start with every namespace selected",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        }
      ]
    },
    {
      "name": "--headless",
      "description": "Run without header/footer",
      "examples": [
        "k9s --headless"
      ],
      "options": [
        {
          "name": "--headless",
          "description": "Hide the header pane",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "--write",
      "description": "Log output to file",
      "examples": [
        "k9s --write /tmp/k9s.log"
      ],
      "options": [
        {
          "name": "--write",
          "description": "Enable modifying commands",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "info",
      "description": "Print cluster info",
      "examples": [
        "k9s info"
      ],
      "options": []
    },
    {
      "name": "version",
      "description": "Print version",
      "examples": [
        "k9s version"
      ],
      "options": [
        {
          "name": "--short",
          "description": "Print the version only",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "help",
      "description": "Print help",
      "examples": [
        "k9s help"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Target namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--command",
      "short": "-c",
      "description": "Resource view to open",
      "type": "string",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--readonly",
      "description": "Read-only mode"
    },
    {
      "name": "--all-namespaces",
      "short": "-A",
      "description": "All namespaces",
      "shorthand": "-A"
    },
    {
      "name": "--headless",
      "description": "No header/footer"
    },
    {
      "name": "--write",
      "description": "Log file path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--crumbsless",
      "description": "Hide breadcrumbs"
    },
    {
      "name": "--logoless",
      "description": "Hide logo"
    },
    {
      "name": "--refresh",
      "short": "-r",
      "description": "Refresh rate",
      "type": "number",
      "takesValue": true,
      "shorthand": "-r"
    }
  ],
  "examples": [
    "k9s",
    "k9s -n production",
    "k9s --context staging",
    "k9s -c pod",
    "k9s -c deploy",
    "k9s -A",
    "k9s --readonly",
    "k9s -c svc -n default",
    "k9s info",
    "k9s version"
  ],
  "relatedCommands": [
    "kubectl",
    "kubectx",
    "kubens",
    "stern",
    "helm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "k9s version",
        "command": "k9s version --short 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "k9s"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "config",
        "description": "k9s configuration",
        "command": "cat ~/.config/k9s/config.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "contexts",
        "description": "Kubeconfig contexts k9s can switch to",
        "command": "kubectl config get-contexts -o name 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "kubectl"
      }
    ]
  }
}
