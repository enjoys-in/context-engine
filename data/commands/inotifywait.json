{
  "name": "inotifywait",
  "description": "Wait for changes to files using inotify (Linux)",
  "category": "utilities",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-m",
      "description": "Monitor continuously"
    },
    {
      "name": "-r",
      "description": "Recursive"
    },
    {
      "name": "-e",
      "description": "Events to watch (modify,create,delete,move,access)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--format",
      "description": "Output format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "--exclude",
      "description": "Exclude pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--include",
      "description": "Include pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Timeout in seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--timefmt",
      "description": "Time format string",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "inotifywait -m -r /path/to/dir",
    "inotifywait -m -e modify,create,delete /path",
    "inotifywait -mrq -e modify src/ | while read path action file; do echo \"$action $file\"; done",
    "inotifywait -e modify script.sh && ./script.sh"
  ],
  "relatedCommands": [
    "entr",
    "fswatch",
    "watch",
    "find"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "inotify-tools version",
        "command": "inotifywait --help 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "inotifywait"
      },
      {
        "name": "watch_limit",
        "description": "Maximum inotify watches per user",
        "command": "cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "instance_limit",
        "description": "Maximum inotify instances per user",
        "command": "cat /proc/sys/fs/inotify/max_user_instances 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
