{
  "language": "elixir",
  "name": "mix",
  "description": "Elixir command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "new project_name",
      "description": "Create new Elixir project",
      "args": [],
      "options": [
        {
          "name": "--app",
          "description": "OTP application name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--module",
          "description": "Root module name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--sup",
          "description": "Generate an OTP application with a supervision tree",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--umbrella",
          "description": "Generate an umbrella project",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix new project_name"
      ]
    },
    {
      "name": "deps.get",
      "description": "Fetch dependencies",
      "args": [],
      "options": [
        {
          "name": "--only",
          "description": "Only fetch dependencies for this environment",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--check-locked",
          "description": "Fail if the lockfile would change",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix deps.get"
      ]
    },
    {
      "name": "compile",
      "description": "Compile project",
      "args": [],
      "options": [
        {
          "name": "--force",
          "description": "Recompile everything",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--warnings-as-errors",
          "description": "Treat warnings as errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-deps-check",
          "description": "Skip the dependency check",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix compile"
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "args": [],
      "options": [
        {
          "name": "--cover",
          "description": "Collect coverage information",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--trace",
          "description": "Run synchronously and print each test",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--only",
          "description": "Only run tests with this tag",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--failed",
          "description": "Only re-run previously failed tests",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--seed",
          "description": "Seed for test ordering",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "mix test"
      ]
    },
    {
      "name": "format",
      "description": "Format code",
      "args": [
        {
          "name": "files",
          "description": "Files to format",
          "required": false,
          "type": "path"
        }
      ],
      "options": [
        {
          "name": "--check-formatted",
          "description": "Fail rather than rewriting files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix format ./src"
      ]
    },
    {
      "name": "phx.new app",
      "description": "Create Phoenix app",
      "args": [],
      "options": [
        {
          "name": "--database",
          "description": "Database adapter to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-html",
          "description": "Skip the HTML layer",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-ecto",
          "description": "Skip Ecto and the database layer",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--live",
          "description": "Include Phoenix LiveView",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--umbrella",
          "description": "Generate an umbrella project",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix phx.new app"
      ]
    },
    {
      "name": "phx.server",
      "description": "Start Phoenix server",
      "args": [],
      "options": [
        {
          "name": "--open",
          "description": "Open a browser once the server starts",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix phx.server"
      ]
    },
    {
      "name": "ecto.create",
      "description": "Create database",
      "args": [],
      "options": [
        {
          "name": "--repo",
          "description": "Repository to act on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix ecto.create"
      ]
    },
    {
      "name": "ecto.migrate",
      "description": "Run migrations",
      "args": [],
      "options": [
        {
          "name": "--repo",
          "description": "Repository to act on",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--all",
          "description": "Run every pending migration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--step",
          "description": "Run this many migrations",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--to",
          "description": "Migrate up to this version",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--log-sql",
          "description": "Log the SQL that is executed",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "mix ecto.migrate"
      ]
    }
  ],
  "examples": [
    {
      "command": "mix new my_app",
      "description": "Create new Elixir project"
    },
    {
      "command": "mix deps.get",
      "description": "Fetch dependencies"
    },
    {
      "command": "mix test",
      "description": "Run tests"
    },
    {
      "command": "mix phx.server",
      "description": "Start Phoenix server"
    },
    {
      "command": "iex -S mix",
      "description": "Start interactive shell with project loaded"
    }
  ],
  "relatedCommands": [
    "mix",
    "iex",
    "elixirc",
    "hex"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Elixir and Mix versions",
        "command": "mix --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mix"
      },
      {
        "name": "project",
        "description": "Mix project definition",
        "command": "cat mix.exs 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "env",
        "description": "Mix environment in effect",
        "command": "echo \"${MIX_ENV:-dev}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "deps_dir",
        "description": "Fetched Elixir dependencies",
        "command": "ls deps 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
