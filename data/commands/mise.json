{
  "name": "mise",
  "description": "Development environment setup tool (successor to asdf)",
  "category": "version-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a tool version",
      "examples": [
        "mise install node@20",
        "mise install python@3.12"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--force",
          "description": "Reinstall even when already present",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--jobs",
          "description": "Number of parallel installs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ],
      "args": [
        {
          "name": "tool",
          "description": "Tool and version to install",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "use",
      "description": "Set active tool version",
      "examples": [
        "mise use node@20",
        "mise use --global python@3.12"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--global",
          "description": "Write to the global config",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--env",
          "description": "Write to this environment's config",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--pin",
          "description": "Pin the exact resolved version",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--fuzzy",
          "description": "Keep the version prefix loose",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "tool",
          "description": "Tool and version to activate",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "ls",
      "description": "List installed versions",
      "examples": [
        "mise ls",
        "mise ls node"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--current",
          "description": "Only show active versions",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--global",
          "description": "Only show globally configured versions",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false,
          "short": "-J",
          "shorthand": "-J"
        },
        {
          "name": "--installed",
          "description": "Only show installed versions",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "ls-remote",
      "description": "List remote available versions",
      "examples": [
        "mise ls-remote node"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "current",
      "description": "Show currently active versions",
      "examples": [
        "mise current"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute a command with tool versions",
      "examples": [
        "mise exec node@18 -- node -v"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--command",
          "description": "Command to run",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--jobs",
          "description": "Number of parallel installs",
          "type": "integer",
          "takesValue": true,
          "short": "-j",
          "shorthand": "-j"
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "env",
      "description": "Show env vars for active tools",
      "examples": [
        "mise env"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--shell",
          "description": "Shell syntax to emit",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false,
          "short": "-J",
          "shorthand": "-J"
        }
      ]
    },
    {
      "name": "activate",
      "description": "Add mise activation to shell",
      "examples": [
        "mise activate bash"
      ],
      "options": [
        {
          "name": "--shell",
          "description": "Shell to emit activation code for",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--status",
          "description": "Show the tool versions on directory change",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "shell",
          "description": "Shell to emit activation code for",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "trust",
      "description": "Trust a .mise.toml config file",
      "examples": [
        "mise trust"
      ],
      "options": [
        {
          "name": "--cd",
          "description": "Change to this directory first",
          "type": "directory",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--quiet",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--all",
          "description": "Trust every config file",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--untrust",
          "description": "Remove trust from the config",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Config file or directory to trust",
          "required": false,
          "type": "path"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    },
    {
      "name": "--yes",
      "short": "-y",
      "description": "Auto-confirm prompts",
      "shorthand": "-y"
    }
  ],
  "examples": [
    "mise install node@20",
    "mise use node@20",
    "mise ls",
    "mise current",
    "mise use --global python@3.12"
  ],
  "relatedCommands": [
    "asdf",
    "nvm",
    "pyenv",
    "volta"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "mise version",
        "command": "mise --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mise"
      },
      {
        "name": "current",
        "description": "Tools mise has active in this directory",
        "command": "mise current 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 60,
        "requiresCmd": "mise"
      },
      {
        "name": "config",
        "description": "mise configuration for this project",
        "command": "cat .mise.toml 2>/dev/null || cat mise.toml 2>/dev/null || cat .tool-versions 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "installed",
        "description": "Tool versions mise manages",
        "command": "mise list 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "mise"
      }
    ]
  }
}
