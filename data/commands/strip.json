{
  "name": "strip",
  "description": "Remove symbols and debug information from binaries",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strip-all",
      "description": "Remove every symbol",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--strip-debug",
      "description": "Remove debug symbols only",
      "type": "boolean",
      "takesValue": false,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--strip-unneeded",
      "description": "Remove symbols not needed for relocation",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--output-file",
      "description": "Write to this file rather than in place",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--keep-symbol",
      "description": "Keep this symbol",
      "type": "string",
      "takesValue": true,
      "short": "-K",
      "shorthand": "-K"
    },
    {
      "name": "--remove-section",
      "description": "Remove this section",
      "type": "string",
      "takesValue": true,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--only-keep-debug",
      "description": "Keep only the debug information",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--discard-locals",
      "description": "Remove compiler-generated local symbols",
      "type": "boolean",
      "takesValue": false,
      "short": "-X",
      "shorthand": "-X"
    }
  ],
  "examples": [
    {
      "command": "strip prog",
      "description": "Remove all symbols"
    },
    {
      "command": "strip -g prog",
      "description": "Remove debug symbols only"
    },
    {
      "command": "strip --only-keep-debug prog -o prog.debug",
      "description": "Split the debug information out"
    },
    {
      "command": "strip --strip-unneeded libx.so",
      "description": "Shrink a shared library"
    }
  ],
  "relatedCommands": [
    "objdump",
    "nm",
    "gdb",
    "ld"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GNU strip version",
        "command": "strip --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "strip"
      },
      {
        "name": "binaries",
        "description": "Binaries in this project and their sizes",
        "command": "find . -maxdepth 2 -type f -perm -u+x -exec ls -lh {} + 2>/dev/null | head -15",
        "parser": "table",
        "cacheFor": 120
      },
      {
        "name": "objects",
        "description": "Object files and libraries in this project",
        "command": "find . -maxdepth 3 -name '*.o' -o -name '*.a' -o -name '*.so' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
