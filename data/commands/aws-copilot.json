{
  "name": "aws-copilot",
  "description": "AWS Copilot — build, release, and operate containerized apps on ECS/Fargate",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a new application",
      "examples": [
        "copilot init",
        "copilot init --app my-app --name api --type 'Load Balanced Web Service' --dockerfile ./Dockerfile --deploy"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Application name",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Service or job name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--svc-type",
          "description": "Service type to create",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--dockerfile",
          "description": "Dockerfile to build from",
          "type": "file",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--deploy",
          "description": "Deploy immediately after initialising",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--port",
          "description": "Port the container listens on",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "app",
      "description": "Manage applications",
      "examples": [
        "copilot app init my-app",
        "copilot app show",
        "copilot app ls",
        "copilot app delete"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "env",
      "description": "Manage environments",
      "examples": [
        "copilot env init --name prod --profile prod --default-config",
        "copilot env deploy --name prod",
        "copilot env ls",
        "copilot env show --name prod",
        "copilot env delete --name staging"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--profile",
          "description": "AWS profile for the environment account",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "svc",
      "description": "Manage services",
      "examples": [
        "copilot svc init --name api --svc-type 'Load Balanced Web Service'",
        "copilot svc deploy --name api",
        "copilot svc ls",
        "copilot svc show --name api",
        "copilot svc status --name api",
        "copilot svc logs --name api --follow",
        "copilot svc exec --name api",
        "copilot svc delete --name api"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to act on",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "job",
      "description": "Manage scheduled jobs",
      "examples": [
        "copilot job init --name report --dockerfile ./Dockerfile --schedule '@daily'",
        "copilot job deploy --name report",
        "copilot job ls",
        "copilot job logs --name report"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to act on",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "pipeline",
      "description": "Manage CI/CD pipelines",
      "examples": [
        "copilot pipeline init",
        "copilot pipeline deploy",
        "copilot pipeline show",
        "copilot pipeline status"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to act on",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "storage",
      "description": "Manage storage resources",
      "examples": [
        "copilot storage init --name my-table --storage-type DynamoDB --workload api",
        "copilot storage init --name my-bucket --storage-type S3 --workload api"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--storage-type",
          "description": "Storage type to create",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--workload",
          "description": "Workload to attach the storage to",
          "type": "string",
          "takesValue": true,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "secret",
      "description": "Manage secrets",
      "examples": [
        "copilot secret init --name DB_PASSWORD",
        "copilot secret init --name API_KEY --values prod=xxx,staging=yyy"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--values",
          "description": "Environment-to-value mapping for the secret",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--overwrite",
          "description": "Replace an existing secret",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "task",
      "description": "Run one-off tasks",
      "examples": [
        "copilot task run --command 'python migrate.py'",
        "copilot task run --image public.ecr.aws/nginx/nginx --command '/bin/sh'"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to run in",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--command",
          "description": "Command to run in the task",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--follow",
          "description": "Stream the task logs",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy service to environment",
      "examples": [
        "copilot deploy",
        "copilot deploy --name api --env prod"
      ],
      "options": [
        {
          "name": "--app",
          "description": "Copilot application to act on",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--name",
          "description": "Resource name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--yes",
          "description": "Skip confirmation prompts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to deploy to",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--tag",
          "description": "Image tag to deploy",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Force a new deployment",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Print version",
      "examples": [
        "copilot version"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--app",
      "description": "Application name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--env",
      "description": "Environment name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--name",
      "description": "Service/job name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--json",
      "description": "Output as JSON"
    },
    {
      "name": "--yes",
      "description": "Skip confirmation prompts"
    }
  ],
  "examples": [
    "copilot init",
    "copilot svc deploy --name api",
    "copilot svc logs --name api --follow",
    "copilot env init --name prod",
    "copilot svc status --name api",
    "copilot pipeline init",
    "copilot task run --command 'python migrate.py'",
    "copilot secret init --name DB_PASSWORD"
  ],
  "relatedCommands": [
    "aws",
    "docker",
    "ecs-cli",
    "kubectl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Copilot CLI version",
        "command": "copilot --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "copilot"
      },
      {
        "name": "app",
        "description": "Copilot application manifest",
        "command": "cat copilot/.workspace 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "services",
        "description": "Copilot service manifests in this workspace",
        "command": "ls copilot 2>/dev/null | grep -v '^\\.' | head -20",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
