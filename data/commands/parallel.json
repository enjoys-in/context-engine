{
  "name": "parallel",
  "description": "GNU Parallel — build and execute shell command lines in parallel",
  "category": "utilities",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-j",
      "description": "Number of parallel jobs",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--eta",
      "description": "Show estimated time of arrival"
    },
    {
      "name": "--progress",
      "description": "Show progress"
    },
    {
      "name": "--bar",
      "description": "Show progress bar"
    },
    {
      "name": "--dry-run",
      "description": "Print commands without executing"
    },
    {
      "name": "-k",
      "description": "Keep output order same as input"
    },
    {
      "name": "--halt",
      "description": "Stop condition (now,fail=1 etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-a",
      "description": "Read input from file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--colsep",
      "description": "Column separator for input",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--pipe",
      "description": "Pipe input to commands"
    }
  ],
  "examples": [
    "parallel gzip ::: *.log",
    "ls *.jpg | parallel convert {} -resize 50% sm_{}",
    "parallel -j 4 wget ::: url1 url2 url3 url4",
    "seq 10 | parallel -j 4 'echo {}'",
    "parallel --eta 'sleep {}' ::: 1 2 3 4 5"
  ],
  "relatedCommands": [
    "xargs",
    "make",
    "bash"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GNU parallel version",
        "command": "parallel --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "parallel"
      },
      {
        "name": "cpu_count",
        "description": "Logical CPUs parallel will use by default",
        "command": "nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "GNU parallel configuration",
        "command": "cat ~/.parallel/config 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
