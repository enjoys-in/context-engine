{
  "name": "colima",
  "description": "Container runtimes on macOS with minimal setup",
  "category": "container",
  "platforms": [
    "macos",
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start a Colima instance",
      "options": [
        {
          "name": "--cpu",
          "description": "CPU cores to allocate",
          "type": "integer",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--memory",
          "description": "Memory in GiB",
          "type": "integer",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--disk",
          "description": "Disk size in GiB",
          "type": "integer",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--runtime",
          "description": "Container runtime (docker, containerd)",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--kubernetes",
          "description": "Also start Kubernetes",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--arch",
          "description": "Architecture to emulate",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--vm-type",
          "description": "Virtual machine type (qemu, vz)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "stop",
      "description": "Stop the instance",
      "options": [
        {
          "name": "--force",
          "description": "Stop without a graceful shutdown",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete the instance",
      "options": [
        {
          "name": "--force",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "restart",
      "description": "Restart the instance",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to act on",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "status",
      "description": "Show the instance status",
      "options": [
        {
          "name": "--extended",
          "description": "Include more detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "list",
      "description": "List the instances",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ssh",
      "description": "Open a shell inside the instance",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to connect to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "nerdctl",
      "description": "Run nerdctl inside the instance",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to act on",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "kubernetes",
      "description": "Manage the Kubernetes cluster",
      "options": [
        {
          "name": "--profile",
          "description": "Profile to act on",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "template",
      "description": "Edit the default configuration",
      "options": [
        {
          "name": "--editor",
          "description": "Editor to open the template in",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--profile",
      "description": "Instance profile to operate on",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "colima start",
      "description": "Start with the defaults"
    },
    {
      "command": "colima start -c 4 -m 8 -k",
      "description": "Start with 4 CPUs, 8 GiB and Kubernetes"
    },
    {
      "command": "colima status",
      "description": "Check the instance status"
    },
    {
      "command": "colima delete",
      "description": "Remove the instance"
    }
  ],
  "relatedCommands": [
    "docker",
    "lima",
    "podman",
    "nerdctl",
    "minikube"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Colima version",
        "command": "colima version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "colima"
      },
      {
        "name": "status",
        "description": "Colima VM status",
        "command": "colima status 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "colima"
      },
      {
        "name": "profiles",
        "description": "Colima profiles on this machine",
        "command": "colima list 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "colima"
      },
      {
        "name": "docker_context",
        "description": "Docker context Colima registered",
        "command": "docker context ls 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "docker"
      }
    ]
  }
}
