{
  "name": "find",
  "description": "Search for files in a directory hierarchy",
  "category": "filesystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-name",
      "description": "Match filename (case sensitive)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-iname",
      "description": "Match filename (case insensitive)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-type",
      "description": "File type (f=file, d=directory, l=symlink)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-size",
      "description": "File size (+10M, -1k, 100c)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-mtime",
      "description": "Modified time in days",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-mmin",
      "description": "Modified time in minutes",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-newer",
      "description": "Modified more recently than file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-user",
      "description": "Owned by user",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-group",
      "description": "Owned by group",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-perm",
      "description": "Match permissions",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-maxdepth",
      "description": "Maximum directory depth",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-mindepth",
      "description": "Minimum directory depth",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-exec",
      "description": "Execute command on each result",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-delete",
      "description": "Delete matching files"
    },
    {
      "name": "-print",
      "description": "Print full file name"
    },
    {
      "name": "-print0",
      "description": "Print null-separated results"
    },
    {
      "name": "-empty",
      "description": "Match empty files/directories"
    },
    {
      "name": "-not",
      "description": "Negate following expression"
    },
    {
      "name": "-or",
      "short": "-o",
      "description": "OR expression"
    },
    {
      "name": "-path",
      "description": "Match path pattern",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-prune",
      "description": "Don't descend into directory"
    },
    {
      "name": "-regex",
      "description": "Match path with regex",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "find . -name '*.js'",
    "find . -type f -name '*.log' -mtime +30 -delete",
    "find /var -type f -size +100M",
    "find . -type d -empty",
    "find . -name '*.py' -exec grep -l 'import os' {} +",
    "find . -type f -not -path './node_modules/*'",
    "find . -name '*.tmp' -print0 | xargs -0 rm",
    "find . -maxdepth 2 -name 'Makefile'",
    "find . -newer reference_file -type f"
  ],
  "relatedCommands": [
    "fd",
    "locate",
    "which",
    "whereis",
    "ls"
  ]
}
