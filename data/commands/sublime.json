{
  "name": "sublime",
  "aliases": [
    "subl"
  ],
  "description": "Sublime Text command line interface",
  "category": "editor",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--new-window",
      "description": "Open in a new window",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--add",
      "description": "Add folders to the current window",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--wait",
      "description": "Wait for the file to be closed",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--background",
      "description": "Do not activate the application",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--stay",
      "description": "Keep the current application active",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--project",
      "description": "Open this project file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--command",
      "description": "Run a Sublime command",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--safe-mode",
      "description": "Start without packages or settings",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "subl .",
      "description": "Open the current directory"
    },
    {
      "command": "subl -n file.txt",
      "description": "Open in a new window"
    },
    {
      "command": "subl -w commit-message.txt",
      "description": "Open and wait, for use as an editor"
    },
    {
      "command": "subl --project app.sublime-project",
      "description": "Open a project"
    }
  ],
  "relatedCommands": [
    "code",
    "vim",
    "nano",
    "helix"
  ]
}
