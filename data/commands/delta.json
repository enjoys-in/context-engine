{
  "name": "delta",
  "description": "Syntax-highlighting pager for git, diff and grep output",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--side-by-side",
      "description": "Show the diff in two columns",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--line-numbers",
      "description": "Show line numbers",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--navigate",
      "description": "Enable n and N to move between files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dark",
      "description": "Use a dark background theme",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--light",
      "description": "Use a light background theme",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--syntax-theme",
      "description": "Syntax highlighting theme",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--features",
      "description": "Named feature sets from the config to enable",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--diff-so-fancy",
      "description": "Emulate diff-so-fancy output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--width",
      "description": "Output width in columns",
      "type": "string",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--paging",
      "description": "When to page (auto, always, never)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--wrap-max-lines",
      "description": "Maximum wrapped lines per diff line",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--list-syntax-themes",
      "description": "List the available themes",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "git diff | delta",
      "description": "Pipe a diff through delta"
    },
    {
      "command": "delta --side-by-side old.py new.py",
      "description": "Compare two files side by side"
    },
    {
      "command": "git config --global core.pager delta",
      "description": "Use delta as git’s pager"
    },
    {
      "command": "delta --list-syntax-themes",
      "description": "List the available themes"
    }
  ],
  "relatedCommands": [
    "git",
    "diff",
    "bat",
    "less"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "delta version",
        "command": "delta --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "delta"
      },
      {
        "name": "git_pager",
        "description": "Git pager configuration",
        "command": "git config --get core.pager 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "features",
        "description": "delta features configured in git",
        "command": "git config --get-regexp '^delta\\.' 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300
      },
      {
        "name": "theme",
        "description": "Syntax theme delta will use",
        "command": "git config --get delta.syntax-theme 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
