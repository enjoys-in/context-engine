{
  "name": "pgcli",
  "description": "PostgreSQL client with auto-completion and syntax highlighting",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--host",
      "description": "Server host",
      "type": "string",
      "takesValue": true,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--port",
      "description": "Server port",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--username",
      "description": "Username to connect as",
      "type": "string",
      "takesValue": true,
      "short": "-U",
      "shorthand": "-U"
    },
    {
      "name": "--dbname",
      "description": "Database to connect to",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--password",
      "description": "Prompt for a password",
      "type": "boolean",
      "takesValue": false,
      "short": "-W",
      "shorthand": "-W"
    },
    {
      "name": "--no-password",
      "description": "Never prompt for a password",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--execute",
      "description": "Run this command and exit",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--single-connection",
      "description": "Use one connection, no completion refresh",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--pgclirc",
      "description": "Configuration file to use",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--row-limit",
      "description": "Rows before prompting",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--less-chatty",
      "description": "Skip the intro banner",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "pgcli -h localhost -U postgres app",
      "description": "Connect to a database"
    },
    {
      "command": "pgcli postgres://user@host:5432/app",
      "description": "Connect with a URL"
    },
    {
      "command": "pgcli -c \"SELECT count(*) FROM users\" app",
      "description": "Run one query and exit"
    }
  ],
  "relatedCommands": [
    "psql",
    "mycli",
    "litecli",
    "pgsql"
  ]
}
