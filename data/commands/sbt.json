{
  "name": "sbt",
  "description": "Interactive build tool for Scala and Java",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "compile",
      "description": "Compile the main sources"
    },
    {
      "name": "test",
      "description": "Run the test suite"
    },
    {
      "name": "testOnly",
      "description": "Run only the named tests",
      "args": [
        {
          "name": "spec",
          "description": "Test class pattern",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Run the main class"
    },
    {
      "name": "package",
      "description": "Produce a jar of the main classes"
    },
    {
      "name": "assembly",
      "description": "Produce a fat jar including dependencies"
    },
    {
      "name": "publishLocal",
      "description": "Publish artifacts to the local repository"
    },
    {
      "name": "publish",
      "description": "Publish artifacts to the configured repository"
    },
    {
      "name": "clean",
      "description": "Delete the build outputs"
    },
    {
      "name": "console",
      "description": "Start a Scala REPL with the project on the classpath"
    },
    {
      "name": "reload",
      "description": "Reload the build definition"
    },
    {
      "name": "dependencyTree",
      "description": "Print the dependency tree"
    },
    {
      "name": "scalafmtAll",
      "description": "Format every Scala source"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--batch",
      "description": "Run non-interactively",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--client",
      "description": "Connect to a running sbt server",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--java-home",
      "description": "JDK to build with",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--mem",
      "description": "Heap size in megabytes",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-colors",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--supershell",
      "description": "Control the supershell UI",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "sbt compile",
      "description": "Compile the project"
    },
    {
      "command": "sbt test",
      "description": "Run the tests"
    },
    {
      "command": "sbt \"testOnly *UserSpec\"",
      "description": "Run one test class"
    },
    {
      "command": "sbt --batch clean compile",
      "description": "Run tasks non-interactively"
    }
  ],
  "relatedCommands": [
    "scala",
    "mill",
    "gradle",
    "mvn",
    "coursier"
  ]
}
