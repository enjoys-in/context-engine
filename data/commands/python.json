{
  "language": "python",
  "name": "python",
  "aliases": [
    "python3"
  ],
  "description": "Interpreted, high-level, general-purpose programming language",
  "category": "runtime",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--version",
      "short": "-V",
      "description": "Print Python version",
      "shorthand": "-V"
    },
    {
      "name": "-c",
      "description": "Execute code passed as string",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-m",
      "description": "Run library module as script",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Inspect interactively after running script"
    },
    {
      "name": "-u",
      "description": "Unbuffered binary stdout and stderr"
    },
    {
      "name": "-B",
      "description": "Don't write .pyc files"
    },
    {
      "name": "-O",
      "description": "Optimize bytecode"
    },
    {
      "name": "-W",
      "description": "Warning control",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "-E",
      "description": "Ignore PYTHON* environment variables"
    },
    {
      "name": "-q",
      "description": "Don't print version on interactive startup"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [],
  "examples": [
    "python script.py",
    "python -c \"print('hello')\"",
    "python -m http.server 8080",
    "python -m venv .venv",
    "python -m pytest",
    "python -m pip install requests"
  ],
  "relatedCommands": [
    "pip",
    "python3",
    "pipx",
    "poetry",
    "conda",
    "virtualenv",
    "pyenv"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Python interpreter version",
        "command": "python3 --version 2>&1 || python --version 2>&1",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "virtualenv",
        "description": "Active Python virtual environment",
        "command": "echo \"${VIRTUAL_ENV:-none}\"",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "executable",
        "description": "Python interpreter that will run",
        "command": "which python3 python 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "project",
        "description": "Python project configuration",
        "command": "cat pyproject.toml 2>/dev/null | head -40 || cat setup.py 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "requirements",
        "description": "Dependency files in this project",
        "command": "ls requirements*.txt Pipfile poetry.lock uv.lock 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
