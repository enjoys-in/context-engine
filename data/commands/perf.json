{
  "name": "perf",
  "description": "Linux performance analysis and profiling",
  "category": "toolchain",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "stat",
      "description": "Count performance events for a command",
      "options": [
        {
          "name": "--event",
          "description": "Events to count",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--all-cpus",
          "description": "Count across every CPU",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--repeat",
          "description": "Repeat the run this many times",
          "type": "integer",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--detailed",
          "description": "Print more counters",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "examples": [
        "perf stat"
      ]
    },
    {
      "name": "record",
      "description": "Sample a command or the system into perf.data",
      "options": [
        {
          "name": "--event",
          "description": "Events to sample",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--freq",
          "description": "Sampling frequency in hertz",
          "type": "integer",
          "takesValue": true,
          "short": "-F",
          "shorthand": "-F"
        },
        {
          "name": "--all-cpus",
          "description": "Sample every CPU",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--call-graph",
          "description": "Capture call graphs (fp, dwarf, lbr)",
          "type": "string",
          "takesValue": true,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--pid",
          "description": "Sample this process",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--output",
          "description": "Write samples to this file",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "examples": [
        "perf record"
      ]
    },
    {
      "name": "report",
      "description": "Summarise a recorded profile",
      "options": [
        {
          "name": "--input",
          "description": "Profile to read",
          "type": "file",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--sort",
          "description": "Sort by these keys",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--stdio",
          "description": "Print a plain-text report",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--children",
          "description": "Accumulate child costs into callers",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "perf report"
      ]
    },
    {
      "name": "top",
      "description": "Show a live profile",
      "options": [
        {
          "name": "--event",
          "description": "Events to sample",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--pid",
          "description": "Profile this process",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "perf top"
      ]
    },
    {
      "name": "script",
      "description": "Print the raw samples, for flame graphs",
      "options": [
        {
          "name": "--input",
          "description": "Profile to read",
          "type": "file",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ],
      "examples": [
        "perf script"
      ]
    },
    {
      "name": "annotate",
      "description": "Show per-instruction costs",
      "options": [
        {
          "name": "--symbol",
          "description": "Symbol to annotate",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "symbol",
          "description": "Symbol to annotate",
          "required": false,
          "type": "string"
        }
      ],
      "examples": [
        "perf annotate symbol"
      ]
    },
    {
      "name": "list",
      "description": "List the available events",
      "options": [
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "perf list"
      ]
    },
    {
      "name": "diff",
      "description": "Compare two recorded profiles",
      "options": [
        {
          "name": "--sort",
          "description": "Field to sort by",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--percentage",
          "description": "How to compute percentages",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "perf diff"
      ]
    },
    {
      "name": "bench",
      "description": "Run the built-in benchmarks",
      "options": [
        {
          "name": "--format",
          "description": "Output format: default, simple or json",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "perf bench"
      ]
    },
    {
      "name": "trace",
      "description": "Trace system calls, like strace",
      "options": [
        {
          "name": "--output",
          "description": "Write the trace here",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--pid",
          "description": "Only trace this process",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "perf trace"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "perf stat ./prog",
      "description": "Count events for one run"
    },
    {
      "command": "perf record -g ./prog",
      "description": "Sample with call graphs"
    },
    {
      "command": "perf report --stdio",
      "description": "Summarise the profile as text"
    },
    {
      "command": "perf top -p 1234",
      "description": "Watch a live profile of one process"
    },
    {
      "command": "perf script | stackcollapse-perf.pl | flamegraph.pl > out.svg",
      "description": "Generate a flame graph"
    }
  ],
  "relatedCommands": [
    "valgrind",
    "gdb",
    "strace",
    "hyperfine",
    "btop"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "perf version",
        "command": "perf --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "perf"
      },
      {
        "name": "paranoid",
        "description": "Whether unprivileged perf events are restricted",
        "command": "cat /proc/sys/kernel/perf_event_paranoid 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "events",
        "description": "Hardware events perf can count",
        "command": "perf list hw 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "perf"
      },
      {
        "name": "recordings",
        "description": "perf recordings in this directory",
        "command": "find . -maxdepth 2 -name 'perf.data*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
