{
  "name": "yt-dlp",
  "description": "Download video and audio from thousands of sites",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--format",
      "description": "Format selector, e.g. bestvideo+bestaudio",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--list-formats",
      "description": "List the available formats",
      "type": "boolean",
      "takesValue": false,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--output",
      "description": "Output filename template",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--extract-audio",
      "description": "Keep only the audio track",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--audio-format",
      "description": "Audio format to convert to (mp3, m4a, opus)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--audio-quality",
      "description": "Audio quality, 0 is best",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--playlist-items",
      "description": "Playlist positions to download",
      "type": "string",
      "takesValue": true,
      "short": "-I",
      "shorthand": "-I"
    },
    {
      "name": "--download-archive",
      "description": "Skip anything listed in this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--write-subs",
      "description": "Download subtitles",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--sub-langs",
      "description": "Subtitle languages to fetch",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--embed-metadata",
      "description": "Write metadata into the file",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--embed-thumbnail",
      "description": "Embed the thumbnail",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--cookies",
      "description": "Cookie file to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--cookies-from-browser",
      "description": "Load cookies from this browser",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--limit-rate",
      "description": "Maximum download rate, e.g. 2M",
      "type": "string",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--concurrent-fragments",
      "description": "Fragments to fetch in parallel",
      "type": "integer",
      "takesValue": true,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--no-playlist",
      "description": "Download only the linked video",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--simulate",
      "description": "Do not download anything",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--print",
      "description": "Print this template instead of downloading",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sponsorblock-remove",
      "description": "Remove these SponsorBlock categories",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "yt-dlp URL",
      "description": "Download at the best quality"
    },
    {
      "command": "yt-dlp -x --audio-format mp3 URL",
      "description": "Extract audio as MP3"
    },
    {
      "command": "yt-dlp -F URL",
      "description": "List the available formats"
    },
    {
      "command": "yt-dlp -f \"bestvideo[height<=1080]+bestaudio\" URL",
      "description": "Cap the resolution"
    },
    {
      "command": "yt-dlp --download-archive seen.txt URL",
      "description": "Skip previously downloaded items"
    }
  ],
  "relatedCommands": [
    "youtube-dl",
    "ffmpeg",
    "curl",
    "wget"
  ]
}
