{
  "name": "surreal",
  "description": "Command-line client and server for SurrealDB",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "start",
      "description": "Start a SurrealDB server",
      "options": [
        {
          "name": "--bind",
          "description": "Address to listen on",
          "type": "string",
          "takesValue": true,
          "short": "-b",
          "shorthand": "-b"
        },
        {
          "name": "--user",
          "description": "Root username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--pass",
          "description": "Root password",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--log",
          "description": "Logging level",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--strict",
          "description": "Run in strict mode",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Storage path or backend, e.g. memory",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "sql",
      "description": "Run SQL against a server",
      "options": [
        {
          "name": "--endpoint",
          "description": "Server endpoint",
          "type": "url",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--username",
          "description": "Username to authenticate as",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--password",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--database",
          "description": "Database to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--pretty",
          "description": "Pretty-print results",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "import",
      "description": "Import a SurrealQL file",
      "options": [
        {
          "name": "--endpoint",
          "description": "Server endpoint",
          "type": "url",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--namespace",
          "description": "Namespace to import into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--database",
          "description": "Database to import into",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "File to import",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "export",
      "description": "Export to a SurrealQL file",
      "options": [
        {
          "name": "--endpoint",
          "description": "Server endpoint",
          "type": "url",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--namespace",
          "description": "Namespace to export",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--database",
          "description": "Database to export",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "File to write",
          "type": "file",
          "required": true
        }
      ]
    },
    {
      "name": "version",
      "description": "Show the server version"
    },
    {
      "name": "isready",
      "description": "Check whether the server is accepting connections"
    },
    {
      "name": "upgrade",
      "description": "Upgrade to a newer SurrealDB version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "surreal start --user root --pass root memory",
      "description": "Start an in-memory server"
    },
    {
      "command": "surreal sql -e http://localhost:8000 --pretty",
      "description": "Open an interactive SQL session"
    },
    {
      "command": "surreal import --namespace test --database test data.surql",
      "description": "Import a file"
    },
    {
      "command": "surreal isready",
      "description": "Check server readiness"
    }
  ],
  "relatedCommands": [
    "duckdb",
    "mongosh",
    "redis-cli",
    "psql"
  ]
}
