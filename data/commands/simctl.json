{
  "name": "simctl",
  "description": "Control Apple simulators — boot, install and interact",
  "category": "mobile",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "list",
      "description": "List devices, device types, runtimes and pairs",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "what",
          "description": "devices, devicetypes, runtimes or pairs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "boot",
      "description": "Boot a device",
      "args": [
        {
          "name": "device",
          "description": "Device udid or name",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "shutdown",
      "description": "Shut down a device, or all",
      "args": [
        {
          "name": "device",
          "description": "Device udid, name or all",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "create",
      "description": "Create a device",
      "args": [
        {
          "name": "name",
          "description": "Device name",
          "type": "string",
          "required": true
        },
        {
          "name": "type",
          "description": "Device type",
          "type": "string",
          "required": true
        },
        {
          "name": "runtime",
          "description": "Runtime",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete a device, or unavailable ones",
      "args": [
        {
          "name": "device",
          "description": "Device udid, name or unavailable",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "install",
      "description": "Install an app bundle",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        },
        {
          "name": "path",
          "description": "App bundle path",
          "type": "path",
          "required": true
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Remove an app",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        },
        {
          "name": "bundleid",
          "description": "Bundle identifier",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "launch",
      "description": "Launch an app",
      "options": [
        {
          "name": "--console",
          "description": "Attach to the app output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--terminate-running-process",
          "description": "Restart if already running",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        },
        {
          "name": "bundleid",
          "description": "Bundle identifier",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "terminate",
      "description": "Terminate a running app",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        },
        {
          "name": "bundleid",
          "description": "Bundle identifier",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "openurl",
      "description": "Open a URL on a device",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        },
        {
          "name": "url",
          "description": "URL to open",
          "type": "url",
          "required": true
        }
      ]
    },
    {
      "name": "io",
      "description": "Record video or take a screenshot",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "spawn",
      "description": "Run a process inside a device",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "erase",
      "description": "Reset a device to factory state",
      "args": [
        {
          "name": "device",
          "description": "Device udid, name or all",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "privacy",
      "description": "Grant or revoke a privacy permission",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "push",
      "description": "Deliver a push notification payload",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "status_bar",
      "description": "Override the status bar appearance",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--set",
      "description": "Simulator device set to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "xcrun simctl list devices available",
      "description": "List the usable simulators"
    },
    {
      "command": "xcrun simctl boot \"iPhone 15\"",
      "description": "Boot a simulator"
    },
    {
      "command": "xcrun simctl install booted App.app",
      "description": "Install a build"
    },
    {
      "command": "xcrun simctl launch --console booted com.example.app",
      "description": "Launch and attach to the output"
    },
    {
      "command": "xcrun simctl io booted screenshot shot.png",
      "description": "Capture a screenshot"
    }
  ],
  "relatedCommands": [
    "xcrun",
    "xcodebuild",
    "adb",
    "fastlane"
  ]
}
