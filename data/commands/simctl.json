{
  "name": "simctl",
  "description": "Control Apple simulators — boot, install and interact",
  "category": "mobile",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "list",
      "description": "List devices, device types, runtimes and pairs",
      "options": [
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "what",
          "description": "devices, devicetypes, runtimes or pairs",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "boot",
      "description": "Boot a device",
      "args": [
        {
          "name": "device",
          "description": "Device udid or name",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": [
        {
          "name": "--arch",
          "description": "Architecture to boot",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "shutdown",
      "description": "Shut down a device, or all",
      "args": [
        {
          "name": "device",
          "description": "Device udid, name or all",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "booted"
          }
        }
      ],
      "options": []
    },
    {
      "name": "create",
      "description": "Create a device",
      "args": [
        {
          "name": "name",
          "description": "Device name",
          "type": "string",
          "required": true
        },
        {
          "name": "type",
          "description": "Device type",
          "type": "string",
          "required": true
        },
        {
          "name": "runtime",
          "description": "Runtime",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "delete",
      "description": "Delete a device, or unavailable ones",
      "args": [
        {
          "name": "device",
          "description": "Device udid, name or unavailable",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": []
    },
    {
      "name": "install",
      "description": "Install an app bundle",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        },
        {
          "name": "path",
          "description": "App bundle path",
          "type": "path",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "uninstall",
      "description": "Remove an app",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        },
        {
          "name": "bundleid",
          "description": "Bundle identifier",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "launch",
      "description": "Launch an app",
      "options": [
        {
          "name": "--console",
          "description": "Attach to the app output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--terminate-running-process",
          "description": "Restart if already running",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        },
        {
          "name": "bundleid",
          "description": "Bundle identifier",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "terminate",
      "description": "Terminate a running app",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "booted"
          }
        },
        {
          "name": "bundleid",
          "description": "Bundle identifier",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "openurl",
      "description": "Open a URL on a device",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        },
        {
          "name": "url",
          "description": "URL to open",
          "type": "url",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "io",
      "description": "Record video or take a screenshot",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": [
        {
          "name": "--type",
          "description": "Screenshot format (png, tiff, jpeg)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--display",
          "description": "Display to capture",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--mask",
          "description": "How to mask the corners",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--codec",
          "description": "Video codec for recording",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "spawn",
      "description": "Run a process inside a device",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": [
        {
          "name": "--standalone",
          "description": "Run outside the simulator environment",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--arch",
          "description": "Architecture to spawn",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "erase",
      "description": "Reset a device to factory state",
      "args": [
        {
          "name": "device",
          "description": "Device udid, name or all",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "booted"
          }
        }
      ],
      "options": []
    },
    {
      "name": "privacy",
      "description": "Grant or revoke a privacy permission",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": []
    },
    {
      "name": "push",
      "description": "Deliver a push notification payload",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": []
    },
    {
      "name": "status_bar",
      "description": "Override the status bar appearance",
      "args": [
        {
          "name": "device",
          "description": "Device udid or booted",
          "type": "device",
          "required": true,
          "completion": {
            "detector": "devices"
          }
        }
      ],
      "options": [
        {
          "name": "--time",
          "description": "Status bar time",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dataNetwork",
          "description": "Data network type",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wifiBars",
          "description": "Wi-Fi signal bars",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--cellularBars",
          "description": "Cellular signal bars",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--batteryLevel",
          "description": "Battery percentage",
          "type": "integer",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--set",
      "description": "Simulator device set to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "xcrun simctl list devices available",
      "description": "List the usable simulators"
    },
    {
      "command": "xcrun simctl boot \"iPhone 15\"",
      "description": "Boot a simulator"
    },
    {
      "command": "xcrun simctl install booted App.app",
      "description": "Install a build"
    },
    {
      "command": "xcrun simctl launch --console booted com.example.app",
      "description": "Launch and attach to the output"
    },
    {
      "command": "xcrun simctl io booted screenshot shot.png",
      "description": "Capture a screenshot"
    }
  ],
  "relatedCommands": [
    "xcrun",
    "xcodebuild",
    "adb",
    "fastlane"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Xcode command-line tools version",
        "command": "xcrun simctl help 2>/dev/null | head -2; xcodebuild -version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "xcrun"
      },
      {
        "name": "booted",
        "description": "Simulators currently booted",
        "command": "xcrun simctl list devices booted 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "xcrun"
      },
      {
        "name": "devices",
        "description": "Simulator devices available",
        "command": "xcrun simctl list devices available 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "xcrun"
      },
      {
        "name": "runtimes",
        "description": "Simulator runtimes installed",
        "command": "xcrun simctl list runtimes 2>/dev/null",
        "parser": "table",
        "cacheFor": 3600,
        "requiresCmd": "xcrun"
      }
    ]
  }
}
