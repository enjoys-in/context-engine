{
  "name": "cilium",
  "description": "Cilium CLI — eBPF-based networking, security, and observability for Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install Cilium",
      "examples": [
        "cilium install",
        "cilium install --version 1.14.0",
        "cilium install --helm-set ipam.mode=kubernetes"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--version",
          "description": "Cilium version to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--set",
          "description": "Set a Helm value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--values",
          "description": "Helm values file to apply",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--dry-run",
          "description": "Print the manifests without applying them",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wait",
          "description": "Wait until Cilium is ready",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade Cilium",
      "examples": [
        "cilium upgrade",
        "cilium upgrade --version 1.14.1"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--version",
          "description": "Cilium version to upgrade to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--set",
          "description": "Set a Helm value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait until the upgrade completes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall Cilium",
      "examples": [
        "cilium uninstall"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--wait",
          "description": "Wait until removal completes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--test-namespace",
          "description": "Also remove this connectivity-test namespace",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "status",
      "description": "Show Cilium status",
      "examples": [
        "cilium status",
        "cilium status --wait"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--wait",
          "description": "Wait until Cilium reports ready",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--output",
          "description": "Output format: summary or json",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--verbose",
          "description": "Include per-node detail",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "connectivity test",
      "description": "Run connectivity tests",
      "examples": [
        "cilium connectivity test",
        "cilium connectivity test --single-node"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--test",
          "description": "Only run tests matching this name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--test-namespace",
          "description": "Namespace to run the tests in",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force-deploy",
          "description": "Redeploy the test workloads",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all-flows",
          "description": "Collect every flow for the report",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "hubble",
      "description": "Hubble observability",
      "examples": [
        "cilium hubble enable",
        "cilium hubble port-forward",
        "cilium hubble ui"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--ui",
          "description": "Enable the Hubble UI",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--relay",
          "description": "Enable Hubble Relay",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "clustermesh",
      "description": "Multi-cluster mesh",
      "examples": [
        "cilium clustermesh enable",
        "cilium clustermesh connect --destination-context ctx2",
        "cilium clustermesh status",
        "cilium clustermesh disconnect --destination-context ctx2",
        "cilium clustermesh disable"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--service-type",
          "description": "Service type to expose the mesh API with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Wait until the mesh is ready",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage Cilium config",
      "examples": [
        "cilium config view",
        "cilium config set enable-hubble true"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "encrypt",
      "description": "Manage encryption",
      "examples": [
        "cilium encrypt status"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "bgp",
      "description": "BGP control plane",
      "examples": [
        "cilium bgp peers"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "sysdump",
      "description": "Collect debug info",
      "examples": [
        "cilium sysdump",
        "cilium sysdump --output-filename debug-dump"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output-filename",
          "description": "Write the sysdump archive here",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--node-list",
          "description": "Only collect from these nodes",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--since",
          "description": "Only collect logs newer than this duration",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "cilium version"
      ],
      "options": [
        {
          "name": "--context",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--client",
          "description": "Show the client version only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Cilium namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--helm-set",
      "description": "Set Helm values",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "cilium install",
    "cilium status",
    "cilium connectivity test",
    "cilium hubble enable",
    "cilium hubble ui",
    "cilium clustermesh enable",
    "cilium sysdump",
    "cilium version"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "calico",
    "linkerd"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Cilium CLI version",
        "command": "cilium version --client 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cilium"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "status",
        "description": "Cilium installation status",
        "command": "cilium status --wait=false 2>/dev/null | head -20",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "cilium"
      }
    ]
  }
}
