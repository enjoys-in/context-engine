{
  "name": "mockgen",
  "description": "Generate Go mock implementations for interfaces",
  "category": "go",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-source",
      "description": "Generate from this source file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-destination",
      "description": "Write the mocks here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-package",
      "description": "Package name for the generated code",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-mock_names",
      "description": "Custom names for the mocks, Iface=MockName",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-self_package",
      "description": "Import path of the generated package",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-build_flags",
      "description": "Flags to pass to the build",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-aux_files",
      "description": "Auxiliary files for embedded interfaces",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-copyright_file",
      "description": "Prepend this copyright header",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-write_package_comment",
      "description": "Write a package comment",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-typed",
      "description": "Generate type-safe expectation helpers",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "mockgen -source=store.go -destination=mocks/store.go",
      "description": "Generate mocks from a file"
    },
    {
      "command": "mockgen -destination=mocks/db.go example.com/app/db Store",
      "description": "Generate mocks for an interface in a package"
    },
    {
      "command": "mockgen -source=api.go -package=mocks -typed",
      "description": "Generate typed expectation helpers"
    }
  ],
  "relatedCommands": [
    "go",
    "gotestsum",
    "gopls"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "mockgen version",
        "command": "mockgen --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mockgen"
      },
      {
        "name": "directives",
        "description": "go:generate mockgen directives in this project",
        "command": "grep -rn 'go:generate.*mockgen' --include='*.go' . 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "interfaces",
        "description": "Go files declaring interfaces mockgen could target",
        "command": "grep -rl 'interface {' --include='*.go' . 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "existing_mocks",
        "description": "Generated mock files present",
        "command": "find . -maxdepth 4 -name 'mock_*.go' -o -maxdepth 4 -path '*/mocks/*.go' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
