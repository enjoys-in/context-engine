{
  "name": "sort",
  "description": "Sort lines of text files",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-r",
      "description": "Reverse the result of comparisons"
    },
    {
      "name": "-n",
      "description": "Compare according to string numerical value"
    },
    {
      "name": "-k",
      "description": "Sort by key/field",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Use character as field separator",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-u",
      "description": "Output only unique lines"
    },
    {
      "name": "-o",
      "description": "Write result to file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Fold lower case to upper case (case-insensitive)"
    },
    {
      "name": "-h",
      "description": "Compare human-readable numbers (2K, 1G)"
    },
    {
      "name": "-V",
      "description": "Natural sort of version numbers"
    },
    {
      "name": "-s",
      "description": "Stabilize sort by disabling last-resort comparison"
    }
  ],
  "examples": [
    "sort file.txt",
    "sort -r file.txt",
    "sort -n numbers.txt",
    "sort -t ',' -k 2 data.csv",
    "sort -u file.txt",
    "sort -k 2 -n -r scores.txt",
    "du -sh * | sort -h"
  ],
  "relatedCommands": [
    "uniq",
    "cut",
    "wc",
    "tsort"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "sort version",
        "command": "sort --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "sort"
      },
      {
        "name": "locale",
        "description": "Collation locale sort will use",
        "command": "echo \"${LC_COLLATE:-${LC_ALL:-${LANG:-C}}}\"",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "text_files",
        "description": "Sortable text files in this directory",
        "command": "find . -maxdepth 2 -name '*.txt' -o -name '*.csv' -o -name '*.tsv' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
