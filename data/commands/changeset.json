{
  "name": "changeset",
  "aliases": [
    "changesets"
  ],
  "description": "Manage versioning and changelogs for monorepos",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "add",
      "description": "Add a new changeset",
      "examples": [
        "changeset add"
      ],
      "options": [
        {
          "name": "--empty",
          "description": "Create a changeset with no package bumps",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--open",
          "description": "Open the changeset in an editor",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Apply changesets to versions/changelogs",
      "examples": [
        "changeset version"
      ],
      "options": [
        {
          "name": "--ignore",
          "description": "Package to exclude from versioning",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--snapshot",
          "description": "Produce a snapshot version",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish changed packages",
      "examples": [
        "changeset publish"
      ],
      "options": [
        {
          "name": "--tag",
          "description": "npm dist-tag to publish under",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--otp",
          "description": "One-time password for two-factor auth",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-git-tag",
          "description": "Do not create git tags",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "status",
      "description": "Show current changeset status",
      "examples": [
        "changeset status"
      ],
      "options": [
        {
          "name": "--since",
          "description": "Compare against this git ref",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the status as JSON here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize changesets",
      "examples": [
        "changeset init"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--empty",
      "description": "Create a changeset with no package bumps",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--open",
      "description": "Open the new changeset in your editor",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--since",
      "description": "Only consider packages changed since this ref",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "changeset",
    "changeset add",
    "changeset version",
    "changeset publish",
    "changeset status",
    "npx @changesets/cli init"
  ],
  "relatedCommands": [
    "lerna",
    "semantic-release",
    "npm",
    "pnpm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Changesets version",
        "command": "changeset --version 2>/dev/null || npx changeset --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Changesets configuration",
        "command": "cat .changeset/config.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "pending",
        "description": "Pending changesets awaiting release",
        "command": "ls .changeset/*.md 2>/dev/null | grep -v README | head -15",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
