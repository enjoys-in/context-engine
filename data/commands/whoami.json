{
  "name": "whoami",
  "description": "Print the current user name",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "whoami"
  ],
  "relatedCommands": [
    "id",
    "who",
    "w",
    "users"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "user",
        "description": "Effective user name",
        "command": "whoami 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "whoami"
      },
      {
        "name": "identity",
        "description": "Full user, group and supplementary group identity",
        "command": "id 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "login",
        "description": "Login name recorded for this session",
        "command": "logname 2>/dev/null || echo \"${USER:-unknown}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "sudo",
        "description": "Whether this session was escalated",
        "command": "echo \"${SUDO_USER:-not sudo}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
