{
  "name": "gsutil",
  "description": "Google Cloud Storage CLI tool",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "ls",
      "description": "List buckets or objects",
      "examples": [
        "gsutil ls",
        "gsutil ls gs://my-bucket/",
        "gsutil ls -l gs://my-bucket/",
        "gsutil ls -la gs://my-bucket/file.txt"
      ],
      "options": [
        {
          "name": "--long",
          "description": "Show size, timestamp and URL",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--all-versions",
          "description": "Include noncurrent versions",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--human-readable",
          "description": "Print sizes in human units",
          "type": "boolean",
          "takesValue": false,
          "short": "-h",
          "shorthand": "-h"
        }
      ]
    },
    {
      "name": "mb",
      "description": "Make bucket",
      "examples": [
        "gsutil mb gs://new-bucket",
        "gsutil mb -l us-central1 gs://new-bucket",
        "gsutil mb -c nearline gs://archive-bucket"
      ],
      "options": [
        {
          "name": "--location",
          "description": "Location to create the bucket in",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--storage-class",
          "description": "Default storage class",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--project",
          "description": "Project to create it under",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "rb",
      "description": "Remove bucket",
      "examples": [
        "gsutil rb gs://my-bucket"
      ]
    },
    {
      "name": "cp",
      "description": "Copy objects",
      "examples": [
        "gsutil cp file.txt gs://my-bucket/",
        "gsutil cp gs://my-bucket/file.txt .",
        "gsutil cp -r ./dir/ gs://my-bucket/dir/",
        "gsutil cp gs://bucket1/file gs://bucket2/file"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Copy directories recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--no-clobber",
          "description": "Skip objects that already exist",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--preserve-acl",
          "description": "Preserve the ACL on copy",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--all-versions",
          "description": "Copy every version",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--content-type",
          "description": "Content-Type to set",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "mv",
      "description": "Move objects",
      "examples": [
        "gsutil mv gs://my-bucket/old.txt gs://my-bucket/new.txt",
        "gsutil mv ./local.txt gs://my-bucket/"
      ]
    },
    {
      "name": "rm",
      "description": "Remove objects",
      "examples": [
        "gsutil rm gs://my-bucket/file.txt",
        "gsutil rm -r gs://my-bucket/dir/",
        "gsutil rm gs://my-bucket/**"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Remove recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--force",
          "description": "Continue past missing objects",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--all-versions",
          "description": "Remove every version",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "rsync",
      "description": "Sync directories",
      "examples": [
        "gsutil rsync -r ./local/ gs://my-bucket/",
        "gsutil rsync -r -d gs://my-bucket/ ./local/"
      ],
      "options": [
        {
          "name": "--recursive",
          "description": "Synchronise directories recursively",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--delete-extras",
          "description": "Delete objects missing from the source",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--checksum",
          "description": "Compare checksums rather than sizes",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--exclude",
          "description": "Skip paths matching this regex",
          "type": "string",
          "takesValue": true,
          "short": "-x",
          "shorthand": "-x"
        },
        {
          "name": "--dry-run",
          "description": "Report what would change",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "cat",
      "description": "Concatenate object content",
      "examples": [
        "gsutil cat gs://my-bucket/file.txt"
      ]
    },
    {
      "name": "stat",
      "description": "Object statistics",
      "examples": [
        "gsutil stat gs://my-bucket/file.txt"
      ]
    },
    {
      "name": "du",
      "description": "Disk usage",
      "examples": [
        "gsutil du gs://my-bucket/",
        "gsutil du -s gs://my-bucket/"
      ],
      "options": [
        {
          "name": "--summarize",
          "description": "Print only a grand total",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--human-readable",
          "description": "Print sizes in human units",
          "type": "boolean",
          "takesValue": false,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--all-versions",
          "description": "Include every version",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "iam",
      "description": "IAM policy management",
      "examples": [
        "gsutil iam get gs://my-bucket",
        "gsutil iam ch user:user@example.com:objectViewer gs://my-bucket"
      ]
    },
    {
      "name": "acl",
      "description": "Set/get ACLs",
      "examples": [
        "gsutil acl get gs://my-bucket",
        "gsutil acl set public-read gs://my-bucket/file.txt"
      ]
    },
    {
      "name": "cors",
      "description": "Get/set CORS configuration",
      "examples": [
        "gsutil cors get gs://my-bucket",
        "gsutil cors set cors.json gs://my-bucket"
      ]
    },
    {
      "name": "lifecycle",
      "description": "Get/set lifecycle config",
      "examples": [
        "gsutil lifecycle get gs://my-bucket",
        "gsutil lifecycle set lifecycle.json gs://my-bucket"
      ]
    },
    {
      "name": "versioning",
      "description": "Get/set versioning",
      "examples": [
        "gsutil versioning set on gs://my-bucket",
        "gsutil versioning get gs://my-bucket"
      ]
    },
    {
      "name": "signurl",
      "description": "Generate signed URL",
      "examples": [
        "gsutil signurl -d 1h key.json gs://my-bucket/file.txt"
      ],
      "options": [
        {
          "name": "--duration",
          "description": "How long the URL stays valid, e.g. 1h",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--method",
          "description": "HTTP method the URL permits",
          "type": "string",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--region",
          "description": "Bucket region",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "compose",
      "description": "Compose objects",
      "examples": [
        "gsutil compose gs://my-bucket/part1 gs://my-bucket/part2 gs://my-bucket/combined"
      ]
    },
    {
      "name": "hash",
      "description": "Calculate hashes",
      "examples": [
        "gsutil hash file.txt"
      ],
      "options": [
        {
          "name": "--hex",
          "description": "Print hashes in hex",
          "type": "boolean",
          "takesValue": false,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--md5",
          "description": "Calculate only the MD5",
          "type": "boolean",
          "takesValue": false,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--crc32c",
          "description": "Calculate only the CRC32C",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-m",
      "description": "Multi-threaded/parallel operations"
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "-o",
      "description": "Set config option",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Debug output"
    },
    {
      "name": "--multithreaded",
      "description": "Run the operation in parallel",
      "type": "boolean",
      "takesValue": false,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--recursive",
      "description": "Recurse into subdirectories",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--project",
      "description": "Project to bill",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--header",
      "description": "Extra request header",
      "type": "string",
      "takesValue": true,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--debug",
      "description": "Emit debug output",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--no-clobber",
      "description": "Do not overwrite existing objects",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    }
  ],
  "examples": [
    "gsutil ls",
    "gsutil cp file.txt gs://my-bucket/",
    "gsutil cp -r ./dir/ gs://my-bucket/dir/",
    "gsutil rsync -r ./local/ gs://my-bucket/",
    "gsutil rm -r gs://my-bucket/old/",
    "gsutil du -s gs://my-bucket/",
    "gsutil mb -l us-central1 gs://new-bucket",
    "gsutil -m cp -r gs://bucket/ ./local/"
  ],
  "relatedCommands": [
    "gcloud",
    "s3cmd",
    "aws",
    "rclone"
  ]
}
