{
  "name": "aws-sso",
  "description": "Manage AWS IAM Identity Center credentials from the terminal",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Authenticate with the identity provider",
      "options": [
        {
          "name": "--url-action",
          "description": "How to open the verification URL",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--sso",
          "description": "Identity Center instance to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "aws-sso login"
      ]
    },
    {
      "name": "logout",
      "description": "Clear the cached credentials",
      "options": [],
      "examples": [
        "aws-sso logout"
      ]
    },
    {
      "name": "list",
      "description": "List the accounts and roles available",
      "options": [
        {
          "name": "--fields",
          "description": "Columns to display",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--csv",
          "description": "Emit CSV",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "aws-sso list"
      ]
    },
    {
      "name": "exec",
      "description": "Run a command with credentials in the environment",
      "options": [
        {
          "name": "--arn",
          "description": "Role ARN to assume",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--account",
          "description": "Account id",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--role",
          "description": "Role name",
          "type": "string",
          "takesValue": true,
          "short": "-R",
          "shorthand": "-R"
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run with the credentials",
          "required": false,
          "type": "string"
        }
      ],
      "examples": [
        "aws-sso exec command"
      ]
    },
    {
      "name": "eval",
      "description": "Print export statements for the credentials",
      "options": [
        {
          "name": "--arn",
          "description": "Role ARN to assume",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--clear",
          "description": "Print statements that unset the variables",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "aws-sso eval"
      ]
    },
    {
      "name": "console",
      "description": "Open the AWS console in a browser",
      "options": [
        {
          "name": "--arn",
          "description": "Role ARN to use",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--print",
          "description": "Print the URL instead of opening it",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "examples": [
        "aws-sso console"
      ]
    },
    {
      "name": "process",
      "description": "Act as an AWS credential_process provider",
      "options": [
        {
          "name": "--arn",
          "description": "Role ARN to assume",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "aws-sso process"
      ]
    },
    {
      "name": "cache",
      "description": "Refresh or inspect the local cache",
      "options": [],
      "examples": [
        "aws-sso cache"
      ]
    },
    {
      "name": "config",
      "description": "Manage the configuration file",
      "options": [],
      "examples": [
        "aws-sso config"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--sso",
      "description": "Identity Center instance to use",
      "type": "string",
      "takesValue": true,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--config",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--no-config-check",
      "description": "Skip the configuration check",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "aws-sso login",
      "description": "Authenticate with Identity Center"
    },
    {
      "command": "aws-sso list",
      "description": "List the accounts and roles you can use"
    },
    {
      "command": "aws-sso exec --account 123456789012 --role Admin -- aws s3 ls",
      "description": "Run a command as a role"
    },
    {
      "command": "eval $(aws-sso eval -a arn:aws:iam::123:role/Admin)",
      "description": "Export credentials into the shell"
    }
  ],
  "relatedCommands": [
    "aws",
    "saml2aws",
    "aws-vault",
    "kubelogin"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "aws-sso version",
        "command": "aws-sso version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "aws-sso"
      },
      {
        "name": "config",
        "description": "aws-sso configuration",
        "command": "cat ~/.aws-sso/config.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "profiles",
        "description": "AWS profiles available locally",
        "command": "grep -o '^\\[.*\\]' ~/.aws/config 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
