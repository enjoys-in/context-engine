{
  "name": "btop",
  "description": "Resource monitor showing usage and stats for processor, memory, disks, network and processes (btop++)",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help message and exit",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-v",
      "description": "Show version information",
      "short": "-v"
    },
    {
      "name": "--utf-force",
      "description": "Force UTF-8 Unicode output regardless of locale"
    },
    {
      "name": "--debug",
      "description": "Start in debug mode, logging to btop.log"
    },
    {
      "name": "--low-color",
      "shorthand": "-lc",
      "description": "Disable truecolor, use 256-color or 16-color mode",
      "short": "-lc"
    },
    {
      "name": "--tty-mode",
      "shorthand": "-t",
      "description": "Force TTY mode (16 color, simplified UI for TTY terminals)",
      "short": "-t"
    },
    {
      "name": "--update",
      "description": "Set update interval in milliseconds (minimum 100)",
      "takesValue": true
    },
    {
      "name": "--preset",
      "shorthand": "-p",
      "description": "Start with a preset layout (0-9) as defined in config",
      "takesValue": true,
      "short": "-p"
    },
    {
      "name": "--theme",
      "description": "Set color theme (name or full path to .theme file)",
      "takesValue": true
    },
    {
      "name": "--no-update-check",
      "description": "Disable check for newer versions at startup"
    },
    {
      "name": "--config",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--tty",
      "description": "Force TUI mode",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--no-tty",
      "description": "Force normal mode",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    }
  ],
  "examples": [
    {
      "command": "btop",
      "description": "Launch the resource monitor"
    },
    {
      "command": "btop --utf-force",
      "description": "Force UTF-8 output (fix rendering issues)"
    },
    {
      "command": "btop -t",
      "description": "Run in TTY-compatible mode"
    },
    {
      "command": "btop --preset 2",
      "description": "Start with layout preset 2"
    },
    {
      "command": "btop --update 500",
      "description": "Update every 500 milliseconds"
    },
    {
      "command": "btop -lc",
      "description": "Run with low-color mode (no truecolor)"
    },
    {
      "command": "btop --theme gruvbox_dark",
      "description": "Start with the gruvbox_dark theme"
    },
    {
      "command": "btop --debug",
      "description": "Run in debug mode for troubleshooting"
    }
  ],
  "relatedCommands": [
    "htop",
    "top",
    "ps"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "btop version",
        "command": "btop --version 2>/dev/null",
        "parser": "lines",
        "cacheFor": 600,
        "requiresCmd": "btop"
      },
      {
        "name": "config",
        "description": "btop config location",
        "command": "ls ~/.config/btop/btop.conf 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "btop"
      },
      {
        "name": "themes",
        "description": "Available btop themes",
        "command": "ls ~/.config/btop/themes/ 2>/dev/null || ls /usr/share/btop/themes/ 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 600,
        "requiresCmd": "btop"
      }
    ]
  }
}
