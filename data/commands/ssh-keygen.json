{
  "name": "ssh-keygen",
  "description": "SSH key generation, management, and conversion utility",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-t",
      "description": "Key type (rsa, ed25519, ecdsa, dsa)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-b",
      "description": "Number of bits in the key",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-C",
      "description": "Comment for the key",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-f",
      "description": "Key file path",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-N",
      "description": "New passphrase",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-P",
      "description": "Old passphrase",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "Change passphrase of existing key"
    },
    {
      "name": "-l",
      "description": "Show fingerprint of key file"
    },
    {
      "name": "-E",
      "description": "Hash algorithm for fingerprint (md5, sha256)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-R",
      "description": "Remove host from known_hosts file",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-F",
      "description": "Search for hostname in known_hosts",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-H",
      "description": "Hash known_hosts file"
    },
    {
      "name": "-y",
      "description": "Read private key and print public key"
    },
    {
      "name": "-e",
      "description": "Export key to other formats"
    },
    {
      "name": "-i",
      "description": "Import key from other formats"
    },
    {
      "name": "-m",
      "description": "Key format (RFC4716, PKCS8, PEM)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-A",
      "description": "Generate host keys for all default key types"
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "-o",
      "description": "Use new OpenSSH format for private key"
    },
    {
      "name": "-a",
      "description": "Number of KDF rounds for new format",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Sign a key (for certificates)",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-I",
      "description": "Certificate identity string",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-n",
      "description": "Certificate principal(s)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-V",
      "description": "Certificate validity interval",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-L",
      "description": "Print contents of a certificate"
    },
    {
      "name": "--type",
      "description": "Key type (rsa, ed25519, ecdsa, ed25519-sk)",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--bits",
      "description": "Key size in bits",
      "type": "integer",
      "takesValue": true,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--comment",
      "description": "Comment to attach",
      "type": "string",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--file",
      "description": "Key file to write or read",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--passphrase",
      "description": "New passphrase",
      "type": "string",
      "takesValue": true,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--old-passphrase",
      "description": "Existing passphrase",
      "type": "string",
      "takesValue": true,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--change-passphrase",
      "description": "Change the passphrase on a key",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--fingerprint",
      "description": "Show the key fingerprint",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--visual",
      "description": "Also print a randomart image",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--public-key",
      "description": "Print the public key from a private key",
      "type": "boolean",
      "takesValue": false,
      "short": "-y",
      "shorthand": "-y"
    },
    {
      "name": "--hash",
      "description": "Fingerprint hash algorithm",
      "type": "string",
      "takesValue": true,
      "short": "-E",
      "shorthand": "-E"
    },
    {
      "name": "--remove-host",
      "description": "Remove a host from known_hosts",
      "type": "string",
      "takesValue": true,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--known-hosts-find",
      "description": "Find a host in known_hosts",
      "type": "string",
      "takesValue": true,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--hash-known-hosts",
      "description": "Hash the known_hosts file",
      "type": "boolean",
      "takesValue": false,
      "short": "-H",
      "shorthand": "-H"
    },
    {
      "name": "--sign",
      "description": "Sign a key with a CA",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--identity",
      "description": "Certificate identity",
      "type": "string",
      "takesValue": true,
      "short": "-I",
      "shorthand": "-I"
    },
    {
      "name": "--principals",
      "description": "Certificate principals",
      "type": "string",
      "takesValue": true,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--validity",
      "description": "Certificate validity interval",
      "type": "string",
      "takesValue": true,
      "short": "-V",
      "shorthand": "-V"
    },
    {
      "name": "--certificate-info",
      "description": "Print certificate details",
      "type": "boolean",
      "takesValue": false,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--rounds",
      "description": "KDF rounds for the private key",
      "type": "integer",
      "takesValue": true,
      "short": "-a",
      "shorthand": "-a"
    }
  ],
  "examples": [
    "ssh-keygen -t ed25519 -C 'user@example.com'",
    "ssh-keygen -t rsa -b 4096 -C 'user@example.com'",
    "ssh-keygen -t ecdsa -b 521",
    "ssh-keygen -t ed25519 -f ~/.ssh/github_key -N ''",
    "ssh-keygen -l -f ~/.ssh/id_ed25519.pub",
    "ssh-keygen -l -E md5 -f ~/.ssh/id_rsa.pub",
    "ssh-keygen -y -f ~/.ssh/id_ed25519 > ~/.ssh/id_ed25519.pub",
    "ssh-keygen -p -f ~/.ssh/id_rsa",
    "ssh-keygen -R hostname",
    "ssh-keygen -F hostname",
    "ssh-keygen -H",
    "ssh-keygen -t ed25519 -a 100",
    "ssh-keygen -s ca_key -I user_key -n user1,user2 -V +52w user_key.pub",
    "ssh-keygen -L -f certificate.pub"
  ],
  "relatedCommands": [
    "ssh",
    "ssh-agent",
    "ssh-copy-id",
    "ssh-add",
    "scp",
    "openssl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "ssh_keys",
        "description": "SSH key files in ~/.ssh/",
        "command": "ls -1 ~/.ssh/id_* 2>/dev/null | grep -v '\\.pub$'",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "ssh-keygen"
      },
      {
        "name": "ssh_public_keys",
        "description": "Public key files in ~/.ssh/",
        "command": "ls -1 ~/.ssh/*.pub 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "ssh-keygen"
      },
      {
        "name": "key_fingerprints",
        "description": "Fingerprints of all SSH keys",
        "command": "for f in ~/.ssh/id_*.pub; do ssh-keygen -l -f \"$f\" 2>/dev/null; done",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "ssh-keygen"
      },
      {
        "name": "ssh_config_hosts",
        "description": "Hosts defined in SSH config",
        "command": "grep -E '^Host[[:space:]]' ~/.ssh/config 2>/dev/null | awk '{for(i=2;i<=NF;i++) print $i}' | grep -v '[*?]'",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "ssh-keygen"
      },
      {
        "name": "known_hosts_count",
        "description": "Number of entries in known_hosts",
        "command": "wc -l < ~/.ssh/known_hosts 2>/dev/null || echo '0'",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "ssh-keygen"
      },
      {
        "name": "ssh_agent_keys",
        "description": "Keys currently loaded in ssh-agent",
        "command": "ssh-add -l 2>/dev/null || echo 'agent not running'",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "ssh-keygen"
      },
      {
        "name": "authorized_keys",
        "description": "Number of authorized keys for incoming SSH",
        "command": "wc -l < ~/.ssh/authorized_keys 2>/dev/null || echo '0'",
        "parser": "text",
        "cacheFor": 120,
        "requiresCmd": "ssh-keygen"
      }
    ]
  }
}
