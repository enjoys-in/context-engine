{
  "name": "uniq",
  "description": "Report or omit repeated lines",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Prefix lines by the number of occurrences"
    },
    {
      "name": "-d",
      "description": "Only print duplicate lines"
    },
    {
      "name": "-u",
      "description": "Only print unique lines"
    },
    {
      "name": "-i",
      "description": "Ignore case when comparing"
    },
    {
      "name": "-f",
      "description": "Skip N fields before comparing",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Skip N characters before comparing",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-w",
      "description": "Compare no more than N characters",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "sort file.txt | uniq",
    "sort file.txt | uniq -c",
    "sort file.txt | uniq -d",
    "sort file.txt | uniq -c | sort -rn | head"
  ],
  "relatedCommands": [
    "sort",
    "wc",
    "comm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "uniq version",
        "command": "uniq --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "uniq"
      },
      {
        "name": "text_files",
        "description": "Text files in this directory",
        "command": "find . -maxdepth 2 -name '*.txt' -o -name '*.csv' -o -name '*.log' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
