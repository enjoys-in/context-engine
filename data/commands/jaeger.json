{
  "name": "jaeger",
  "description": "Distributed tracing backend — all-in-one binary and CLI",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--collector.otlp.enabled",
      "description": "Accept OTLP traffic",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--collector.otlp.grpc.host-port",
      "description": "OTLP gRPC listen address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--collector.otlp.http.host-port",
      "description": "OTLP HTTP listen address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--query.base-path",
      "description": "Base path for the query UI",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--span-storage.type",
      "description": "Storage backend (memory, badger, elasticsearch, cassandra)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--memory.max-traces",
      "description": "Traces to retain in memory",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--log-level",
      "description": "Logging level",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--admin.http.host-port",
      "description": "Admin and health endpoint address",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--metrics-backend",
      "description": "Metrics backend to expose",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "jaeger-all-in-one --collector.otlp.enabled=true",
      "description": "Run everything with OTLP enabled"
    },
    {
      "command": "jaeger-all-in-one --span-storage.type=badger",
      "description": "Persist traces to disk"
    },
    {
      "command": "jaeger-all-in-one --memory.max-traces=50000",
      "description": "Cap in-memory trace retention"
    }
  ],
  "relatedCommands": [
    "otelcol",
    "prometheus",
    "grafana-cli",
    "tempo"
  ]
}
