      "name": "init",
      "description": "Initialize Scaleway CLI",
      "examples": [
        "scw init"
      ],
      "options": [
        {
          "name": "--access-key",
          "description": "Access key to store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--secret-key",
          "description": "Secret key to store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--organization-id",
          "description": "Organization to associate",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--project-id",
          "description": "Default project to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "Default region",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--zone",
          "description": "Default availability zone",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "instance server",
      "description": "Manage instances",
      "examples": [
        "scw instance server list",
        "scw instance server create type=DEV1-S image=ubuntu_jammy",
        "scw instance server start server-id",
        "scw instance server stop server-id",
        "scw instance server delete server-id"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Configuration profile to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--output",
          "description": "Output format: human, json, yaml or template",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--zone",
          "description": "Availability zone to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--debug",
          "description": "Emit wire-level request logging",
          "type": "boolean",
          "takesValue": false,
          "short": "-D",
          "shorthand": "-D"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against instance server, such as list",
          "type": "string",
          "required": true
        }
