  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Scaleway CLI version",
        "command": "scw version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "scw"
      },
      {
        "name": "config",
        "description": "Scaleway CLI configuration",
        "command": "scw config dump 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300,
        "requiresCmd": "scw"
      },
      {
        "name": "profiles",
        "description": "Scaleway profiles configured",
        "command": "scw config profile list 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "scw"
      }
    ]
  }
