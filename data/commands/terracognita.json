{
  "name": "terracognita",
  "description": "Reverse Terraform — generate HCL and state from existing infrastructure",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "aws",
      "description": "Import AWS resources",
      "options": [
        {
          "name": "--aws-access-key",
          "description": "Access key to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--aws-secret-access-key",
          "description": "Secret key to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--aws-default-region",
          "description": "Region to import from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--include",
          "description": "Only these resource types",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--exclude",
          "description": "Skip these resource types",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--tags",
          "description": "Only resources with these tags",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        }
      ]
    },
    {
      "name": "azurerm",
      "description": "Import Azure resources",
      "options": [
        {
          "name": "--subscription-id",
          "description": "Subscription to import from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--client-id",
          "description": "Client id",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--client-secret",
          "description": "Client secret",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--tenant-id",
          "description": "Tenant id",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "google",
      "description": "Import Google Cloud resources",
      "options": [
        {
          "name": "--project",
          "description": "Project to import from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "Region to import from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--credentials",
          "description": "Service account credentials file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "vsphere",
      "description": "Import vSphere resources"
    },
    {
      "name": "version",
      "description": "Show the installed version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--hcl",
      "description": "Write the generated HCL here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--tfstate",
      "description": "Write the generated state here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--module",
      "description": "Write a module into this directory",
      "type": "directory",
      "takesValue": true,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--interpolate",
      "description": "Interpolate references between resources",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "terracognita aws --hcl main.tf --tfstate terraform.tfstate",
      "description": "Import an AWS account"
    },
    {
      "command": "terracognita aws -i aws_instance -i aws_security_group --hcl out.tf",
      "description": "Import only two resource types"
    },
    {
      "command": "terracognita google --project my-proj --hcl gcp.tf",
      "description": "Import a Google Cloud project"
    }
  ],
  "relatedCommands": [
    "terraform",
    "terragrunt",
    "driftctl",
    "pulumi"
  ]
}
