{
  "name": "awslogs",
  "description": "Query and follow AWS CloudWatch Logs from the terminal",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "get",
      "description": "Fetch log events",
      "options": [
        {
          "name": "--start",
          "description": "Start time, e.g. 1h ago",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--end",
          "description": "End time",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--watch",
          "description": "Stream new events",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--filter-pattern",
          "description": "CloudWatch filter pattern",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--timestamp",
          "description": "Print the event timestamp",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ingestion-time",
          "description": "Print the ingestion time",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-group",
          "description": "Do not print the group name",
          "type": "boolean",
          "takesValue": false,
          "short": "-G",
          "shorthand": "-G"
        },
        {
          "name": "--no-stream",
          "description": "Do not print the stream name",
          "type": "boolean",
          "takesValue": false,
          "short": "-S",
          "shorthand": "-S"
        }
      ],
      "args": [
        {
          "name": "group",
          "description": "Log group name",
          "type": "string",
          "required": true
        },
        {
          "name": "stream",
          "description": "Log stream pattern",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "groups",
      "description": "List the log groups",
      "options": [
        {
          "name": "--prefix",
          "description": "Only groups with this prefix",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ]
    },
    {
      "name": "streams",
      "description": "List the streams in a group",
      "args": [
        {
          "name": "group",
          "description": "Log group name",
          "type": "string",
          "required": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--aws-access-key-id",
      "description": "Access key to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--aws-secret-access-key",
      "description": "Secret key to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--profile",
      "description": "AWS profile to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--aws-region",
      "description": "Region to query",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--color",
      "description": "When to colour output",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "awslogs groups",
      "description": "List the log groups"
    },
    {
      "command": "awslogs get /aws/lambda/api ALL -s 1h",
      "description": "Fetch the last hour of a group"
    },
    {
      "command": "awslogs get /aws/lambda/api ALL --watch",
      "description": "Stream new events"
    },
    {
      "command": "awslogs get /aws/lambda/api -f \"ERROR\" -s 1d",
      "description": "Filter a day of logs for errors"
    }
  ],
  "relatedCommands": [
    "aws",
    "logcli",
    "journalctl",
    "sam"
  ]
}
