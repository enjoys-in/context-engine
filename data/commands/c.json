  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GCC version",
        "command": "gcc --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gcc"
      },
      {
        "name": "target",
        "description": "GCC target triple",
        "command": "gcc -dumpmachine 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "gcc"
      },
      {
        "name": "include_paths",
        "description": "GCC default include search paths",
        "command": "gcc -E -Wp,-v -xc /dev/null 2>&1 | grep '^ /' | head -10",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "gcc"
      },
      {
        "name": "sources",
        "description": "C sources in this project",
        "command": "find . -maxdepth 3 -name '*.c' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "build_files",
        "description": "C build files present",
        "command": "ls Makefile CMakeLists.txt meson.build configure 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
