{
  "name": "latex",
  "description": "LaTeX document typesetting system",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-output-directory",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-jobname",
      "description": "Base name for output files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-interaction",
      "description": "Interaction mode (nonstopmode, batchmode, scrollmode)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-shell-escape",
      "description": "Enable shell commands"
    },
    {
      "name": "-synctex",
      "description": "Generate SyncTeX data",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-file-line-error",
      "description": "Show file and line in errors"
    },
    {
      "name": "-halt-on-error",
      "description": "Stop on first error"
    }
  ],
  "examples": [
    "pdflatex document.tex",
    "xelatex document.tex",
    "lualatex document.tex",
    "pdflatex -interaction=nonstopmode document.tex",
    "latexmk -pdf document.tex",
    "bibtex document"
  ],
  "relatedCommands": [
    "pandoc",
    "bibtex",
    "latexmk",
    "dvipdfm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "TeX distribution and version",
        "command": "latex --version 2>/dev/null | head -2 || pdflatex --version 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "documents",
        "description": "LaTeX sources in this project",
        "command": "find . -maxdepth 3 -name '*.tex' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "bibliography",
        "description": "Bibliography files present",
        "command": "find . -maxdepth 2 -name '*.bib' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "engines",
        "description": "TeX engines available",
        "command": "which pdflatex xelatex lualatex latexmk 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
