{
  "name": "skaffold",
  "description": "Skaffold — continuous development for Kubernetes-native applications",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Generate Skaffold config",
      "examples": [
        "skaffold init",
        "skaffold init --compose-file docker-compose.yml"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Overwrite an existing skaffold.yaml",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--analyze",
          "description": "Print the detected builders as JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--generate-manifests",
          "description": "Generate Kubernetes manifests for detected services",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-build",
          "description": "Do not configure a build stage",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "dev",
      "description": "Continuous development mode",
      "examples": [
        "skaffold dev",
        "skaffold dev --port-forward",
        "skaffold dev --tail",
        "skaffold dev --trigger polling",
        "skaffold dev --cleanup=false"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to deploy into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--port-forward",
          "description": "Forward container ports to localhost",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--trigger",
          "description": "What triggers a rebuild (polling, notify, manual)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cleanup",
          "description": "Delete deployed resources on exit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--tail",
          "description": "Stream container logs",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--auto-build",
          "description": "Rebuild automatically on change",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--auto-deploy",
          "description": "Redeploy automatically after a build",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and deploy once",
      "examples": [
        "skaffold run",
        "skaffold run --tail",
        "skaffold run --tag v1.0.0"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to deploy into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--tail",
          "description": "Stream container logs",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--tag",
          "description": "Tag to apply to built images",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--force",
          "description": "Recreate resources that cannot be updated in place",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build artifacts",
      "examples": [
        "skaffold build",
        "skaffold build --push",
        "skaffold build -q | skaffold deploy --build-artifacts -"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--push",
          "description": "Push the built images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--file-output",
          "description": "Write the build result as JSON here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--tag",
          "description": "Tag to apply to built images",
          "type": "string",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--cache-artifacts",
          "description": "Reuse cached build artifacts",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--platform",
          "description": "Target platform, e.g. linux/amd64",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy artifacts",
      "examples": [
        "skaffold deploy",
        "skaffold deploy --images my-image:latest"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to deploy into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--images",
          "description": "Images to deploy, overriding the build",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--build-artifacts",
          "description": "Build result JSON to deploy from",
          "type": "file",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--force",
          "description": "Recreate resources that cannot be updated in place",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "debug",
      "description": "Dev mode with debug support",
      "examples": [
        "skaffold debug",
        "skaffold debug --port-forward"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to deploy into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--port-forward",
          "description": "Forward container ports to localhost",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--auto-build",
          "description": "Rebuild automatically on change",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "render",
      "description": "Render manifests",
      "examples": [
        "skaffold render",
        "skaffold render --output rendered.yaml"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--output",
          "description": "Write the rendered manifests here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--digest-source",
          "description": "Where to take image digests from (remote, local, tag)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--offline",
          "description": "Render without contacting a cluster",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "skaffold test"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--build-artifacts",
          "description": "Build result JSON to test from",
          "type": "file",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete deployed resources",
      "examples": [
        "skaffold delete"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to delete from",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--dry-run",
          "description": "Report what would happen without applying it",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "config",
      "description": "Manage global config",
      "examples": [
        "skaffold config list",
        "skaffold config set local-cluster true"
      ],
      "options": [
        {
          "name": "--kubecontext",
          "description": "Kubeconfig context to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Config operation, such as list, set or unset",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "fix",
      "description": "Fix config to latest version",
      "examples": [
        "skaffold fix"
      ],
      "options": [
        {
          "name": "--overwrite",
          "description": "Write the upgraded configuration in place",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--version",
          "description": "Target schema version",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "diagnose",
      "description": "Diagnose config issues",
      "examples": [
        "skaffold diagnose"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--yaml-only",
          "description": "Print only the resolved configuration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--enable-templating",
          "description": "Resolve templated fields",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect Skaffold config",
      "examples": [
        "skaffold inspect profiles",
        "skaffold inspect build-env list"
      ],
      "options": [
        {
          "name": "--filename",
          "description": "Skaffold config to inspect",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--format",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "subcommand",
          "description": "Inspect subcommand, such as build-env",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "verify",
      "description": "Verify deployed resources",
      "examples": [
        "skaffold verify"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to activate",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--namespace",
          "description": "Namespace to verify in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--filename",
      "short": "-f",
      "description": "Config file path",
      "type": "string",
      "takesValue": true,
      "shorthand": "-f"
    },
    {
      "name": "--profile",
      "short": "-p",
      "description": "Activate profiles",
      "type": "string",
      "takesValue": true,
      "shorthand": "-p"
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--default-repo",
      "short": "-d",
      "description": "Default image repo",
      "type": "string",
      "takesValue": true,
      "shorthand": "-d"
    },
    {
      "name": "--kube-context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tail",
      "description": "Stream logs"
    },
    {
      "name": "--port-forward",
      "description": "Port forward services"
    },
    {
      "name": "--cleanup",
      "description": "Clean up on exit"
    }
  ],
  "examples": [
    "skaffold dev",
    "skaffold dev --port-forward --tail",
    "skaffold run --tag v1.0.0",
    "skaffold build",
    "skaffold deploy",
    "skaffold debug",
    "skaffold render --output rendered.yaml",
    "skaffold delete"
  ],
  "relatedCommands": [
    "kubectl",
    "docker",
    "helm",
    "tilt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Skaffold version",
        "command": "skaffold version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "skaffold"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "config",
        "description": "Skaffold pipeline configuration",
        "command": "cat skaffold.yaml 2>/dev/null | head -60",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "profiles",
        "description": "Skaffold profiles declared",
        "command": "grep -A5 '^profiles:' skaffold.yaml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
