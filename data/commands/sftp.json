{
  "name": "sftp",
  "description": "Interactive file transfer over SSH",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "-P",
      "description": "Port to connect to",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Identity file to use",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-b",
      "description": "Read commands from this batch file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-r",
      "description": "Recurse into directories",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-C",
      "description": "Enable compression",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-o",
      "description": "SSH option, as in ssh_config",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-J",
      "description": "Connect through this jump host",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-v",
      "description": "Print verbose output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-a",
      "description": "Resume partial transfers",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "sftp user@host",
      "description": "Open an interactive session"
    },
    {
      "command": "sftp -P 2222 user@host",
      "description": "Connect on a non-default port"
    },
    {
      "command": "sftp -b commands.txt user@host",
      "description": "Run a batch of commands"
    },
    {
      "command": "sftp -r user@host:/data ./local",
      "description": "Fetch a directory recursively"
    }
  ],
  "relatedCommands": [
    "scp",
    "ssh",
    "rsync",
    "ftp",
    "ssh-config"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "OpenSSH sftp client version",
        "command": "sftp -V 2>&1 | head -1 || ssh -V 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "hosts",
        "description": "Hosts defined in the SSH config",
        "command": "grep -i '^host ' ~/.ssh/config 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "agent_keys",
        "description": "Keys loaded into the SSH agent",
        "command": "ssh-add -l 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
