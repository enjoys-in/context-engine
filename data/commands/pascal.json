{
  "language": "pascal",
  "name": "fpc",
  "description": "Free Pascal Compiler — Object Pascal / Delphi compiler",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-O1 / -O2 / -O3",
      "description": "Optimization level"
    },
    {
      "name": "-g",
      "description": "Generate debug information"
    },
    {
      "name": "-Mdelphi / -Mobjfpc",
      "description": "Language compatibility mode (Delphi, ObjFPC)"
    },
    {
      "name": "-Fu<path>",
      "description": "Unit search path"
    },
    {
      "name": "-Fi<path>",
      "description": "Include file search path"
    },
    {
      "name": "-o<name>",
      "description": "Output executable name"
    },
    {
      "name": "-Sh",
      "description": "Use ansistrings by default"
    },
    {
      "name": "-Tlinux / -Twin64",
      "description": "Target operating system"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    }
  ],
  "subcommands": [
    {
      "name": "program.pas",
      "description": "Compile a Pascal program",
      "args": [
        {
          "name": "file",
          "description": "Pascal source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-Fu",
          "description": "Add a unit search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-Fi",
          "description": "Add an include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "fpc program.pas"
      ]
    },
    {
      "name": "-O2 program.pas",
      "description": "Compile with optimization level 2",
      "args": [
        {
          "name": "file",
          "description": "Pascal source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-Fu",
          "description": "Add a unit search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-Fi",
          "description": "Add an include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "fpc -O2 program.pas"
      ]
    },
    {
      "name": "-g program.pas",
      "description": "Compile with debug information",
      "args": [
        {
          "name": "file",
          "description": "Pascal source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-Fu",
          "description": "Add a unit search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-Fi",
          "description": "Add an include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "fpc -g program.pas"
      ]
    },
    {
      "name": "-Mdelphi program.pas",
      "description": "Compile in Delphi compatibility mode",
      "args": [
        {
          "name": "file",
          "description": "Pascal source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-Fu",
          "description": "Add a unit search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-Fi",
          "description": "Add an include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "fpc -Mdelphi program.pas"
      ]
    },
    {
      "name": "-FUunits/ program.pas",
      "description": "Set unit output directory",
      "args": [
        {
          "name": "file",
          "description": "Pascal source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-Fu",
          "description": "Add a unit search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-Fi",
          "description": "Add an include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-O",
          "description": "Optimisation level to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-g",
          "description": "Emit debug information",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "fpc -FUunits/ program.pas"
      ]
    }
  ],
  "examples": [
    "fpc program.pas",
    "fpc -O2 -o myapp program.pas",
    "fpc -Mdelphi -g program.pas",
    "fpc -FUunits/ -Fulib/ main.pas",
    "lazbuild project.lpi"
  ],
  "relatedCommands": [
    "lazarus",
    "gcc",
    "m3",
    "vb"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Free Pascal compiler version",
        "command": "fpc -iV 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "fpc"
      },
      {
        "name": "target",
        "description": "Free Pascal target platform",
        "command": "fpc -iTP 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "fpc"
      },
      {
        "name": "sources",
        "description": "Pascal sources",
        "command": "find . -maxdepth 3 -name '*.pas' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "lazarus_projects",
        "description": "Lazarus projects here",
        "command": "find . -maxdepth 2 -name '*.lpi' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
