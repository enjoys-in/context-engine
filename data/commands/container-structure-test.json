{
  "name": "container-structure-test",
  "aliases": [
    "cst"
  ],
  "description": "Validate the contents and structure of container images",
  "category": "container",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "test",
      "description": "Run the configured tests against an image",
      "options": [
        {
          "name": "--image",
          "description": "Image to test",
          "type": "string",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--config",
          "description": "Test configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output",
          "description": "Output format (text, json, junit)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--pull",
          "description": "Pull the image first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--driver",
          "description": "Test driver (docker, tar, host)",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--force",
          "description": "Run even without a matching driver",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Show the installed version"
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbosity",
      "description": "Logging level",
      "type": "string",
      "takesValue": true,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-test output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "container-structure-test test --image app:dev --config tests.yaml",
      "description": "Validate an image"
    },
    {
      "command": "container-structure-test test -i app:dev -c tests.yaml -o junit",
      "description": "Emit JUnit results"
    },
    {
      "command": "container-structure-test test -i app:dev -c tests.yaml --pull",
      "description": "Pull before testing"
    }
  ],
  "relatedCommands": [
    "docker",
    "dive",
    "hadolint",
    "trivy"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "container-structure-test version",
        "command": "container-structure-test version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "container-structure-test"
      },
      {
        "name": "test_configs",
        "description": "Structure test configurations in this project",
        "command": "find . -maxdepth 3 -name '*structure-test*.yaml' -o -maxdepth 3 -name '*structure-test*.yml' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "images",
        "description": "Local images available to test",
        "command": "docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "docker"
      }
    ]
  }
}
