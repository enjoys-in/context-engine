          "name": "--port",
          "description": "Redis server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--pass",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--db",
          "description": "Database index to select",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--tls",
          "description": "Connect over TLS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--count",
          "description": "Keys to scan per iteration",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--stat",
      "description": "Show server stats",
      "args": [],
      "options": [
        {
          "name": "--host",
          "description": "Redis server host",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Redis server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--pass",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--db",
          "description": "Database index to select",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--tls",
          "description": "Connect over TLS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--interval",
          "description": "Seconds between samples",
          "type": "integer",
          "takesValue": true,
          "short": "-i",
          "shorthand": "-i"
        }
      ]
    },
    {
      "name": "--bigkeys",
      "description": "Find big keys",
      "args": [],
      "options": [
        {
          "name": "--host",
          "description": "Redis server host",
          "type": "string",
          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Redis server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--pass",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--db",
          "description": "Database index to select",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--tls",
          "description": "Connect over TLS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--memkeys",
          "description": "Sample memory usage rather than key size",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    {
      "command": "redis-server",
      "description": "Start Redis server"
    },
    {
      "command": "redis-cli ping",
      "description": "Test Redis connection"
    },
    {
      "command": "redis-cli SET key value",
      "description": "Set a key-value pair"
    },
    {
      "command": "redis-cli --scan --pattern 'user:*'",
      "description": "Scan keys matching pattern"
    }
  ],
  "relatedCommands": [
    "redis-cli",
    "redis-server",
    "redis-benchmark"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "redis-cli version",
        "command": "redis-cli --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "redis-cli"
      },
      {
        "name": "ping",
        "description": "Redis server reachability",
        "command": "redis-cli ping 2>/dev/null",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "redis-cli"
      },
      {
        "name": "server_info",
        "description": "Redis server information",
        "command": "redis-cli info server 2>/dev/null | head -20",
        "parser": "keyvalue",
        "cacheFor": 60,
        "requiresCmd": "redis-cli"
      },
      {
        "name": "databases",
        "description": "Redis keyspace in use",
        "command": "redis-cli info keyspace 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 30,
        "requiresCmd": "redis-cli"
      }
    ]
  }
}
