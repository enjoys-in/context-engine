          "takesValue": true,
          "short": "-h",
          "shorthand": "-h"
        },
        {
          "name": "--port",
          "description": "Redis server port",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--pass",
          "description": "Password to authenticate with",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--db",
          "description": "Database index to select",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--tls",
          "description": "Connect over TLS",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--user",
          "description": "ACL user to authenticate as",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--scan --pattern '*'",
      "description": "Scan keys",
      "args": [],
