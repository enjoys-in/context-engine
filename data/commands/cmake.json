{
  "name": "cmake",
  "description": "Cross-platform build system generator for C/C++ projects",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "--build",
      "description": "Build a project",
      "options": [
        {
          "name": "--target",
          "shorthand": "-t",
          "description": "Build specific target",
          "takesValue": true,
          "short": "-t"
        },
        {
          "name": "--config",
          "description": "Configuration (Debug, Release, etc.)",
          "takesValue": true
        },
        {
          "name": "--parallel",
          "shorthand": "-j",
          "description": "Number of parallel jobs",
          "takesValue": true,
          "short": "-j"
        },
        {
          "name": "--clean-first",
          "description": "Clean before building"
        },
        {
          "name": "--verbose",
          "shorthand": "-v",
          "description": "Verbose output",
          "short": "-v"
        }
      ],
      "examples": [
        "cmake --build"
      ]
    },
    {
      "name": "--install",
      "description": "Install built project",
      "options": [
        {
          "name": "--prefix",
          "description": "Install prefix",
          "takesValue": true
        },
        {
          "name": "--config",
          "description": "Install configuration",
          "takesValue": true
        },
        {
          "name": "--component",
          "description": "Install specific component",
          "takesValue": true
        },
        {
          "name": "--strip",
          "description": "Strip binaries"
        }
      ],
      "examples": [
        "cmake --install"
      ]
    },
    {
      "name": "--open",
      "description": "Open project in IDE",
      "options": [
        {
          "name": "--open",
          "description": "Open the generated project in its IDE",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "cmake --open"
      ]
    },
    {
      "name": "-E",
      "description": "Command-line tool mode",
      "subcommands": [
        {
          "name": "capabilities",
          "description": "Show cmake capabilities",
          "options": [],
          "examples": [
            "cmake -E capabilities"
          ]
        },
        {
          "name": "copy",
          "description": "Copy files",
          "options": [],
          "args": [
            {
              "name": "source",
              "description": "Files to copy",
              "required": true,
              "type": "string"
            },
            {
              "name": "destination",
              "description": "Destination path",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "cmake -E copy"
          ]
        },
        {
          "name": "copy_directory",
          "description": "Copy directory",
          "options": [],
          "examples": [
            "cmake -E copy_directory"
          ]
        },
        {
          "name": "copy_if_different",
          "description": "Copy if different",
          "options": [],
          "examples": [
            "cmake -E copy_if_different"
          ]
        },
        {
          "name": "echo",
          "description": "Print message",
          "options": [],
          "examples": [
            "cmake -E echo"
          ]
        },
        {
          "name": "env",
          "description": "Run in modified environment",
          "options": [],
          "examples": [
            "cmake -E env"
          ]
        },
        {
          "name": "make_directory",
          "description": "Create directory",
          "options": [],
          "examples": [
            "cmake -E make_directory"
          ]
        },
        {
          "name": "md5sum",
          "description": "Compute MD5",
          "options": [],
          "examples": [
            "cmake -E md5sum"
          ]
        },
        {
          "name": "sha256sum",
          "description": "Compute SHA256",
          "options": [],
          "examples": [
            "cmake -E sha256sum"
          ]
        },
        {
          "name": "remove",
          "description": "Remove files",
          "options": [
            {
              "name": "-f",
              "description": "Ignore missing files",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "files",
              "description": "Files to remove",
              "required": true,
              "type": "path"
            }
          ],
          "examples": [
            "cmake -E remove"
          ]
        },
        {
          "name": "rename",
          "description": "Rename file",
          "options": [],
          "args": [
            {
              "name": "source",
              "description": "Path to rename",
              "required": true,
              "type": "string"
            },
            {
              "name": "destination",
              "description": "New path",
              "required": true,
              "type": "string"
            }
          ],
          "examples": [
            "cmake -E rename"
          ]
        },
        {
          "name": "tar",
          "description": "Create/extract archives",
          "options": [
            {
              "name": "--format",
              "description": "Archive format",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--files-from",
              "description": "Read the file list from here",
              "type": "file",
              "takesValue": true
            }
          ],
          "examples": [
            "cmake -E tar"
          ]
        },
        {
          "name": "touch",
          "description": "Touch files",
          "options": [],
          "examples": [
            "cmake -E touch"
          ]
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-S",
      "description": "Source directory",
      "takesValue": true
    },
    {
      "name": "-B",
      "description": "Build directory",
      "takesValue": true
    },
    {
      "name": "-G",
      "description": "Generator (Unix Makefiles, Ninja, Visual Studio, etc.)",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Define cache variable",
      "takesValue": true
    },
    {
      "name": "-C",
      "description": "Pre-load cache script",
      "takesValue": true
    },
    {
      "name": "-U",
      "description": "Undefine cache variable",
      "takesValue": true
    },
    {
      "name": "--preset",
      "description": "Use CMake preset",
      "takesValue": true
    },
    {
      "name": "--list-presets",
      "description": "List available presets"
    },
    {
      "name": "-A",
      "description": "Platform name (VS generators)",
      "takesValue": true
    },
    {
      "name": "-T",
      "description": "Toolset name (VS generators)",
      "takesValue": true
    },
    {
      "name": "--toolchain",
      "description": "Toolchain file",
      "takesValue": true
    },
    {
      "name": "--log-level",
      "description": "Log level (ERROR, WARNING, NOTICE, STATUS, VERBOSE, DEBUG, TRACE)",
      "takesValue": true
    },
    {
      "name": "--trace",
      "description": "Trace cmake execution"
    },
    {
      "name": "--trace-expand",
      "description": "Trace with variable expansion"
    },
    {
      "name": "--warn-uninitialized",
      "description": "Warn about uninitialized vars"
    },
    {
      "name": "--fresh",
      "description": "Clean build tree"
    },
    {
      "name": "--version",
      "description": "Show version"
    },
    {
      "name": "--help",
      "description": "Show help"
    }
  ],
  "examples": [
    {
      "command": "cmake -B build -DCMAKE_BUILD_TYPE=Release",
      "description": "Configure release build"
    },
    {
      "command": "cmake --build build -j$(nproc)",
      "description": "Build with all cores"
    },
    {
      "command": "cmake --build build --target install",
      "description": "Install"
    },
    {
      "command": "cmake -B build -G Ninja",
      "description": "Use Ninja generator"
    },
    {
      "command": "cmake --preset release",
      "description": "Use preset"
    },
    {
      "command": "cmake --build build --clean-first",
      "description": "Clean and rebuild"
    },
    {
      "command": "cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr/local",
      "description": "Set install prefix"
    },
    {
      "command": "cmake -B build -DCMAKE_TOOLCHAIN_FILE=conan_toolchain.cmake",
      "description": "Use toolchain file"
    }
  ],
  "relatedCommands": [
    "make",
    "bazel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "cmake_files",
        "description": "CMakeLists.txt files",
        "command": "find . -name 'CMakeLists.txt' -not -path './build/*' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "presets",
        "description": "Available CMake presets",
        "command": "cmake --list-presets 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "cmake"
      },
      {
        "name": "cache_vars",
        "description": "CMake cache variables",
        "command": "cat build/CMakeCache.txt 2>/dev/null | grep -v '^#' | grep -v '^$' | head -20",
        "parser": "keyvalue",
        "cacheFor": 30
      },
      {
        "name": "targets",
        "description": "Available build targets",
        "command": "cmake --build build --target help 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "cmake"
      },
      {
        "name": "presets_file",
        "description": "CMake presets configuration",
        "command": "cat CMakePresets.json 2>/dev/null | head -30",
        "parser": "json",
        "cacheFor": 60
      }
    ]
  }
}
