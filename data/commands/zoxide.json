{
  "name": "zoxide",
  "description": "Smarter cd that learns the directories you use",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "add",
      "description": "Record a directory visit",
      "args": [
        {
          "name": "path",
          "description": "Directory to record",
          "type": "directory",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "query",
      "description": "Look up a directory from a query",
      "options": [
        {
          "name": "--interactive",
          "description": "Pick from matches with fzf",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--list",
          "description": "Print every match",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--score",
          "description": "Show each match score",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "keywords",
          "description": "Words to match against",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "name": "remove",
      "description": "Forget a directory",
      "options": [
        {
          "name": "--interactive",
          "description": "Pick which to remove",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Directory to forget",
          "type": "directory",
          "required": false
        }
      ]
    },
    {
      "name": "init",
      "description": "Print the shell integration snippet",
      "options": [
        {
          "name": "--cmd",
          "description": "Command name to define instead of z",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--hook",
          "description": "When to record visits (prompt, pwd, none)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-cmd",
          "description": "Do not define the shortcut command",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "shell",
          "description": "Shell to generate for (bash, zsh, fish, powershell)",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "edit",
      "description": "Interactively edit the database",
      "options": []
    },
    {
      "name": "import",
      "description": "Import a database from autojump or z",
      "options": [
        {
          "name": "--from",
          "description": "Source format (autojump, z)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--merge",
          "description": "Merge instead of replacing",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Database file to import",
          "type": "file",
          "required": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "eval \"$(zoxide init zsh)\"",
      "description": "Enable the shell integration"
    },
    {
      "command": "z proj",
      "description": "Jump to the best match for \"proj\""
    },
    {
      "command": "zoxide query -l",
      "description": "List every known directory"
    },
    {
      "command": "zoxide remove /tmp/old",
      "description": "Forget a directory"
    }
  ],
  "relatedCommands": [
    "cd",
    "fzf",
    "autojump",
    "fd"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "zoxide version",
        "command": "zoxide --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "zoxide"
      },
      {
        "name": "top_dirs",
        "description": "Most-visited directories zoxide tracks",
        "command": "zoxide query --list --score 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "zoxide"
      },
      {
        "name": "data_dir",
        "description": "zoxide database location",
        "command": "echo \"${_ZO_DATA_DIR:-$HOME/.local/share/zoxide}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
