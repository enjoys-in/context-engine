{
  "name": "gifsicle",
  "description": "Create, edit and optimise GIF images and animations",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--optimize",
      "description": "Optimisation level 1-3",
      "type": "integer",
      "takesValue": true,
      "short": "-O",
      "shorthand": "-O"
    },
    {
      "name": "--output",
      "description": "Write to this file",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--batch",
      "description": "Modify each input file in place",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--colors",
      "description": "Reduce to this many colours",
      "type": "integer",
      "takesValue": true,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--resize",
      "description": "Resize to WxH",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--resize-fit",
      "description": "Resize to fit within WxH",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--scale",
      "description": "Scale by this factor",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--delay",
      "description": "Frame delay in hundredths of a second",
      "type": "integer",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--loopcount",
      "description": "Times to loop; 0 is forever",
      "type": "string",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--crop",
      "description": "Crop to a region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--dither",
      "description": "Dither when reducing colours",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--info",
      "description": "Print information about the file",
      "type": "boolean",
      "takesValue": false,
      "short": "-I",
      "shorthand": "-I"
    }
  ],
  "examples": [
    {
      "command": "gifsicle -O3 in.gif -o out.gif",
      "description": "Optimise an animation"
    },
    {
      "command": "gifsicle --resize-fit 480x_ in.gif -o small.gif",
      "description": "Scale to a width"
    },
    {
      "command": "gifsicle -I anim.gif",
      "description": "Inspect the frames"
    },
    {
      "command": "gifsicle -O3 -k 64 in.gif -o out.gif",
      "description": "Optimise and reduce to 64 colours"
    }
  ],
  "relatedCommands": [
    "imagemagick",
    "ffmpeg",
    "optipng"
  ]
}
