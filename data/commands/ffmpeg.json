{
  "name": "ffmpeg",
  "description": "Universal media converter — audio, video, streaming",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-i",
      "description": "Input file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-c:v",
      "description": "Video codec",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-c:a",
      "description": "Audio codec",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-b:v",
      "description": "Video bitrate",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-b:a",
      "description": "Audio bitrate",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-r",
      "description": "Frame rate",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Frame size (WxH)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-ss",
      "description": "Start time offset",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Duration",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-to",
      "description": "Stop time",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-vn",
      "description": "No video"
    },
    {
      "name": "-an",
      "description": "No audio"
    },
    {
      "name": "-f",
      "description": "Force format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-y",
      "description": "Overwrite output"
    },
    {
      "name": "-map",
      "description": "Stream mapping",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-filter:v",
      "description": "Video filter",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-filter:a",
      "description": "Audio filter",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "ffmpeg -i input.mp4 output.avi",
    "ffmpeg -i input.mp4 -c:v libx264 -crf 23 output.mp4",
    "ffmpeg -i input.mp4 -vn -c:a libmp3lame output.mp3",
    "ffmpeg -i input.mp4 -ss 00:01:00 -t 30 clip.mp4",
    "ffmpeg -i input.mp4 -vf scale=1280:720 output.mp4",
    "ffmpeg -i input.mp4 -r 30 -s 1920x1080 output.mp4"
  ],
  "relatedCommands": [
    "ffprobe",
    "imagemagick",
    "sox",
    "vlc"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "FFmpeg version and build configuration",
        "command": "ffmpeg -version 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ffmpeg"
      },
      {
        "name": "encoders",
        "description": "Video and audio encoders available",
        "command": "ffmpeg -hide_banner -encoders 2>/dev/null | head -30",
        "parser": "table",
        "cacheFor": 3600,
        "requiresCmd": "ffmpeg"
      },
      {
        "name": "hwaccels",
        "description": "Hardware acceleration methods available",
        "command": "ffmpeg -hide_banner -hwaccels 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "ffmpeg"
      },
      {
        "name": "media_files",
        "description": "Media files in this directory",
        "command": "find . -maxdepth 2 -name '*.mp4' -o -name '*.mkv' -o -name '*.mov' -o -name '*.mp3' -o -name '*.wav' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
