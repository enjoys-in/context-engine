    {
      "name": "kubernetes",
      "description": "Manage Kubernetes clusters",
      "subcommands": [
        {
          "name": "cluster",
          "description": "Cluster operations",
          "subcommands": [
            {
              "name": "create",
              "description": "Create cluster",
              "examples": [
                "doctl kubernetes cluster create my-cluster --region nyc1 --node-pool 'name=default;size=s-2vcpu-4gb;count=3'"
              ],
              "options": [
                {
                  "name": "--region",
                  "description": "Region to operate in",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--version",
                  "description": "Kubernetes version",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--node-pool",
                  "description": "Node pool specification",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--auto-upgrade",
                  "description": "Enable automatic upgrades",
                  "type": "boolean",
                  "takesValue": false
                },
                {
                  "name": "--ha",
                  "description": "Enable a highly available control plane",
                  "type": "boolean",
                  "takesValue": false
                },
                {
                  "name": "--surge-upgrade",
                  "description": "Enable surge upgrades",
                  "type": "boolean",
                  "takesValue": false
                },
                {
                  "name": "--set-current-context",
                  "description": "Switch kubectl to the new cluster",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--wait",
                  "description": "Block until the operation completes",
                  "type": "boolean",
                  "takesValue": false
                }
              ],
              "args": [
                {
                  "name": "name",
                  "description": "Name for the new cluster",
                  "required": true,
                  "type": "string"
                }
              ]
            },
            {
              "name": "list",
              "description": "List clusters",
              "examples": [
                "doctl kubernetes cluster list"
              ],
              "options": [
                {
                  "name": "--format",
                  "description": "Output format (json, text, table)",
                  "type": "string",
                  "takesValue": true
                }
              ]
            },
            {
              "name": "kubeconfig",
              "description": "Get kubeconfig",
              "examples": [
                "doctl kubernetes cluster kubeconfig save my-cluster"
              ],
              "options": [
                {
                  "name": "--set-current-context",
                  "description": "Switch kubectl to this cluster",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--expiry-seconds",
                  "description": "Credential lifetime",
                  "type": "integer",
                  "takesValue": true
                }
              ]
            },
            {
              "name": "delete",
              "description": "Delete cluster",
              "examples": [
                "doctl kubernetes cluster delete my-cluster --force"
              ],
              "options": [
                {
                  "name": "--force",
                  "description": "Do not prompt for confirmation",
                  "type": "boolean",
                  "takesValue": false,
                  "short": "-f",
                  "shorthand": "-f"
                },
                {
                  "name": "--dangerous",
                  "description": "Also delete attached resources",
                  "type": "boolean",
                  "takesValue": false
                }
              ],
              "args": [
                {
                  "name": "id",
                  "description": "Cluster id or name to delete",
                  "required": true,
                  "type": "string"
                }
              ]
            },
            {
              "name": "node-pool",
              "description": "Manage node pools",
              "examples": [
                "doctl kubernetes cluster node-pool list my-cluster",
                "doctl kubernetes cluster node-pool create my-cluster --name gpu-pool --size g-2vcpu-8gb --count 2"
              ],
              "options": [
                {
                  "name": "--count",
                  "description": "Node count",
                  "type": "integer",
                  "takesValue": true
                },
                {
                  "name": "--size",
                  "description": "Node size slug",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--auto-scale",
                  "description": "Enable autoscaling",
                  "type": "boolean",
                  "takesValue": false
                },
                {
                  "name": "--min-nodes",
                  "description": "Minimum nodes",
                  "type": "integer",
                  "takesValue": true
                },
                {
                  "name": "--max-nodes",
                  "description": "Maximum nodes",
                  "type": "integer",
                  "takesValue": true
                }
              ]
            }
          ]
        }
      ]
    },
