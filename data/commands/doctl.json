{
  "name": "doctl",
  "description": "DigitalOcean CLI for managing infrastructure and services",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "compute",
      "description": "Manage compute resources (droplets, volumes, etc.)",
      "subcommands": [
        {
          "name": "droplet",
          "description": "Manage Droplets",
          "subcommands": [
            {
              "name": "create",
              "description": "Create a Droplet",
              "examples": [
                "doctl compute droplet create my-droplet --image ubuntu-22-04-x64 --size s-1vcpu-1gb --region nyc1",
                "doctl compute droplet create web --image ubuntu-22-04-x64 --size s-2vcpu-4gb --region sfo3 --ssh-keys 12345 --user-data-file cloud-init.yaml"
              ],
              "options": [
                {
                  "name": "--size",
                  "description": "Droplet size slug",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--image",
                  "description": "Image slug or id",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--region",
                  "description": "Region to operate in",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--ssh-keys",
                  "description": "SSH keys to add",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--user-data",
                  "description": "Cloud-init user data",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--user-data-file",
                  "description": "Cloud-init file",
                  "type": "file",
                  "takesValue": true
                },
                {
                  "name": "--enable-monitoring",
                  "description": "Install the monitoring agent",
                  "type": "boolean",
                  "takesValue": false
                },
                {
                  "name": "--enable-backups",
                  "description": "Enable automatic backups",
                  "type": "boolean",
                  "takesValue": false
                },
                {
                  "name": "--vpc-uuid",
                  "description": "VPC to attach to",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--tag-names",
                  "description": "Tags to apply",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--wait",
                  "description": "Block until the operation completes",
                  "type": "boolean",
                  "takesValue": false
                }
              ],
              "args": [
                {
                  "name": "name",
                  "description": "Name for the new Droplet",
                  "required": true,
                  "type": "string"
                }
              ]
            },
            {
              "name": "list",
              "description": "List Droplets",
              "examples": [
                "doctl compute droplet list",
                "doctl compute droplet list --format ID,Name,PublicIPv4"
              ],
              "options": [
                {
                  "name": "--format",
                  "description": "Output format (json, text, table)",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--tag-name",
                  "description": "Only droplets with this tag",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--no-header",
                  "description": "Omit the header row",
                  "type": "boolean",
                  "takesValue": false
                }
              ]
            },
            {
              "name": "get",
              "description": "Get Droplet details",
              "examples": [
                "doctl compute droplet get 12345"
              ],
              "options": [
                {
                  "name": "--format",
                  "description": "Output format (json, text, table)",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--template",
                  "description": "Go template for the output",
                  "type": "string",
                  "takesValue": true
                }
              ],
              "args": [
                {
                  "name": "id",
                  "description": "Droplet id or name to fetch",
                  "required": true,
                  "type": "string"
                }
              ]
            },
            {
              "name": "delete",
              "description": "Delete Droplet",
              "examples": [
                "doctl compute droplet delete 12345 --force"
              ],
              "options": [
                {
                  "name": "--force",
                  "description": "Do not prompt for confirmation",
                  "type": "boolean",
                  "takesValue": false,
                  "short": "-f",
                  "shorthand": "-f"
                },
                {
                  "name": "--tag-name",
                  "description": "Delete every droplet with this tag",
                  "type": "string",
                  "takesValue": true
                }
              ],
              "args": [
                {
                  "name": "id",
                  "description": "Droplet id or name to delete",
                  "required": true,
                  "type": "string"
                }
              ]
            },
            {
              "name": "actions",
              "description": "Droplet actions",
              "examples": [
                "doctl compute droplet-action power-off 12345",
                "doctl compute droplet-action power-on 12345",
                "doctl compute droplet-action reboot 12345",
                "doctl compute droplet-action snapshot 12345 --snapshot-name my-snap"
              ],
              "options": [
                {
                  "name": "--format",
                  "description": "Output format (json, text, table)",
                  "type": "string",
                  "takesValue": true
                }
              ]
            }
          ]
        },
        {
          "name": "volume",
          "description": "Manage block storage volumes",
          "subcommands": [
            {
              "name": "create",
              "description": "Create volume",
              "examples": [
                "doctl compute volume create my-vol --region nyc1 --size 100GiB"
              ],
              "options": [
                {
                  "name": "--size",
                  "description": "Volume size, e.g. 100GiB",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--region",
                  "description": "Region to operate in",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--fs-type",
                  "description": "Filesystem to create",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--desc",
                  "description": "Volume description",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--tag",
                  "description": "Tags to apply",
                  "type": "string",
                  "takesValue": true
                }
              ],
              "args": [
                {
                  "name": "name",
                  "description": "Name for the new volume",
                  "required": true,
                  "type": "string"
                }
              ]
            },
            {
              "name": "list",
              "description": "List volumes",
              "examples": [
                "doctl compute volume list"
              ],
              "options": [
                {
                  "name": "--format",
                  "description": "Output format (json, text, table)",
                  "type": "string",
                  "takesValue": true
                },
                {
                  "name": "--region",
                  "description": "Region to operate in",
                  "type": "string",
                  "takesValue": true
                }
              ]
            },
            {
              "name": "delete",
              "description": "Delete volume",
              "examples": [
                "doctl compute volume delete vol-id --force"
              ],
              "options": [
                {
                  "name": "--force",
                  "description": "Do not prompt for confirmation",
                  "type": "boolean",
                  "takesValue": false,
                  "short": "-f",
                  "shorthand": "-f"
                }
              ],
              "args": [
                {
                  "name": "id",
                  "description": "Volume id to delete",
                  "required": true,
                  "type": "string"
                }
              ]
            }
          ]
        },
        {
          "name": "load-balancer",
          "description": "Manage load balancers",
          "subcommands": [
            {
              "name": "create",
              "description": "Create LB",
              "examples": [
                "doctl compute load-balancer create --name my-lb --region nyc1 --forwarding-rules entry_protocol:http,entry_port:80,target_protocol:http,target_port:8080 --droplet-ids 12345"
