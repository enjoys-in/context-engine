{
  "name": "ibmcloud",
  "description": "IBM Cloud CLI",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Login to IBM Cloud",
      "examples": [
        "ibmcloud login",
        "ibmcloud login --sso",
        "ibmcloud login --apikey @apikey.json",
        "ibmcloud login -r us-south"
      ],
      "options": [
        {
          "name": "--apikey",
          "description": "API key or file to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--sso",
          "description": "Authenticate with a one-time passcode",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--account",
          "description": "Account to target",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--resource-group",
          "description": "Resource group to target",
          "type": "string",
          "takesValue": true,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--no-region",
          "description": "Log in without targeting a region",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "target",
      "description": "Set target org/space/group",
      "examples": [
        "ibmcloud target -g default",
        "ibmcloud target -r us-south",
        "ibmcloud target --cf-api https://api.us-south.cf.cloud.ibm.com"
      ],
      "options": [
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--account",
          "description": "Account to target",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--resource-group",
          "description": "Resource group to target",
          "type": "string",
          "takesValue": true,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--cf",
          "description": "Target a Cloud Foundry org and space",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--org",
          "description": "Cloud Foundry org to target",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--space",
          "description": "Cloud Foundry space to target",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        }
      ]
    },
    {
      "name": "ks cluster",
      "description": "Kubernetes Service clusters",
      "examples": [
        "ibmcloud ks cluster ls",
        "ibmcloud ks cluster create --name mycluster --zone dal10",
        "ibmcloud ks cluster config --cluster mycluster",
        "ibmcloud ks cluster rm --cluster mycluster -f"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "ce",
      "description": "Code Engine",
      "examples": [
        "ibmcloud ce project list",
        "ibmcloud ce project create --name my-project",
        "ibmcloud ce app create --name myapp --image icr.io/ns/app:latest",
        "ibmcloud ce app list"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "cr",
      "description": "Container Registry",
      "examples": [
        "ibmcloud cr namespace-list",
        "ibmcloud cr image-list",
        "ibmcloud cr login",
        "ibmcloud cr namespace-add my-ns"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "is",
      "description": "VPC Infrastructure Service",
      "examples": [
        "ibmcloud is instances",
        "ibmcloud is instance-create my-vm vpc-id subnet-id profile bx2-2x8 --image ibm-ubuntu-22-04",
        "ibmcloud is vpcs",
        "ibmcloud is subnets"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "cos",
      "description": "Cloud Object Storage",
      "examples": [
        "ibmcloud cos bucket-list",
        "ibmcloud cos object-put --bucket my-bucket --key file.txt --body ./file.txt",
        "ibmcloud cos object-list --bucket my-bucket"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "fn",
      "description": "Cloud Functions",
      "examples": [
        "ibmcloud fn action list",
        "ibmcloud fn action create hello hello.js",
        "ibmcloud fn action invoke hello --result"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "resource",
      "description": "Resource management",
      "examples": [
        "ibmcloud resource groups",
        "ibmcloud resource service-instances",
        "ibmcloud resource service-instance-create my-db databases-for-postgresql standard us-south"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "iam",
      "description": "Identity and Access Management",
      "examples": [
        "ibmcloud iam api-keys",
        "ibmcloud iam api-key-create mykey",
        "ibmcloud iam access-groups",
        "ibmcloud iam service-ids"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "plugin",
      "description": "Manage CLI plugins",
      "examples": [
        "ibmcloud plugin list",
        "ibmcloud plugin install container-service",
        "ibmcloud plugin update --all"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "cf",
      "description": "Cloud Foundry commands",
      "examples": [
        "ibmcloud cf apps",
        "ibmcloud cf push",
        "ibmcloud cf logs app-name --recent"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    },
    {
      "name": "catalog",
      "description": "Browse service catalog",
      "examples": [
        "ibmcloud catalog service-marketplace",
        "ibmcloud catalog search postgresql"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format, typically json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-r",
      "description": "Region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-g",
      "description": "Resource group",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "description": "Output format (json)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "--apikey",
      "description": "API key for auth",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--region",
      "description": "Region to target",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--resource-group",
      "description": "Resource group to target",
      "type": "string",
      "takesValue": true,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--api",
      "description": "API endpoint to use",
      "type": "url",
      "takesValue": true
    },
    {
      "name": "--quiet",
      "description": "Suppress non-essential output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--json",
      "description": "Emit JSON",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "ibmcloud login --sso",
    "ibmcloud login --apikey @apikey.json",
    "ibmcloud ks cluster ls",
    "ibmcloud is instances",
    "ibmcloud cos bucket-list",
    "ibmcloud target -r us-south -g default",
    "ibmcloud cr image-list",
    "ibmcloud ce app list",
    "ibmcloud resource service-instances"
  ],
  "relatedCommands": [
    "aws",
    "az",
    "gcloud",
    "oci",
    "terraform"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "IBM Cloud CLI version",
        "command": "ibmcloud version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ibmcloud"
      },
      {
        "name": "target",
        "description": "Active IBM Cloud account, region and resource group",
        "command": "ibmcloud target 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 300,
        "requiresCmd": "ibmcloud"
      },
      {
        "name": "plugins",
        "description": "Installed IBM Cloud CLI plugins",
        "command": "ibmcloud plugin list 2>/dev/null",
        "parser": "table",
        "cacheFor": 3600,
        "requiresCmd": "ibmcloud"
      }
    ]
  }
}
