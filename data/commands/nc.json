{
  "name": "nc",
  "description": "Netcat — arbitrary TCP and UDP connections and listens",
  "category": "networking",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-l",
      "description": "Listen mode"
    },
    {
      "name": "-p",
      "description": "Port number",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-v",
      "description": "Verbose"
    },
    {
      "name": "-z",
      "description": "Zero-I/O mode (scanning)"
    },
    {
      "name": "-w",
      "description": "Timeout for connections (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-u",
      "description": "UDP mode"
    },
    {
      "name": "-k",
      "description": "Keep listening after disconnect"
    },
    {
      "name": "-n",
      "description": "No DNS resolution"
    },
    {
      "name": "-e",
      "description": "Execute program after connect",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "nc -zv host 80",
    "nc -l 8080",
    "nc host 1234 < file.txt",
    "nc -zv host 20-30",
    "echo 'test' | nc host 80",
    "nc -lk 9000",
    "nc -u host 514"
  ],
  "relatedCommands": [
    "socat",
    "nmap",
    "curl",
    "telnet"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "netcat variant and version",
        "command": "nc -h 2>&1 | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "nc"
      },
      {
        "name": "listening",
        "description": "Ports listening on this host",
        "command": "ss -tlnp 2>/dev/null | head -20 || netstat -an 2>/dev/null | grep LISTEN | head -20",
        "parser": "table",
        "cacheFor": 30
      }
    ]
  }
}
