{
  "name": "just",
  "description": "Handy command runner (modern alternative to Make)",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "--list",
      "description": "List available recipes",
      "options": [
        {
          "name": "--unsorted",
          "description": "Don't sort recipes"
        },
        {
          "name": "--list-heading",
          "description": "List heading text",
          "takesValue": true
        },
        {
          "name": "--list-prefix",
          "description": "Prefix for each recipe",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--summary",
      "description": "List recipe names",
      "options": []
    },
    {
      "name": "--show",
      "description": "Show recipe source",
      "args": [
        {
          "name": "recipe",
          "description": "Recipe name",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "--choose",
      "description": "Interactive recipe chooser",
      "options": [
        {
          "name": "--chooser",
          "description": "Program to pick the recipe with",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--init",
      "description": "Create empty justfile",
      "options": [
        {
          "name": "--justfile",
          "description": "Justfile path to create",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--edit",
      "description": "Open justfile in editor",
      "options": []
    },
    {
      "name": "--evaluate",
      "description": "Evaluate and print variables",
      "options": []
    },
    {
      "name": "--dump",
      "description": "Dump justfile as JSON or just format",
      "options": [
        {
          "name": "--dump-format",
          "description": "Format (just, json)",
          "takesValue": true
        }
      ]
    },
    {
      "name": "--fmt",
      "description": "Format justfile",
      "options": [
        {
          "name": "--check",
          "description": "Check without writing"
        }
      ]
    },
    {
      "name": "--completions",
      "description": "Generate shell completions",
      "args": [
        {
          "name": "shell",
          "description": "Shell (bash, zsh, fish, powershell)",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "--variables",
      "description": "List variables",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--justfile",
      "shorthand": "-f",
      "description": "Justfile path",
      "takesValue": true,
      "short": "-f"
    },
    {
      "name": "--working-directory",
      "shorthand": "-d",
      "description": "Working directory",
      "takesValue": true,
      "short": "-d"
    },
    {
      "name": "--set",
      "description": "Override variable",
      "takesValue": true
    },
    {
      "name": "--dotenv-filename",
      "description": "Dotenv filename",
      "takesValue": true
    },
    {
      "name": "--dotenv-path",
      "description": "Dotenv path",
      "takesValue": true
    },
    {
      "name": "--shell",
      "description": "Shell to use",
      "takesValue": true
    },
    {
      "name": "--shell-arg",
      "description": "Shell argument",
      "takesValue": true
    },
    {
      "name": "--dry-run",
      "shorthand": "-n",
      "description": "Dry run mode",
      "short": "-n"
    },
    {
      "name": "--highlight",
      "description": "Highlight echoed commands"
    },
    {
      "name": "--no-highlight",
      "description": "Don't highlight"
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose mode",
      "short": "-v"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet mode",
      "short": "-q"
    },
    {
      "name": "--yes",
      "description": "Auto-confirm prompts"
    },
    {
      "name": "--color",
      "description": "Color output (auto, always, never)",
      "takesValue": true
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-V",
      "description": "Show version",
      "short": "-V"
    }
  ],
  "examples": [
    {
      "command": "just",
      "description": "Run default recipe"
    },
    {
      "command": "just build",
      "description": "Run build recipe"
    },
    {
      "command": "just --list",
      "description": "List available recipes"
    },
    {
      "command": "just --show build",
      "description": "Show recipe source"
    },
    {
      "command": "just test arg1 arg2",
      "description": "Run recipe with arguments"
    },
    {
      "command": "just --set version 1.0.0 release",
      "description": "Override variable"
    },
    {
      "command": "just --choose",
      "description": "Interactive chooser"
    },
    {
      "command": "just --dry-run deploy",
      "description": "Dry run deploy"
    },
    {
      "command": "just --fmt --check",
      "description": "Check formatting"
    }
  ],
  "relatedCommands": [
    "make"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "recipes",
        "description": "Available recipes",
        "command": "just --list 2>/dev/null",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "just"
      },
      {
        "name": "variables",
        "description": "Justfile variables",
        "command": "just --evaluate 2>/dev/null | head -20",
        "parser": "keyvalue",
        "cacheFor": 15,
        "requiresCmd": "just"
      },
      {
        "name": "justfile",
        "description": "Justfile contents",
        "command": "cat justfile 2>/dev/null || cat Justfile 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 15
      },
      {
        "name": "summary",
        "description": "Recipe names list",
        "command": "just --summary 2>/dev/null",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "just"
      }
    ]
  }
}
