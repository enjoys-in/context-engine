{
  "name": "ifconfig",
  "description": "Configure network interfaces (legacy)",
  "category": "networking",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "up",
      "description": "Activate the interface"
    },
    {
      "name": "down",
      "description": "Deactivate the interface"
    },
    {
      "name": "-a",
      "description": "Display all interfaces"
    },
    {
      "name": "-s",
      "description": "Short listing format"
    }
  ],
  "examples": [
    "ifconfig",
    "ifconfig eth0",
    "ifconfig -a",
    "ifconfig eth0 up",
    "ifconfig eth0 down",
    "ifconfig eth0 192.168.1.10 netmask 255.255.255.0"
  ],
  "relatedCommands": [
    "ip",
    "route",
    "netstat",
    "ss"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ifconfig version",
        "command": "ifconfig --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ifconfig"
      },
      {
        "name": "interfaces",
        "description": "Interface addresses and state",
        "command": "ifconfig -a 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "ifconfig"
      },
      {
        "name": "up_interfaces",
        "description": "Interfaces currently up",
        "command": "ifconfig 2>/dev/null | grep -E '^[a-z]' | head -15",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "ifconfig"
      }
    ]
  }
}
