{
  "name": "curlie",
  "description": "Frontend to curl with httpie-style syntax",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Show the request and response headers",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--pretty",
      "description": "Force pretty-printing",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--plain",
      "description": "Disable colour and formatting",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--json",
      "description": "Send the body as JSON",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--form",
      "description": "Send the body as a form",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--output",
      "description": "Write the body to this file",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--header",
      "description": "Add a request header",
      "type": "string",
      "takesValue": true,
      "short": "-H",
      "shorthand": "-H"
    },
    {
      "name": "--request",
      "description": "HTTP method to use",
      "type": "string",
      "takesValue": true,
      "short": "-X",
      "shorthand": "-X"
    },
    {
      "name": "--data",
      "description": "Request body",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    }
  ],
  "examples": [
    {
      "command": "curlie example.com",
      "description": "Make a GET request"
    },
    {
      "command": "curlie POST api.example.com/users name=alice",
      "description": "Post JSON built from key=value pairs"
    },
    {
      "command": "curlie -v GET api.example.com/health",
      "description": "Show the full exchange"
    },
    {
      "command": "curlie GET api.example.com Authorization:\"Bearer t\"",
      "description": "Send a header"
    }
  ],
  "relatedCommands": [
    "curl",
    "httpie",
    "xh",
    "wget"
  ]
}
