{
  "name": "grype",
  "description": "Vulnerability scanner for container images and filesystems",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "db",
      "description": "Manage vulnerability database",
      "examples": [
        "grype db update",
        "grype db status",
        "grype db list"
      ],
      "options": [
        {
          "name": "--config",
          "description": "grype configuration file",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Output format (table, json, sarif, cyclonedx)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--fail-on",
      "description": "Fail if severity >= level (negligible, low, medium, high, critical)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--scope",
      "description": "Analysis scope (squashed, all-layers)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--only-fixed",
      "description": "Show only vulnerabilities with fixes"
    },
    {
      "name": "--add-cpes-if-none",
      "description": "Generate CPEs if package has none"
    },
    {
      "name": "--exclude",
      "description": "Exclude paths",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--by-cve",
      "description": "Orient results by CVE"
    }
  ],
  "examples": [
    "grype image:tag",
    "grype dir:.",
    "grype image:tag --fail-on high",
    "grype image:tag -o json",
    "grype sbom:./sbom.json",
    "grype image:tag --only-fixed"
  ],
  "relatedCommands": [
    "syft",
    "trivy",
    "cosign",
    "snyk"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "grype version",
        "command": "grype version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "grype"
      },
      {
        "name": "db_status",
        "description": "Vulnerability database status",
        "command": "grype db status 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "grype"
      },
      {
        "name": "config",
        "description": "grype configuration",
        "command": "cat .grype.yaml 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "sbom_files",
        "description": "SBOM files grype can scan",
        "command": "find . -maxdepth 2 -name '*.sbom.json' -o -maxdepth 2 -name 'sbom.json' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
