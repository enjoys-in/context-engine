{
  "name": "hey",
  "description": "HTTP load generator (formerly boom)",
  "category": "http-testing",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Number of requests",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Concurrency level",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-z",
      "description": "Duration (e.g. 30s, 1m)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-m",
      "description": "HTTP method",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Request body",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Request body file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-H",
      "description": "Custom header",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-T",
      "description": "Content-Type",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-a",
      "description": "Basic auth (user:pass)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-q",
      "description": "Rate limit (QPS per worker)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Timeout per request (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-o",
      "description": "Output format (csv)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "hey -n 1000 -c 50 http://localhost:8080/",
    "hey -z 30s -c 100 http://localhost:3000/",
    "hey -m POST -d '{\"name\":\"test\"}' -T application/json http://localhost:8080/api",
    "hey -n 500 -c 20 -H 'Authorization: Bearer token' http://api.example.com/"
  ],
  "relatedCommands": [
    "ab",
    "wrk",
    "vegeta",
    "siege"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "hey version",
        "command": "hey --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hey"
      },
      {
        "name": "open_files",
        "description": "File descriptor limit that caps concurrency",
        "command": "ulimit -n 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "cpu_count",
        "description": "Logical CPUs available for load generation",
        "command": "nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
