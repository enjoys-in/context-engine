{
  "name": "scoop",
  "description": "Command-line installer for Windows",
  "category": "package-manager",
  "platforms": [
    "windows"
  ],
  "shells": [
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install applications",
      "options": [
        {
          "name": "--global",
          "description": "Install for all users",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--skip",
          "description": "Skip the hash check",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--independent",
          "description": "Do not install dependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        }
      ],
      "args": [
        {
          "name": "app",
          "description": "Application to install",
          "type": "app",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Remove applications",
      "options": [
        {
          "name": "--global",
          "description": "Remove a global install",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--purge",
          "description": "Also delete persisted data",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "app",
          "description": "Application to remove",
          "type": "app",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "update",
      "description": "Update apps, or scoop itself",
      "options": [
        {
          "name": "--global",
          "description": "Update global installs",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--all",
          "description": "Update every app",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--skip",
          "description": "Skip the hash check",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "app",
          "description": "Application to update",
          "type": "app",
          "required": false,
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "search",
      "description": "Search the known buckets",
      "args": [
        {
          "name": "query",
          "description": "Search terms",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "list",
      "description": "List the installed apps",
      "args": [
        {
          "name": "pattern",
          "description": "Filter pattern",
          "type": "string",
          "required": false
        }
      ],
      "options": []
    },
    {
      "name": "info",
      "description": "Show details about an app",
      "args": [
        {
          "name": "app",
          "description": "Application name",
          "type": "app",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Show full manifest detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    },
    {
      "name": "bucket",
      "description": "Manage the app buckets",
      "options": []
    },
    {
      "name": "hold",
      "description": "Prevent an app from being updated",
      "args": [
        {
          "name": "app",
          "description": "Application name",
          "type": "app",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--global",
          "description": "Act on globally installed apps",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        }
      ]
    },
    {
      "name": "unhold",
      "description": "Allow an app to be updated again",
      "args": [
        {
          "name": "app",
          "description": "Application name",
          "type": "app",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--global",
          "description": "Act on globally installed apps",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        }
      ]
    },
    {
      "name": "cleanup",
      "description": "Remove old versions",
      "options": [
        {
          "name": "--global",
          "description": "Clean global installs",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--all",
          "description": "Clean every app",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--cache",
          "description": "Also remove the download cache",
          "type": "boolean",
          "takesValue": false,
          "short": "-k",
          "shorthand": "-k"
        }
      ]
    },
    {
      "name": "cache",
      "description": "Inspect or clear the download cache",
      "options": []
    },
    {
      "name": "status",
      "description": "Show which apps are outdated",
      "options": [
        {
          "name": "--local",
          "description": "Skip the remote check and compare locally only",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        }
      ]
    },
    {
      "name": "reset",
      "description": "Reset an app to resolve conflicts",
      "args": [
        {
          "name": "app",
          "description": "Application name",
          "type": "app",
          "required": true,
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": []
    },
    {
      "name": "which",
      "description": "Print the path of a shimmed command",
      "args": [
        {
          "name": "command",
          "description": "Command name",
          "type": "string",
          "required": true
        }
      ],
      "options": []
    },
    {
      "name": "export",
      "description": "Print the installed apps and buckets as JSON",
      "options": [
        {
          "name": "--config",
          "description": "Include the Scoop configuration",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "import",
      "description": "Install from an exported file",
      "args": [
        {
          "name": "file",
          "description": "Exported JSON",
          "type": "file",
          "required": true
        }
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "scoop install ripgrep",
      "description": "Install an application"
    },
    {
      "command": "scoop update --all",
      "description": "Update everything"
    },
    {
      "command": "scoop search node",
      "description": "Search the buckets"
    },
    {
      "command": "scoop bucket add extras",
      "description": "Add the extras bucket"
    },
    {
      "command": "scoop cleanup --all -k",
      "description": "Remove old versions and the cache"
    }
  ],
  "relatedCommands": [
    "winget",
    "choco",
    "brew",
    "apt"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Scoop version",
        "command": "scoop --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "scoop"
      },
      {
        "name": "installed",
        "description": "Apps Scoop has installed",
        "command": "scoop list 2>/dev/null | head -25",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "scoop"
      },
      {
        "name": "buckets",
        "description": "Scoop buckets configured",
        "command": "scoop bucket list 2>/dev/null",
        "parser": "table",
        "cacheFor": 3600,
        "requiresCmd": "scoop"
      },
      {
        "name": "status",
        "description": "Apps with updates available",
        "command": "scoop status 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "scoop"
      }
    ]
  }
}
