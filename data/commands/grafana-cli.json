{
  "name": "grafana-cli",
  "description": "Grafana command-line tool for managing plugins and server",
  "category": "monitoring",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "plugins install",
      "description": "Install a plugin",
      "examples": [
        "grafana-cli plugins install grafana-clock-panel"
      ],
      "options": [
        {
          "name": "--pluginsDir",
          "description": "Plugin directory to install into",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--repo",
          "description": "Plugin repository URL",
          "type": "url",
          "takesValue": true
        },
        {
          "name": "--insecure",
          "description": "Skip TLS verification",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "plugin",
          "description": "Plugin id to install",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "plugins"
          }
        }
      ]
    },
    {
      "name": "plugins list-remote",
      "description": "List available plugins",
      "examples": [
        "grafana-cli plugins list-remote"
      ],
      "options": [
        {
          "name": "--repo",
          "description": "Plugin repository URL",
          "type": "url",
          "takesValue": true
        }
      ]
    },
    {
      "name": "plugins ls",
      "description": "List installed plugins",
      "examples": [
        "grafana-cli plugins ls"
      ],
      "options": [
        {
          "name": "--pluginsDir",
          "description": "Plugin directory to list",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "plugins update",
      "description": "Update a plugin",
      "examples": [
        "grafana-cli plugins update grafana-clock-panel"
      ],
      "options": [
        {
          "name": "--pluginsDir",
          "description": "Plugin directory to update",
          "type": "directory",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "plugin",
          "description": "Plugin id to update",
          "required": true,
          "type": "package"
        }
      ]
    },
    {
      "name": "plugins update-all",
      "description": "Update all plugins",
      "examples": [
        "grafana-cli plugins update-all"
      ],
      "options": [
        {
          "name": "--pluginsDir",
          "description": "Plugin directory to update",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "plugins remove",
      "description": "Remove a plugin",
      "examples": [
        "grafana-cli plugins remove grafana-clock-panel"
      ],
      "options": [
        {
          "name": "--pluginsDir",
          "description": "Plugin directory to remove from",
          "type": "directory",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "plugin",
          "description": "Plugin id to remove",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "plugins"
          }
        }
      ]
    },
    {
      "name": "admin reset-admin-password",
      "description": "Reset admin password",
      "examples": [
        "grafana-cli admin reset-admin-password newpassword"
      ],
      "options": [
        {
          "name": "--homepath",
          "description": "Grafana home path",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--config",
          "description": "Configuration file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--password-from-stdin",
          "description": "Read the new password from stdin",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "password",
          "description": "New admin password",
          "required": true,
          "type": "secret"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--pluginsDir",
      "description": "Plugin directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--homepath",
      "description": "Grafana home path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Config file path",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    "grafana-cli plugins install grafana-clock-panel",
    "grafana-cli plugins ls",
    "grafana-cli plugins list-remote",
    "grafana-cli plugins update-all",
    "grafana-cli admin reset-admin-password newpass"
  ],
  "relatedCommands": [
    "prometheus",
    "grafana-server",
    "influxdb",
    "telegraf"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "grafana-cli version",
        "command": "grafana-cli --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "grafana-cli"
      },
      {
        "name": "plugins",
        "description": "Grafana plugins installed",
        "command": "grafana-cli plugins ls 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "grafana-cli"
      },
      {
        "name": "config",
        "description": "Grafana server configuration",
        "command": "grep -v '^;' /etc/grafana/grafana.ini 2>/dev/null | grep . | head -25",
        "parser": "keyvalue",
        "cacheFor": 300
      },
      {
        "name": "service",
        "description": "Grafana service state",
        "command": "systemctl is-active grafana-server 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
