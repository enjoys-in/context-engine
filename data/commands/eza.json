{
  "name": "eza",
  "aliases": [
    "exa2"
  ],
  "description": "Modern replacement for ls with git integration and colours",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--long",
      "description": "Show extended details",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--all",
      "description": "Include hidden entries",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--tree",
      "description": "Display as a tree",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--level",
      "description": "Depth limit for the tree",
      "type": "integer",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--git",
      "description": "Show git status per file",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--git-ignore",
      "description": "Hide files git ignores",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--header",
      "description": "Add a header row",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--icons",
      "description": "Show file-type icons",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sort",
      "description": "Sort field (name, size, modified, extension)",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--reverse",
      "description": "Reverse the sort order",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--only-dirs",
      "description": "List directories only",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--total-size",
      "description": "Show directory sizes recursively",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--grid",
      "description": "Display in a grid",
      "type": "boolean",
      "takesValue": false,
      "short": "-G",
      "shorthand": "-G"
    },
    {
      "name": "--across",
      "description": "Sort the grid across rather than down",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    }
  ],
  "examples": [
    {
      "command": "eza -la --git",
      "description": "Long listing with git status"
    },
    {
      "command": "eza -T -L 2",
      "description": "Two-level tree"
    },
    {
      "command": "eza -l --sort size --reverse",
      "description": "Largest files first"
    },
    {
      "command": "eza -D",
      "description": "Directories only"
    }
  ],
  "relatedCommands": [
    "ls",
    "exa",
    "tree",
    "fd",
    "bat"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "eza version",
        "command": "eza --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "eza"
      },
      {
        "name": "cwd_entries",
        "description": "Entries in the current directory",
        "command": "ls -A 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "config",
        "description": "eza colour configuration",
        "command": "echo \"${EZA_COLORS:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
