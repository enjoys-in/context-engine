{
  "name": "zellij",
  "description": "Terminal workspace and multiplexer",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "attach",
      "description": "Attach to an existing session",
      "options": [
        {
          "name": "--create",
          "description": "Create the session if it does not exist",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--index",
          "description": "Attach by session index",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "session",
          "description": "Session name",
          "type": "session",
          "required": false,
          "completion": {
            "detector": "sessions"
          }
        }
      ],
      "examples": [
        "zellij attach main"
      ]
    },
    {
      "name": "list-sessions",
      "description": "List the running sessions",
      "options": [
        {
          "name": "--no-formatting",
          "description": "Print without colour or formatting",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "examples": [
        "zellij list-sessions"
      ]
    },
    {
      "name": "kill-session",
      "description": "Terminate a session",
      "args": [
        {
          "name": "session",
          "description": "Session name",
          "type": "session",
          "required": true,
          "completion": {
            "detector": "sessions"
          }
        }
      ],
      "options": [],
      "examples": [
        "zellij kill-session main"
      ]
    },
    {
      "name": "kill-all-sessions",
      "description": "Terminate every session",
      "options": [
        {
          "name": "--yes",
          "description": "Do not prompt for confirmation",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "examples": [
        "zellij kill-all-sessions"
      ]
    },
    {
      "name": "delete-session",
      "description": "Delete a resurrectable session",
      "options": [
        {
          "name": "--force",
          "description": "Delete even if running",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "session",
          "description": "Session name",
          "type": "session",
          "required": true,
          "completion": {
            "detector": "sessions"
          }
        }
      ],
      "examples": [
        "zellij delete-session main"
      ]
    },
    {
      "name": "action",
      "description": "Send an action to the running session",
      "options": [],
      "examples": [
        "zellij action"
      ]
    },
    {
      "name": "run",
      "description": "Run a command in a new pane",
      "options": [
        {
          "name": "--direction",
          "description": "Where to open the pane",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--floating",
          "description": "Open as a floating pane",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--close-on-exit",
          "description": "Close the pane when the command exits",
          "type": "boolean",
          "takesValue": false,
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "args": [
        {
          "name": "command",
          "description": "Command to run in a new pane",
          "required": true,
          "type": "string"
        }
      ],
      "examples": [
        "zellij run command"
      ]
    },
    {
      "name": "edit",
      "description": "Open a file in a new pane",
      "options": [
        {
          "name": "--line-number",
          "description": "Open at this line",
          "type": "integer",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--floating",
          "description": "Open as a floating pane",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "File to open",
          "type": "file",
          "required": true
        }
      ],
      "examples": [
        "zellij edit file.txt"
      ]
    },
    {
      "name": "setup",
      "description": "Print setup information and shell completions",
      "options": [
        {
          "name": "--dump-config",
          "description": "Print the default configuration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--generate-completion",
          "description": "Print completions for a shell",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "zellij setup"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--session",
      "description": "Session name to use",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--layout",
      "description": "Layout to start with",
      "type": "string",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--config",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--config-dir",
      "description": "Configuration directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "zellij",
      "description": "Start a new session"
    },
    {
      "command": "zellij attach -c work",
      "description": "Attach to \"work\", creating it if needed"
    },
    {
      "command": "zellij list-sessions",
      "description": "List running sessions"
    },
    {
      "command": "zellij run -f -- htop",
      "description": "Run a command in a floating pane"
    }
  ],
  "relatedCommands": [
    "tmux",
    "screen",
    "byobu"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Zellij version",
        "command": "zellij --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "zellij"
      },
      {
        "name": "sessions",
        "description": "Zellij sessions running",
        "command": "zellij list-sessions 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "zellij"
      },
      {
        "name": "layouts",
        "description": "Zellij layouts available",
        "command": "ls ~/.config/zellij/layouts 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "inside_session",
        "description": "Whether this shell is inside Zellij",
        "command": "echo \"${ZELLIJ:-no}\"",
        "parser": "text",
        "cacheFor": 30
      }
    ]
  }
}
