{
  "name": "ld",
  "description": "GNU linker — combine object files into an executable or library",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--output",
      "description": "Write the result to this file",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--library",
      "description": "Link against this library",
      "type": "string",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--library-path",
      "description": "Add a directory to the library search path",
      "type": "directory",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--shared",
      "description": "Produce a shared library",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--static",
      "description": "Link statically",
      "type": "boolean",
      "takesValue": false,
      "short": "-static",
      "shorthand": "-static"
    },
    {
      "name": "--strip-all",
      "description": "Discard all symbols",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--entry",
      "description": "Symbol to use as the entry point",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--Map",
      "description": "Write a link map to this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--gc-sections",
      "description": "Discard unused sections",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--as-needed",
      "description": "Only record needed dependencies",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--rpath",
      "description": "Runtime library search path",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--verbose",
      "description": "Print detailed link information",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "ld -o prog main.o utils.o -lc",
      "description": "Link two objects against libc"
    },
    {
      "command": "ld -shared -o libx.so x.o",
      "description": "Produce a shared library"
    },
    {
      "command": "ld -o prog main.o -L./lib -lmine",
      "description": "Link against a local library"
    },
    {
      "command": "ld --Map=link.map -o prog main.o",
      "description": "Write a link map"
    }
  ],
  "relatedCommands": [
    "gcc",
    "ar",
    "nm",
    "objdump",
    "strip"
  ]
}
