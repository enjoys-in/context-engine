{
  "name": "infisical",
  "description": "Infisical CLI — open-source secret management",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Login to Infisical",
      "examples": [
        "infisical login",
        "infisical login --domain https://app.infisical.com"
      ],
      "options": [
        {
          "name": "--method",
          "description": "Authentication method to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--domain",
          "description": "Self-hosted Infisical domain",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--plain",
          "description": "Print the token without decoration",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize project link",
      "examples": [
        "infisical init"
      ],
      "options": []
    },
    {
      "name": "run",
      "description": "Inject secrets and run command",
      "examples": [
        "infisical run -- npm run dev",
        "infisical run --env=prod -- node server.js",
        "infisical run --path=/backend -- ./start.sh"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment slug to pull secrets from",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--path",
          "description": "Secret path to read from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--command",
          "description": "Shell command to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--secret-overriding",
          "description": "Allow personal overrides to win",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "secrets",
      "description": "Manage secrets",
      "examples": [
        "infisical secrets",
        "infisical secrets --env=prod",
        "infisical secrets set MY_SECRET=value",
        "infisical secrets get MY_SECRET",
        "infisical secrets delete MY_SECRET",
        "infisical secrets generate-example-env"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment slug to read",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--path",
          "description": "Secret path to read from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--plain",
          "description": "Print values only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "export",
      "description": "Export secrets",
      "examples": [
        "infisical export",
        "infisical export --env=prod --format=json",
        "infisical export --format=dotenv > .env"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment slug to export",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--format",
          "description": "Output format: dotenv, json, csv or yaml",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--path",
          "description": "Secret path to export",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "vault",
      "description": "Manage local credential vault",
      "examples": [
        "infisical vault set-backend file",
        "infisical vault set-backend auto"
      ],
      "options": []
    },
    {
      "name": "user",
      "description": "User info",
      "examples": [
        "infisical user"
      ],
      "options": []
    },
    {
      "name": "reset",
      "description": "Reset local state",
      "examples": [
        "infisical reset"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--env",
      "description": "Environment (dev, staging, prod, etc.)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--path",
      "description": "Secret path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--domain",
      "description": "Infisical instance domain",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--token",
      "description": "Service token",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--projectId",
      "description": "Project ID",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "infisical login",
    "infisical init",
    "infisical run -- npm run dev",
    "infisical secrets",
    "infisical secrets set DB_URL=postgres://...",
    "infisical export --format=dotenv > .env",
    "infisical run --env=prod -- node server.js"
  ],
  "relatedCommands": [
    "doppler",
    "vault",
    "chamber",
    "sops"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Infisical CLI version",
        "command": "infisical --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "infisical"
      },
      {
        "name": "project",
        "description": "Infisical project configuration",
        "command": "cat .infisical.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "user",
        "description": "Authenticated Infisical identity",
        "command": "infisical user get 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "infisical"
      }
    ]
  }
}
