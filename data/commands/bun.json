{
  "name": "bun",
  "description": "Bun — all-in-one JavaScript runtime, bundler, transpiler, and package manager",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Execute a JavaScript/TypeScript file or package.json script",
      "args": [
        {
          "name": "<script>",
          "type": "string",
          "required": true,
          "description": "Script file or package.json script name"
        }
      ],
      "options": [
        {
          "name": "--watch",
          "description": "Watch mode — restart on file changes"
        },
        {
          "name": "--hot",
          "description": "Hot reload mode"
        },
        {
          "name": "--smol",
          "description": "Use less memory at the cost of performance"
        },
        {
          "name": "--bun",
          "description": "Force usage of Bun's runtime"
        },
        {
          "name": "--env-file",
          "description": "Load environment variables from file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Set default port for Bun.serve()",
          "type": "number",
          "takesValue": true
        },
        {
          "name": "--inspect",
          "description": "Enable inspector on host:port",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "bun run index.ts",
        "bun run dev",
        "bun run build",
        "bun run --watch server.ts",
        "bun run --hot src/index.ts"
      ]
    },
    {
      "name": "install",
      "description": "Install dependencies from package.json",
      "options": [
        {
          "name": "--production",
          "description": "Skip devDependencies"
        },
        {
          "name": "--frozen-lockfile",
          "description": "Error if lockfile is out of date"
        },
        {
          "name": "--no-save",
          "description": "Don't update package.json"
        },
        {
          "name": "--dry-run",
          "description": "Show what would be installed"
        },
        {
          "name": "--force",
          "description": "Always request latest versions"
        },
        {
          "name": "--global",
          "short": "-g",
          "description": "Install globally",
          "shorthand": "-g"
        },
        {
          "name": "--backend",
          "description": "Package resolution backend",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--trust",
          "description": "Trust lifecycle scripts from specific packages"
        }
      ],
      "examples": [
        "bun install",
        "bun install --frozen-lockfile",
        "bun install --production"
      ],
      "args": [
        {
          "name": "package",
          "description": "Packages to install",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "installed_deps"
          }
        }
      ]
    },
    {
      "name": "add",
      "description": "Add a package to dependencies",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": true,
          "description": "Package name(s) to add",
          "completion": {
            "detector": "installed_deps"
          }
        }
      ],
      "options": [
        {
          "name": "--dev",
          "short": "-d",
          "description": "Add as devDependency",
          "shorthand": "-d"
        },
        {
          "name": "--optional",
          "description": "Add as optionalDependency"
        },
        {
          "name": "--exact",
          "short": "-E",
          "description": "Pin exact version",
          "shorthand": "-E"
        },
        {
          "name": "--global",
          "short": "-g",
          "description": "Install globally",
          "shorthand": "-g"
        },
        {
          "name": "--trust",
          "description": "Trust lifecycle scripts"
        }
      ],
      "examples": [
        "bun add express",
        "bun add -d typescript",
        "bun add react react-dom",
        "bun add -g serve"
      ]
    },
    {
      "name": "remove",
      "description": "Remove a package from dependencies",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": true,
          "description": "Package name to remove",
          "completion": {
            "detector": "installed_deps"
          }
        }
      ],
      "examples": [
        "bun remove express",
        "bun remove -g serve"
      ],
      "options": [
        {
          "name": "--global",
          "description": "Remove from the global install",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        },
        {
          "name": "--dev",
          "description": "Remove from devDependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update packages to latest versions",
      "args": [
        {
          "name": "<package>",
          "type": "package",
          "required": false,
          "description": "Specific package to update",
          "completion": {
            "detector": "installed_deps"
          }
        }
      ],
      "options": [
        {
          "name": "--latest",
          "description": "Update beyond semver range"
        }
      ],
      "examples": [
        "bun update",
        "bun update react",
        "bun update --latest"
      ]
    },
    {
      "name": "create",
      "description": "Create a new project from a template",
      "args": [
        {
          "name": "<template>",
          "type": "string",
          "required": true,
          "description": "Template to use"
        }
      ],
      "examples": [
        "bun create react-app my-app",
        "bun create elysia my-api",
        "bun create hono my-api",
        "bun create vite my-app"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Overwrite an existing directory",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--no-install",
          "description": "Scaffold without installing dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--open",
          "description": "Open the project when done",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize a new package.json",
      "options": [
        {
          "name": "--yes",
          "short": "-y",
          "description": "Accept all defaults",
          "shorthand": "-y"
        }
      ],
      "examples": [
        "bun init",
        "bun init -y"
      ]
    },
    {
      "name": "test",
      "description": "Run tests using Bun's built-in test runner",
      "args": [
        {
          "name": "<pattern>",
          "type": "string",
          "required": false,
          "description": "Test file pattern"
        }
      ],
      "options": [
        {
          "name": "--watch",
          "description": "Run in watch mode"
        },
        {
          "name": "--bail",
          "description": "Stop after first failure",
          "type": "number",
          "takesValue": true
        },
        {
          "name": "--timeout",
          "description": "Test timeout (ms)",
          "type": "number",
          "takesValue": true
        },
        {
          "name": "--rerun-each",
          "description": "Run each test N times",
          "type": "number",
          "takesValue": true
        },
        {
          "name": "--coverage",
          "description": "Enable code coverage"
        },
        {
          "name": "--preload",
          "description": "Preload modules before tests",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "bun test",
        "bun test --watch",
        "bun test src/utils.test.ts",
        "bun test --coverage"
      ]
    },
    {
      "name": "build",
      "description": "Bundle TypeScript/JavaScript using Bun's bundler",
      "args": [
        {
          "name": "<entrypoint>",
          "type": "file",
          "required": true,
          "description": "Entry point file(s)"
        }
      ],
      "options": [
        {
          "name": "--outdir",
          "description": "Output directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--outfile",
          "description": "Output file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--target",
          "description": "Target environment (browser, bun, node)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--minify",
          "description": "Minify output"
        },
        {
          "name": "--sourcemap",
          "description": "Generate source maps (none, linked, inline, external)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--splitting",
          "description": "Enable code splitting"
        },
        {
          "name": "--format",
          "description": "Module format (esm, cjs, iife)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--external",
          "description": "Mark packages as external",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--compile",
          "description": "Create a standalone executable"
        }
      ],
      "examples": [
        "bun build src/index.ts --outdir ./dist",
        "bun build src/index.ts --target bun --minify",
        "bun build src/index.ts --compile --outfile myapp"
      ]
    },
    {
      "name": "x",
      "description": "Execute a package binary (like npx)",
      "args": [
        {
          "name": "<command>",
          "type": "string",
          "required": true,
          "description": "Package/command to run"
        }
      ],
      "examples": [
        "bunx tsc --init",
        "bunx create-react-app my-app",
        "bunx prisma migrate dev",
        "bunx eslint ."
      ],
      "options": [
        {
          "name": "--bun",
          "description": "Force the Bun runtime rather than Node",
          "type": "boolean",
          "takesValue": false,
          "short": "-b",
          "shorthand": "-b"
        }
      ]
    },
    {
      "name": "link",
      "description": "Register or link a local package",
      "examples": [
        "bun link",
        "bun link my-package"
      ],
      "options": [
        {
          "name": "--save",
          "description": "Record the link in package.json",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to link",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "installed_deps"
          }
        }
      ]
    },
    {
      "name": "pm",
      "description": "Package manager utilities",
      "examples": [
        "bun pm ls",
        "bun pm cache",
        "bun pm cache rm",
        "bun pm hash",
        "bun pm hash-string",
        "bun pm bin",
        "bun pm bin -g"
      ],
      "options": [
        {
          "name": "--global",
          "description": "Act on the global install",
          "type": "boolean",
          "takesValue": false,
          "short": "-g",
          "shorthand": "-g"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade Bun to the latest version",
      "examples": [
        "bun upgrade",
        "bun upgrade --canary"
      ],
      "options": [
        {
          "name": "--canary",
          "description": "Upgrade to the canary build",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--stable",
          "description": "Upgrade to the latest stable build",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "repl",
      "description": "Start the Bun REPL",
      "examples": [
        "bun repl"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--version",
      "description": "Show Bun version"
    },
    {
      "name": "--help",
      "short": "-h",
      "description": "Show help",
      "shorthand": "-h"
    },
    {
      "name": "--cwd",
      "description": "Set working directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--config",
      "short": "-c",
      "description": "Config file path",
      "type": "file",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--env-file",
      "description": "Environment file path",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    "bun run dev",
    "bun install",
    "bun add express",
    "bun test",
    "bun build src/index.ts --outdir dist",
    "bun --version"
  ],
  "relatedCommands": [
    "node",
    "npm",
    "yarn",
    "pnpm",
    "deno"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "bun_version",
        "description": "Installed Bun version",
        "command": "bun --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "bun"
      },
      {
        "name": "package_json_scripts",
        "description": "Scripts defined in package.json",
        "command": "cat package.json 2>/dev/null | grep -A100 '\"scripts\"' | grep -B0 -E '\"[^\"]+\"\\s*:' | head -30",
        "parser": "lines",
        "cacheFor": 10,
        "requiresCmd": "bun"
      },
      {
        "name": "installed_deps",
        "description": "Installed dependencies (from bun.lockb)",
        "command": "bun pm ls 2>/dev/null | head -50",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "bun"
      },
      {
        "name": "lockfile_exists",
        "description": "Check for bun.lockb lockfile",
        "command": "test -f bun.lockb && echo 'bun.lockb' || test -f bun.lock && echo 'bun.lock' || echo 'none'",
        "parser": "text",
        "cacheFor": 10,
        "requiresCmd": "bun"
      },
      {
        "name": "package_name",
        "description": "Package name from package.json",
        "command": "cat package.json 2>/dev/null | grep '\"name\"' | head -1 | sed 's/.*\"name\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/'",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "bun"
      },
      {
        "name": "workspaces",
        "description": "Workspace definitions from package.json",
        "command": "cat package.json 2>/dev/null | grep -A10 '\"workspaces\"' | head -12",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "bun"
      },
      {
        "name": "bunfig_toml",
        "description": "Check for bunfig.toml configuration",
        "command": "test -f bunfig.toml && cat bunfig.toml 2>/dev/null | head -20 || echo 'none'",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "bun"
      },
      {
        "name": "global_packages",
        "description": "Globally installed Bun packages",
        "command": "bun pm bin -g 2>/dev/null && ls $(bun pm bin -g 2>/dev/null) 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "bun"
      },
      {
        "name": "test_files",
        "description": "Test files in the project",
        "command": "find . -name '*.test.ts' -o -name '*.test.js' -o -name '*.spec.ts' -o -name '*.spec.js' 2>/dev/null | head -20 | grep -v node_modules",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "bun"
      }
    ]
  }
}
