{
  "name": "nm",
  "description": "List the symbols in object files and libraries",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--demangle",
      "description": "Decode C++ symbol names",
      "type": "boolean",
      "takesValue": false,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--dynamic",
      "description": "List dynamic symbols",
      "type": "boolean",
      "takesValue": false,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--defined-only",
      "description": "Show only defined symbols",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--undefined-only",
      "description": "Show only undefined symbols",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--extern-only",
      "description": "Show only external symbols",
      "type": "boolean",
      "takesValue": false,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--numeric-sort",
      "description": "Sort by address",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--size-sort",
      "description": "Sort by symbol size",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--print-size",
      "description": "Print the symbol size",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--format",
      "description": "Output format (bsd, sysv, posix)",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    }
  ],
  "examples": [
    {
      "command": "nm -C libmine.a",
      "description": "List symbols with C++ names demangled"
    },
    {
      "command": "nm -u prog",
      "description": "Find unresolved symbols"
    },
    {
      "command": "nm -C --defined-only libx.so | grep Foo",
      "description": "Search for a defined symbol"
    },
    {
      "command": "nm --size-sort -S prog",
      "description": "Sort symbols by size"
    }
  ],
  "relatedCommands": [
    "objdump",
    "ar",
    "ld",
    "strip"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "GNU nm version",
        "command": "nm --version 2>/dev/null | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "nm"
      },
      {
        "name": "objects",
        "description": "Object files and libraries in this project",
        "command": "find . -maxdepth 3 -name '*.o' -o -name '*.a' -o -name '*.so' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "executables",
        "description": "Executables whose symbols nm can list",
        "command": "find . -maxdepth 2 -type f -perm -u+x 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
