{
  "name": "lein",
  "description": "Leiningen — build automation and dependency management for Clojure",
  "category": "build",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "new",
      "description": "Create a project from a template",
      "args": [
        {
          "name": "template",
          "description": "Template name",
          "type": "string",
          "required": false
        },
        {
          "name": "name",
          "description": "Project name",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--force",
          "description": "Overwrite an existing directory",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--to-dir",
          "description": "Directory to generate into",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "run",
      "description": "Run the project main function",
      "options": [
        {
          "name": "--",
          "description": "Pass the remaining arguments to the main function",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "repl",
      "description": "Start a REPL",
      "options": [
        {
          "name": "--headless",
          "description": "Run without a client",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--port",
          "description": "Port to listen on",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "test",
      "description": "Run the test suite",
      "args": [
        {
          "name": "namespace",
          "description": "Namespace to test",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--only",
          "description": "Only run this namespace or var",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--select",
          "description": "Only run tests with this selector",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "uberjar",
      "description": "Build a standalone jar including dependencies",
      "options": [
        {
          "name": "--trace",
          "description": "Show the full stack trace on failure",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "jar",
      "description": "Build a jar of the project classes",
      "options": [
        {
          "name": "--trace",
          "description": "Show the full stack trace on failure",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "install",
      "description": "Install the artifact into the local repository",
      "options": []
    },
    {
      "name": "deploy",
      "description": "Deploy the artifact to a remote repository",
      "args": [
        {
          "name": "repository",
          "description": "Repository name",
          "type": "string",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--sign-releases",
          "description": "Sign the artifacts before deploying",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "deps",
      "description": "Download the project dependencies",
      "options": [
        {
          "name": "--tree",
          "description": "Print the dependency tree",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "clean",
      "description": "Remove the build outputs",
      "options": []
    },
    {
      "name": "check",
      "description": "Compile every namespace to surface warnings",
      "options": []
    },
    {
      "name": "update-in",
      "description": "Modify the project map before running a task",
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--offline",
      "description": "Work without network access",
      "type": "boolean",
      "takesValue": false,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--user",
      "description": "Run with the user profile",
      "type": "boolean",
      "takesValue": false,
      "short": "-U",
      "shorthand": "-U"
    }
  ],
  "examples": [
    {
      "command": "lein new app my-app",
      "description": "Scaffold an application"
    },
    {
      "command": "lein run",
      "description": "Run the project"
    },
    {
      "command": "lein test",
      "description": "Run the tests"
    },
    {
      "command": "lein uberjar",
      "description": "Build a standalone jar"
    }
  ],
  "relatedCommands": [
    "clj",
    "clojure",
    "deps.edn",
    "mvn"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Leiningen and Clojure versions",
        "command": "lein --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "lein"
      },
      {
        "name": "project",
        "description": "Leiningen project definition",
        "command": "cat project.clj 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "profiles",
        "description": "Leiningen user profiles",
        "command": "cat ~/.lein/profiles.clj 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "java",
        "description": "JVM Leiningen will run on",
        "command": "java -version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
