{
  "name": "flake8",
  "description": "Python style guide enforcement — pyflakes, pycodestyle and mccabe",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--max-line-length",
      "description": "Maximum line length",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--select",
      "description": "Error codes to enable",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ignore",
      "description": "Error codes to disable",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--extend-ignore",
      "description": "Add codes to the default ignore list",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Comma-separated patterns to skip",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--max-complexity",
      "description": "Maximum McCabe complexity to allow",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--statistics",
      "description": "Count each error type",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--count",
      "description": "Print the total number of errors",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--format",
      "description": "Report format",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Path to the configuration file",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "flake8 src/",
      "description": "Lint a package"
    },
    {
      "command": "flake8 --max-line-length 100 .",
      "description": "Lint with a wider line limit"
    },
    {
      "command": "flake8 --statistics .",
      "description": "Show a per-rule summary"
    }
  ],
  "relatedCommands": [
    "ruff",
    "pylint",
    "black",
    "pycodestyle"
  ]
}
