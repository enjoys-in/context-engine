{
  "language": "mysql",
  "name": "mysql",
  "description": "MySQL/MariaDB command-line client",
  "category": "database",
  "contextEngine": {
    "detectors": [
      {
        "name": "databases",
        "description": "Available databases",
        "command": "mysql -e 'SHOW DATABASES' -B --skip-column-names 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "mysql"
      },
      {
        "name": "tables",
        "description": "Tables in current database",
        "command": "mysql -e 'SHOW TABLES' -B --skip-column-names 2>/dev/null",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "mysql"
      },
      {
        "name": "status",
        "description": "MySQL server status",
        "command": "mysqladmin status 2>/dev/null",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "mysqladmin"
      },
      {
        "name": "my_cnf",
        "description": "MySQL config",
        "command": "cat ~/.my.cnf 2>/dev/null | grep -v password | head -10",
        "parser": "text",
        "cacheFor": 120
      }
    ]
  },
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "globalOptions": [
    {
      "name": "--host",
      "shorthand": "-h",
      "description": "Server hostname",
      "takesValue": true,
      "short": "-h"
    },
    {
      "name": "--port",
      "shorthand": "-P",
      "description": "Server port",
      "takesValue": true,
      "short": "-P"
    },
    {
      "name": "--user",
      "shorthand": "-u",
      "description": "Username",
      "takesValue": true,
      "short": "-u"
    },
    {
      "name": "--password",
      "shorthand": "-p",
      "description": "Password (prompted if omitted)",
      "takesValue": true,
      "short": "-p"
    },
    {
      "name": "--database",
      "shorthand": "-D",
      "description": "Database to use",
      "takesValue": true,
      "short": "-D"
    },
    {
      "name": "--execute",
      "shorthand": "-e",
      "description": "Execute SQL and exit",
      "takesValue": true,
      "short": "-e"
    },
    {
      "name": "--batch",
      "shorthand": "-B",
      "description": "Batch mode (tab-separated output)",
      "short": "-B"
    },
    {
      "name": "--table",
      "shorthand": "-t",
      "description": "Table output format",
      "short": "-t"
    },
    {
      "name": "--html",
      "shorthand": "-H",
      "description": "HTML output format",
      "short": "-H"
    },
    {
      "name": "--xml",
      "shorthand": "-X",
      "description": "XML output format",
      "short": "-X"
    },
    {
      "name": "--vertical",
      "shorthand": "-E",
      "description": "Vertical output",
      "short": "-E"
    },
    {
      "name": "--raw",
      "shorthand": "-r",
      "description": "Disable character escaping",
      "short": "-r"
    },
    {
      "name": "--silent",
      "shorthand": "-s",
      "description": "Silent mode",
      "short": "-s"
    },
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose mode",
      "short": "-v"
    },
    {
      "name": "--socket",
      "shorthand": "-S",
      "description": "Socket file path",
      "takesValue": true,
      "short": "-S"
    },
    {
      "name": "--ssl-mode",
      "description": "SSL mode (DISABLED, PREFERRED, REQUIRED, VERIFY_CA, VERIFY_IDENTITY)",
      "takesValue": true
    },
    {
      "name": "--default-character-set",
      "description": "Character set",
      "takesValue": true
    },
    {
      "name": "--auto-rehash",
      "description": "Enable auto-completion"
    },
    {
      "name": "--no-auto-rehash",
      "shorthand": "-A",
      "description": "Disable auto-completion (faster startup)",
      "short": "-A"
    },
    {
      "name": "--quick",
      "shorthand": "-q",
      "description": "Don't cache results",
      "short": "-q"
    },
    {
      "name": "--safe-updates",
      "shorthand": "-U",
      "description": "Prevent UPDATE/DELETE without WHERE",
      "short": "-U"
    },
    {
      "name": "--compress",
      "shorthand": "-C",
      "description": "Compress client-server protocol",
      "short": "-C"
    },
    {
      "name": "--force",
      "shorthand": "-f",
      "description": "Continue on errors",
      "short": "-f"
    },
    {
      "name": "--line-numbers",
      "description": "Show line numbers on errors"
    },
    {
      "name": "--tee",
      "description": "Log output to file",
      "takesValue": true
    },
    {
      "name": "--pager",
      "description": "Set pager command",
      "takesValue": true
    }
  ],
  "subcommands": [],
  "examples": [
    {
      "command": "mysql -u root -p",
      "description": "Connect as root"
    },
    {
      "command": "mysql -h localhost -u admin -p mydb",
      "description": "Connect to specific database"
    },
    {
      "command": "mysql -e 'SHOW DATABASES'",
      "description": "Execute query"
    },
    {
      "command": "mysql mydb < backup.sql",
      "description": "Import SQL file"
    },
    {
      "command": "mysql -B -e 'SELECT * FROM users' mydb",
      "description": "Batch mode query"
    },
    {
      "command": "mysql --safe-updates -u root -p mydb",
      "description": "Safe mode connection"
    },
    {
      "command": "mysql -h db.example.com -P 3306 -u admin -p --ssl-mode REQUIRED",
      "description": "SSL connection"
    }
  ],
  "relatedCommands": [
    "psql",
    "mongosh",
    "sqlite3"
  ]
}
