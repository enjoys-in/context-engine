{
  "name": "bq",
  "description": "BigQuery command-line tool",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "query",
      "description": "Execute a SQL query",
      "examples": [
        "bq query 'SELECT * FROM dataset.table LIMIT 10'",
        "bq query --use_legacy_sql=false 'SELECT count(*) FROM `project.dataset.table`'",
        "bq query --format=json 'SELECT * FROM dataset.table'",
        "bq query --destination_table=project:dataset.results 'SELECT * FROM dataset.table'",
        "bq query --dry_run 'SELECT * FROM dataset.table'"
      ],
      "options": [
        {
          "name": "--destination_table",
          "description": "Table to write results into",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--replace",
          "description": "Overwrite the destination table",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--append_table",
          "description": "Append to the destination table",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--maximum_bytes_billed",
          "description": "Fail if the query would scan more than this",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--label",
          "description": "Label to attach, key:value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--batch",
          "description": "Run in batch priority",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "query",
          "description": "SQL query to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "ls",
      "description": "List datasets or tables",
      "examples": [
        "bq ls",
        "bq ls dataset",
        "bq ls --all dataset",
        "bq ls --format=json"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Include hidden datasets",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--datasets",
          "description": "List datasets rather than tables",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--jobs",
          "description": "List jobs",
          "type": "boolean",
          "takesValue": false,
          "short": "-j",
          "shorthand": "-j"
        },
        {
          "name": "--max_results",
          "description": "Maximum results",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "show",
      "description": "Show resource details",
      "examples": [
        "bq show dataset",
        "bq show dataset.table",
        "bq show --schema dataset.table",
        "bq show --format=json dataset.table"
      ],
      "options": [
        {
          "name": "--schema",
          "description": "Print only the schema",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--view",
          "description": "Show the view definition",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "resource",
          "description": "Dataset, table or view to describe",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "mk",
      "description": "Create resources",
      "examples": [
        "bq mk dataset",
        "bq mk --table dataset.table schema.json",
        "bq mk --view 'SELECT * FROM dataset.source' dataset.my_view",
        "bq mk --external_table_definition=schema@CSV=gs://bucket/file.csv dataset.ext_table"
      ],
      "options": [
        {
          "name": "--dataset",
          "description": "Create a dataset",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--table",
          "description": "Create a table",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--schema",
          "description": "Schema definition or file",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--expiration",
          "description": "Expiry in seconds",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--description",
          "description": "Description text",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Do nothing if it already exists",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "rm",
      "description": "Remove resources",
      "examples": [
        "bq rm dataset.table",
        "bq rm -f dataset.table",
        "bq rm -r dataset",
        "bq rm --table dataset.table"
      ],
      "options": [
        {
          "name": "--dataset",
          "description": "Remove a dataset",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--table",
          "description": "Remove a table",
          "type": "boolean",
          "takesValue": false,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--recursive",
          "description": "Also remove contained tables",
          "type": "boolean",
          "takesValue": false,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--force",
          "description": "Do not prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "resource",
          "description": "Dataset or table to remove",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "load",
      "description": "Load data into a table",
      "examples": [
        "bq load dataset.table gs://bucket/data.csv schema.json",
        "bq load --source_format=NEWLINE_DELIMITED_JSON dataset.table gs://bucket/data.jsonl",
        "bq load --autodetect dataset.table gs://bucket/data.csv",
        "bq load --replace dataset.table gs://bucket/data.csv"
      ],
      "options": [
        {
          "name": "--source_format",
          "description": "Input format (CSV, NEWLINE_DELIMITED_JSON, PARQUET, AVRO)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--autodetect",
          "description": "Infer the schema automatically",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip_leading_rows",
          "description": "Header rows to skip",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--replace",
          "description": "Overwrite the table",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--max_bad_records",
          "description": "Bad records to tolerate",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--field_delimiter",
          "description": "Column delimiter",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "destination",
          "description": "Destination table",
          "required": true,
          "type": "string"
        },
        {
          "name": "source",
          "description": "Source data files or URIs",
          "required": true,
          "type": "path"
        }
      ]
    },
    {
      "name": "extract",
      "description": "Export table to GCS",
      "examples": [
        "bq extract dataset.table gs://bucket/export.csv",
        "bq extract --destination_format=NEWLINE_DELIMITED_JSON dataset.table gs://bucket/export.jsonl"
      ],
      "options": [
        {
          "name": "--destination_format",
          "description": "Output format (CSV, JSON, AVRO, PARQUET)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--compression",
          "description": "Compression to apply (GZIP, SNAPPY)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--field_delimiter",
          "description": "Column delimiter",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--print_header",
          "description": "Include a header row",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "cp",
      "description": "Copy tables",
      "examples": [
        "bq cp dataset.source dataset.dest",
        "bq cp project1:dataset.table project2:dataset.table"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Overwrite the destination table",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--append_table",
          "description": "Append rather than replace",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--destination_kms_key",
          "description": "KMS key to encrypt the destination with",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source table",
          "required": true,
          "type": "string"
        },
        {
          "name": "destination",
          "description": "Destination table",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "head",
      "description": "Preview table rows",
      "examples": [
        "bq head dataset.table",
        "bq head -n 20 dataset.table"
      ],
      "options": [
        {
          "name": "--start_row",
          "description": "Row to start from",
          "type": "integer",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--max_rows",
          "description": "Rows to print",
          "type": "integer",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--selected_fields",
          "description": "Columns to print",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update resource properties",
      "examples": [
        "bq update --description 'My table' dataset.table",
        "bq update --expiration 3600 dataset.table"
      ],
      "options": [
        {
          "name": "--description",
          "description": "Description to set",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--expiration",
          "description": "Expiration in seconds",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--schema",
          "description": "Schema to apply",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--set_label",
          "description": "Label to set as key:value",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "partition",
      "description": "List partitions",
      "examples": [
        "bq ls --format=json dataset.table$"
      ],
      "options": [
        {
          "name": "--time_partitioning_type",
          "description": "Partition granularity",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--time_partitioning_expiration",
          "description": "Partition expiry in seconds",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "wait",
      "description": "Wait for a job to complete",
      "examples": [
        "bq wait job_id"
      ],
      "options": [
        {
          "name": "--fail_on_error",
          "description": "Exit non-zero if the job failed",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--project_id",
      "description": "GCP project ID",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--format",
      "description": "Output format (json, csv, prettyjson, sparse)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--location",
      "description": "Processing location",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--max_rows",
      "description": "Maximum rows to display",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--use_legacy_sql",
      "description": "Use legacy SQL (true/false)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--nouse_legacy_sql",
      "description": "Use standard SQL"
    },
    {
      "name": "--api",
      "description": "API endpoint URL",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--dry_run",
      "description": "Estimate the query without running it",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--apilog",
      "description": "Write the API log here",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    "bq query 'SELECT * FROM dataset.table LIMIT 10'",
    "bq ls",
    "bq show dataset.table",
    "bq load --autodetect dataset.table gs://bucket/data.csv",
    "bq extract dataset.table gs://bucket/export.csv",
    "bq mk dataset",
    "bq rm -f dataset.table",
    "bq head -n 5 dataset.table"
  ],
  "relatedCommands": [
    "gcloud",
    "gsutil",
    "psql",
    "mysql"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "bq version",
        "command": "bq version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "bq"
      },
      {
        "name": "project",
        "description": "Active gcloud project for BigQuery",
        "command": "gcloud config get-value project 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "gcloud"
      },
      {
        "name": "datasets",
        "description": "BigQuery datasets in the active project",
        "command": "bq ls 2>/dev/null | head -30",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "bq"
      }
    ]
  }
}
