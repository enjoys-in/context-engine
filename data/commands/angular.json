{
  "language": "angular",
  "name": "angular",
  "description": "Angular CLI and development commands",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the Angular CLI version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dry-run",
      "description": "Report what would change without writing files",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--interactive",
      "description": "Prompt for missing options",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--defaults",
      "description": "Accept all defaults without prompting",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Print detailed output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "subcommands": [
    {
      "name": "ng new",
      "description": "Creates a new Angular workspace and initial application.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the new workspace and initial project"
        },
        {
          "name": "--standalone",
          "description": "Create an application based on standalone APIs (default: true)"
        },
        {
          "name": "--routing",
          "description": "Enable routing for the initial project"
        },
        {
          "name": "--style",
          "description": "Style preprocessor: css, scss, sass, less"
        },
        {
          "name": "--prefix",
          "description": "Prefix for component selectors (default: app)"
        },
        {
          "name": "--skip-git",
          "description": "Do not initialize a git repository"
        },
        {
          "name": "--skip-install",
          "description": "Do not install dependency packages"
        },
        {
          "name": "--skip-tests",
          "description": "Do not generate spec files"
        },
        {
          "name": "--ssr",
          "description": "Enable server-side rendering and static site generation"
        },
        {
          "name": "--strict",
          "description": "Enable stricter type checking and bundle budgets"
        },
        {
          "name": "--inline-style",
          "description": "Include styles inline in the component TS file"
        },
        {
          "name": "--inline-template",
          "description": "Include template inline in the component TS file"
        },
        {
          "name": "--package-manager",
          "description": "Package manager to use: npm, yarn, pnpm, cnpm"
        }
      ],
      "examples": [
        "ng new"
      ]
    },
    {
      "name": "ng generate component",
      "description": "Generates a new Angular component.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the component"
        },
        {
          "name": "--standalone",
          "description": "Create a standalone component (default: true)"
        },
        {
          "name": "--inline-template",
          "description": "Include template inline",
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--inline-style",
          "description": "Include styles inline",
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        },
        {
          "name": "--change-detection",
          "description": "Change detection strategy: Default or OnPush"
        },
        {
          "name": "--flat",
          "description": "Create at the top level of the project"
        },
        {
          "name": "--prefix",
          "description": "Selector prefix"
        },
        {
          "name": "--view-encapsulation",
          "description": "View encapsulation strategy: Emulated, None, ShadowDom"
        },
        {
          "name": "--style",
          "description": "Style file extension: css, scss, sass, less"
        }
      ],
      "examples": [
        "ng generate component"
      ]
    },
    {
      "name": "ng generate service",
      "description": "Generates a new Angular service.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the service"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        },
        {
          "name": "--flat",
          "description": "Create at the top level of the project"
        }
      ],
      "examples": [
        "ng generate service"
      ]
    },
    {
      "name": "ng generate module",
      "description": "Generates a new Angular NgModule.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the module"
        },
        {
          "name": "--routing",
          "description": "Create a routing module"
        },
        {
          "name": "--flat",
          "description": "Create at the top level of the project"
        },
        {
          "name": "--module",
          "description": "The declaring NgModule"
        }
      ],
      "examples": [
        "ng generate module"
      ]
    },
    {
      "name": "ng generate directive",
      "description": "Generates a new Angular directive.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the directive"
        },
        {
          "name": "--standalone",
          "description": "Create a standalone directive"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        },
        {
          "name": "--prefix",
          "description": "Selector prefix"
        }
      ],
      "examples": [
        "ng generate directive"
      ]
    },
    {
      "name": "ng generate pipe",
      "description": "Generates a new Angular pipe.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the pipe"
        },
        {
          "name": "--standalone",
          "description": "Create a standalone pipe"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        }
      ],
      "examples": [
        "ng generate pipe"
      ]
    },
    {
      "name": "ng generate guard",
      "description": "Generates a new Angular route guard.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the guard"
        },
        {
          "name": "--functional",
          "description": "Create a functional guard (default: true)"
        },
        {
          "name": "--implements",
          "description": "Guard interfaces: CanActivate, CanDeactivate, CanActivateChild, CanMatch"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        }
      ],
      "examples": [
        "ng generate guard"
      ]
    },
    {
      "name": "ng generate interceptor",
      "description": "Generates a new Angular HTTP interceptor.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the interceptor"
        },
        {
          "name": "--functional",
          "description": "Create a functional interceptor (default: true)"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        }
      ],
      "examples": [
        "ng generate interceptor"
      ]
    },
    {
      "name": "ng generate resolver",
      "description": "Generates a new Angular route resolver.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the resolver"
        },
        {
          "name": "--functional",
          "description": "Create a functional resolver (default: true)"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        }
      ],
      "examples": [
        "ng generate resolver"
      ]
    },
    {
      "name": "ng generate interface",
      "description": "Generates a new TypeScript interface.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the interface"
        },
        {
          "name": "<type>",
          "description": "Optional suffix (e.g., 'model')"
        }
      ],
      "examples": [
        "ng generate interface"
      ]
    },
    {
      "name": "ng generate enum",
      "description": "Generates a new TypeScript enum.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the enum"
        }
      ],
      "examples": [
        "ng generate enum"
      ]
    },
    {
      "name": "ng generate class",
      "description": "Generates a new TypeScript class.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the class"
        },
        {
          "name": "--skip-tests",
          "description": "Do not create spec file"
        }
      ],
      "examples": [
        "ng generate class"
      ]
    },
    {
      "name": "ng generate library",
      "description": "Generates a new library project in the workspace.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the library"
        },
        {
          "name": "--prefix",
          "description": "Prefix for component selectors"
        },
        {
          "name": "--skip-install",
          "description": "Do not install dependency packages"
        }
      ],
      "examples": [
        "ng generate library"
      ]
    },
    {
      "name": "ng generate application",
      "description": "Generates a new application project in the workspace.",
      "options": [
        {
          "name": "<name>",
          "description": "The name of the application"
        },
        {
          "name": "--routing",
          "description": "Enable routing"
        },
        {
          "name": "--style",
          "description": "Style preprocessor"
        },
        {
          "name": "--ssr",
          "description": "Enable server-side rendering"
        }
      ],
      "examples": [
        "ng generate application"
      ]
    },
    {
      "name": "ng serve",
      "description": "Builds and serves the application with live reload on file changes.",
      "options": [
        {
          "name": "--port",
          "description": "Port to listen on (default: 4200)"
        },
        {
          "name": "--host",
          "description": "Host to listen on (default: localhost)"
        },
        {
          "name": "--open",
          "description": "Open the URL in the default browser",
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--ssl",
          "description": "Serve using HTTPS"
        },
        {
          "name": "--proxy-config",
          "description": "Path to proxy configuration file"
        },
        {
          "name": "--configuration",
          "description": "Build configuration: production, development",
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--hmr",
          "description": "Enable hot module replacement"
        },
        {
          "name": "--watch",
          "description": "Rebuild on change (default: true)"
        },
        {
          "name": "--poll",
          "description": "Enable polling-based file watching"
        }
      ],
      "examples": [
        "ng serve"
      ]
    },
    {
      "name": "ng build",
      "description": "Compiles the application into an output directory.",
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration: production, development",
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--output-path",
          "description": "Output directory path"
        },
        {
          "name": "--base-href",
          "description": "Base URL for the application"
        },
        {
          "name": "--source-map",
          "description": "Generate source maps"
        },
        {
          "name": "--watch",
          "description": "Rebuild on file changes"
        },
        {
          "name": "--stats-json",
          "description": "Generate stats.json for bundle analysis"
        },
        {
          "name": "--aot",
          "description": "Build using Ahead of Time compilation (default: true)"
        },
        {
          "name": "--optimization",
          "description": "Enable build optimizations (default for production)"
        }
      ],
      "examples": [
        "ng build"
      ]
    },
    {
      "name": "ng test",
      "description": "Runs unit tests using Karma test runner.",
      "options": [
        {
          "name": "--watch",
          "description": "Rerun tests when files change"
        },
        {
          "name": "--code-coverage",
          "description": "Generate code coverage report"
        },
        {
          "name": "--browsers",
          "description": "Override browsers for test run"
        },
        {
          "name": "--karma-config",
          "description": "Path to Karma configuration file"
        },
        {
          "name": "--no-watch",
          "description": "Run tests once without watching"
        }
      ],
      "examples": [
        "ng test"
      ]
    },
    {
      "name": "ng e2e",
      "description": "Runs end-to-end tests. Requires an e2e package to be installed.",
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration to use",
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--port",
          "description": "Port for the development server"
        }
      ],
      "examples": [
        "ng e2e"
      ]
    },
    {
      "name": "ng lint",
      "description": "Runs linting tools on Angular application code.",
      "options": [
        {
          "name": "--fix",
          "description": "Apply lint fixes automatically"
        },
        {
          "name": "--format",
          "description": "Output format: prose, json, stylish"
        },
        {
          "name": "--force",
          "description": "Succeed even if lint errors exist"
        }
      ],
      "args": [
        {
          "name": "project",
          "description": "Project to lint",
          "required": false,
          "type": "project",
          "completion": {
            "detector": "projects"
          }
        }
      ],
      "examples": [
        "ng lint my-project"
      ]
    },
    {
      "name": "ng add",
      "description": "Adds support for an external library to the project.",
      "options": [
        {
          "name": "<collection>",
          "description": "The npm package to add (e.g., @angular/material)"
        },
        {
          "name": "--skip-confirmation",
          "description": "Skip asking install confirmation"
        },
        {
          "name": "--defaults",
          "description": "Disable interactive prompts and use defaults"
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to add and configure",
          "required": true,
          "type": "package"
        }
      ],
      "examples": [
        "ng add @angular/material"
      ]
    },
    {
      "name": "ng update",
      "description": "Updates the application and its dependencies.",
      "options": [
        {
          "name": "<packages>",
          "description": "Packages to update (e.g., @angular/core @angular/cli)"
        },
        {
          "name": "--force",
          "description": "Ignore peer dependency version mismatches"
        },
        {
          "name": "--next",
          "description": "Use the prerelease version"
        },
        {
          "name": "--migrate-only",
          "description": "Only perform migrations, not package updates"
        },
        {
          "name": "--allow-dirty",
          "description": "Allow updating when the repository has modified or untracked files"
        }
      ],
      "examples": [
        "ng update"
      ]
    },
    {
      "name": "ng deploy",
      "description": "Invokes the deploy builder for the project.",
      "options": [
        {
          "name": "--configuration",
          "description": "Build configuration to use",
          "short": "-c",
          "shorthand": "-c"
        }
      ],
      "examples": [
        "ng deploy"
      ]
    },
    {
      "name": "ng analytics",
      "description": "Configures the collection of Angular CLI usage metrics.",
      "options": [
        {
          "name": "enable",
          "description": "Enable analytics gathering"
        },
        {
          "name": "disable",
          "description": "Disable analytics gathering"
        },
        {
          "name": "info",
          "description": "Print analytics gathering info"
        },
        {
          "name": "prompt",
          "description": "Prompt for analytics gathering permission"
        }
      ],
      "examples": [
        "ng analytics"
      ]
    },
    {
      "name": "ng config",
      "description": "Retrieves or sets Angular CLI configuration values.",
      "options": [
        {
          "name": "<jsonPath>",
          "description": "Configuration key in JSON path format"
        },
        {
          "name": "<value>",
          "description": "New value for the given key"
        },
        {
          "name": "--global",
          "description": "Use global CLI configuration",
          "short": "-g",
          "shorthand": "-g"
        }
      ],
      "examples": [
        "ng config"
      ]
    },
    {
      "name": "ng doc",
      "description": "Opens the official Angular documentation in a browser.",
      "options": [
        {
          "name": "<keyword>",
          "description": "Keyword to search for in documentation"
        }
      ],
      "examples": [
        "ng doc"
      ]
    },
    {
      "name": "ng extract-i18n",
      "description": "Extracts i18n messages from source code.",
      "options": [
        {
          "name": "--output-path",
          "description": "Path where output will be placed"
        },
        {
          "name": "--format",
          "description": "Output format: xlf, xlf2, xmb, json, arb"
        },
        {
          "name": "--out-file",
          "description": "Name of the output file"
        }
      ],
      "examples": [
        "ng extract-i18n"
      ]
    },
    {
      "name": "ng run",
      "description": "Runs an Architect target with an optional custom builder configuration.",
      "options": [
        {
          "name": "<target>",
          "description": "Target in the format project:target[:configuration]"
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "Target to run as project:target",
          "required": true,
          "type": "string"
        }
      ],
      "examples": [
        "ng run target"
      ]
    },
    {
      "name": "ng cache",
      "description": "Configure and manage the Angular CLI disk cache.",
      "options": [
        {
          "name": "enable",
          "description": "Enable the CLI cache"
        },
        {
          "name": "disable",
          "description": "Disable the CLI cache"
        },
        {
          "name": "clean",
          "description": "Delete the persistent cache"
        },
        {
          "name": "info",
          "description": "Print cache statistics"
        }
      ],
      "examples": [
        "ng cache"
      ]
    },
    {
      "name": "npm run start",
      "description": "Starts the Angular development server (alias for ng serve).",
      "options": [
        {
          "name": "--if-present",
          "description": "Do nothing when the script is missing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--silent",
          "description": "Suppress npm's own output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npm run start"
      ]
    },
    {
      "name": "npm run build",
      "description": "Builds the Angular application for production.",
      "options": [
        {
          "name": "--if-present",
          "description": "Do nothing when the script is missing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--silent",
          "description": "Suppress npm's own output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npm run build"
      ]
    },
    {
      "name": "npm run test",
      "description": "Runs the unit test suite.",
      "options": [
        {
          "name": "--if-present",
          "description": "Do nothing when the script is missing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--silent",
          "description": "Suppress npm's own output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npm run test"
      ]
    },
    {
      "name": "npm run lint",
      "description": "Runs the linter on the project.",
      "options": [
        {
          "name": "--if-present",
          "description": "Do nothing when the script is missing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--silent",
          "description": "Suppress npm's own output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "npm run lint"
      ]
    },
    {
      "name": "npx ng",
      "description": "Runs the Angular CLI directly without global installation.",
      "options": [
        {
          "name": "<command>",
          "description": "Any Angular CLI command"
        }
      ],
      "examples": [
        "npx ng"
      ]
    }
  ],
  "examples": [
    {
      "command": "ng new my-app",
      "description": "Create a new Angular project"
    },
    {
      "command": "ng serve",
      "description": "Start development server"
    },
    {
      "command": "ng generate component my-comp",
      "description": "Generate a new component"
    },
    {
      "command": "ng build --configuration production",
      "description": "Build for production"
    },
    {
      "command": "ng test",
      "description": "Run unit tests"
    }
  ],
  "relatedCommands": [
    "ng",
    "npm",
    "npx",
    "vue",
    "react"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Angular CLI and framework versions",
        "command": "ng version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ng"
      },
      {
        "name": "workspace",
        "description": "Angular workspace configuration",
        "command": "cat angular.json 2>/dev/null | head -60",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "projects",
        "description": "Projects in this Angular workspace",
        "command": "grep -oE '\"[a-z0-9-]+\": *\\{ *$' angular.json 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
