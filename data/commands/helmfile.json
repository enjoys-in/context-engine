          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--detailed-exitcode",
          "description": "Exit 2 when there are changes",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--suppress-secrets",
          "description": "Hide secret values",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--context",
          "description": "Lines of context in the diff",
