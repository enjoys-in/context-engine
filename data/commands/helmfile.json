{
  "name": "helmfile",
  "description": "Deploy Kubernetes Helm charts declaratively",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "sync",
      "description": "Sync releases to cluster",
      "examples": [
        "helmfile sync",
        "helmfile -f helmfile.yaml sync",
        "helmfile -e production sync"
      ],
      "options": [
        {
          "name": "--environment",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--selector",
          "description": "Label selector for releases",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--concurrency",
          "description": "Releases to process in parallel",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--skip-deps",
          "description": "Do not update chart dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "apply",
      "description": "Apply changes (sync with diff)",
      "examples": [
        "helmfile apply",
        "helmfile -e staging apply"
      ],
      "options": [
        {
          "name": "--environment",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--selector",
          "description": "Label selector for releases",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--concurrency",
          "description": "Releases to process in parallel",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--skip-deps",
          "description": "Do not update chart dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--suppress-secrets",
          "description": "Hide secret values in the diff",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wait",
          "description": "Block until resources are ready",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--context",
          "description": "Lines of context in the diff",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
