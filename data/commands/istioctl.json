{
  "name": "istioctl",
  "description": "Istio CLI for installing and debugging the Istio service mesh",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install Istio",
      "examples": [
        "istioctl install",
        "istioctl install --set profile=demo",
        "istioctl install --set profile=minimal",
        "istioctl install -f custom-operator.yaml"
      ],
      "options": [
        {
          "name": "--set",
          "description": "Override a configuration value, key=value",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--filename",
          "description": "IstioOperator file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--skip-confirmation",
          "description": "Do not prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--revision",
          "description": "Control plane revision",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--dry-run",
          "description": "Print the manifest only",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "manifest",
      "description": "Generate or diff manifests",
      "examples": [
        "istioctl manifest generate",
        "istioctl manifest generate --set profile=demo > istio.yaml",
        "istioctl manifest diff a.yaml b.yaml"
      ],
      "options": [
        {
          "name": "--filename",
          "description": "IstioOperator file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--set",
          "description": "Override a configuration value",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--output",
          "description": "Directory to write manifests into",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "profile",
      "description": "Manage installation profiles",
      "examples": [
        "istioctl profile list",
        "istioctl profile dump demo",
        "istioctl profile diff demo default"
      ],
      "options": [
        {
          "name": "--config-path",
          "description": "Configuration path to show",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--filename",
          "description": "IstioOperator file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "verify-install",
      "description": "Verify installation",
      "examples": [
        "istioctl verify-install"
      ],
      "options": [
        {
          "name": "--filename",
          "description": "Manifest to verify against",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--revision",
          "description": "Revision to verify",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall Istio",
      "examples": [
        "istioctl uninstall --purge",
        "istioctl uninstall --revision canary"
      ],
      "options": [
        {
          "name": "--purge",
          "description": "Remove every Istio resource",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--revision",
          "description": "Revision to remove",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--skip-confirmation",
          "description": "Do not prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade Istio",
      "examples": [
        "istioctl upgrade"
      ],
      "options": [
        {
          "name": "--filename",
          "description": "IstioOperator file",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--skip-confirmation",
          "description": "Do not prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "analyze",
      "description": "Analyze mesh config for issues",
      "examples": [
        "istioctl analyze",
        "istioctl analyze -n my-ns",
        "istioctl analyze -A",
        "istioctl analyze my-manifest.yaml"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--all-namespaces",
          "description": "Analyse every namespace",
          "type": "boolean",
          "takesValue": false,
          "short": "-A",
          "shorthand": "-A"
        },
        {
          "name": "--use-kube",
          "description": "Also read live cluster state",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--failure-threshold",
          "description": "Severity that fails the run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "proxy-config",
      "description": "Inspect Envoy proxy config",
      "examples": [
        "istioctl proxy-config cluster my-pod",
        "istioctl proxy-config route my-pod",
        "istioctl proxy-config listener my-pod",
        "istioctl proxy-config endpoint my-pod",
        "istioctl proxy-config bootstrap my-pod",
        "istioctl proxy-config secret my-pod",
        "istioctl proxy-config log my-pod --level debug"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format (json, yaml, short)",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--fqdn",
          "description": "Filter by FQDN",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Filter by port",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "proxy-status",
      "description": "Show proxy sync status",
      "examples": [
        "istioctl proxy-status",
        "istioctl proxy-status my-pod"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--revision",
          "description": "Revision to query",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        }
      ]
    },
    {
      "name": "dashboard",
      "description": "Open web dashboards",
      "examples": [
        "istioctl dashboard kiali",
        "istioctl dashboard grafana",
        "istioctl dashboard jaeger",
        "istioctl dashboard prometheus",
        "istioctl dashboard envoy my-pod",
        "istioctl dashboard controlz istiod-xxx"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--port",
          "description": "Local port to bind",
          "type": "integer",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--browser",
          "description": "Open a browser",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--address",
          "description": "Address to bind",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "kube-inject",
      "description": "Inject sidecar into manifests",
      "examples": [
        "istioctl kube-inject -f deployment.yaml | kubectl apply -f -",
        "kubectl get deploy my-deploy -o yaml | istioctl kube-inject -f - | kubectl apply -f -"
      ],
      "options": [
        {
          "name": "--filename",
          "description": "Manifest to inject into",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--output",
          "description": "File to write",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--injectConfigFile",
          "description": "Injection configuration file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "experimental",
      "description": "Experimental commands",
      "examples": [
        "istioctl experimental waypoint generate",
        "istioctl experimental waypoint apply"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "tag",
      "description": "Manage revision tags",
      "examples": [
        "istioctl tag set prod --revision 1-17",
        "istioctl tag list"
      ],
      "options": [
        {
          "name": "--revision",
          "description": "Revision the tag points at",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--overwrite",
          "description": "Replace an existing tag",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-confirmation",
          "description": "Do not prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ]
    },
    {
      "name": "remote-clusters",
      "description": "List remote clusters",
      "examples": [
        "istioctl remote-clusters"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "bug-report",
      "description": "Generate debug report",
      "examples": [
        "istioctl bug-report"
      ],
      "options": [
        {
          "name": "--include",
          "description": "Resources to include",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--exclude",
          "description": "Resources to exclude",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--duration",
          "description": "How far back to collect",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "admin",
      "description": "Admin utilities",
      "examples": [
        "istioctl admin log --level debug"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "istioctl version",
        "istioctl version --remote"
      ],
      "options": [
        {
          "name": "--short",
          "description": "Print just the version",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--output",
          "description": "Output format",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--remote",
          "description": "Include control plane versions",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--istioNamespace",
      "short": "-i",
      "description": "Istio system namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-i"
    },
    {
      "name": "--revision",
      "description": "Istio revision",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "istioctl install --set profile=demo",
    "istioctl analyze",
    "istioctl proxy-config route my-pod",
    "istioctl proxy-status",
    "istioctl dashboard kiali",
    "istioctl kube-inject -f deployment.yaml | kubectl apply -f -",
    "istioctl manifest generate --set profile=demo",
    "istioctl profile list",
    "istioctl verify-install",
    "istioctl version"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "linkerd",
    "envoy"
  ]
}
