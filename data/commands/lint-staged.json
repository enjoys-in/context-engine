{
  "name": "lint-staged",
  "description": "Run linters against staged git files",
  "category": "javascript",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--config",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--allow-empty",
      "description": "Permit an empty commit",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--concurrent",
      "description": "Run tasks concurrently, or a limit",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--diff",
      "description": "Compare against this revision range",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--diff-filter",
      "description": "Git diff filter to apply",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-stash",
      "description": "Do not stash unstaged changes",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--relative",
      "description": "Pass paths relative to the config",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--shell",
      "description": "Shell to run commands in",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Print task output",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    }
  ],
  "examples": [
    {
      "command": "lint-staged",
      "description": "Run the configured tasks on staged files"
    },
    {
      "command": "lint-staged --no-stash",
      "description": "Run without stashing unstaged changes"
    },
    {
      "command": "lint-staged -c .lintstagedrc.json",
      "description": "Use a specific configuration"
    },
    {
      "command": "lint-staged --diff=\"main...HEAD\"",
      "description": "Run over a revision range"
    }
  ],
  "relatedCommands": [
    "husky",
    "prettier",
    "eslint",
    "biome",
    "pre-commit"
  ]
}
