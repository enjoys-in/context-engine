{
  "language": "ini",
  "name": "crudini",
  "description": "INI file manipulation tools (crudini, ini-parser)",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--existing",
      "description": "Fail if the section or key does not exist"
    },
    {
      "name": "--format",
      "description": "Output format: sh, lines, or ini"
    },
    {
      "name": "--output",
      "description": "Write output to file instead of modifying in-place"
    },
    {
      "name": "--verbose",
      "description": "Show details of changes"
    },
    {
      "name": "--list",
      "description": "Treat values as comma-separated lists"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    }
  ],
  "subcommands": [
    {
      "name": "--get",
      "description": "Get a value from an INI file",
      "args": [
        {
          "name": "file",
          "description": "INI file to act on",
          "type": "file",
          "required": true
        },
        {
          "name": "section",
          "description": "Configuration section to act on",
          "type": "string",
          "required": true
        },
        {
          "name": "key",
          "description": "Key to act on",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--format",
          "description": "Output format: sh, ini, lines or json",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "crudini --get config.ini database host",
        "crudini --get config.ini database"
      ]
    },
    {
      "name": "--set",
      "description": "Set a value in an INI file",
      "args": [
        {
          "name": "file",
          "description": "INI file to act on",
          "type": "file",
          "required": true
        },
        {
          "name": "section",
          "description": "Configuration section to act on",
          "type": "string",
          "required": true
        },
        {
          "name": "key",
          "description": "Key to act on",
          "type": "string",
          "required": true
        },
        {
          "name": "value",
          "description": "Value to set",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--inplace",
          "description": "Edit the file in place",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "crudini --set config.ini database port 5432"
      ]
    },
    {
      "name": "--del",
      "description": "Delete a key or section from an INI file",
      "args": [
        {
          "name": "file",
          "description": "INI file to act on",
          "type": "file",
          "required": true
        },
        {
          "name": "section",
          "description": "Configuration section to act on",
          "type": "string",
          "required": true
        },
        {
          "name": "key",
          "description": "Key to act on",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "crudini --del config.ini database password"
      ]
    },
    {
      "name": "--merge",
      "description": "Merge INI data from stdin into file",
      "args": [
        {
          "name": "file",
          "description": "INI file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Verbose output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "crudini --merge config.ini < overrides.ini"
      ]
    },
    {
      "name": "--get --format=lines",
      "description": "Get all keys in a section as lines",
      "args": [
        {
          "name": "file",
          "description": "INI file to act on",
          "type": "file",
          "required": true
        },
        {
          "name": "section",
          "description": "Configuration section to act on",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "crudini --get --format=lines config.ini"
      ]
    },
    {
      "name": "--existing",
      "description": "Only update existing keys (fail if missing)",
      "args": [
        {
          "name": "file",
          "description": "INI file to act on",
          "type": "file",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "crudini --set --existing config.ini database port 5432"
      ]
    }
  ],
  "examples": [
    "crudini --get config.ini database host",
    "crudini --set config.ini database port 5432",
    "crudini --del config.ini deprecated_section",
    "crudini --get --format=lines config.ini database",
    "crudini --merge config.ini < overrides.ini"
  ],
  "relatedCommands": [
    "toml",
    "yaml",
    "jq",
    "sed"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "crudini version",
        "command": "crudini --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "crudini"
      },
      {
        "name": "ini_files",
        "description": "INI files in this project",
        "command": "find . -maxdepth 2 -name '*.ini' -o -name '*.cfg' -o -name '*.conf' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "sections",
        "description": "Sections in the nearest INI file",
        "command": "grep -h '^\\[' *.ini 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  },
  "aliases": [
    "ini",
    "cfg",
    "conf",
    "config"
  ]
}
