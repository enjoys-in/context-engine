          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-header-row",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false,
          "short": "-H",
          "shorthand": "-H"
        },
        {
          "name": "--encoding",
          "description": "Input character encoding",
          "type": "string",
          "takesValue": true,
