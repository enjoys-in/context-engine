          "type": "string",
          "takesValue": true,
          "short": "-C",
          "shorthand": "-C"
        },
        {
          "name": "--names",
          "description": "List the column names and exit",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
