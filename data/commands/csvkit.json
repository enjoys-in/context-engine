          "shorthand": "-e"
        },
        {
          "name": "--skip-lines",
          "description": "Lines to skip before the header",
          "type": "integer",
          "takesValue": true,
          "short": "-K",
          "shorthand": "-K"
        },
        {
          "name": "--columns",
          "description": "Columns to include",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
