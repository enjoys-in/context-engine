{
  "name": "csvkit",
  "description": "Suite of command-line tools for converting to and working with CSV",
  "category": "data",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "csvlook",
      "description": "Render CSV as a table",
      "examples": [
        "csvlook data.csv"
      ],
      "options": [
        {
          "name": "--delimiter",
          "description": "Field delimiter of the input",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--no-header-row",
          "description": "Treat the first row as data",
          "type": "boolean",
          "takesValue": false,
          "short": "-H",
          "shorthand": "-H"
        },
        {
          "name": "--encoding",
          "description": "Input character encoding",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--skip-lines",
          "description": "Lines to skip before the header",
          "type": "integer",
          "takesValue": true,
          "short": "-K",
          "shorthand": "-K"
        },
        {
          "name": "--max-rows",
          "description": "Maximum rows to display",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--max-columns",
          "description": "Maximum columns to display",
          "type": "integer",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "CSV file to render as a table",
          "required": false,
          "type": "file"
        }
      ]
    },
    {
