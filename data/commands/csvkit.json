  "examples": [
    "csvlook data.csv",
    "csvcut -c name,age data.csv",
    "csvstat data.csv",
    "csvsql --query 'SELECT * FROM data' data.csv",
    "in2csv data.xlsx | csvlook"
  ],
  "relatedCommands": [
    "miller",
    "xsv",
    "awk",
    "jq"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "csvkit version",
        "command": "csvlook --version 2>/dev/null || in2csv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "csv_files",
        "description": "CSV and TSV files in this directory",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.tsv' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "tools",
        "description": "csvkit tools available on this host",
        "command": "which csvlook csvcut csvstat csvjoin csvsql in2csv 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
