{
  "name": "csvkit",
  "description": "Suite of command-line tools for converting to and working with CSV",
  "category": "data",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "csvlook",
      "description": "Render CSV as a table",
      "examples": [
        "csvlook data.csv"
      ]
    },
    {
      "name": "csvcut",
      "description": "Select/reorder columns",
      "examples": [
        "csvcut -c 1,3 data.csv"
      ]
    },
    {
      "name": "csvgrep",
      "description": "Filter rows",
      "examples": [
        "csvgrep -c name -m Alice data.csv"
      ]
    },
    {
      "name": "csvstat",
      "description": "Show statistics",
      "examples": [
        "csvstat data.csv"
      ]
    },
    {
      "name": "csvsort",
      "description": "Sort rows",
      "examples": [
        "csvsort -c 2 data.csv"
      ]
    },
    {
      "name": "csvjoin",
      "description": "Join CSV files",
      "examples": [
        "csvjoin -c id a.csv b.csv"
      ]
    },
    {
      "name": "in2csv",
      "description": "Convert to CSV",
      "examples": [
        "in2csv data.xlsx",
        "in2csv data.json"
      ]
    },
    {
      "name": "csvsql",
      "description": "Run SQL on CSV",
      "examples": [
        "csvsql --query 'SELECT * FROM data WHERE age > 30' data.csv"
      ]
    },
    {
      "name": "csvformat",
      "description": "Convert delimiter",
      "examples": [
        "csvformat -D '\\t' data.csv"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--delimiter",
      "description": "Field delimiter of the input file",
      "type": "string",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--tabs",
      "description": "Treat the input as tab-delimited",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--encoding",
      "description": "Character encoding of the input file",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--no-header-row",
      "description": "Treat the first row as data, not headers",
      "type": "boolean",
      "takesValue": false,
      "short": "-H",
      "shorthand": "-H"
    },
    {
      "name": "--skip-lines",
      "description": "Skip this many lines before the header",
      "type": "integer",
      "takesValue": true,
      "short": "-K",
      "shorthand": "-K"
    },
    {
      "name": "--verbose",
      "description": "Print detailed output and full tracebacks",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    "csvlook data.csv",
    "csvcut -c name,age data.csv",
    "csvstat data.csv",
    "csvsql --query 'SELECT * FROM data' data.csv",
    "in2csv data.xlsx | csvlook"
  ],
  "relatedCommands": [
    "miller",
    "xsv",
    "awk",
    "jq"
  ]
}
