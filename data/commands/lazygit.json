{
  "name": "lazygit",
  "description": "Terminal UI for git",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--path",
      "description": "Repository to open",
      "type": "directory",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--work-tree",
      "description": "Work tree path",
      "type": "directory",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--git-dir",
      "description": "Git directory path",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Print the current configuration",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--use-config-file",
      "description": "Configuration file to use",
      "type": "file",
      "takesValue": true,
      "short": "-ucf",
      "shorthand": "-ucf"
    },
    {
      "name": "--filter",
      "description": "Show the history of a single file",
      "type": "path",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--debug",
      "description": "Enable debug logging",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--logs",
      "description": "Tail the debug log",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--print-config-dir",
      "description": "Print the config directory",
      "type": "boolean",
      "takesValue": false,
      "short": "-cd",
      "shorthand": "-cd"
    }
  ],
  "examples": [
    {
      "command": "lazygit",
      "description": "Open in the current repository"
    },
    {
      "command": "lazygit -p ~/code/app",
      "description": "Open a specific repository"
    },
    {
      "command": "lazygit -f src/main.go",
      "description": "Browse one file’s history"
    },
    {
      "command": "lazygit -cd",
      "description": "Print the configuration directory"
    }
  ],
  "relatedCommands": [
    "git",
    "gitui",
    "tig",
    "gh",
    "delta"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "lazygit version",
        "command": "lazygit --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "lazygit"
      },
      {
        "name": "repo",
        "description": "Git repository lazygit would open",
        "command": "git rev-parse --show-toplevel 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "git"
      },
      {
        "name": "branch",
        "description": "Active git branch",
        "command": "git rev-parse --abbrev-ref HEAD 2>/dev/null",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "git"
      },
      {
        "name": "config",
        "description": "lazygit configuration",
        "command": "cat ~/.config/lazygit/config.yml 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
