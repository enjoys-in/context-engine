{
  "language": "msdax",
  "name": "dax",
  "description": "DAX — Data Analysis Expressions tools for Power BI and SSAS",
  "category": "tool",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "shells": [
    "powershell",
    "bash",
    "zsh"
  ],
  "globalOptions": [
    {
      "name": "--server",
      "description": "Analysis Services server connection string"
    },
    {
      "name": "--database",
      "description": "Target database name"
    },
    {
      "name": "--output",
      "description": "Output file path"
    },
    {
      "name": "--format",
      "description": "Output format (csv, json, xlsx)"
    },
    {
      "name": "--timeout",
      "description": "Query timeout in seconds"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    }
  ],
  "subcommands": [
    {
      "name": "format",
      "description": "Format DAX expressions using DAX Formatter",
      "args": [
        {
          "name": "expression",
          "description": "DAX expression to format",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--short",
          "description": "Format on a single line where possible",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--long",
          "description": "Format across multiple lines",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "analyze",
      "description": "Analyze DAX model using DAX Studio",
      "args": [
        {
          "name": "connection",
          "description": "Connection string to the model",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--query",
          "description": "DAX query to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the result to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "query",
      "description": "Execute DAX query against tabular model",
      "args": [
        {
          "name": "query",
          "description": "DAX query to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--server",
          "description": "Analysis Services or Power BI server",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--database",
          "description": "Database to query",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "export",
      "description": "Export DAX query results to file",
      "args": [
        {
          "name": "query",
          "description": "DAX query to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--format",
          "description": "Export format (csv, json, xlsx)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Write the result to this file",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "benchmark",
      "description": "Benchmark DAX query performance",
      "args": [
        {
          "name": "query",
          "description": "DAX query to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--iterations",
          "description": "Number of benchmark iterations",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--cold-cache",
          "description": "Clear the cache between iterations",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "examples": [
    "daxstudio.exe -c \"Data Source=localhost\\SSAS\"",
    "EVALUATE SUMMARIZECOLUMNS(Sales[Region], \"Total\", SUM(Sales[Amount]))",
    "tabular-editor model.bim --script analyze.csx",
    "pbi-tools extract report.pbix --output ./extracted"
  ],
  "relatedCommands": [
    "powerquery",
    "sql",
    "powershell"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "model_files",
        "description": "Power BI and tabular model files here",
        "command": "find . -maxdepth 2 -name '*.pbix' -o -maxdepth 2 -name '*.bim' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "dax_queries",
        "description": "DAX query files in this project",
        "command": "find . -maxdepth 2 -name '*.dax' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "tools",
        "description": "DAX tooling available on this host",
        "command": "which pbi-tools tabular-editor 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
