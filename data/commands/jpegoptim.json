{
  "name": "jpegoptim",
  "description": "Optimise JPEG files, losslessly or to a target quality",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--max",
      "description": "Maximum quality, enabling lossy mode",
      "type": "integer",
      "takesValue": true,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--size",
      "description": "Target file size, e.g. 200k",
      "type": "string",
      "takesValue": true,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--strip-all",
      "description": "Remove every metadata marker",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strip-exif",
      "description": "Remove EXIF data",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strip-com",
      "description": "Remove comment markers",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dest",
      "description": "Write outputs into this directory",
      "type": "directory",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--overwrite",
      "description": "Overwrite existing output files",
      "type": "boolean",
      "takesValue": false,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--preserve",
      "description": "Preserve file timestamps",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--totals",
      "description": "Print a summary",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--noaction",
      "description": "Do not write anything",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    }
  ],
  "examples": [
    {
      "command": "jpegoptim photo.jpg",
      "description": "Optimise losslessly"
    },
    {
      "command": "jpegoptim -m85 --strip-all *.jpg",
      "description": "Re-encode at quality 85 and strip metadata"
    },
    {
      "command": "jpegoptim -S200k photo.jpg",
      "description": "Optimise towards a target size"
    },
    {
      "command": "jpegoptim -d out/ -p *.jpg",
      "description": "Write results elsewhere, keeping timestamps"
    }
  ],
  "relatedCommands": [
    "optipng",
    "imagemagick",
    "exiftool"
  ]
}
