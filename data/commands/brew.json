{
  "name": "brew",
  "description": "Homebrew package manager for macOS and Linux",
  "category": "package-manager",
  "platforms": [
    "macos",
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install packages (formulae or casks)",
      "args": [
        {
          "name": "formula",
          "description": "Formula/cask name",
          "required": true,
          "type": "package"
        }
      ],
      "options": [
        {
          "name": "--cask",
          "description": "Install as cask"
        },
        {
          "name": "--build-from-source",
          "description": "Build from source"
        },
        {
          "name": "--force",
          "description": "Force install"
        },
        {
          "name": "--verbose",
          "description": "Verbose"
        },
        {
          "name": "--HEAD",
          "description": "Install HEAD version"
        },
        {
          "name": "--fetch-HEAD",
          "description": "Fetch HEAD version"
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall formula",
      "args": [
        {
          "name": "formula",
          "description": "Formula name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--force",
          "description": "Force uninstall"
        },
        {
          "name": "--zap",
          "description": "Remove all files (casks)"
        }
      ]
    },
    {
      "name": "update",
      "description": "Update Homebrew itself",
      "options": [
        {
          "name": "--verbose",
          "description": "Print more detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        },
        {
          "name": "--force",
          "description": "Update even without changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--auto-update",
          "description": "Run as an automatic update",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade packages",
      "args": [
        {
          "name": "formula",
          "description": "Specific formula (optional)",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--cask",
          "description": "Upgrade casks"
        },
        {
          "name": "--greedy",
          "description": "Also upgrade auto-updated casks"
        }
      ]
    },
    {
      "name": "search",
      "description": "Search formulae and casks",
      "args": [
        {
          "name": "query",
          "description": "Search text",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--formula",
          "description": "Search formulae only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--cask",
          "description": "Search casks only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--desc",
          "description": "Search descriptions too",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--eval-all",
          "description": "Evaluate every formula",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "info",
      "description": "Formula/cask info",
      "args": [
        {
          "name": "formula",
          "description": "Formula name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--json",
          "description": "JSON output"
        },
        {
          "name": "--cask",
          "description": "Cask info"
        }
      ]
    },
    {
      "name": "list",
      "description": "List installed",
      "options": [
        {
          "name": "--cask",
          "description": "List casks"
        },
        {
          "name": "--versions",
          "description": "Show versions"
        },
        {
          "name": "--formula",
          "description": "Only formulae"
        }
      ]
    },
    {
      "name": "outdated",
      "description": "Show outdated packages",
      "options": [
        {
          "name": "--cask",
          "description": "Outdated casks"
        },
        {
          "name": "--greedy",
          "description": "Include auto-updated"
        }
      ]
    },
    {
      "name": "pin",
      "description": "Pin formula version",
      "args": [
        {
          "name": "formula",
          "description": "Formula to pin",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": []
    },
    {
      "name": "unpin",
      "description": "Unpin formula",
      "options": [],
      "args": [
        {
          "name": "formula",
          "description": "Formula to unpin",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "cleanup",
      "description": "Clean old versions",
      "options": [
        {
          "name": "--prune",
          "description": "Remove older than N days",
          "takesValue": true
        },
        {
          "name": "-s",
          "description": "Scrub cache"
        },
        {
          "name": "-n",
          "description": "Dry run"
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Diagnose issues",
      "options": [
        {
          "name": "--list-checks",
          "description": "List the available checks",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--audit-debug",
          "description": "Enable debugging for audits",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "config",
      "description": "Show Homebrew config",
      "options": []
    },
    {
      "name": "deps",
      "description": "Show dependencies",
      "args": [
        {
          "name": "formula",
          "description": "Formula name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--tree",
          "description": "Tree view"
        },
        {
          "name": "--installed",
          "description": "Installed deps"
        }
      ]
    },
    {
      "name": "uses",
      "description": "Show dependents",
      "args": [
        {
          "name": "formula",
          "description": "Formula name",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ],
      "options": [
        {
          "name": "--installed",
          "description": "Only installed dependents",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recursive",
          "description": "Include transitive dependents",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--include-build",
          "description": "Include build dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--include-test",
          "description": "Include test dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "leaves",
      "description": "Show formulae not depended on",
      "options": [
        {
          "name": "--installed-on-request",
          "description": "Only explicitly installed",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--installed-as-dependency",
          "description": "Only installed as dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "services",
      "description": "Manage background services",
      "subcommands": [
        {
          "name": "list",
          "description": "List services",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "start",
          "description": "Start service",
          "options": [
            {
              "name": "--all",
              "description": "Start every service",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--file",
              "description": "Service plist to use",
              "type": "file",
              "takesValue": true
            }
          ],
          "args": [
            {
              "name": "formula",
              "description": "Service to start",
              "required": false,
              "type": "package",
              "completion": {
                "detector": "services"
              }
            }
          ]
        },
        {
          "name": "stop",
          "description": "Stop service",
          "options": [
            {
              "name": "--all",
              "description": "Stop every service",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--keep",
              "description": "Keep the service file in place",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "formula",
              "description": "Service to stop",
              "required": false,
              "type": "package",
              "completion": {
                "detector": "services"
              }
            }
          ]
        },
        {
          "name": "restart",
          "description": "Restart service",
          "options": [
            {
              "name": "--all",
              "description": "Restart every service",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "formula",
              "description": "Service to restart",
              "required": false,
              "type": "package",
              "completion": {
                "detector": "services"
              }
            }
          ]
        },
        {
          "name": "run",
          "description": "Run service (foreground)",
          "options": [
            {
              "name": "--all",
              "description": "Run every service",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "args": [
            {
              "name": "formula",
              "description": "Service to run",
              "required": false,
              "type": "package",
              "completion": {
                "detector": "services"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "tap",
      "description": "Tap (add) a repository",
      "args": [
        {
          "name": "repo",
          "description": "user/repo",
          "required": false
        }
      ],
      "options": [
        {
          "name": "--force-auto-update",
          "description": "Always check the tap for updates",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--shallow",
          "description": "Clone a shallow copy",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "untap",
      "description": "Remove a tapped repository",
      "options": [
        {
          "name": "--force",
          "description": "Untap even if formulae are installed",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "tap",
          "description": "Tap to remove",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "link",
      "description": "Symlink formula",
      "options": [
        {
          "name": "--overwrite",
          "description": "Replace conflicting files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Report what would be linked",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--force",
          "description": "Link a keg-only formula",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "args": [
        {
          "name": "formula",
          "description": "Formula to link",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "unlink",
      "description": "Unsymlink formula",
      "options": [
        {
          "name": "--dry-run",
          "description": "Report what would be unlinked",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "formula",
          "description": "Formula to unlink",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "switch",
      "description": "Switch to specific version",
      "options": [],
      "args": [
        {
          "name": "formula",
          "description": "Formula to switch",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        },
        {
          "name": "version",
          "description": "Installed version to activate",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "bundle",
      "description": "Bundler for Homebrew",
      "subcommands": [
        {
          "name": "dump",
          "description": "Write Brewfile",
          "options": [
            {
              "name": "--file",
              "description": "Brewfile to write",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--force",
              "description": "Overwrite an existing Brewfile",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--describe",
              "description": "Add descriptive comments",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "install",
          "description": "Install from Brewfile",
          "options": [
            {
              "name": "--file",
              "description": "Brewfile to read",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--no-upgrade",
              "description": "Do not upgrade installed formulae",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--verbose",
              "description": "Print more detail",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "check",
          "description": "Check Brewfile",
          "options": [
            {
              "name": "--file",
              "description": "Brewfile to read",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--verbose",
              "description": "List what is missing",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "cleanup",
          "description": "Remove unlisted",
          "options": [
            {
              "name": "--file",
              "description": "Brewfile to read",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--force",
              "description": "Actually remove the extras",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--zap",
              "description": "Also zap casks",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "list",
          "description": "List from Brewfile",
          "options": [
            {
              "name": "--file",
              "description": "Brewfile to read",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--all",
              "description": "List every entry type",
              "type": "boolean",
              "takesValue": false
            }
          ]
        }
      ]
    },
    {
      "name": "autoremove",
      "description": "Remove dependencies no longer needed",
      "options": [
        {
          "name": "--dry-run",
          "description": "Report what would be removed",
          "type": "boolean",
          "takesValue": false,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "analytics",
      "description": "Manage anonymous analytics",
      "options": []
    },
    {
      "name": "desc",
      "description": "Show a formula description",
      "options": [
        {
          "name": "--search",
          "description": "Search descriptions",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "formula",
          "description": "Formula to describe",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "livecheck",
      "description": "Check formulae for newer upstream versions",
      "options": [
        {
          "name": "--newer-only",
          "description": "Only formulae with newer versions",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--full-name",
          "description": "Print fully qualified names",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "formula",
          "description": "Formula to check upstream versions for",
          "required": false,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    },
    {
      "name": "reinstall",
      "description": "Reinstall a formula",
      "options": [
        {
          "name": "--force",
          "description": "Reinstall without prompting",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--build-from-source",
          "description": "Compile from source",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        }
      ],
      "args": [
        {
          "name": "formula",
          "description": "Formula to reinstall",
          "required": true,
          "type": "package",
          "completion": {
            "detector": "installed"
          }
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--debug",
      "shorthand": "-d",
      "description": "Debug mode",
      "short": "-d"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet mode",
      "short": "-q"
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "description": "Show version"
    }
  ],
  "examples": [
    {
      "command": "brew install node",
      "description": "Install Node.js"
    },
    {
      "command": "brew install --cask visual-studio-code",
      "description": "Install VS Code"
    },
    {
      "command": "brew update && brew upgrade",
      "description": "Update and upgrade all"
    },
    {
      "command": "brew search redis",
      "description": "Search for Redis"
    },
    {
      "command": "brew info nginx",
      "description": "Nginx formula info"
    },
    {
      "command": "brew list",
      "description": "List installed formulae"
    },
    {
      "command": "brew outdated",
      "description": "Show outdated"
    },
    {
      "command": "brew services list",
      "description": "List services"
    },
    {
      "command": "brew services start postgresql",
      "description": "Start PostgreSQL"
    },
    {
      "command": "brew cleanup -s",
      "description": "Clean cache"
    },
    {
      "command": "brew doctor",
      "description": "Diagnose issues"
    },
    {
      "command": "brew bundle dump",
      "description": "Create Brewfile"
    }
  ],
  "relatedCommands": [
    "apt",
    "pacman"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "installed",
        "description": "Installed formulae",
        "command": "brew list --formula --versions 2>/dev/null | tail -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "brew"
      },
      {
        "name": "casks",
        "description": "Installed casks",
        "command": "brew list --cask 2>/dev/null | tail -20",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "brew"
      },
      {
        "name": "outdated",
        "description": "Outdated packages",
        "command": "brew outdated 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "brew"
      },
      {
        "name": "services",
        "description": "Homebrew services",
        "command": "brew services list 2>/dev/null | tail -15",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "brew"
      },
      {
        "name": "taps",
        "description": "Tapped repositories",
        "command": "brew tap 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300,
        "requiresCmd": "brew"
      }
    ]
  }
}
