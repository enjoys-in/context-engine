{
  "language": "perl",
  "name": "perl",
  "description": "Perl — practical extraction and report language interpreter",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "-e",
      "description": "Execute the given string as Perl code"
    },
    {
      "name": "-n",
      "description": "Wrap code in 'while (<>) { ... }' loop"
    },
    {
      "name": "-p",
      "description": "Like -n but also prints each line"
    },
    {
      "name": "-i[ext]",
      "description": "Edit files in-place (optionally create backup)"
    },
    {
      "name": "-w",
      "description": "Enable warnings"
    },
    {
      "name": "-c",
      "description": "Check syntax without executing"
    },
    {
      "name": "-d",
      "description": "Run under the Perl debugger"
    },
    {
      "name": "-I<dir>",
      "description": "Add directory to @INC module search path"
    },
    {
      "name": "-M<module>",
      "description": "Load a module before executing"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    }
  ],
  "subcommands": [
    {
      "name": "script.pl",
      "description": "Run a Perl script",
      "args": [
        {
          "name": "file",
          "description": "Perl script to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-I",
          "description": "Add a directory to @INC",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-M",
          "description": "Load this module before running",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-w",
          "description": "Enable warnings",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-T",
          "description": "Enable taint checking",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "perl script.pl"
      ]
    },
    {
      "name": "-e \"code\"",
      "description": "Execute a one-liner expression",
      "args": [
        {
          "name": "code",
          "description": "Code to execute",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-l",
          "description": "Enable automatic line-ending processing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-n",
          "description": "Wrap the code in a read loop",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-p",
          "description": "Wrap the code in a print loop",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-M",
          "description": "Load this module first",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "perl -e \"code\""
      ]
    },
    {
      "name": "-c script.pl",
      "description": "Syntax check without executing",
      "args": [
        {
          "name": "file",
          "description": "Perl script to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-w",
          "description": "Enable warnings",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-I",
          "description": "Add a directory to @INC",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "perl -c script.pl"
      ]
    },
    {
      "name": "-n -e \"code\"",
      "description": "Process each input line with expression",
      "args": [
        {
          "name": "code",
          "description": "Code to execute",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-l",
          "description": "Enable automatic line-ending processing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-a",
          "description": "Split each line into @F",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-F",
          "description": "Field separator for autosplit",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "perl -n -e \"code\""
      ]
    },
    {
      "name": "-p -i -e 's/old/new/g' file",
      "description": "In-place edit with regex substitution",
      "args": [
        {
          "name": "pattern",
          "description": "Substitution expression to apply",
          "type": "string",
          "required": true
        },
        {
          "name": "file",
          "description": "Perl script to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-i",
          "description": "Edit in place, optionally with this backup suffix",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-l",
          "description": "Enable automatic line-ending processing",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "perl -p -i -e 's/old/new/g' file"
      ]
    },
    {
      "name": "-MCPAN -e 'install Module'",
      "description": "Install a CPAN module",
      "args": [
        {
          "name": "module",
          "description": "Module to act on",
          "type": "package",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-I",
          "description": "Add a directory to @INC",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "perl -MCPAN -e 'install Module'"
      ]
    }
  ],
  "examples": [
    "perl script.pl",
    "perl -e 'print \"Hello, World!\\n\"'",
    "perl -pi -e 's/foo/bar/g' *.txt",
    "perl -ne 'print if /pattern/' file.log",
    "cpanm install JSON::XS",
    "perl -c script.pl"
  ],
  "relatedCommands": [
    "sed",
    "awk",
    "python",
    "ruby",
    "grep"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Perl version",
        "command": "perl -v 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "perl"
      },
      {
        "name": "inc_paths",
        "description": "Perl module search paths",
        "command": "perl -e 'print join(\"\\n\", @INC)' 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "perl"
      },
      {
        "name": "project_files",
        "description": "Perl project files present",
        "command": "ls Makefile.PL Build.PL cpanfile 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "sources",
        "description": "Perl sources",
        "command": "find . -maxdepth 3 -name '*.pl' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
