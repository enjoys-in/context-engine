{
  "name": "xcodebuild",
  "description": "Build Xcode projects and workspaces",
  "category": "mobile",
  "platforms": [
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build the target in the build root (SYMROOT)",
      "args": [],
      "options": [
        {
          "name": "-scheme",
          "description": "Scheme to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-project",
          "description": "Xcode project to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-workspace",
          "description": "Xcode workspace to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-destination",
          "description": "Destination specifier to build for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-derivedDataPath",
          "description": "Directory for derived data",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "xcodebuild"
      ]
    },
    {
      "name": "clean",
      "description": "Remove build products and intermediate files from the build root (SYMROOT)",
      "args": [],
      "options": [
        {
          "name": "-scheme",
          "description": "Scheme to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-project",
          "description": "Xcode project to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-workspace",
          "description": "Xcode workspace to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-destination",
          "description": "Destination specifier to build for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-derivedDataPath",
          "description": "Directory for derived data",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "xcodebuild clean"
      ]
    },
    {
      "name": "test",
      "description": "Test a scheme from the build root (SYMROOT)",
      "args": [],
      "options": [
        {
          "name": "-scheme",
          "description": "Scheme to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-project",
          "description": "Xcode project to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-workspace",
          "description": "Xcode workspace to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-destination",
          "description": "Destination specifier to build for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-derivedDataPath",
          "description": "Directory for derived data",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-only-testing",
          "description": "Only run these tests",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-skip-testing",
          "description": "Skip these tests",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-resultBundlePath",
          "description": "Write the result bundle here",
          "type": "path",
          "takesValue": true
        }
      ],
      "examples": [
        "xcodebuild test -workspace MyApp.xcworkspace -scheme MyApp -destination 'platform=iOS Simulator,name=iPhone 14'"
      ]
    },
    {
      "name": "archive",
      "description": "Archive a scheme from the build root (SYMROOT)",
      "args": [],
      "options": [
        {
          "name": "-scheme",
          "description": "Scheme to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-project",
          "description": "Xcode project to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-workspace",
          "description": "Xcode workspace to act on",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-configuration",
          "description": "Build configuration to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-destination",
          "description": "Destination specifier to build for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "-derivedDataPath",
          "description": "Directory for derived data",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-archivePath",
          "description": "Write the archive here",
          "type": "path",
          "takesValue": true
        }
      ],
      "examples": [
        "xcodebuild archive -workspace MyApp.xcworkspace -scheme MyApp -archivePath MyApp.xcarchive"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-project",
      "description": "Build the project NAME",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-workspace",
      "description": "Build the workspace NAME",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-target",
      "description": "Build the target NAME",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-alltargets",
      "description": "Build all targets"
    },
    {
      "name": "-scheme",
      "description": "Build the scheme NAME",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-destination",
      "description": "Use the destination described by DESTINATIONSPECIFIER",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-configuration",
      "description": "Use the build configuration NAME for building each target",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-arch",
      "description": "Use the architecture ARCHITECTURE for building each target",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-sdk",
      "description": "Use SDK as the name or path of the base SDK when building the project",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-showsdks",
      "description": "Display a comprehensive list of all installed SDKs"
    },
    {
      "name": "-showBuildSettings",
      "description": "display a list of build settings and values"
    },
    {
      "name": "-list",
      "description": "List the targets and configurations in a project, or the schemes in a workspace"
    },
    {
      "name": "-allowProvisioningUpdates",
      "description": "Allow xcodebuild to communicate with the Apple Developer website"
    }
  ],
  "examples": [
    "xcodebuild -workspace MyApp.xcworkspace -scheme MyApp clean build",
    "xcodebuild -list",
    "xcodebuild -showsdks"
  ],
  "relatedCommands": [
    "pod",
    "fastlane"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "workspaces",
        "description": "Available Xcode Workspaces",
        "command": "ls -d *.xcworkspace 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "projects",
        "description": "Available Xcode Projects",
        "command": "ls -d *.xcodeproj 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  }
}
