{
  "name": "ab",
  "description": "Apache Bench — HTTP server benchmarking tool",
  "category": "http-testing",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Number of requests",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Concurrency level",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Time limit (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-H",
      "description": "Custom header",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-T",
      "description": "Content-Type header",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "POST data file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-k",
      "description": "Enable keep-alive"
    },
    {
      "name": "-s",
      "description": "Timeout per request (seconds)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-g",
      "description": "Output TSV (gnuplot)",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "Output CSV percentiles",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    "ab -n 1000 -c 10 http://localhost:8080/",
    "ab -n 5000 -c 100 -k http://localhost/",
    "ab -t 30 -c 50 http://localhost:3000/api/test",
    "ab -n 100 -c 10 -H 'Authorization: Bearer token' http://api.example.com/"
  ],
  "relatedCommands": [
    "wrk",
    "hey",
    "vegeta",
    "siege"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ApacheBench version",
        "command": "ab -V 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ab"
      },
      {
        "name": "open_files",
        "description": "File descriptor limit that caps concurrency",
        "command": "ulimit -n 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "cpu_count",
        "description": "Logical CPUs available for load generation",
        "command": "nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
