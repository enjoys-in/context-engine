{
  "name": "hyperfine",
  "description": "Command-line benchmarking tool with statistical analysis",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--warmup",
      "description": "Warm-up runs before timing",
      "type": "integer",
      "takesValue": true,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--runs",
      "description": "Number of timed runs",
      "type": "integer",
      "takesValue": true,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--min-runs",
      "description": "Minimum number of runs",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--max-runs",
      "description": "Maximum number of runs",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--prepare",
      "description": "Command to run before each timed run",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--cleanup",
      "description": "Command to run after all runs",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--parameter-list",
      "description": "Vary a parameter across values",
      "type": "string",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--export-json",
      "description": "Write results as JSON",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--export-markdown",
      "description": "Write results as Markdown",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--export-csv",
      "description": "Write results as CSV",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--shell",
      "description": "Shell to run commands in, or none",
      "type": "string",
      "takesValue": true,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--ignore-failure",
      "description": "Continue when a command exits non-zero",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--show-output",
      "description": "Print the command output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "hyperfine \"ls -R ~\"",
      "description": "Benchmark a single command"
    },
    {
      "command": "hyperfine -w 3 \"rg TODO\" \"grep -r TODO .\"",
      "description": "Compare two commands after warm-up"
    },
    {
      "command": "hyperfine -L n 1,2,4 \"make -j{n}\"",
      "description": "Sweep a parameter"
    },
    {
      "command": "hyperfine --export-markdown bench.md \"./a\" \"./b\"",
      "description": "Export a comparison table"
    }
  ],
  "relatedCommands": [
    "time",
    "perf",
    "wrk",
    "hey"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "hyperfine version",
        "command": "hyperfine --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "hyperfine"
      },
      {
        "name": "cpu_count",
        "description": "Logical CPUs available for benchmarking",
        "command": "nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "governor",
        "description": "CPU frequency governor in effect",
        "command": "cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
