{
  "name": "devspace",
  "description": "DevSpace — develop, deploy, and debug apps on Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize DevSpace in a project",
      "examples": [
        "devspace init"
      ],
      "options": [
        {
          "name": "--reconfigure",
          "description": "Reconfigure an existing project",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dockerfile",
          "description": "Dockerfile to use",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--context",
          "description": "Build context",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "dev",
      "description": "Start development mode",
      "examples": [
        "devspace dev",
        "devspace dev --no-warn",
        "devspace dev -n my-ns"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--profile",
          "description": "Configuration profile",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--skip-build",
          "description": "Do not rebuild images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force-build",
          "description": "Rebuild even if unchanged",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--open",
          "description": "Open the app in a browser",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--var",
          "description": "Config variable, key=value",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy the project",
      "examples": [
        "devspace deploy",
        "devspace deploy --skip-build",
        "devspace deploy -p production"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--profile",
          "description": "Configuration profile",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--force-deploy",
          "description": "Redeploy even if unchanged",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--skip-build",
          "description": "Do not rebuild images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--var",
          "description": "Config variable, key=value",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "build",
      "description": "Build images",
      "examples": [
        "devspace build",
        "devspace build --skip-push"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Configuration profile",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--skip-push",
          "description": "Do not push the images",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force-build",
          "description": "Rebuild even if unchanged",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "purge",
      "description": "Delete deployed resources",
      "examples": [
        "devspace purge"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--deployments",
          "description": "Only these deployments",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--all",
          "description": "Purge everything",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "enter",
      "description": "Start a shell in container",
      "examples": [
        "devspace enter",
        "devspace enter -c my-container"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--container",
          "description": "Container to enter",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--pod",
          "description": "Pod to enter",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--label-selector",
          "description": "Pod label selector",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        }
      ]
    },
    {
      "name": "logs",
      "description": "View container logs",
      "examples": [
        "devspace logs",
        "devspace logs -f",
        "devspace logs -c my-container"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--follow",
          "description": "Stream new output",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--container",
          "description": "Container to read",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--lines",
          "description": "Lines to show",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "sync",
      "description": "Start file sync",
      "examples": [
        "devspace sync --local-path=. --container-path=/app"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--local-path",
          "description": "Local path to sync",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--container-path",
          "description": "Container path to sync",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-watch",
          "description": "Sync once and exit",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--download-only",
          "description": "Only download changes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "open",
      "description": "Open app in browser",
      "examples": [
        "devspace open"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--provider",
          "description": "Provider to open through",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ui",
      "description": "Start DevSpace UI",
      "examples": [
        "devspace ui"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Local port to serve on",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host to bind",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "use",
      "description": "Set context/namespace/profile",
      "examples": [
        "devspace use context my-context",
        "devspace use namespace my-ns",
        "devspace use profile my-profile"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to select",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "What to use: context, namespace or profile",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "list",
      "description": "List resources",
      "examples": [
        "devspace list commands",
        "devspace list profiles",
        "devspace list vars",
        "devspace list deployments"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to list from",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run custom command",
      "examples": [
        "devspace run my-command"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Configuration profile",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        }
      ],
      "args": [
        {
          "name": "pipeline",
          "description": "Custom command to run",
          "required": true,
          "type": "job"
        }
      ]
    },
    {
      "name": "reset",
      "description": "Reset cluster state",
      "examples": [
        "devspace reset vars",
        "devspace reset pods"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "cleanup",
      "description": "Clean images",
      "examples": [
        "devspace cleanup images"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade DevSpace",
      "examples": [
        "devspace upgrade"
      ],
      "options": [
        {
          "name": "--version",
          "description": "Version to upgrade to",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Config file path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--kube-context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--profile",
      "short": "-p",
      "description": "Profile to use",
      "type": "string",
      "takesValue": true,
      "shorthand": "-p"
    },
    {
      "name": "--var",
      "description": "Set variables",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--debug",
      "description": "Debug mode"
    },
    {
      "name": "--silent",
      "description": "Silent mode"
    }
  ],
  "examples": [
    "devspace init",
    "devspace dev",
    "devspace deploy",
    "devspace build",
    "devspace enter",
    "devspace logs -f",
    "devspace purge",
    "devspace use namespace my-ns",
    "devspace ui"
  ],
  "relatedCommands": [
    "skaffold",
    "tilt",
    "telepresence",
    "kubectl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "DevSpace version",
        "command": "devspace version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "devspace"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "config",
        "description": "DevSpace project configuration",
        "command": "cat devspace.yaml 2>/dev/null | head -60",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "profiles",
        "description": "DevSpace profiles declared",
        "command": "devspace list profiles 2>/dev/null",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "devspace"
      }
    ]
  }
}
