{
  "name": "uv",
  "description": "Extremely fast Python package and project manager, written in Rust",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "pip",
      "description": "pip-compatible interface for installing and managing packages",
      "options": [
        {
          "name": "--system",
          "description": "Install into the system Python rather than a virtualenv",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-cache",
          "description": "Disable the package cache",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "venv",
      "description": "Create a virtual environment",
      "options": [
        {
          "name": "--python",
          "description": "Python interpreter to use",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--seed",
          "description": "Install pip and setuptools into the environment",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "path",
          "description": "Directory to create the environment in",
          "type": "path",
          "required": false
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a command in the project environment",
      "options": [
        {
          "name": "--with",
          "description": "Add a package for this run only",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--no-project",
          "description": "Ignore the surrounding project",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "sync",
      "description": "Install exactly what the lockfile specifies",
      "options": [
        {
          "name": "--frozen",
          "description": "Do not update the lockfile",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--all-extras",
          "description": "Include every optional dependency group",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "lock",
      "description": "Resolve dependencies and write uv.lock",
      "options": [
        {
          "name": "--upgrade",
          "description": "Ignore pinned versions and re-resolve",
          "type": "boolean",
          "takesValue": false,
          "short": "-U",
          "shorthand": "-U"
        }
      ]
    },
    {
      "name": "add",
      "description": "Add a dependency to pyproject.toml",
      "options": [
        {
          "name": "--dev",
          "description": "Add to the development group",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--optional",
          "description": "Add to an optional group",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "package",
          "description": "Package to add",
          "type": "string",
          "required": true
        }
      ]
    },
    {
      "name": "remove",
      "description": "Remove a dependency from pyproject.toml",
      "args": [
        {
          "name": "package",
          "description": "Package to remove",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--dev",
          "description": "Remove from the dev dependency group",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--optional",
          "description": "Remove from this optional extra",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--package",
          "description": "Remove from this workspace member",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--frozen",
          "description": "Do not update the lockfile",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "tool",
      "description": "Install and run tools in isolated environments",
      "options": [
        {
          "name": "--from",
          "description": "Package that provides the tool",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "python",
      "description": "Install and manage Python versions",
      "options": [
        {
          "name": "--preview",
          "description": "Allow preview releases",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build source and wheel distributions",
      "options": [
        {
          "name": "--out-dir",
          "description": "Directory to write artifacts to",
          "type": "directory",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ]
    },
    {
      "name": "publish",
      "description": "Upload distributions to an index",
      "options": [
        {
          "name": "--token",
          "description": "Token to authenticate with",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "tree",
      "description": "Show the dependency tree",
      "options": [
        {
          "name": "--depth",
          "description": "Maximum depth to display",
          "type": "integer",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--quiet",
      "description": "Suppress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--offline",
      "description": "Work without network access",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--directory",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "uv venv",
      "description": "Create a virtual environment in .venv"
    },
    {
      "command": "uv pip install -r requirements.txt",
      "description": "Install from a requirements file"
    },
    {
      "command": "uv add ruff --dev",
      "description": "Add ruff as a dev dependency"
    },
    {
      "command": "uv run pytest",
      "description": "Run pytest in the project environment"
    },
    {
      "command": "uv sync --frozen",
      "description": "Install exactly the lockfile, without re-resolving"
    }
  ],
  "relatedCommands": [
    "pip",
    "poetry",
    "pipx",
    "pyenv",
    "python"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "uv version",
        "command": "uv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "uv"
      },
      {
        "name": "pyproject",
        "description": "Python project configuration",
        "command": "cat pyproject.toml 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "python_versions",
        "description": "Python interpreters uv can use",
        "command": "uv python list 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "uv"
      },
      {
        "name": "lock",
        "description": "uv lockfile present",
        "command": "ls uv.lock 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "virtualenv",
        "description": "Active Python virtual environment",
        "command": "echo \"${VIRTUAL_ENV:-none}\"",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
