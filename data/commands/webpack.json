{
  "name": "webpack",
  "description": "Module bundler for JavaScript applications",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "serve",
      "description": "Start webpack dev server",
      "examples": [
        "webpack serve",
        "webpack serve --open"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Port the dev server binds to",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Host the dev server binds to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--open",
          "description": "Open a browser on start",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--hot",
          "description": "Enable hot module replacement",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--config",
          "description": "webpack config file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    },
    {
      "name": "watch",
      "description": "Watch files for changes",
      "examples": [
        "webpack watch"
      ],
      "options": [
        {
          "name": "--config",
          "description": "webpack config file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--mode",
          "description": "Build mode: development or production",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--progress",
          "description": "Show build progress",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "build",
      "description": "Build the project",
      "examples": [
        "webpack build"
      ],
      "options": [
        {
          "name": "--config",
          "description": "webpack config file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--mode",
          "description": "Build mode: development or production",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--analyze",
          "description": "Open the bundle analyzer",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--mode",
      "description": "Build mode (development, production, none)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config",
      "description": "Path to config file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--entry",
      "description": "Entry point",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output-path",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--devtool",
      "description": "Source map strategy",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--watch",
      "short": "-w",
      "description": "Watch for changes",
      "shorthand": "-w"
    },
    {
      "name": "--stats",
      "description": "Stats preset",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--progress",
      "description": "Show build progress"
    }
  ],
  "examples": [
    "webpack",
    "webpack --mode production",
    "webpack --config webpack.prod.js",
    "webpack serve --open",
    "webpack --progress --stats errors-only"
  ],
  "relatedCommands": [
    "esbuild",
    "rollup",
    "vite",
    "babel"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "webpack version",
        "command": "webpack --version 2>/dev/null || npx webpack --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "webpack configuration",
        "command": "cat webpack.config.js 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "configs",
        "description": "webpack configs for each environment",
        "command": "ls webpack.*.js 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
