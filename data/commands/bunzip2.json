{
  "name": "bunzip2",
  "description": "Expand files compressed with bzip2",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--verbose",
      "description": "Report each file",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "bunzip2 dump.sql.bz2",
      "description": "Expand in place"
    },
    {
      "command": "bunzip2 -c dump.sql.bz2 | psql",
      "description": "Stream straight into a consumer"
    }
  ],
  "relatedCommands": [
    "bzip2",
    "gunzip",
    "tar"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "bzip2 version",
        "command": "bunzip2 --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "bunzip2"
      },
      {
        "name": "archives",
        "description": "bzip2 archives in this directory",
        "command": "find . -maxdepth 2 -name '*.bz2' -o -name '*.tbz2' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
