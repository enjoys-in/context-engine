{
  "language": "scheme",
  "name": "scheme",
  "description": "Scheme — Lisp-dialect interpreter (Chez Scheme, Guile, MIT/GNU Scheme, Racket)",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--script",
      "description": "Run file as a script"
    },
    {
      "name": "--program",
      "description": "Run file as R6RS program"
    },
    {
      "name": "--optimize-level",
      "description": "Optimization level (0-3)"
    },
    {
      "name": "--libdirs",
      "description": "Colon-separated library directories"
    },
    {
      "name": "--compile-imported-libraries",
      "description": "Compile imported libraries to .so files"
    },
    {
      "name": "--debug-on-exception",
      "description": "Enter debugger on unhandled exceptions"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    }
  ],
  "subcommands": [
    {
      "name": "--script file.scm",
      "description": "Run a Scheme script file",
      "args": [
        {
          "name": "file",
          "description": "Scheme source file to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--heap",
          "description": "Heap size to allocate",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--quiet",
          "description": "Suppress the startup banner",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "scheme --script file.scm"
      ]
    },
    {
      "name": "--program file.scm",
      "description": "Run as R6RS program",
      "args": [
        {
          "name": "file",
          "description": "Scheme source file to run",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--heap",
          "description": "Heap size to allocate",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "scheme --program file.scm"
      ]
    },
    {
      "name": "-e '(expression)'",
      "description": "Evaluate a single Scheme expression",
      "args": [
        {
          "name": "expr",
          "description": "Expression to evaluate",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--quiet",
          "description": "Suppress the startup banner",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "scheme -e '(expression)'"
      ]
    },
    {
      "name": "--compile-imported-libraries",
      "description": "Compile all imported libraries",
      "args": [],
      "options": [
        {
          "name": "--optimize-level",
          "description": "Optimisation level to compile at",
          "type": "integer",
          "takesValue": true
        }
      ],
      "examples": [
        "scheme --compile-imported-libraries"
      ]
    },
    {
      "name": "--optimize-level 3",
      "description": "Set optimization level",
      "args": [
        {
          "name": "level",
          "description": "Optimisation level to use",
          "type": "integer",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--compile-imported-libraries",
          "description": "Compile imported libraries too",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "scheme --optimize-level 3"
      ]
    }
  ],
  "examples": [
    "scheme --script program.scm",
    "guile script.scm",
    "racket program.rkt",
    "mit-scheme --load program.scm",
    "chez-scheme --optimize-level 3 --program app.scm"
  ],
  "relatedCommands": [
    "clojure",
    "racket",
    "lua",
    "python"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Scheme interpreter version",
        "command": "scheme --version 2>/dev/null || guile --version 2>/dev/null | head -1 || chez --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "sources",
        "description": "Scheme sources",
        "command": "find . -maxdepth 3 -name '*.scm' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "guile_paths",
        "description": "Guile module search path",
        "command": "echo \"${GUILE_LOAD_PATH:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
