{
  "name": "free",
  "description": "Display amount of free and used memory",
  "category": "system",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-h",
      "description": "Human-readable output"
    },
    {
      "name": "-b",
      "description": "Output in bytes"
    },
    {
      "name": "-m",
      "description": "Output in mebibytes"
    },
    {
      "name": "-g",
      "description": "Output in gibibytes"
    },
    {
      "name": "-s",
      "description": "Repeat printing every N seconds",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Repeat N times then exit",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Show total for RAM + swap"
    },
    {
      "name": "-w",
      "description": "Wide output (separate buffers and cache)"
    },
    {
      "name": "--bytes",
      "description": "Show amounts in bytes",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--kibi",
      "description": "Show amounts in kibibytes",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--mebi",
      "description": "Show amounts in mebibytes",
      "type": "boolean",
      "takesValue": false,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--gibi",
      "description": "Show amounts in gibibytes",
      "type": "boolean",
      "takesValue": false,
      "short": "-g",
      "shorthand": "-g"
    },
    {
      "name": "--human",
      "description": "Print human-readable units",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--total",
      "description": "Add a total row",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--seconds",
      "description": "Refresh every N seconds",
      "type": "number",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--count",
      "description": "Refresh this many times then exit",
      "type": "integer",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--wide",
      "description": "Use a wider layout",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--si",
      "description": "Use powers of 1000",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--lohi",
      "description": "Show low and high memory statistics",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--committed",
      "description": "Show committed memory",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    "free -h",
    "free -m",
    "free -h -s 5",
    "free -tw",
    "free -g"
  ],
  "relatedCommands": [
    "top",
    "htop",
    "vmstat",
    "ps"
  ]
}
