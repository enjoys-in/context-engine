{
  "name": "ip",
  "description": "Show/manipulate routing, network devices, interfaces and tunnels",
  "category": "networking",
  "platforms": [
    "linux"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "addr",
      "description": "Protocol address management",
      "examples": [
        "ip addr show",
        "ip addr add 192.168.1.10/24 dev eth0",
        "ip addr del 192.168.1.10/24 dev eth0"
      ],
      "options": [
        {
          "name": "-4",
          "description": "Operate on IPv4 only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-6",
          "description": "Operate on IPv6 only",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-brief",
          "description": "One line per record",
          "type": "boolean",
          "takesValue": false,
          "short": "-br",
          "shorthand": "-br"
        },
        {
          "name": "-json",
          "description": "Emit JSON output",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "-statistics",
          "description": "Include counters",
          "type": "boolean",
          "takesValue": false,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "-details",
          "description": "Include driver-level detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-d",
          "shorthand": "-d"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Address operation, such as show, add, del or flush",
          "required": true,
          "type": "string"
        }
      ]
    },
