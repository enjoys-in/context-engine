  "globalOptions": [
    {
      "name": "-4",
      "description": "IPv4 only"
    },
    {
      "name": "-6",
      "description": "IPv6 only"
    },
    {
      "name": "-s",
      "description": "More information (statistics)"
    },
    {
      "name": "-c",
      "description": "Color output"
    },
    {
      "name": "-br",
      "description": "Brief output"
    },
    {
      "name": "-j",
      "description": "JSON output"
    },
    {
      "name": "--brief",
      "description": "Print a compact one-line-per-object listing",
      "type": "boolean",
      "takesValue": false,
      "short": "-br",
      "shorthand": "-br"
    },
    {
      "name": "--json",
      "description": "Emit JSON",
      "type": "boolean",
      "takesValue": false,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--pretty",
      "description": "Pretty-print the JSON",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--details",
      "description": "Include extra detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--statistics",
      "description": "Include statistics",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--family",
      "description": "Address family (inet, inet6, link)",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--oneline",
      "description": "Keep each record on one line",
      "type": "boolean",
      "takesValue": false,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--color",
      "description": "Colour the output",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--numeric",
      "description": "Print numbers instead of names",
      "type": "boolean",
      "takesValue": false,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--all",
      "description": "Apply the command to every object",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    }
  ],
  "examples": [
    "ip addr show",
    "ip -br addr",
    "ip route show",
    "ip link set eth0 up",
    "ip -s link",
    "ip -j addr show"
  ],
  "relatedCommands": [
    "ifconfig",
    "route",
    "netstat",
    "ss"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "iproute2 version",
        "command": "ip -V 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ip"
      },
      {
        "name": "interfaces",
        "description": "Network interfaces on this host",
        "command": "ip -brief address 2>/dev/null || ifconfig -l 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "routes",
        "description": "Routing table",
        "command": "ip route 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "ip"
      },
      {
        "name": "neighbours",
        "description": "ARP and neighbour table",
        "command": "ip neigh 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "ip"
      }
    ]
  }
}
