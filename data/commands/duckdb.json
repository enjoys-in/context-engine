{
  "name": "duckdb",
  "description": "In-process analytical SQL database",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--csv",
      "description": "Emit results as CSV",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--json",
      "description": "Emit results as JSON",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--markdown",
      "description": "Emit results as a Markdown table",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--box",
      "description": "Emit results in a box-drawing table",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--command",
      "description": "Run this SQL and exit",
      "type": "string",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--init",
      "description": "SQL file to run at startup",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--readonly",
      "description": "Open the database read-only",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--list",
      "description": "Emit results as delimited text",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--noheader",
      "description": "Omit the header row",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--separator",
      "description": "Column separator for list output",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--unsigned",
      "description": "Allow unsigned extensions",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--echo",
      "description": "Print statements as they run",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "duckdb",
      "description": "Start an in-memory session"
    },
    {
      "command": "duckdb data.db",
      "description": "Open a database file"
    },
    {
      "command": "duckdb -c \"SELECT * FROM read_csv_auto('x.csv') LIMIT 5\"",
      "description": "Query a CSV directly"
    },
    {
      "command": "duckdb --json -c \"SELECT 1 AS n\"",
      "description": "Emit JSON results"
    }
  ],
  "relatedCommands": [
    "sqlite3",
    "psql",
    "clickhouse-client",
    "sqlite-utils"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "DuckDB version",
        "command": "duckdb --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "duckdb"
      },
      {
        "name": "databases",
        "description": "DuckDB database files here",
        "command": "find . -maxdepth 2 -name '*.duckdb' -o -name '*.ddb' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "data_files",
        "description": "Data files DuckDB can query directly",
        "command": "find . -maxdepth 2 -name '*.parquet' -o -name '*.csv' -o -name '*.json' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
