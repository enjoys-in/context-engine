{
  "name": "erlang",
  "description": "Erlang runtime system and compiler (erl/erlc)",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-noshell",
      "description": "Start without shell"
    },
    {
      "name": "-eval",
      "description": "Evaluate expression",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Call module function on start",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-pa",
      "description": "Add code path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-name",
      "description": "Set long node name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-sname",
      "description": "Set short node name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-cookie",
      "description": "Set cookie for distributed Erlang",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-setcookie",
      "description": "Set magic cookie",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-remsh",
      "description": "Connect to remote shell",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "erl",
    "erl -noshell -eval 'io:format(\"hello~n\"), halt().'",
    "erlc module.erl",
    "erl -pa ebin/",
    "erl -sname mynode"
  ],
  "relatedCommands": [
    "rebar3",
    "mix",
    "elixir",
    "erl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Erlang/OTP release",
        "command": "erl -noshell -eval 'io:format(\"~s~n\",[erlang:system_info(otp_release)]),halt().' 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "erl"
      },
      {
        "name": "rebar_config",
        "description": "Rebar3 project configuration",
        "command": "cat rebar.config 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "beam_files",
        "description": "Compiled BEAM modules",
        "command": "find . -maxdepth 4 -name '*.beam' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "sources",
        "description": "Erlang sources",
        "command": "find . -maxdepth 3 -name '*.erl' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
