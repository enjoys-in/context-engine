{
  "name": "skopeo",
  "description": "skopeo — perform operations on container images and registries",
  "category": "containers",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "copy",
      "description": "Copy images between registries/transports",
      "examples": [
        "skopeo copy docker://docker.io/library/nginx:latest docker://my-registry.com/nginx:latest",
        "skopeo copy docker://registry.example.com/img:v1 dir:/tmp/img",
        "skopeo copy oci:./my-image:latest docker://registry.example.com/my-image:latest",
        "skopeo copy docker://src oci-archive:./archive.tar",
        "skopeo copy --all docker://src docker://dst"
      ],
      "options": [
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--all",
          "description": "Copy every image in the manifest list",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--format",
          "description": "Manifest format to write: oci, v2s1 or v2s2",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--sign-by",
          "description": "Sign the copied image with this key",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "source",
          "description": "Source image, as transport:reference",
          "required": true,
          "type": "string"
        },
        {
          "name": "destination",
          "description": "Destination image, as transport:reference",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect image metadata",
      "examples": [
        "skopeo inspect docker://docker.io/library/alpine:latest",
        "skopeo inspect --raw docker://docker.io/library/nginx:latest",
        "skopeo inspect --config docker://docker.io/library/node:18",
        "skopeo inspect dir:/tmp/img",
        "skopeo inspect oci:./my-image"
      ],
      "options": [
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--config",
          "description": "Show the image configuration",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw",
          "description": "Show the raw manifest",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image to inspect, as transport:reference",
          "required": true,
          "type": "image"
        }
      ]
    },
    {
      "name": "delete",
      "description": "Delete image from registry",
      "examples": [
        "skopeo delete docker://registry.example.com/my-image:old",
        "skopeo delete docker://my-registry.com/temp:latest"
      ],
      "options": [
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to read",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Image to delete, as transport:reference",
          "required": true,
          "type": "image"
        }
      ]
    },
    {
      "name": "list-tags",
      "description": "List tags for an image",
      "examples": [
        "skopeo list-tags docker://docker.io/library/nginx",
        "skopeo list-tags docker://registry.example.com/my-app",
        "skopeo list-tags docker://ghcr.io/my-org/my-app"
      ],
      "options": [
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to read",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "image",
          "description": "Repository to list tags for, as transport:reference",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "sync",
      "description": "Sync images",
      "examples": [
        "skopeo sync --src docker --dest dir docker.io/library/nginx /tmp/nginx-sync",
        "skopeo sync --src yaml --dest docker sync.yaml my-registry.com"
      ],
      "options": [
        {
          "name": "--tls-verify",
          "description": "Verify the registry TLS certificate",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--creds",
          "description": "Registry credentials as user:password",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to read",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--src",
          "description": "Source transport: docker, dir or yaml",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dest",
          "description": "Destination transport: docker or dir",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--scoped",
          "description": "Prefix the destination with the source registry",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "login",
      "description": "Login to registry",
      "examples": [
        "skopeo login registry.example.com",
        "skopeo login docker.io -u username -p password",
        "skopeo login --get-login registry.example.com"
      ],
      "options": [
        {
          "name": "--username",
          "description": "Registry username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--password",
          "description": "Registry password",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--password-stdin",
          "description": "Read the password from stdin",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to write",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "registry",
          "description": "Registry to authenticate against",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "logout",
      "description": "Logout from registry",
      "examples": [
        "skopeo logout registry.example.com",
        "skopeo logout --all"
      ],
      "options": [
        {
          "name": "--all",
          "description": "Log out of every registry",
          "type": "boolean",
          "takesValue": false,
          "short": "-a",
          "shorthand": "-a"
        },
        {
          "name": "--authfile",
          "description": "Registry auth file to update",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "registry",
          "description": "Registry to log out of",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "manifest-digest",
      "description": "Compute manifest digest",
      "examples": [
        "skopeo manifest-digest manifest.json"
      ],
      "options": [],
      "args": [
        {
          "name": "manifest",
          "description": "Manifest file to digest",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "standalone-sign",
      "description": "Sign image manifest",
      "examples": [
        "skopeo standalone-sign manifest.json registry.example.com/my-image key-fingerprint"
      ],
      "options": [],
      "args": [
        {
          "name": "manifest",
          "description": "Manifest to sign",
          "required": true,
          "type": "file"
        },
        {
          "name": "reference",
          "description": "Image reference being signed",
          "required": true,
          "type": "string"
        },
        {
          "name": "key",
          "description": "Key fingerprint to sign with",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "standalone-verify",
      "description": "Verify image signature",
      "examples": [
        "skopeo standalone-verify manifest.json registry.example.com/my-image key-fingerprint signature"
      ],
      "options": [],
      "args": [
        {
          "name": "manifest",
          "description": "Manifest to verify",
          "required": true,
          "type": "file"
        },
        {
          "name": "reference",
          "description": "Expected image reference",
          "required": true,
          "type": "string"
        },
        {
          "name": "key",
          "description": "Expected key fingerprint",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--override-os",
      "description": "Override OS",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--override-arch",
      "description": "Override architecture",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--insecure-policy",
      "description": "Allow insecure operations"
    },
    {
      "name": "--authfile",
      "description": "Auth file path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--tls-verify",
      "description": "Require HTTPS and verify certs",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Enable debug logging"
    },
    {
      "name": "--policy",
      "description": "Policy file",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--all",
      "short": "-a",
      "description": "Process all platforms",
      "shorthand": "-a"
    }
  ],
  "examples": [
    "skopeo copy docker://docker.io/library/nginx:latest docker://my-registry.com/nginx:latest",
    "skopeo inspect docker://docker.io/library/alpine:latest",
    "skopeo list-tags docker://docker.io/library/nginx",
    "skopeo delete docker://registry.example.com/my-image:old",
    "skopeo sync --src docker --dest dir docker.io/library/nginx /tmp/",
    "skopeo login registry.example.com",
    "skopeo copy --all docker://src docker://dst",
    "skopeo inspect --config docker://docker.io/library/node:18",
    "skopeo logout --all",
    "skopeo manifest-digest manifest.json"
  ],
  "relatedCommands": [
    "docker",
    "podman",
    "crane",
    "buildah",
    "crictl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Skopeo version",
        "command": "skopeo --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "skopeo"
      },
      {
        "name": "registry_auth",
        "description": "Registries with stored credentials",
        "command": "grep -o '\"[^\"]*\": *{' ~/.docker/config.json 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "policy",
        "description": "Skopeo signature policy",
        "command": "cat /etc/containers/policy.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 3600
      }
    ]
  }
}
