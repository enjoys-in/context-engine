{
  "language": "dotenv",
  "name": "dotenv",
  "description": "dotenv — environment variable management from .env files",
  "category": "tool",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--env-file",
      "description": "Specify path to .env file (default: .env)"
    },
    {
      "name": "--override",
      "description": "Override existing environment variables"
    },
    {
      "name": "--no-expand",
      "description": "Disable variable expansion"
    },
    {
      "name": "--debug",
      "description": "Enable debug output"
    },
    {
      "name": "--encoding",
      "description": "Specify file encoding (default: utf-8)"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    }
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a command with .env variables loaded",
      "args": [
        {
          "name": "command",
          "description": "Command to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--env-file",
          "description": "Path to the .env file to load",
          "type": "path",
          "takesValue": true
        }
      ],
      "examples": [
        "dotenv run command"
      ]
    },
    {
      "name": "list",
      "description": "List all variables in .env file",
      "args": [],
      "options": [
        {
          "name": "--env-file",
          "description": "Path to the .env file to load",
          "type": "path",
          "takesValue": true
        }
      ],
      "examples": [
        "dotenv list"
      ]
    },
    {
      "name": "set",
      "description": "Set a variable in .env file",
      "args": [
        {
          "name": "KEY=VALUE",
          "description": "Environment variable assignment",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--env-file",
          "description": "Env file to write to",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "dotenv set KEY=VALUE"
      ]
    },
    {
      "name": "get",
      "description": "Get a specific variable value",
      "args": [
        {
          "name": "KEY",
          "description": "Environment variable name",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--env-file",
          "description": "Env file to read from",
          "type": "file",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "dotenv get KEY"
      ]
    },
    {
      "name": "check",
      "description": "Validate .env file against .env.example",
      "args": [],
      "options": [
        {
          "name": "--strict",
          "description": "Fail if a referenced variable is missing",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "dotenv check"
      ]
    }
  ],
  "examples": [
    "dotenv run -- node server.js",
    "dotenv --env-file .env.production run -- npm start",
    "dotenv list",
    "dotenv set DATABASE_URL=postgres://localhost/mydb",
    "dotenv check --strict"
  ],
  "relatedCommands": [
    "env",
    "export",
    "direnv",
    "shell"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "dotenv CLI version",
        "command": "dotenv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "dotenv"
      },
      {
        "name": "env_files",
        "description": "Environment files in this project",
        "command": "ls -a 2>/dev/null | grep '^\\.env' | head -15",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "keys",
        "description": "Variable names declared in .env",
        "command": "grep -oE '^[A-Za-z_][A-Za-z0-9_]*' .env 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "gitignored",
        "description": "Whether .env is excluded from git",
        "command": "grep -c '^\\.env' .gitignore 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
