{
  "language": "scss",
  "name": "sass",
  "description": "Dart Sass — SCSS/Sass CSS preprocessor compiler",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--style",
      "description": "Output style: expanded (default) or compressed"
    },
    {
      "name": "--source-map",
      "description": "Generate source map (on by default)"
    },
    {
      "name": "--no-source-map",
      "description": "Disable source map generation"
    },
    {
      "name": "--watch",
      "description": "Watch for file changes and recompile"
    },
    {
      "name": "--load-path",
      "description": "Add import path for @use and @import resolution"
    },
    {
      "name": "--charset",
      "description": "Emit @charset or BOM for non-ASCII CSS"
    },
    {
      "name": "--update",
      "description": "Only compile changed stylesheets"
    },
    {
      "name": "--quiet",
      "description": "Suppress warning messages"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    }
  ],
  "subcommands": [
    {
      "name": "input.scss output.css",
      "description": "Compile SCSS to CSS",
      "args": [
        {
          "name": "input",
          "description": "Sass stylesheet to compile",
          "type": "file",
          "required": true
        },
        {
          "name": "output",
          "description": "Path to write the CSS to",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--style",
          "description": "Output style: expanded or compressed",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--load-path",
          "description": "Additional import search path",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-source-map",
          "description": "Do not emit a source map",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Recompile on file changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "--watch input.scss:output.css",
      "description": "Watch for changes and recompile",
      "args": [
        {
          "name": "mapping",
          "description": "Input-to-output mapping",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--style",
          "description": "Output style: expanded or compressed",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--load-path",
          "description": "Additional import search path",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-source-map",
          "description": "Do not emit a source map",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Recompile on file changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "--style compressed input.scss",
      "description": "Compile with minified/compressed output",
      "args": [
        {
          "name": "file",
          "description": "Sass stylesheet to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--style",
          "description": "Output style: expanded or compressed",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--load-path",
          "description": "Additional import search path",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-source-map",
          "description": "Do not emit a source map",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Recompile on file changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "--update src/:dist/",
      "description": "Compile only changed files",
      "args": [
        {
          "name": "dirs",
          "description": "Input and output directory mapping",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--style",
          "description": "Output style: expanded or compressed",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--load-path",
          "description": "Additional import search path",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-source-map",
          "description": "Do not emit a source map",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Recompile on file changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    },
    {
      "name": "--source-map input.scss output.css",
      "description": "Compile with source map for debugging",
      "args": [
        {
          "name": "input",
          "description": "Sass stylesheet to compile",
          "type": "file",
          "required": true
        },
        {
          "name": "output",
          "description": "Path to write the CSS to",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--style",
          "description": "Output style: expanded or compressed",
          "type": "string",
          "takesValue": true,
          "short": "-s",
          "shorthand": "-s"
        },
        {
          "name": "--load-path",
          "description": "Additional import search path",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        },
        {
          "name": "--no-source-map",
          "description": "Do not emit a source map",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Recompile on file changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        }
      ]
    }
  ],
  "examples": [
    "sass src/styles.scss dist/styles.css",
    "sass --watch src/:dist/ --style compressed",
    "sass --style compressed input.scss output.min.css",
    "sass --load-path=node_modules/ src/main.scss dist/main.css",
    "npx sass src/theme.scss dist/theme.css --no-source-map"
  ],
  "relatedCommands": [
    "less",
    "css",
    "postcss",
    "tailwindcss"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Sass compiler version",
        "command": "sass --version 2>/dev/null || npx sass --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "stylesheets",
        "description": "Sass stylesheets in this project",
        "command": "find . -maxdepth 3 -name '*.scss' -o -maxdepth 3 -name '*.sass' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "partials",
        "description": "Sass partials available for import",
        "command": "find . -maxdepth 3 -name '_*.scss' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
