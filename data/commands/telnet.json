{
  "name": "telnet",
  "description": "User interface to the TELNET protocol, and a plain TCP probe",
  "category": "network",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "-4",
      "description": "Use IPv4 only",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-6",
      "description": "Use IPv6 only",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-a",
      "description": "Attempt automatic login",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-l",
      "description": "User to log in as",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-e",
      "description": "Escape character to use",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-n",
      "description": "Record the session trace here",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Enable debugging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-E",
      "description": "Disable the escape character",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "telnet example.com 80",
      "description": "Open a raw TCP connection to a port"
    },
    {
      "command": "telnet localhost 25",
      "description": "Probe an SMTP server"
    },
    {
      "command": "telnet -l admin router.local",
      "description": "Log in with a username"
    }
  ],
  "relatedCommands": [
    "nc",
    "ssh",
    "curl",
    "socat"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "telnet client version",
        "command": "telnet --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "telnet"
      },
      {
        "name": "listening",
        "description": "Ports listening on this host",
        "command": "ss -tlnp 2>/dev/null | head -20 || netstat -an 2>/dev/null | grep LISTEN | head -20",
        "parser": "table",
        "cacheFor": 30
      }
    ]
  }
}
