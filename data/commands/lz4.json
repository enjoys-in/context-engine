{
  "name": "lz4",
  "description": "Extremely fast compression (.lz4)",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--decompress",
      "description": "Expand instead of compress",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--best",
      "description": "Use the highest compression level",
      "type": "boolean",
      "takesValue": false,
      "short": "-9",
      "shorthand": "-9"
    },
    {
      "name": "--multithread",
      "description": "Use multiple threads",
      "type": "boolean",
      "takesValue": false,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--verbose",
      "description": "Report progress",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "lz4 -9 backup.tar",
      "description": "Compress at the highest level"
    },
    {
      "command": "lz4 -d backup.tar.lz4",
      "description": "Expand an archive"
    },
    {
      "command": "lz4 -t backup.tar.lz4",
      "description": "Verify integrity"
    }
  ],
  "relatedCommands": [
    "zstd",
    "gzip",
    "tar"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "LZ4 version",
        "command": "lz4 --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "lz4"
      },
      {
        "name": "archives",
        "description": "LZ4 archives in this directory",
        "command": "find . -maxdepth 2 -name '*.lz4' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
