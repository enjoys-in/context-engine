{
  "name": "nix-shell",
  "description": "Enter an environment with specified Nix packages available",
  "category": "package-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--packages",
      "description": "Packages to make available",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--run",
      "description": "Run this command instead of a shell",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--pure",
      "description": "Clear the inherited environment",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--attr",
      "description": "Attribute to build the shell from",
      "type": "string",
      "takesValue": true,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--file",
      "description": "Nix expression to read",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--arg",
      "description": "Pass an argument to the expression",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--argstr",
      "description": "Pass a string argument to the expression",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--command",
      "description": "Run this command then stay interactive",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--keep",
      "description": "Keep this environment variable when pure",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "nix-shell -p ripgrep fd",
      "description": "Enter a shell with two packages"
    },
    {
      "command": "nix-shell --pure",
      "description": "Enter the project shell with a clean environment"
    },
    {
      "command": "nix-shell -p python3 --run \"python -V\"",
      "description": "Run one command in a temporary shell"
    },
    {
      "command": "nix-shell shell.nix",
      "description": "Use a shell expression file"
    }
  ],
  "relatedCommands": [
    "nix",
    "nix-env",
    "direnv",
    "mise"
  ]
}
