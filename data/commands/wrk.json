{
  "name": "wrk",
  "description": "Modern HTTP benchmarking tool",
  "category": "http-testing",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-t",
      "description": "Number of threads",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-c",
      "description": "Number of connections",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-d",
      "description": "Duration (e.g. 30s, 2m)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-s",
      "description": "Lua script file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-H",
      "description": "Custom header",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--latency",
      "description": "Print latency statistics"
    },
    {
      "name": "--timeout",
      "description": "Socket/request timeout",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "wrk -t4 -c100 -d30s http://localhost:8080/",
    "wrk -t2 -c50 -d10s --latency http://localhost:3000/",
    "wrk -t8 -c200 -d60s -H 'Authorization: Bearer token' http://api.example.com/",
    "wrk -t4 -c100 -d30s -s post.lua http://localhost:8080/api"
  ],
  "relatedCommands": [
    "ab",
    "hey",
    "vegeta",
    "siege"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "wrk version",
        "command": "wrk --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "wrk"
      },
      {
        "name": "scripts",
        "description": "Lua scripts wrk can load",
        "command": "find . -maxdepth 2 -name '*.lua' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "cpu_count",
        "description": "Logical CPUs available for load generation",
        "command": "nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "open_files",
        "description": "File descriptor limit that caps connections",
        "command": "ulimit -n 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
