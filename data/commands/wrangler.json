{
  "name": "wrangler",
  "description": "Cloudflare Wrangler CLI — build and deploy Cloudflare Workers",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a Worker project",
      "examples": [
        "wrangler init",
        "wrangler init my-worker",
        "wrangler init my-worker --type typescript"
      ],
      "options": [
        {
          "name": "--yes",
          "description": "Accept the defaults",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        },
        {
          "name": "--from-dash",
          "description": "Import an existing Worker",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--type",
          "description": "Template type",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "dev",
      "description": "Start local dev server",
      "examples": [
        "wrangler dev",
        "wrangler dev --local",
        "wrangler dev --port 8787",
        "wrangler dev src/index.ts"
      ],
      "options": [
        {
          "name": "--port",
          "description": "Local port",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--local",
          "description": "Run entirely locally",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--remote",
          "description": "Run against Cloudflare infrastructure",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--var",
          "description": "Binding override, key=value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--inspect",
          "description": "Enable the devtools inspector",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy Worker",
      "examples": [
        "wrangler deploy",
        "wrangler deploy --dry-run",
        "wrangler deploy --env staging",
        "wrangler deploy --minify"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to deploy",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--name",
          "description": "Worker name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--compatibility-date",
          "description": "Compatibility date",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--minify",
          "description": "Minify the bundle",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dry-run",
          "description": "Build without uploading",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "publish",
      "description": "Publish Worker (alias for deploy)",
      "examples": [
        "wrangler publish"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to publish",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--dry-run",
          "description": "Build without uploading",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "tail",
      "description": "Tail Worker logs",
      "examples": [
        "wrangler tail",
        "wrangler tail my-worker",
        "wrangler tail --format json"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to tail",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--format",
          "description": "Output format (json, pretty)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--status",
          "description": "Only these outcomes",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--method",
          "description": "Only these HTTP methods",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--search",
          "description": "Only messages containing this",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "secret",
      "description": "Manage Worker secrets",
      "examples": [
        "wrangler secret put MY_SECRET",
        "wrangler secret list",
        "wrangler secret delete MY_SECRET"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to modify",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--name",
          "description": "Worker name",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "kv:namespace",
      "description": "Manage KV namespaces",
      "examples": [
        "wrangler kv:namespace list",
        "wrangler kv:namespace create MY_KV",
        "wrangler kv:namespace delete --namespace-id xxx"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--preview",
          "description": "Operate on the preview namespace",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "kv:key",
      "description": "Manage KV keys",
      "examples": [
        "wrangler kv:key list --namespace-id xxx",
        "wrangler kv:key put --namespace-id xxx my-key my-value",
        "wrangler kv:key get --namespace-id xxx my-key",
        "wrangler kv:key delete --namespace-id xxx my-key"
      ],
      "options": [
        {
          "name": "--binding",
          "description": "KV binding name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namespace-id",
          "description": "Namespace id",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--preview",
          "description": "Use the preview namespace",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--text",
          "description": "Treat the value as text",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "kv:bulk",
      "description": "Bulk KV operations",
      "examples": [
        "wrangler kv:bulk put --namespace-id xxx data.json",
        "wrangler kv:bulk delete --namespace-id xxx keys.json"
      ],
      "options": [
        {
          "name": "--binding",
          "description": "KV binding name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namespace-id",
          "description": "Namespace id",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "r2",
      "description": "Manage R2 storage",
      "examples": [
        "wrangler r2 bucket list",
        "wrangler r2 bucket create my-bucket",
        "wrangler r2 bucket delete my-bucket",
        "wrangler r2 object get my-bucket/key",
        "wrangler r2 object put my-bucket/key --file ./file.txt"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "d1",
      "description": "Manage D1 databases",
      "examples": [
        "wrangler d1 list",
        "wrangler d1 create my-db",
        "wrangler d1 execute my-db --command 'SELECT * FROM users'",
        "wrangler d1 execute my-db --file schema.sql",
        "wrangler d1 migrations create my-db create-users",
        "wrangler d1 migrations apply my-db"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--local",
          "description": "Operate on the local database",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--command",
          "description": "SQL to execute",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "pages",
      "description": "Manage Cloudflare Pages",
      "examples": [
        "wrangler pages project list",
        "wrangler pages project create my-project",
        "wrangler pages deploy ./dist",
        "wrangler pages deployment list --project-name my-project"
      ],
      "options": [
        {
          "name": "--project-name",
          "description": "Pages project",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--branch",
          "description": "Branch to deploy as",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "queues",
      "description": "Manage Queues",
      "examples": [
        "wrangler queues list",
        "wrangler queues create my-queue",
        "wrangler queues delete my-queue"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment to use",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "login",
      "description": "Login to Cloudflare",
      "examples": [
        "wrangler login"
      ],
      "options": [
        {
          "name": "--scopes",
          "description": "OAuth scopes to request",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--browser",
          "description": "Open a browser",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "whoami",
      "description": "Show authenticated user",
      "examples": [
        "wrangler whoami"
      ],
      "options": []
    },
    {
      "name": "types",
      "description": "Generate TypeScript types",
      "examples": [
        "wrangler types"
      ],
      "options": [
        {
          "name": "--env-interface",
          "description": "Name for the generated Env interface",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "generate",
      "description": "Generate a Worker from template",
      "examples": [
        "wrangler generate my-worker https://github.com/cloudflare/worker-template"
      ],
      "options": []
    },
    {
      "name": "vectorize",
      "description": "Manage Vectorize indexes",
      "examples": [
        "wrangler vectorize create my-index --dimensions 768 --metric cosine",
        "wrangler vectorize list",
        "wrangler vectorize delete my-index"
      ],
      "options": [
        {
          "name": "--dimensions",
          "description": "Vector dimensions",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--metric",
          "description": "Distance metric",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ai",
      "description": "Manage Workers AI",
      "examples": [
        "wrangler ai models list"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Wrangler config file to read",
          "type": "file",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--config",
      "short": "-c",
      "description": "Config file path",
      "type": "string",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--env",
      "short": "-e",
      "description": "Environment",
      "type": "string",
      "takesValue": true,
      "shorthand": "-e"
    },
    {
      "name": "--compatibility-date",
      "description": "Compatibility date",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "wrangler init my-worker",
    "wrangler dev",
    "wrangler deploy",
    "wrangler tail",
    "wrangler secret put MY_SECRET",
    "wrangler kv:namespace create MY_KV",
    "wrangler r2 bucket list",
    "wrangler d1 create my-db",
    "wrangler d1 execute my-db --file schema.sql",
    "wrangler pages deploy ./dist",
    "wrangler login",
    "wrangler whoami"
  ],
  "relatedCommands": [
    "cloudflared",
    "netlify",
    "vercel",
    "firebase"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Wrangler version",
        "command": "wrangler --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "wrangler"
      },
      {
        "name": "config",
        "description": "Worker configuration",
        "command": "cat wrangler.toml 2>/dev/null || cat wrangler.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "account",
        "description": "Authenticated Cloudflare account",
        "command": "wrangler whoami 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "wrangler"
      },
      {
        "name": "bindings",
        "description": "Bindings declared for this Worker",
        "command": "grep -E '^\\[\\[?(kv_namespaces|d1_databases|r2_buckets|durable_objects)' wrangler.toml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
