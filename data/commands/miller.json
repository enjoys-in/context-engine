{
  "name": "miller",
  "description": "Like awk, sed, cut, join for name-indexed data (CSV, JSON, etc.)",
  "category": "data",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--csv",
      "description": "CSV input/output"
    },
    {
      "name": "--json",
      "description": "JSON input/output"
    },
    {
      "name": "--tsv",
      "description": "TSV input/output"
    },
    {
      "name": "--icsv",
      "description": "CSV input"
    },
    {
      "name": "--ojson",
      "description": "JSON output"
    },
    {
      "name": "--from",
      "description": "Input file",
      "type": "file",
      "takesValue": true
    }
  ],
  "examples": [
    "mlr --csv head -n 10 data.csv",
    "mlr --csv filter '$age > 30' data.csv",
    "mlr --csv sort-by name data.csv",
    "mlr --csv stats1 -a mean -f salary data.csv",
    "mlr --icsv --ojson cat data.csv",
    "mlr --csv cut -f name,age data.csv"
  ],
  "relatedCommands": [
    "csvkit",
    "xsv",
    "jq",
    "awk"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Miller version",
        "command": "mlr --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "mlr"
      },
      {
        "name": "data_files",
        "description": "Structured data files Miller can process",
        "command": "find . -maxdepth 2 -name '*.csv' -o -name '*.tsv' -o -name '*.json' -o -name '*.jsonl' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "config",
        "description": "Miller default flags",
        "command": "cat ~/.mlrrc 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
