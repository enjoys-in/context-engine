{
  "name": "zig",
  "description": "Zig programming language compiler and build system",
  "category": "language",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build project using build.zig",
      "examples": [
        "zig build",
        "zig build -Drelease"
      ],
      "options": [
        {
          "name": "--release",
          "description": "Optimisation mode: safe, fast or small",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--prefix",
          "description": "Installation prefix",
          "type": "directory",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--summary",
          "description": "Build summary detail to print",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--verbose",
          "description": "Print the commands being run",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--build-file",
          "description": "build.zig file to use",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "build-exe",
      "description": "Compile executable",
      "examples": [
        "zig build-exe src/main.zig"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Name for the output binary",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--optimize",
          "description": "Optimisation mode",
          "type": "string",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        },
        {
          "name": "--target",
          "description": "Target triple to build for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--library",
          "description": "Link against this system library",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--strip",
          "description": "Strip debug symbols",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Zig source file to compile into an executable",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "build-lib",
      "description": "Compile library",
      "examples": [
        "zig build-lib src/lib.zig"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Name for the output library",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dynamic",
          "description": "Build a shared rather than static library",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--optimize",
          "description": "Optimisation mode",
          "type": "string",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        },
        {
          "name": "--target",
          "description": "Target triple to build for",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Zig source file to compile into a library",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "run",
      "description": "Build and run",
      "examples": [
        "zig run src/main.zig"
      ],
      "options": [
        {
          "name": "--optimize",
          "description": "Optimisation mode",
          "type": "string",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        },
        {
          "name": "--target",
          "description": "Target triple to build for",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Zig source file to run",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "zig test src/main.zig"
      ],
      "options": [
        {
          "name": "--test-filter",
          "description": "Only run tests whose name matches",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--optimize",
          "description": "Optimisation mode",
          "type": "string",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        },
        {
          "name": "--test-no-exec",
          "description": "Compile the tests without running them",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "Zig source file whose tests to run",
          "required": true,
          "type": "file"
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize new project",
      "examples": [
        "zig init"
      ],
      "options": [
        {
          "name": "--minimal",
          "description": "Write a minimal build script",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "fetch",
      "description": "Fetch Zig package",
      "examples": [
        "zig fetch --save url"
      ],
      "options": [
        {
          "name": "--save",
          "description": "Record the dependency in build.zig.zon",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "fmt",
      "description": "Format source files",
      "examples": [
        "zig fmt src/"
      ],
      "options": [
        {
          "name": "--check",
          "description": "Fail rather than rewriting files",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--stdin",
          "description": "Format standard input",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ast-check",
          "description": "Only check for syntax errors",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "paths",
          "description": "Files or directories to format",
          "required": false,
          "type": "path"
        }
      ]
    },
    {
      "name": "cc",
      "description": "Use Zig as C/C++ compiler",
      "examples": [
        "zig cc -o hello hello.c"
      ],
      "options": [
        {
          "name": "--target",
          "description": "Target triple to compile for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--optimize",
          "description": "Optimisation mode",
          "type": "string",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        }
      ]
    },
    {
      "name": "translate-c",
      "description": "Translate C to Zig",
      "examples": [
        "zig translate-c header.h"
      ],
      "options": [
        {
          "name": "--target",
          "description": "Target triple to translate for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--include",
          "description": "Additional include directory",
          "type": "directory",
          "takesValue": true,
          "short": "-I",
          "shorthand": "-I"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "C header or source to translate",
          "required": true,
          "type": "file"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "-target",
      "description": "Cross-compilation target",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-O",
      "description": "Optimization mode (Debug, ReleaseSafe, ReleaseFast, ReleaseSmall)",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "zig build",
    "zig run src/main.zig",
    "zig test src/main.zig",
    "zig fmt src/",
    "zig cc -o hello hello.c"
  ],
  "relatedCommands": [
    "gcc",
    "clang",
    "rust",
    "cmake"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Zig version",
        "command": "zig version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "zig"
      },
      {
        "name": "targets",
        "description": "Zig native target",
        "command": "zig targets 2>/dev/null | head -20",
        "parser": "json",
        "cacheFor": 3600,
        "requiresCmd": "zig"
      },
      {
        "name": "build",
        "description": "Zig build script",
        "command": "cat build.zig 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "sources",
        "description": "Zig sources",
        "command": "find . -maxdepth 3 -name '*.zig' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
