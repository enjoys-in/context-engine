{
  "name": "stern",
  "description": "Multi pod and container log tailing for Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "(none — use directly)",
      "description": "Tail logs matching a pod query",
      "examples": [
        "stern my-app",
        "stern my-app -n production",
        "stern my-app --since 1h",
        "stern 'web-.*'",
        "stern my-app -c sidecar",
        "stern my-app --exclude 'health'",
        "stern my-app --tail 50",
        "stern . -n my-namespace",
        "stern my-app -o json",
        "stern my-app --template '{{.PodName}} {{.Message}}'"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--all-namespaces",
      "short": "-A",
      "description": "All namespaces",
      "shorthand": "-A"
    },
    {
      "name": "--container",
      "short": "-c",
      "description": "Container name filter",
      "type": "string",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--since",
      "short": "-s",
      "description": "Duration to start from",
      "type": "string",
      "takesValue": true,
      "shorthand": "-s"
    },
    {
      "name": "--tail",
      "description": "Number of initial lines",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "short": "-e",
      "description": "Exclude log lines matching regex",
      "type": "string",
      "takesValue": true,
      "shorthand": "-e"
    },
    {
      "name": "--include",
      "short": "-i",
      "description": "Include only lines matching regex",
      "type": "string",
      "takesValue": true,
      "shorthand": "-i"
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output format (default, json, raw)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--template",
      "short": "-t",
      "description": "Go template for output",
      "type": "string",
      "takesValue": true,
      "shorthand": "-t"
    },
    {
      "name": "--selector",
      "short": "-l",
      "description": "Label selector",
      "type": "string",
      "takesValue": true,
      "shorthand": "-l"
    },
    {
      "name": "--timestamps",
      "description": "Show timestamps"
    },
    {
      "name": "--color",
      "description": "Force color (auto, always, never)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--context",
      "description": "Kubernetes context name",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "stern my-app",
    "stern my-app -n production",
    "stern 'web-.*' --since 1h",
    "stern my-app -c main --tail 100",
    "stern my-app --exclude 'healthcheck'",
    "stern . -A",
    "stern my-app -o json",
    "stern my-app -l app=web"
  ],
  "relatedCommands": [
    "kubectl",
    "k9s",
    "kubetail",
    "lnav"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "stern version",
        "command": "stern --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "stern"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "pods",
        "description": "Pods stern can tail in the active namespace",
        "command": "kubectl get pods -o name 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "kubectl"
      }
    ]
  }
}
