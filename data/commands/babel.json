{
  "name": "babel",
  "description": "JavaScript compiler — transform modern JS to compatible versions",
  "category": "build-tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--out-dir",
      "short": "-d",
      "description": "Output directory",
      "type": "string",
      "takesValue": true,
      "shorthand": "-d"
    },
    {
      "name": "--out-file",
      "short": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true,
      "shorthand": "-o"
    },
    {
      "name": "--watch",
      "short": "-w",
      "description": "Watch for changes",
      "shorthand": "-w"
    },
    {
      "name": "--source-maps",
      "short": "-s",
      "description": "Generate source maps",
      "shorthand": "-s"
    },
    {
      "name": "--presets",
      "description": "Comma-separated presets",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--plugins",
      "description": "Comma-separated plugins",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config-file",
      "description": "Path to config",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--extensions",
      "description": "File extensions to compile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ignore",
      "description": "Glob patterns to skip",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--copy-files",
      "description": "Copy non-compilable files"
    }
  ],
  "examples": [
    "babel src -d dist",
    "babel src/index.js -o dist/index.js",
    "babel src -d dist -w",
    "babel src -d dist --presets @babel/preset-env",
    "babel src -d dist --copy-files -s"
  ],
  "relatedCommands": [
    "swc",
    "esbuild",
    "tsc",
    "webpack"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Babel version",
        "command": "babel --version 2>/dev/null || npx babel --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Babel configuration",
        "command": "cat babel.config.js 2>/dev/null || cat .babelrc 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "presets",
        "description": "Babel presets declared",
        "command": "grep -oE '\"@babel/preset[^\"]*\"' babel.config.js .babelrc package.json 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "package_json",
        "description": "Project package manifest",
        "command": "cat package.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
