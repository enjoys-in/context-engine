{
  "name": "exiftool",
  "description": "Read, write and edit metadata in images, audio and video",
  "category": "media",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-all=",
      "description": "Strip every metadata tag",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-overwrite_original",
      "description": "Edit in place without a backup",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-recurse",
      "description": "Descend into directories",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "-ext",
      "description": "Only process this extension",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-json",
      "description": "Emit metadata as JSON",
      "type": "boolean",
      "takesValue": false,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "-csv",
      "description": "Emit metadata as CSV",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "-tagsFromFile",
      "description": "Copy tags from this file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-GPSLatitude",
      "description": "Read or set the GPS latitude",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-DateTimeOriginal",
      "description": "Read or set the capture time",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-filename",
      "description": "Rename using a tag template",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-if",
      "description": "Only process files matching this condition",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-quiet",
      "description": "Suppress progress output",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    }
  ],
  "examples": [
    {
      "command": "exiftool photo.jpg",
      "description": "Show every tag"
    },
    {
      "command": "exiftool -all= -overwrite_original photo.jpg",
      "description": "Strip all metadata in place"
    },
    {
      "command": "exiftool -j -r ./photos > meta.json",
      "description": "Export a directory as JSON"
    },
    {
      "command": "exiftool \"-filename<DateTimeOriginal\" -d \"%Y%m%d_%H%M%S.%%e\" .",
      "description": "Rename files by capture time"
    }
  ],
  "relatedCommands": [
    "imagemagick",
    "ffmpeg",
    "jpegoptim",
    "optipng"
  ]
}
