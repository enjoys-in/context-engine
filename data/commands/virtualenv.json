{
  "name": "virtualenv",
  "description": "Create isolated Python environments",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--python",
      "description": "Interpreter to base the environment on",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--system-site-packages",
      "description": "Give the environment access to system packages",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--clear",
      "description": "Delete the directory contents before creating",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--prompt",
      "description": "Prompt prefix for the activated environment",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-pip",
      "description": "Do not install pip",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-setuptools",
      "description": "Do not install setuptools",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-wheel",
      "description": "Do not install wheel",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--seeder",
      "description": "How to install the seed packages (app-data, pip)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--download",
      "description": "Download the latest seed packages",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "virtualenv .venv",
      "description": "Create an environment in .venv"
    },
    {
      "command": "virtualenv -p python3.12 .venv",
      "description": "Create it from a specific interpreter"
    },
    {
      "command": "virtualenv --system-site-packages .venv",
      "description": "Allow access to system packages"
    }
  ],
  "relatedCommands": [
    "uv",
    "python",
    "pyenv",
    "conda"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "virtualenv version",
        "command": "virtualenv --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "virtualenv"
      },
      {
        "name": "virtualenv",
        "description": "Active Python virtual environment",
        "command": "echo \"${VIRTUAL_ENV:-none}\"",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "local_envs",
        "description": "Virtual environments in this directory",
        "command": "ls -d .venv venv env 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "python_version",
        "description": "Python interpreter version",
        "command": "python3 --version 2>&1 || python --version 2>&1",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
