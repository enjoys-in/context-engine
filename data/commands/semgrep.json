{
  "name": "semgrep",
  "description": "Lightweight static analysis for finding bugs and enforcing code standards",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "scan",
      "description": "Scan code",
      "examples": [
        "semgrep scan",
        "semgrep scan --config auto"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Rule config or registry ruleset to run",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--severity",
          "description": "Minimum severity to report",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--exclude",
          "description": "Paths to skip",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--autofix",
          "description": "Apply fixes that rules provide",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ci",
      "description": "Run in CI mode",
      "examples": [
        "semgrep ci"
      ],
      "options": [
        {
          "name": "--config",
          "description": "Rule config or registry ruleset to run",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--json",
          "description": "Emit raw JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--baseline-commit",
          "description": "Only report findings newer than this commit",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "login",
      "description": "Login to Semgrep Cloud",
      "examples": [
        "semgrep login"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--config",
      "description": "Rule configuration (auto, p/default, file)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--lang",
      "description": "Target language",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--json",
      "description": "JSON output"
    },
    {
      "name": "--sarif",
      "description": "SARIF output"
    },
    {
      "name": "--severity",
      "description": "Filter by severity",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Exclude paths",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--include",
      "description": "Include paths",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--autofix",
      "description": "Apply autofixes"
    },
    {
      "name": "-e",
      "description": "Pattern to search for",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "semgrep scan --config auto",
    "semgrep scan --config p/owasp-top-ten",
    "semgrep scan --config p/typescript",
    "semgrep ci",
    "semgrep scan -e '$X == $X' --lang python"
  ],
  "relatedCommands": [
    "eslint",
    "sonar",
    "codeql",
    "bandit"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Semgrep version",
        "command": "semgrep --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "semgrep"
      },
      {
        "name": "config",
        "description": "Semgrep rule configuration",
        "command": "cat .semgrep.yml 2>/dev/null || ls .semgrep 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "rules",
        "description": "Custom Semgrep rules in this project",
        "command": "find . -maxdepth 3 -name '*.semgrep.yml' -o -path '*/.semgrep/*.yml' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "ignore",
        "description": "Paths Semgrep excludes",
        "command": "cat .semgrepignore 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
