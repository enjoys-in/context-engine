{
  "name": "kube-score",
  "description": "Kubernetes object analysis with recommendations for improved reliability and security",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "score",
      "description": "Score Kubernetes manifests",
      "examples": [
        "kube-score score manifest.yaml",
        "kube-score score deployment.yaml service.yaml",
        "kube-score score *.yaml",
        "kube-score score - < manifest.yaml",
        "cat manifest.yaml | kube-score score -",
        "helm template my-release my-chart | kube-score score -",
        "kube-score score --output-format ci manifest.yaml"
      ],
      "options": [
        {
          "name": "--output-format",
          "description": "Output format: human, ci, json or sarif",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--ignore-test",
          "description": "Test to skip",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--enable-optional-test",
          "description": "Optional test to enable",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "list",
      "description": "List available checks",
      "examples": [
        "kube-score list"
      ],
      "options": []
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "kube-score version"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--output-format",
      "description": "Output format (human, ci, json, sarif)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output-version",
      "description": "Output schema version (v2)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--ignore-test",
      "description": "Ignore specific test",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--enable-optional-test",
      "description": "Enable optional test",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--kubernetes-version",
      "description": "Target Kubernetes version",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "kube-score score manifest.yaml",
    "kube-score score *.yaml",
    "helm template my-chart | kube-score score -",
    "kube-score score --output-format ci manifest.yaml",
    "kube-score score --output-format json manifest.yaml",
    "kube-score list"
  ],
  "relatedCommands": [
    "kubectl",
    "kubeconform",
    "popeye",
    "trivy"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "kube-score version",
        "command": "kube-score version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "kube-score"
      },
      {
        "name": "manifests",
        "description": "Kubernetes manifests kube-score can check",
        "command": "grep -rl '^kind:' --include='*.yaml' --include='*.yml' . 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "helm_charts",
        "description": "Helm charts present",
        "command": "find . -maxdepth 3 -name 'Chart.yaml' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
