{
  "name": "mypy",
  "description": "Optional static type checker for Python",
  "category": "python-tooling",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--strict",
      "description": "Enable all optional strictness flags",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--ignore-missing-imports",
      "description": "Do not error on unresolvable imports",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--disallow-untyped-defs",
      "description": "Report functions without annotations",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--check-untyped-defs",
      "description": "Type-check bodies of unannotated functions",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--follow-imports",
      "description": "How to handle imports (normal, silent, skip, error)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--python-version",
      "description": "Python version to check against",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--config-file",
      "description": "Path to the configuration file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--cache-dir",
      "description": "Directory for the incremental cache",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--no-incremental",
      "description": "Disable the incremental cache",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--show-error-codes",
      "description": "Append the error code to each message",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--pretty",
      "description": "Use a formatted, coloured report",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--install-types",
      "description": "Install missing stub packages",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "mypy src/",
      "description": "Type-check a package"
    },
    {
      "command": "mypy --strict src/",
      "description": "Type-check with every strictness flag"
    },
    {
      "command": "mypy --install-types",
      "description": "Install the stub packages mypy asks for"
    }
  ],
  "relatedCommands": [
    "ruff",
    "pyright",
    "pytype",
    "python"
  ]
}
