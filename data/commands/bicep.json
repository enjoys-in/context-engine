{
  "language": "bicep",
  "name": "az bicep",
  "description": "Bicep command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    },
    {
      "name": "--env",
      "description": "Set environment (development, staging, production)",
      "valueHint": "name"
    },
    {
      "name": "--timeout",
      "description": "Set operation timeout in seconds",
      "valueHint": "seconds"
    },
    {
      "name": "--parallel",
      "description": "Run operations in parallel where possible"
    }
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build a Bicep file",
      "args": [],
      "options": [
        {
          "name": "--outfile",
          "description": "Write the ARM template here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--outdir",
          "description": "Directory to write the template to",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--stdout",
          "description": "Write the template to stdout",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-restore",
          "description": "Skip restoring external modules",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "az bicep build"
      ]
    },
    {
      "name": "decompile",
      "description": "Decompile ARM template to Bicep",
      "args": [],
      "options": [
        {
          "name": "--outfile",
          "description": "Write the Bicep file here",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--outdir",
          "description": "Directory to write the Bicep file to",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Overwrite an existing file",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "az bicep decompile"
      ]
    },
    {
      "name": "install",
      "description": "Install Bicep CLI",
      "args": [],
      "options": [
        {
          "name": "--target-platform",
          "description": "Platform to install the Bicep CLI for",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--version",
          "description": "Version to install",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "az bicep install"
      ]
    },
    {
      "name": "upgrade",
      "description": "Upgrade Bicep CLI",
      "args": [],
      "options": [],
      "examples": [
        "az bicep upgrade"
      ]
    },
    {
      "name": "publish",
      "description": "Publish a Bicep file to a registry",
      "args": [
        {
          "name": "file",
          "description": "Bicep file to publish",
          "required": true,
          "type": "file"
        }
      ],
      "options": [
        {
          "name": "--target",
          "description": "Registry reference to publish to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--documentation-uri",
          "description": "Documentation URI to record",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Overwrite an existing module version",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "az bicep publish file.txt"
      ]
    }
  ],
  "examples": [
    {
      "command": "az bicep build --file main.bicep",
      "description": "Build Bicep file to ARM template"
    },
    {
      "command": "az bicep decompile --file template.json",
      "description": "Decompile ARM template to Bicep"
    },
    {
      "command": "az deployment group create --template-file main.bicep --resource-group myRG",
      "description": "Deploy a Bicep template"
    },
    {
      "command": "az bicep lint --file main.bicep",
      "description": "Lint a Bicep file"
    }
  ],
  "relatedCommands": [
    "az",
    "terraform",
    "pulumi",
    "helm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Bicep CLI version",
        "command": "az bicep version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "az"
      },
      {
        "name": "templates",
        "description": "Bicep templates in this project",
        "command": "find . -maxdepth 3 -name '*.bicep' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "parameters",
        "description": "Bicep parameter files",
        "command": "find . -maxdepth 3 -name '*.bicepparam' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
