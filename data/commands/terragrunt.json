{
  "name": "terragrunt",
  "description": "Thin wrapper for Terraform providing extra tools for keeping configurations DRY",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "plan",
      "description": "Generate and show execution plan (wraps terraform plan)",
      "options": [
        {
          "name": "--terragrunt-working-dir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--terragrunt-source",
          "description": "Override the module source",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--terragrunt-non-interactive",
          "description": "Never prompt",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--out",
          "description": "Write the plan here",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "terragrunt plan"
      ]
    },
    {
      "name": "apply",
      "description": "Apply changes (wraps terraform apply)",
      "options": [
        {
          "name": "--auto-approve",
          "description": "Skip approval prompt"
        }
      ],
      "examples": [
        "terragrunt apply"
      ]
    },
    {
      "name": "destroy",
      "description": "Destroy infrastructure (wraps terraform destroy)",
      "options": [
        {
          "name": "--terragrunt-working-dir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--terragrunt-non-interactive",
          "description": "Never prompt",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--auto-approve",
          "description": "Skip the approval prompt",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terragrunt destroy"
      ]
    },
    {
      "name": "init",
      "description": "Initialize Terraform (wraps terraform init)",
      "options": [
        {
          "name": "--terragrunt-working-dir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--upgrade",
          "description": "Upgrade the modules and providers",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--reconfigure",
          "description": "Reconfigure the backend",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terragrunt init"
      ]
    },
    {
      "name": "validate",
      "description": "Validate configuration",
      "options": [
        {
          "name": "--terragrunt-working-dir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terragrunt validate"
      ]
    },
    {
      "name": "output",
      "description": "Show output values",
      "options": [
        {
          "name": "--terragrunt-working-dir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--json",
          "description": "Emit JSON",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--raw",
          "description": "Print the raw value",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terragrunt output"
      ]
    },
    {
      "name": "run-all",
      "description": "Run command in all subdirectories",
      "subcommands": [
        {
          "name": "plan",
          "description": "Plan across all modules",
          "options": [
            {
              "name": "--terragrunt-non-interactive",
              "description": "Never prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--terragrunt-parallelism",
              "description": "Concurrent module runs",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--terragrunt-include-dir",
              "description": "Only these directories",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--terragrunt-exclude-dir",
              "description": "Skip these directories",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "terragrunt run-all plan"
          ]
        },
        {
          "name": "apply",
          "description": "Apply across all modules",
          "options": [
            {
              "name": "--terragrunt-non-interactive",
              "description": "Never prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--terragrunt-parallelism",
              "description": "Concurrent module runs",
              "type": "integer",
              "takesValue": true
            },
            {
              "name": "--auto-approve",
              "description": "Skip the approval prompt",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "terragrunt run-all apply"
          ]
        },
        {
          "name": "destroy",
          "description": "Destroy across all modules",
          "options": [
            {
              "name": "--terragrunt-non-interactive",
              "description": "Never prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--auto-approve",
              "description": "Skip the approval prompt",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "terragrunt run-all destroy"
          ]
        },
        {
          "name": "init",
          "description": "Init across all modules",
          "options": [
            {
              "name": "--terragrunt-non-interactive",
              "description": "Never prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--upgrade",
              "description": "Upgrade the modules and providers",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "terragrunt run-all init"
          ]
        },
        {
          "name": "validate",
          "description": "Validate across all modules",
          "options": [
            {
              "name": "--terragrunt-non-interactive",
              "description": "Never prompt",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "terragrunt run-all validate"
          ]
        },
        {
          "name": "output",
          "description": "Show outputs across all modules",
          "options": [
            {
              "name": "--json",
              "description": "Emit JSON",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--terragrunt-non-interactive",
              "description": "Never prompt",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "terragrunt run-all output"
          ]
        }
      ]
    },
    {
      "name": "graph-dependencies",
      "description": "Show dependency graph",
      "options": [
        {
          "name": "--terragrunt-working-dir",
          "description": "Working directory",
          "type": "directory",
          "takesValue": true
        }
      ],
      "examples": [
        "terragrunt graph-dependencies"
      ]
    },
    {
      "name": "hclfmt",
      "description": "Format HCL files",
      "options": [
        {
          "name": "--terragrunt-check",
          "description": "Report without writing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--terragrunt-diff",
          "description": "Print the diff",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--terragrunt-hclfmt-file",
          "description": "Only this file",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "terragrunt hclfmt"
      ]
    },
    {
      "name": "render-json",
      "description": "Render terragrunt.hcl as JSON",
      "options": [
        {
          "name": "--terragrunt-json-out",
          "description": "File to write",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--with-metadata",
          "description": "Include Terragrunt metadata",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terragrunt render-json"
      ]
    },
    {
      "name": "aws-provider-patch",
      "description": "Patch AWS provider configs",
      "options": [
        {
          "name": "--terragrunt-override-attr",
          "description": "Attribute to override, key=value",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "terragrunt aws-provider-patch"
      ]
    },
    {
      "name": "scaffold",
      "description": "Scaffold new module configuration",
      "options": [
        {
          "name": "--var",
          "description": "Template variable, key=value",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--var-file",
          "description": "Template variable file",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "terragrunt scaffold"
      ]
    },
    {
      "name": "catalog",
      "description": "Browse module catalog",
      "options": [
        {
          "name": "--terragrunt-no-include-root",
          "description": "Exclude the root module",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "terragrunt catalog"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--terragrunt-config",
      "description": "Path to terragrunt.hcl",
      "takesValue": true
    },
    {
      "name": "--terragrunt-working-dir",
      "description": "Working directory",
      "takesValue": true
    },
    {
      "name": "--terragrunt-source",
      "description": "Override source in terragrunt.hcl",
      "takesValue": true
    },
    {
      "name": "--terragrunt-non-interactive",
      "description": "Non-interactive mode"
    },
    {
      "name": "--terragrunt-log-level",
      "description": "Log level (trace, debug, info, warn, error)",
      "takesValue": true
    },
    {
      "name": "--terragrunt-no-auto-init",
      "description": "Don't auto-run init"
    },
    {
      "name": "--terragrunt-no-auto-retry",
      "description": "Don't auto-retry on errors"
    },
    {
      "name": "--terragrunt-parallelism",
      "description": "Number of parallel modules for run-all",
      "takesValue": true
    },
    {
      "name": "--terragrunt-exclude-dir",
      "description": "Exclude directory from run-all",
      "takesValue": true
    },
    {
      "name": "--terragrunt-include-dir",
      "description": "Include only this directory in run-all",
      "takesValue": true
    }
  ],
  "examples": [
    {
      "command": "terragrunt plan",
      "description": "Run plan"
    },
    {
      "command": "terragrunt apply --auto-approve",
      "description": "Apply without prompt"
    },
    {
      "command": "terragrunt run-all apply",
      "description": "Apply all modules"
    },
    {
      "command": "terragrunt graph-dependencies",
      "description": "Show dependency graph"
    },
    {
      "command": "terragrunt hclfmt",
      "description": "Format HCL files"
    },
    {
      "command": "terragrunt run-all plan --terragrunt-parallelism 4",
      "description": "Parallel plan"
    },
    {
      "command": "terragrunt render-json",
      "description": "Render config as JSON"
    }
  ],
  "relatedCommands": [
    "terraform",
    "pulumi"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "config_file",
        "description": "Terragrunt configuration",
        "command": "cat terragrunt.hcl 2>/dev/null | head -30",
        "parser": "text",
        "cacheFor": 30
      },
      {
        "name": "modules",
        "description": "Terragrunt modules in subdirectories",
        "command": "find . -name 'terragrunt.hcl' -not -path './.terragrunt-cache/*' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "dependencies",
        "description": "Module dependencies",
        "command": "grep -r 'dependency' terragrunt.hcl 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "terraform_source",
        "description": "Terraform source modules",
        "command": "grep 'source' terragrunt.hcl 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
