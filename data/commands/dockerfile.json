{
  "language": "dockerfile",
  "name": "dockerfile",
  "description": "Dockerfile — instructions to build Docker container images",
  "category": "containers",
  "contextEngine": {
    "detectors": [
      {
        "name": "docker_version",
        "description": "Docker engine version",
        "command": "docker version --format '{{.Server.Version}}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "docker"
      },
      {
        "name": "buildkit_enabled",
        "description": "Check if BuildKit is enabled",
        "command": "echo $DOCKER_BUILDKIT",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "local_images",
        "description": "Local Docker images",
        "command": "docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "docker"
      },
      {
        "name": "dockerfiles_present",
        "description": "Dockerfiles in current directory",
        "command": "find . -maxdepth 2 -name 'Dockerfile*' -o -name '*.dockerfile' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 60
      }
    ]
  },
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--platform",
      "description": "Set target platform for the build (e.g., linux/amd64)"
    },
    {
      "name": "--mount=type=cache",
      "description": "Mount a cache directory during RUN to speed up builds"
    },
    {
      "name": "--mount=type=secret",
      "description": "Mount a secret file during RUN without baking into image"
    },
    {
      "name": "--from=stage",
      "description": "Copy files from a named build stage"
    },
    {
      "name": "--chown=user:group",
      "description": "Set ownership of copied files"
    },
    {
      "name": "--chmod=permissions",
      "description": "Set file permissions on copied files"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    }
  ],
  "subcommands": [
    {
      "name": "FROM",
      "description": "Set the base image for the build stage",
      "args": [
        {
          "name": "image:tag",
          "description": "Base image and tag to build from",
          "type": "image",
          "required": true
        }
      ],
      "options": [
        {
          "name": "AS",
          "description": "Name this build stage so later stages can reference it",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "FROM node:20-alpine",
        "FROM golang:1.22 AS builder"
      ]
    },
    {
      "name": "RUN",
      "description": "Execute a command during the image build",
      "args": [
        {
          "name": "command",
          "description": "Command to run in the image",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--mount",
          "description": "Attach a bind, cache, secret or ssh mount for this RUN",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--network",
          "description": "Network mode for this RUN (default, none, host)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--security",
          "description": "Security mode for this RUN (insecure, sandbox)",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "RUN npm ci --omit=dev",
        "RUN --mount=type=cache,target=/root/.cache apt-get update"
      ]
    },
    {
      "name": "CMD",
      "description": "Set default command for the container",
      "args": [
        {
          "name": "command",
          "description": "Command to run in the image",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "CMD [\"node\", \"server.js\"]"
      ]
    },
    {
      "name": "ENTRYPOINT",
      "description": "Set the main executable for the container",
      "args": [
        {
          "name": "executable",
          "description": "Executable to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "ENTRYPOINT [\"/usr/local/bin/entrypoint.sh\"]"
      ]
    },
    {
      "name": "COPY",
      "description": "Copy files from build context into image",
      "args": [
        {
          "name": "src",
          "description": "Source path to copy from",
          "type": "path",
          "required": true
        },
        {
          "name": "dest",
          "description": "Destination path in the image",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--from",
          "description": "Copy from a named build stage or image instead of the build context",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--chown",
          "description": "Set owner and group on the copied files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--chmod",
          "description": "Set permissions on the copied files",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "COPY package*.json ./",
        "COPY --from=builder /app/dist ./dist"
      ]
    },
    {
      "name": "ADD",
      "description": "Copy files/URLs/archives into image with extraction",
      "args": [
        {
          "name": "src",
          "description": "Source path to copy from",
          "type": "path",
          "required": true
        },
        {
          "name": "dest",
          "description": "Destination path in the image",
          "type": "path",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--chown",
          "description": "Set owner and group on the copied files",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--chmod",
          "description": "Set permissions on the copied files",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "ADD https://example.com/archive.tar.gz /tmp/",
        "ADD --chown=app:app ./src /app/src"
      ]
    },
    {
      "name": "WORKDIR",
      "description": "Set the working directory for subsequent instructions",
      "args": [
        {
          "name": "path",
          "description": "Path inside the image",
          "type": "path",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "WORKDIR /app"
      ]
    },
    {
      "name": "ENV",
      "description": "Set environment variable in the image",
      "args": [
        {
          "name": "KEY=VALUE",
          "description": "Environment variable assignment",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "ENV NODE_ENV=production",
        "ENV PATH=/usr/local/bin:$PATH"
      ]
    },
    {
      "name": "EXPOSE",
      "description": "Declare the port the container listens on",
      "args": [
        {
          "name": "port",
          "description": "Port to use",
          "type": "integer",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "EXPOSE 3000",
        "EXPOSE 8080/tcp"
      ]
    },
    {
      "name": "ARG",
      "description": "Define a build-time variable",
      "args": [
        {
          "name": "name=default",
          "description": "Build argument name and default value",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "ARG NODE_VERSION=20",
        "ARG BUILD_DATE"
      ]
    },
    {
      "name": "HEALTHCHECK",
      "description": "Define a health check command for the container",
      "args": [
        {
          "name": "CMD command",
          "description": "Health check command to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--interval",
          "description": "Time between health checks (e.g. 30s)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--timeout",
          "description": "Time before a single health check is considered failed",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--retries",
          "description": "Consecutive failures before the container is marked unhealthy",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--start-period",
          "description": "Grace period before failed checks begin counting",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "HEALTHCHECK --interval=30s CMD curl -f http://localhost:3000/health || exit 1"
      ]
    },
    {
      "name": "USER",
      "description": "Set the user for subsequent instructions and runtime",
      "args": [
        {
          "name": "user:group",
          "description": "User and optional group to run as",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "USER node",
        "USER 1000:1000"
      ]
    },
    {
      "name": "VOLUME",
      "description": "Create a mount point for external volumes",
      "args": [
        {
          "name": "path",
          "description": "Path inside the image",
          "type": "path",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "VOLUME [\"/var/lib/data\"]"
      ]
    },
    {
      "name": "LABEL",
      "description": "Add metadata to the image",
      "args": [
        {
          "name": "key=value",
          "description": "Label key and value",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "LABEL org.opencontainers.image.source=\"https://github.com/org/repo\""
      ]
    },
    {
      "name": "SHELL",
      "description": "Override the default shell for RUN commands",
      "args": [
        {
          "name": "executable",
          "description": "Executable to run",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "SHELL [\"/bin/bash\", \"-o\", \"pipefail\", \"-c\"]"
      ]
    },
    {
      "name": "STOPSIGNAL",
      "description": "Set the system call signal for container exit",
      "args": [
        {
          "name": "signal",
          "description": "Signal used to stop the container",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "STOPSIGNAL SIGTERM"
      ]
    }
  ],
  "examples": [
    "FROM node:20-alpine",
    "FROM python:3.12-slim AS builder",
    "WORKDIR /app",
    "COPY package*.json ./",
    "COPY . .",
    "RUN npm ci --production",
    "RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*",
    "ENV NODE_ENV=production",
    "EXPOSE 3000",
    "CMD [\"node\", \"server.js\"]",
    "ENTRYPOINT [\"python\", \"app.py\"]",
    "ARG BUILD_VERSION=latest",
    "LABEL maintainer=\"dev@example.com\"",
    "HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:3000/health || exit 1",
    "USER node",
    "VOLUME /data",
    "ADD https://example.com/file.tar.gz /tmp/",
    "SHELL [\"/bin/bash\", \"-c\"]",
    "STOPSIGNAL SIGTERM",
    "# Multi-stage: FROM builder AS final"
  ],
  "relatedCommands": [
    "docker",
    "docker-compose",
    "podman",
    "buildah"
  ],
  "aliases": [
    "containerfile"
  ]
}
