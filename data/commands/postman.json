{
  "name": "postman",
  "description": "Postman CLI for API testing and collection runs",
  "category": "http-testing",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "login",
      "description": "Login to Postman",
      "examples": [
        "postman login --with-api-key PMAK-xxx"
      ],
      "options": [
        {
          "name": "--with-api-key",
          "description": "API key to authenticate with",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "collection run",
      "description": "Run a collection",
      "examples": [
        "postman collection run collection-id"
      ],
      "options": [
        {
          "name": "--environment",
          "description": "Environment to run against",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--reporters",
          "description": "Reporters to use",
          "type": "string",
          "takesValue": true,
          "short": "-r",
          "shorthand": "-r"
        },
        {
          "name": "--bail",
          "description": "Stop on the first failure",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "collection",
          "description": "Collection id, file or URL to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "api lint",
      "description": "Lint API definition",
      "examples": [
        "postman api lint --api-definition openapi.yaml"
      ],
      "options": [
        {
          "name": "--api-id",
          "description": "API to lint",
          "type": "string",
          "takesValue": true
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--environment",
      "description": "Environment ID",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--iteration-count",
      "description": "Number of iterations",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--iteration-data",
      "description": "Data file for iterations",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--delay-request",
      "description": "Delay between requests (ms)",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--bail",
      "description": "Stop on first failure"
    },
    {
      "name": "--timeout",
      "description": "Global timeout (ms)",
      "type": "number",
      "takesValue": true
    }
  ],
  "examples": [
    "postman login --with-api-key PMAK-xxx",
    "postman collection run 12345",
    "postman collection run 12345 --environment 67890",
    "postman api lint --api-definition openapi.yaml"
  ],
  "relatedCommands": [
    "newman",
    "curl",
    "httpie",
    "insomnia"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Postman CLI version",
        "command": "postman --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "postman"
      },
      {
        "name": "collections",
        "description": "Postman collections exported into this project",
        "command": "find . -maxdepth 3 -name '*postman_collection.json' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "environments",
        "description": "Postman environment files here",
        "command": "find . -maxdepth 3 -name '*postman_environment.json' 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "newman",
        "description": "Newman available as the collection runner",
        "command": "newman --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
