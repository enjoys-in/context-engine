{
  "name": "mycli",
  "description": "MySQL and MariaDB client with auto-completion and highlighting",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--host",
      "description": "Server host",
      "type": "string",
      "takesValue": true,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--port",
      "description": "Server port",
      "type": "integer",
      "takesValue": true,
      "short": "-P",
      "shorthand": "-P"
    },
    {
      "name": "--user",
      "description": "Username to connect as",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--password",
      "description": "Password to connect with",
      "type": "string",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--database",
      "description": "Database to connect to",
      "type": "string",
      "takesValue": true,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--execute",
      "description": "Run this command and exit",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--socket",
      "description": "Unix socket to connect through",
      "type": "path",
      "takesValue": true,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--ssl-ca",
      "description": "CA certificate for TLS",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--myclirc",
      "description": "Configuration file to use",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--table",
      "description": "Render output as a table",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--csv",
      "description": "Render output as CSV",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "mycli -u root -p app",
      "description": "Connect to a database"
    },
    {
      "command": "mycli mysql://user@host:3306/app",
      "description": "Connect with a URL"
    },
    {
      "command": "mycli -e \"SHOW TABLES\" app",
      "description": "Run one query and exit"
    }
  ],
  "relatedCommands": [
    "mysql",
    "pgcli",
    "litecli",
    "mysqldump"
  ]
}
