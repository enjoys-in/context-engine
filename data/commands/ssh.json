{
  "name": "ssh",
  "description": "OpenSSH remote login client",
  "category": "networking",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-p",
      "description": "Port to connect to",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-i",
      "description": "Identity file (private key)",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-l",
      "description": "Login name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-L",
      "description": "Local port forwarding (local:host:remote)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-R",
      "description": "Remote port forwarding (remote:host:local)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-D",
      "description": "Dynamic SOCKS proxy port",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-N",
      "description": "Don't execute remote command"
    },
    {
      "name": "-f",
      "description": "Go to background before command execution"
    },
    {
      "name": "-v",
      "description": "Verbose mode"
    },
    {
      "name": "-o",
      "description": "Specify option (key=value)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-A",
      "description": "Enable agent forwarding"
    },
    {
      "name": "-X",
      "description": "Enable X11 forwarding"
    },
    {
      "name": "-C",
      "description": "Enable compression"
    },
    {
      "name": "-J",
      "description": "ProxyJump (jump host)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-t",
      "description": "Force pseudo-terminal allocation"
    },
    {
      "name": "-q",
      "description": "Quiet mode"
    },
    {
      "name": "--port",
      "description": "Port to connect to",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--identity-file",
      "description": "Private key to authenticate with",
      "type": "file",
      "takesValue": true,
      "short": "-i",
      "shorthand": "-i"
    },
    {
      "name": "--login-name",
      "description": "User to log in as",
      "type": "string",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--option",
      "description": "Config option, as in ssh_config",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--config-file",
      "description": "Read configuration from this file",
      "type": "file",
      "takesValue": true,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--jump-host",
      "description": "Connect through this jump host",
      "type": "string",
      "takesValue": true,
      "short": "-J",
      "shorthand": "-J"
    },
    {
      "name": "--local-forward",
      "description": "Forward a local port, [bind:]port:host:hostport",
      "type": "string",
      "takesValue": true,
      "short": "-L",
      "shorthand": "-L"
    },
    {
      "name": "--remote-forward",
      "description": "Forward a remote port, [bind:]port:host:hostport",
      "type": "string",
      "takesValue": true,
      "short": "-R",
      "shorthand": "-R"
    },
    {
      "name": "--dynamic-forward",
      "description": "Open a SOCKS proxy on this port",
      "type": "string",
      "takesValue": true,
      "short": "-D",
      "shorthand": "-D"
    },
    {
      "name": "--no-command",
      "description": "Do not run a remote command; useful for forwarding",
      "type": "boolean",
      "takesValue": false,
      "short": "-N",
      "shorthand": "-N"
    },
    {
      "name": "--background",
      "description": "Go to the background after authenticating",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--force-tty",
      "description": "Force pseudo-terminal allocation",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--no-tty",
      "description": "Disable pseudo-terminal allocation",
      "type": "boolean",
      "takesValue": false,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--verbose",
      "description": "Print debug output; repeat for more",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--quiet",
      "description": "Suppress warnings",
      "type": "boolean",
      "takesValue": false,
      "short": "-q",
      "shorthand": "-q"
    },
    {
      "name": "--compression",
      "description": "Compress the session",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--agent-forwarding",
      "description": "Forward the authentication agent",
      "type": "boolean",
      "takesValue": false,
      "short": "-A",
      "shorthand": "-A"
    },
    {
      "name": "--no-agent-forwarding",
      "description": "Do not forward the agent",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--x11-forwarding",
      "description": "Enable X11 forwarding",
      "type": "boolean",
      "takesValue": false,
      "short": "-X",
      "shorthand": "-X"
    },
    {
      "name": "--trusted-x11",
      "description": "Enable trusted X11 forwarding",
      "type": "boolean",
      "takesValue": false,
      "short": "-Y",
      "shorthand": "-Y"
    },
    {
      "name": "--ipv4",
      "description": "Use IPv4 only",
      "type": "boolean",
      "takesValue": false,
      "short": "-4",
      "shorthand": "-4"
    },
    {
      "name": "--ipv6",
      "description": "Use IPv6 only",
      "type": "boolean",
      "takesValue": false,
      "short": "-6",
      "shorthand": "-6"
    },
    {
      "name": "--bind-address",
      "description": "Local address to bind to",
      "type": "string",
      "takesValue": true,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--escape-char",
      "description": "Escape character to use",
      "type": "string",
      "takesValue": true,
      "short": "-e",
      "shorthand": "-e"
    },
    {
      "name": "--subsystem",
      "description": "Request a subsystem, e.g. sftp",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--control-path",
      "description": "Path for the control socket",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "ssh user@hostname",
    "ssh -p 2222 user@hostname",
    "ssh -i ~/.ssh/mykey.pem user@hostname",
    "ssh -L 8080:localhost:80 user@hostname",
    "ssh -R 9090:localhost:3000 user@hostname",
    "ssh -D 1080 user@hostname",
    "ssh -J jumphost user@destination",
    "ssh user@hostname 'ls -la /var/log'"
  ],
  "relatedCommands": [
    "scp",
    "sftp",
    "ssh-keygen",
    "ssh-copy-id",
    "ssh-agent",
    "rsync",
    "mosh"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "OpenSSH client version",
        "command": "ssh -V 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "ssh"
      },
      {
        "name": "hosts",
        "description": "Hosts defined in the SSH config",
        "command": "grep -i '^host ' ~/.ssh/config 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "keys",
        "description": "SSH private keys available",
        "command": "ls ~/.ssh/id_* 2>/dev/null | grep -v '\\.pub$'",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "agent_keys",
        "description": "Keys loaded into the SSH agent",
        "command": "ssh-add -l 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "known_hosts_count",
        "description": "Hosts already trusted",
        "command": "wc -l < ~/.ssh/known_hosts 2>/dev/null",
        "parser": "text",
        "cacheFor": 300
      }
    ]
  }
}
