  "relatedCommands": [
    "psql",
    "redis-cli"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "buckets",
        "description": "Available buckets",
        "command": "influx bucket list --json 2>/dev/null | head -30",
        "parser": "json",
        "cacheFor": 30,
        "requiresCmd": "influx"
      },
      {
        "name": "orgs",
        "description": "Organizations",
        "command": "influx org list --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "influx"
      },
      {
        "name": "health",
        "description": "Server health",
        "command": "influx ping 2>/dev/null",
        "parser": "text",
        "cacheFor": 15,
        "requiresCmd": "influx"
      },
      {
        "name": "configs",
        "description": "CLI configurations",
        "command": "influx config list --json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "influx"
      }
    ]
  }
}
