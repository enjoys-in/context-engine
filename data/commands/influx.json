        {
          "name": "--username",
          "description": "Initial username",
          "type": "string",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--password",
          "description": "Initial password",
          "type": "string",
          "takesValue": true,
          "short": "-p",
          "shorthand": "-p"
