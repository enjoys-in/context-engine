  "examples": [
    {
      "command": "influx setup",
      "description": "Initial setup"
    },
    {
      "command": "influx bucket list",
      "description": "List buckets"
    },
    {
      "command": "influx write -b mybucket 'cpu,host=server01 value=0.64'",
      "description": "Write data point"
    },
    {
      "command": "influx query 'from(bucket:\"mybucket\") |> range(start:-1h)'",
      "description": "Execute Flux query"
    },
    {
      "command": "influx ping",
      "description": "Health check"
    },
    {
      "command": "influx backup ./backup-dir",
      "description": "Backup database"
    }
