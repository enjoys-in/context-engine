{
  "name": "k6",
  "description": "Modern load testing tool for developers and testers",
  "category": "Testing Tools",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "run",
      "description": "Run a test script",
      "args": [
        {
          "name": "script",
          "description": "Test script file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--vus",
          "shorthand": "-u",
          "description": "Virtual users",
          "takesValue": true,
          "short": "-u"
        },
        {
          "name": "--duration",
          "shorthand": "-d",
          "description": "Test duration",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--iterations",
          "shorthand": "-i",
          "description": "Total iterations",
          "takesValue": true,
          "short": "-i"
        },
        {
          "name": "--stage",
          "shorthand": "-s",
          "description": "Ramp stage (duration:vus)",
          "takesValue": true,
          "short": "-s"
        },
        {
          "name": "--env",
          "shorthand": "-e",
          "description": "Set environment variable",
          "takesValue": true,
          "short": "-e"
        },
        {
          "name": "--tag",
          "description": "Test run tag",
          "takesValue": true
        },
        {
          "name": "--out",
          "shorthand": "-o",
          "description": "Output (json, csv, influxdb, cloud, prometheus, etc.)",
          "takesValue": true,
          "short": "-o"
        },
        {
          "name": "--http-debug",
          "description": "Log HTTP requests (full, headers)"
        },
        {
          "name": "--no-color",
          "description": "Disable color output"
        },
        {
          "name": "--log-output",
          "description": "Log output destination",
          "takesValue": true
        },
        {
          "name": "--linger",
          "description": "Keep running after test completion"
        },
        {
          "name": "--no-thresholds",
          "description": "Ignore thresholds"
        },
        {
          "name": "--no-usage-report",
          "description": "Disable usage reporting"
        },
        {
          "name": "--throw",
          "description": "throw on failed test"
        },
        {
          "name": "--include-system-env-vars",
          "description": "Pass system env vars"
        },
        {
          "name": "--compatibility-mode",
          "description": "Script compatibility (extended, base)",
          "takesValue": true
        },
        {
          "name": "--insecure-skip-tls-verify",
          "description": "Skip TLS verification"
        }
      ],
      "examples": [
        "k6 run script.sh"
      ]
    },
    {
      "name": "cloud",
      "description": "Run test in k6 Cloud",
      "args": [
        {
          "name": "script",
          "description": "Test script",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--vus",
          "description": "Number of virtual users",
          "type": "integer",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--duration",
          "description": "How long to run for",
          "type": "string",
          "takesValue": true,
          "short": "-d",
          "shorthand": "-d"
        },
        {
          "name": "--env",
          "description": "Set an environment variable for the script",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--exit-on-running",
          "description": "Return as soon as the test starts running",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "k6 cloud script.sh"
      ]
    },
    {
      "name": "inspect",
      "description": "Inspect a test script",
      "args": [
        {
          "name": "script",
          "description": "Script file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--execution-requirements",
          "description": "Include the computed execution requirements",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--compatibility-mode",
          "description": "JavaScript compatibility mode",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "k6 inspect script.sh"
      ]
    },
    {
      "name": "archive",
      "description": "Create test archive",
      "args": [
        {
          "name": "script",
          "description": "Script file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--archive-out",
          "description": "Path to write the archive to",
          "type": "file",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        },
        {
          "name": "--env",
          "description": "Set an environment variable for the script",
          "type": "string",
          "takesValue": true,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--include-system-env-vars",
          "description": "Bundle the system environment into the archive",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "k6 archive script.sh"
      ]
    },
    {
      "name": "login",
      "description": "Login to k6 cloud",
      "subcommands": [
        {
          "name": "cloud",
          "description": "Login to k6 Cloud",
          "options": [
            {
              "name": "--token",
              "description": "API token to store",
              "type": "string",
              "takesValue": true,
              "short": "-t",
              "shorthand": "-t"
            },
            {
              "name": "--show",
              "description": "Print the stored credentials",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--reset",
              "description": "Remove the stored credentials",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "k6 login cloud"
          ]
        },
        {
          "name": "influxdb",
          "description": "Login to InfluxDB",
          "options": [
            {
              "name": "--username",
              "description": "InfluxDB username",
              "type": "string",
              "takesValue": true,
              "short": "-u",
              "shorthand": "-u"
            },
            {
              "name": "--password",
              "description": "InfluxDB password",
              "type": "string",
              "takesValue": true,
              "short": "-p",
              "shorthand": "-p"
            },
            {
              "name": "--show",
              "description": "Print the stored credentials",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--reset",
              "description": "Remove the stored credentials",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "k6 login influxdb"
          ]
        }
      ]
    },
    {
      "name": "pause",
      "description": "Pause a running test",
      "options": [
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--address",
          "description": "k6 REST API address",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "k6 pause"
      ]
    },
    {
      "name": "resume",
      "description": "Resume a paused test",
      "options": [
        {
          "name": "--quiet",
          "description": "Suppress progress output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--address",
          "description": "k6 REST API address",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "k6 resume"
      ]
    },
    {
      "name": "scale",
      "description": "Scale VUs of a running test",
      "options": [
        {
          "name": "--vus",
          "description": "Number of virtual users to scale to",
          "type": "integer",
          "takesValue": true,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--max",
          "description": "Maximum number of virtual users",
          "type": "integer",
          "takesValue": true,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--address",
          "description": "k6 REST API address",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "k6 scale"
      ]
    },
    {
      "name": "stats",
      "description": "Show test stats",
      "options": [
        {
          "name": "--address",
          "description": "k6 REST API address",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "k6 stats"
      ]
    },
    {
      "name": "status",
      "description": "Show test status",
      "options": [
        {
          "name": "--address",
          "description": "k6 REST API address",
          "type": "string",
          "takesValue": true,
          "short": "-a",
          "shorthand": "-a"
        }
      ],
      "examples": [
        "k6 status"
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "options": [],
      "examples": [
        "k6 version"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--verbose",
      "shorthand": "-v",
      "description": "Verbose output",
      "short": "-v"
    },
    {
      "name": "--quiet",
      "shorthand": "-q",
      "description": "Quiet mode",
      "short": "-q"
    },
    {
      "name": "--address",
      "shorthand": "-a",
      "description": "API address",
      "takesValue": true,
      "short": "-a"
    },
    {
      "name": "--config",
      "description": "Config file",
      "takesValue": true
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    }
  ],
  "examples": [
    {
      "command": "k6 run script.js",
      "description": "Run load test"
    },
    {
      "command": "k6 run --vus 50 --duration 30s script.js",
      "description": "50 VUs for 30 seconds"
    },
    {
      "command": "k6 run -s 10s:10 -s 1m:50 -s 10s:0 script.js",
      "description": "Ramping stages"
    },
    {
      "command": "k6 run --out json=results.json script.js",
      "description": "JSON output"
    },
    {
      "command": "k6 run --out influxdb=http://localhost:8086/k6 script.js",
      "description": "InfluxDB output"
    },
    {
      "command": "k6 run -e BASE_URL=http://localhost:3000 script.js",
      "description": "With env variable"
    },
    {
      "command": "k6 cloud script.js",
      "description": "Run in k6 Cloud"
    }
  ],
  "relatedCommands": [
    "locust"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "scripts",
        "description": "k6 test scripts",
        "command": "find . -maxdepth 2 -name '*.js' -exec grep -l 'import.*k6' {} \\; 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 30
      },
      {
        "name": "config",
        "description": "k6 configuration",
        "command": "cat k6.config.js 2>/dev/null || cat k6.json 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "version",
        "description": "k6 version",
        "command": "k6 version 2>/dev/null",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "k6"
      }
    ]
  }
}
