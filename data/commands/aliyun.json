{
  "name": "aliyun",
  "description": "Alibaba Cloud CLI",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "configure",
      "description": "Configure credentials",
      "examples": [
        "aliyun configure",
        "aliyun configure set --profile default --mode AK --access-key-id xxx --access-key-secret xxx --region cn-hangzhou"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Profile to configure",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--mode",
          "description": "Credential mode: AK, StsToken, RamRoleArn or EcsRamRole",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--access-key-id",
          "description": "Access key to store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--access-key-secret",
          "description": "Access key secret to store",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "Default region",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "ecs",
      "description": "Elastic Compute Service",
      "examples": [
        "aliyun ecs DescribeInstances",
        "aliyun ecs RunInstances --ImageId ubuntu_22_04 --InstanceType ecs.t6-c1m1.large",
        "aliyun ecs StopInstance --InstanceId i-xxx",
        "aliyun ecs DeleteInstance --InstanceId i-xxx --Force true"
      ],
      "options": [
        {
          "name": "--profile",
          "description": "Configuration profile to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--region",
          "description": "Region to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--output",
          "description": "Output format and field filters",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--access-key-id",
          "description": "Access key to authenticate with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Skip client-side parameter validation",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "oss",
