    "aliyun configure",
    "aliyun ecs DescribeInstances --output table",
    "aliyun oss ls",
    "aliyun oss cp file.txt oss://bucket/",
    "aliyun cs DescribeClusters",
    "aliyun rds DescribeDBInstances",
    "aliyun vpc DescribeVpcs"
  ],
  "relatedCommands": [
    "aws",
    "az",
    "gcloud",
    "terraform"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Aliyun CLI version",
        "command": "aliyun version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "aliyun"
      },
      {
        "name": "profiles",
        "description": "Configured Aliyun profiles",
        "command": "aliyun configure list 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "aliyun"
      },
      {
        "name": "config_file",
        "description": "Aliyun credential profiles on disk",
        "command": "cat ~/.aliyun/config.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 300
      }
    ]
  }
}
