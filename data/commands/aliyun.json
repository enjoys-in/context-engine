  "globalOptions": [
    {
      "name": "--profile",
      "description": "Named profile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--region",
      "description": "Region ID",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "description": "Output format (json, table, text)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--access-key-id",
      "description": "Access Key ID",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--access-key-secret",
      "description": "Access Key Secret",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--mode",
      "description": "Credential mode (AK, StsToken, RamRoleArn)",
      "type": "string",
      "takesValue": true
