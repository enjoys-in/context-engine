{
  "name": "cdk",
  "description": "AWS Cloud Development Kit CLI",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Create a new CDK project",
      "examples": [
        "cdk init app --language typescript"
      ],
      "options": [
        {
          "name": "--language",
          "description": "Language for the new app",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--generate-only",
          "description": "Scaffold without initialising git or installing",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "template",
          "description": "Template to scaffold, such as app or lib",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "synth",
      "description": "Synthesize CloudFormation template",
      "examples": [
        "cdk synth"
      ],
      "options": [
        {
          "name": "--exclusively",
          "description": "Only synthesise the named stacks",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--quiet",
          "description": "Do not print the template",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--validation",
          "description": "Run validation plugins",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "deploy",
      "description": "Deploy stack to AWS",
      "examples": [
        "cdk deploy",
        "cdk deploy --all"
      ],
      "options": [
        {
          "name": "--require-approval",
          "description": "When to prompt for security changes",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--hotswap",
          "description": "Attempt a fast in-place update",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--outputs-file",
          "description": "Write the stack outputs here",
          "type": "file",
          "takesValue": true,
          "short": "-O",
          "shorthand": "-O"
        },
        {
          "name": "--parameters",
          "description": "Pass a parameter to the stack",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--all",
          "description": "Deploy every stack",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--concurrency",
          "description": "Number of stacks to deploy at once",
          "type": "integer",
          "takesValue": true
        }
      ]
    },
    {
      "name": "diff",
      "description": "Show diff between deployed and local",
      "examples": [
        "cdk diff"
      ],
      "options": [
        {
          "name": "--exclusively",
          "description": "Only diff the named stacks",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--context-lines",
          "description": "Lines of context to show",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--fail",
          "description": "Exit non-zero when there is a diff",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--template",
          "description": "Compare against this template",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "stacks",
          "description": "Stacks to diff",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "destroy",
      "description": "Destroy deployed stack",
      "examples": [
        "cdk destroy"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Destroy without confirming",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--exclusively",
          "description": "Only destroy the named stacks",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--all",
          "description": "Destroy every stack",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "bootstrap",
      "description": "Bootstrap CDK toolkit stack",
      "examples": [
        "cdk bootstrap"
      ],
      "options": [
        {
          "name": "--bootstrap-bucket-name",
          "description": "Name for the bootstrap bucket",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--trust",
          "description": "Accounts permitted to deploy into this environment",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--cloudformation-execution-policies",
          "description": "Policies for the deployment role",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--qualifier",
          "description": "Qualifier for the bootstrap resources",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "list",
      "description": "List stacks",
      "examples": [
        "cdk list"
      ],
      "options": [
        {
          "name": "--long",
          "description": "Include stack names and dependencies",
          "type": "boolean",
          "takesValue": false,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--show-dependencies",
          "description": "Show inter-stack dependencies",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "watch",
      "description": "Watch for changes and deploy",
      "examples": [
        "cdk watch"
      ],
      "options": [
        {
          "name": "--hotswap",
          "description": "Attempt fast in-place updates",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--logs",
          "description": "Stream CloudWatch logs while watching",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--exclusively",
          "description": "Only watch the named stacks",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        }
      ]
    },
    {
      "name": "doctor",
      "description": "Check CDK setup",
      "examples": [
        "cdk doctor"
      ],
      "options": [
        {
          "name": "--verbose",
          "description": "Include the full diagnostic detail",
          "type": "boolean",
          "takesValue": false,
          "short": "-v",
          "shorthand": "-v"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--profile",
      "description": "AWS profile",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--region",
      "description": "AWS region",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--context",
      "short": "-c",
      "description": "Context values",
      "type": "string",
      "takesValue": true,
      "shorthand": "-c"
    },
    {
      "name": "--require-approval",
      "description": "Approval level (never, any-change, broadening)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--hotswap",
      "description": "Use hotswap deployments"
    },
    {
      "name": "--verbose",
      "short": "-v",
      "description": "Verbose output",
      "shorthand": "-v"
    }
  ],
  "examples": [
    "cdk init app --language typescript",
    "cdk synth",
    "cdk deploy",
    "cdk diff",
    "cdk deploy --all --require-approval never"
  ],
  "relatedCommands": [
    "aws",
    "sam",
    "terraform",
    "cloudformation"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "AWS CDK version",
        "command": "cdk --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "cdk"
      },
      {
        "name": "stacks",
        "description": "Stacks defined in this CDK app",
        "command": "cdk list 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "cdk"
      },
      {
        "name": "config",
        "description": "CDK app configuration",
        "command": "cat cdk.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      },
      {
        "name": "context",
        "description": "Cached CDK context",
        "command": "cat cdk.context.json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120
      }
    ]
  }
}
