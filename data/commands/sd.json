{
  "name": "sd",
  "description": "Intuitive find-and-replace, a simpler sed",
  "category": "modern-cli",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--preview",
      "description": "Show the result without writing",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--string-mode",
      "description": "Treat the pattern literally",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--fixed-strings",
      "description": "Treat the pattern literally",
      "type": "boolean",
      "takesValue": false,
      "short": "-F",
      "shorthand": "-F"
    },
    {
      "name": "--flags",
      "description": "Regex flags such as i or m",
      "type": "string",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--replace-first",
      "description": "Replace only the first match",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "sd \"foo\" \"bar\" file.txt",
      "description": "Replace in place"
    },
    {
      "command": "sd -p \"foo\" \"bar\" file.txt",
      "description": "Preview the change"
    },
    {
      "command": "fd -e js -x sd \"var \" \"let \"",
      "description": "Replace across matching files"
    },
    {
      "command": "sd -s \"a.b\" \"x\" file",
      "description": "Treat the pattern as a literal string"
    }
  ],
  "relatedCommands": [
    "sed",
    "rg",
    "fd",
    "awk"
  ]
}
