{
  "name": "nuclei",
  "description": "Template-based vulnerability scanner",
  "category": "security",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--target",
      "description": "Target URL or host to scan",
      "type": "string",
      "takesValue": true,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--list",
      "description": "File of targets to scan",
      "type": "file",
      "takesValue": true,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--templates",
      "description": "Templates or directories to run",
      "type": "string",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--tags",
      "description": "Only templates with these tags",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--severity",
      "description": "Only these severities (info, low, medium, high, critical)",
      "type": "string",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--exclude-templates",
      "description": "Templates to skip",
      "type": "string",
      "takesValue": true,
      "short": "-et",
      "shorthand": "-et"
    },
    {
      "name": "--output",
      "description": "Write findings here",
      "type": "file",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--json-export",
      "description": "Write findings as JSON",
      "type": "file",
      "takesValue": true,
      "short": "-je",
      "shorthand": "-je"
    },
    {
      "name": "--rate-limit",
      "description": "Requests per second",
      "type": "integer",
      "takesValue": true,
      "short": "-rl",
      "shorthand": "-rl"
    },
    {
      "name": "--concurrency",
      "description": "Templates to run in parallel",
      "type": "integer",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--bulk-size",
      "description": "Hosts to scan per template",
      "type": "integer",
      "takesValue": true,
      "short": "-bs",
      "shorthand": "-bs"
    },
    {
      "name": "--timeout",
      "description": "Seconds before a request times out",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--retries",
      "description": "Times to retry a failed request",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--update-templates",
      "description": "Refresh the template store",
      "type": "boolean",
      "takesValue": false,
      "short": "-ut",
      "shorthand": "-ut"
    },
    {
      "name": "--validate",
      "description": "Check templates without running them",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--proxy",
      "description": "Proxy to route requests through",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--silent",
      "description": "Print findings only",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--stats",
      "description": "Show progress statistics",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "nuclei -u https://example.com",
      "description": "Scan a single target"
    },
    {
      "command": "nuclei -l hosts.txt -s critical,high",
      "description": "Scan a list, high severity only"
    },
    {
      "command": "nuclei -ut",
      "description": "Update the template store"
    },
    {
      "command": "nuclei -u https://example.com -t http/cves/ -je out.json",
      "description": "Run one template set and export JSON"
    }
  ],
  "relatedCommands": [
    "semgrep",
    "trivy",
    "grype",
    "sqlmap",
    "nmap"
  ]
}
