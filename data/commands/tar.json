{
  "name": "tar",
  "description": "Archive utility for creating and extracting tar archives",
  "category": "filesystem",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-c",
      "description": "Create a new archive"
    },
    {
      "name": "-x",
      "description": "Extract files from archive"
    },
    {
      "name": "-t",
      "description": "List contents of archive"
    },
    {
      "name": "-f",
      "description": "Archive file name",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-z",
      "description": "Filter through gzip"
    },
    {
      "name": "-j",
      "description": "Filter through bzip2"
    },
    {
      "name": "-J",
      "description": "Filter through xz"
    },
    {
      "name": "-v",
      "description": "Verbose output"
    },
    {
      "name": "-C",
      "description": "Change to directory",
      "type": "directory",
      "takesValue": true
    },
    {
      "name": "--exclude",
      "description": "Exclude matching files",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-r",
      "description": "Append files to archive"
    },
    {
      "name": "-u",
      "description": "Update archive (append newer files)"
    },
    {
      "name": "--strip-components",
      "description": "Strip leading path components",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "-p",
      "description": "Preserve permissions"
    },
    {
      "name": "--create",
      "description": "Create a new archive",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--extract",
      "description": "Extract from an archive",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    },
    {
      "name": "--list",
      "description": "List the archive contents",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--append",
      "description": "Append files to an archive",
      "type": "boolean",
      "takesValue": false,
      "short": "-r",
      "shorthand": "-r"
    },
    {
      "name": "--update",
      "description": "Append only newer files",
      "type": "boolean",
      "takesValue": false,
      "short": "-u",
      "shorthand": "-u"
    },
    {
      "name": "--compare",
      "description": "Compare the archive against the filesystem",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--file",
      "description": "Archive file to use",
      "type": "file",
      "takesValue": true,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--verbose",
      "description": "List files as they are processed",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--gzip",
      "description": "Filter through gzip",
      "type": "boolean",
      "takesValue": false,
      "short": "-z",
      "shorthand": "-z"
    },
    {
      "name": "--bzip2",
      "description": "Filter through bzip2",
      "type": "boolean",
      "takesValue": false,
      "short": "-j",
      "shorthand": "-j"
    },
    {
      "name": "--xz",
      "description": "Filter through xz",
      "type": "boolean",
      "takesValue": false,
      "short": "-J",
      "shorthand": "-J"
    },
    {
      "name": "--zstd",
      "description": "Filter through zstd",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--directory",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--exclude-from",
      "description": "Read exclude patterns from this file",
      "type": "file",
      "takesValue": true,
      "short": "-X",
      "shorthand": "-X"
    },
    {
      "name": "--exclude-vcs",
      "description": "Skip version-control directories",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--preserve-permissions",
      "description": "Restore permissions exactly",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--same-owner",
      "description": "Restore ownership",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-same-owner",
      "description": "Do not restore ownership",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--numeric-owner",
      "description": "Use numeric uid and gid",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--dereference",
      "description": "Follow symlinks",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--keep-newer-files",
      "description": "Do not overwrite newer files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--overwrite",
      "description": "Overwrite existing files",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--to-stdout",
      "description": "Extract to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-O",
      "shorthand": "-O"
    },
    {
      "name": "--wildcards",
      "description": "Treat member names as glob patterns",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--anchored",
      "description": "Match patterns from the start of the name",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--totals",
      "description": "Print the total bytes processed",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--checkpoint",
      "description": "Print progress every N records",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--files-from",
      "description": "Read the member list from here",
      "type": "file",
      "takesValue": true,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--transform",
      "description": "Rewrite names with a sed expression",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--sparse",
      "description": "Handle sparse files efficiently",
      "type": "boolean",
      "takesValue": false,
      "short": "-S",
      "shorthand": "-S"
    },
    {
      "name": "--one-file-system",
      "description": "Do not cross filesystem boundaries",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "tar -czf archive.tar.gz directory/",
    "tar -xzf archive.tar.gz",
    "tar -xzf archive.tar.gz -C /target/dir",
    "tar -tzf archive.tar.gz",
    "tar -cjf archive.tar.bz2 directory/",
    "tar -xjf archive.tar.bz2",
    "tar -czf backup.tar.gz --exclude='node_modules' --exclude='.git' .",
    "tar -xzf archive.tar.gz --strip-components=1"
  ],
  "relatedCommands": [
    "gzip",
    "bzip2",
    "xz",
    "zip",
    "unzip",
    "7z"
  ]
}
