{
  "name": "echo",
  "description": "Display text to standard output",
  "category": "coreutils",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-n",
      "description": "Do not output trailing newline"
    },
    {
      "name": "-e",
      "description": "Enable interpretation of backslash escapes"
    },
    {
      "name": "-E",
      "description": "Disable interpretation of backslash escapes"
    }
  ],
  "examples": [
    "echo 'Hello World'",
    "echo -n 'no newline'",
    "echo -e 'line1\\nline2'",
    "echo $HOME",
    "echo \"Value: $VAR\"",
    "echo 'text' > file.txt",
    "echo 'append' >> file.txt"
  ],
  "relatedCommands": [
    "printf",
    "cat",
    "tee"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "shell",
        "description": "Shell interpreting echo",
        "command": "echo \"${SHELL:-unknown}\"",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "path_entries",
        "description": "Directories on PATH",
        "command": "echo \"${PATH}\" | tr ':' '\\n' | head -20",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "bash_version",
        "description": "Bash version, which changes echo's flags",
        "command": "echo \"${BASH_VERSION:-not bash}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
