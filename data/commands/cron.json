{
  "name": "cron",
  "description": "Daemon to execute scheduled commands (crontab)",
  "category": "system",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--foreground",
      "description": "Stay in the foreground instead of daemonising",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--no-fork",
      "description": "Do not fork; useful under a supervisor",
      "type": "boolean",
      "takesValue": false,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--syslog",
      "description": "Log to syslog instead of mail",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--permissive",
      "description": "Relax crontab file permission checks",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--debug",
      "description": "Enable debug output",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    }
  ],
  "examples": [
    "crontab -l",
    "crontab -e",
    "crontab -r",
    "crontab file.txt",
    "crontab -l -u www-data"
  ],
  "relatedCommands": [
    "crontab",
    "at",
    "systemd-timer",
    "anacron"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "user_crontab",
        "description": "Crontab for the current user",
        "command": "crontab -l 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "system_cron",
        "description": "System-wide cron jobs",
        "command": "ls /etc/cron.d /etc/cron.daily 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "cron_service",
        "description": "cron service state",
        "command": "systemctl is-active cron 2>/dev/null || systemctl is-active crond 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      }
    ]
  }
}
