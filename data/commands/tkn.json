  "globalOptions": [
    {
      "name": "--context",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--kubeconfig",
      "short": "-k",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true,
      "shorthand": "-k"
    },
    {
      "name": "--no-headers",
      "description": "Omit table headers"
    }
  ],
  "examples": [
    "tkn pipeline list",
    "tkn pipeline start my-pipeline",
    "tkn pipelinerun logs run-xxxxx",
    "tkn task list",
    "tkn hub search git-clone",
    "tkn hub install task git-clone",
    "tkn eventlistener list"
  ],
  "relatedCommands": [
    "kubectl",
    "argocd",
    "flux",
    "jenkins"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Tekton CLI version",
        "command": "tkn version 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600,
        "requiresCmd": "tkn"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "pipelines",
        "description": "Tekton pipelines in the active namespace",
        "command": "tkn pipeline list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "tkn"
      },
      {
        "name": "tasks",
        "description": "Tekton tasks available",
        "command": "tkn task list 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "tkn"
      }
    ]
  }
}
