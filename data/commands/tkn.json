{
  "name": "tkn",
  "description": "Tekton CLI for CI/CD pipelines on Kubernetes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "pipeline",
      "description": "Manage pipelines",
      "examples": [
        "tkn pipeline list",
        "tkn pipeline start my-pipeline",
        "tkn pipeline start my-pipeline -p param1=value1",
        "tkn pipeline describe my-pipeline",
        "tkn pipeline delete my-pipeline",
        "tkn pipeline logs my-pipeline"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Namespace to operate in",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--kubeconfig",
          "description": "Kubeconfig file to read",
          "type": "file",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        },
        {
          "name": "--output",
          "description": "Output format: json, yaml or name",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--allow-missing-template-keys",
          "description": "Ignore missing keys in templates",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against pipeline, such as list",
          "type": "string",
          "required": true
        }
      ]
    },
