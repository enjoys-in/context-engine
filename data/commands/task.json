{
  "name": "task",
  "description": "Task runner and build tool configured in Taskfile.yml",
  "category": "environment",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--list",
      "description": "List the available tasks",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--list-all",
      "description": "List tasks including undocumented ones",
      "type": "boolean",
      "takesValue": false,
      "short": "-a",
      "shorthand": "-a"
    },
    {
      "name": "--taskfile",
      "description": "Taskfile to read",
      "type": "file",
      "takesValue": true,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--dir",
      "description": "Change to this directory first",
      "type": "directory",
      "takesValue": true,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--force",
      "description": "Run even when the task is up to date",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--watch",
      "description": "Re-run when sources change",
      "type": "boolean",
      "takesValue": false,
      "short": "-w",
      "shorthand": "-w"
    },
    {
      "name": "--parallel",
      "description": "Run the given tasks in parallel",
      "type": "boolean",
      "takesValue": false,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--concurrency",
      "description": "Maximum concurrent tasks",
      "type": "integer",
      "takesValue": true,
      "short": "-C",
      "shorthand": "-C"
    },
    {
      "name": "--dry",
      "description": "Print what would run without running it",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--summary",
      "description": "Show a task summary",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--silent",
      "description": "Suppress task output",
      "type": "boolean",
      "takesValue": false,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--verbose",
      "description": "Print more detail",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--output",
      "description": "Output style (interleaved, group, prefixed)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--init",
      "description": "Create a starter Taskfile",
      "type": "boolean",
      "takesValue": false,
      "short": "-i",
      "shorthand": "-i"
    }
  ],
  "examples": [
    {
      "command": "task --list",
      "description": "List the available tasks"
    },
    {
      "command": "task build",
      "description": "Run a task"
    },
    {
      "command": "task -p test lint",
      "description": "Run two tasks in parallel"
    },
    {
      "command": "task -w build",
      "description": "Rebuild when sources change"
    },
    {
      "command": "task --init",
      "description": "Create a starter Taskfile"
    }
  ],
  "relatedCommands": [
    "make",
    "just",
    "mise",
    "npm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Task version",
        "command": "task --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "task"
      },
      {
        "name": "taskfile",
        "description": "Taskfile for this project",
        "command": "cat Taskfile.yml 2>/dev/null | head -50 || cat Taskfile.yaml 2>/dev/null | head -50",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "tasks",
        "description": "Tasks declared in this Taskfile",
        "command": "task --list-all 2>/dev/null | head -30",
        "parser": "lines",
        "cacheFor": 120,
        "requiresCmd": "task"
      },
      {
        "name": "includes",
        "description": "Taskfiles included by this one",
        "command": "grep -A10 '^includes:' Taskfile.yml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
