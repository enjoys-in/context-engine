{
  "name": "nvm",
  "description": "Node Version Manager — manage multiple Node.js versions",
  "category": "version-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a Node.js version",
      "examples": [
        "nvm install 20",
        "nvm install --lts",
        "nvm install 18.17.0"
      ],
      "options": [
        {
          "name": "--lts",
          "description": "Install the latest LTS release",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--reinstall-packages-from",
          "description": "Reinstall global packages from this version",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "version",
          "description": "Node version to install",
          "required": false,
          "type": "version"
        }
      ]
    },
    {
      "name": "use",
      "description": "Switch to a Node.js version",
      "examples": [
        "nvm use 20",
        "nvm use --lts",
        "nvm use default"
      ],
      "options": [
        {
          "name": "--silent",
          "description": "Suppress output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "version",
          "description": "Node version to activate",
          "required": false,
          "type": "version"
        }
      ]
    },
    {
      "name": "ls",
      "description": "List installed versions",
      "examples": [
        "nvm ls"
      ],
      "options": [
        {
          "name": "--no-colors",
          "description": "Disable coloured output",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ls-remote",
      "description": "List available remote versions",
      "examples": [
        "nvm ls-remote --lts"
      ],
      "options": [
        {
          "name": "--lts",
          "description": "Only show LTS releases",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "alias",
      "description": "Set an alias",
      "examples": [
        "nvm alias default 20"
      ],
      "options": [],
      "args": [
        {
          "name": "name",
          "description": "Alias name",
          "required": true,
          "type": "alias"
        },
        {
          "name": "version",
          "description": "Version the alias points at",
          "required": false,
          "type": "version"
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall a version",
      "examples": [
        "nvm uninstall 16"
      ],
      "options": [],
      "args": [
        {
          "name": "version",
          "description": "Node version to remove",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "current",
      "description": "Show currently active version",
      "examples": [
        "nvm current"
      ],
      "options": []
    },
    {
      "name": "which",
      "description": "Show path for installed version",
      "examples": [
        "nvm which 20"
      ],
      "options": [],
      "args": [
        {
          "name": "version",
          "description": "Version whose path to print",
          "required": false,
          "type": "version"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-colors",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--lts",
      "description": "Operate on the latest LTS release",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "nvm install --lts",
    "nvm use 20",
    "nvm ls",
    "nvm alias default 20",
    "nvm ls-remote --lts",
    "nvm current"
  ],
  "relatedCommands": [
    "fnm",
    "volta",
    "node",
    "npm"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "current",
        "description": "Node version nvm has active",
        "command": "node --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "version_file",
        "description": "Node version pinned for this project",
        "command": "cat .nvmrc 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "installed",
        "description": "Node versions installed under nvm",
        "command": "ls ~/.nvm/versions/node 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "nvm_dir",
        "description": "nvm installation directory",
        "command": "echo \"${NVM_DIR:-$HOME/.nvm}\"",
        "parser": "text",
        "cacheFor": 3600
      }
    ]
  }
}
