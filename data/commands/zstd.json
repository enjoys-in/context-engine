{
  "name": "zstd",
  "description": "Fast real-time compression from Facebook (.zst)",
  "category": "archive",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--decompress",
      "description": "Expand instead of compress",
      "type": "boolean",
      "takesValue": false,
      "short": "-d",
      "shorthand": "-d"
    },
    {
      "name": "--keep",
      "description": "Keep the input file",
      "type": "boolean",
      "takesValue": false,
      "short": "-k",
      "shorthand": "-k"
    },
    {
      "name": "--force",
      "description": "Overwrite existing output",
      "type": "boolean",
      "takesValue": false,
      "short": "-f",
      "shorthand": "-f"
    },
    {
      "name": "--stdout",
      "description": "Write to stdout",
      "type": "boolean",
      "takesValue": false,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--test",
      "description": "Verify integrity",
      "type": "boolean",
      "takesValue": false,
      "short": "-t",
      "shorthand": "-t"
    },
    {
      "name": "--threads",
      "description": "Worker threads; 0 uses all cores",
      "type": "integer",
      "takesValue": true,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--ultra",
      "description": "Unlock compression levels above 19",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--long",
      "description": "Enable long-distance matching",
      "type": "integer",
      "takesValue": true
    },
    {
      "name": "--rm",
      "description": "Delete the input after success",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--train",
      "description": "Train a compression dictionary from samples",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--verbose",
      "description": "Report progress",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    }
  ],
  "examples": [
    {
      "command": "zstd -19 -T0 dump.sql",
      "description": "Compress hard using every core"
    },
    {
      "command": "zstd -d dump.sql.zst",
      "description": "Expand an archive"
    },
    {
      "command": "tar --zstd -cf out.tar.zst dir/",
      "description": "Compress a directory through tar"
    },
    {
      "command": "zstd -t dump.sql.zst",
      "description": "Verify integrity"
    }
  ],
  "relatedCommands": [
    "gzip",
    "xz",
    "lz4",
    "tar"
  ]
}
