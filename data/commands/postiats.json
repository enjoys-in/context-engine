{
  "language": "postiats",
  "name": "patscc",
  "description": "ATS/Postiats — Applied Type System compiler with dependent types",
  "category": "language",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh"
  ],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Set output file name"
    },
    {
      "name": "-tcats",
      "description": "Type-check only"
    },
    {
      "name": "-ccats",
      "description": "Compile to C only"
    },
    {
      "name": "-DATS",
      "description": "Define an ATS compile-time symbol"
    },
    {
      "name": "-IATS",
      "description": "Add ATS include search path"
    },
    {
      "name": "-cleanaft",
      "description": "Clean generated C files after compilation"
    },
    {
      "name": "-atsccomp",
      "description": "Specify the C compiler to use"
    },
    {
      "name": "--help",
      "description": "Show help information",
      "alias": "-h"
    },
    {
      "name": "--version",
      "description": "Show version number",
      "alias": "-v"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    }
  ],
  "subcommands": [
    {
      "name": "file.dats",
      "description": "Compile an ATS dynamic file",
      "args": [
        {
          "name": "file",
          "description": "ATS source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-IATS",
          "description": "Add an ATS include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "-D",
          "description": "Define a preprocessor macro",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-o output file.dats",
      "description": "Compile with named output executable",
      "args": [
        {
          "name": "output",
          "description": "Path for the compiled binary",
          "type": "file",
          "required": true
        },
        {
          "name": "file",
          "description": "ATS source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-IATS",
          "description": "Add an ATS include search directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "-cleanaft",
          "description": "Remove the generated C after compiling",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "-tcats file.dats",
      "description": "Type-check only without compiling to C",
      "args": [
        {
          "name": "file",
          "description": "ATS source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-IATS",
          "description": "Add an ATS include search directory",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "-ccats file.dats",
      "description": "Compile to C without generating executable",
      "args": [
        {
          "name": "file",
          "description": "ATS source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-IATS",
          "description": "Add an ATS include search directory",
          "type": "directory",
          "takesValue": true
        }
      ]
    },
    {
      "name": "file.dats -DATS_MEMALLOC_LIBC",
      "description": "Compile with libc memory allocation",
      "args": [
        {
          "name": "file",
          "description": "ATS source file to compile",
          "type": "file",
          "required": true
        }
      ],
      "options": [
        {
          "name": "-o",
          "description": "Path for the output binary",
          "type": "file",
          "takesValue": true
        }
      ]
    }
  ],
  "examples": [
    "patscc -o hello hello.dats",
    "patscc -tcats mylib.dats",
    "patscc -DATS_MEMALLOC_LIBC -o app main.dats utils.dats",
    "patscc -ccats module.dats",
    "patsopt --dynamic file.dats"
  ],
  "relatedCommands": [
    "gcc",
    "make",
    "c"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "ATS/Postiats compiler version",
        "command": "patscc --version 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "patscc"
      },
      {
        "name": "patshome",
        "description": "PATSHOME in effect",
        "command": "echo \"${PATSHOME:-unset}\"",
        "parser": "text",
        "cacheFor": 300
      },
      {
        "name": "sources",
        "description": "ATS sources",
        "command": "find . -maxdepth 3 -name '*.dats' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
