{
  "name": "sdkman",
  "aliases": [
    "sdk"
  ],
  "description": "Software Development Kit Manager for JVM languages",
  "category": "version-manager",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install a SDK version",
      "examples": [
        "sdk install java 21.0.1-tem",
        "sdk install gradle"
      ],
      "options": [],
      "args": [
        {
          "name": "candidate",
          "description": "SDK to install",
          "required": true,
          "type": "package"
        },
        {
          "name": "version",
          "description": "Version to install",
          "required": false,
          "type": "version"
        }
      ]
    },
    {
      "name": "use",
      "description": "Use a specific version in current shell",
      "examples": [
        "sdk use java 21.0.1-tem"
      ],
      "options": [],
      "args": [
        {
          "name": "candidate",
          "description": "SDK to switch",
          "required": true,
          "type": "package"
        },
        {
          "name": "version",
          "description": "Version to activate",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "default",
      "description": "Set default version",
      "examples": [
        "sdk default java 21.0.1-tem"
      ],
      "options": []
    },
    {
      "name": "list",
      "description": "List available versions",
      "examples": [
        "sdk list java",
        "sdk list gradle"
      ],
      "options": []
    },
    {
      "name": "current",
      "description": "Show current versions",
      "examples": [
        "sdk current",
        "sdk current java"
      ],
      "options": []
    },
    {
      "name": "uninstall",
      "description": "Uninstall a version",
      "examples": [
        "sdk uninstall java 17.0.1-tem"
      ],
      "options": [],
      "args": [
        {
          "name": "candidate",
          "description": "SDK to remove",
          "required": true,
          "type": "package"
        },
        {
          "name": "version",
          "description": "Version to remove",
          "required": true,
          "type": "version"
        }
      ]
    },
    {
      "name": "env",
      "description": "Load from .sdkmanrc",
      "examples": [
        "sdk env",
        "sdk env init"
      ],
      "options": []
    },
    {
      "name": "upgrade",
      "description": "Upgrade outdated versions",
      "examples": [
        "sdk upgrade"
      ],
      "options": []
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--offline",
      "description": "Work from the local cache without network access",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "sdk install java 21.0.1-tem",
    "sdk list java",
    "sdk use java 21.0.1-tem",
    "sdk current",
    "sdk default java 21.0.1-tem"
  ],
  "relatedCommands": [
    "java",
    "gradle",
    "mvn",
    "kotlin"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "current",
        "description": "SDKs sdkman has active",
        "command": "sdk current 2>/dev/null",
        "parser": "lines",
        "cacheFor": 60
      },
      {
        "name": "config",
        "description": "sdkman configuration",
        "command": "cat ~/.sdkman/etc/config 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 3600
      },
      {
        "name": "candidates",
        "description": "SDK candidates installed locally",
        "command": "ls ~/.sdkman/candidates 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "sdkmanrc",
        "description": "SDK versions pinned for this project",
        "command": "cat .sdkmanrc 2>/dev/null",
        "parser": "keyvalue",
        "cacheFor": 120
      }
    ]
  }
}
