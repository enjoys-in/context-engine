{
  "name": "vagrant",
  "description": "Build and manage reproducible development environments",
  "category": "devops",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Initialize a Vagrantfile",
      "examples": [
        "vagrant init ubuntu/jammy64"
      ],
      "options": [
        {
          "name": "--box-version",
          "description": "Box version constraint",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Overwrite an existing Vagrantfile",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--minimal",
          "description": "Write a Vagrantfile without comments",
          "type": "boolean",
          "takesValue": false,
          "short": "-m",
          "shorthand": "-m"
        },
        {
          "name": "--output",
          "description": "Path for the generated Vagrantfile",
          "type": "file",
          "takesValue": true
        }
      ]
    },
    {
      "name": "up",
      "description": "Start and provision VM",
      "examples": [
        "vagrant up"
      ],
      "options": [
        {
          "name": "--provider",
          "description": "Provider to bring the machine up with",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--provision",
          "description": "Force provisioning to run",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-provision",
          "description": "Skip provisioning",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--provision-with",
          "description": "Only run these provisioners",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--parallel",
          "description": "Bring machines up in parallel",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "ssh",
      "description": "SSH into the VM",
      "examples": [
        "vagrant ssh"
      ],
      "options": [
        {
          "name": "--command",
          "description": "Run this command instead of an interactive shell",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--plain",
          "description": "Connect without Vagrant's SSH options",
          "type": "boolean",
          "takesValue": false,
          "short": "-p",
          "shorthand": "-p"
        },
        {
          "name": "--no-tty",
          "description": "Do not allocate a TTY",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "halt",
      "description": "Stop the VM",
      "examples": [
        "vagrant halt"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Power off without a graceful shutdown",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ]
    },
    {
      "name": "destroy",
      "description": "Destroy the VM",
      "examples": [
        "vagrant destroy -f"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Destroy without confirming",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--graceful",
          "description": "Attempt a graceful shutdown first",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--parallel",
          "description": "Destroy machines in parallel",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "reload",
      "description": "Restart VM with new config",
      "examples": [
        "vagrant reload --provision"
      ],
      "options": [
        {
          "name": "--provision",
          "description": "Force provisioning to run",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-provision",
          "description": "Skip provisioning",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--provision-with",
          "description": "Only run these provisioners",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "provision",
      "description": "Run provisioners",
      "examples": [
        "vagrant provision"
      ],
      "options": [
        {
          "name": "--provision-with",
          "description": "Only run these provisioners",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "status",
      "description": "Show VM status",
      "examples": [
        "vagrant status"
      ],
      "options": []
    },
    {
      "name": "snapshot",
      "description": "Manage snapshots",
      "examples": [
        "vagrant snapshot save clean",
        "vagrant snapshot restore clean"
      ],
      "options": [
        {
          "name": "--name",
          "description": "Name for the snapshot",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--no-provision",
          "description": "Skip provisioning after restoring",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-start",
          "description": "Do not start the machine after restoring",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "box",
      "description": "Manage boxes",
      "examples": [
        "vagrant box list",
        "vagrant box add ubuntu/jammy64"
      ],
      "options": [
        {
          "name": "--box-version",
          "description": "Box version constraint",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--provider",
          "description": "Provider the box targets",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--force",
          "description": "Overwrite an existing box",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--clean",
          "description": "Remove the temporary download files",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "global-status",
      "description": "Show all VMs on host",
      "examples": [
        "vagrant global-status"
      ],
      "options": [
        {
          "name": "--prune",
          "description": "Remove stale entries from the index",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--debug",
      "description": "Enable debug-level logging",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--machine-readable",
      "description": "Emit machine-readable output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-color",
      "description": "Disable coloured output",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--no-tty",
      "description": "Do not use a TTY for output",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    "vagrant init ubuntu/jammy64",
    "vagrant up",
    "vagrant ssh",
    "vagrant halt",
    "vagrant destroy -f",
    "vagrant status"
  ],
  "relatedCommands": [
    "docker",
    "virtualbox",
    "terraform",
    "ansible"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Vagrant version",
        "command": "vagrant --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "vagrant"
      },
      {
        "name": "status",
        "description": "Status of machines defined by this Vagrantfile",
        "command": "vagrant status 2>/dev/null",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "vagrant"
      },
      {
        "name": "vagrantfile",
        "description": "Vagrant machine definition",
        "command": "cat Vagrantfile 2>/dev/null | grep -v '^ *#' | grep . | head -30",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "boxes",
        "description": "Vagrant boxes available locally",
        "command": "vagrant box list 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 3600,
        "requiresCmd": "vagrant"
      },
      {
        "name": "providers",
        "description": "Virtualisation providers available",
        "command": "which VBoxManage virsh qemu-system-x86_64 2>/dev/null",
        "parser": "lines",
        "cacheFor": 3600
      }
    ]
  }
}
