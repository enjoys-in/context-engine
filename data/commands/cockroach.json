{
  "name": "cockroach",
  "description": "CockroachDB command-line interface for cluster management and SQL",
  "category": "database",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "sql",
      "description": "Open SQL shell",
      "options": [
        {
          "name": "--url",
          "description": "Connection URL",
          "takesValue": true
        },
        {
          "name": "--host",
          "description": "Server host",
          "takesValue": true
        },
        {
          "name": "--port",
          "description": "Server port",
          "takesValue": true
        },
        {
          "name": "--user",
          "description": "Username",
          "takesValue": true
        },
        {
          "name": "--database",
          "shorthand": "-d",
          "description": "Database name",
          "takesValue": true,
          "short": "-d"
        },
        {
          "name": "--execute",
          "shorthand": "-e",
          "description": "Execute SQL",
          "takesValue": true,
          "short": "-e"
        },
        {
          "name": "--format",
          "description": "Output format (table, csv, tsv, json, html, raw, records)",
          "takesValue": true
        }
      ]
    },
    {
      "name": "start",
      "description": "Start a node",
      "options": [
        {
          "name": "--listen-addr",
          "description": "Listen address",
          "takesValue": true
        },
        {
          "name": "--advertise-addr",
          "description": "Advertise address",
          "takesValue": true
        },
        {
          "name": "--join",
          "description": "Join addresses",
          "takesValue": true
        },
        {
          "name": "--store",
          "description": "Store spec",
          "takesValue": true
        },
        {
          "name": "--insecure",
          "description": "Insecure mode"
        },
        {
          "name": "--certs-dir",
          "description": "Certs directory",
          "takesValue": true
        },
        {
          "name": "--background",
          "description": "Run in background"
        }
      ]
    },
    {
      "name": "start-single-node",
      "description": "Start single-node cluster",
      "options": [
        {
          "name": "--listen-addr",
          "description": "Listen address",
          "takesValue": true
        },
        {
          "name": "--store",
          "description": "Store spec",
          "takesValue": true
        },
        {
          "name": "--insecure",
          "description": "Insecure mode"
        }
      ]
    },
    {
      "name": "init",
      "description": "Initialize a cluster",
      "options": [
        {
          "name": "--host",
          "description": "Node to contact",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--certs-dir",
          "description": "Certificate directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--insecure",
          "description": "Connect without TLS",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "node",
      "description": "Node management",
      "subcommands": [
        {
          "name": "ls",
          "description": "List nodes",
          "options": [
            {
              "name": "--format",
              "description": "Output format (table, csv, tsv)",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--certs-dir",
              "description": "Certificate directory",
              "type": "directory",
              "takesValue": true
            }
          ]
        },
        {
          "name": "status",
          "description": "Node status",
          "options": [
            {
              "name": "--all",
              "description": "Show every status field",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--ranges",
              "description": "Include range statistics",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--stats",
              "description": "Include disk statistics",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--decommission",
              "description": "Include decommissioning detail",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "decommission",
          "description": "Decommission nodes",
          "options": [
            {
              "name": "--wait",
              "description": "When to return (all, none)",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--self",
              "description": "Decommission this node",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "recommission",
          "description": "Recommission nodes",
          "options": [
            {
              "name": "--self",
              "description": "Recommission this node",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "drain",
          "description": "Drain a node",
          "options": [
            {
              "name": "--drain-wait",
              "description": "How long to wait for the drain",
              "type": "string",
              "takesValue": true
            },
            {
              "name": "--self",
              "description": "Drain this node",
              "type": "boolean",
              "takesValue": false
            }
          ]
        }
      ]
    },
    {
      "name": "dump",
      "description": "Dump SQL tables",
      "args": [
        {
          "name": "database",
          "description": "Database name",
          "required": true
        }
      ],
      "options": [
        {
          "name": "--dump-mode",
          "description": "What to dump (both, schema, data)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--as-of",
          "description": "Dump as of this timestamp",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "demo",
      "description": "Start temporary in-memory cluster",
      "options": [
        {
          "name": "--nodes",
          "description": "Nodes in the demo cluster",
          "type": "integer",
          "takesValue": true
        },
        {
          "name": "--with-load",
          "description": "Generate background load",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--no-example-database",
          "description": "Skip the sample database",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "cert",
      "description": "Certificate management",
      "subcommands": [
        {
          "name": "create-ca",
          "description": "Create CA cert",
          "options": [
            {
              "name": "--certs-dir",
              "description": "Certificate directory",
              "type": "directory",
              "takesValue": true
            },
            {
              "name": "--ca-key",
              "description": "CA key path",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--allow-ca-key-reuse",
              "description": "Reuse an existing CA key",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "create-node",
          "description": "Create node cert",
          "options": [
            {
              "name": "--certs-dir",
              "description": "Certificate directory",
              "type": "directory",
              "takesValue": true
            },
            {
              "name": "--ca-key",
              "description": "CA key path",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--overwrite",
              "description": "Replace an existing certificate",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "create-client",
          "description": "Create client cert",
          "options": [
            {
              "name": "--certs-dir",
              "description": "Certificate directory",
              "type": "directory",
              "takesValue": true
            },
            {
              "name": "--ca-key",
              "description": "CA key path",
              "type": "file",
              "takesValue": true
            },
            {
              "name": "--also-generate-pkcs8-key",
              "description": "Also emit a PKCS#8 key",
              "type": "boolean",
              "takesValue": false
            }
          ]
        },
        {
          "name": "list",
          "description": "List certificates",
          "options": [
            {
              "name": "--certs-dir",
              "description": "Certificate directory",
              "type": "directory",
              "takesValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "options": [
        {
          "name": "--build-tag",
          "description": "Print only the build tag",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--url",
      "description": "Connection URL",
      "takesValue": true
    },
    {
      "name": "--certs-dir",
      "description": "Certificate directory",
      "takesValue": true
    },
    {
      "name": "--insecure",
      "description": "Insecure mode"
    },
    {
      "name": "--help",
      "description": "Show help"
    }
  ],
  "examples": [
    {
      "command": "cockroach sql --insecure",
      "description": "Open SQL shell"
    },
    {
      "command": "cockroach start-single-node --insecure --store=node1",
      "description": "Start single node"
    },
    {
      "command": "cockroach sql -e 'SHOW DATABASES' --insecure",
      "description": "List databases"
    },
    {
      "command": "cockroach demo",
      "description": "Temporary demo cluster"
    },
    {
      "command": "cockroach node status --insecure",
      "description": "Show node status"
    },
    {
      "command": "cockroach sql --url 'postgresql://root@localhost:26257/mydb?sslmode=disable'",
      "description": "Connect via URL"
    }
  ],
  "relatedCommands": [
    "psql",
    "pg_dump"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "databases",
        "description": "CockroachDB databases",
        "command": "cockroach sql --insecure -e 'SHOW DATABASES' --format=csv 2>/dev/null | tail -n +2",
        "parser": "lines",
        "cacheFor": 30,
        "requiresCmd": "cockroach"
      },
      {
        "name": "node_status",
        "description": "Cluster node status",
        "command": "cockroach node status --insecure 2>/dev/null | head -10",
        "parser": "text",
        "cacheFor": 30,
        "requiresCmd": "cockroach"
      },
      {
        "name": "version",
        "description": "CockroachDB version",
        "command": "cockroach version 2>/dev/null | head -3",
        "parser": "text",
        "cacheFor": 300,
        "requiresCmd": "cockroach"
      }
    ]
  }
}
