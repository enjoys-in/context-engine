{
  "name": "eleventy",
  "description": "Simple static site generator (11ty)",
  "category": "static-site",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--input",
      "description": "Input directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "description": "Output directory",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--serve",
      "description": "Start dev server with live reload"
    },
    {
      "name": "--watch",
      "description": "Watch for changes"
    },
    {
      "name": "--port",
      "description": "Server port",
      "type": "number",
      "takesValue": true
    },
    {
      "name": "--formats",
      "description": "Template formats to process",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--quiet",
      "description": "Suppress output"
    },
    {
      "name": "--config",
      "description": "Config file path",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "--dryrun",
      "description": "Simulate without writing"
    }
  ],
  "examples": [
    "eleventy",
    "eleventy --serve",
    "npx @11ty/eleventy --serve",
    "eleventy --input=src --output=dist",
    "eleventy --serve --port=8080"
  ],
  "relatedCommands": [
    "hugo",
    "jekyll",
    "gatsby",
    "astro"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Eleventy version",
        "command": "npx @11ty/eleventy --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600
      },
      {
        "name": "config",
        "description": "Eleventy configuration",
        "command": ".eleventy.js 2>/dev/null; cat .eleventy.js 2>/dev/null || cat eleventy.config.js 2>/dev/null",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "input_dir",
        "description": "Eleventy input and output directories",
        "command": "grep -E 'dir:|input:|output:' .eleventy.js eleventy.config.js 2>/dev/null | head -10",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "scripts",
        "description": "npm scripts declared in this project",
        "command": "grep -A25 '\"scripts\"' package.json 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
