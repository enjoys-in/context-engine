{
  "language": "xml",
  "name": "xmllint",
  "description": "XML command-line tool",
  "category": "development",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell"
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help information"
    },
    {
      "name": "--version",
      "description": "Show version information"
    },
    {
      "name": "--verbose",
      "description": "Enable verbose/detailed output"
    },
    {
      "name": "--quiet",
      "description": "Suppress non-error output",
      "alias": "-q"
    },
    {
      "name": "--debug",
      "description": "Enable debug mode for troubleshooting"
    },
    {
      "name": "--config",
      "description": "Specify configuration file path",
      "valueHint": "path"
    },
    {
      "name": "--output",
      "description": "Specify output directory or file",
      "valueHint": "path",
      "alias": "-o"
    },
    {
      "name": "--force",
      "description": "Force operation without confirmation",
      "alias": "-f"
    },
    {
      "name": "--dry-run",
      "description": "Preview what would happen without making changes"
    },
    {
      "name": "--no-color",
      "description": "Disable colored output"
    },
    {
      "name": "--format",
      "description": "Specify output format (json, text, table)",
      "valueHint": "format"
    },
    {
      "name": "--log-level",
      "description": "Set logging level (error, warn, info, debug)",
      "valueHint": "level"
    },
    {
      "name": "--interactive",
      "description": "Enable interactive prompts",
      "alias": "-i"
    },
    {
      "name": "--silent",
      "description": "Suppress all output except errors"
    },
    {
      "name": "--strict",
      "description": "Enable strict mode with additional checks"
    },
    {
      "name": "--color",
      "description": "Force colored output even when not a TTY"
    },
    {
      "name": "--working-dir",
      "description": "Set the working directory",
      "valueHint": "dir",
      "alias": "-d"
    }
  ],
  "subcommands": [
    {
      "name": "--format file.xml",
      "description": "Format/pretty print",
      "args": [],
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pretty",
          "description": "Pretty-print style to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "xmllint --format config.xml",
        "xmllint --format --output pretty.xml config.xml"
      ]
    },
    {
      "name": "--valid file.xml",
      "description": "Validate DTD",
      "args": [],
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--dtdvalid",
          "description": "Validate against this DTD",
          "type": "file",
          "takesValue": true
        }
      ],
      "examples": [
        "xmllint --valid --noout doc.xml"
      ]
    },
    {
      "name": "--schema schema.xsd file.xml",
      "description": "Validate XSD",
      "args": [],
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "xmllint --schema schema.xsd --noout doc.xml"
      ]
    },
    {
      "name": "--xpath expr file.xml",
      "description": "Query with XPath",
      "args": [],
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--shell",
          "description": "Enter the interactive XPath shell",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "xmllint --xpath '//book/title/text()' catalog.xml"
      ]
    },
    {
      "name": "validate",
      "description": "Validate XML against schema",
      "usage": "xmllint --schema schema.xsd file.xml",
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--relaxng",
          "description": "Validate against this RELAX NG schema",
          "type": "file",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "XML document to validate",
          "required": true,
          "type": "file"
        }
      ],
      "examples": [
        "xmllint --noout --schema schema.xsd doc.xml",
        "xmllint --noout --relaxng schema.rng doc.xml"
      ]
    },
    {
      "name": "format",
      "description": "Format/pretty-print XML",
      "usage": "xmllint --format file.xml",
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pretty",
          "description": "Pretty-print style to use",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "XML document to format",
          "required": true,
          "type": "file"
        }
      ],
      "examples": [
        "xmllint --format doc.xml",
        "xmllint --format --encode UTF-8 doc.xml"
      ]
    },
    {
      "name": "xpath",
      "description": "Query XML with XPath",
      "usage": "xmllint --xpath '//element' file.xml",
      "options": [
        {
          "name": "--noout",
          "description": "Suppress the output document",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--encode",
          "description": "Output encoding to use",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nonet",
          "description": "Never fetch remote resources",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recover",
          "description": "Continue past well-formedness errors",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "xmllint --xpath 'count(//item)' catalog.xml",
        "xmllint --shell catalog.xml"
      ]
    },
    {
      "name": "transform",
      "description": "Apply XSLT transformation",
      "usage": "xsltproc style.xsl file.xml",
      "options": [
        {
          "name": "--output",
          "description": "Write the result here",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--stringparam",
          "description": "Pass a string parameter to the stylesheet",
          "type": "string",
          "takesValue": true
        }
      ],
      "examples": [
        "xsltproc style.xsl input.xml",
        "xsltproc --output out.html style.xsl input.xml"
      ]
    }
  ],
  "examples": [
    {
      "command": "xmllint --format file.xml",
      "description": "Pretty-print XML file"
    },
    {
      "command": "xmllint --schema schema.xsd file.xml",
      "description": "Validate XML against XSD schema"
    },
    {
      "command": "xmllint --xpath '//element' file.xml",
      "description": "Query XML with XPath"
    },
    {
      "command": "xsltproc style.xsl file.xml",
      "description": "Apply XSLT transformation"
    }
  ],
  "relatedCommands": [
    "xmllint",
    "xsltproc",
    "xmlstarlet",
    "yq"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "xmllint version",
        "command": "xmllint --version 2>&1 | head -1",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "xmllint"
      },
      {
        "name": "documents",
        "description": "XML documents in this directory",
        "command": "find . -maxdepth 2 -name '*.xml' -not -path './node_modules/*' 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "schemas",
        "description": "XML schemas available for validation",
        "command": "find . -maxdepth 3 -name '*.xsd' -o -maxdepth 3 -name '*.dtd' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  },
  "aliases": [
    "xml"
  ]
}
