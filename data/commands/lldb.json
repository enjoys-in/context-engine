{
  "name": "lldb",
  "description": "LLVM debugger",
  "category": "toolchain",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--attach-pid",
      "description": "Attach to this process",
      "type": "integer",
      "takesValue": true,
      "short": "-p",
      "shorthand": "-p"
    },
    {
      "name": "--attach-name",
      "description": "Attach to a process by name",
      "type": "string",
      "takesValue": true,
      "short": "-n",
      "shorthand": "-n"
    },
    {
      "name": "--core",
      "description": "Load this core dump",
      "type": "file",
      "takesValue": true,
      "short": "-c",
      "shorthand": "-c"
    },
    {
      "name": "--batch",
      "description": "Run the commands and exit",
      "type": "boolean",
      "takesValue": false,
      "short": "-b",
      "shorthand": "-b"
    },
    {
      "name": "--one-line",
      "description": "Execute this command after loading",
      "type": "string",
      "takesValue": true,
      "short": "-o",
      "shorthand": "-o"
    },
    {
      "name": "--source",
      "description": "Run commands from this file",
      "type": "file",
      "takesValue": true,
      "short": "-s",
      "shorthand": "-s"
    },
    {
      "name": "--arch",
      "description": "Architecture to debug",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--no-lldbinit",
      "description": "Skip the .lldbinit file",
      "type": "boolean",
      "takesValue": false,
      "short": "-x",
      "shorthand": "-x"
    }
  ],
  "examples": [
    {
      "command": "lldb ./prog",
      "description": "Debug a binary"
    },
    {
      "command": "lldb -- ./prog --flag input.txt",
      "description": "Debug with program arguments"
    },
    {
      "command": "lldb -p 12345",
      "description": "Attach to a running process"
    },
    {
      "command": "lldb -b -o \"bt\" -c core.1234 ./prog",
      "description": "Print a backtrace non-interactively"
    }
  ],
  "relatedCommands": [
    "gdb",
    "valgrind",
    "swift",
    "clang"
  ]
}
