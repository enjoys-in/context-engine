{
  "name": "render",
  "description": "Render CLI for managing Render cloud services and deployments",
  "category": "cloud",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "powershell",
    "fish"
  ],
  "subcommands": [
    {
      "name": "services",
      "description": "Manage services",
      "subcommands": [
        {
          "name": "list",
          "description": "List all services",
          "options": [
            {
              "name": "--type",
              "description": "Filter by type (web, worker, cron, static)",
              "takesValue": true
            }
          ],
          "examples": [
            "render services list"
          ]
        },
        {
          "name": "show",
          "description": "Show service details",
          "args": [
            {
              "name": "service-id",
              "description": "Service ID",
              "required": true,
              "type": "service",
              "completion": {
                "detector": "services"
              }
            }
          ],
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "render services show web"
          ]
        },
        {
          "name": "tail",
          "description": "Tail service logs",
          "args": [
            {
              "name": "service-id",
              "description": "Service ID",
              "required": true,
              "type": "service",
              "completion": {
                "detector": "services"
              }
            }
          ],
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--limit",
              "description": "Number of recent log lines to show",
              "type": "integer",
              "takesValue": true
            }
          ],
          "examples": [
            "render services tail web"
          ]
        }
      ]
    },
    {
      "name": "deploys",
      "description": "Manage deployments",
      "subcommands": [
        {
          "name": "list",
          "description": "List recent deploys",
          "args": [
            {
              "name": "service-id",
              "description": "Service ID",
              "required": true,
              "type": "service",
              "completion": {
                "detector": "services"
              }
            }
          ],
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--limit",
              "description": "Number of deploys to list",
              "type": "integer",
              "takesValue": true
            }
          ],
          "examples": [
            "render deploys list web"
          ]
        },
        {
          "name": "create",
          "description": "Trigger a deploy",
          "args": [
            {
              "name": "service-id",
              "description": "Service ID",
              "required": true,
              "type": "service",
              "completion": {
                "detector": "services"
              }
            }
          ],
          "options": [
            {
              "name": "--clear-cache",
              "description": "Clear build cache"
            }
          ],
          "examples": [
            "render deploys create web"
          ]
        }
      ]
    },
    {
      "name": "env-groups",
      "description": "Manage environment groups",
      "subcommands": [
        {
          "name": "list",
          "description": "List env groups",
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "render env-groups list"
          ]
        },
        {
          "name": "show",
          "description": "Show env group details",
          "args": [
            {
              "name": "name",
              "description": "Group name",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "render env-groups show name"
          ]
        }
      ]
    },
    {
      "name": "custom-domains",
      "description": "Manage custom domains",
      "subcommands": [
        {
          "name": "list",
          "description": "List custom domains for a service",
          "args": [
            {
              "name": "service-id",
              "description": "Service ID",
              "required": true,
              "type": "service",
              "completion": {
                "detector": "services"
              }
            }
          ],
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "render custom-domains list web"
          ]
        }
      ]
    },
    {
      "name": "blueprints",
      "description": "Manage infrastructure as code blueprints",
      "subcommands": [
        {
          "name": "list",
          "description": "List blueprints",
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            }
          ],
          "examples": [
            "render blueprints list"
          ]
        },
        {
          "name": "launch",
          "description": "Launch a blueprint",
          "args": [
            {
              "name": "file",
              "description": "Blueprint file",
              "required": true
            }
          ],
          "options": [
            {
              "name": "--output",
              "description": "Output format: json, yaml or text",
              "type": "string",
              "takesValue": true,
              "short": "-o",
              "shorthand": "-o"
            },
            {
              "name": "--confirm",
              "description": "Skip the confirmation prompt",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--pretty",
              "description": "Human-readable output",
              "type": "boolean",
              "takesValue": false
            },
            {
              "name": "--branch",
              "description": "Branch to launch from",
              "type": "string",
              "takesValue": true
            }
          ],
          "examples": [
            "render blueprints launch file"
          ]
        }
      ]
    },
    {
      "name": "regions",
      "description": "List available regions",
      "options": [
        {
          "name": "--output",
          "description": "Output format: json, yaml or text",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--confirm",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--pretty",
          "description": "Human-readable output",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "render regions"
      ]
    },
    {
      "name": "login",
      "description": "Log in to Render",
      "options": [
        {
          "name": "--output",
          "description": "Output format: json, yaml or text",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "examples": [
        "render login"
      ]
    },
    {
      "name": "logout",
      "description": "Log out",
      "options": [
        {
          "name": "--confirm",
          "description": "Skip the confirmation prompt",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "examples": [
        "render logout"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--output",
      "shorthand": "-o",
      "description": "Output format (json, yaml, table)",
      "takesValue": true,
      "short": "-o"
    },
    {
      "name": "--profile",
      "description": "Config profile",
      "takesValue": true
    },
    {
      "name": "--help",
      "shorthand": "-h",
      "description": "Show help",
      "short": "-h"
    },
    {
      "name": "--version",
      "shorthand": "-v",
      "description": "Show version",
      "short": "-v"
    }
  ],
  "examples": [
    {
      "command": "render services list",
      "description": "List all services"
    },
    {
      "command": "render deploys create srv-abc123",
      "description": "Trigger a new deploy"
    },
    {
      "command": "render services tail srv-abc123",
      "description": "Tail logs for a service"
    },
    {
      "command": "render blueprints launch render.yaml",
      "description": "Launch infrastructure from blueprint"
    }
  ],
  "relatedCommands": [
    "vercel",
    "railway",
    "flyctl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "services",
        "description": "List Render services",
        "command": "render services list --output json 2>/dev/null",
        "parser": "json",
        "cacheFor": 120,
        "requiresCmd": "render"
      },
      {
        "name": "blueprint",
        "description": "Local render.yaml blueprint",
        "command": "cat render.yaml 2>/dev/null || cat render.yml 2>/dev/null",
        "parser": "text",
        "cacheFor": 60
      },
      {
        "name": "regions",
        "description": "Available regions",
        "command": "render regions --output json 2>/dev/null",
        "parser": "json",
        "cacheFor": 3600,
        "requiresCmd": "render"
      }
    ]
  }
}
