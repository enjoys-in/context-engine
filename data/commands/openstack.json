  "subcommands": [
    {
      "name": "server",
      "description": "Manage compute instances",
      "examples": [
        "openstack server list",
        "openstack server create --flavor m1.small --image ubuntu-22 --network private --key-name mykey myserver",
        "openstack server delete myserver",
        "openstack server show myserver",
        "openstack server start myserver",
        "openstack server stop myserver",
        "openstack server reboot myserver",
        "openstack server ssh myserver"
      ],
      "options": [
        {
          "name": "--os-cloud",
          "description": "Named cloud from clouds.yaml",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--os-project-name",
          "description": "Project scope for the request",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--os-region-name",
          "description": "Region to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--format",
          "description": "Output format: table, csv, json, value or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--column",
          "description": "Restrict output to these columns",
          "type": "string",
          "takesValue": true,
          "short": "-c",
          "shorthand": "-c"
        },
        {
          "name": "--quiet",
          "description": "Suppress warning output",
          "type": "boolean",
          "takesValue": false,
          "short": "-q",
          "shorthand": "-q"
        },
        {
          "name": "--debug",
          "description": "Show full API request and response bodies",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Operation to run against server, such as list",
          "type": "string",
          "required": true
        }
      ]
    },
