{
  "name": "kustomize",
  "description": "Kustomize — customize Kubernetes YAML configurations",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "build",
      "description": "Build kustomization target",
      "examples": [
        "kustomize build .",
        "kustomize build ./overlays/production",
        "kustomize build . | kubectl apply -f -",
        "kustomize build --enable-helm .",
        "kustomize build --load-restrictor LoadRestrictionsNone ."
      ],
      "options": [
        {
          "name": "--output",
          "description": "Write the result here rather than stdout",
          "type": "file",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--enable-helm",
          "description": "Allow the helmCharts field to run helm template",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--load-restrictor",
          "description": "Restrict file loading outside the root (LoadRestrictionsNone)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--enable-alpha-plugins",
          "description": "Allow alpha plugins to run",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--reorder",
          "description": "Output ordering (legacy, none)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "edit",
      "description": "Edit kustomization file",
      "examples": [
        "kustomize edit add resource deployment.yaml",
        "kustomize edit add configmap my-cm --from-literal=key=value",
        "kustomize edit set namespace production",
        "kustomize edit set image my-image=my-image:v2",
        "kustomize edit add patch --path patch.yaml",
        "kustomize edit set nameprefix prod-",
        "kustomize edit add label app:myapp",
        "kustomize edit add annotation team:backend",
        "kustomize edit remove resource old.yaml"
      ],
      "options": [
        {
          "name": "--from-file",
          "description": "Create a secret or configmap from this file",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--from-literal",
          "description": "Create an entry from key=value",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "subcommand",
          "description": "Edit subcommand, such as set or add",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "create",
      "description": "Create kustomization file",
      "examples": [
        "kustomize create",
        "kustomize create --resources deployment.yaml,service.yaml",
        "kustomize create --autodetect"
      ],
      "options": [
        {
          "name": "--resources",
          "description": "Resources to include",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namespace",
          "description": "Namespace to set",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--nameprefix",
          "description": "Prefix for every resource name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namesuffix",
          "description": "Suffix for every resource name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--autodetect",
          "description": "Detect resources in the current directory",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--recursive",
          "description": "Recurse when autodetecting",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "resources",
          "description": "Resources to seed the kustomization with",
          "required": false,
          "type": "path"
        }
      ]
    },
    {
      "name": "cfg",
      "description": "Config function commands",
      "examples": [
        "kustomize cfg tree .",
        "kustomize cfg grep 'kind=Deployment' .",
        "kustomize cfg cat .",
        "kustomize cfg count .",
        "kustomize cfg fmt ."
      ],
      "options": [
        {
          "name": "--recurse-subpackages",
          "description": "Operate on subpackages too",
          "type": "boolean",
          "takesValue": false,
          "short": "-R",
          "shorthand": "-R"
        }
      ]
    },
    {
      "name": "fn",
      "description": "Function commands",
      "examples": [
        "kustomize fn run .",
        "kustomize fn source .",
        "kustomize fn sink .",
        "kustomize fn wrap ."
      ],
      "options": [
        {
          "name": "--image",
          "description": "Function image to run",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--network",
          "description": "Give the function network access",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--mount",
          "description": "Mount a host path into the function",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "localize",
      "description": "Localize remote references",
      "examples": [
        "kustomize localize . ./localized"
      ],
      "options": [
        {
          "name": "--scope",
          "description": "Restrict localization to this directory",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--no-verify",
          "description": "Skip verifying the result builds",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "completion",
      "description": "Generate shell completion",
      "examples": [
        "source <(kustomize completion bash)"
      ],
      "options": []
    },
    {
      "name": "version",
      "description": "Print version",
      "examples": [
        "kustomize version"
      ],
      "options": [
        {
          "name": "--short",
          "description": "Print just the version number",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--enable-helm",
      "description": "Enable Helm chart inflation"
    },
    {
      "name": "--load-restrictor",
      "description": "Load restrictions",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--reorder",
      "description": "Reorder output (legacy, none)",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output to file",
      "type": "string",
      "takesValue": true,
      "shorthand": "-o"
    }
  ],
  "examples": [
    "kustomize build .",
    "kustomize build ./overlays/production | kubectl apply -f -",
    "kustomize edit set image my-image=my-image:v2",
    "kustomize edit set namespace production",
    "kustomize edit add resource deployment.yaml",
    "kustomize create --autodetect",
    "kubectl apply -k .",
    "kustomize build --enable-helm .",
    "kustomize cfg tree .",
    "kustomize version"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "flux",
    "argocd"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "kustomize version",
        "command": "kustomize version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "kustomize"
      },
      {
        "name": "kustomizations",
        "description": "Kustomization files in this project",
        "command": "find . -maxdepth 4 -name 'kustomization.yaml' -o -maxdepth 4 -name 'kustomization.yml' 2>/dev/null | head -15",
        "parser": "lines",
        "cacheFor": 120
      },
      {
        "name": "bases",
        "description": "Bases and overlays referenced",
        "command": "grep -A10 '^resources:' kustomization.yaml 2>/dev/null",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
