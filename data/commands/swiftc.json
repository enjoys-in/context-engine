{
  "name": "swiftc",
  "description": "Swift compiler",
  "category": "language",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "-o",
      "description": "Output file",
      "type": "file",
      "takesValue": true
    },
    {
      "name": "-O",
      "description": "Optimize for speed"
    },
    {
      "name": "-Osize",
      "description": "Optimize for size"
    },
    {
      "name": "-g",
      "description": "Include debug info"
    },
    {
      "name": "-emit-library",
      "description": "Emit dynamic library"
    },
    {
      "name": "-emit-object",
      "description": "Emit object file"
    },
    {
      "name": "-module-name",
      "description": "Module name",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-target",
      "description": "Target triple",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-I",
      "description": "Add import search path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-L",
      "description": "Add library search path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "-warnings-as-errors",
      "description": "Treat warnings as errors"
    },
    {
      "name": "-parse-as-library",
      "description": "Parse as library (no main)"
    }
  ],
  "examples": [
    "swiftc main.swift",
    "swiftc -o hello main.swift",
    "swiftc -O -o app main.swift",
    "swiftc -emit-library -o libutil.dylib util.swift",
    "swift main.swift"
  ],
  "relatedCommands": [
    "swift",
    "xcodebuild",
    "spm",
    "lldb"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Swift compiler version",
        "command": "swiftc --version 2>/dev/null | head -2",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "swiftc"
      },
      {
        "name": "target",
        "description": "Swift default target triple",
        "command": "swiftc -print-target-info 2>/dev/null | head -20",
        "parser": "json",
        "cacheFor": 3600,
        "requiresCmd": "swiftc"
      },
      {
        "name": "package",
        "description": "Swift package manifest",
        "command": "cat Package.swift 2>/dev/null | head -40",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "sources",
        "description": "Swift sources",
        "command": "find . -maxdepth 3 -name '*.swift' 2>/dev/null | head -20",
        "parser": "lines",
        "cacheFor": 120
      }
    ]
  }
}
