{
  "name": "nano",
  "description": "Small, friendly terminal text editor",
  "category": "editor",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    },
    {
      "name": "--linenumbers",
      "description": "Show line numbers",
      "type": "boolean",
      "takesValue": false,
      "short": "-l",
      "shorthand": "-l"
    },
    {
      "name": "--mouse",
      "description": "Enable mouse support",
      "type": "boolean",
      "takesValue": false,
      "short": "-m",
      "shorthand": "-m"
    },
    {
      "name": "--softwrap",
      "description": "Wrap long lines visually",
      "type": "boolean",
      "takesValue": false,
      "short": "-$",
      "shorthand": "-$"
    },
    {
      "name": "--tabstospaces",
      "description": "Convert typed tabs to spaces",
      "type": "boolean",
      "takesValue": false,
      "short": "-E",
      "shorthand": "-E"
    },
    {
      "name": "--tabsize",
      "description": "Width of a tab",
      "type": "integer",
      "takesValue": true,
      "short": "-T",
      "shorthand": "-T"
    },
    {
      "name": "--syntax",
      "description": "Syntax definition to use",
      "type": "string",
      "takesValue": true,
      "short": "-Y",
      "shorthand": "-Y"
    },
    {
      "name": "--backup",
      "description": "Save a backup of the previous version",
      "type": "boolean",
      "takesValue": false,
      "short": "-B",
      "shorthand": "-B"
    },
    {
      "name": "--readonly",
      "description": "Open without allowing writes",
      "type": "boolean",
      "takesValue": false,
      "short": "-v",
      "shorthand": "-v"
    },
    {
      "name": "--ignorercfiles",
      "description": "Skip nanorc configuration",
      "type": "boolean",
      "takesValue": false,
      "short": "-I",
      "shorthand": "-I"
    }
  ],
  "examples": [
    {
      "command": "nano notes.md",
      "description": "Open a file"
    },
    {
      "command": "nano -l +42 main.c",
      "description": "Open at line 42 with line numbers"
    },
    {
      "command": "nano -ET4 setup.py",
      "description": "Use 4 spaces instead of tabs"
    }
  ],
  "relatedCommands": [
    "vim",
    "nvim",
    "micro",
    "emacs"
  ]
}
