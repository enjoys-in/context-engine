{
  "name": "git-crypt",
  "description": "Transparent file encryption inside a git repository",
  "category": "security",
  "platforms": [
    "linux",
    "macos"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell",
    "cmd"
  ],
  "subcommands": [
    {
      "name": "init",
      "description": "Set up git-crypt in the repository",
      "options": [
        {
          "name": "--key-name",
          "description": "Named key to create",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ],
      "examples": [
        "git-crypt init"
      ]
    },
    {
      "name": "lock",
      "description": "Re-encrypt the working tree",
      "options": [
        {
          "name": "--force",
          "description": "Lock even with unstaged changes",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--all",
          "description": "Lock every key",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--key-name",
          "description": "Key to lock",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ],
      "examples": [
        "git-crypt lock"
      ]
    },
    {
      "name": "unlock",
      "description": "Decrypt the working tree",
      "args": [
        {
          "name": "keyfile",
          "description": "Symmetric key file",
          "type": "file",
          "required": false
        }
      ],
      "options": [],
      "examples": [
        "git-crypt unlock key.pem"
      ]
    },
    {
      "name": "add-gpg-user",
      "description": "Grant access to a GPG user",
      "options": [
        {
          "name": "--trusted",
          "description": "Trust the key without verification",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--key-name",
          "description": "Key to share",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ],
      "args": [
        {
          "name": "user",
          "description": "GPG user id",
          "type": "string",
          "required": true
        }
      ],
      "examples": [
        "git-crypt add-gpg-user user"
      ]
    },
    {
      "name": "rm-gpg-user",
      "description": "Revoke a GPG user",
      "args": [
        {
          "name": "user",
          "description": "GPG user id",
          "type": "string",
          "required": true
        }
      ],
      "options": [],
      "examples": [
        "git-crypt rm-gpg-user user"
      ]
    },
    {
      "name": "ls-gpg-users",
      "description": "List the GPG users with access",
      "options": [],
      "examples": [
        "git-crypt ls-gpg-users"
      ]
    },
    {
      "name": "export-key",
      "description": "Write the symmetric key to a file",
      "options": [
        {
          "name": "--key-name",
          "description": "Key to export",
          "type": "string",
          "takesValue": true,
          "short": "-k",
          "shorthand": "-k"
        }
      ],
      "args": [
        {
          "name": "file",
          "description": "File to write",
          "type": "file",
          "required": true
        }
      ],
      "examples": [
        "git-crypt export-key file.txt"
      ]
    },
    {
      "name": "status",
      "description": "Show which files are encrypted",
      "options": [
        {
          "name": "--encrypted",
          "description": "List only encrypted files",
          "type": "boolean",
          "takesValue": false,
          "short": "-e",
          "shorthand": "-e"
        },
        {
          "name": "--unencrypted",
          "description": "List only unencrypted files",
          "type": "boolean",
          "takesValue": false,
          "short": "-u",
          "shorthand": "-u"
        },
        {
          "name": "--fix",
          "description": "Re-stage files whose state is wrong",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        }
      ],
      "examples": [
        "git-crypt status"
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--help",
      "description": "Show help for this command",
      "type": "boolean",
      "takesValue": false,
      "short": "-h",
      "shorthand": "-h"
    },
    {
      "name": "--version",
      "description": "Show the installed version",
      "type": "boolean",
      "takesValue": false
    }
  ],
  "examples": [
    {
      "command": "git-crypt init",
      "description": "Initialise encryption in the repository"
    },
    {
      "command": "git-crypt add-gpg-user alice@example.com",
      "description": "Grant a collaborator access"
    },
    {
      "command": "git-crypt status -e",
      "description": "List the encrypted files"
    },
    {
      "command": "git-crypt unlock keyfile",
      "description": "Decrypt using a symmetric key"
    }
  ],
  "relatedCommands": [
    "sops",
    "age",
    "gpg",
    "gitleaks",
    "vault"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "git-crypt version",
        "command": "git-crypt --version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "git-crypt"
      },
      {
        "name": "status",
        "description": "Encryption status of tracked files",
        "command": "git-crypt status 2>/dev/null | head -25",
        "parser": "lines",
        "cacheFor": 60,
        "requiresCmd": "git-crypt"
      },
      {
        "name": "attributes",
        "description": "git-crypt filters declared in .gitattributes",
        "command": "grep 'git-crypt' .gitattributes 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      },
      {
        "name": "keys",
        "description": "git-crypt keys in this repository",
        "command": "ls .git/git-crypt/keys 2>/dev/null",
        "parser": "lines",
        "cacheFor": 300
      }
    ]
  }
}
