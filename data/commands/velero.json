{
  "name": "velero",
  "description": "Velero — backup and restore Kubernetes resources and persistent volumes",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "install",
      "description": "Install Velero server",
      "examples": [
        "velero install --provider aws --bucket my-bucket --secret-file ./credentials --backup-location-config region=us-east-1",
        "velero install --provider gcp --bucket my-bucket --secret-file ./credentials"
      ],
      "options": [
        {
          "name": "--provider",
          "description": "Object storage provider",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--bucket",
          "description": "Bucket to store backups in",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--secret-file",
          "description": "Credentials file for the provider",
          "type": "file",
          "takesValue": true
        },
        {
          "name": "--use-node-agent",
          "description": "Deploy the node agent for filesystem backups",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--namespace",
          "description": "Namespace to install into",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--plugins",
          "description": "Plugin images to install",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--dry-run",
          "description": "Print the manifests instead of applying them",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--wait",
          "description": "Block until Velero is ready",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "backup",
      "description": "Manage backups",
      "examples": [
        "velero backup create my-backup",
        "velero backup create my-backup --include-namespaces ns1,ns2",
        "velero backup create my-backup --exclude-resources configmaps",
        "velero backup create my-backup --ttl 720h",
        "velero backup get",
        "velero backup describe my-backup",
        "velero backup logs my-backup",
        "velero backup delete my-backup"
      ],
      "options": [
        {
          "name": "--include-namespaces",
          "description": "Namespaces to include",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--exclude-namespaces",
          "description": "Namespaces to exclude",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--include-resources",
          "description": "Resource types to include",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--exclude-resources",
          "description": "Resource types to exclude",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--selector",
          "description": "Label selector for the resources to back up",
          "type": "string",
          "takesValue": true,
          "short": "-l",
          "shorthand": "-l"
        },
        {
          "name": "--snapshot-volumes",
          "description": "Take volume snapshots",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--default-volumes-to-fs-backup",
          "description": "Use filesystem backup for volumes by default",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--ttl",
          "description": "How long to retain the backup, e.g. 720h",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--storage-location",
          "description": "Backup storage location to write to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Block until the operation completes",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "restore",
      "description": "Manage restores",
      "examples": [
        "velero restore create --from-backup my-backup",
        "velero restore create --from-backup my-backup --include-namespaces ns1",
        "velero restore create --from-backup my-backup --restore-volumes=true",
        "velero restore get",
        "velero restore describe my-restore",
        "velero restore logs my-restore",
        "velero restore delete my-restore"
      ],
      "options": [
        {
          "name": "--from-backup",
          "description": "Backup to restore from",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--from-schedule",
          "description": "Restore the latest backup from this schedule",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--include-namespaces",
          "description": "Namespaces to include",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--exclude-namespaces",
          "description": "Namespaces to exclude",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--namespace-mappings",
          "description": "Remap namespaces, old:new",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--restore-volumes",
          "description": "Restore volumes from snapshots",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--existing-resource-policy",
          "description": "What to do with existing resources (none, update)",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--wait",
          "description": "Block until the operation completes",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "name",
          "description": "Backup to restore from",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "schedule",
      "description": "Manage backup schedules",
      "examples": [
        "velero schedule create daily --schedule='0 1 * * *'",
        "velero schedule create daily --schedule='0 1 * * *' --include-namespaces production",
        "velero schedule get",
        "velero schedule describe daily",
        "velero schedule delete daily"
      ],
      "options": [
        {
          "name": "--schedule",
          "description": "Cron expression for the schedule",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--ttl",
          "description": "How long to retain each backup",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--include-namespaces",
          "description": "Namespaces to include",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--paused",
          "description": "Create the schedule paused",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "backup-location",
      "description": "Manage backup locations",
      "examples": [
        "velero backup-location get",
        "velero backup-location create secondary --provider aws --bucket secondary-bucket --config region=eu-west-1"
      ],
      "options": [
        {
          "name": "--provider",
          "description": "Object storage provider",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--bucket",
          "description": "Bucket name",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--default",
          "description": "Make this the default location",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--access-mode",
          "description": "Access mode (ReadWrite, ReadOnly)",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "snapshot-location",
      "description": "Manage volume snapshot locations",
      "examples": [
        "velero snapshot-location get",
        "velero snapshot-location create default --provider aws --config region=us-east-1"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Velero namespace",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "plugin",
      "description": "Manage plugins",
      "examples": [
        "velero plugin get",
        "velero plugin add velero/velero-plugin-for-aws:v1.5.0"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Velero namespace",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        }
      ]
    },
    {
      "name": "uninstall",
      "description": "Uninstall Velero",
      "examples": [
        "velero uninstall"
      ],
      "options": [
        {
          "name": "--namespace",
          "description": "Velero namespace",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--force",
          "description": "Uninstall without confirming",
          "type": "boolean",
          "takesValue": false
        }
      ]
    },
    {
      "name": "version",
      "description": "Show version",
      "examples": [
        "velero version"
      ],
      "options": [
        {
          "name": "--client-only",
          "description": "Print only the client version",
          "type": "boolean",
          "takesValue": false
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--kubeconfig",
      "description": "Kubeconfig path",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--kubecontext",
      "description": "Kubernetes context",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--namespace",
      "short": "-n",
      "description": "Namespace (default: velero)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-n"
    },
    {
      "name": "--output",
      "short": "-o",
      "description": "Output format (json, table)",
      "type": "string",
      "takesValue": true,
      "shorthand": "-o"
    }
  ],
  "examples": [
    "velero backup create my-backup",
    "velero backup get",
    "velero restore create --from-backup my-backup",
    "velero schedule create daily --schedule='0 1 * * *'",
    "velero backup logs my-backup",
    "velero backup-location get",
    "velero version"
  ],
  "relatedCommands": [
    "kubectl",
    "helm",
    "restic",
    "etcdctl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Velero CLI and server versions",
        "command": "velero version --client-only 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "velero"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "backups",
        "description": "Velero backups",
        "command": "velero backup get 2>/dev/null | head -20",
        "parser": "table",
        "cacheFor": 60,
        "requiresCmd": "velero"
      },
      {
        "name": "schedules",
        "description": "Velero backup schedules",
        "command": "velero schedule get 2>/dev/null",
        "parser": "table",
        "cacheFor": 300,
        "requiresCmd": "velero"
      }
    ]
  }
}
