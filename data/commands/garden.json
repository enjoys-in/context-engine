{
  "name": "garden",
  "description": "Garden — automate building, deploying, and testing Kubernetes apps",
  "category": "containers",
  "platforms": [
    "linux",
    "macos",
    "windows"
  ],
  "shells": [
    "bash",
    "zsh",
    "fish",
    "powershell"
  ],
  "subcommands": [
    {
      "name": "deploy",
      "description": "Deploy actions/services",
      "examples": [
        "garden deploy",
        "garden deploy my-service",
        "garden deploy --force"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Force redeploy even when up to date",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--force-build",
          "description": "Rebuild before deploying",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--watch",
          "description": "Watch for changes and redeploy",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--sync",
          "description": "Start sync mode for these actions",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env",
          "description": "Environment to deploy to",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--var",
          "description": "Set a Garden variable",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "args": [
        {
          "name": "names",
          "description": "Deploy actions to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "dev",
      "description": "Start development mode",
      "examples": [
        "garden dev",
        "garden dev my-service"
      ],
      "options": [
        {
          "name": "--cmd",
          "description": "Run this command on start",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env",
          "description": "Environment to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--var",
          "description": "Set a Garden variable",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "names",
          "description": "Actions to develop",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "build",
      "description": "Build modules/actions",
      "examples": [
        "garden build",
        "garden build my-module"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Rebuild even when up to date",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--watch",
          "description": "Watch for changes and rebuild",
          "type": "boolean",
          "takesValue": false,
          "short": "-w",
          "shorthand": "-w"
        },
        {
          "name": "--with-dependants",
          "description": "Also build actions that depend on these",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to target",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "names",
          "description": "Build actions to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "test",
      "description": "Run tests",
      "examples": [
        "garden test",
        "garden test my-module",
        "garden test --force"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Re-run tests even when cached",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--force-build",
          "description": "Rebuild before testing",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--name",
          "description": "Run only tests matching this name",
          "type": "string",
          "takesValue": true,
          "short": "-n",
          "shorthand": "-n"
        },
        {
          "name": "--interactive",
          "description": "Attach to the test container",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--env",
          "description": "Environment to target",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "names",
          "description": "Test actions to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "run",
      "description": "Run a one-off action",
      "examples": [
        "garden run my-task",
        "garden run my-task -- arg1 arg2"
      ],
      "options": [
        {
          "name": "--force",
          "description": "Re-run even when cached",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--force-build",
          "description": "Rebuild before running",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--interactive",
          "description": "Attach to the run container",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--env",
          "description": "Environment to target",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "action",
          "description": "Run action to execute",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "logs",
      "description": "View runtime logs",
      "examples": [
        "garden logs",
        "garden logs my-service",
        "garden logs --follow"
      ],
      "options": [
        {
          "name": "--follow",
          "description": "Stream new log lines",
          "type": "boolean",
          "takesValue": false,
          "short": "-f",
          "shorthand": "-f"
        },
        {
          "name": "--tail",
          "description": "Number of recent lines to show",
          "type": "integer",
          "takesValue": true,
          "short": "-t",
          "shorthand": "-t"
        },
        {
          "name": "--since",
          "description": "Only logs newer than this duration",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--timestamps",
          "description": "Prefix each line with a timestamp",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--original-color",
          "description": "Keep the service's own colouring",
          "type": "boolean",
          "takesValue": false
        }
      ],
      "args": [
        {
          "name": "names",
          "description": "Deploy actions to read logs from",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "exec",
      "description": "Execute command in container",
      "examples": [
        "garden exec my-service -- sh"
      ],
      "options": [
        {
          "name": "--interactive",
          "description": "Keep stdin open and allocate a TTY",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--target",
          "description": "Container to exec into",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "deploy",
          "description": "Deploy action to exec into",
          "required": true,
          "type": "string"
        },
        {
          "name": "command",
          "description": "Command to run",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "get",
      "description": "Get info about resources",
      "examples": [
        "garden get status",
        "garden get outputs",
        "garden get actions",
        "garden get graph"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        },
        {
          "name": "--env",
          "description": "Environment to target",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "subcommand",
          "description": "What to get, such as status or config",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "name": "cleanup",
      "description": "Clean up resources",
      "examples": [
        "garden cleanup namespace",
        "garden cleanup deploy"
      ],
      "options": [
        {
          "name": "--dependants-first",
          "description": "Clean up dependants before dependencies",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--with-dependants",
          "description": "Also clean up dependent actions",
          "type": "boolean",
          "takesValue": false
        },
        {
          "name": "--env",
          "description": "Environment to target",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--yes",
          "description": "Assume yes to prompts",
          "type": "boolean",
          "takesValue": false,
          "short": "-y",
          "shorthand": "-y"
        }
      ],
      "args": [
        {
          "name": "target",
          "description": "What to clean up, such as namespace or deploy",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "plugins",
      "description": "List/manage plugins",
      "examples": [
        "garden plugins",
        "garden plugins resolve-action my-action"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Plugin command to run",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "login",
      "description": "Login to Garden Cloud",
      "examples": [
        "garden login"
      ],
      "options": [
        {
          "name": "--env",
          "description": "Environment whose backend to log in to",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "create",
      "description": "Create a project/module",
      "examples": [
        "garden create project"
      ],
      "options": [
        {
          "name": "--dir",
          "description": "Directory to create the project or action in",
          "type": "directory",
          "takesValue": true
        },
        {
          "name": "--name",
          "description": "Name for the new project or action",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--interactive",
          "description": "Prompt for values interactively",
          "type": "boolean",
          "takesValue": false,
          "short": "-i",
          "shorthand": "-i"
        },
        {
          "name": "--filename",
          "description": "Config filename to write",
          "type": "string",
          "takesValue": true
        }
      ],
      "args": [
        {
          "name": "kind",
          "description": "What to create: project or action",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "validate",
      "description": "Validate config",
      "examples": [
        "garden validate"
      ],
      "options": [
        {
          "name": "--resolve",
          "description": "How far to resolve the config graph",
          "type": "string",
          "takesValue": true
        },
        {
          "name": "--env",
          "description": "Environment to validate against",
          "type": "string",
          "takesValue": true
        }
      ]
    },
    {
      "name": "util",
      "description": "Utility commands",
      "examples": [
        "garden util fetch-tools",
        "garden util profile-project"
      ],
      "options": [
        {
          "name": "--output",
          "description": "Output format: json or yaml",
          "type": "string",
          "takesValue": true,
          "short": "-o",
          "shorthand": "-o"
        }
      ],
      "args": [
        {
          "name": "operation",
          "description": "Utility command, such as fetch-tools",
          "required": true,
          "type": "string"
        }
      ]
    }
  ],
  "globalOptions": [
    {
      "name": "--env",
      "short": "-e",
      "description": "Environment",
      "type": "string",
      "takesValue": true,
      "shorthand": "-e"
    },
    {
      "name": "--root",
      "description": "Project root",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--logger-type",
      "description": "Logger type",
      "type": "string",
      "takesValue": true
    },
    {
      "name": "--log-level",
      "short": "-l",
      "description": "Log level",
      "type": "string",
      "takesValue": true,
      "shorthand": "-l"
    },
    {
      "name": "--force-refresh",
      "description": "Force refresh of provider plugins"
    },
    {
      "name": "--var",
      "description": "Set variables",
      "type": "string",
      "takesValue": true
    }
  ],
  "examples": [
    "garden deploy",
    "garden dev",
    "garden build",
    "garden test",
    "garden run my-task",
    "garden logs --follow",
    "garden get status",
    "garden validate"
  ],
  "relatedCommands": [
    "skaffold",
    "tilt",
    "devspace",
    "kubectl"
  ],
  "contextEngine": {
    "detectors": [
      {
        "name": "version",
        "description": "Garden CLI version",
        "command": "garden version 2>/dev/null",
        "parser": "text",
        "cacheFor": 3600,
        "requiresCmd": "garden"
      },
      {
        "name": "kube_context",
        "description": "Active Kubernetes context",
        "command": "kubectl config current-context 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "kube_namespace",
        "description": "Active Kubernetes namespace",
        "command": "kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null",
        "parser": "text",
        "cacheFor": 60,
        "requiresCmd": "kubectl"
      },
      {
        "name": "config",
        "description": "Garden project configuration",
        "command": "cat garden.yml 2>/dev/null | head -60 || cat project.garden.yml 2>/dev/null | head -60",
        "parser": "text",
        "cacheFor": 120
      },
      {
        "name": "actions",
        "description": "Garden actions in this project",
        "command": "garden get actions 2>/dev/null | head -30",
        "parser": "table",
        "cacheFor": 120,
        "requiresCmd": "garden"
      }
    ]
  }
}
