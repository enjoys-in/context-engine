      "parameters": [
        {
          "label": "T",
          "documentation": {
            "value": "Element type (e.g., Float64, Int). Defaults to Float64."
          }
        },
        {
          "label": "dims...",
          "documentation": {
            "value": "Dimensions of the array (e.g., 3, 4 for a 3×4 matrix)."
