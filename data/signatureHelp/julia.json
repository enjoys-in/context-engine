  "signatures": [
    {
      "label": "println(io::IO, xs...): Nothing",
      "documentation": {
        "value": "Prints the arguments followed by a newline. If no IO object is given, prints to stdout."
      },
      "parameters": [
        {
          "label": "io::IO",
          "documentation": {
            "value": "Optional IO stream to print to. Defaults to stdout."
          }
        },
        {
          "label": "xs...",
          "documentation": {
            "value": "Values to print."
          }
        }
      ]
    },
    {
      "label": "parse(type::Type, str::AbstractString; base::Integer): type",
      "documentation": {
        "value": "Parses a string as the given type. For integers, an optional base can be specified."
      },
      "parameters": [
        {
          "label": "type",
          "documentation": {
            "value": "The type to parse the string as (e.g., Int, Float64)."
          }
        },
        {
          "label": "str",
          "documentation": {
            "value": "The string to parse."
          }
        },
        {
          "label": "base",
          "documentation": {
            "value": "Optional base for integer parsing (default 10)."
          }
        }
      ]
    },
    {
      "label": "typeof(x): DataType",
      "documentation": {
        "value": "Returns the concrete type of the argument."
      },
      "parameters": [
        {
          "label": "x",
          "documentation": {
            "value": "The value whose type to determine."
          }
        }
      ]
    },
    {
      "label": "length(collection): Integer",
      "documentation": {
        "value": "Returns the number of elements in a collection (array, string, tuple, etc.)."
      },
      "parameters": [
        {
          "label": "collection",
          "documentation": {
            "value": "The collection to measure."
          }
        }
      ]
    },
    {
      "label": "push!(collection, items...): collection",
      "documentation": {
        "value": "Inserts one or more items at the end of a collection. Modifies the collection in place."
      },
      "parameters": [
        {
          "label": "collection",
          "documentation": {
            "value": "The mutable collection to append to."
          }
        },
        {
          "label": "items...",
          "documentation": {
            "value": "Items to add to the end."
          }
        }
      ]
    },
    {
      "label": "pop!(collection): item",
      "documentation": {
        "value": "Removes and returns the last item from a collection."
      },
      "parameters": [
        {
          "label": "collection",
          "documentation": {
            "value": "The mutable collection to remove from."
          }
        }
      ]
    },
    {
      "label": "map(f::Function, collection...): Array",
      "documentation": {
        "value": "Applies function f to each element of the collection(s) and returns an array of results."
      },
      "parameters": [
        {
          "label": "f",
          "documentation": {
            "value": "The function to apply to each element."
          }
        },
        {
          "label": "collection...",
          "documentation": {
            "value": "One or more collections to map over."
          }
        }
      ]
    },
    {
      "label": "filter(f::Function, collection): Array",
      "documentation": {
        "value": "Returns an array containing only elements of the collection for which f returns true."
      },
      "parameters": [
        {
          "label": "f",
          "documentation": {
            "value": "A predicate function returning a boolean."
          }
        },
        {
          "label": "collection",
          "documentation": {
            "value": "The collection to filter."
          }
        }
      ]
    },
    {
      "label": "reduce(op, collection; init): value",
      "documentation": {
        "value": "Reduces the collection using the binary operator op. An optional initial value can be provided."
      },
      "parameters": [
        {
          "label": "op",
          "documentation": {
            "value": "A binary function or operator (e.g., +, *, min)."
          }
        },
        {
          "label": "collection",
          "documentation": {
            "value": "The collection to reduce."
          }
        },
        {
          "label": "init",
          "documentation": {
            "value": "Optional initial value for the reduction."
          }
        }
      ]
    },
    {
      "label": "sort(v::AbstractVector; by, rev, alg): Vector",
      "documentation": {
        "value": "Returns a sorted copy of the vector. Use sort! for in-place sorting."
      },
      "parameters": [
        {
          "label": "v",
          "documentation": {
            "value": "The vector to sort."
          }
        },
        {
          "label": "by",
          "documentation": {
            "value": "A function to transform elements before comparison."
          }
        },
        {
          "label": "rev",
          "documentation": {
            "value": "If true, sort in reverse order."
          }
        },
        {
          "label": "alg",
          "documentation": {
            "value": "Sorting algorithm to use (e.g., QuickSort, MergeSort)."
          }
        }
      ]
    },
    {
      "label": "open(filename::AbstractString, mode::AbstractString): IOStream",
      "documentation": {
        "value": "Opens a file and returns an IOStream. Mode can be \"r\" (read), \"w\" (write), \"a\" (append), etc."
      },
      "parameters": [
        {
          "label": "filename",
          "documentation": {
            "value": "The path to the file to open."
          }
        },
        {
          "label": "mode",
          "documentation": {
            "value": "File open mode: \"r\", \"w\", \"a\", \"r+\", \"w+\", \"a+\"."
          }
        }
      ]
    },
    {
      "label": "read(io::IO, T::Type): T",
      "documentation": {
        "value": "Reads a single value of the specified type from the IO stream."
      },
      "parameters": [
        {
          "label": "io",
          "documentation": {
            "value": "The IO stream to read from."
          }
        },
        {
          "label": "T",
          "documentation": {
            "value": "The type of value to read."
          }
        }
      ]
    },
    {
      "label": "write(io::IO, x...): Integer",
      "documentation": {
        "value": "Writes the canonical binary representation of the values to the IO stream. Returns number of bytes written."
      },
      "parameters": [
        {
          "label": "io",
          "documentation": {
            "value": "The IO stream to write to."
          }
        },
        {
          "label": "x...",
          "documentation": {
            "value": "The values to write."
          }
        }
      ]
    },
    {
