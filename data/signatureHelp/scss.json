{
  "language": "scss",
  "triggerCharacters": [
    "(",
    ","
  ],
  "retriggerCharacters": [
    ","
  ],
  "signatures": [
    {
      "label": "@mixin name($param1, $param2: default) { ... }",
      "documentation": {
        "value": "Defines a reusable group of CSS declarations that can be included throughout the stylesheet."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "The name of the mixin"
          }
        },
        {
          "label": "$param1",
          "documentation": {
            "value": "A required parameter"
          }
        },
        {
          "label": "$param2: default",
          "documentation": {
            "value": "An optional parameter with a default value"
          }
        }
      ]
    },
    {
      "label": "@include name($args...)",
      "documentation": {
        "value": "Includes a mixin's styles into the current rule."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "The name of the mixin to include"
          }
        },
        {
          "label": "$args",
          "documentation": {
            "value": "Arguments to pass to the mixin"
          }
        }
      ]
    },
    {
      "label": "@function name($param1, $param2) { @return value; }",
      "documentation": {
        "value": "Defines a custom function that can compute and return values."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "The name of the function"
          }
        },
        {
          "label": "$param1",
          "documentation": {
            "value": "First parameter of the function"
          }
        },
        {
          "label": "$param2",
          "documentation": {
            "value": "Second parameter of the function"
          }
        }
      ]
    },
    {
      "label": "@return expression",
      "documentation": {
        "value": "Returns the result of an expression from a `@function`."
      },
      "parameters": [
        {
          "label": "expression",
          "documentation": {
            "value": "The value to return from the function"
          }
        }
      ]
    },
    {
      "label": "@extend selector",
      "documentation": {
        "value": "Shares a set of CSS properties from one selector to another."
      },
      "parameters": [
        {
          "label": "selector",
          "documentation": {
            "value": "The selector whose styles should be extended"
          }
        }
      ]
    },
    {
      "label": "@use 'url' as namespace",
      "documentation": {
        "value": "Loads mixins, functions, and variables from another stylesheet and makes them available namespaced."
      },
      "parameters": [
        {
          "label": "'url'",
          "documentation": {
            "value": "The URL of the module to load"
          }
        },
        {
          "label": "namespace",
          "documentation": {
            "value": "Optional namespace alias (use `*` for no namespace)"
          }
        }
      ]
    },
    {
      "label": "@forward 'url' with ($config...)",
      "documentation": {
        "value": "Loads a Sass stylesheet and makes its mixins, functions, and variables available when this stylesheet is loaded with `@use`."
      },
      "parameters": [
        {
          "label": "'url'",
          "documentation": {
            "value": "The URL of the module to forward"
          }
        },
        {
          "label": "$config",
          "documentation": {
            "value": "Optional configuration values to pass"
          }
        }
      ]
    },
    {
      "label": "@if condition { ... } @else if condition { ... } @else { ... }",
      "documentation": {
        "value": "Conditionally evaluates a block of styles based on the result of an expression."
      },
      "parameters": [
        {
          "label": "condition",
          "documentation": {
            "value": "A SassScript expression that evaluates to true or false"
          }
        }
      ]
    },
    {
      "label": "@each $var in list { ... }",
      "documentation": {
        "value": "Iterates over each item in a list or each pair in a map."
      },
      "parameters": [
        {
          "label": "$var",
          "documentation": {
            "value": "The variable name for the current item"
          }
        },
        {
          "label": "list",
          "documentation": {
            "value": "A Sass list or map to iterate over"
          }
        }
      ]
    },
    {
      "label": "@for $var from start through end { ... }",
      "documentation": {
        "value": "Iterates from a start number to an end number (inclusive with `through`, exclusive with `to`)."
      },
      "parameters": [
        {
          "label": "$var",
          "documentation": {
            "value": "The counter variable"
          }
        },
        {
          "label": "start",
          "documentation": {
            "value": "The starting number"
          }
        },
        {
          "label": "end",
          "documentation": {
            "value": "The ending number"
          }
        }
      ]
    },
    {
      "label": "darken($color, $amount): color",
      "documentation": {
        "value": "Makes a color darker by decreasing its lightness by the given amount."
      },
      "parameters": [
        {
          "label": "$color",
          "documentation": {
            "value": "The color to darken"
          }
        },
        {
          "label": "$amount",
          "documentation": {
            "value": "A percentage between 0% and 100%"
          }
        }
      ]
    },
    {
      "label": "lighten($color, $amount): color",
      "documentation": {
        "value": "Makes a color lighter by increasing its lightness by the given amount."
      },
      "parameters": [
        {
          "label": "$color",
          "documentation": {
            "value": "The color to lighten"
          }
        },
        {
          "label": "$amount",
          "documentation": {
            "value": "A percentage between 0% and 100%"
          }
        }
      ]
    },
    {
      "label": "mix($color1, $color2, $weight: 50%): color",
      "documentation": {
        "value": "Mixes two colors together. The weight specifies the amount of the first color to include."
      },
      "parameters": [
        {
          "label": "$color1",
          "documentation": {
            "value": "The first color"
          }
        },
        {
          "label": "$color2",
          "documentation": {
            "value": "The second color"
          }
        },
        {
          "label": "$weight",
          "documentation": {
            "value": "The proportion of the first color (default 50%)"
          }
        }
      ]
    },
    {
      "label": "percentage($number): percentage",
      "documentation": {
        "value": "Converts a unitless number to a percentage."
      },
      "parameters": [
        {
          "label": "$number",
          "documentation": {
            "value": "A unitless number (e.g. 0.5 becomes 50%)"
          }
        }
      ]
    },
    {
      "label": "map-get($map, $key): value",
      "documentation": {
        "value": "Returns the value in a map associated with the given key."
      },
      "parameters": [
        {
          "label": "$map",
          "documentation": {
            "value": "The map to search"
          }
        },
        {
          "label": "$key",
          "documentation": {
            "value": "The key to look up"
          }
        }
      ]
    },
    {
      "label": "@mixin name($arg: default) { ... }",
      "documentation": {
        "value": "Declares a reusable block, optionally parameterised."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "Mixin name."
          }
        },
        {
          "label": "$arg",
          "documentation": {
            "value": "Parameter with an optional default."
          }
        }
      ]
    },
    {
      "label": "@include name($arg...)",
      "documentation": {
        "value": "Applies a mixin. Trailing `...` forwards an argument list."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "Mixin to apply."
          }
        },
        {
          "label": "$arg",
          "documentation": {
            "value": "Arguments."
          }
        }
      ]
    },
    {
      "label": "@function name($args) { @return value; }",
      "documentation": {
        "value": "Declares a function returning a value, unlike a mixin which emits declarations."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "Function name."
          }
        },
        {
          "label": "$args",
          "documentation": {
            "value": "Parameters."
          }
        }
      ]
    },
    {
      "label": "map.get($map, $key)",
      "documentation": {
        "value": "Reads from a Sass map. From `sass:map`, replacing the deprecated global `map-get`."
      },
      "parameters": [
        {
          "label": "$map",
          "documentation": {
            "value": "Sass map."
          }
        },
        {
          "label": "$key",
          "documentation": {
            "value": "Key to read."
          }
        }
      ]
    },
    {
      "label": "math.div($a, $b)",
      "documentation": {
        "value": "Division. The `/` operator is deprecated for division because it is ambiguous with the CSS shorthand separator."
      },
      "parameters": [
        {
          "label": "$a",
          "documentation": {
            "value": "Numerator."
          }
        },
        {
          "label": "$b",
          "documentation": {
            "value": "Denominator."
          }
        }
      ]
    },
    {
      "label": "color.adjust($color, $lightness: ...)",
      "documentation": {
        "value": "Adjusts colour channels. From `sass:color`, replacing `lighten`/`darken`."
      },
      "parameters": [
        {
          "label": "$color",
          "documentation": {
            "value": "Base colour."
          }
        },
        {
          "label": "$lightness",
          "documentation": {
            "value": "Delta to apply; also $alpha, $hue, $saturation."
          }
        }
      ]
    },
    {
      "label": "@each $item in $list { ... }",
      "documentation": {
        "value": "Iterates a list or map. `@for` counts and `@while` loops on a condition."
      },
      "parameters": [
        {
          "label": "$item",
          "documentation": {
            "value": "Loop binding."
          }
        },
        {
          "label": "$list",
          "documentation": {
            "value": "List or map."
          }
        }
      ]
    },
    {
      "label": "@use \"module\" as ns with ($var: value)",
      "documentation": {
        "value": "Loads a module and configures its defaults. Replaces `@import`."
      },
      "parameters": [
        {
          "label": "module",
          "documentation": {
            "value": "Module path."
          }
        },
        {
          "label": "ns",
          "documentation": {
            "value": "Namespace, or * to flatten."
          }
        },
        {
          "label": "$var",
          "documentation": {
            "value": "Configuration override."
          }
        }
      ]
    },
    {
      "label": "if($condition, $if-true, $if-false)",
      "documentation": {
        "value": "Inline conditional expression; both branches are evaluated lazily."
      },
      "parameters": [
        {
          "label": "$condition",
          "documentation": {
            "value": "Test."
          }
        },
        {
          "label": "$if-true",
          "documentation": {
            "value": "Value when true."
          }
        },
        {
          "label": "$if-false",
          "documentation": {
            "value": "Value when false."
          }
        }
      ]
    }
  ]
}
