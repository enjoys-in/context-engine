{
  "language": "twig",
  "triggerCharacters": [
    "(",
    ",",
    " "
  ],
  "retriggerCharacters": [
    ","
  ],
  "signatures": [
    {
      "label": "{{ expression }}",
      "documentation": {
        "value": "Outputs the result of an expression. Variables, function calls, and filters can be used inside."
      },
      "parameters": [
        {
          "label": "expression",
          "documentation": {
            "value": "A Twig expression: variable, function call, or expression with filters"
          }
        }
      ]
    },
    {
      "label": "{% tag %} - Statement tag",
      "documentation": {
        "value": "Executes statements such as control structures, variable assignments, and block definitions."
      },
      "parameters": [
        {
          "label": "tag",
          "documentation": {
            "value": "A Twig tag like `for`, `if`, `set`, `block`, `extends`, etc."
          }
        }
      ]
    },
    {
      "label": "{% block name %}content{% endblock %}",
      "documentation": {
        "value": "Defines a named block that child templates can override. Used with template inheritance."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "The block identifier"
          }
        },
        {
          "label": "content",
          "documentation": {
            "value": "The default content of the block"
          }
        }
      ]
    },
    {
      "label": "{% extends 'template' %}",
      "documentation": {
        "value": "Declares that the current template extends a parent template. Must be the first tag in the file."
      },
      "parameters": [
        {
          "label": "template",
          "documentation": {
            "value": "The path to the parent template"
          }
        }
      ]
    },
    {
      "label": "{% include 'template' with vars only %}",
      "documentation": {
        "value": "Includes and renders another template within the current template."
      },
      "parameters": [
        {
          "label": "template",
          "documentation": {
            "value": "The path to the template to include"
          }
        },
        {
          "label": "vars",
          "documentation": {
            "value": "Optional variables to pass to the included template"
          }
        },
        {
          "label": "only",
          "documentation": {
            "value": "Optional keyword to restrict the included template to only the passed variables"
          }
        }
      ]
    },
    {
      "label": "{% for item in sequence %}...{% endfor %}",
      "documentation": {
        "value": "Loops over each item in a sequence (array or iterable). Provides `loop` variable with index info."
      },
      "parameters": [
        {
          "label": "item",
          "documentation": {
            "value": "The variable name for the current element"
          }
        },
        {
          "label": "sequence",
          "documentation": {
            "value": "The array, hash, or iterable to loop over"
          }
        }
      ]
    },
    {
      "label": "{% if condition %}...{% elseif condition %}...{% else %}...{% endif %}",
      "documentation": {
        "value": "Conditional rendering of template content based on expression evaluation."
      },
      "parameters": [
        {
          "label": "condition",
          "documentation": {
            "value": "A Twig expression that evaluates to a truthy or falsy value"
          }
        }
      ]
    },
    {
      "label": "{% set variable = value %}",
      "documentation": {
        "value": "Assigns a value to a variable inside the template."
      },
      "parameters": [
        {
          "label": "variable",
          "documentation": {
            "value": "The variable name to assign to"
          }
        },
        {
          "label": "value",
          "documentation": {
            "value": "The expression or value to assign"
          }
        }
      ]
    },
    {
      "label": "{% macro name(arg1, arg2, ...) %}...{% endmacro %}",
      "documentation": {
        "value": "Defines a reusable template fragment, similar to a function. Macros have their own scope."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "The macro identifier"
          }
        },
        {
          "label": "arg1, arg2",
          "documentation": {
            "value": "Parameters with optional default values"
          }
        }
      ]
    },
    {
      "label": "value|filter(args)",
      "documentation": {
        "value": "Applies a filter to transform a value. Filters are separated from the variable by a pipe `|`."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "The value to transform"
          }
        },
        {
          "label": "filter",
          "documentation": {
            "value": "The filter name: `upper`, `lower`, `trim`, `slice`, `sort`, `join`, `replace`, etc."
          }
        },
        {
          "label": "args",
          "documentation": {
            "value": "Optional arguments to pass to the filter"
          }
        }
      ]
    },
    {
      "label": "{% raw %}...{% endraw %}",
      "documentation": {
        "value": "Prevents the Twig engine from processing the content inside the block. Outputs it as-is."
      },
      "parameters": []
    },
    {
      "label": "value|escape(strategy) or value|e(strategy)",
      "documentation": {
        "value": "Escapes a string for safe output. Default strategy is `html`."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "The string to escape"
          }
        },
        {
          "label": "strategy",
          "documentation": {
            "value": "The escaping strategy: `html`, `js`, `css`, `url`, `html_attr`"
          }
        }
      ]
    },
    {
      "label": "value|date(format, timezone)",
      "documentation": {
        "value": "Formats a date according to the given format string (uses PHP date format)."
      },
      "parameters": [
        {
          "label": "format",
          "documentation": {
            "value": "A PHP date format string, e.g. `'Y-m-d H:i:s'`"
          }
        },
        {
          "label": "timezone",
          "documentation": {
            "value": "Optional timezone, e.g. `'Europe/Paris'`"
          }
        }
      ]
    },
    {
      "label": "value|format(args ...)",
      "documentation": {
        "value": "Formats a string by replacing `%s` and `%d` placeholders (works like `sprintf`)."
      },
      "parameters": [
        {
          "label": "args",
          "documentation": {
            "value": "Values to substitute into the format placeholders"
          }
        }
      ]
    },
    {
      "label": "value|length: integer",
      "documentation": {
        "value": "Returns the number of items in a sequence or the length of a string."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "A string, array, or countable object"
          }
        }
      ]
    },
    {
      "label": "{{ value|default(fallback) }}",
      "documentation": {
        "value": "Supplies a value when the input is undefined, null or empty."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "Input."
          }
        },
        {
          "label": "fallback",
          "documentation": {
            "value": "Value used when empty."
          }
        }
      ]
    },
    {
      "label": "{{ value|date(format, timezone) }}",
      "documentation": {
        "value": "Formats a date using PHP date syntax."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "Date value or string."
          }
        },
        {
          "label": "format",
          "documentation": {
            "value": "e.g. 'Y-m-d'."
          }
        },
        {
          "label": "timezone",
          "documentation": {
            "value": "Target timezone."
          }
        }
      ]
    },
    {
      "label": "{% for item in collection %}...{% else %}...{% endfor %}",
      "documentation": {
        "value": "Iterates; the `else` branch runs when the collection is empty. `loop.index` and `loop.last` are available inside."
      },
      "parameters": [
        {
          "label": "item",
          "documentation": {
            "value": "Loop binding."
          }
        },
        {
          "label": "collection",
          "documentation": {
            "value": "Array or iterable."
          }
        }
      ]
    },
    {
      "label": "{% extends template %}",
      "documentation": {
        "value": "Declares a parent template. Must be the first tag, and only one is allowed."
      },
      "parameters": [
        {
          "label": "template",
          "documentation": {
            "value": "Parent template path."
          }
        }
      ]
    },
    {
      "label": "{% block name %}...{% endblock %}",
      "documentation": {
        "value": "Defines an overridable region. `{{ parent() }}` inserts the parent's content."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "Block name."
          }
        }
      ]
    },
    {
      "label": "{% include template with vars only %}",
      "documentation": {
        "value": "Renders another template. `only` withholds the current context."
      },
      "parameters": [
        {
          "label": "template",
          "documentation": {
            "value": "Template to include."
          }
        },
        {
          "label": "with vars",
          "documentation": {
            "value": "Extra variables."
          }
        },
        {
          "label": "only",
          "documentation": {
            "value": "Do not pass the parent context."
          }
        }
      ]
    },
    {
      "label": "{{ value|escape(strategy) }}",
      "documentation": {
        "value": "Escapes for a context — html, js, css, url or html_attr. Aliased as `|e`."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "Value to escape."
          }
        },
        {
          "label": "strategy",
          "documentation": {
            "value": "Escaping context."
          }
        }
      ]
    },
    {
      "label": "{% set name = value %}",
      "documentation": {
        "value": "Assigns a variable. The block form captures rendered output instead."
      },
      "parameters": [
        {
          "label": "name",
          "documentation": {
            "value": "Variable name."
          }
        },
        {
          "label": "value",
          "documentation": {
            "value": "Expression."
          }
        }
      ]
    },
    {
      "label": "{{ value|join(glue) }}",
      "documentation": {
        "value": "Joins an array into a string. `|split` is the inverse."
      },
      "parameters": [
        {
          "label": "value",
          "documentation": {
            "value": "Array."
          }
        },
        {
          "label": "glue",
          "documentation": {
            "value": "Separator."
          }
        }
      ]
    },
    {
      "label": "{% apply filter %}...{% endapply %}",
      "documentation": {
        "value": "Applies a filter to a whole block of output."
      },
      "parameters": [
        {
          "label": "filter",
          "documentation": {
            "value": "Filter to apply."
          }
        }
      ]
    }
  ]
}
