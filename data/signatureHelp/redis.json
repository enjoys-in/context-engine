{
  "language": "redis",
  "triggerCharacters": [
    "(",
    ",",
    " "
  ],
  "retriggerCharacters": [
    ",",
    " "
  ],
  "signatures": [
    {
      "label": "GET key -> string | nil",
      "documentation": {
        "value": "Gets the value of a key. Returns nil if the key does not exist. Only works for string values."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key to retrieve."
          }
        }
      ]
    },
    {
      "label": "SET key value [EX seconds | PX milliseconds] [NX | XX] [KEEPTTL] -> OK | nil",
      "documentation": {
        "value": "Sets the string value of a key. Overwrites any existing value regardless of its type."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key to set."
          }
        },
        {
          "label": "value",
          "documentation": {
            "value": "The value to store."
          }
        },
        {
          "label": "EX seconds",
          "documentation": {
            "value": "Optional. Set the expiration time in seconds."
          }
        },
        {
          "label": "NX | XX",
          "documentation": {
            "value": "NX: Only set if key does not exist. XX: Only set if key already exists."
          }
        }
      ]
    },
    {
      "label": "DEL key [key ...] -> integer",
      "documentation": {
        "value": "Removes one or more keys. Returns the number of keys that were removed."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "One or more keys to delete."
          }
        }
      ]
    },
    {
      "label": "HGET key field -> string | nil",
      "documentation": {
        "value": "Returns the value associated with a field in a hash stored at key."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the hash."
          }
        },
        {
          "label": "field",
          "documentation": {
            "value": "The field to retrieve from the hash."
          }
        }
      ]
    },
    {
      "label": "HSET key field value [field value ...] -> integer",
      "documentation": {
        "value": "Sets one or more field-value pairs in a hash. Returns the number of new fields added."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the hash."
          }
        },
        {
          "label": "field",
          "documentation": {
            "value": "The field name."
          }
        },
        {
          "label": "value",
          "documentation": {
            "value": "The value to set for the field."
          }
        }
      ]
    },
    {
      "label": "LPUSH key element [element ...] -> integer",
      "documentation": {
        "value": "Inserts one or more elements at the head (left) of a list. Returns the new list length."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the list."
          }
        },
        {
          "label": "element",
          "documentation": {
            "value": "One or more elements to push. Multiple elements are inserted left to right."
          }
        }
      ]
    },
    {
      "label": "RPUSH key element [element ...] -> integer",
      "documentation": {
        "value": "Inserts one or more elements at the tail (right) of a list. Returns the new list length."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the list."
          }
        },
        {
          "label": "element",
          "documentation": {
            "value": "One or more elements to push to the right end."
          }
        }
      ]
    },
    {
      "label": "LRANGE key start stop -> list",
      "documentation": {
        "value": "Returns elements from a list within the specified range. 0 is the first element, -1 is the last."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the list."
          }
        },
        {
          "label": "start",
          "documentation": {
            "value": "The start index (0-based, negative values count from the end)."
          }
        },
        {
          "label": "stop",
          "documentation": {
            "value": "The stop index (inclusive, -1 means the last element)."
          }
        }
      ]
    },
    {
      "label": "SADD key member [member ...] -> integer",
      "documentation": {
        "value": "Adds one or more members to a set. Returns the number of new members added (excluding duplicates)."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the set."
          }
        },
        {
          "label": "member",
          "documentation": {
            "value": "One or more members to add."
          }
        }
      ]
    },
    {
      "label": "SMEMBERS key -> set",
      "documentation": {
        "value": "Returns all members of a set stored at key."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the set."
          }
        }
      ]
    },
    {
      "label": "ZADD key [NX | XX] [GT | LT] [CH] score member [score member ...] -> integer",
      "documentation": {
        "value": "Adds one or more members to a sorted set with scores. Returns the number of new members."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the sorted set."
          }
        },
        {
          "label": "score",
          "documentation": {
            "value": "The score for ranking (double-precision floating point)."
          }
        },
        {
          "label": "member",
          "documentation": {
            "value": "The member to add."
          }
        },
        {
          "label": "NX | XX",
          "documentation": {
            "value": "NX: Only add new elements. XX: Only update existing elements."
          }
        }
      ]
    },
    {
      "label": "ZRANGE key min max [BYSCORE | BYLEX] [REV] [LIMIT offset count] [WITHSCORES] -> list",
      "documentation": {
        "value": "Returns members of a sorted set within the specified range, ordered by score."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key of the sorted set."
          }
        },
        {
          "label": "min",
          "documentation": {
            "value": "The minimum score or index."
          }
        },
        {
          "label": "max",
          "documentation": {
            "value": "The maximum score or index."
          }
        },
        {
          "label": "WITHSCORES",
          "documentation": {
            "value": "Optional. Include scores in the output."
          }
        }
      ]
    },
    {
      "label": "EXPIRE key seconds [NX | XX | GT | LT] -> integer",
      "documentation": {
        "value": "Sets a timeout on a key. After the timeout, the key is automatically deleted. Returns 1 if set, 0 if key doesn't exist."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key to set the expiration on."
          }
        },
        {
          "label": "seconds",
          "documentation": {
            "value": "The timeout in seconds."
          }
        }
      ]
    },
    {
      "label": "TTL key -> integer",
      "documentation": {
        "value": "Returns the remaining time to live of a key in seconds. Returns -1 if no expiry, -2 if key doesn't exist."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "The key to check."
          }
        }
      ]
    },
    {
      "label": "KEYS pattern -> list",
      "documentation": {
        "value": "Returns all keys matching the given glob-style pattern. WARNING: Use SCAN in production to avoid blocking."
      },
      "parameters": [
        {
          "label": "pattern",
          "documentation": {
            "value": "A glob-style pattern (e.g., 'user:*', 'session:????', 'h[ae]llo')."
          }
        }
      ]
    },
    {
      "label": "PING [message] -> string",
      "documentation": {
        "value": "Returns PONG if no argument is provided. Otherwise returns a copy of the message. Used to test connectivity."
      },
      "parameters": [
        {
          "label": "message",
          "documentation": {
            "value": "Optional. A message string to echo back."
          }
        }
      ]
    },
    {
      "label": "SET key value [EX seconds] [NX|XX] [KEEPTTL]",
      "documentation": {
        "value": "Sets a string value. `NX` only if absent, `XX` only if present, `EX` sets a TTL in one atomic step."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "Key to write."
          }
        },
        {
          "label": "value",
          "documentation": {
            "value": "Value to store."
          }
        },
        {
          "label": "EX seconds",
          "documentation": {
            "value": "Expiry in seconds."
          }
        },
        {
          "label": "NX|XX",
          "documentation": {
            "value": "Only-if-absent / only-if-present."
          }
        },
        {
          "label": "KEEPTTL",
          "documentation": {
            "value": "Retain the existing TTL."
          }
        }
      ]
    },
    {
      "label": "SCAN cursor [MATCH pattern] [COUNT n] [TYPE t]",
      "documentation": {
        "value": "Incrementally iterates keys without blocking. Always use this instead of `KEYS` in production."
      },
      "parameters": [
        {
          "label": "cursor",
          "documentation": {
            "value": "0 to start; pass back the returned cursor."
          }
        },
        {
          "label": "MATCH pattern",
          "documentation": {
            "value": "Glob filter."
          }
        },
        {
          "label": "COUNT n",
          "documentation": {
            "value": "Hint for work per call."
          }
        },
        {
          "label": "TYPE t",
          "documentation": {
            "value": "Restrict to one type."
          }
        }
      ]
    },
    {
      "label": "EXPIRE key seconds [NX|XX|GT|LT]",
      "documentation": {
        "value": "Sets a TTL. The conditional flags avoid clobbering an existing expiry."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "Key to expire."
          }
        },
        {
          "label": "seconds",
          "documentation": {
            "value": "Time to live."
          }
        },
        {
          "label": "NX|XX|GT|LT",
          "documentation": {
            "value": "Apply only under this condition."
          }
        }
      ]
    },
    {
      "label": "ZADD key [NX|XX] [GT|LT] [CH] score member",
      "documentation": {
        "value": "Adds to a sorted set. `GT`/`LT` update only when the new score is greater or lesser."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "Sorted set key."
          }
        },
        {
          "label": "NX|XX",
          "documentation": {
            "value": "Only-if-absent / only-if-present."
          }
        },
        {
          "label": "GT|LT",
          "documentation": {
            "value": "Directional score update."
          }
        },
        {
          "label": "CH",
          "documentation": {
            "value": "Count changed elements."
          }
        },
        {
          "label": "score member",
          "documentation": {
            "value": "Score and member."
          }
        }
      ]
    },
    {
      "label": "HSET key field value [field value ...]",
      "documentation": {
        "value": "Sets hash fields. Supersedes the deprecated `HMSET`."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "Hash key."
          }
        },
        {
          "label": "field value",
          "documentation": {
            "value": "One or more pairs."
          }
        }
      ]
    },
    {
      "label": "XADD key [MAXLEN|MINID] ID field value",
      "documentation": {
        "value": "Appends to a stream. `MAXLEN ~ n` trims approximately, which is much cheaper than exactly."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "Stream key."
          }
        },
        {
          "label": "MAXLEN|MINID",
          "documentation": {
            "value": "Trim strategy."
          }
        },
        {
          "label": "ID",
          "documentation": {
            "value": "`*` to auto-generate."
          }
        },
        {
          "label": "field value",
          "documentation": {
            "value": "Entry fields."
          }
        }
      ]
    },
    {
      "label": "EVAL script numkeys key [key ...] arg [arg ...]",
      "documentation": {
        "value": "Runs a Lua script atomically. Declare every key so the script works on a cluster."
      },
      "parameters": [
        {
          "label": "script",
          "documentation": {
            "value": "Lua source."
          }
        },
        {
          "label": "numkeys",
          "documentation": {
            "value": "How many of the following arguments are keys."
          }
        },
        {
          "label": "key",
          "documentation": {
            "value": "Keys touched."
          }
        },
        {
          "label": "arg",
          "documentation": {
            "value": "Extra arguments."
          }
        }
      ]
    },
    {
      "label": "SETNX key value",
      "documentation": {
        "value": "Sets only if absent. For a lock prefer `SET key val NX EX ttl`, which sets the expiry atomically."
      },
      "parameters": [
        {
          "label": "key",
          "documentation": {
            "value": "Key to write."
          }
        },
        {
          "label": "value",
          "documentation": {
            "value": "Value to store."
          }
        }
      ]
    },
    {
      "label": "INFO [section]",
      "documentation": {
        "value": "Server statistics — memory, clients, persistence, replication, keyspace."
      },
      "parameters": [
        {
          "label": "section",
          "documentation": {
            "value": "Restrict to one section."
          }
        }
      ]
    }
  ]
}
