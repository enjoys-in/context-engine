{
  "language": "crontab",
  "comments": {
    "lineComment": "#"
  },
  "brackets": [],
  "autoClosingPairs": [],
  "surroundingPairs": [],
  "colorizedBracketPairs": [],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "wordPattern": "[^\\s]+",
  "indentationRules": {
    "increaseIndentPattern": "$^",
    "decreaseIndentPattern": "$^"
  },
  "onEnterRules": [],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
