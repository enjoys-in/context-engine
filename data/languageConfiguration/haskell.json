{
  "language": "haskell",
  "comments": {
    "lineComment": "--",
    "blockComment": [
      "{-",
      "-}"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "{-",
      "close": "-}"
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoCloseBefore": ";:.,=}])> \n\t",
  "wordPattern": "[A-Za-z_'][A-Za-z0-9_']*",
  "indentationRules": {
    "increaseIndentPattern": "(\\b(where|do|of|let)\\s*$)|(=\\s*$)|(\\{\\s*$)",
    "decreaseIndentPattern": "^\\s*(\\}|\\)|\\]|in\\b)"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*--.*$",
      "action": {
        "indentAction": 0,
        "appendText": "-- "
      }
    },
    {
      "beforeText": "^\\s*\\{-.*$",
      "afterText": "^\\s*-\\}",
      "action": {
        "indentAction": 2,
        "appendText": " "
      }
    }
  ],
  "folding": {
    "offSide": true,
    "markers": {
      "start": "^\\s*--\\s*#region\\b",
      "end": "^\\s*--\\s*#endregion\\b"
    }
  }
}
