{
  "language": "ssh-config",
  "comments": {
    "lineComment": "#"
  },
  "brackets": [],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "colorizedBracketPairs": [],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "wordPattern": "[\\w.*?-]+",
  "indentationRules": {
    "increaseIndentPattern": "$^",
    "decreaseIndentPattern": "$^"
  },
  "onEnterRules": [],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*#\\s*#region\\b",
      "end": "^\\s*#\\s*#endregion\\b"
    }
  }
}
