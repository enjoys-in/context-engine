{
  "language": "ignore",
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "[",
      "close": "]"
    }
  ],
  "surroundingPairs": [
    {
      "open": "[",
      "close": "]"
    }
  ],
  "colorizedBracketPairs": [
    [
      "[",
      "]"
    ]
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "wordPattern": "[^\\s#!]+",
  "indentationRules": {
    "increaseIndentPattern": "$^",
    "decreaseIndentPattern": "$^"
  },
  "onEnterRules": [],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
