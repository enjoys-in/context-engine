{
  "language": "scheme",
  "comments": {
    "lineComment": ";",
    "blockComment": [
      "#|",
      "|#"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "#|",
      "close": "|#",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\""
    }
  ],
  "colorizedBracketPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "wordPattern": "[^\\s()\\[\\]{}'\"`,;]+",
  "indentationRules": {
    "increaseIndentPattern": "^((?!//).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$",
    "decreaseIndentPattern": "^\\s*[})\\]].*$"
  },
  "onEnterRules": [],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*\\/\\/\\s*#region\\b",
      "end": "^\\s*\\/\\/\\s*#endregion\\b"
    }
  }
}
