{
  "language": "ruby",
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "=begin",
      "=end"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "=begin",
      "close": "=end",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\s`~!@#%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(class|module|def|if|unless|else|elsif|case|when|while|until|for|begin|rescue|ensure)\\b|\\b(do)\\s*(\\|[^|]*\\|)?\\s*$",
    "decreaseIndentPattern": "^\\s*(end|else|elsif|when|rescue|ensure)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*\\{\\s*$",
      "afterText": "^\\s*\\}",
      "action": {
        "indentAction": 2
      },
      "description": "Split an empty brace pair across lines"
    }
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
