{
  "language": "st",
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "(*",
      "*)"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "(*",
      "close": "*)",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "colorizedBracketPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t",
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\s`~!@#%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?]+)",
  "indentationRules": {
    "increaseIndentPattern": "\\b(THEN|DO|OF|VAR|VAR_INPUT|VAR_OUTPUT|STRUCT)\\s*$",
    "decreaseIndentPattern": "^\\s*(END_IF|END_WHILE|END_FOR|END_CASE|END_VAR|END_STRUCT|ELSE|ELSIF)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*.*\\{\\s*$",
      "afterText": "^\\s*\\}",
      "action": {
        "indentAction": 2
      },
      "description": "Split an empty brace pair across lines"
    }
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*\\(\\*\\s*#region\\b",
      "end": "^\\s*\\(\\*\\s*#endregion\\b"
    }
  }
}
