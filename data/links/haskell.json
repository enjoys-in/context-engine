{
  "language": "haskell",
  "linkPatterns": [
    {
      "pattern": "^import\\s+(?:qualified\\s+)?([A-Z][\\w.]*)",
      "captureGroup": 1,
      "tooltip": "Open module",
      "linkKind": "module"
    },
    {
      "pattern": "\\{-#\\s*LANGUAGE\\s+(\\w+)",
      "captureGroup": 1,
      "tooltip": "GHC extension documentation",
      "linkKind": "documentation"
    },
    {
      "pattern": "(https?://[^\\s)\\]\"]+)",
      "captureGroup": 1,
      "tooltip": "Open URL",
      "linkKind": "url"
    },
    {
      "pattern": "--\\s*See:?\\s*(https?://\\S+)",
      "captureGroup": 1,
      "tooltip": "Open reference",
      "linkKind": "url"
    },
    {
      "pattern": "^\\s*,?\\s*([a-z][\\w-]*)\\s*[><=^]{2}",
      "captureGroup": 1,
      "tooltip": "Open package on Hackage",
      "linkKind": "dependency"
    },
    {
      "pattern": "\\bhackage\\.haskell\\.org/package/([\\w-]+)",
      "captureGroup": 1,
      "tooltip": "Open Hackage package",
      "linkKind": "dependency"
    },
    {
      "pattern": "@since\\s+([\\d.]+)",
      "captureGroup": 1,
      "tooltip": "Version introduced",
      "linkKind": "documentation"
    },
    {
      "pattern": "'([A-Za-z_][\\w']*)'",
      "captureGroup": 1,
      "tooltip": "Haddock identifier link",
      "linkKind": "symbol"
    }
  ]
}
