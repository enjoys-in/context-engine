{
  "language": "haskell",
  "implementationPatterns": [
    {
      "interface": "Instance",
      "implementationKeyword": "instance",
      "pattern": "^instance\\s+(?:.*=>\\s*)?([A-Z][\\w.]*)\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "description": "Class instance for a type",
      "kind": "instance"
    },
    {
      "interface": "Functor",
      "implementationKeyword": "instance",
      "pattern": "^instance\\s+.*\\bFunctor\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "description": "Functor instance",
      "kind": "instance"
    },
    {
      "interface": "Monad",
      "implementationKeyword": "instance",
      "pattern": "^instance\\s+.*\\bMonad\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "description": "Monad instance",
      "kind": "instance"
    },
    {
      "interface": "Show",
      "implementationKeyword": "instance",
      "pattern": "^instance\\s+.*\\bShow\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "description": "Show instance",
      "kind": "instance"
    },
    {
      "interface": "Deriving",
      "implementationKeyword": "deriving",
      "pattern": "\\bderiving\\s*\\(([^)]*)\\)",
      "captureGroup": 1,
      "description": "Derived instances",
      "kind": "derived"
    },
    {
      "interface": "DerivingVia",
      "implementationKeyword": "via",
      "pattern": "\\bderiving\\s+(\\w+)\\s+via\\b",
      "captureGroup": 1,
      "description": "Instance derived via a newtype",
      "kind": "derived"
    },
    {
      "interface": "ClassMethod",
      "implementationKeyword": "where",
      "pattern": "^\\s+([a-z_]\\w*'?)\\s*=",
      "captureGroup": 1,
      "description": "Method implementation in an instance body",
      "kind": "method"
    }
  ],
  "keywords": {
    "instance": "Implements a class for a type",
    "deriving": "Generates instances automatically",
    "via": "Derives through a representationally equal type"
  }
}
