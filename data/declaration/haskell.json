{
  "language": "haskell",
  "declarations": {},
  "declarationPatterns": [
    {
      "name": "Function",
      "pattern": "^([a-z_]\\w*'?)\\s*::",
      "captureGroup": 1,
      "type": "function"
    },
    {
      "name": "Function equation",
      "pattern": "^([a-z_]\\w*'?)\\s+[^=]*=",
      "captureGroup": 1,
      "type": "function"
    },
    {
      "name": "Data type",
      "pattern": "^data\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "type": "data"
    },
    {
      "name": "Newtype",
      "pattern": "^newtype\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "type": "newtype"
    },
    {
      "name": "Type synonym",
      "pattern": "^type\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "type": "type"
    },
    {
      "name": "Class",
      "pattern": "^class\\s+(?:.*=>\\s*)?([A-Z]\\w*)",
      "captureGroup": 1,
      "type": "class"
    },
    {
      "name": "Constructor",
      "pattern": "^\\s*[=|]\\s*([A-Z]\\w*)",
      "captureGroup": 1,
      "type": "constructor"
    },
    {
      "name": "Record field",
      "pattern": "^\\s*[,{]\\s*(\\w+)\\s*::",
      "captureGroup": 1,
      "type": "field"
    },
    {
      "name": "Local binding",
      "pattern": "^\\s+(?:let\\s+)?([a-z_]\\w*'?)\\s*=",
      "captureGroup": 1,
      "type": "variable"
    },
    {
      "name": "Operator",
      "pattern": "^\\(([^)\\s]+)\\)\\s*::",
      "captureGroup": 1,
      "type": "operator"
    }
  ]
}
