{
  "language": "haskell",
  "codeLensPatterns": [
    {
      "pattern": "^([a-z_]\\w*'?)\\s*::",
      "captureGroup": 1,
      "commandId": "editor.action.referenceSearch.trigger",
      "title": "Find References",
      "description": "References to this binding"
    },
    {
      "pattern": "^(?:data|newtype)\\s+([A-Z]\\w*)",
      "captureGroup": 1,
      "commandId": "editor.action.goToImplementation",
      "title": "Find Instances",
      "description": "Instances declared for this type"
    },
    {
      "pattern": "^class\\s+(?:.*=>\\s*)?([A-Z]\\w*)",
      "captureGroup": 1,
      "commandId": "editor.action.goToImplementation",
      "title": "Find Instances",
      "description": "Instances of this class"
    },
    {
      "pattern": "^module\\s+([A-Z][\\w.]*)",
      "captureGroup": 1,
      "commandId": "editor.action.showReferences",
      "title": "Find Importers",
      "description": "Modules importing this one"
    },
    {
      "pattern": "^(prop_\\w+)\\s*::",
      "captureGroup": 1,
      "commandId": "haskell.runProperty",
      "title": "Run Property",
      "description": "Run this QuickCheck property"
    },
    {
      "pattern": "^(spec|main)\\s*::",
      "captureGroup": 1,
      "commandId": "haskell.runTest",
      "title": "Run",
      "description": "Run this entry point"
    }
  ]
}
