{
  "language": "haskell",
  "selectionRanges": {
    "bracketPairs": [
      [
        "(",
        ")"
      ],
      [
        "[",
        "]"
      ],
      [
        "{",
        "}"
      ]
    ],
    "stringDelimiters": [
      "\"",
      "'"
    ],
    "blockPatterns": [
      {
        "start": "\\bdo\\b",
        "end": "",
        "description": "do block, closed by layout"
      },
      {
        "start": "\\bwhere\\b",
        "end": "",
        "description": "where block, closed by layout"
      },
      {
        "start": "\\bcase\\b",
        "end": "\\bof\\b",
        "description": "case scrutinee"
      },
      {
        "start": "\\blet\\b",
        "end": "\\bin\\b",
        "description": "let expression"
      },
      {
        "start": "\\{-",
        "end": "-\\}",
        "description": "block comment"
      }
    ],
    "expansionHierarchy": [
      "word",
      "string",
      "parentheses",
      "list",
      "tuple",
      "application",
      "operator-section",
      "alternative",
      "equation",
      "declaration",
      "module"
    ],
    "wordPattern": "[A-Za-z_'][A-Za-z0-9_']*"
  },
  "selectionPatterns": [
    {
      "pattern": "[A-Za-z_'][A-Za-z0-9_']*",
      "expandTo": "word",
      "description": "Identifier"
    },
    {
      "pattern": "\"[^\"]*\"",
      "expandTo": "string",
      "description": "String literal"
    },
    {
      "pattern": "\\([^()]*\\)",
      "expandTo": "parentheses",
      "description": "Parenthesised expression"
    },
    {
      "pattern": "\\[[^\\[\\]]*\\]",
      "expandTo": "list",
      "description": "List literal"
    },
    {
      "pattern": "\\{[^{}]*\\}",
      "expandTo": "record",
      "description": "Record braces"
    },
    {
      "pattern": "\\\\[^-]*->",
      "expandTo": "lambda",
      "description": "Lambda"
    },
    {
      "pattern": "^\\s*[|]\\s*[^=]*=",
      "expandTo": "guard",
      "description": "Guard alternative"
    },
    {
      "pattern": "^[a-z_]\\w*'?\\s*::[^\\n]*",
      "expandTo": "signature",
      "description": "Type signature"
    },
    {
      "pattern": "^(?:data|newtype|type)\\s+[A-Z]\\w*",
      "expandTo": "declaration",
      "description": "Type declaration"
    },
    {
      "pattern": "\\{-[\\s\\S]*?-\\}",
      "expandTo": "comment",
      "description": "Block comment"
    },
    {
      "pattern": "--[^\\n]*",
      "expandTo": "comment",
      "description": "Line comment"
    },
    {
      "pattern": "^module\\s+[A-Z][\\w.]*",
      "expandTo": "module",
      "description": "Module header"
    }
  ]
}
