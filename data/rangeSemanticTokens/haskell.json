{
  "language": "haskell",
  "tokenTypes": [
    "namespace",
    "type",
    "class",
    "enum",
    "interface",
    "struct",
    "typeParameter",
    "parameter",
    "variable",
    "property",
    "enumMember",
    "event",
    "function",
    "method",
    "macro",
    "keyword",
    "modifier",
    "comment",
    "string",
    "number",
    "regexp",
    "operator",
    "decorator"
  ],
  "tokenModifiers": [
    "declaration",
    "definition",
    "readonly",
    "static",
    "deprecated",
    "abstract",
    "async",
    "modification",
    "documentation",
    "defaultLibrary"
  ],
  "tokenLegend": {
    "tokenTypes": [
      "namespace",
      "type",
      "class",
      "enum",
      "interface",
      "struct",
      "typeParameter",
      "parameter",
      "variable",
      "property",
      "enumMember",
      "event",
      "function",
      "method",
      "macro",
      "keyword",
      "modifier",
      "comment",
      "string",
      "number",
      "regexp",
      "operator",
      "decorator"
    ],
    "tokenModifiers": [
      "declaration",
      "definition",
      "readonly",
      "static",
      "deprecated",
      "abstract",
      "async",
      "modification",
      "documentation",
      "defaultLibrary"
    ]
  },
  "supportedRangeScopes": [
    "function",
    "class",
    "block",
    "statement"
  ],
  "multilineTokens": [
    "comment",
    "string"
  ],
  "rangeTokenRules": [
    {
      "type": "function",
      "pattern": "^([a-z_]\\w*'?)\\s*::",
      "modifiers": [
        "declaration"
      ],
      "description": "Type signature",
      "rangeScope": "declaration"
    },
    {
      "type": "function",
      "pattern": "^([a-z_]\\w*'?)\\s+[^=]*=",
      "modifiers": [
        "definition"
      ],
      "description": "Function equation",
      "rangeScope": "function"
    },
    {
      "type": "type",
      "pattern": "^(?:data|newtype)\\s+([A-Z]\\w*)",
      "modifiers": [
        "declaration"
      ],
      "description": "Data declaration",
      "rangeScope": "declaration"
    },
    {
      "type": "class",
      "pattern": "^class\\s+(?:.*=>\\s*)?([A-Z]\\w*)",
      "modifiers": [
        "declaration"
      ],
      "description": "Class declaration",
      "rangeScope": "class"
    },
    {
      "type": "class",
      "pattern": "^instance\\s+(?:.*=>\\s*)?([A-Z][\\w.]*)",
      "modifiers": [
        "definition"
      ],
      "description": "Instance declaration",
      "rangeScope": "class"
    },
    {
      "type": "property",
      "pattern": "^\\s*[,{]\\s*(\\w+)\\s*::",
      "modifiers": [
        "declaration"
      ],
      "description": "Record field",
      "rangeScope": "block"
    },
    {
      "type": "namespace",
      "pattern": "^module\\s+([A-Z][\\w.]*)",
      "modifiers": [
        "declaration"
      ],
      "description": "Module header",
      "rangeScope": "declaration"
    },
    {
      "type": "keyword",
      "pattern": "\\bdo\\b",
      "modifiers": [],
      "description": "do block",
      "rangeScope": "block"
    },
    {
      "type": "keyword",
      "pattern": "\\bwhere\\b",
      "modifiers": [],
      "description": "where block",
      "rangeScope": "block"
    },
    {
      "type": "keyword",
      "pattern": "\\bcase\\b.*\\bof\\b",
      "modifiers": [],
      "description": "case expression",
      "rangeScope": "statement"
    },
    {
      "type": "macro",
      "pattern": "\\{-#\\s*LANGUAGE[^#]*#-\\}",
      "modifiers": [],
      "description": "LANGUAGE pragma",
      "rangeScope": "declaration"
    },
    {
      "type": "typeParameter",
      "pattern": "\\bforall\\s+([a-z]\\w*)",
      "modifiers": [],
      "description": "Quantified type variable",
      "rangeScope": "declaration"
    }
  ]
}
