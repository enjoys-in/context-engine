{
  "language": "react",
  "tokenTypes": [
    "namespace",
    "type",
    "class",
    "enum",
    "interface",
    "struct",
    "typeParameter",
    "parameter",
    "variable",
    "property",
    "enumMember",
    "event",
    "function",
    "method",
    "macro",
    "keyword",
    "modifier",
    "comment",
    "string",
    "number",
    "regexp",
    "operator",
    "decorator"
  ],
  "tokenModifiers": [
    "declaration",
    "definition",
    "readonly",
    "static",
    "deprecated",
    "async",
    "modification",
    "documentation",
    "defaultLibrary",
    "local"
  ],
  "tokenLegend": {
    "tokenTypes": [
      "namespace",
      "type",
      "class",
      "enum",
      "interface",
      "struct",
      "typeParameter",
      "parameter",
      "variable",
      "property",
      "enumMember",
      "event",
      "function",
      "method"
    ],
    "tokenModifiers": [
      "declaration",
      "definition",
      "readonly",
      "static",
      "deprecated",
      "async"
    ]
  },
  "rangeTokenRules": [
    {
      "type": "class",
      "pattern": "\\bclass\\s+[A-Z][A-Za-z0-9_]*\\s+extends\\s+(?:React\\.)?(?:Pure)?Component",
      "modifiers": [
        "declaration"
      ],
      "description": "Class component declaration",
      "rangeScope": "class"
    },
    {
      "type": "function",
      "pattern": "\\bfunction\\s+([A-Z][A-Za-z0-9_]*)\\s*\\(",
      "modifiers": [
        "declaration"
      ],
      "description": "Function component declaration (capitalised)",
      "rangeScope": "function"
    },
    {
      "type": "function",
      "pattern": "\\bconst\\s+([A-Z][A-Za-z0-9_]*)\\s*=\\s*(?:React\\.)?(?:memo|forwardRef)\\s*\\(",
      "modifiers": [
        "declaration",
        "readonly"
      ],
      "description": "Component wrapped in memo/forwardRef",
      "rangeScope": "function"
    },
    {
      "type": "function",
      "pattern": "\\bconst\\s+([A-Z][A-Za-z0-9_]*)\\s*=\\s*(?:\\([^)]*\\)|[A-Za-z0-9_$]+)\\s*=>",
      "modifiers": [
        "declaration",
        "readonly"
      ],
      "description": "Arrow function component",
      "rangeScope": "function"
    },
    {
      "type": "function",
      "pattern": "\\buse[A-Z][A-Za-z0-9_]*\\s*\\(",
      "modifiers": [],
      "description": "Hook call site",
      "rangeScope": "statement"
    },
    {
      "type": "function",
      "pattern": "\\bfunction\\s+(use[A-Z][A-Za-z0-9_]*)\\s*\\(",
      "modifiers": [
        "declaration"
      ],
      "description": "Custom hook declaration",
      "rangeScope": "function"
    },
    {
      "type": "function",
      "pattern": "\\bconst\\s+(use[A-Z][A-Za-z0-9_]*)\\s*=",
      "modifiers": [
        "declaration",
        "readonly"
      ],
      "description": "Custom hook assigned to a const",
      "rangeScope": "function"
    },
    {
      "type": "variable",
      "pattern": "\\bconst\\s*\\[\\s*([A-Za-z0-9_$]+)\\s*,\\s*set[A-Z][A-Za-z0-9_]*\\s*\\]\\s*=\\s*useState",
      "modifiers": [
        "declaration",
        "readonly",
        "local"
      ],
      "description": "useState value binding",
      "rangeScope": "statement"
    },
    {
      "type": "function",
      "pattern": "\\bconst\\s*\\[\\s*[A-Za-z0-9_$]+\\s*,\\s*(set[A-Z][A-Za-z0-9_]*)\\s*\\]\\s*=\\s*useState",
      "modifiers": [
        "declaration",
        "readonly",
        "local"
      ],
      "description": "useState setter binding",
      "rangeScope": "statement"
    },
    {
      "type": "variable",
      "pattern": "\\bconst\\s+([A-Za-z0-9_$]+)\\s*=\\s*useRef\\s*\\(",
      "modifiers": [
        "declaration",
        "readonly",
        "local"
      ],
      "description": "useRef binding",
      "rangeScope": "statement"
    },
    {
      "type": "function",
      "pattern": "\\bconst\\s+([A-Za-z0-9_$]+)\\s*=\\s*useCallback\\s*\\(",
      "modifiers": [
        "declaration",
        "readonly",
        "local"
      ],
      "description": "useCallback binding",
      "rangeScope": "function"
    },
    {
      "type": "variable",
      "pattern": "\\bconst\\s+([A-Za-z0-9_$]+)\\s*=\\s*useMemo\\s*\\(",
      "modifiers": [
        "declaration",
        "readonly",
        "local"
      ],
      "description": "useMemo binding",
      "rangeScope": "statement"
    },
    {
      "type": "type",
      "pattern": "<([A-Z][A-Za-z0-9_.]*)(?=[\\s/>])",
      "modifiers": [],
      "description": "JSX component opening tag",
      "rangeScope": "block"
    },
    {
      "type": "type",
      "pattern": "</([A-Z][A-Za-z0-9_.]*)\\s*>",
      "modifiers": [],
      "description": "JSX component closing tag",
      "rangeScope": "block"
    },
    {
      "type": "keyword",
      "pattern": "<>|</>",
      "modifiers": [],
      "description": "JSX fragment shorthand",
      "rangeScope": "block"
    },
    {
      "type": "property",
      "pattern": "\\s([a-z][A-Za-z0-9_]*)=(?=[\\\"'{])",
      "modifiers": [],
      "description": "JSX attribute name",
      "rangeScope": "block"
    },
    {
      "type": "property",
      "pattern": "\\s(on[A-Z][A-Za-z0-9_]*)=(?=[\\\"'{])",
      "modifiers": [],
      "description": "JSX event handler prop",
      "rangeScope": "block"
    },
    {
      "type": "property",
      "pattern": "\\bkey=(?=[\\\"'{])",
      "modifiers": [
        "defaultLibrary"
      ],
      "description": "React reserved key prop",
      "rangeScope": "block"
    },
    {
      "type": "operator",
      "pattern": "\\{\\s*\\.\\.\\.([A-Za-z0-9_$]+)\\s*\\}",
      "modifiers": [],
      "description": "JSX spread attributes",
      "rangeScope": "block"
    },
    {
      "type": "namespace",
      "pattern": "\\bimport\\s+.*\\bfrom\\s+[\\\"']react[\\\"']",
      "modifiers": [
        "defaultLibrary"
      ],
      "description": "React package import",
      "rangeScope": "statement"
    },
    {
      "type": "decorator",
      "pattern": "\\bReact\\.(?=[A-Za-z])",
      "modifiers": [
        "defaultLibrary"
      ],
      "description": "React namespace member access",
      "rangeScope": "statement"
    },
    {
      "type": "type",
      "pattern": ":\\s*(React\\.(?:FC|FunctionComponent|ReactNode|ReactElement|PropsWithChildren)\\b)",
      "modifiers": [
        "defaultLibrary"
      ],
      "description": "React type annotation",
      "rangeScope": "declaration"
    }
  ],
  "supportedRangeScopes": [
    "function",
    "class",
    "block",
    "statement"
  ],
  "multilineTokens": [
    "comment",
    "string"
  ]
}
