{
  "language": "prisma",
  "tokenTypes": [
    "namespace",
    "type",
    "class",
    "enum",
    "interface",
    "struct",
    "typeParameter",
    "parameter",
    "variable",
    "property",
    "enumMember",
    "event",
    "function",
    "method",
    "macro",
    "keyword",
    "modifier",
    "comment",
    "string",
    "number",
    "regexp",
    "operator",
    "decorator"
  ],
  "tokenModifiers": [
    "declaration",
    "definition",
    "readonly",
    "static",
    "deprecated",
    "abstract",
    "async",
    "modification",
    "documentation",
    "defaultLibrary"
  ],
  "tokenLegend": {
    "tokenTypes": [
      "comment",
      "keyword",
      "class",
      "enum",
      "property",
      "type",
      "decorator",
      "string"
    ],
    "tokenModifiers": [
      "declaration",
      "definition",
      "readonly",
      "documentation"
    ]
  },
  "rangeTokenRules": [
    {
      "type": "comment",
      "pattern": "^\\s*///.*$",
      "modifiers": [
        "documentation"
      ],
      "description": "Documentation comment",
      "rangeScope": "statement"
    },
    {
      "type": "comment",
      "pattern": "^\\s*//(?!/).*$",
      "modifiers": [],
      "description": "Line comment",
      "rangeScope": "statement"
    },
    {
      "type": "keyword",
      "pattern": "^\\s*(model|enum|datasource|generator|type|view)\\b",
      "modifiers": [
        "declaration"
      ],
      "description": "Block keyword",
      "rangeScope": "declaration"
    },
    {
      "type": "class",
      "pattern": "^\\s*model\\s+([A-Za-z_]\\w*)",
      "modifiers": [
        "declaration"
      ],
      "description": "Model name",
      "rangeScope": "declaration"
    },
    {
      "type": "enum",
      "pattern": "^\\s*enum\\s+([A-Za-z_]\\w*)",
      "modifiers": [
        "declaration"
      ],
      "description": "Enum name",
      "rangeScope": "declaration"
    },
    {
      "type": "property",
      "pattern": "^\\s*(?!model\\b|enum\\b|datasource\\b|generator\\b|type\\b|view\\b)([A-Za-z_]\\w*)\\s+\\w+",
      "modifiers": [
        "declaration"
      ],
      "description": "Field declaration",
      "rangeScope": "statement"
    },
    {
      "type": "type",
      "pattern": "\\b(String|Boolean|Int|BigInt|Float|Decimal|DateTime|Json|Bytes|Unsupported)\\b",
      "modifiers": [],
      "description": "Scalar type",
      "rangeScope": "expression"
    },
    {
      "type": "decorator",
      "pattern": "@@?[a-zA-Z_]\\w*",
      "modifiers": [],
      "description": "Field or block attribute",
      "rangeScope": "expression"
    },
    {
      "type": "string",
      "pattern": "\"(?:[^\"\\\\]|\\\\.)*\"",
      "modifiers": [],
      "description": "String literal",
      "rangeScope": "expression"
    }
  ],
  "multilineTokens": [
    "comment",
    "string"
  ],
  "supportedRangeScopes": [
    "statement",
    "expression",
    "declaration"
  ]
}
