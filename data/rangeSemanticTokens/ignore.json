{
  "language": "ignore",
  "tokenTypes": [
    "namespace",
    "type",
    "class",
    "enum",
    "interface",
    "struct",
    "typeParameter",
    "parameter",
    "variable",
    "property",
    "enumMember",
    "event",
    "function",
    "method",
    "macro",
    "keyword",
    "modifier",
    "comment",
    "string",
    "number",
    "regexp",
    "operator",
    "decorator"
  ],
  "tokenModifiers": [
    "declaration",
    "definition",
    "readonly",
    "static",
    "deprecated",
    "abstract",
    "async",
    "modification",
    "documentation",
    "defaultLibrary"
  ],
  "tokenLegend": {
    "tokenTypes": [
      "comment",
      "operator",
      "regexp",
      "string"
    ],
    "tokenModifiers": [
      "declaration",
      "definition",
      "readonly",
      "documentation"
    ]
  },
  "rangeTokenRules": [
    {
      "type": "comment",
      "pattern": "^\\s*#.*$",
      "modifiers": [
        "documentation"
      ],
      "description": "Comment line",
      "rangeScope": "statement"
    },
    {
      "type": "operator",
      "pattern": "^\\s*!",
      "modifiers": [],
      "description": "Negation (re-include) prefix",
      "rangeScope": "expression"
    },
    {
      "type": "regexp",
      "pattern": "\\*\\*|\\*|\\?|\\[[^\\]]*\\]",
      "modifiers": [],
      "description": "Glob wildcard or character class",
      "rangeScope": "expression"
    },
    {
      "type": "string",
      "pattern": "^\\s*!?[^#\\s]\\S*$",
      "modifiers": [
        "declaration"
      ],
      "description": "Ignore path pattern",
      "rangeScope": "statement"
    }
  ],
  "multilineTokens": [
    "comment"
  ],
  "supportedRangeScopes": [
    "statement",
    "expression",
    "declaration"
  ]
}
