{
  "language": "ignore",
  "defaultOptions": {
    "tabSize": 2,
    "insertSpaces": true,
    "trimTrailingWhitespace": true,
    "insertFinalNewline": true,
    "trimFinalNewlines": true
  },
  "rangeFormattingRules": [
    {
      "description": "Remove trailing whitespace",
      "action": "trimTrailing",
      "pattern": "\\s+$"
    },
    {
      "description": "Collapse runs of blank lines",
      "action": "normalizeSpacing",
      "pattern": "\\n{3,}"
    },
    {
      "description": "Sort ignore patterns alphabetically within the range",
      "action": "sort",
      "pattern": "^[^#!\\s].*$"
    },
    {
      "description": "Normalize line endings",
      "action": "normalizeEOL"
    }
  ],
  "adjustToSyntaxNode": false,
  "supportedRangeTypes": [
    "comment",
    "selection"
  ]
}
