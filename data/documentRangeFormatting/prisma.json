{
  "language": "prisma",
  "defaultOptions": {
    "tabSize": 2,
    "insertSpaces": true,
    "trimTrailingWhitespace": true,
    "insertFinalNewline": true,
    "trimFinalNewlines": true
  },
  "rangeFormattingRules": [
    {
      "description": "Align field types within a block",
      "action": "align",
      "pattern": "^\\s*\\w+\\s+\\w+",
      "options": {
        "alignOn": "type"
      }
    },
    {
      "description": "Align field attributes",
      "action": "align",
      "pattern": "@\\w+",
      "options": {
        "alignOn": "@"
      }
    },
    {
      "description": "Normalize indentation in range",
      "action": "reindent"
    },
    {
      "description": "Remove trailing whitespace",
      "action": "trimTrailing",
      "pattern": "\\s+$"
    },
    {
      "description": "Normalize line endings",
      "action": "normalizeEOL"
    }
  ],
  "adjustToSyntaxNode": true,
  "supportedRangeTypes": [
    "block",
    "field",
    "comment",
    "selection"
  ]
}
