{
  "language": "haskell",
  "defaultOptions": {
    "tabSize": 2,
    "insertSpaces": true
  },
  "adjustToSyntaxNode": true,
  "supportedRangeTypes": [
    "declaration",
    "expression",
    "block",
    "statement"
  ],
  "rangeFormattingRules": [
    {
      "description": "Two-space indentation (tabs break layout)",
      "action": "reindent",
      "options": {
        "tabSize": 2,
        "insertSpaces": true
      }
    },
    {
      "description": "Align the :: of consecutive signatures",
      "action": "align",
      "options": {
        "on": "::"
      }
    },
    {
      "description": "Align the = of consecutive equations",
      "action": "align",
      "options": {
        "on": "="
      }
    },
    {
      "description": "Align record fields on their :: ",
      "action": "align",
      "options": {
        "on": "::"
      }
    },
    {
      "description": "Align case alternatives on ->",
      "action": "align",
      "options": {
        "on": "->"
      }
    },
    {
      "description": "Normalize spacing around operators",
      "action": "normalizeSpacing",
      "options": {}
    },
    {
      "description": "Trim trailing whitespace",
      "action": "trimTrailing",
      "options": {}
    },
    {
      "description": "Normalize line endings",
      "action": "normalizeEOL",
      "options": {
        "eol": "\n"
      }
    },
    {
      "description": "Collapse blank line runs",
      "action": "normalizeBlankLines",
      "options": {
        "max": 1
      }
    }
  ]
}
