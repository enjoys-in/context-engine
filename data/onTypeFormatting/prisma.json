{
  "language": "prisma",
  "autoFormatTriggerCharacters": [
    "\n",
    "}",
    ")"
  ],
  "formatRules": [
    {
      "trigger": "}",
      "description": "Align closing brace of a block",
      "rules": [
        {
          "action": "outdent",
          "pattern": "^\\s*\\}",
          "description": "Outdent closing brace to block level"
        }
      ]
    },
    {
      "trigger": ")",
      "description": "Format attribute argument lists",
      "rules": [
        {
          "action": "trimWhitespace",
          "pattern": "\\(\\s+|\\s+\\)",
          "description": "Trim padding inside attribute parentheses"
        }
      ]
    },
    {
      "trigger": "\n",
      "description": "Formatting on newline",
      "rules": [
        {
          "action": "trimWhitespace",
          "pattern": "\\s+$",
          "description": "Remove trailing whitespace"
        },
        {
          "action": "indent",
          "pattern": "\\{\\s*$",
          "description": "Indent inside an opened block"
        }
      ]
    }
  ],
  "indentation": {
    "increasePattern": "\\{\\s*$",
    "decreasePattern": "^\\s*\\}"
  }
}
