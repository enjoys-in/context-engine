{
  "language": "haskell",
  "autoFormatTriggerCharacters": [
    "\n",
    "}",
    ")",
    "]"
  ],
  "formatRules": [
    {
      "trigger": "\n",
      "description": "Indent after a layout keyword",
      "rules": [
        {
          "action": "indent",
          "pattern": "\\b(where|do|of)\\s*$",
          "description": "Open a layout block"
        },
        {
          "action": "indent",
          "pattern": "\\blet\\s*$",
          "description": "Open a let block"
        },
        {
          "action": "indent",
          "pattern": "=\\s*$",
          "description": "Continue a definition on the next line"
        },
        {
          "action": "outdent",
          "pattern": "^\\s*in\\b",
          "description": "in closes a let block"
        },
        {
          "action": "trimWhitespace",
          "description": "Drop trailing whitespace on the line just left"
        }
      ]
    },
    {
      "trigger": "}",
      "description": "Align a closing brace",
      "rules": [
        {
          "action": "alignBrackets",
          "description": "Line up with its opener"
        }
      ]
    },
    {
      "trigger": ")",
      "description": "Align a closing parenthesis",
      "rules": [
        {
          "action": "alignBrackets",
          "description": "Line up with its opener"
        }
      ]
    },
    {
      "trigger": "]",
      "description": "Align a closing bracket",
      "rules": [
        {
          "action": "alignBrackets",
          "description": "Line up with its opener"
        }
      ]
    }
  ],
  "indentation": {
    "increasePattern": "(\\b(where|do|of|let)\\s*$)|(=\\s*$)|(\\bif\\b.*\\bthen\\s*$)",
    "decreasePattern": "^\\s*(in\\b|else\\b|\\}|\\)|\\])"
  }
}
