{
  "language": "haskell",
  "colorPatterns": [
    {
      "pattern": "\"#([0-9a-fA-F]{3})\"",
      "format": "hex3_string",
      "description": "Short hex colour in a string literal"
    },
    {
      "pattern": "\"#([0-9a-fA-F]{6})\"",
      "format": "hex6_string",
      "description": "Hex colour in a string literal"
    },
    {
      "pattern": "\"#([0-9a-fA-F]{8})\"",
      "format": "hex8_string",
      "description": "Hex colour with alpha in a string literal"
    },
    {
      "pattern": "\\bsRGB\\s+([\\d.]+)\\s+([\\d.]+)\\s+([\\d.]+)",
      "format": "srgb_unit",
      "description": "colour package sRGB with unit components"
    },
    {
      "pattern": "\\bsRGB24\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)",
      "format": "srgb24",
      "description": "colour package sRGB24 with 0-255 components"
    },
    {
      "pattern": "\\brgb\\s+([\\d.]+)\\s+([\\d.]+)\\s+([\\d.]+)",
      "format": "rgb_unit",
      "description": "Diagrams rgb with unit components"
    },
    {
      "pattern": "\\brgba\\s+([\\d.]+)\\s+([\\d.]+)\\s+([\\d.]+)\\s+([\\d.]+)",
      "format": "rgba_unit",
      "description": "Diagrams rgba with unit components"
    },
    {
      "pattern": "\\bRGB\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)",
      "format": "rgb24",
      "description": "RGB constructor with 0-255 components"
    },
    {
      "pattern": "\"(rgb\\([^\"]*\\))\"",
      "format": "css_rgb_string",
      "description": "CSS rgb() inside a string"
    },
    {
      "pattern": "\"(hsl\\([^\"]*\\))\"",
      "format": "css_hsl_string",
      "description": "CSS hsl() inside a string"
    }
  ],
  "colorPresentations": [
    {
      "label": "#rrggbb"
    },
    {
      "label": "sRGB24 r g b"
    },
    {
      "label": "sRGB r g b"
    },
    {
      "label": "rgb r g b"
    },
    {
      "label": "rgba r g b a"
    }
  ],
  "namedColors": {
    "black": "#000000",
    "white": "#ffffff",
    "red": "#ff0000",
    "green": "#008000",
    "blue": "#0000ff",
    "yellow": "#ffff00",
    "cyan": "#00ffff",
    "magenta": "#ff00ff",
    "grey": "#808080",
    "orange": "#ffa500",
    "purple": "#800080",
    "brown": "#a52a2a",
    "pink": "#ffc0cb",
    "transparent": "#00000000"
  }
}
