{
  "language": "haskell",
  "wordPattern": "[A-Za-z_'][A-Za-z0-9_']*",
  "supported": true,
  "linkedEditingPatterns": [
    {
      "type": "comment_pair",
      "openPattern": "\\{-",
      "closePattern": "-\\}",
      "description": "Block comment delimiters"
    },
    {
      "type": "signature_equation",
      "openPattern": "^([a-z_]\\w*'?)\\s*::",
      "closePattern": "^([a-z_]\\w*'?)\\s+[^=]*=",
      "description": "A type signature and its equations share a name"
    },
    {
      "type": "newtype_wrapper",
      "openPattern": "^newtype\\s+([A-Z]\\w*)",
      "closePattern": "=\\s*([A-Z]\\w*)\\s*\\{",
      "description": "A newtype and its single constructor are conventionally named alike"
    },
    {
      "type": "record_accessor",
      "openPattern": "\\{\\s*(\\w+)\\s*::",
      "closePattern": "\\b(\\w+)\\s+\\w+\\s*=",
      "description": "Record field and its generated accessor"
    },
    {
      "type": "pragma_pair",
      "openPattern": "\\{-#",
      "closePattern": "#-\\}",
      "description": "Pragma delimiters"
    },
    {
      "type": "module_export",
      "openPattern": "^module\\s+([A-Z][\\w.]*)",
      "closePattern": "\\bwhere\\b",
      "description": "Module header and its where"
    }
  ]
}
